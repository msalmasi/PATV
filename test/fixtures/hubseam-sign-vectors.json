{
  "v": 1,
  "about": "Shared HMAC test vectors of the v1 seam (CHAT-ARCHITECTURE §16, seam plan §2.1, §5.1). Byte-identical in the hub (services/rooms/test/fixtures) and v1 (test/fixtures); both repos pin its sha256. Generated from v1's hubsign.js, the reference implementation. Keys are test values, never used anywhere else.",
  "algorithm": "X-PATV-Sig = v1=<hex HMAC-SHA256(utf8(key), key_id \\n METHOD \\n raw_target \\n ts \\n nonce \\n hex(sha256(body_bytes)))>; key_id = the X-PATV-Key-Id value as sent; ts unix seconds, ±60 s; nonce 16-64 hex, signed as sent; key ids v1-<env>-<n> (v1 -> hub) or hub-<env>-<n> (hub -> v1)",
  "refusal_order": [
    "missing",
    "wrong_env",
    "unknown_key",
    "stale",
    "missing (nonce format)",
    "bad_sig",
    "replay",
    "busy"
  ],
