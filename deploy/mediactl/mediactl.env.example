# /etc/mediactl/mediactl.env - PATV media-control (deploy/mediactl). root:mediactl 0640.
# Placeholders only - install.sh fills the secret and the Plex token itself and never prints them.

# The shared secret the PATV site signs every request with (32+ chars). Same value as MEDIACTL_SECRET in the site's .env.
MEDIACTL_SECRET=REPLACE_ME_openssl_rand_hex_32

# Where it listens, and who may talk to it (comma-separated IPs / CIDRs). Put ONLY the VPS's public IP
# (or its Tailscale 100.x address) here, plus loopback for local checks.
MEDIACTL_LISTEN=0.0.0.0:8790
MEDIACTL_ALLOW=127.0.0.1/32,::1,VPS_PUBLIC_IP/32

# HTTPS with a self-signed certificate (install.sh makes one). The site pins its SHA-256 fingerprint
# (MEDIACTL_TLS_SHA256 in the site's .env). Leave both empty for plain HTTP (only over Tailscale).
MEDIACTL_TLS_CERT=/etc/mediactl/tls.crt
MEDIACTL_TLS_KEY=/etc/mediactl/tls.key

# Plex on this box. The token is the server's own (Preferences.xml PlexOnlineToken) - install.sh copies it.
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=REPLACE_ME

# Encoding: vaapi = the Intel iGPU (QuickSync hardware through VA-API), x264 = CPU fallback
MEDIACTL_ENCODER=vaapi
MEDIACTL_VAAPI_DEVICE=/dev/dri/renderD128
# The most library streams this box encodes at once (one per stage is enforced regardless)
MEDIACTL_MAX_STREAMS=2
# HDR10 / HLG / Dolby Vision sources are tone-mapped to SDR on the CPU (this iGPU's tonemap_vaapi doesn't work):
# ~0.5 core at 720p, ~1.4 at 1080p, so two 1080p HDR streams can't keep up on 4 cores. 480 | 720 | 1080.
MEDIACTL_HDR_MAX_HEIGHT=720

# Guards: RTMP targets must start with one of these; media files must resolve under one of these folders
MEDIACTL_RTMP_ALLOW=rtmp://stream.publicaccess.tv/
MEDIACTL_MEDIA_ROOTS=/mnt/
