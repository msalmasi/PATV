# Auto detect text files and perform LF normalization
* text=auto

# Deploy scripts and units run on Linux
*.sh text eol=lf
deploy/** text eol=lf
.github/** text eol=lf

# The seam fixtures shared byte-for-byte with the hub repo (their sha256 is pinned in both)
test/fixtures/hubseam-*.json text eol=lf
# The Admin › Backends contract fixture shared byte-for-byte with camfrog-bot (ci/fixtures/; sha256 pinned in both)
test/fixtures/backends-contract.json text eol=lf
# PO-3: the economy settings' thin-client contract fixture, shared byte-for-byte with camfrog-bot (ci/fixtures/; sha256 pinned in both)
test/fixtures/policycfg-contract.json text eol=lf
# S1 Q5b: rt-schema's registry/text-styles.json, byte for byte (sha256 pinned in test/huboutbox-s1.test.js)
chat-text-styles.json text eol=lf

# CL10: the chat-log download golden files ("PATV chat log v1": compared byte for byte - LF line ends, whatever the checkout)
test/fixtures/chatlog/golden-* text eol=lf

# 1.99aej: the chat hub's vendored widget (the platform repo's export; chatwidget.js checks the tab entry against its SRI and
# the browser checks every file it loads): the build's exact bytes in every checkout, never line-end converted
public/js/patv-chat/** -text
