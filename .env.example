# .env.example - the PATV website's environment (copy to .env on the server; .env is gitignored).
# Placeholders only. NEVER commit real keys.
#
# ── Stripe (1.99ix, stripebilling.js): real-money Prime Time / Season Pass ──
# OFF by default: while STRIPE_ENABLED isn't 1 (or a key below is empty) the Stripe routes 404 and no page shows a card option.
# Test mode first: use the test-mode keys (sk_test_..., the test webhook's whsec_...) on STAGING only, pay with 4242 4242 4242 4242.
STRIPE_ENABLED=0
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Recurring monthly Prices (Stripe dashboard -> Products), one per tier:
STRIPE_PRICE_PRIME_TIME=price_REPLACE_ME
STRIPE_PRICE_SEASON_PASS=price_REPLACE_ME
# 1.99th: 💎 Prime Time Plus ($100/month recurring). Empty = Plus stays PAT-only (no card button on the Plus card).
STRIPE_PRICE_PRIME_PLUS=price_REPLACE_ME
# The public site URL Stripe sends people back to (defaults: https://publicaccess.tv, staging: https://staging.publicaccess.tv)
# SITE_URL=https://staging.publicaccess.tv

# ── Plex / media (1.99ji, mediaconf.js + /admin/media) ──
# Each part stays OFF until its keys are here AND an admin switches it on at /admin/media.
# 📼 Play from library: the homelab media-control service (deploy/mediactl/README.md). install.sh prints the values.
MEDIACTL_URL=https://MEDIACTL_HOST:8790
MEDIACTL_SECRET=REPLACE_ME_same_value_as_in_etc_mediactl_mediactl_env
# SHA-256 fingerprint of its self-signed certificate (AB:CD:...); required for https (pins it)
MEDIACTL_TLS_SHA256=REPLACE_ME
# 🎬 Requests: Overseerr / Seerr / Jellyseerr (Settings -> General -> API Key)
OVERSEERR_URL=https://OVERSEERR_HOST
OVERSEERR_API_KEY=REPLACE_ME
# Overseerr Settings -> Notifications -> Webhook: URL https://<site>/api/requests/overseerr-webhook, Authorization header = this
OVERSEERR_WEBHOOK_SECRET=REPLACE_ME_random_string
# 🎟️ Plex invites: Wizarr (Settings -> API keys). WIZARR_PUBLIC_URL = the address buyers open (default WIZARR_URL)
WIZARR_URL=https://WIZARR_HOST
WIZARR_API_KEY=REPLACE_ME
# WIZARR_PUBLIC_URL=https://WIZARR_HOST
# 📊 Plex watch stats on profiles (1.99nj, plexstats.js): Tautulli, read-only (Settings -> Web Interface -> API key).
# The address the server reaches it on: the homelab's public https://TAUTULLI_HOST (its /api/v2 must not sit behind
# the SSO gate - same as Wizarr's /api). Unset = the profile's Plex stats stay off; nothing else needs it.
TAUTULLI_URL=https://TAUTULLI_HOST
TAUTULLI_API_KEY=REPLACE_ME
# TAUTULLI_SYNC_MIN=60

# 1.99ks crypto donations (cryptopay.js): OPTIONAL keyed RPC endpoints. Without them the public endpoints set on
# /admin/crypto are used. The switch, the receiving addresses and the limits are admin settings, not env.
# Use a DIFFERENT provider for the verifier than for the scanner.
# CRYPTO_RPC_ETH=https://eth-mainnet.g.alchemy.com/v2/REPLACE_ME
# CRYPTO_RPC_BASE=https://base-mainnet.g.alchemy.com/v2/REPLACE_ME
# CRYPTO_RPC_SOL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME
# CRYPTO_VERIFY_RPC_ETH=
# CRYPTO_VERIFY_RPC_BASE=
# CRYPTO_VERIFY_RPC_SOL=

# ── Sign-in methods (1.99lb: telegramsso.js, googlesso.js; switches on /admin/users#signin) ──
# Each button stays HIDDEN until its keys are here (and its switch is on, the default).
#
# ✈️ Sign in with Telegram - the official Login Widget, signed by the bot's token (the same bot as the Telegram
# bridge on prod: @pepe_cf_bot; Pepe keeps his own copy of the token in his keys registry).
#   1. In Telegram, open @BotFather -> /setdomain -> pick @pepe_cf_bot -> send: publicaccess.tv
#      (a bot has ONE domain: staging needs its own BotFather bot + its own token, or no Telegram button there)
#   2. Paste the bot's token below (BotFather -> /mybots -> the bot -> API Token). Never commit it.
# TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME
#
# G Sign in with Google - OpenID Connect (authorization code + PKCE).
#   1. https://console.cloud.google.com -> pick / create a project (e.g. "PATV")
#   2. APIs & Services -> OAuth consent screen (Google Auth Platform -> Branding / Audience / Data access):
#      app name "Public Access TV", support email, authorized domain publicaccess.tv, audience External,
#      scopes openid, .../auth/userinfo.email, .../auth/userinfo.profile (no sensitive scopes -> no review needed);
#      then Publish the app (In production) so anyone can sign in, not only test users
#   3. APIs & Services -> Credentials -> Create credentials -> OAuth client ID -> Web application, name "PATV web"
#      Authorized redirect URIs (exactly):
#        https://publicaccess.tv/auth/google/callback
#        https://staging.publicaccess.tv/auth/google/callback
#      (no "Authorized JavaScript origins" needed)
#   4. Copy the Client ID and Client secret here (prod .env and, to test there, staging's .env)
# GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=REPLACE_ME
#
# Sign in with Apple (applesso.js) - OpenID Connect code flow, form_post, ES256 client secret signed with your .p8 key.
# All four values, or the Apple button stays hidden. https://developer.apple.com/account -> Certificates, Identifiers & Profiles:
#   1. Identifiers -> App IDs: a primary App ID (e.g. tv.publicaccess.app) with the "Sign in with Apple" capability. In its
#      Sign in with Apple settings, Server-to-Server Notification Endpoint: https://publicaccess.tv/auth/apple/notifications
#   2. Identifiers -> Services IDs -> + (e.g. tv.publicaccess.signin = APPLE_SERVICES_ID) -> Sign in with Apple -> Configure:
#      Primary App ID = step 1; Domains: publicaccess.tv, staging.publicaccess.tv; Return URLs (exactly):
#        https://publicaccess.tv/auth/apple/callback
#        https://staging.publicaccess.tv/auth/apple/callback
#   3. Keys -> + -> "Sign in with Apple" (primary App ID from step 1) -> download AuthKey_<KeyID>.p8 (only once - keep it in the
#      password manager). APPLE_KEY_ID = that Key ID; APPLE_TEAM_ID = your Team ID (Membership details).
#   4. APPLE_PRIVATE_KEY = the .p8 file base64-encoded on ONE line:  base64 -w0 AuthKey_XXXXXXXXXX.p8
#   5. APPLE_APP_ID = the step-1 bundle id. Apple's server-to-server notifications (consent revoked, Apple Account deleted, email
#      forwarding on / off) name the primary App ID as their audience: without it they are all refused (a boot warning and the
#      /admin/users#signin card say so). Apple allows ONE notification endpoint per primary App ID.
# Never commit these; pm2 restart index after editing .env.
# APPLE_SERVICES_ID=tv.publicaccess.signin
# APPLE_TEAM_ID=REPLACE_ME
# APPLE_KEY_ID=REPLACE_ME
# APPLE_PRIVATE_KEY=REPLACE_ME
# APPLE_APP_ID=tv.publicaccess.app

# ── 🔔 Browser notifications / Web Push (1.99acd, webpush.js, docs/webpush.md) ──
# Without all three the feature stays off (one log line says why); the switch itself is in /admin/push (default off).
#   node tools/vapid-keys.js --env .env --subject mailto:<ops address>
# writes these three lines (it prints only the public key and its kid). ONE pair per instance (staging and prod each their
# own, never copied between them); never rotate it once people have turned notifications on; keep a copy in the password
# manager. At S5 the pair moves to notify's secrets. Values must never be committed.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

# 1.99mv: the legacy Discord blackjack bot routes (/api/blackjack/wager|result) answer 410 unless this is 1;
# when on they need the site bot token (TWITCH_BOT_TOKEN) or a non-empty BOT_TOKEN.
# LEGACY_DISCORD_BLACKJACK=0

# ── 1.99acf: per-caller bot keys + the chat seam (docs/bot-keys.md, docs/chat-tickets.md) ──
# The ops alerts' own key (the "ops" key minted on /admin/keys; deploy/webrtc/pepe-relay-watchdog.sh reads it). Empty = the
# shared bot token only.
OPS_PATV_KEY=
# v1 chat tickets (chatticket.js): make the four values with `node tools/chat-ticket-key.js --out <new file>` (each
# environment its own key). Empty = tickets off and no JWKS.
CHAT_TICKET_KEY=
CHAT_TICKET_KID=
CHAT_TICKET_PREV_PUB=
CHAT_TICKET_PREV_KID=
# Optional: the UUID namespace that maps a legacy non-UUID account id to the hub's account_id (uuidv5). Empty = such ids refused.
CHAT_GENESIS_NS=
# The chat hub (huboutbox.js): its origin (no path - the /internal/v1 paths are signed as sent), v1's outbound HMAC key id
# ("v1-<env>-<n>") + key (per environment), and the local userspace tailscaled HTTP proxy (prod 127.0.0.1:1055, staging
# 127.0.0.1:1056) for an http:// hub (http:// only to loopback or the tailnet: 100.64.0.0/10, fd7a:115c:a1e0::/48, *.ts.net).
# Empty = nothing is sent. Every key is generated separately (never one secret for two key ids; key_reuse).
HUB_V1_URL=
HUB_V1_KEY_ID=
HUB_V1_KEY=
HUB_V1_PROXY=
# 1.99acm: the seam environment (prod | staging | test | dev; empty = staging when STAGING is set, else prod), and the key the
# hub signs its calls into this site with (hubinbound.js: snapshots, rewind): id "hub-<env>-<n>" + key, plus the previous
# pair during a rotation. Empty = /internal/v1 answers 404. Before setting it: the public nginx's /internal/ rule
# (deploy/README.md, deploy/check-internal.sh).
HUB_V1_ENV=
HUB_V1_IN_KEY_ID=
HUB_V1_IN_KEY=
HUB_V1_IN_PREV_KEY_ID=
HUB_V1_IN_PREV_KEY=
