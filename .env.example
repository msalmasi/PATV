# .env.example - the PATV website's environment (copy to .env on the server; .env is gitignored).
# Placeholders only. NEVER commit real keys.
#
# ── Stripe (1.99ix, stripebilling.js): real-money Prime Time / Season Pass ──
# OFF by default: while STRIPE_ENABLED isn't 1 (or a key below is empty) the Stripe routes 404 and no page shows a card option.
# Test mode first: use the test-mode keys (sk_test_..., the test webhook's whsec_...) on STAGING only, pay with 4242 4242 4242 4242.
STRIPE_ENABLED=0
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Recurring monthly Prices (Stripe dashboard -> Products), one per tier:
STRIPE_PRICE_PRIME_TIME=price_REPLACE_ME
STRIPE_PRICE_SEASON_PASS=price_REPLACE_ME
# The public site URL Stripe sends people back to (defaults: https://publicaccess.tv, staging: https://staging.publicaccess.tv)
# SITE_URL=https://staging.publicaccess.tv
