<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('acctdel.title'), user: username }) %>
<%# /settings/account/delete - 1.99wj (accountdelete.js): what deleting does, what to close first, re-authentication + the typed
    confirmation. The policy: docs/account-deletion.md. %>
<%- include('partials/account-css') %>
<main class="ds-page mid pe">
  <a class="ds-back" href="/settings/account#delete">← <%- t('settings.account') %></a>
  <div class="ds-head">
    <span class="ds-eyebrow"><span class="ds-ic" aria-hidden="true">🗑️</span> <%- t('sethub.eyebrow') %></span>
    <h1 class="ds-h1"><%- t('acctdel.h1') %></h1>
    <p class="ds-sub"><%- t('acctdel.lead', { days: graceDays }) %></p>
  </div>

  <section class="card">
    <h2><%- t('acctdel.what') %></h2>
    <ul class="acctdel-list">
      <li><%- t('acctdel.what.profile') %></li>
      <li><%- t('acctdel.what.posts') %></li>
      <li><%- t('acctdel.what.dms') %></li>
      <li><%- t('acctdel.what.pat') %></li>
      <li><%- t('acctdel.what.camfrog') %></li>
      <li><%- t('acctdel.what.kept') %></li>
      <li><%- t('acctdel.what.chat') %></li>
      <%# S1 V4: PATV chat (the chat hub) - only while the hub's erasure switch is on (accountdelete.removeOffered) %>
      <% if (locals.removePublic) { %><li><%- t('acctdel.what.hub') %></li><% } %>
      <li><%- t('acctdel.what.grace', { days: graceDays }) %></li>
    </ul>
    <p class="hint"><%- t('acctdel.export_first', { link: '<a href="/settings/account#data">' + t('settings.data.download') + '</a>' }) %></p>
  </section>

  <% if (elevated) { %>
  <section class="card">
    <h2><%- t('acctdel.elevated_h') %></h2>
    <p class="lede"><%- t('acctdel.elevated') %></p>
  </section>
  <% } else if (block.length) { %>
  <section class="card" id="blockers">
    <h2><%- t('acctdel.block_h') %></h2>
    <p class="lede"><%- t('acctdel.block_lede') %></p>
    <ul class="acctdel-list">
      <% block.forEach((b) => { %><li><%= b.label %><% if (b.href) { %> · <a href="<%= b.href %>"><%- t('acctdel.go') %></a><% } %></li><% }) %>
    </ul>
  </section>
  <% } else { %>
  <% if (settle.length) { %>
  <section class="card">
    <h2><%- t('acctdel.settle_h') %></h2>
    <ul class="acctdel-list"><% settle.forEach((s) => { %><li><%= s.label %></li><% }) %></ul>
  </section>
  <% } %>
  <section class="card" id="confirm">
    <h2><%- t('acctdel.confirm_h') %></h2>
    <form id="delForm" class="grid2" autocomplete="off">
      <% if (hasPassword && !fresh) { %>
      <div class="field"><label class="lbl" for="delPw"><%- t('acctdel.password') %></label>
        <input type="password" id="delPw" name="password" autocomplete="current-password" maxlength="72">
        <span class="hint"><%- t('acctdel.password_or_fresh') %></span></div>
      <% } else if (!fresh) { %>
      <p class="hint" style="grid-column:1/-1"><%- t('acctdel.fresh_needed') %></p>
      <% } else { %>
      <p class="hint" style="grid-column:1/-1"><%- t('acctdel.fresh_ok') %></p>
      <% } %>
      <div class="field"><label class="lbl" for="delConfirm"><%- t('acctdel.type', { name: '<code>' + username.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]) + '</code>' }) %></label>
        <input type="text" id="delConfirm" name="confirm" autocomplete="off" spellcheck="false" data-want="<%= username %>"></div>
      <%# CL6 (decision 14): unticked by default (accountdelete.js hide_lines -> the pad chat archive's sticky hidden set) %>
      <div class="field" style="grid-column:1/-1"><label class="acctdel-ck"><input type="checkbox" id="delHideLines" name="hide_lines" aria-describedby="delHideLinesHint"> <%- t('acctdel.hide_lines') %></label>
        <span class="hint" id="delHideLinesHint"><%- t('acctdel.hide_lines_meta') %></span></div>
      <% if (locals.removePublic) { const rpWait = removePublic.wait; %>
      <%# S1 V4 (ADR 0007 D16, OQ-20): ONE checkbox for both stores - the chat hub (privacy/account-deleted remove_public) and the pad
          chat archive's web lines (chatlogmod.removeAccountLines); unticked by default; only while the hub's erasure switch is on;
          at most once a day (accountdelete.js remove_public) %>
      <div class="field" style="grid-column:1/-1"><label class="acctdel-ck"><input type="checkbox" id="delRemovePublic" name="remove_public" aria-describedby="delRemovePublicHint"<% if (rpWait) { %> disabled<% } %>> <%- t('acctdel.remove_public') %></label>
        <span class="hint" id="delRemovePublicHint"><%- t('acctdel.remove_public_meta') %><% if (rpWait) { %> <%- t('acctdel.remove_public_wait', { when: t.date(rpWait, { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }) }) %><% } %></span></div>
      <% } %>
      <% if (locals.recordings) { %>
      <%# mic retention (owner answers 2026-10-27; micrec.js): unticked by default; only while the mic-recordings policy switch is on and a
          Pepe that deletes them was heard from, to an account that has (had) a Camfrog login (accountdelete.js delete_recordings) %>
      <div class="field" style="grid-column:1/-1"><label class="acctdel-ck"><input type="checkbox" id="delRecordings" name="delete_recordings" aria-describedby="delRecordingsHint"> <%- t('acctdel.recordings') %></label>
        <span class="hint" id="delRecordingsHint"><%- t('acctdel.recordings_meta') %></span></div>
      <% } %>
      <div style="grid-column:1/-1"><button class="btn" type="submit" id="delBtn" disabled><%- t('acctdel.button', { days: graceDays }) %></button></div>
    </form>
    <span class="status" id="delStatus" role="status" aria-live="polite"></span>
  </section>
  <% } %>
</main>
<style>
  .pe .acctdel-list { margin: 0 0 var(--ds-sp-3); padding-left: 20px; display: grid; gap: 6px; color: var(--ds-text-2); line-height: 1.5; }
  .pe #delBtn:not(:disabled) { background: var(--ds-danger-fill); border-color: var(--ds-danger-line); color: var(--ds-danger-ink) !important; }
  .pe .acctdel-ck { display: flex; gap: 8px; align-items: center; min-height: 44px; cursor: pointer; color: var(--ds-text); }
  .pe .acctdel-ck input { width: auto; min-height: 0; margin: 0; }
</style>
<script src="/public/js/account-delete.js?v=4" defer></script>
</body>
</html>
