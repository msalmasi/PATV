<%- include('layout', { title: `${displayname || usernameProfile} on Public Access`, user: username, og: typeof og !== 'undefined' ? og : null }) %>
<%
  const need = xpForNextLevel(level);
  const pct = Math.max(0, Math.min(100, need ? (xp / need) * 100 : 0));
  const fmt = (n) => Math.floor(Number(n) || 0).toLocaleString('en-US');
  const previewing = typeof previewVisitor !== 'undefined' && !!previewVisitor;
  const isMe = username && username == usernameProfile && !previewing;
  // section order + visibility (profilelayout.js). Hidden sections render only for the owner/admins, greyed.
  const L = typeof layout !== 'undefined' && layout ? layout : { order: ['stats', 'level', 'avatar', 'analytics', 'gtf', 'badges'],
    hidden: () => false, show: () => true, seesHidden: false, anyHidden: false };
  const hidTag = (id) => L.hidden(id) ? '<span class="pf-hid">\u{1F441} Hidden from visitors</span>' : '';
  const role = (classh || '').toLowerCase();
  // equipped cosmetics (cosmetics.js preloads them for this route)
  const pc = typeof profileCosmetics !== 'undefined' && profileCosmetics ? profileCosmetics : null;
  const cx = (k) => (pc && pc.equipped && pc.equipped[k] ? pc.equipped[k].r : null);
  const cxName = cx('name_color'), cxBorder = cx('profile_border'), cxDeco = cx('avatar_decoration'), cxBanner = cx('profile_banner'), cxFx = cx('profile_effect');
  const cxShow = pc && pc.showcase ? pc.showcase : [];
%>
<%- include('partials/cosmetics-css') %>
<style>
  .pf { max-width: 920px; margin: 0 auto; padding: 18px 16px 56px; font-family: Ubuntu, sans-serif; color: #e6e6e6; display: grid; gap: 16px; }
  .pf a { color: #81c784; text-decoration: none; }
  .pf a:hover { color: #a5d6a7; }
  .pf .card { background: #111; border: 1px solid #222; border-radius: 14px; padding: 18px 20px; min-width: 0; }
  .pf .hero { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 18px 22px; align-items: center;
              background: radial-gradient(120% 140% at 0% 0%, #17301a 0%, #111 55%); }
  .pf .avatar { width: 108px; height: 108px; border-radius: 50%; object-fit: cover; border: 3px solid #4caf50; background: #0d0d0d;
                box-shadow: 0 0 0 6px rgba(76, 175, 80, .12); }
  .pf .who h1 { margin: 0; font-size: 28px; line-height: 1.15; overflow-wrap: anywhere; }
  .pf .handle { color: #9a9; font-size: 14px; margin-top: 2px; overflow-wrap: anywhere; }
  .pf .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .pf .chip { font-size: 12px; padding: 3px 10px; border-radius: 999px; border: 1px solid #2c3a2d; background: #0f1a10; color: #b9d8bb; }
  .pf .chip.admin { border-color: #6b4fa0; background: #1a1326; color: #cbb6f2; }
  .pf .chip.staff { border-color: #2f6d8f; background: #10202a; color: #a9d7f0; }
  .pf .actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; }
  .pf .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 8px; border: 1px solid #2b2b2b;
             background: #181818; color: #ddd !important; font-size: 14px; cursor: pointer; font-family: inherit; }
  .pf .btn:hover { border-color: #4caf50; }
  .pf .btn.primary { background: #4caf50; border-color: #4caf50; color: #fff !important; font-weight: bold; }
  .pf .btn.ghost { background: transparent; }
  .pf form.inline { display: inline; margin: 0; }
  .pf .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
  .pf .stat { background: #111; border: 1px solid #222; border-radius: 12px; padding: 14px 16px; }
  .pf .stat .k { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #888; }
  .pf .stat .v { font-size: 24px; font-weight: bold; margin-top: 4px; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .pf .stat .v.gold { color: #ffd700; }
  .pf .stat .s { font-size: 12px; color: #888; margin-top: 2px; }
  .pf .lvl { display: grid; gap: 8px; }
  .pf .lvl-top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .pf .lvl-top b { font-size: 18px; }
  .pf .bar { height: 14px; background: #1c1c1c; border-radius: 999px; overflow: hidden; }
  .pf .bar span { display: block; height: 100%; background: linear-gradient(90deg, #4caf50, #c6e94f); border-radius: 999px; }
  .pf .muted { color: #888; font-size: 13px; }
  .pf h2 { margin: 0 0 12px; letter-spacing: .1em; text-transform: uppercase; color: #ffd700; font-family: 'Press Start 2P', monospace; font-size: 11px; }
  .pf .gtf { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center; }
  .pf .links { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 14px; }
  .pf .badges { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; }
  .pf .badge { background: #0d0d0d; border: 1px solid #1f1f1f; border-radius: 10px; padding: 10px 8px; text-align: center; display: grid; gap: 6px; justify-items: center; }
  .pf .badge img { height: 48px; width: 48px; object-fit: contain; image-rendering: pixelated; }
  .pf .badge span { font-size: 12px; line-height: 1.25; color: #ccc; overflow-wrap: anywhere; }
  .pf code { background: #1c1c1c; padding: 1px 5px; border-radius: 4px; }
  .pf .showcase { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .pf .showcase .pin { display: inline-flex; align-items: center; gap: 6px; background: rgba(0,0,0,.35); border: 1px solid #3a3a1c; border-radius: 10px; padding: 4px 10px 4px 4px; font-size: 12px; color: #e8e2b0; }
  .pf .showcase img { width: 30px; height: 30px; object-fit: contain; image-rendering: pixelated; }
  .pf .gtf-av { display: grid; justify-items: center; gap: 4px; }
  .pf .gtf-av .cx-gtf { width: 96px; height: 96px; display: grid; place-items: center; background: #0d0d0d; border-radius: 10px; font-size: 40px; }
  .pf .avs { display: grid; grid-template-columns: 192px minmax(0, 1fr); gap: 18px 22px; align-items: center; }
  .pf .avs-frame { width: 192px; height: 192px; box-sizing: border-box; border-radius: 14px; border: 1px solid #2a2a2a; display: grid; place-items: center;
                   background: repeating-conic-gradient(#151515 0% 25%, #101010 0% 50%) 50% / 24px 24px; overflow: hidden; }
  .pf .avs-frame svg { display: block; width: 176px; height: 176px; image-rendering: pixelated; shape-rendering: crispEdges; }
  .pf .avs-frame.empty { border-style: dashed; }
  .pf .avs-ph { font-size: 64px; opacity: .35; filter: grayscale(.4); }
  .pf .avs-info { min-width: 0; }
  .pf .avs-regen { margin-top: 10px; }
  .pf .avs-regen summary { display: inline-block; cursor: pointer; list-style: none; }
  .pf .avs-regen summary::-webkit-details-marker { display: none; }
  .pf .avs-regen p { margin: 8px 0; max-width: 60ch; }
  .pf .avs-info h2 { margin-bottom: 6px; }
  .pf .avs-who { font-size: 18px; font-weight: bold; overflow-wrap: anywhere; }
  .pf .avs-who .chip { font-size: 12px; font-weight: normal; vertical-align: 2px; margin-left: 4px; }
  .pf .avs-items { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 6px; }
  .pf .avs-items li { display: grid; grid-template-columns: 86px minmax(0, 1fr) auto; gap: 8px; align-items: center; font-size: 13px;
                      background: #0d0d0d; border: 1px solid #1f1f1f; border-radius: 8px; padding: 6px 10px; }
  .pf .avs-slot { color: #888; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; }
  .pf .avs-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #ddd; }
  .pf .avs-r { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 6px; vertical-align: 1px; }
  .pf .avs-rar { font-size: 11px; text-transform: capitalize; }
  .pf .avs-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .pf .pf-slot { position: relative; min-width: 0; display: grid; }
  .pf .pf-slot.is-hidden > :not(.pf-hid), .pf .stat.is-hidden > :not(.pf-hid) { opacity: .45; filter: grayscale(.6); }
  .pf .pf-slot.is-hidden > .card, .pf .pf-slot.is-hidden > .stats > .stat, .pf .stat.is-hidden { border-style: dashed; border-color: #3a3a3a; }
  .pf .pf-hid { position: absolute; top: -9px; right: 14px; z-index: 5; font-size: 11px; line-height: 1; padding: 4px 9px; border-radius: 999px;
                background: #1d1a10; border: 1px solid #5a4a1c; color: #e8cf7a; white-space: nowrap; pointer-events: none; }
  .pf .stat.is-hidden { position: relative; }
  .pf .pf-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 14px; padding: 10px 14px;
                border-radius: 12px; border: 1px solid #3a3320; background: #15130b; color: #e8dfb8; font-size: 13px; }
  .pf .pf-bar.preview { border-color: #2f6d8f; background: #0d1a22; color: #b9def2; }
  .pf .pf-bar .btns { display: flex; flex-wrap: wrap; gap: 6px; }
  .pf .pf-bar .btn { padding: 5px 11px; font-size: 13px; }
  @media (max-width: 560px) {
    .pf .avs { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .pf .avs-info { width: 100%; }
    .pf .avs-items li { text-align: left; grid-template-columns: 84px minmax(0, 1fr) auto; }
    .pf .avs-slot { font-size: 10px; letter-spacing: .04em; }
    .pf .avs-links { justify-content: center; }
    .pf .hero { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .pf .chips, .pf .actions { justify-content: center; }
    .pf .gtf { grid-template-columns: 1fr; }
  }
</style>
<div class="pf">
  <section class="card hero cx-host">
    <% if (cxBanner) { %><div class="cx-banner" style="<%= cxBanner.css %>" aria-hidden="true"></div><% } %>
    <% if (cxFx) { %><div class="cx-fx cx-fx-<%= cxFx.effect %>" aria-hidden="true"></div><% } %>
    <span class="cx-av">
      <% if (cxDeco && cxDeco.conic) { %><span class="cx-conic<%= cxDeco.spin ? ' cx-spin' : '' %>" style="<%= cxDeco.conic %>" aria-hidden="true"></span><% } %>
      <img class="avatar" src="<%= avatar %>" alt="<%= usernameProfile %>'s avatar" onerror="this.src='/public/img/avatar.png'"<% if (cxDeco && cxDeco.ring) { %> style="<%= cxDeco.ring %>"<% } %>>
      <% if (cxDeco && cxDeco.emoji) { %><span class="cx-emoji" aria-hidden="true"><%= cxDeco.emoji %></span><% } %>
    </span>
    <div class="who">
      <h1><% if (cxName && cxName.css) { %><span class="cx-name" style="<%= cxName.css %>"><%= displayname || usernameProfile %></span><% } else { %><%= displayname || usernameProfile %><% } %></h1>
      <div class="handle">@<%= usernameProfile %><% if (typeof camfrog !== 'undefined' && camfrog) { %> · 🐸 <%= camfrog %> on Camfrog<% } %></div>
      <div class="chips">
        <span class="chip">Level <%= level %></span>
        <% if (role && role !== 'pleb') { %><span class="chip <%= role %>"><%= classh %></span><% } %>
        <% if (badges.length) { %><span class="chip">🏅 <%= badges.length %> badge<%= badges.length === 1 ? '' : 's' %></span><% } %>
        <% if (typeof heistSheet !== 'undefined' && heistSheet && heistSheet.cls) { %><span class="chip">🥷 <%= heistSheet.cls %></span><% } %>
      </div>
      <% if (cxShow.length) { %>
        <div class="showcase" aria-label="Pinned badges">
          <% cxShow.forEach((b) => { %><span class="pin" title="<%= b.description %>"><img src="<%= b.icon %>" alt=""><%= b.name %></span><% }) %>
        </div>
      <% } %>
    </div>
    <div class="actions">
      <% if (isMe) { %>
        <a class="btn primary" href="/u/<%= username %>/profile/edit">✏️ Edit profile</a>
        <a class="btn" href="/history">📜 PAT history</a>
        <a class="btn" href="/wallet">👛 Wallet</a>
        <a class="btn" href="/achievements?user=<%= encodeURIComponent(usernameProfile) %>">🏅 Achievements</a>
        <a class="btn" href="/cosmetics?tab=mine#tabs">🎨 Cosmetics</a>
        <form class="inline" action="/logout" method="POST"><button class="btn ghost" type="submit">Log out</button></form>
      <% } else { %>
        <% if (username && !previewing) { %><a class="btn primary" href="/u/<%= usernameProfile %>/tip">💸 Tip</a><% } %>
        <a class="btn" href="/achievements?user=<%= encodeURIComponent(usernameProfile) %>">🏅 Achievements</a>
        <% if (typeof canSeeHistory !== 'undefined' && canSeeHistory) { %>
          <a class="btn" href="/history?user=<%= encodeURIComponent(usernameProfile) %>">📜 PAT history</a>
        <% } %>
      <% } %>
    </div>
    <% if (cxBorder) { %><div class="cx-frame <%= cxBorder.cls %>" style="<%= cxBorder.css %>" aria-hidden="true"></div><% } %>
  </section>

  <% if (previewing) { %>
    <div class="pf-bar preview" role="status"><span>👁 Previewing your profile as a visitor sees it — hidden sections and “only me &amp; admins” panels are left out.</span>
      <span class="btns"><a class="btn" href="/u/<%= usernameProfile %>/profile">Back to my view</a><a class="btn" href="/u/<%= usernameProfile %>/profile/edit#layout">Edit layout</a></span></div>
  <% } else if (L.seesHidden && L.anyHidden) { %>
    <div class="pf-bar"><span>👁 Greyed-out sections are hidden from visitors<%= isMe ? '' : ' (you see them as an admin)' %>.</span>
      <% if (isMe) { %><span class="btns"><a class="btn" href="/u/<%= usernameProfile %>/profile?preview=visitor">Preview as visitor</a><a class="btn" href="/u/<%= usernameProfile %>/profile/edit#layout">Edit layout</a></span><% } %></div>
  <% } %>

  <%
    const av = typeof gtfAvatar !== 'undefined' && gtfAvatar ? gtfAvatar : null;
    const hasAnalytics = (typeof analytics !== 'undefined' && analytics) || (isMe && !(typeof camfrog !== 'undefined' && camfrog));
    const has = {
      stats: true, level: true, gtf: true, badges: true,
      avatar: !!(av && (av.svg || av.items.length || isMe || (typeof heistSheet !== 'undefined' && heistSheet))),
      analytics: !!hasAnalytics,
    };
    const SEC = {};
    SEC.stats = function () { %>
  <section class="stats">
    <% if (L.show('stats_balance')) { %><div class="stat<%= L.hidden('stats_balance') ? ' is-hidden' : '' %>"><%- hidTag('stats_balance') %><div class="k">PAT balance</div><div class="v gold"><%= fmt(points_balance) %></div><div class="s">in their wallet</div></div><% } %>
    <div class="stat"><div class="k">Level</div><div class="v"><%= level %></div><div class="s"><%= Math.round(pct) %>% to level <%= level + 1 %></div></div>
    <div class="stat"><div class="k">Badges</div><div class="v"><%= badges.length %></div><div class="s"><a href="/achievements?user=<%= encodeURIComponent(usernameProfile) %>">see all achievements</a></div></div>
  </section>
  <% };
    SEC.level = function () { %>
  <section class="card lvl">
    <div class="lvl-top"><b>Level <%= level %></b><span class="muted"><%= fmt(xp) %> / <%= fmt(need) %> XP · <%= fmt(need - xp) %> to go</span></div>
    <div class="bar" role="progressbar" aria-valuenow="<%= Math.round(pct) %>" aria-valuemin="0" aria-valuemax="100"><span style="width: <%= pct.toFixed(1) %>%"></span></div>
    <div class="muted">XP comes from chatting, the mic and games. Every level-up pays a PAT bonus.</div>
  </section>
  <% };
    SEC.avatar = function () { %>
  <section class="card avs" aria-label="Grand Theft Frogger avatar">
    <div class="avs-frame<%= av.svg ? '' : ' empty' %>">
      <% if (av.svg) { %><%- av.svg %><% } else { %><span class="avs-ph" aria-hidden="true">🐸</span><% } %>
    </div>
    <div class="avs-info">
      <h2>GTF avatar</h2>
      <div class="avs-who"><%= displayname || usernameProfile %><% if (typeof heistSheet !== 'undefined' && heistSheet && heistSheet.cls) { %> <span class="chip">🥷 <%= heistSheet.cls %></span><% } %></div>
      <% if (!av.svg) { %>
        <p class="muted" style="margin:6px 0 0">No GTF avatar yet — <code>!sheet</code> in a room with Pepe rolls one<%= isMe ? '' : ' for them' %>.</p>
      <% } %>
      <% if (av.items.length) { %>
        <ul class="avs-items">
          <% av.items.forEach((it) => { %>
            <li title="<%= it.desc %>"><span class="avs-slot"><%= it.slot %></span><span class="avs-name"><span class="avs-r" style="background:<%= it.color %>"></span><%= it.emoji %> <%= it.name %></span><span class="avs-rar" style="color:<%= it.color %>"><%= it.rarity %></span></li>
          <% }) %>
        </ul>
      <% } else if (av.svg) { %>
        <p class="muted" style="margin:6px 0 0">Wearing nothing from the GTF wardrobe yet.</p>
      <% } %>
      <div class="avs-links">
        <% if (isMe) { %><a class="btn" href="/cosmetics?tab=mine#tabs">🎨 Change look</a><% } else { %><a class="btn" href="/cosmetics">🎨 GTF wardrobe</a><% } %>
        <% if (typeof heistSheet !== 'undefined' && heistSheet) { %><a class="btn" href="<%= heistSheet.url %>">🥷 Heist sheet</a><% } %>
      </div>
      <% if (isMe && av.svg && camfrog) { %>
        <details class="avs-regen">
          <summary class="btn">🎲 New avatar…</summary>
          <p class="muted">Pepe rolls you a brand-new pixel avatar for <b>20,000 PAT</b> (the same as <code>!avatar regen</code> in chat). Your equipped cosmetics stay on; your current face is gone for good.</p>
          <form method="post" action="/act">
            <input type="hidden" name="kind" value="cmd">
            <input type="hidden" name="cmd" value="avatar">
            <input type="hidden" name="a0" value="regen">
            <input type="hidden" name="tag" value="avatar">
            <input type="hidden" name="label" value="New GTF avatar">
            <input type="hidden" name="back" value="/u/<%= encodeURIComponent(usernameProfile) %>/profile">
            <button class="btn" type="submit">Yes, roll a new one</button>
          </form>
        </details>
      <% } %>
      <% if (isMe && typeof avatarActs !== 'undefined') { %><%- include('partials/actions', { acts: avatarActs, msg: avatarMsg }) %><% } %>
    </div>
  </section>
  <% };
    SEC.analytics = function () { %>
  <% if (typeof analytics !== 'undefined' && analytics && !analytics.empty) { %>
    <%- include('partials/user-analytics', { a: analytics, L }) %>
  <% } else if (typeof analytics !== 'undefined' && analytics && analytics.empty) { %>
    <section class="card" id="analytics"><h2>Analytics</h2><p class="muted" style="margin:0">Pepe hasn't recorded any Camfrog activity for <%= camfrog %> yet — it shows up here after some chat or mic time.</p></section>
  <% } else if (isMe && !(typeof camfrog !== 'undefined' && camfrog)) { %>
    <section class="card" id="analytics"><h2>Analytics</h2><p class="muted" style="margin:0">No Camfrog name is linked to this account, so there's no chat or mic activity to show. Accounts Pepe makes in Camfrog are linked automatically.</p></section>
  <% } %>
  <% };
    SEC.gtf = function () { %>
  <section class="card">
    <h2>Grand Theft Frogger</h2>
    <div class="gtf">
      <div>
        <% if (typeof heistSheet !== 'undefined' && heistSheet) { %>
          <div style="font-size:16px;margin-bottom:8px">🥷 <a href="<%= heistSheet.url %>">Heist sheet</a><%= heistSheet.cls ? ' · ' + heistSheet.cls : '' %></div>
        <% } else { %>
          <div class="muted" style="margin-bottom:8px">No heist sheet yet — <code>!sheet</code> in a room with Pepe rolls one.</div>
        <% } %>
        <% if (typeof gtf !== 'undefined' && gtf) { %>
          <div class="links">
            <a href="/gtf">What is GTF?</a><a href="<%= gtf.heistHelp %>">Heists</a><a href="<%= gtf.turfGuide %>">Turf Wars</a>
            <a href="<%= gtf.turfMap %>">Turf map</a><a href="<%= gtf.gangs %>">Gangs</a><a href="/bounties">Bounties</a>
          </div>
        <% } %>
      </div>
      <% if (typeof heistSheet !== 'undefined' && heistSheet) { %><a class="btn" href="<%= heistSheet.url %>">Open sheet →</a><% } %>
    </div>
  </section>
  <% };
    SEC.badges = function () { %>
  <section class="card">
    <h2>Badges</h2>
    <% if (!badges.length) { %>
      <p class="muted" style="margin:0">No badges yet. <a href="/achievements">How to earn them</a></p>
    <% } else { %>
      <div class="badges">
        <% badges.forEach((badge) => { %>
          <div class="badge" title="<%= badge.description %>"><img src="<%= badge.icon %>" alt=""><span><%= badge.name %></span></div>
        <% }) %>
      </div>
    <% } %>
  </section>
  <% };
  %>
  <% L.order.forEach((id) => { if (!SEC[id] || !has[id] || !L.show(id)) return; %>
  <div class="pf-slot<%= L.hidden(id) ? ' is-hidden' : '' %>" data-sec="<%= id %>"><%- hidTag(id) %>
  <% SEC[id](); %>
  </div>
  <% }) %>
</div>
</body>
</html>
