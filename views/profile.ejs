                          border-radius: var(--ds-r-xs); background: linear-gradient(90deg, color-mix(in srgb, var(--rc) 16%, #0d0d0d), #0d0d0d 70%); border-inline-start: 3px solid var(--rc); }
  .gtf-pop .gp-slot { color: var(--ds-text-muted); font-size: 10.5px; letter-spacing: var(--ds-ls-label); text-transform: uppercase; }
  .gtf-pop .gp-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ds-text); }
  .gtf-pop .gp-rar { font-size: 10.5px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--rc); }
  .gtf-pop .gp-none { margin: var(--ds-sp-3) 0 0; padding: var(--ds-sp-2h) var(--ds-sp-3); border: 1px dashed var(--ds-line-strong); border-radius: var(--ds-r-md); color: var(--ds-text-muted); font-size: var(--ds-fs-meta); }
  .gtf-pop .gp-acts { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: var(--ds-sp-2); }
  .gtf-pop .gp-regen { grid-column: 1 / -1; }
  .gtf-pop .gp-regen summary { display: inline-flex; cursor: pointer; list-style: none; }
  .gtf-pop .gp-regen summary::-webkit-details-marker { display: none; }
  .gtf-pop .gp-regen p { margin: var(--ds-sp-2) 0; font-size: var(--ds-fs-meta); color: var(--ds-text-muted); }
  .gtf-pop .gp-regen form { margin: 0; }
  .gtf-pop .gp-log { grid-column: 1 / -1; }
  .gtf-pop .gp-log .act-box { margin: 0; }
  .gtf-pop code { font-family: var(--ds-font-mono); font-size: .9em; background: #1c1c1c; padding: 1px 5px; border-radius: var(--ds-r-xs); }
  @media (prefers-reduced-motion: reduce) { .pf .pf-gtfmini, .pf .btn, .gtf-pop .btn, .pf .pf-tab { transition: none; } .pf .pf-gtfmini:hover { transform: none; } }
  @media (max-width: 520px) {
    .pf .card { padding: var(--ds-sp-4); }
    .pf .hero { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; gap: var(--ds-sp-4); padding: var(--ds-sp-5) var(--ds-sp-4); }
    .pf .who { justify-items: center; width: 100%; }
    .pf .chips, .pf .actions, .pf .showcase { justify-content: center; }
    .pf .pf-strip { width: 100%; text-align: start; }
    .pf .ps { padding: var(--ds-sp-2h) var(--ds-sp-3); }
    .pf .ps.lv { flex-basis: 100%; order: 9; }
    .pf .ps b { font-size: 16px; }
    .pf .pf-menu { inset-inline-start: auto; inset-inline-end: 0; }
    .pf .pf-tab { padding: 0 var(--ds-sp-3h); }
    .pf .gtf { grid-template-columns: auto minmax(0, 1fr); }
    .pf .gtf > .btn { grid-column: 1 / -1; justify-self: start; }
    .pf .badges { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .gtf-pop .gp-body { grid-template-columns: 1fr; justify-items: center; }
    .gtf-pop .gp-info { width: 100%; text-align: center; }
    .gtf-pop .gp-items li { text-align: start; }
    .gtf-pop .gp-acts { justify-content: center; }
  }
</style>
<main class="ds-page pf" data-profile="<%= usernameProfile %>">
  <section class="card hero cx-host">
    <% if (cxBanner) { %><div class="cx-banner" style="<%= cxBanner.css %>" aria-hidden="true"></div><% } %>
    <% if (cxFx) { %><div class="cx-fx cx-fx-<%= cxFx.effect %>" aria-hidden="true"></div><% } %>
    <div class="pf-face">
      <span class="cx-av">
        <% if (cxDeco && cxDeco.conic) { %><span class="cx-conic<%= cxDeco.spin ? ' cx-spin' : '' %>" style="<%= cxDeco.conic %>" aria-hidden="true"></span><% } %>
        <img class="avatar" src="<%= avatar %>" alt="<%- t('profile.avatar_alt', { name: usernameProfile }) %>" onerror="this.src='/public/img/avatar.png'"<% if (cxDeco && cxDeco.ring) { %> style="<%= cxDeco.ring %>"<% } %>>
        <% if (cxDeco && cxDeco.emoji) { %><span class="cx-emoji" aria-hidden="true"><%= cxDeco.emoji %></span><% } %>
      </span>
      <% if (showAv) { %>
        <button type="button" class="pf-gtfmini<%= av.svg ? '' : ' empty' %>" popovertarget="gtfPop" data-gtf-open
                style="--rc:<%= top ? top.color : '#3a3a3a' %>" title="<%- t('profile.gtf.wardrobe_title', { label: gtfLabel }) %>" aria-label="<%- t('profile.gtf.open_aria', { name: displayname || usernameProfile }) %>"><% if (av.svg) { %><%- av.svg %><% } else { %><span aria-hidden="true">🐸</span><% } %></button>
      <% } %>
    </div>
    <div class="who">
      <h1><% if (cxName && cxName.css) { %><span class="cx-name" style="<%= cxName.css %>"><%= displayname || usernameProfile %></span><% } else { %><%= displayname || usernameProfile %><% } %></h1>
      <div class="handle">@<%= usernameProfile %><% if (cf) { %> · 🐸 <%- t('profile.on_camfrog', { name: cf }) %><% } %></div>
      <div class="chips">
        <% if (role && role !== 'pleb') { %><span class="chip <%= role %>"><%= classh %></span><% } %>
        <% if (pc && pc.seasonPass) { %><a class="chip" href="/premium" title="<%- t('profile.has_season_pass') %>" style="background:linear-gradient(90deg,#9b5de5,#ff6ad5);color:#fff;text-decoration:none">🎟️ Season Pass</a><% } %>
        <% const crP_ = locals.creatorProfile || { on: false }; if (crP_.badge) { %><a class="chip" href="/creators/<%= encodeURIComponent(usernameProfile) %>" title="<%- t('cr.badge_title') %>" style="background:linear-gradient(90deg,#ff5fa2,#ffb36b);color:#2a0016;text-decoration:none">⭐ <%- t('cr.links.creator_chip') %></a><% } %>
        <% if (pc && pc.supporter) { %><a class="chip" href="/support" title="<%- t('supporter.chip_title') %>" style="background:<%= pc.supporter.color %>;color:#1a1200;text-decoration:none"><%= pc.supporter.emoji %> <%- t('supporter.chip') %></a><% } %>
        <% if (pc && pc.plex) { %><a class="chip" href="/subscriptions" title="<%- t('profile.plex_member') %>" style="background:linear-gradient(90deg,#cc7b19,#e5a00d);color:#1a1200;text-decoration:none"><%- t('profile.plex_chip') %></a><% } %>
        <% if (showAv) { %><button type="button" class="chip gtfc" popovertarget="gtfPop" data-gtf-open style="--rc:<%= top ? top.color : '#3a3a1c' %>">🎮 <%- gtfLabel %></button><% } else if (sheet && sheet.cls) { %><span class="chip">🥷 <%= sheet.cls %></span><% } %>
      </div>
      <% if (cxShow.length) { %>
        <div class="showcase" aria-label="<%- t('profile.pinned_badges') %>">
          <% cxShow.forEach((b) => { %><span class="pin" title="<%= b.description %>"><img src="<%= b.icon %>" alt=""><%= b.name %></span><% }) %>
        </div>
      <% } %>
    </div>
    <div class="pf-strip" aria-label="<%- t('profile.stats_aria') %>">
      <% if (L.show('stats') && L.show('stats_balance')) { const h_ = L.hidden('stats') || L.hidden('stats_balance'); %>
        <div class="ps<%= h_ ? ' is-hidden' : '' %>"<%- h_ ? ' title="' + t('profile.hidden_from_visitors') + '"' : '' %>><span class="k">PAT</span><b class="gold"><%= fmt(points_balance) %></b></div>
      <% } %>
      <div class="ps lv<%= L.show('level') && L.hidden('level') ? ' is-hidden' : '' %>" title="<%- t('profile.level_title') %>">
        <span class="k"><%- t('profile.level') %></span>
        <span class="lv-row"><b><%= level %></b><% if (L.show('level')) { %><small><%= fmt(xp) %> / <%= fmt(need) %> XP</small><% } %></span>
        <% if (L.show('level')) { %><div class="xb" role="progressbar" aria-label="<%- t('profile.xp_to_level', { n: level + 1 }) %>" aria-valuenow="<%= Math.round(pct) %>" aria-valuemin="0" aria-valuemax="100"><span style="width: <%= pct.toFixed(1) %>%"></span></div><% } %>
      </div>
      <% if (L.show('stats')) { %>
        <a class="ps<%= L.hidden('stats') ? ' is-hidden' : '' %>" href="/achievements?user=<%= enc %>"><span class="k"><%- t('profile.badges') %></span><b><%= badges.length %></b></a>
      <% } %>
      <% if (soc) { %><%- include('partials/profile-follow', { social: soc, usernameProfile, previewing, part: 'stat' }) %><% } %>
    </div>
    <div class="actions">
      <% if (isMe) { %>
        <a class="btn primary" href="/u/<%= encodeURIComponent(username) %>/edit"><span class="ds-ic" aria-hidden="true">✏️</span> <%- t('profile.edit_profile') %></a>
        <a class="btn" href="/wallet"><span class="ds-ic" aria-hidden="true">👛</span> <%- t('profile.wallet') %></a>
      <% } else if (!previewing) { %>
        <% if (soc) { %><%- include('partials/profile-follow', { social: soc, usernameProfile, previewing, part: 'actions' }) %><% } %>
        <% if ((locals.creatorProfile || {}).active) { %><a class="btn primary" href="/creators/<%= enc %>"><span class="ds-ic" aria-hidden="true">⭐</span> <%- t('cr.links.subscribe') %></a><% } %>
        <a class="btn<%= soc ? '' : ' primary' %>" href="/u/<%= enc %>/tip" title="<%- t('profile.tip_title', { name: displayname || usernameProfile }) %>"><span class="ds-ic" aria-hidden="true">💸</span> <%- t('profile.tip') %></a>
      <% } %>
      <details class="pf-more" data-pf-more>
        <summary class="btn" aria-haspopup="menu"><span aria-hidden="true">⋯</span> <%- t('profile.more') %><% if (tipNew > 0) { %> <span class="tj-new" title="<%- t('profile.new_tips_title') %>"><%= tipNew > 99 ? '99+' : tipNew %></span><% } %></summary>
        <div class="pf-menu" role="menu">
          <% if (isMe) { %>
            <% (typeof myPads === 'function' ? myPads(username) : []).forEach((p_) => { %><a role="menuitem" href="<%= p_.href %>">👑 <%- t('profile.menu.owner_panel', { pad: t.esc(p_.title) }) %></a><% }) %>
            <a role="menuitem" href="/u/<%= enc %>/tip">💰 <%- t('profile.menu.tip_jar') %><% if (tipNew > 0) { %> <span class="tj-new"><%- t('profile.menu.n_new', { n: tipNew > 99 ? '99+' : tipNew }) %></span><% } %></a>
            <a role="menuitem" href="/history"><span class="ds-ic" aria-hidden="true">📜</span> <%- t('profile.menu.pat_history') %></a>
            <% if (soc) { %><a role="menuitem" href="/feed/following"><span class="ds-ic" aria-hidden="true">⭐</span> <%- t('profile.menu.follow_lists') %></a><% } %>
            <a role="menuitem" href="/achievements?user=<%= enc %>">🏅 <%- t('profile.menu.achievements') %></a>
            <a role="menuitem" href="/cosmetics?tab=mine#tabs"><span class="ds-ic" aria-hidden="true">🎨</span> <%- t('profile.menu.cosmetics') %></a>
            <a role="menuitem" href="/premium"><span class="ds-ic" aria-hidden="true">🎟️</span> <%- t('profile.menu.season_pass') %></a>
            <a role="menuitem" href="/subscriptions"><span class="ds-ic" aria-hidden="true">🔁</span> <%- t('subs.title') %></a>
            <%# 1.99ta: your voice (voice store + !clonemyvoice status) and the likeness opt-outs %>
            <a role="menuitem" href="/voices/mine"><span class="ds-ic" aria-hidden="true">🗣️</span> <%- t('vs.mine_link') %></a>
            <a role="menuitem" href="/voices/clone"><span class="ds-ic" aria-hidden="true">🎙️</span> <%- t('vc.title') %></a>
            <a role="menuitem" href="/settings/likeness"><span class="ds-ic" aria-hidden="true">🪞</span> <%- t('settings.privacy.likeness') %></a>
            <% const crMe_ = locals.creatorProfile || { on: false }; if (crMe_.on) { %><a role="menuitem" href="<%= crMe_.badge ? '/creator' : '/creators#apply' %>"><span class="ds-ic" aria-hidden="true">⭐</span> <%- crMe_.badge ? t('nav.creator_dash') : t('nav.become_creator') %></a><% } %>
            <% if (showAv) { %><button type="button" role="menuitem" popovertarget="gtfPop" data-gtf-open><span class="ds-ic" aria-hidden="true">🎮</span> <%- t('profile.menu.gtf_wardrobe') %></button><% } %>
            <hr>
            <form action="/logout" method="POST"><button type="submit" role="menuitem"><span class="ds-ic" aria-hidden="true">↪</span> <%- t('profile.menu.logout') %></button></form>
          <% } else { %>
            <a role="menuitem" href="/achievements?user=<%= enc %>">🏅 <%- t('profile.menu.achievements') %></a>
            <% if (typeof canSeeHistory !== 'undefined' && canSeeHistory) { %><a role="menuitem" href="/history?user=<%= enc %>">📜 <%- t('profile.menu.pat_history') %></a><% } %>
            <% if (showAv) { %><button type="button" role="menuitem" popovertarget="gtfPop" data-gtf-open><span class="ds-ic" aria-hidden="true">🎮</span> <%- t('profile.gtf.avatar') %></button><% } %>
            <% if (soc) { %><%- include('partials/profile-follow', { social: soc, usernameProfile, previewing, part: 'menu' }) %><% } %>
          <% } %>
          <% if (typeof viewerIsAdmin !== 'undefined' && viewerIsAdmin) { %><hr><a role="menuitem" href="/admin/comps?user=<%= enc %>">🎁 <%- t('profile.menu.comp') %></a><% } %>
        </div>
      </details>
    </div>
    <% if (cxBorder) { %><div class="cx-frame <%= cxBorder.cls %>" style="<%= cxBorder.css %>" aria-hidden="true"></div><% } %>
  </section>

  <%# 1.99ez: their story ring (own uploads + captures of them, userstories.js); the owner adds stories and picks whether
      captures of them show here %>
  <% const pst_ = typeof profileStory !== 'undefined' && profileStory ? profileStory : null; %>
  <% if (!vaultView_ && pst_ && (pst_.rooms.length || pst_.owner)) { %>
    <section class="card pf-story" aria-label="<%- t('profile.story.aria') %>">
      <%- include('partials/story-strip', { story: { rooms: pst_.rooms, caps: [], room: null, signed: pst_.signed, compose: pst_.owner, pad: 'profile' }, heading: '📸 ' + t('profile.story.heading'), next: base }) %>
      <% if (pst_.owner && pst_.prefs) { %>
        <label class="ds-check pf-story-set"><input type="checkbox" data-story-pref="capturesOfMe"<%= pst_.prefs.capturesOfMe ? ' checked' : '' %>> <%- t('profile.story.captures_pref') %></label>
        <script>
          (function () {
            var _t = typeof __t === 'function' ? __t : function (k, d, v) { return String(d).replace(/\{!?(\w+)\}/g, function (m, n) { return v && v[n] != null ? v[n] : m; }); };
            var c = document.querySelector('[data-story-pref="capturesOfMe"]');
            if (!c) return;
            c.addEventListener('change', function () {
              c.disabled = true;
              fetch('/api/stories/prefs', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' },
                body: JSON.stringify({ capturesOfMe: c.checked }) }).then(function (r) { return r.json(); })
                .then(function (d) { c.disabled = false; if (!d.ok) { c.checked = !c.checked; alert(d.error || _t('js.profile.not_saved', 'Not saved.')); } else location.reload(); })
                .catch(function () { c.disabled = false; c.checked = !c.checked; });
            });
          })();
        </script>
      <% } %>
    </section>
  <% } %>

  <% if (previewing) { %>
    <div class="pf-bar preview" role="status"><span>👁 <%- t('profile.bar.previewing') %></span>
      <span class="btns"><a class="btn" href="<%= tabHref(active === 'posts' ? '' : active) %>"><%- t('profile.bar.back') %></a><a class="btn" href="<%= base %>/edit#layout"><%- t('profile.bar.edit_layout') %></a></span></div>
  <% } else if (L.seesHidden && L.anyHidden) { %>
    <div class="pf-bar"><span>👁 <%- isMe ? t('profile.bar.greyed') : t('profile.bar.greyed_admin') %></span>
      <% if (isMe) { %><span class="btns"><a class="btn" href="<%= base %>?preview=visitor"><%- t('profile.bar.preview') %></a><a class="btn" href="<%= base %>/edit#layout"><%- t('profile.bar.edit_layout') %></a></span><% } %></div>
  <% } %>

  <%
    const SEC = {};
    SEC.analytics = function () { %>
  <% if (typeof analytics !== 'undefined' && analytics && !analytics.empty) { %>
    <%- include('partials/user-analytics', { a: analytics, L }) %>
  <% } else if (typeof analytics !== 'undefined' && analytics && analytics.empty) { %>
    <section class="card" id="analytics"><h2><%- t('profile.analytics') %></h2><p class="muted" style="margin:0"><%- t('profile.analytics.empty', { name: cf }) %></p></section>
  <% } else if (isMe && !cf) { %>
    <section class="card" id="analytics"><h2><%- t('profile.analytics') %></h2><p class="muted" style="margin:0"><%- t('profile.analytics.unlinked') %></p></section>
  <% } %>
  <% };
    SEC.plex = function () { %>
  <%- include('partials/profile-plex', { px: plexProfile, L }) %>
  <% };
    SEC.gtf = function () { %>
  <section class="card" id="gtf">
    <h2>Grand Theft Frogger</h2>
    <div class="gtf">
      <% if (showAv) { %>
        <button type="button" class="gtf-port" popovertarget="gtfPop" data-gtf-open style="--rc:<%= top ? top.color : '#2a2a2a' %>" aria-label="<%- t('profile.gtf.open_the') %>"><% if (av.svg) { %><%- av.svg %><% } else { %><span aria-hidden="true">🐸</span><% } %></button>
      <% } else { %><span></span><% } %>
      <div>
        <% if (sheet) { %>
          <div class="gtf-sheet"><span class="ds-ic" aria-hidden="true">🥷</span> <a href="<%= sheet.url %>"><%- t('profile.gtf.heist_sheet') %></a><%= sheet.cls ? ' · ' + sheet.cls : '' %><% if (showAv) { %> · <span class="muted"><%- configured ? t('profile.gtf.n_items', { count: avItems.length }) : t('profile.gtf.no_items') %></span><% } %></div>
        <% } else { %>
          <div class="muted gtf-sheet"><%- t('profile.gtf.no_sheet') %></div>
        <% } %>
        <% if (typeof gtf !== 'undefined' && gtf) { %>
          <div class="links">
            <a href="/gtf"><%- t('profile.gtf.what') %></a><a href="<%= gtf.heistHelp %>"><%- t('profile.gtf.heists') %></a><a href="<%= gtf.turfGuide %>"><%- t('profile.gtf.turf_wars') %></a>
            <a href="<%= gtf.turfMap %>"><%- t('profile.gtf.turf_map') %></a><a href="<%= gtf.gangs %>"><%- t('profile.gtf.gangs') %></a><a href="/bounties"><%- t('profile.gtf.bounties') %></a>
          </div>
        <% } %>
      </div>
      <% if (sheet) { %><a class="btn" href="<%= sheet.url %>"><%- t('profile.gtf.open_sheet') %></a><% } %>
    </div>
  </section>
  <% };
    SEC.posts = function () { %>
  <%- include('partials/profile-posts', { social, usernameProfile, displayname, isMe }) %>
  <% };
    SEC.badges = function () { %>
  <section class="card" id="badges">
    <h2><%- t('profile.badges') %></h2>
    <% if (!badges.length) { %>
      <p class="muted" style="margin:0"><%- t('profile.badges.none') %> <a href="/achievements"><%- t('profile.badges.how') %></a></p>
    <% } else { %>
      <div class="badges">
        <% badges.forEach((badge) => { %>
          <div class="badge" title="<%= badge.description %>"><img src="<%= badge.icon %>" alt=""><span><%= badge.name %></span></div>
        <% }) %>
      </div>
    <% } %>
  </section>
  <% };
  %>
  <% if (vaultView_) { %>
    <%# 1.99vy: /u/<name>/vault - the tab bar as plain links back to the profile (no panels here), then the vault card %>
    <nav class="pf-tabs" aria-label="<%- t('profile.tabs_aria') %>">
      <% tabs.forEach((tb) => { %>
        <a class="pf-tab<%= tb.hidden ? ' is-hidden' : '' %>" href="<%= tabHref(tb.id) %>"><span aria-hidden="true"><%= tb.icon %></span><%- t.has('profile.tab.' + tb.id) ? t('profile.tab.' + tb.id) : t.esc(tb.label) %></a>
      <% }) %>
      <a class="pf-tab pf-vault" href="<%= vaultHref %>" aria-current="page"><span aria-hidden="true">💰</span><%- t('profile.tab.vault') %></a>
      <% if (isMe) { %><a class="pf-tab" href="<%= base %>/saved" title="<%- t('profile.tab.saved_title') %>"><span aria-hidden="true">🔖</span><%- t('profile.tab.saved') %></a><% } %>
    </nav>
    <div class="pf-panel pf-vaultpage">
      <%- include('partials/profile-vault-card', { rv: pv.card, slug: pv.slug, name: displayname || usernameProfile, uname: usernameProfile,
                   signed: !!username, isMe, num: (n) => Math.round(Number(n) || 0).toLocaleString('en-US') }) %>
    </div>
    <script src="/public/js/pad-vault.js?v=2" defer></script>
  <% } else if (tabs.length) { %>
    <nav class="pf-tabs" role="tablist" aria-label="<%- t('profile.tabs_aria') %>">
      <% tabs.forEach((tb) => { %>
        <a class="pf-tab<%= tb.hidden ? ' is-hidden' : '' %>" role="tab" id="tb-<%= tb.id %>" href="<%= tabHref(tb.id) %>" data-tab="<%= tb.id %>" aria-controls="tab-<%= tb.id %>"
           aria-selected="<%= tb.id === active ? 'true' : 'false' %>" tabindex="<%= tb.id === active ? '0' : '-1' %>"<%- tb.hidden ? ' title="' + t('profile.hidden_from_visitors') + '"' : '' %>><span aria-hidden="true"><%= tb.icon %></span><%- t.has('profile.tab.' + tb.id) ? t('profile.tab.' + tb.id) : t.esc(tb.label) %><% if (tb.hidden) { %> <span class="eye" aria-label="<%- t('profile.hidden_from_visitors_lc') %>">👁</span><% } %></a>
      <% }) %>
      <%# 1.99vy: 💰 the profile vault - a link to its own page (an old #vault link is sent there by profile-tabs.js) %>
      <% if (pv) { %><a class="pf-tab pf-vault" href="<%= vaultHref %>" data-vault-link title="<%- t('profile.tab.vault_title') %>"><span aria-hidden="true">💰</span><%- t('profile.tab.vault') %></a><% } %>
      <%# 1.99eq: the owner's private Saved captures (storykeep.js) - a page of its own, never shown to visitors %>
      <% if (isMe) { %><a class="pf-tab" href="<%= base %>/saved" title="<%- t('profile.tab.saved_title') %>"><span aria-hidden="true">🔖</span><%- t('profile.tab.saved') %></a><% } %>
    </nav>
    <% tabs.forEach((tb) => { %>
      <div class="pf-panel" role="tabpanel" id="tab-<%= tb.id %>" aria-labelledby="tb-<%= tb.id %>" data-panel="<%= tb.id %>"<%= tb.id === active ? '' : ' hidden' %>>
        <% tb.sections.forEach((id) => { %>
          <div class="pf-slot<%= L.hidden(id) ? ' is-hidden' : '' %>" data-sec="<%= id %>"><%- hidTag(id) %>
          <% SEC[id](); %>
          </div>
        <% }) %>
      </div>
    <% }) %>
  <% } else { %>
    <p class="pf-empty"><%- t('profile.nothing_else') %></p>
  <% } %>
</main>

<% if (showAv) { %>
<div id="gtfPop" class="gtf-pop" popover aria-label="<%- t('profile.gtf.pop_aria') %>" data-gtf-pop data-gtf-state="<%= configured ? 'configured' : 'unconfigured' %>">
  <div class="gp-head"><h2>🎮 Grand Theft Frogger</h2><button type="button" class="gp-x" popovertarget="gtfPop" popovertargetaction="hide" aria-label="<%- t('profile.close') %>">×</button></div>
  <div class="gp-body">
    <div class="gp-frame<%= av.svg ? '' : ' empty' %>" style="--rc:<%= top ? top.color : '#2a2a2a' %>"><% if (av.svg) { %><%- av.svg %><% } else { %><span aria-hidden="true">🐸</span><% } %></div>
    <div class="gp-info">
      <div class="gp-who"><%= displayname || usernameProfile %></div>
      <% if (sheet && sheet.cls) { %><span class="gp-role" title="<%- t('profile.gtf.heist_role') %>">🥷 <%= sheet.cls %></span><% } %>
      <% if (!av.svg) { %>
        <p class="gp-none"><%- isMe ? t('profile.gtf.no_avatar_me') : t('profile.gtf.no_avatar_them') %></p>
      <% } else if (configured) { %>
        <ul class="gp-items" aria-label="<%- t('profile.gtf.wardrobe') %>">
          <% avItems.forEach((it) => { %>
            <li style="--rc:<%= it.color %>" title="<%= it.desc %>"><span class="gp-slot"><%= it.slot %></span><span class="gp-name"><%= it.emoji %> <%= it.name %></span><span class="gp-rar"><%= it.rarity %></span></li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="gp-none"><%- isMe ? t('profile.gtf.not_wearing_me') : t('profile.gtf.not_wearing') %></p>
      <% } %>
    </div>
    <div class="gp-acts">
      <% if (isMe) { %><a class="btn<%= configured ? '' : ' primary' %>" href="/cosmetics?tab=mine#tabs"><span class="ds-ic" aria-hidden="true">🎨</span> <%- t('profile.gtf.change_look') %></a><% } else { %><a class="btn" href="/cosmetics"><span class="ds-ic" aria-hidden="true">🎨</span> <%- t('profile.gtf.gtf_wardrobe') %></a><% } %>
      <% if (sheet) { %><a class="btn" href="<%= sheet.url %>"><span class="ds-ic" aria-hidden="true">🥷</span> <%- t('profile.gtf.heist_sheet') %></a><% } %>
    </div>
    <% if (isMe && av.svg && cf) { %>
      <details class="gp-regen">
        <summary class="btn"><span class="ds-ic" aria-hidden="true">🎲</span> <%- t('profile.gtf.new_avatar') %></summary>
        <p><%- t('profile.gtf.regen_info') %></p>
        <form method="post" action="/act">
          <input type="hidden" name="kind" value="cmd">
          <input type="hidden" name="cmd" value="avatar">
          <input type="hidden" name="a0" value="regen">
          <input type="hidden" name="tag" value="avatar">
          <input type="hidden" name="label" value="New GTF avatar">
          <input type="hidden" name="back" value="<%= base %>?gtf=1">
          <button class="btn" type="submit"><%- t('profile.gtf.regen_yes') %></button>
        </form>
      </details>
    <% } %>
    <% if (isMe && typeof avatarActs !== 'undefined') { %><div class="gp-log"><%- include('partials/actions', { acts, msg: typeof avatarMsg !== 'undefined' ? avatarMsg : '' }) %></div><% } %>
  </div>
</div>
<% } %>
<script src="/public/js/profile-tabs.js?v=3" defer></script>
</body>
</html>
