<%- include('layout', { title: item ? ((item.kind === 'clip' ? 'Clip' : item.kind === 'audio' ? 'Audio' : 'Snap') + ' of ' + (item.subject || 'someone')) : 'Expired', user: user}) %>
<style>
  .md { max-width: 900px; margin: 0 auto; padding: 0 16px 48px; font-family: Ubuntu, sans-serif; text-align: center; }
  .md .stage { background: #000; border-radius: 10px; overflow: hidden; margin: 18px 0 12px; }
  .md .stage img, .md .stage video { width: 100%; max-height: 75vh; object-fit: contain; display: block; }
  .md .stage audio { width: 94%; margin: 28px 0; }
  .md .meta { color: #ccc; font-size: 14px; line-height: 1.7; }
  .md .meta b { color: #fff; }
  .md .mut { color: #888; }
  .md a { color: #81c784; }
</style>
<div class="md">
  <% if (!item) { %>
    <h1><%= gone === 410 ? 'This capture has expired' : 'Not found' %></h1>
    <p class="mut">Snaps and clips only live for a while. <a href="/feed">See what's on the feed</a>.</p>
  <% } else { const src = '/media/' + item.id + '/raw'; %>
    <div class="stage">
      <% if (item.kind === 'clip') { %>
        <video src="<%= src %>" controls playsinline preload="metadata"></video>
      <% } else if (item.kind === 'audio') { %>
        <audio src="<%= src %>" controls preload="metadata"></audio>
      <% } else { %>
        <img src="<%= src %>" alt="Snap of <%= item.subject %>">
      <% } %>
    </div>
    <div class="meta">
      <div><b><%= item.subject || 'someone' %></b> in <b><%= item.room || 'a room' %></b><%= item.secs ? ' · ' + Math.round(item.secs) + 's' : '' %></div>
      <div class="mut">Captured by <%= item.by_user || '?' %> · <%= new Date(item.created).toUTCString() %> · expires in <%= item.ttl %></div>
      <div><a href="/feed">More clips &amp; snaps ›</a></div>
    </div>
  <% } %>
</div>
</body>
</html>
