<% const stage_ = !!(item && item.source === 'stage'); const user_ = !!(item && item.source === 'user'); const what_ = item ? (user_ ? 'Story' : stage_ ? (item.kind === 'clip' ? 'Stage clip' : 'Stage snap') : (item.kind === 'clip' ? 'Clip' : item.kind === 'audio' ? 'Audio' : 'Snap')) : ''; %>
<%- include('layout', { title: item ? (user_ ? 'Story by ' + (item.by_user || 'someone') : what_ + ' of ' + (item.subject || 'someone')) : (typeof adult !== 'undefined' && adult ? '18+' : 'Expired'), user: user}) %>
<style>
  /* 1.99qd: .ds-page.mid (docs/design-system.md, "Area notes: feed, pads and social") */
  .md { text-align: center; gap: var(--ds-sp-3); }
  .md h1 { margin: 0; }
  .md .stage { position: relative; background: #000; border-radius: var(--ds-r-xl); overflow: hidden; margin: 0; border: 1px solid var(--ds-line); }
  .md .stage img, .md .stage video { width: 100%; max-height: 75vh; object-fit: contain; display: block; }
  .md .stage audio { width: 94%; margin: 28px 0; }
  .md .stage img.wave { max-width: 480px; margin: 18px auto 0; border-radius: 8px; }
  .md .stage.nsfw img, .md .stage.nsfw video { filter: blur(28px); }
  .md .stage .gate { position: absolute; inset: 0; display: grid; place-content: center; gap: 10px; background: rgba(0,0,0,.45); color: #fff; font-size: 15px; }
  .md .stage .gate button { justify-self: center; min-height: var(--ds-tap); padding: 0 var(--ds-sp-5); border-radius: var(--ds-r-pill); border: 1px solid #e57373; background: #2a1010; color: #ffcdd2; font: inherit; font-weight: bold; cursor: pointer; }
  .md .stage:not(.nsfw) .gate { display: none; }
  .md .meta { display: grid; gap: var(--ds-sp-1); justify-items: center; color: var(--ds-text-2); font-size: var(--ds-fs-sm); line-height: 1.7; }
  .md .meta b { color: #fff; }
  .md .mut { color: var(--ds-text-muted); }
  .md a { color: var(--ds-green-2); }
  .md .tag { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 12px; border: 1px solid #2a3442; color: #9fb3c8; margin-right: 6px; }
  .md .tag.x { border-color: #5a2222; color: #ffb4b4; }
  .md .del { margin-top: var(--ds-sp-2); }
  .md .stage .gate button:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
</style>
<main class="ds-page mid md">
  <% if (!item && typeof adult !== 'undefined' && (adult === 'signin' || adult === 'confirm')) { %>
    <%# adultgate site: a capture of an 18+ pad, owner switch on - sign in / confirm your age (no picture, no names) %>
    <%- include('partials/adult-gate', { gate: adult, next: typeof adultNext !== 'undefined' ? adultNext : '/', tag: 'section' }) %>
  <% } else if (!item) { %>
    <h1 class="ds-h1"><%= gone === 410 ? 'This capture has expired' : 'Not found' %></h1>
    <p class="mut">Snaps and clips only live for a while. <a href="/feed">See what's on the feed</a>.</p>
  <% } else { const src = '/media/' + item.id + '/raw'; const nsfw_ = !!item.nsfw; %>
    <div class="stage<%= nsfw_ ? ' nsfw' : '' %>" id="mdStage">
      <% if (item.kind === 'clip') { %>
        <video src="<%= src %>" controls playsinline preload="metadata"<% if (typeof poster !== 'undefined' && poster) { %> poster="<%= poster %>"<% } %>></video>
      <% } else if (item.kind === 'audio') { %>
<% if (typeof poster !== 'undefined' && poster) { %><img class="wave" src="<%= poster %>" alt="" onerror="this.remove()"><% } %>
        <audio src="<%= src %>" controls preload="metadata"></audio>
      <% } else { %>
        <img src="<%= src %>" alt="<%= what_ %> of <%= item.subject || 'someone' %>">
      <% } %>
      <div class="gate"><span><span class="ds-ic" aria-hidden="true">🔞</span> Marked NSFW by the streamer</span><button type="button" id="mdReveal">Show it (18+)</button></div>
    </div>
    <div class="meta">
      <div><% if (stage_) { %><span class="tag">📺 Stage <%= item.kind === 'clip' ? 'clip' : 'snap' %></span><% } %><% if (nsfw_) { %><span class="tag x">NSFW</span><% } %>
        <% if (user_) { %><span class="tag">✨ Story</span> by <% } %><b><%= user_ ? (item.by_user || 'someone') : (item.subject || 'someone') %></b> <%= stage_ ? 'on the stage of' : 'in' %> <% if (typeof pad !== 'undefined' && pad) { %><a href="<%= pad.href %>"><b><%= pad.title %></b></a><% } else { %><b><%= item.room || 'a room' %></b><% } %><%= item.secs ? ' · ' + Math.round(item.secs) + 's' : '' %></div>
      <div class="mut"><%= user_ ? 'Posted' : (stage_ ? (item.kind === 'clip' ? 'Clipped' : 'Snapped') : 'Captured') + ' by ' + (item.by_user || '?') %> · <%= new Date(item.created).toUTCString() %> · expires in <%= item.ttl %></div>
      <div><% if (stage_) { %><a href="/stage/captures">More stage snaps &amp; clips ›</a> · <% } %><a href="/feed">More clips &amp; snaps ›</a></div>
      <% if (typeof canDelete !== 'undefined' && canDelete) { %><button type="button" class="ds-btn danger sm del" id="mdDel" data-id="<%= item.id %>"><span class="ds-ic" aria-hidden="true">🗑️</span>Delete this <%= user_ ? 'story' : 'capture' %></button><% } %>
    </div>
    <script>
    (function () {
      var r = document.getElementById('mdReveal');
      if (r) r.addEventListener('click', function () { document.getElementById('mdStage').classList.remove('nsfw'); });
      var d = document.getElementById('mdDel');
      if (d) d.addEventListener('click', function () {
        if (!confirm('Delete this capture for everyone? This can\'t be undone.')) return;
        d.disabled = true;
        fetch('/api/stage/captures/media/' + encodeURIComponent(d.getAttribute('data-id')) + '/delete', { method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' }, body: '{}' })
          .then(function (x) { return x.json(); })
          .then(function (j) { if (j.ok) location.href = '/stage/captures'; else { alert(j.error || 'Could not delete it.'); d.disabled = false; } })
          .catch(function () { alert('Could not reach the site.'); d.disabled = false; });
      });
    })();
    </script>
  <% } %>
</main>
</body>
</html>
