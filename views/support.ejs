</style>
<main class="ds-page sp" id="support" data-rate="<%= R %>" data-bonus="<%= BP %>" data-min="<%= min %>" data-max="<%= max %>" data-cardmax="<%= cardMax %>">
  <% if (preview) { %><div class="ds-note warn preview"><span class="ds-ic" aria-hidden="true">👁️</span><div><%- t('support.preview') %></div></div><% } %>

  <% if (D.result === 'success') { %>
  <section class="thanks" id="thanks" role="status" data-celebrate>
    <div class="big" aria-hidden="true">🎉</div>
    <h2 class="ds-h2"><%- t('support.thanks_title') %></h2>
    <% if (locals.thanks && thanks.pat) { %>
      <p><%- t('support.thanks_credited', { pat: '<b>' + num(thanks.pat) + '</b>' }) %></p>
    <% } else { %>
      <p><%- t('donate.thanks') %></p>
    <% } %>
    <p><%- t('support.thanks_pot', { bonus: BP }) %></p>
    <div class="row" style="justify-content:center;margin-block-start:var(--ds-sp-2)"><a class="ds-btn quiet" href="/wallet"><span class="ds-ic" aria-hidden="true">👛</span> <%- t('support.thanks_wallet') %></a></div>
  </section>
  <% } else if (D.result === 'cancel') { %>
  <p class="cancel" role="status"><%- t('donate.cancelled') %></p>
  <% } %>

  <section class="ds-hero hero" aria-labelledby="spT">
    <div class="frog" aria-hidden="true">🐸</div>
    <p class="ds-eyebrow" style="margin:0"><%- t('support.hero_eyebrow') %></p>
    <h1 id="spT"><%- t('support.hero_title') %></h1>
    <p class="ds-lead"><%- t('support.hero_lead') %></p>
    <p class="deal"><span><%- t('support.hero_deal', { rate: '<b>' + num(R) + '</b>' }) %></span><span class="plus"><%- t('support.hero_deal_pot', { bonus: BP }) %></span></p>
    <div class="ds-ctas">
      <a class="ds-btn lg big" href="#give"><span class="ds-ic" aria-hidden="true">💖</span> <%- t('support.hero_cta') %></a>
      <a class="ds-btn lg ghost" href="#where"><%- t('support.hero_cta2') %></a>
    </div>
    <ul class="mini">
      <li><span class="ds-ic" aria-hidden="true">🔒</span> <%- t('support.mini_keys') %></li>
      <li><span class="ds-ic" aria-hidden="true">📬</span> <%- t('support.mini_receipt') %></li>
      <li><span class="ds-ic" aria-hidden="true">🪙</span> <%- t('support.mini_pot') %></li>
    </ul>
    <% if (SP.goal) { %>
    <div class="meter" id="spGoal">
      <div class="bar" role="progressbar" aria-valuemin="0" aria-valuemax="<%= SP.goal.goal %>" aria-valuenow="<%= Math.min(SP.goal.usd, SP.goal.goal) %>" aria-label="<%- t('support.goal_label') %>"><i style="width:<%= Math.max(2, SP.goal.pct) %>%"></i></div>
      <p><b><%- t('support.goal_label') %>:</b> <%- t('support.goal_text', { usd: num(SP.goal.usd), goal: num(SP.goal.goal), pct: SP.goal.pct }) %></p>
    </div>
    <% } %>
    <% if (SP.total) { %><p class="raised" id="spTotal"><span class="ds-ic" aria-hidden="true">💖</span> <%- t('support.total_text', { usd: num(SP.total.usd), count: SP.total.supporters }) %></p><% } %>
  </section>

  <section class="card" id="give" aria-labelledby="amtT">
    <h2 class="ds-h2" id="amtT"><span class="n" aria-hidden="true">1</span><%- t('support.amt_title') %></h2>
    <div class="tiers" role="radiogroup" aria-labelledby="amtT">
      <% TIERS.forEach(([usd, em, k, pop]) => { %>
      <label class="tier<%= pop ? ' on' : '' %>">
        <input type="radio" name="spAmt" value="<%= usd %>"<%= pop ? ' checked' : '' %>>
        <% if (pop) { %><span class="pop"><%- t('support.tier_popular') %></span><% } %>
        <span class="em" aria-hidden="true"><%= em %></span>
        <span class="nm"><%- t('support.tier.' + k) %></span>
        <span class="usd">$<%= usd %></span>
        <span class="pat"><%- t('support.tier_pat', { pat: num(patOf(usd)) }) %></span>
        <span class="bon"><%- t('support.tier_bonus', { bonus: num(bonusOf(usd)) }) %></span>
      </label>
      <% }) %>
      <label class="tier" id="spCustTier">
        <input type="radio" name="spAmt" value="custom">
        <span class="em" aria-hidden="true">✨</span>
        <span class="nm"><%- t('support.tier_custom') %></span>
        <span class="cust">$<input type="number" id="spCustom" min="1" max="<%= max %>" step="1" inputmode="numeric" placeholder="100" aria-label="<%- t('support.custom_label') %>"></span>
        <span class="pat" id="spCustPat"></span>
        <span class="bon" id="spCustBon"></span>
      </label>
    </div>
    <p class="sum" id="spSum" aria-live="polite"><%- t('support.sum', { usd: 10, pat: '<b>' + num(patOf(10)) + '</b>', bonus: '<span class="plus">' + num(bonusOf(10)) + '</span>' }) %></p>
  </section>

  <section class="card" id="pay" aria-labelledby="payT">
    <h2 class="ds-h2" id="payT"><span class="n" aria-hidden="true">2</span><%- t('support.pay_title') %></h2>
    <% if (cardOn && cryptoShown) { %>
    <div class="tabs" role="tablist" aria-labelledby="payT">
      <button type="button" class="tab" role="tab" id="tab-card" aria-controls="pane-card" aria-selected="<%= tab0 === 'card' %>" tabindex="<%= tab0 === 'card' ? 0 : -1 %>" data-tab="card"><span class="ds-ic lg" aria-hidden="true">💳</span><span><%- t('support.tab_card') %><small><%- t('support.tab_card_d') %></small></span></button>
      <button type="button" class="tab" role="tab" id="tab-crypto" aria-controls="pane-crypto" aria-selected="<%= tab0 === 'crypto' %>" tabindex="<%= tab0 === 'crypto' ? 0 : -1 %>" data-tab="crypto"><span class="ds-ic lg" aria-hidden="true">🪙</span><span><%- t('support.tab_crypto') %><small><%- t('support.tab_crypto_d') %></small></span></button>
    </div>
    <% } %>

    <% if (cardOn) { %>
    <div class="sp-pane" id="pane-card" role="tabpanel" aria-labelledby="<%= cryptoShown ? 'tab-card' : 'payT' %>"<%= tab0 !== 'card' ? ' hidden' : '' %>>
      <p class="mut"><%- t('support.card_lede') %></p>
      <% if (me) { %>
      <div class="row">
        <button type="button" class="ds-btn lg big" id="donateGo" data-back="/support"><span class="ds-ic" aria-hidden="true">💳</span> <span id="donateGoTxt"><%- t('support.card_button', { usd: 10 }) %></span></button>
        <% if (ST.test) { %><span class="tag"><%- t('premium.test_mode') %></span><% } %>
      </div>
      <% } else { %>
      <div class="row"><a class="ds-btn lg big" href="/login?next=%2Fsupport%23pay"><span class="ds-ic" aria-hidden="true">🔑</span> <%- t('support.card_signin') %></a></div>
      <% } %>
      <p class="msg" id="donateMsg" role="status" aria-live="polite"></p>
      <p class="secure"><span class="ds-ic" aria-hidden="true">🔒</span><span><%- t('support.card_secure') %></span></p>
      <p class="secure"><span class="ds-ic" aria-hidden="true">🚫</span><span><%- t('donate.no_cashout') %></span></p>
    </div>
    <% } %>

    <% if (cryptoShown) { %>
    <div class="sp-pane" id="pane-crypto" role="tabpanel" aria-labelledby="<%= cardOn ? 'tab-crypto' : 'payT' %>"<%= tab0 !== 'crypto' ? ' hidden' : '' %> data-crypto-box data-signed="<%= me ? 1 : 0 %>" data-families="<%= families.join(',') %>">
      <p class="mut"><%- t('support.crypto_lede') %></p>
      <ol class="steps">
        <li class="<%= wallets.length ? 'done' : '' %>">
          <h3><%- t('support.s1_title') %><% if (wallets.length) { %> <span class="tag ok"><%- t('support.s1_done') %></span><% } %></h3>
          <% if (!me) { %>
            <p class="mut"><%- t('support.sign_in', { link: '<a href="/login?next=%2Fsupport">' + t('support.sign_in_link') + '</a>' }) %></p>
          <% } else { %>
            <p class="mut"><%- t('support.s1_lede') %></p>
            <% if (wallets.length) { %>
            <ul class="wallets">
              <% wallets.forEach((w) => { %><li><span><%= w.family === 'evm' ? 'Ethereum / Base' : 'Solana' %> · <code><%= w.address %></code></span>
                <button type="button" class="ds-btn sm ghost" data-crypto-unlink="<%= w.id %>"><%- t('support.unlink') %></button></li><% }) %>
            </ul>
            <% } %>
            <% if (cryptoOn) { %>
            <div class="row" style="margin-block-start:var(--ds-sp-2h)">
              <button type="button" class="ds-btn sm quiet" data-crypto-link="evm"><span class="ds-ic" aria-hidden="true">🦊</span> <%- t('support.link_evm') %></button>
              <button type="button" class="ds-btn sm quiet" data-crypto-link="sol"><span class="ds-ic" aria-hidden="true">👻</span> <%- t('support.link_sol') %></button>
            </div>
            <% } %>
            <p class="msg status" data-crypto-msg role="status" aria-live="polite"></p>
          <% } %>
        </li>
        <li>
          <h3><%- t('support.s2_title') %></h3>
          <div class="pick">
            <div><span class="lbl" id="chainL"><%- t('support.pick_chain') %></span>
              <div class="seg" role="radiogroup" aria-labelledby="chainL">
                <% chains.forEach((c, i) => { %><label class="<%= i === 0 ? 'on' : '' %>"><input type="radio" name="spChain" value="<%= c.chain %>" data-family="<%= c.family %>" data-tokens="<%= c.tokens.map((x) => x.symbol).join(',') %>"<%= i === 0 ? ' checked' : '' %>><%= c.name %></label><% }) %>
              </div></div>
            <div><span class="lbl" id="tokL"><%- t('support.pick_token') %></span>
              <div class="seg" role="radiogroup" aria-labelledby="tokL" id="spTokens">
                <% ['USDC', 'USDT'].forEach((s, i) => { %><label class="<%= i === 0 ? 'on' : '' %>"><input type="radio" name="spToken" value="<%= s %>"<%= i === 0 ? ' checked' : '' %>><%= s %></label><% }) %>
              </div></div>
          </div>
          <% chains.forEach((c, i) => { %>
          <div class="dest" data-chain="<%= c.chain %>"<%= i ? ' hidden' : '' %>>
            <% if (c.qr) { %><div class="qr" role="img" aria-label="<%- t('support.qr_label', { chain: c.name }) %>"><%- c.qr %></div><% } %>
            <div class="addrbox">
              <p class="send"><%- t('support.send_line', { amount: '<b data-send-amt>10</b>', token: '<b data-send-tok>USDC</b>', chain: c.name }) %></p>
              <code class="addr"><%= c.address %></code>
              <div class="row" style="margin-block-start:var(--ds-sp-2)"><button type="button" class="ds-btn sm quiet" data-copy="<%= c.address %>"><span class="ds-ic" aria-hidden="true">📋</span> <%- t('support.copy') %></button></div>
              <% c.tokens.forEach((tk, j) => { %><p class="contract" data-token="<%= tk.symbol %>"<%= j ? ' hidden' : '' %>><%- t('support.contract_line', { token: tk.symbol, chain: c.name }) %> <code><%= tk.address %></code></p><% }) %>
            </div>
          </div>
          <% }) %>
          <p class="famhint" id="spFamHint" role="status"></p>
          <div class="warn">
            <b><span class="ds-ic" aria-hidden="true">⚠️</span> <%- t('support.warn_title') %></b>
            <ul>
              <li><%- t('support.warn_tokens') %></li>
              <li><%- t('support.limits', { min: min, max: num(max) }) %></li>
              <li><%- t('support.warn_network') %></li>
              <li><%- t('support.warn_linked') %></li>
              <li><%- t('support.warn_exchange') %></li>
            </ul>
          </div>
        </li>
        <li>
          <h3><%- t('support.s3_title') %></h3>
          <p class="mut"><%- t('support.step_wait') %></p>
          <% if (me) { %>
          <div id="payBox">
            <% if (!payments.length) { %><p class="mut" style="margin-block-start:var(--ds-sp-2)"><%- t('support.no_payments') %></p><% } else { %>
            <ol class="pays" id="cryptoPayments">
              <% payments.forEach((p) => { const sg = STAGE[p.status] || 0, tn = tone(p.status); %><li data-id="<%= p.id %>" data-status="<%= p.status %>" data-pat="<%= p.pat || '' %>">
                <span><span class="amt"><%= (Number(p.usd_cents) / 100).toFixed(2) %> <%= p.token %></span>
                  <span class="meta"> · <a href="<%= p.explorer %>" target="_blank" rel="noopener noreferrer"><%= p.chain_name %> ↗</a> · <time data-ts="<%= p.seen %>"><%= new Date(Number(p.seen)).toISOString().slice(0, 16).replace('T', ' ') %> UTC</time></span></span>
                <span class="pp"><%= p.pat ? num(p.pat) + ' PAT' : '' %></span>
                <span class="st <%= tn %>"><% if (sg) { %><span class="dots" aria-hidden="true"><i class="on<%= sg === 1 ? ' last' : '' %>"></i><i class="<%= sg >= 2 ? 'on' : '' %><%= sg === 2 ? ' last' : '' %>"></i><i class="<%= sg >= 3 ? 'on' : '' %>"></i></span><% } %><span class="lab"><%- t('support.status.' + p.status) %></span></span>
              </li><% }) %>
            </ol>
            <% } %>
          </div>
          <% } %>
        </li>
      </ol>
    </div>
    <% } %>
  </section>

  <section id="where" aria-labelledby="whereT">
    <h2 class="ds-h2" id="whereT"><span class="ds-ic" aria-hidden="true">🧾</span> <%- t('support.where_title') %></h2>
    <div class="grid3">
      <div class="tile"><span class="ic ds-ic xl" aria-hidden="true">🖥️</span><b><%- t('support.where_servers') %></b><p><%- t('support.where_servers_d') %></p></div>
      <div class="tile"><span class="ic ds-ic xl" aria-hidden="true">🌐</span><b><%- t('support.where_hosting') %></b><p><%- t('support.where_hosting_d') %></p></div>
      <div class="tile"><span class="ic ds-ic xl" aria-hidden="true">🪙</span><b><%- t('support.where_pot') %></b><p><%- t('support.where_pot_d', { bonus: BP }) %></p></div>
    </div>
  </section>

  <% if (typeof perks !== 'undefined' && perks) { const PK = perks; %>
  <%# 1.99mv: 💚 Supporter perks (supporter.js) - automatic on any confirmed donation, card or crypto %>
  <section id="perks" aria-labelledby="perksT">
    <h2 class="ds-h2" id="perksT"><span class="ds-ic" aria-hidden="true">💚</span> <%- t('supporter.perks_title') %></h2>
    <p class="mut"><%- t('supporter.perks_lede') %></p>
    <% if (PK.mine) { %><p class="perk-mine"><%- t('supporter.perks_yours', { tier: PK.mine.emoji + ' ' + t('supporter.tier.' + PK.mine.tier) }) %></p><% } %>
    <div class="grid3">
      <div class="tile"><span class="ic ds-ic xl" aria-hidden="true">🏷️</span><b><%- t('supporter.perk_flair') %></b><p><%- t('supporter.perk_flair_d') %></p>
        <div class="perk-fl"><% PK.tiers.forEach((x) => { %><span class="ufl" style="--fl:<%= x.color %>;--fli:#111"><span class="ufl-e" aria-hidden="true"><%= x.emoji %></span><%- t('supporter.chip') %></span><small><%- x.min ? t('supporter.tier_from', { tier: t('supporter.tier.' + x.id), usd: x.min }) : t('supporter.tier_any', { tier: t('supporter.tier.' + x.id) }) %></small><% }) %></div></div>
      <div class="tile"><span class="ic ds-ic xl" aria-hidden="true">✨</span><b><%- t('supporter.perk_cosmetics') %></b><p><%- t('supporter.perk_cosmetics_d') %></p>
        <div class="perk-cx"><% if (PK.halo) { %><span class="perk-halo<%= PK.halo.spin ? ' spin' : '' %>" style="<%= PK.halo.conic %>" aria-hidden="true"><span><%= PK.halo.emoji %></span></span><% } %><% if (PK.name) { %><b class="perk-name" style="<%= PK.name.css %>"><%= locals.user || t('supporter.chip') %></b><% } %></div></div>
      <div class="tile"><span class="ic ds-ic xl" aria-hidden="true">🏅</span><b><%- t('supporter.perk_badges') %></b><p><%- t('supporter.perk_badges_d') %></p>
        <div class="perk-bd"><% PK.badges.forEach((a) => { %><img src="<%= a.icon %>" alt="<%- t('ach.n.' + a.id) %>" title="<%- t('ach.n.' + a.id) %>" width="56" height="56" loading="lazy"><% }) %></div></div>
    </div>
  </section>
  <% } %>

  <section aria-labelledby="trustT">
    <h2 class="ds-h2" id="trustT"><span class="ds-ic" aria-hidden="true">🛡️</span> <%- t('support.trust_title') %></h2>
    <div class="grid3">
      <div class="tile"><span class="ic ds-ic xl" aria-hidden="true">🔒</span><b><%- t('support.trust_keys') %></b><p><%- t('support.trust_keys_d') %></p></div>
      <% if (cardOn) { %><div class="tile"><span class="ds-ic lg" aria-hidden="true">💳</span><b><%- t('support.trust_stripe') %></b><p><%- t('support.trust_stripe_d') %></p></div><% } %>
      <div class="tile"><span class="ic ds-ic xl" aria-hidden="true">📬</span><b><%- t('support.trust_receipt') %></b><p><%- t('support.trust_receipt_d') %></p></div>
      <div class="tile"><span class="ic ds-ic xl" aria-hidden="true">🚫</span><b><%- t('support.trust_cashout') %></b><p><%- t('support.trust_cashout_d') %></p></div>
    </div>
  </section>

  <% if (SP.recent) { %>
  <section class="card" id="supporters" aria-labelledby="supT">
    <h2 class="ds-h2" id="supT"><span class="ds-ic" aria-hidden="true">💖</span> <%- t('support.recent_title') %></h2>
    <% if (!SP.recent.length) { %><p class="mut"><%- t('support.recent_none') %></p><% } else { %>
    <ul class="sups">
      <% SP.recent.forEach((r) => { %><li><b><% if (r.name) { %><%= r.name %><% } else { %><%- t('support.recent_someone') %><% } %></b><span><%- t('support.tier.' + r.tier) %></span><% if (r.at) { %><time class="ago" data-ago="<%= r.at %>" datetime="<%= new Date(r.at).toISOString() %>"><%= new Date(r.at).toISOString().slice(0, 10) %></time><% } %></li><% }) %>
    </ul>
    <% } %>
    <% if (me) { %>
    <label class="ds-check chk"><input type="checkbox" id="spShowName"<%= locals.showName ? ' checked' : '' %>> <%- t('support.recent_optin') %></label>
    <p class="msg" id="spShowMsg" role="status" aria-live="polite"></p>
    <% } %>
  </section>
  <% } %>

  <section class="card" id="faq" aria-labelledby="faqT">
    <h2 class="ds-h2" id="faqT"><span class="ds-ic" aria-hidden="true">❓</span> <%- t('support.faq_title') %></h2>
    <details><summary><%- t('support.faq_get_q') %></summary><p><%- t('support.faq_get_a', { rate: num(R) }) %></p></details>
    <details><summary><%- t('support.faq_pot_q') %></summary><p><%- t('support.faq_pot_a', { bonus: BP }) %></p></details>
    <details><summary><%- t('support.faq_cash_q') %></summary><p><%- t('support.faq_cash_a') %></p></details>
    <% if (cryptoShown) { %>
    <details><summary><%- t('support.faq_time_q') %></summary><p><%- t('support.step_wait') %></p></details>
    <details><summary><%- t('support.faq_safe_q') %></summary><p><%- t('support.faq_safe_a') %></p></details>
    <details><summary><%- t('support.faq_wrong_q') %></summary><p><%- t('support.faq_wrong_a') %></p></details>
    <details><summary><%- t('support.faq_big_q') %></summary><p><%- t('support.limits', { min: min, max: num(max) }) %></p></details>
    <% } %>
    <details><summary><%- t('support.faq_receipt_q') %></summary><p><%- t('support.faq_receipt_a') %></p></details>
  </section>

  <section class="ds-hero hero endcta" aria-labelledby="endT">
    <p class="ds-lead" id="endT"><%- t('support.end_line') %></p>
    <a class="ds-btn lg big" href="#give"><span class="ds-ic" aria-hidden="true">💖</span> <%- t('support.hero_cta') %></a>
  </section>
</main>
<script src="/public/js/crypto-link.js?v=2" defer></script>
<script src="/public/js/support.js?v=1" defer></script>
