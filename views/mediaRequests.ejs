<%- include('layout', { title: 'Request a movie or show', user: user }) %>
<!-- views/mediaRequests.ejs — 1.99ji: 🎬 request movies / shows for the Plex server (mediarequests.js, Overseerr). -->
<link rel="stylesheet" href="/public/css/stage.css?v=6">
<% const fmt = (n) => Number(n || 0).toLocaleString('en-US'); %>
<main class="sb mr" id="mreq" data-price-movie="<%= price.movie %>" data-price-tv="<%= price.tv %>">
  <div class="sb-head">
    <h1>🎬 Request a movie or show</h1>
    <p class="lede">Ask for something that isn't on our Plex server yet. You'll get a 🔔 notice when it's ready to watch.</p>
  </div>
  <% if (!on) { %>
    <section class="sb-card"><p class="note">Requests aren't open right now — check back soon<%= admin ? ' (admins: /admin/media)' : '' %>.</p></section>
  <% } else if (!signedIn) { %>
    <section class="sb-card"><p class="note"><a href="/login?next=/requests">Sign in</a> to request movies and shows.</p></section>
  <% } else { %>
    <section class="sb-card" aria-labelledby="mrS">
      <h2 id="mrS">Search</h2>
      <p class="muted">
        <% if (credits.movie || credits.tv) { %>You have <b><%= credits.movie %></b> movie and <b><%= credits.tv %></b> show request credit<%= credits.movie + credits.tv === 1 ? '' : 's' %> — they're used first. <% } %>
        A request costs <b><%= price.movie ? fmt(price.movie) + ' PAT' : 'nothing' %></b> for a movie and <b><%= price.tv ? fmt(price.tv) + ' PAT' : 'nothing' %></b> for a show<%= (price.movie || price.tv) ? ', given back if it\'s declined or fails' : '' %>.
        <% if (perDay) { %>Up to <%= perDay %> a day.<% } %>
      </p>
      <form id="mrForm" class="row" role="search" autocomplete="off">
        <input type="text" name="q" minlength="2" maxlength="100" placeholder="Title of a movie or show" aria-label="Search for a movie or show" style="flex:1 1 240px" required>
        <button type="submit" class="btn primary">Search</button>
      </form>
      <div id="mrResults" class="mr-grid"></div>
      <div id="mrPick" class="mr-pick hide"></div>
      <p class="msg" id="mrMsg" role="status" aria-live="polite"></p>
    </section>
    <section class="sb-card" id="mine" aria-labelledby="mrM">
      <h2 id="mrM">Your requests</h2>
      <ul class="mr-mine" id="mrMine">
        <% mine.forEach((r) => { %>
          <li><%= r.type === 'tv' ? '📺' : '🎬' %> <b><%= r.title %></b><%= r.year ? ' (' + r.year + ')' : '' %><%= r.seasons ? ' — S' + r.seasons.join(', S') : '' %>
            <span class="pill st-<%= r.status %>"><%= r.label %></span>
            <small class="muted"><%= new Date(r.created).toISOString().slice(0, 10) %><%= r.paid_with === 'credit' ? ' · credit' : r.paid_with === 'pat' ? ' · ' + fmt(r.price) + ' PAT' : '' %><% if (r.order_id) { %> · <a href="/shop/orders/<%= r.order_id %>">order #<%= r.order_id %></a><% } %></small></li>
        <% }) %>
        <% if (!mine.length) { %><li class="muted">Nothing yet.</li><% } %>
      </ul>
    </section>
  <% } %>
</main>
<style>
  .mr .mr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px; margin-top: 10px; }
  .mr .mr-it { background: #0b0b0b; border: 1px solid #222; border-radius: 10px; padding: 6px; cursor: pointer; text-align: left; color: #ddd; font: inherit; display: grid; gap: 4px; }
  .mr .mr-it:hover, .mr .mr-it:focus-visible { border-color: var(--green); }
  .mr .mr-it img, .mr .mr-ph { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 6px; background: #1a1a1a; display: block; }
  .mr .mr-it b { font-size: 13px; line-height: 1.3; overflow-wrap: anywhere; }
  .mr .mr-it small { color: var(--muted); font-size: 11.5px; }
  .mr .mr-pick { border-top: 1px solid #222; margin-top: 12px; padding-top: 12px; display: grid; gap: 8px; }
  .mr .mr-seasons { display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .mr .mr-seasons label { font-size: 13px; color: #ccc; display: inline-flex; gap: 5px; align-items: center; }
  .mr .mr-mine { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .mr .mr-mine li { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: baseline; }
  .mr .pill { font-size: 12px; padding: 2px 8px; border-radius: 999px; border: 1px solid #333; color: #ccc; }
  .mr .st-available { color: #81c784; border-color: #2e5d32; }
  .mr .st-approved, .mr .st-partial { color: #64b5f6; border-color: #24435e; }
  .mr .st-pending, .mr .st-submitting { color: #ffd54f; border-color: #5e4d14; }
  .mr .st-declined, .mr .st-failed, .mr .st-removed, .mr .st-error { color: #e57373; border-color: #5a2222; }
</style>
<% if (on && signedIn) { %><script src="/public/js/media-requests.js?v=1" defer></script><% } %>
