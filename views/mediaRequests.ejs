<%- include('layout', { title: 'Request a movie or show', user: user }) %>
<!-- views/mediaRequests.ejs — 1.99ji: 🎬 request movies / shows for the Plex server (mediarequests.js, Overseerr). -->
<link rel="stylesheet" href="/public/css/stage.css?v=9">
<% const fmt = (n) => Number(n || 0).toLocaleString('en-US'); %>
<main class="ds-page sb mr" id="mreq" data-price-movie="<%= price.movie %>" data-price-tv="<%= price.tv %>" data-scout="<%= locals.roles && roles.scout ? 1 : 0 %>">
  <div class="sb-head">
    <h1><span class="ds-ic" aria-hidden="true">🎬</span> Request a movie or show</h1>
    <p class="lede">Ask for something that isn't on our Plex server yet. You'll get a 🔔 notice when it's ready to watch.</p>
    <% const tR_ = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); %>
    <p class="muted mr-links"><a class="ds-back" href="/plex">‹ <span class="ds-ic" aria-hidden="true">📼</span><%- tR_('nav.plex') %></a><% if (locals.manage) { %><a class="ds-back" href="/plex/manage"><span class="ds-ic" aria-hidden="true">🎟️</span><%- tR_('plex.manage.go') %></a><% } %></p>
  </div>
  <% if (!on) { %>
    <section class="sb-card"><p class="note">Requests aren't open right now — check back soon<%= admin ? ' (admins: /admin/media)' : '' %>.</p></section>
  <% } else if (!signedIn) { %>
    <section class="sb-card"><p class="note"><a href="/login?next=/requests">Sign in</a> to request movies and shows.</p></section>
  <% } else { %>
    <section class="sb-card" aria-labelledby="mrS">
      <h2 id="mrS">Search</h2>
      <% if (locals.roles && roles.scout) { %><p class="note"><%- tR_('plex.req.scout') %></p><% } %>
      <% if (locals.roles && roles.curator) { %><p class="note"><%- tR_('plex.req.curator') %></p><% } %>
      <p class="muted">
        <% if (credits.movie || credits.tv) { %>You have <b><%= credits.movie %></b> movie and <b><%= credits.tv %></b> show request credit<%= credits.movie + credits.tv === 1 ? '' : 's' %> — they're used first. <% } %>
        A request costs <b><%= price.movie ? fmt(price.movie) + ' PAT' : 'nothing' %></b> for a movie and <b><%= price.tv ? fmt(price.tv) + ' PAT' : 'nothing' %></b> for a show<%= (price.movie || price.tv) ? ', given back if it\'s declined or fails' : '' %>.
        <% if (perDay && !(locals.roles && roles.scout)) { %>Up to <%= perDay %> a day.<% } %>
      </p>
      <form id="mrForm" class="row" role="search" autocomplete="off">
        <input type="text" name="q" minlength="2" maxlength="100" placeholder="Title of a movie or show" aria-label="Search for a movie or show" style="flex:1 1 240px" required>
        <button type="submit" class="btn primary">Search</button>
      </form>
      <div id="mrResults" class="mr-grid"></div>
      <div id="mrPick" class="mr-pick hide"></div>
      <p class="msg" id="mrMsg" role="status" aria-live="polite"></p>
    </section>
    <section class="sb-card" id="mine" aria-labelledby="mrM">
      <h2 id="mrM">Your requests</h2>
      <ul class="mr-mine" id="mrMine">
        <% mine.forEach((r) => { %>
          <li><% if (r.poster_url) { %><img class="mr-thumb" src="<%= r.poster_url %>" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'mr-thumb mr-tph',textContent:'🎬'}))"><% } else { %><span class="mr-thumb mr-tph" aria-hidden="true"><%= r.type === 'tv' ? '📺' : '🎬' %></span><% } %>
            <span class="mr-txt"><b><%= r.title %></b><%= r.year ? ' (' + r.year + ')' : '' %><%= r.seasons ? ' — S' + r.seasons.join(', S') : '' %>
            <span class="pill st-<%= r.status %>"><%= r.label %></span>
            <small class="muted"><%= new Date(r.created).toISOString().slice(0, 10) %><%= r.paid_with === 'credit' ? ' · credit' : r.paid_with === 'scout' ? ' · 🔭 Scout' : r.paid_with === 'pat' ? ' · ' + fmt(r.price) + ' PAT' : '' %><% if (r.order_id) { %> · <a href="/shop/orders/<%= r.order_id %>">order #<%= r.order_id %></a><% } %></small></span></li>
        <% }) %>
        <% if (!mine.length) { %><li class="muted">Nothing yet.</li><% } %>
      </ul>
    </section>
  <% } %>
</main>
<style>
  /* 1.99po polish (G5): tokens; the result tiles + "Your requests" list on the ds rhythm */
  .mr .mr-links { display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .mr .mr-links .ds-back { color: var(--ds-green-2); gap: 6px; }
  .mr .mr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 130px), 1fr)); gap: var(--ds-sp-2h); margin-top: var(--ds-sp-3); }
  .mr .mr-it { background: var(--ds-sunken); border: 1px solid var(--ds-line); border-radius: var(--ds-r-md); padding: 6px; cursor: pointer; text-align: start; color: #ddd; font: inherit; display: grid; gap: 4px; align-content: start; }
  .mr .mr-it:hover { border-color: var(--ds-green); }
  .mr .mr-it:focus-visible { outline: 2px solid var(--ds-focus); outline-offset: 2px; }
  .mr .mr-it img, .mr .mr-ph { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; border-radius: var(--ds-r-xs); background: #1a1a1a; display: block; }
  .mr .mr-it b { font-size: var(--ds-fs-meta); line-height: 1.3; overflow-wrap: anywhere; }
  .mr .mr-it small { color: var(--ds-text-muted); font-size: 11.5px; }
  .mr .mr-pick { border-top: 1px solid var(--ds-line-soft); margin-top: var(--ds-sp-3); padding-top: var(--ds-sp-3); display: grid; gap: var(--ds-sp-2); }
  .mr .mr-seasons { display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .mr .mr-seasons label { font-size: var(--ds-fs-meta); color: #ccc; display: inline-flex; gap: 6px; align-items: center; min-height: 36px; }
  .mr .mr-mine { list-style: none; margin: 0; padding: 0; display: grid; }
  .mr .mr-mine li { display: flex; gap: var(--ds-sp-3); align-items: flex-start; padding: var(--ds-sp-2h) 0; border-bottom: 1px solid var(--ds-line-soft); }
  .mr .mr-mine li:last-child { border-bottom: 0; }
  .mr .mr-txt { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; min-width: 0; overflow-wrap: anywhere; }
  .mr .mr-txt small { flex-basis: 100%; }
  .mr .mr-thumb { width: 34px; height: 51px; object-fit: cover; border-radius: var(--ds-r-xs); flex: none; background: #1a1a1a; }
  .mr .mr-tph { display: inline-flex; align-items: center; justify-content: center; font-size: 16px; color: var(--ds-text-faint); border: 1px solid #2a2a2a; box-sizing: border-box; }
  /* request status chips (the .ds-chip vocabulary: available ok, approved info, pending warn, failed danger) */
  .mr .pill { display: inline-flex; align-items: center; font-size: 11px; font-weight: 700; letter-spacing: var(--ds-ls-chip); text-transform: uppercase; padding: 2px 9px; border-radius: var(--ds-r-pill); border: 1px solid var(--ds-line-strong); color: #ccc; }
  .mr .st-available { color: var(--ds-ok); border-color: var(--ds-ok-line); background: var(--ds-ok-bg); }
  .mr .st-approved, .mr .st-partial { color: var(--ds-info); border-color: var(--ds-info-line); background: var(--ds-info-bg); }
  .mr .st-pending, .mr .st-submitting { color: var(--ds-warn); border-color: var(--ds-warn-line); background: var(--ds-warn-bg); }
  .mr .st-declined, .mr .st-failed, .mr .st-removed, .mr .st-error { color: var(--ds-danger); border-color: var(--ds-danger-line); background: var(--ds-danger-bg); }
</style>
<% if (on && signedIn) { %><script src="/public/js/media-requests.js?v=2" defer></script><% } %>
