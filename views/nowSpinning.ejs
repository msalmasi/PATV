<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <!-- OBS text source (/api/g/wheel/last-result while a public spin is pending). Refresh every 3s,
         but only while the site answers: a plain meta refresh that fired during a site restart
         loaded an error page with no refresh in it, and the OBS source died. -->
    <script>setInterval(function () { fetch('/healthz', { cache: 'no-store' })
      .then(function (r) { if (r.ok) location.reload(); }).catch(function () {}); }, 3000);</script>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
    <title>Now Spinning</title>
    <style>
        html, body { margin: 0; background: transparent; overflow: hidden; }
        body { text-align: center; padding-top: 10px; text-transform: uppercase; }
        p { margin: 0 0 6px; font-family: 'Press Start 2P', monospace; font-size: 1.6em; letter-spacing: 3px;
            color: #FFC600; text-shadow: 0 0 6px #FFC600, 0 0 16px rgba(255,198,0,.7);
            animation: bounce 1s ease-in-out infinite; }
        h1 { margin: 6px 0 0; font-family: 'VT323', monospace; font-weight: 400; font-size: 5em; line-height: 1; letter-spacing: 2px;
             color: #4AFFEF; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
             text-shadow: 0 0 6px #4AFFEF, 0 0 18px #D42CCA, 0 0 36px #D42CCA; }
        @keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
    </style>
</head>
<body>
    <p>Now Spinning</p>
    <h1><%= username %></h1>
</body>
</html>
