<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: 'Staking', user: user}) %>
<% /* 1.99dt: ul() links names (userlinks.js, app.locals); rendered without the app it's the plain name */
   const UL = typeof ul === 'function' ? ul : (n, o) => escapeFn(o && o.text != null ? o.text : (n == null ? '' : n)) + (o && o.web ? ' 🌐' : '');
   const ULE = typeof ulEsc === 'function' ? ulEsc : escapeFn; %>
<style>
  /* 1.99pr polish: .ds-page.flow + ds tokens (the money pages' look: gold hero, pixel section headings, .ds-tbl tables) */
  .sk { --ds-w: 1040px; }
  .sk a:not(.ds-btn) { text-decoration: none; } .sk a:not(.ds-btn):hover { text-decoration: underline; }
  .sk .ds-hero { margin-block-end: var(--ds-sp-4); }
  .sk .ds-hero .explain { margin: 0; max-width: 72ch; font-size: var(--ds-fs-sm); }
  .sk .ds-hero .explain b { color: var(--ds-text-strong); }
  .sk h2.ds-pixel-h { margin: var(--ds-sp-8) 0 var(--ds-sp-3); }
  .sk .center { text-align: center; }
  .sk .info { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); line-height: 1.6; margin: var(--ds-sp-2h) 0; }
  .sk .info b { color: var(--ds-text-2); }
  .sk .mut { color: var(--ds-text-muted); }
  .sk .pend { color: var(--ds-warn-ink); }
  .sk .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: var(--ds-sp-3); }
  .sk .card { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); display: grid; gap: var(--ds-sp-2); align-content: start; min-width: 0; }
  .sk .card .vname { font: 700 var(--ds-fs-h3)/var(--ds-lh-h3) var(--ds-font); color: var(--ds-text-strong); }
  .sk .card .price { font-size: var(--ds-fs-num-lg); line-height: 1.1; color: var(--ds-gold-text); font-weight: 700; font-variant-numeric: tabular-nums; }
  .sk .card .price small { font-size: var(--ds-fs-xs); color: var(--ds-text-muted); font-weight: 400; }
  .sk .kv { display: grid; grid-template-columns: auto auto; gap: 4px 10px; font-size: var(--ds-fs-meta); font-variant-numeric: tabular-nums; }
  .sk .kv span { color: var(--ds-text-muted); } .sk .kv b { color: var(--ds-text); text-align: end; font-weight: 500; }
  .sk .kv b small { color: var(--ds-text-faint); font-weight: 400; }
  .sk .ds-stats { margin: var(--ds-sp-3) 0; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); }
  .sk .ds-stat em { color: var(--ds-text-faint); font-size: var(--ds-fs-xs); font-style: normal; }
  .sk .gold { color: var(--ds-gold-text) !important; } .sk .up { color: var(--ds-ok) !important; } .sk .down { color: var(--ds-danger-solid) !important; }
  .sk .chart { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-3); }
  .sk .chart svg { display: block; width: 100%; height: auto; }
  .sk .legend { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: var(--ds-fs-xs); color: var(--ds-text-2); margin-top: var(--ds-sp-2); }
  .sk .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-inline-end: 5px; vertical-align: -1px; }
  .sk .legend .lg-note { margin-inline-start: auto; color: var(--ds-text-muted); }
  .sk .ds-tbl td { vertical-align: top; }
  .sk .ds-tbl td:not([colspan]) { white-space: nowrap; }
  .sk .rev { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: var(--ds-sp-3); }
  .sk .rev .card h4 { margin: 0; font: 700 var(--ds-fs-h4)/var(--ds-lh-h4) var(--ds-font); color: var(--ds-text-strong); }
  .sk .rev .ds-tbl { border-radius: var(--ds-r-lg); background: var(--ds-sunken); }
  .sk .rev .ds-tbl td { padding: 6px 10px; }
  /* the 7 / 30 day switch: radios (visually hidden, still keyboard-focusable) + pill labels */
  .sk .tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: var(--ds-sp-3); }
  .sk .tabs label { display: inline-flex; align-items: center; min-height: 36px; padding: 0 var(--ds-sp-3h); border-radius: var(--ds-r-pill); border: 1px solid #2a2a2a; background: #151515;
       color: #ccc; font: 500 var(--ds-fs-meta)/1 var(--ds-font); cursor: pointer; }
  .sk .tabs label:hover { border-color: var(--ds-ac); color: #fff; }
  .sk #rv7:checked ~ .tabs label[for=rv7], .sk #rv30:checked ~ .tabs label[for=rv30] { border-color: var(--ds-ac); background: var(--ds-ac-bg); color: #fff; }
  .sk #rv7:focus-visible ~ .tabs label[for=rv7], .sk #rv30:focus-visible ~ .tabs label[for=rv30] { box-shadow: var(--ds-focus-ring); }
  .sk .rvp { display: none; }
  .sk #rv7:checked ~ .rvp.d7, .sk #rv30:checked ~ .rvp.d30 { display: block; }
  .sk details.more { margin-top: var(--ds-sp-2); }
  .sk details.more > summary { background: none; cursor: pointer; min-height: 36px; display: flex; align-items: center; }
  /* forms */
  .sk form { display: grid; gap: var(--ds-sp-2h); margin: 0; }
  .sk .forms { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: var(--ds-sp-3); margin-top: var(--ds-sp-3); }
  .sk .forms > form { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); align-content: start; min-width: 0; }
  .sk .forms > form > b:first-of-type { color: var(--ds-text-strong); font-size: var(--ds-fs-h4); }
  .sk .forms > form .info { margin: 0; }
  .sk input[type=text], .sk select { box-sizing: border-box; width: 100%; max-width: 100%; min-width: 0; min-height: var(--ds-tap); margin: 0; padding: 10px 12px; border-radius: var(--ds-r-md);
       border: 1px solid var(--ds-line-strong); background: var(--ds-sunken); color: #eee; font: 400 15px/1.3 var(--ds-font); }
  .sk input[type=text]:hover, .sk select:hover { border-color: #444; }
  .sk input[type=text]:focus, .sk select:focus { outline: none; border-color: var(--ds-ac); box-shadow: 0 0 0 3px var(--ds-ac-bg); }
  .sk input::placeholder { color: #777; }
  .sk button { display: inline-flex; align-items: center; justify-content: center; gap: var(--ds-sp-2); margin: 0; min-height: var(--ds-tap); padding: 0 var(--ds-sp-5);
       border: 1px solid transparent; border-radius: var(--ds-r-pill); background: var(--ds-gold-grad); color: var(--ds-on-gold); font: 700 15px/1.1 var(--ds-font); cursor: pointer; transition: filter var(--ds-dur-1); }
  .sk button:hover { filter: brightness(1.1); }
  .sk button:disabled, .sk button[aria-busy="true"] { filter: grayscale(.6) brightness(.7); cursor: not-allowed; }
  .sk button.alt { background: #1c1c1f; color: var(--ds-text); border-color: var(--ds-line-strong); }
  .sk button.alt:hover { border-color: var(--ds-gold); filter: none; }
  .sk .hint { margin: 0; }
  .sk .act-box { margin: var(--ds-sp-3) 0; }
  @media (max-width: 760px) { .sk input[type=text], .sk select { font-size: 16px; } }
  @media (prefers-reduced-motion: reduce) { .sk button { transition: none; } }
</style>
<%
  const V = {
    bank:  { icon: '🏦', name: 'Bank',         color: '#64b5f6', acct: 'bank' },
    house: { icon: '🎰', name: 'House',        color: '#e57373', acct: 'jackpot' },
    mm:    { icon: '📈', name: 'Market maker', color: '#ffd54f', acct: 'mm' },
    auto:  { icon: '🤖', name: 'Auto',         color: '#4caf50', acct: null },
  };
  const KEYS = ['bank', 'house', 'mm', 'auto'];
  const fmt = (n) => Math.round(Number(n) || 0).toLocaleString();
  const pct = (f, d) => ((Number(f) || 0) * 100).toFixed(d == null ? 1 : d) + '%';
  const apr = (f) => f == null ? '—' : pct(f);
  const price = (p) => (Number(p) || 0).toFixed(4);
  const day = (ts) => ts ? new Date(ts * 1000).toISOString().slice(0, 10) : '';
  const when = (ts) => ts ? new Date(ts * 1000).toISOString().slice(0, 16).replace('T', ' ') : '';
  const left = (t) => { const s = Math.max(0, Math.round(t - now)); return s >= 86400 ? Math.floor(s/86400) + 'd ' + Math.floor(s%86400/3600) + 'h' : s >= 3600 ? Math.floor(s/3600) + 'h ' + Math.floor(s%3600/60) + 'm' : s > 0 ? Math.max(1, Math.floor(s/60)) + 'm' : 'now'; };
  const cd = (t) => '<span data-until="' + Number(t) + '">' + left(t) + '</span>';
  const amb = (v) => v == null ? '—' : typeof v === 'boolean' ? (v ? 'on' : 'off') : Math.abs(v) <= 1 && v !== 0 ? pct(v) : fmt(v);
  const hidden = (cmd) => '<input type="hidden" name="kind" value="cmd"><input type="hidden" name="cmd" value="' + cmd + '"><input type="hidden" name="back" value="/staking"><input type="hidden" name="tag" value="staking">';
  const vaultSelect = (sel) => '<select name="a3">' + KEYS.map((k) => '<option value="' + k + '"' + (k === sel ? ' selected' : '') + '>' + V[k].icon + ' ' + V[k].name + '</option>').join('') + '</select>';
%>
<main class="ds-page flow sk">
  <%# 1.99lx design pass: the wallet's look (hero, rounder cards); content and forms unchanged %>
  <section class="ds-hero gold sk-hero">
    <div class="ds-eyebrow">STASHES · VAULTS · YIELD</div>
    <h1>Staking</h1>
  <p class="ds-lead explain">Stashes can stake PAT into the protocol's vaults and own a slice of what they earn.
    The <b>🏦 Bank</b> lends to players, the <b>🎰 House</b> banks the casino games and the jackpot, and the <b>📈 Market maker</b> seeds and trades the prediction markets.
    Each vault is priced per share: its value (NAV) divided by its shares, so the share price rises as the vault takes in fees and profits and falls when it pays out.
    <b>🤖 Auto</b> spreads itself over the three by target weights. Stakes and withdrawals run once a day at the cut-off, at that day's price.
    <a href="/economy#protocol">How the protocol works ›</a> · <a href="/wallet#stashes">Your stashes ›</a></p>
  </section>

  <%- include('partials/actions', { acts, msg }) %>

<% if (!snap) { %>
  <div class="ds-empty"><span class="ds-ic" aria-hidden="true">📈</span><b>No staking numbers from Pepe yet.</b></div>
<% } else {
     const s = snap.settings || {};
     const share = (k) => snap.nav[k] ? (snap.staked[k] || 0) / snap.nav[k] : 0;
%>
  <div class="ds-stats">
    <div class="ds-stat"><span>Next cut-off</span><b><%- snap.next_epoch ? cd(snap.next_epoch) : '—' %></b><% if (snap.next_epoch) { %><em><%= when(snap.next_epoch) %> UTC</em><% } %></div>
    <div class="ds-stat"><span>Pending requests</span><b><%= pending.length %></b></div>
    <div class="ds-stat"><span>Total in vaults</span><b class="gold"><%= fmt((snap.nav.bank || 0) + (snap.nav.house || 0) + (snap.nav.mm || 0)) %></b></div>
    <div class="ds-stat"><span>Staked by stashes</span><b class="up"><%= fmt((snap.staked.bank || 0) + (snap.staked.house || 0) + (snap.staked.mm || 0)) %></b></div>
  </div>

  <!-- ───────── Vaults ───────── -->
  <h2 class="ds-pixel-h">VAULTS</h2>
  <div class="grid">
    <% KEYS.forEach((k) => { const a = (snap.apr || {})[k] || {}; %>
      <div class="card" style="border-top: 3px solid <%= V[k].color %>">
        <span class="vname"><span class="ds-ic" aria-hidden="true"><%= V[k].icon %></span> <%= V[k].name %></span>
        <span class="price"><%= price(snap.prices[k]) %> <small>PAT / share</small></span>
        <div class="kv">
          <% if (k === 'auto') { %>
            <span>Value</span><b><%= fmt(snap.auto_nav) %></b>
          <% } else { %>
            <span>Value (NAV)</span><b><%= fmt(snap.nav[k]) %></b>
            <span>Stakers' share</span><b><%= pct(share(k)) %></b>
          <% } %>
          <% if (k === 'auto') { %>
            <span>APR 7 days</span><b class="<%= a[7] == null ? '' : a[7] >= 0 ? 'up' : 'down' %>"><%= apr(a[7]) %></b>
            <span>APR 30 days</span><b class="<%= a[30] == null ? '' : a[30] >= 0 ? 'up' : 'down' %>"><%= apr(a[30]) %></b>
          <% } else { /* staking fix plan P0.3: the whole vault's APR is not what a staker earns - the stakers' own APR next to it */
               const sa = (snap.staker_apr || {})[k] || {}, ssf = (snap.staker_so_far || {})[k]; %>
            <span><%= t('staking.card.vault_apr7') %></span><b class="<%= a[7] == null ? '' : a[7] >= 0 ? 'up' : 'down' %>"><%= apr(a[7]) %></b>
            <span><%= t('staking.card.vault_apr30') %></span><b class="<%= a[30] == null ? '' : a[30] >= 0 ? 'up' : 'down' %>"><%= apr(a[30]) %></b>
            <span><%= t('staking.card.staker_apr7') %></span>
            <% if (sa[7] != null) { %><b class="<%= sa[7] >= 0 ? 'up' : 'down' %>"><%= apr(sa[7]) %></b>
            <% } else if (ssf) { %><b class="<%= ssf.r >= 0 ? 'up' : 'down' %>"><%= (ssf.r >= 0 ? '+' : '') + pct(ssf.r, 2) %> <small><%= t('staking.card.staker_so_far', { days: ssf.days }) %></small></b>
            <% } else { %><b>— <small><%= t('staking.card.staker_none') %></small></b><% } %>
            <% if (sa[30] != null) { %><span><%= t('staking.card.staker_apr30') %></span><b class="<%= sa[30] >= 0 ? 'up' : 'down' %>"><%= apr(sa[30]) %></b><% } %>
            <% const cu = (snap.cushion || {})[k]; if ((snap.settings || {}).cushion && cu) { %>
              <span><%= t('staking.card.cushion', { days: (snap.settings || {}).cushion_days || 8 }) %></span><b><%= fmt(cu.value) %></b>
            <% } %>
          <% } %>
          <% const sf = (snap.so_far || {})[k]; if (a[7] == null && sf) { %>
            <span>Return so far</span><b class="<%= sf.r >= 0 ? 'up' : 'down' %>"><%= (sf.r >= 0 ? '+' : '') + pct(sf.r, 2) %> <small>in <%= sf.days %> d (APR once there's 7 days of history)</small></b>
          <% } %>
          <% if (k === 'mm' && snap.mm_book) { %>
            <span>Seeds in markets</span><b><%= fmt(snap.mm_book.seeds) %> <small>marked at <%= fmt(snap.mm_book.value) %></small></b>
          <% } %>
          <% if (k === 'auto') { %>
            <span>Target split</span><b><%= ['bank', 'house', 'mm'].map((t) => V[t].icon + ' ' + pct(snap.targets[t], 0)).join(' ') %></b>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
  <div class="ds-stats">
    <div class="ds-stat"><span>🏦 Bank cash</span><b><%= fmt(snap.bank_cash) %></b><em><%= fmt(Math.max(0, snap.nav.bank - snap.bank_cash)) %> lent out</em></div>
    <div class="ds-stat"><span>📈 Market maker cash</span><b><%= fmt(snap.mm_cash) %></b><em><%= fmt(Math.max(0, snap.nav.mm - snap.mm_cash)) %> committed to markets</em></div>
    <div class="ds-stat"><span>🎟️ Lotto pot</span><b class="gold"><%= fmt(snap.lotto_pot) %></b></div>
    <% if (snap.heist_vault != null) { %><div class="ds-stat"><span>🎰 Casino vault</span><b><%= fmt(snap.heist_vault) %></b><em>what casino heists rob</em></div><% } %>
  </div>

  <!-- ───────── The weekly settlement (Economy v3) + the older daily dividends ───────── -->
  <h2 class="ds-pixel-h">WEEKLY SETTLEMENT</h2>
  <%# The copy the owner approved 2026-10-19 (staking fix plan §5.2 rewritten for that day's rule - no daily APR ceiling, no
      weekly payout cap, a time-weighted weekly payout, stakers carry the House's swings incl. the Monday draws); the i18n sync
      translates it once it's pushed. Every sentence follows the LIVE settings (s.ceil,
      s.bonus_cap, s.cushion, s.weighted, s.auto_staker_cap), so the page never states a rule that isn't in force; a setting
      that isn't known (no snapshot field) gets no sentence at all rather than a guess. %>
  <% /* staking fix plan P0.3 / §5.2: the weekly payouts per vault (Pepe's epoch records), the CURRENT rule said plainly */
     const divs = snap.dividends || [];
     const nowS = Date.now() / 1000;
     const sumSince = (k, days) => divs.filter((x) => x.vault === k && x.ts >= nowS - days * 86400).reduce((a, x) => a + x.amount, 0);
     const tsz = snap.targets_size || {};
     const wfs = snap.waterfall || [];
     const wl = wfs[wfs.length - 1] || null;
     const pc1 = (f) => Math.round(Number(f) * 1000) / 10;
     const bcap = s.bonus_cap == null ? null : s.bonus_cap;           // null = not reported: no cap sentence either way
     const shr = wl && wl.staker_share != null ? pc1(wl.staker_share) : 20;
     const wfSum = (r, f) => ['house', 'bank', 'mm'].reduce((a, v) => a + (((r.vaults || {})[v] || {})[f] || 0), 0);
     const pdw0 = snap.pd_week || {}; %>
  <p class="info"><%- t('staking.wf.how', { share: shr, cap: bcap > 0 ? t('staking.wf.cap', { cap: pc1(bcap) }) : '' }) %>
    <%- s.weighted ? t('staking.wf.weighted') : t('staking.wf.snapshot') %>
    <%# a partial week (Pepe's bucket rule): the "first week" sentence only when the PAT-days began inside the week this Monday
        settles (pd_from in [boundary - 7 d, boundary): capital/vaults.pdFirstWeek, which the admin card uses); any other partial week (PAT-days that began in an earlier week of a
        longer stretch, a pruned oldest week, or Pepe's local snapshot, which sends no pd_from) gets the plain one %>
    <% const pdFirst = pdw0.partial && Number(pdw0.from) > 0 && Number(pdw0.boundary) > 0 && Number(pdw0.from) >= Number(pdw0.boundary) - 7 * 86400 && Number(pdw0.from) < Number(pdw0.boundary); %>
    <%- s.weighted && pdw0.partial ? (pdFirst ? t('staking.wf.partial', { when: when(pdw0.from) }) : t('staking.wf.partial_gap')) : '' %>
    <%# D2's safeguard (camfrog-bot 31c65d0): with no weekly cap set, a week that isn't wholly time-weighted settles under the
        25% reference cap - said only when the cap is known to be off and this week is known to be partial %>
    <%- bcap != null && !(bcap > 0) && pdw0.partial ? t('staking.wf.partial_cap', { cap: 25 }) : '' %></p>
  <p class="info"><%- s.ceil == null ? '' : !(s.ceil > 0) ? t('staking.wf.ceiling_off') : s.cushion ? t('staking.wf.ceiling_cushion', { ceil: pc1(s.ceil), days: s.cushion_days || 8 }) : t('staking.wf.ceiling', { ceil: pc1(s.ceil) }) %>
    <a href="/economy#incentives">How it works</a></p>
  <% if (wl) { %>
    <p class="info"><b><%= t('staking.wf.week', { week: wl.epoch.slice(1) }) %></b> · <%= wl.state === 'done' && wl.done ? t('staking.wf.settled', { when: when(wl.done) }) : t('staking.wf.not_done') %></p>
    <div class="ds-tbl"><table>
      <tr><th><%= t('staking.wf.col_vault') %></th><th class="r"><%= t('staking.wf.col_surplus') %></th><th class="r"><%= t('staking.wf.col_share', { share: shr }) %></th>
        <th class="r"><%= bcap > 0 ? t('staking.wf.col_cap', { cap: pc1(bcap) }) : t('staking.wf.col_cap_none') %></th><th class="r"><%= t('staking.wf.col_paid') %></th>
        <th class="r"><%= t('staking.wf.col_fed') %></th><th class="r"><%= t('staking.wf.col_inc') %></th></tr>
      <% ['house', 'bank', 'mm'].filter((k) => (wl.vaults || {})[k]).forEach((k) => { const x = wl.vaults[k]; %>
        <tr><td><%= V[k].icon %> <%= V[k].name %></td><td class="r"><%= fmt(x.surplus) %></td><td class="r"><%= fmt(x.stakers_share) %></td>
          <td class="r"><%= x.stakers_share > 0 ? fmt(x.apr_cap) : '—' %><%= x.stakers_share > 0 && x.fallback ? ' †' : '' %></td><td class="r up"><%= fmt(x.stakers) %></td>
          <td class="r"><%= fmt(x.fed + (x.fed_loan_repaid || 0)) %></td><td class="r"><%= fmt(x.incentives) %></td></tr>
      <% }) %>
      <tr class="tot"><td><%= t('staking.wf.total') %></td><td class="r"><%= fmt(wfSum(wl, 'surplus')) %></td><td class="r"><%= fmt(wfSum(wl, 'stakers_share')) %></td><td></td>
        <td class="r up"><%= fmt(wfSum(wl, 'stakers')) %></td><td class="r"><%= fmt(wfSum(wl, 'fed') + wfSum(wl, 'fed_loan_repaid')) %></td><td class="r"><%= fmt(wfSum(wl, 'incentives')) %></td></tr>
    </table></div>
    <p class="info"><%- t('staking.wf.table_help') %></p>
    <% if (['house', 'bank', 'mm'].some((k) => (wl.vaults || {})[k] && wl.vaults[k].stakers_share > 0 && wl.vaults[k].fallback)) { %>
      <p class="info"><%- t('staking.wf.fallback', { cap: 25 }) %></p>
    <% } %>
    <% if (wfs.length > 1) { %>
      <details class="more"><summary class="info"><%= t('staking.wf.earlier', { n: wfs.length - 1 }) %></summary>
        <div class="ds-tbl"><table>
          <tr><th><%= t('staking.wf.col_week') %></th><th class="r"><%= t('staking.wf.col_surplus') %></th><th class="r"><%= t('staking.wf.col_paid') %></th>
            <th class="r"><%= t('staking.wf.col_fed') %></th><th class="r"><%= t('staking.wf.col_inc') %></th></tr>
          <% wfs.slice(0, -1).reverse().forEach((r) => { %>
            <tr><td><%= r.epoch.slice(1) %></td><td class="r"><%= fmt(wfSum(r, 'surplus')) %></td><td class="r up"><%= fmt(wfSum(r, 'stakers')) %></td>
              <td class="r"><%= fmt(wfSum(r, 'fed') + wfSum(r, 'fed_loan_repaid')) %></td><td class="r"><%= fmt(wfSum(r, 'incentives')) %></td></tr>
          <% }) %>
        </table></div>
      </details>
    <% } %>
  <% } else { %>
    <p class="info"><%= t('staking.wf.none') %></p>
  <% } %>
  <details class="more"><summary class="info"><%= t('staking.div.title') %></summary>
    <p class="info"><%= t('staking.div.help') %></p>
    <div class="ds-tbl"><table>
      <tr><th>Vault</th><th class="r">Value now</th><th class="r">Target</th><th class="r">Paid · 7 days</th><th class="r">Paid · 30 days</th><th class="r">Paid · all</th></tr>
      <% ['bank', 'house', 'mm'].forEach((k) => { %>
        <tr><td><%= V[k].icon %> <%= V[k].name %></td>
            <td class="r"><%= fmt(snap.nav[k]) %></td>
            <td class="r"><%= tsz[k] == null ? '—' : fmt(tsz[k]) %><%= tsz[k] != null && snap.nav[k] > tsz[k] ? ' ▲' : '' %></td>
            <td class="r"><%= fmt(sumSince(k, 7)) %></td><td class="r"><%= fmt(sumSince(k, 30)) %></td>
            <td class="r"><%= fmt(divs.filter((x) => x.vault === k).reduce((a, x) => a + x.amount, 0)) %></td></tr>
      <% }) %>
    </table></div>
    <% if (divs.length) { %>
      <div class="ds-tbl"><table>
        <tr><th>When (UTC)</th><th>Vault</th><th class="r">PAT to the Reserve</th></tr>
        <% divs.slice().reverse().slice(0, 30).forEach((x) => { %>
          <tr><td><%= when(x.ts) %></td><td><%= V[x.vault].icon %> <%= V[x.vault].name %></td><td class="r"><%= fmt(x.amount) %></td></tr>
        <% }) %>
      </table></div>
    <% } %>
  </details>
  <p class="info">Settings: APR ceiling <b><%= s.ceil == null ? '—' : s.ceil > 0 ? amb(s.ceil) : t('staking.off') %></b> · <%- t('staking.settings.cushion', { state: s.cushion ? t('staking.on') : t('staking.off'), days: s.cushion_days || 8 }) %> ·
    <%- t('staking.settings.bonus', { cap: bcap == null ? '—' : bcap > 0 ? t('staking.settings.cap_val', { cap: pc1(bcap) }) : t('staking.settings.no_cap') }) %> · floor <b><%= amb(s.floor) %></b> · Reserve top-up <b><%= amb(s.topup) %></b> ·
    <%- t('staking.settings.weighted', { state: s.weighted ? t('staking.on') : t('staking.off') }) %> ·
    <%- t(s.auto_staker_cap ? 'staking.settings.smax_all' : 'staking.settings.smax_direct', { p: s.staker_max == null ? '—' : pct(s.staker_max, 0) }) %> ·
    Auto bands: Bank ≥ <b><%= s.bank_min == null ? '—' : pct(s.bank_min, 0) %></b>, House ≤ <b><%= s.house_max == null ? '—' : pct(s.house_max, 0) %></b>, Market maker ≤ <b><%= s.mm_max == null ? '—' : pct(s.mm_max, 0) %></b>.
    <% if (snap.updated) { %>Updated <%= when(snap.updated / 1000) %> UTC.<% } %></p>

  <!-- ───────── Share price chart ───────── -->
  <h2 class="ds-pixel-h">SHARE PRICE</h2>
  <% const ts = chart.ts;
     const vals = [];
     KEYS.forEach((k) => (chart.series[k] || []).forEach((v) => { if (v != null) vals.push(v); }));
     if (ts.length < 2 || !vals.length) { %>
    <p class="info">The chart starts after the second daily cut-off.</p>
  <% } else {
       const W = 640, H = 260, L = 66, R = 12, T = 12, B = 32;
       let lo = Math.min(1, ...vals), hi = Math.max(1, ...vals);
       if (hi - lo < 0.002) { hi += 0.001; lo -= 0.001; }
       const padv = (hi - lo) * 0.08; lo -= padv; hi += padv;
       const t0 = ts[0], t1 = ts[ts.length - 1];
       const X = (t) => (L + (t - t0) / (t1 - t0) * (W - L - R)).toFixed(1);
       const Y = (v) => (T + (hi - v) / (hi - lo) * (H - T - B)).toFixed(1);
       const ticks = [0, 1, 2, 3, 4].map((i) => lo + (hi - lo) * i / 4);
       const segs = (arr) => { const out = []; let cur = []; arr.forEach((v, i) => { if (v == null) { if (cur.length) out.push(cur); cur = []; } else cur.push(X(ts[i]) + ',' + Y(v)); }); if (cur.length) out.push(cur); return out; };
       const xl = [0, Math.floor((ts.length - 1) / 2), ts.length - 1]; %>
    <div class="chart">
      <svg viewBox="0 0 <%= W %> <%= H %>" role="img" aria-label="Share price per vault, normalised to 1.0 at the first cut-off">
        <% ticks.forEach((v) => { %>
          <line x1="<%= L %>" y1="<%= Y(v) %>" x2="<%= W - R %>" y2="<%= Y(v) %>" stroke="#1f1f1f"/>
          <text x="<%= L - 6 %>" y="<%= Number(Y(v)) + 6 %>" fill="#9a9a9a" font-size="17" text-anchor="end"><%= v.toFixed(3) %></text>
        <% }) %>
        <line x1="<%= L %>" y1="<%= Y(1) %>" x2="<%= W - R %>" y2="<%= Y(1) %>" stroke="#444" stroke-dasharray="4 4"/>
        <line x1="<%= L %>" y1="<%= T %>" x2="<%= L %>" y2="<%= H - B %>" stroke="#333"/>
        <line x1="<%= L %>" y1="<%= H - B %>" x2="<%= W - R %>" y2="<%= H - B %>" stroke="#333"/>
        <% xl.forEach((i, n) => { %>
          <text x="<%= X(ts[i]) %>" y="<%= H - 6 %>" fill="#9a9a9a" font-size="17" text-anchor="<%= n === 0 ? 'start' : n === 2 ? 'end' : 'middle' %>"><%= day(ts[i]) %></text>
        <% }) %>
        <% KEYS.forEach((k) => segs(chart.series[k] || []).forEach((pts) => { %>
          <polyline fill="none" stroke="<%= V[k].color %>" stroke-width="2" stroke-linejoin="round" points="<%= pts.join(' ') %>"/>
        <% })) %>
      </svg>
      <div class="legend">
        <% KEYS.forEach((k) => { const sr = (chart.series[k] || []).filter((v) => v != null); const last = sr[sr.length - 1]; %>
          <span><i style="background: <%= V[k].color %>"></i><%= V[k].name %><%= last != null ? ' ' + ((last - 1) * 100 >= 0 ? '+' : '') + ((last - 1) * 100).toFixed(2) + '%' : '' %></span>
        <% }) %>
        <span class="lg-note">1.0 = price at <%= day(t0) %> · <%= ts.length %> cut-offs</span>
      </div>
    </div>
  <% } %>

  <!-- ───────── Revenue by source ───────── -->
  <h2 class="ds-pixel-h">REVENUE BY SOURCE</h2>
  <% if (!rev.length) { %><p class="info">No cut-offs yet.</p><% } else { %>
    <input class="tabsel ds-sr-only" type="radio" name="rv" id="rv7" checked>
    <input class="tabsel ds-sr-only" type="radio" name="rv" id="rv30">
    <div class="tabs"><label for="rv7">Last 7 days</label><label for="rv30">Last 30 days</label></div>
    <% rev.forEach((r) => { %>
      <div class="rvp d<%= r.days %>">
        <div class="rev">
          <% [['bank', V.bank.icon + ' Bank'], ['jackpot', V.house.icon + ' House'], ['mm', V.mm.icon + ' Market maker'], ['lotto', '🎟️ Lotto']].forEach(([acct, title]) => { const a = r.accounts[acct]; %>
            <div class="card">
              <h4><%= title %></h4>
              <div class="ds-tbl"><table>
                <% if (!a.in.length && !a.out.length) { %><tr><td class="mut">Nothing moved.</td></tr><% } %>
                <% a.in.forEach((x) => { %><tr><td><%= x.k %></td><td class="r up">+<%= fmt(x.v) %></td></tr><% }) %>
                <% a.out.forEach((x) => { %><tr><td><%= x.k %></td><td class="r down">−<%= fmt(x.v) %></td></tr><% }) %>
                <tr class="tot"><td>Net</td><td class="r <%= a.net >= 0 ? 'up' : 'down' %>"><%= (a.net >= 0 ? '+' : '−') + fmt(Math.abs(a.net)) %></td></tr>
              </table></div>
            </div>
          <% }) %>
        </div>
        <p class="info">PAT in (revenue) and out (costs and payouts) per account over the last <%= r.epochs %> daily cut-off<%= r.epochs === 1 ? '' : 's' %>. Stakes and withdrawals aren't counted here.</p>
      </div>
    <% }) %>
  <% } %>

  <!-- ───────── Your stakes ───────── -->
  <h2 class="ds-pixel-h">YOUR STAKES</h2>
  <% if (!signedIn) { %>
    <p class="info"><a href="/login">Sign in</a> to see and manage your stashes' stakes.</p>
  <% } else if (!camfrog && !locals.canStake) { %>
    <p class="ds-note warn hint">Link a chat account (Settings → Account → Connections; for Camfrog, <code>!verify</code>) to stake from here — Pepe runs it as you.</p>
  <% } else if (!mine.length) { %>
    <p class="info">You don't own or share a stash yet. <a href="/wallet">Create one in your wallet ›</a></p>
  <% } else { %>
    <% /* staking fix plan P0.3: what each stash put in, where it stands, and what staking paid it (into the stash's balance) */
       const PNL = typeof pnl === 'function' ? pnl : null;
       const sgn = (n) => (n > 0 ? '+' : n < 0 ? '−' : '') + fmt(Math.abs(n));
       const plCell = (pl) => pl == null ? '<td class="r mut" title="' + t('staking.mine.pl_none') + '">—</td>' : '<td class="r ' + (pl >= 0 ? 'up' : 'down') + '">' + sgn(pl) + '</td>';
       let grand = 0, gStaked = 0, gStakedKnown = true, gPl = 0, gPlKnown = true, gP7 = 0, gPall = 0, gPaidKnown = true; %>
    <div class="ds-tbl"><table>
      <tr><th><%= t('staking.mine.col_stash') %></th><th><%= t('staking.mine.col_vault') %></th><th class="r"><%= t('staking.mine.col_shares') %></th><th class="r"><%= t('staking.mine.col_price') %></th>
        <th class="r"><%= t('staking.mine.col_staked') %></th><th class="r"><%= t('staking.mine.col_value') %></th><th class="r"><%= t('staking.mine.col_pl') %></th><th class="r"><%= t('staking.mine.col_paid') %></th></tr>
      <% mine.forEach((m) => {
           const P = PNL ? PNL(m) : { rows: Object.fromEntries(KEYS.filter((k) => m.hold[k]).map((k) => [k, { value: Number(m.hold[k].value) || 0, staked: null, pl: null, has: true }])), total: { pl: null, staked: null } };
           const rows = KEYS.filter((k) => P.rows[k]);
           const pd = m.paid || null;
           grand += m.total;
           if (P.total.staked == null) gStakedKnown = false; else gStaked += P.total.staked;
           if (P.total.pl == null) gPlKnown = false; else gPl += P.total.pl;
           if (pd) { gP7 += pd.d7 || 0; gPall += pd.all || 0; } else gPaidKnown = false;
           const paidCell = pd ? '<td class="r' + (pd.all > 0 ? ' up' : '') + '">' + (pd.d7 > 0 ? '+' : '') + fmt(pd.d7) + ' / ' + (pd.all > 0 ? '+' : '') + fmt(pd.all) +
             (pd.corr > 0 ? '<br><small class="mut">' + t('staking.mine.corr', { n: fmt(pd.corr) }) + '</small>' : '') + '</td>' : '<td class="r mut">—</td>'; %>
        <% if (!rows.length) { %>
          <tr><td><%- UL(m.owner) %>/<%= m.name %></td><td colspan="6" class="mut"><%= t('staking.mine.nothing') %></td><%- paidCell %></tr>
        <% } %>
        <% rows.forEach((k, i) => { const r = P.rows[k], h = m.hold[k]; %>
          <tr><td><%- i === 0 ? UL(m.owner) + '/' + ULE(m.name) : '' %></td><td><%= V[k].icon %> <%= V[k].name %></td>
            <td class="r"><%= h ? (Number(h.shares) || 0).toLocaleString(undefined, { maximumFractionDigits: 2 }) : '—' %></td>
            <td class="r"><%= price(snap.prices[k]) %></td>
            <td class="r"><%= r.staked == null ? '—' : fmt(r.staked) %></td>
            <td class="r"><%= fmt(r.value) %></td><%- plCell(r.pl) %><%- i === 0 ? paidCell : '<td></td>' %></tr>
        <% }) %>
        <% m.pending.forEach((q) => { %>
          <tr><td></td><td colspan="7" class="pend">⏳ <%= q.kind %> <%= q.amount ? fmt(q.amount) + ' PAT' : q.shares ? q.shares.toLocaleString(undefined, { maximumFractionDigits: 2 }) + ' shares' : '' %>
            <%= q.kind === 'withdraw' ? 'from' : 'into' %> <%= (V[q.vault] || { name: q.vault }).name %> · <%= q.state || 'queued' %><%= q.ts ? ' · ' + when(q.ts) + ' UTC' : '' %></td></tr>
        <% }) %>
      <% }) %>
      <tr class="tot"><td><%= t('staking.mine.total') %></td><td></td><td></td><td></td><td class="r"><%= PNL && gStakedKnown ? fmt(gStaked) : '—' %></td><td class="r"><%= fmt(grand) %></td>
        <%- plCell(PNL && gPlKnown ? gPl : null) %><td class="r"><%= gPaidKnown ? (gP7 > 0 ? '+' : '') + fmt(gP7) + ' / ' + (gPall > 0 ? '+' : '') + fmt(gPall) : '—' %></td></tr>
    </table></div>
    <p class="info"><%- t('staking.mine.note') %></p>
    <% /* P2.1: what each stash has earned toward next Monday's payout so far - its share of each vault's PAT-days this week */
       const pdw = snap.pd_week || {}, pdt = pdw.total || {};
       const wk = mine.map((m) => {
         const parts = ['house', 'bank', 'mm'].filter((v) => (m.pd || {})[v] > 0 && pdt[v] > 0).map((v) => V[v].icon + ' ' + V[v].name + ' ' + pct(m.pd[v] / pdt[v], 1));
         return parts.length ? [m, parts] : null;
       }).filter(Boolean);
       if (s.weighted && wk.length) { %>
      <p class="info"><b><%= t('staking.mine.week_h', { when: pdw.boundary ? when(pdw.boundary) : '—' }) %></b>
        <% wk.forEach(([m, parts], i) => { %><%- i ? ' · ' : '' %><%- UL(m.owner) %>/<%= m.name %>: <%= parts.join(', ') %><% }) %></p>
      <p class="info"><%- t('staking.mine.week_help') %></p>
    <% } %>

    <div class="forms">
      <form method="post" action="/act"><%- hidden('stash') %>
        <b><span class="ds-ic" aria-hidden="true">📥</span> Stake</b>
        <input type="hidden" name="a0" value="stake">
        <select name="a1"><% mine.forEach((m) => { %><option value="<%= m.ref %>"><%= m.owner_name || m.owner %>/<%= m.name %></option><% }) %></select>
        <input type="text" name="a2" pattern="[Aa][Ll][Ll]|[0-9][0-9,]*[kKmM]?" placeholder="amount or all" required>
        <%- vaultSelect('auto') %>
        <button type="submit">Stake</button>
        <span class="info">Moves PAT from the stash into the vault at the next daily cut-off, at that day's share price.</span>
      </form>
      <form method="post" action="/act"><%- hidden('stash') %>
        <b><span class="ds-ic" aria-hidden="true">📤</span> Unstake</b>
        <input type="hidden" name="a0" value="unstake">
        <select name="a1"><% mine.forEach((m) => { %><option value="<%= m.ref %>"><%= m.owner_name || m.owner %>/<%= m.name %></option><% }) %></select>
        <input type="text" name="a2" pattern="[Aa][Ll][Ll]|[0-9][0-9,]*[kKmM]?" placeholder="amount or all" required>
        <%- vaultSelect('auto') %>
        <button class="alt" type="submit">Unstake</button>
        <span class="info">Runs at the next daily cut-off at that day's price and pays back into the stash. If the vault has no free cash (it's lent out or committed to markets), the withdrawal waits in the queue until it does.</span>
      </form>
    </div>
  <% } %>
<% } %>

  <script>
    (function () {
      const fmt = (s) => s >= 86400 ? Math.floor(s/86400) + 'd ' + Math.floor(s%86400/3600) + 'h' : s >= 3600 ? Math.floor(s/3600) + 'h ' + Math.floor(s%3600/60) + 'm' : s >= 60 ? Math.floor(s/60) + 'm ' + (s%60) + 's' : s > 0 ? s + 's' : 'now';
      const tick = () => document.querySelectorAll('[data-until]').forEach((el) => { el.textContent = fmt(Math.max(0, Math.round(Number(el.dataset.until) - Date.now() / 1000))); });
      tick(); setInterval(tick, 1000);
    })();
  </script>
</main>
</body>
</html>
