<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('rank.title'), user: user }) %>
<%
  const fmt = (n) => Math.floor(Number(n) || 0).toLocaleString('en-US');
  const avs = typeof gtfAvatars !== 'undefined' && gtfAvatars ? gtfAvatars : {};
  const lvlList = typeof byLevel !== 'undefined' && byLevel ? byLevel : [];
  const badgeList = typeof byBadges !== 'undefined' && byBadges ? byBadges : [];
  const need = (lv) => { try { return typeof xpForNextLevel === 'function' ? xpForNextLevel(lv) : 0; } catch (e) { return 0; } };
  const pctOf = (u) => { const n = need(u.level); return n ? Math.max(0, Math.min(100, (Number(u.xp) || 0) / n * 100)) : 0; };
  const nameOf = (u) => typeof cosmeticNameHtml === 'function' ? cosmeticNameHtml(u.username, u.displayname || u.username)
    : String(u.displayname || u.username).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const prof = (u) => '/u/' + encodeURIComponent(u.username);
  const isMe = (u) => !!user && u.username === user;
  // metric per board: [big value, unit]
  const metric = {
    pat:    (u) => [fmt(u.points_balance), 'PAT'],
    level:  (u) => [t('rank.lv', { n: fmt(u.level) }), t('rank.xp', { n: fmt(u.xp) })],
    badges: (u) => [fmt(u.badges), t('rank.badge_unit', { count: Number(u.badges) })],
  };
  const boards = [
    { id: 'pat', label: 'PAT', list: users, empty: t('rank.empty_pat') },
    { id: 'level', label: t('rank.tab_level'), list: lvlList, empty: t('rank.empty_level') },
    { id: 'badges', label: t('rank.tab_badges'), list: badgeList, empty: t('rank.empty_badges') },
  ];
  const pot = typeof currentPot !== 'undefined' ? currentPot : 0;
  const hasSupply = typeof supply !== 'undefined' && supply;
%>
<%- include('partials/cosmetics-css') %>
<style>
  /* 1.99pt polish: on the design system (docs/design-system.md, "Area notes: games"). A compact gold hero (money page), .ds-tabs for the
     boards (the .lb-tab class stays - the script finds the tabs by it), .ds-pixel-h panel headings, ds cards and tokens. */
  .lb { --ds-ac: var(--ds-gold); --ds-ac-2: var(--ds-gold); --ds-ac-bg: rgba(255,207,64,.12); --ds-ac-line: var(--ds-gold-line); --ds-on-ac: var(--ds-on-gold); }
  .lb a:not([class]) { color: var(--ds-green-2); }
  .lb .card { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); min-width: 0; }
  .lb-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--ds-sp-3h) var(--ds-sp-5); align-items: center; }
  .lb-head .ds-sub { margin-top: var(--ds-sp-1h); }
  .lb-tiles { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2h); }
  .lb-tile { display: grid; gap: 3px; margin: 0; min-width: 150px; min-height: var(--ds-tap); padding: var(--ds-sp-2h) var(--ds-sp-3h); border-radius: var(--ds-r-md);
             background: var(--ds-glass); border: 1px solid #2c2c2c; text-align: start; font: inherit; color: inherit !important; text-decoration: none !important; cursor: default; }
  button.lb-tile, a.lb-tile { cursor: pointer; transition: border-color var(--ds-dur-1); }
  button.lb-tile:hover, a.lb-tile:hover { border-color: var(--ds-gold); }
  .lb-tile:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .lb-tile .k { display: block; font: 700 11px/1.3 var(--ds-font); letter-spacing: var(--ds-ls-label); text-transform: uppercase; color: var(--ds-text-muted); }
  .lb-tile .v { display: block; font-size: 20px; font-weight: 700; line-height: 1.2; color: var(--ds-gold-text); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }

  .lb-panel[hidden] { display: none !important; }
  .lb-panel { display: grid; gap: var(--ds-sp-4); min-width: 0; }
  .lb .ds-pixel-h { margin: 0 0 var(--ds-sp-3); }

  /* podium: 2nd / 1st / 3rd */
  .lb-pod { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--ds-sp-3); align-items: end; padding-top: var(--ds-sp-3); }
  .lb-pod .p { position: relative; display: grid; justify-items: center; gap: var(--ds-sp-1h); text-align: center; padding: var(--ds-sp-4) var(--ds-sp-2h) var(--ds-sp-3h);
               border-radius: var(--ds-r-xl); border: 1px solid var(--ds-line); background: linear-gradient(180deg, #161616, #0f0f0f); min-width: 0;
               color: inherit !important; text-decoration: none; transition: transform var(--ds-dur-2), border-color var(--ds-dur-2); }
  .lb-pod a.p:hover { transform: translateY(-2px); }
  .lb-pod .p1 { order: 2; padding-top: var(--ds-sp-5); border-color: #8a7420; background: linear-gradient(180deg, #2a2410, #111 70%); box-shadow: 0 0 24px rgba(255,215,0,.12); }
  .lb-pod .p2 { order: 1; border-color: #5a5f66; }
  .lb-pod .p3 { order: 3; border-color: #6b4a2c; }
  .lb-pod .medal { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); width: 28px; height: 28px; border-radius: 50%;
                   display: grid; place-items: center; font: 11px/1 var(--ds-font-pixel); color: #111; box-shadow: 0 2px 0 rgba(0,0,0,.4); }
  .lb-pod .p1 .medal { background: linear-gradient(180deg, #ffe66b, #e0a800); }
  .lb-pod .p2 .medal { background: linear-gradient(180deg, #f0f3f6, #9aa3ad); }
  .lb-pod .p3 .medal { background: linear-gradient(180deg, #f0b27a, #a8642c); }
  .lb-pod .av { width: 96px; height: 96px; border-radius: var(--ds-r-lg); overflow: hidden; background: #0b0b0b; border: 2px solid #2b2b2b; display: grid; place-items: center; }
  .lb-pod .p1 .av { width: 120px; height: 120px; border-color: #b8961d; }
  .lb-pod .av svg { width: 100%; height: 100%; display: block; image-rendering: pixelated; }
  .lb-pod .av img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lb-pod .nm { font-weight: 700; font-size: 15px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ds-text-strong); }
  .lb-pod .val { font-size: 20px; font-weight: 700; color: var(--ds-gold-text); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; line-height: 1.15; }
  .lb-pod .p1 .val { font-size: 24px; }
  .lb-pod .sub { font-size: var(--ds-fs-xs); color: var(--ds-text-muted); }
  .lb-pod .me-tag, .lb-row .me-tag { font-size: 10px; letter-spacing: .08em; padding: 1px 6px; border-radius: var(--ds-r-pill); background: var(--ds-green); color: var(--ds-on-ac);
                                      vertical-align: 2px; margin-inline-start: 4px; font-weight: 700; text-transform: uppercase; }
  .lb-row .me-tag { color: #04150a; }

  /* rank list */
  .lb-list { list-style: none; margin: 0; padding: 0; }
  .lb-row { display: grid; grid-template-columns: 44px minmax(0, 1fr) 150px 130px; gap: var(--ds-sp-2h); align-items: center; min-height: var(--ds-tap);
            padding: var(--ds-sp-2) var(--ds-sp-1h); border-bottom: 1px solid var(--ds-line-soft); font-variant-numeric: tabular-nums; }
  .lb-row:last-child { border-bottom: 0; }
  .lb-row.hd { min-height: 0; color: var(--ds-text-muted); font-size: 11.5px; font-weight: 700; letter-spacing: var(--ds-ls-label); text-transform: uppercase; padding-top: 0; }
  .lb-row.me { background: var(--ds-green-bg); border-radius: var(--ds-r-sm); }
  .lb-row .rk { color: var(--ds-text-muted); font-weight: 700; text-align: end; padding-inline-end: 4px; }
  .lb-row .who { display: flex; align-items: center; gap: var(--ds-sp-2h); min-width: 0; }
  .lb-row .who img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; flex: none; background: #0d0d0d; border: 1px solid #2a2a2a; }
  .lb-row .who a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; color: var(--ds-text); text-decoration: none; }
  .lb-row .who a:hover { color: #fff; text-decoration: underline; }
  .lb-row .lv { display: grid; gap: var(--ds-sp-1); font-size: var(--ds-fs-meta); color: #ccc; }
  .lb-row .lv small { color: var(--ds-text-faint); }
  .lb-row .bar { height: 6px; background: #1f1f1f; border-radius: var(--ds-r-pill); overflow: hidden; }
  .lb-row .bar span { display: block; height: 100%; background: var(--ds-green); }
  .lb-row .amt { text-align: end; font-weight: 700; color: var(--ds-gold-text); white-space: nowrap; }
  .lb-row .amt small { color: #d9c88a; font-weight: 700; font-size: 11px; }
  .lb-row.hd .amt { color: var(--ds-text-muted); }
  .lb .muted { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); }
  .lb .muted b.gold { color: var(--ds-gold-text); }
  .lb .empty { color: var(--ds-text-muted); text-align: center; padding: var(--ds-sp-5) 0; margin: 0; }

  /* jackpots + supply */
  .lb-jp { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto 80px; gap: var(--ds-sp-2h); align-items: center; min-height: var(--ds-tap); padding: var(--ds-sp-2) var(--ds-sp-1);
           border-bottom: 1px solid var(--ds-line-soft); font-variant-numeric: tabular-nums; }
  .lb-jp:last-child { border-bottom: 0; }
  .lb-jp .rk { color: var(--ds-text-muted); text-align: end; }
  .lb-jp a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .lb-jp .amt { color: var(--ds-gold-text); font-weight: 700; text-align: end; white-space: nowrap; }
  .lb-jp .t { color: var(--ds-text-muted); font-size: var(--ds-fs-xs); text-align: end; }
  .lb-sup { display: grid; gap: var(--ds-sp-2h); }
  .lb-sup .r { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--ds-sp-1) var(--ds-sp-3); font-variant-numeric: tabular-nums; }
  .lb-sup .r .l { overflow-wrap: anywhere; }
  .lb-sup .r .a, .lb-sup .lyr-h .a { text-align: end; color: var(--ds-gold-text); font-weight: 700; }
  .lb-sup .r .a small, .lb-sup .lyr-h .a small { color: var(--ds-text-muted); font-weight: 400; margin-inline-start: 6px; }
  .lb-sup .r .bar { grid-column: 1 / -1; height: 6px; background: #1f1f1f; border-radius: var(--ds-r-pill); overflow: hidden; }
  .lb-sup .r .bar span { display: block; height: 100%; background: var(--ds-gold-grad); }
  .lb-sup .lyr { display: grid; gap: var(--ds-sp-2h); padding: var(--ds-sp-3) 0 var(--ds-sp-1); border-top: 1px solid var(--ds-line); }
  .lb-sup .lyr:first-child { border-top: 0; padding-top: 0; }
  .lb-sup .lyr-h { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px var(--ds-sp-3); font-variant-numeric: tabular-nums; }
  .lb-sup .lyr-h b { color: var(--ds-text-strong); }
  .lb-sup .lyr-h .d { grid-column: 1 / -1; color: var(--ds-text-muted); font-size: var(--ds-fs-meta); }

  @media (max-width: 760px) {
    .lb-row { grid-template-columns: 34px minmax(0, 1fr) auto; }
    .lb-row .lv { display: none; }
    .lb-row.lvl-board .lv { display: grid; text-align: end; }
    .lb-row.lvl-board .lv .bar, .lb-row.lvl-board .amt { display: none; }
    .lb-head { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 520px) {
    .lb-pod { gap: var(--ds-sp-2); }
    .lb-pod .p { padding: var(--ds-sp-3h) var(--ds-sp-1) var(--ds-sp-2h); }
    .lb-pod .p1 { padding-top: 18px; }
    .lb-pod .av { width: 64px; height: 64px; border-radius: var(--ds-r-md); }
    .lb-pod .p1 .av { width: 80px; height: 80px; }
    .lb-pod .nm { font-size: var(--ds-fs-meta); }
    .lb-pod .val, .lb-pod .p1 .val { font-size: 15px; }
    .lb-pod .sub { font-size: 11px; }
    .lb-tile { min-width: 0; flex: 1 1 140px; }
    .lb-tile .v { font-size: 17px; }
    .lb-jp { grid-template-columns: 24px minmax(0, 1fr) auto; }
    .lb-jp .t { grid-column: 2 / -1; text-align: start; margin-top: -6px; }
  }
  @media (prefers-reduced-motion: reduce) { .lb-pod .p, .lb-tile { transition: none; } .lb-pod a.p:hover { transform: none; } }
</style>

<main class="ds-page lb">
  <section class="ds-hero compact gold lb-head">
    <div>
      <h1><%- t('rank.heading') %></h1>
      <p class="ds-sub"><%- t('rank.sub') %></p>
    </div>
    <div class="lb-tiles">
      <% if (hasSupply) { %>
        <button type="button" class="lb-tile" data-go="supply" title="<%- t('rank.tile.supply_title') %>"><span class="k"><%- t('rank.tile.supply') %></span><span class="v"><%= fmt(supply.total) %></span></button>
      <% } %>
      <% if (hasSupply && supply.burned) { %>
        <a class="lb-tile" href="/economy#burned" title="<%- t('rank.tile.burned_title') %>"><span class="k"><%- t('rank.tile.burned') %></span><span class="v"><%= fmt(supply.burned.total) %></span></a>
      <% } %>
      <button type="button" class="lb-tile" data-go="jackpots" title="<%- t('rank.tile.jackpot_title') %>"><span class="k"><%- t('rank.tile.jackpot') %></span><span class="v"><%= fmt(pot) %></span></button>
    </div>
  </section>

  <div class="ds-tabs lb-tabs" role="tablist" aria-label="<%- t('rank.tabs_aria') %>">
    <% boards.forEach((b, i) => { %>
      <button type="button" class="ds-tab lb-tab" role="tab" id="t-<%= b.id %>" aria-controls="p-<%= b.id %>" aria-selected="<%= i === 0 ? 'true' : 'false' %>" data-tab="<%= b.id %>"><%- b.label %></button>
    <% }) %>
    <button type="button" class="ds-tab lb-tab" role="tab" id="t-jackpots" aria-controls="p-jackpots" aria-selected="false" data-tab="jackpots"><%- t('rank.tab_jackpots') %></button>
    <button type="button" class="ds-tab lb-tab" role="tab" id="t-supply" aria-controls="p-supply" aria-selected="false" data-tab="supply"><%- t('rank.tab_supply') %></button>
  </div>

  <% boards.forEach((b, bi) => { const list = b.list || []; const m = metric[b.id]; %>
  <section class="lb-panel" role="tabpanel" id="p-<%= b.id %>" aria-labelledby="t-<%= b.id %>"<%= bi === 0 ? '' : ' hidden' %>>
    <% if (!list.length) { %>
      <div class="card"><p class="empty"><%- b.empty %></p></div>
    <% } else { %>
      <div class="lb-pod">
        <% list.slice(0, 3).forEach((u, i) => { const v = m(u); %>
          <a class="p p<%= i + 1 %>" href="<%= prof(u) %>">
            <span class="medal" aria-label="<%- t('rank.rank_n', { n: i + 1 }) %>"><%= i + 1 %></span>
            <span class="av"><% if (avs[u.username]) { %><%- avs[u.username] %><% } else { %><img src="<%= u.avatar || '/public/img/avatar.png' %>" alt="" loading="lazy" onerror="this.onerror=null;this.src='/public/img/avatar.png'"><% } %></span>
            <span class="nm"><%- nameOf(u) %><% if (isMe(u)) { %><span class="me-tag"><%- t('rank.you') %></span><% } %></span>
            <span class="val"><%- v[0] %></span>
            <span class="sub"><%- v[1] %><% if (b.id !== 'level') { %> &middot; <%- t('rank.lv', { n: fmt(u.level) }) %><% } %></span>
          </a>
        <% }) %>
      </div>

      <% if (list.length > 3) { %>
      <div class="card">
        <ol class="lb-list">
          <li class="lb-row hd<%= b.id === 'level' ? ' lvl-board' : '' %>" aria-hidden="true"><span class="rk">#</span><span><%- t('rank.col_player') %></span><span class="lv"><%- t('rank.tab_level') %></span><span class="amt"><%- b.id === 'badges' ? t('rank.tab_badges') : 'PAT' %></span></li>
          <% list.slice(3).forEach((u, j) => { const i = j + 3; %>
            <li class="lb-row<%= b.id === 'level' ? ' lvl-board' : '' %><%= isMe(u) ? ' me' : '' %>">
              <span class="rk"><%= i + 1 %></span>
              <span class="who"><img src="<%= u.avatar || '/public/img/avatar.png' %>" alt="" loading="lazy" onerror="this.onerror=null;this.src='/public/img/avatar.png'"><a href="<%= prof(u) %>"><%- nameOf(u) %></a><% if (isMe(u)) { %><span class="me-tag"><%- t('rank.you') %></span><% } %></span>
              <span class="lv"><span><%- t('rank.lv', { n: fmt(u.level) }) %> <small><%- t('rank.xp', { n: fmt(u.xp) }) %></small></span><span class="bar"><span style="width: <%= pctOf(u).toFixed(1) %>%"></span></span></span>
              <% if (b.id === 'badges') { %>
                <span class="amt"><%= fmt(u.badges) %></span>
              <% } else { %>
                <span class="amt"><%= fmt(u.points_balance) %> <small>PAT</small></span>
              <% } %>
            </li>
          <% }) %>
        </ol>
      </div>
      <% } %>
    <% } %>
  </section>
  <% }) %>

  <section class="lb-panel" role="tabpanel" id="p-jackpots" aria-labelledby="t-jackpots" hidden>
    <div class="card">
      <h2 class="ds-pixel-h"><%- t('rank.jp.heading') %></h2>
      <p class="muted" style="margin:-4px 0 12px"><%- t('rank.jp.pot', { pot: '<b class="gold">' + fmt(pot) + ' PAT</b>' }) %> &middot; <%- t('rank.jp.land', { wheel: '<a href="' + t.esc(user ? '/u/' + encodeURIComponent(user) + '/wheel' : '/login') + '">' + t('rank.jp.wheel') + '</a>' }) %></p>
      <% if (!jackpots || jackpots.length === 0) { %>
        <p class="empty"><%- t('rank.jp.none') %></p>
      <% } else { %>
        <div>
          <% jackpots.forEach((j, index) => { %>
            <div class="lb-jp">
              <span class="rk"><%= index + 1 %></span>
              <a href="/u/<%= encodeURIComponent(j.username) %>"><%- nameOf(j) %></a>
              <span class="amt"><%= fmt(j.amount) %> PAT</span>
              <span class="t jackpot-time" data-ts="<%= j.timestamp %>"><%= j.timestamp %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <section class="lb-panel" role="tabpanel" id="p-supply" aria-labelledby="t-supply" hidden>
    <div class="card">
      <h2 class="ds-pixel-h"><%- t('rank.sup.heading') %></h2>
      <% if (hasSupply) { %>
        <p class="muted" style="margin:-4px 0 14px"><%- t('rank.sup.total', { total: '<b class="gold">' + fmt(supply.total) + ' PAT</b>' }) %>
          <% if (supply.burned) { %> · <%- t('rank.sup.burned', { total: '<b>' + fmt(supply.burned.total) + '</b>', d7: fmt(supply.burned.d7), d30: fmt(supply.burned.d30) }) %> · <a href="/economy#burned"><%- t('rank.sup.burn_log') %></a><% } %></p>
        <div class="lb-sup">
          <% const _groups = (supply.layers && supply.layers.length) ? supply.layers.map((g) => ({ ...g, rows: supply.rows.filter((r) => r.layer === g.key) }))
                                                                    : [{ key: "all", label: "", rows: supply.rows }]; %>
          <% _groups.forEach((g) => { const gshare = supply.total ? (g.amount / supply.total * 100) : 0; %>
            <div class="lyr">
              <% if (g.label) { %>
                <div class="lyr-h"><b><%= g.label %></b><span class="a"><%= fmt(g.amount) %><small><%= gshare.toFixed(1) %>%</small></span>
                  <span class="d"><%= g.blurb %></span></div>
              <% } %>
              <% g.rows.forEach((r) => { const share = supply.total ? (r.amount / supply.total * 100) : 0; %>
                <div class="r"><span class="l"><%= r.label %></span><span class="a"><%= fmt(r.amount) %><small><%= share.toFixed(1) %>%</small></span>
                  <span class="bar"><span style="width: <%= Math.max(0, Math.min(100, share)).toFixed(1) %>%"></span></span></div>
              <% }) %>
            </div>
          <% }) %>
        </div>
        <p class="muted" style="margin:14px 0 0"><%- t('rank.sup.note') %>
          <% if (supply.updated) { %><%- t('rank.sup.as_of', { when: supply.updated }) %><% } else { %><%- t('rank.sup.not_reported') %><% } %>
          <a href="/economy"><%- t('rank.sup.how') %></a></p>
      <% } else { %>
        <p class="empty"><%- t('rank.sup.unavailable') %></p>
      <% } %>
    </div>
  </section>
</main>

<script>
  (function () {
    var _t = typeof __t === 'function' ? __t : function (k, d, v) { return String(d).replace(/\{!?(\w+)\}/g, function (m, n) { return v && v[n] != null ? v[n] : m; }); };
    var ids = ['pat', 'level', 'badges', 'jackpots', 'supply'];
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.lb-tab'));
    function show(name, focus) {
      if (ids.indexOf(name) < 0) name = 'pat';
      tabs.forEach(function (t) {
        var on = t.dataset.tab === name;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      ids.forEach(function (id) { var p = document.getElementById('p-' + id); if (p) p.hidden = id !== name; });
      try { localStorage.setItem('rankingsTab', name); } catch (e) { }
      if (history.replaceState) history.replaceState(null, '', name === 'pat' ? location.pathname : '#' + name);
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { show(t.dataset.tab); });
      t.addEventListener('keydown', function (e) {
        var d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        show(tabs[(i + d + tabs.length) % tabs.length].dataset.tab, true);
      });
    });
    document.querySelectorAll('[data-go]').forEach(function (b) {
      b.addEventListener('click', function () { show(b.dataset.go); document.querySelector('.lb-tabs').scrollIntoView({ block: 'nearest' }); });
    });

    // relative times for jackpots (SQLite timestamps are UTC "YYYY-MM-DD HH:MM:SS")
    function relTime(ts) {
      if (!ts) return '';
      var d = new Date(String(ts).replace(' ', 'T') + 'Z');
      if (isNaN(d)) return ts;
      var s = Math.floor((Date.now() - d.getTime()) / 1000);
      if (s < 60) return _t('js.rank.s_ago', '{n}s ago', { n: s });
      if (s < 3600) return _t('js.rank.m_ago', '{n}m ago', { n: Math.floor(s / 60) });
      if (s < 86400) return _t('js.rank.h_ago', '{n}h ago', { n: Math.floor(s / 3600) });
      if (s < 2592000) return _t('js.rank.d_ago', '{n}d ago', { n: Math.floor(s / 86400) });
      return d.toLocaleDateString();
    }
    document.querySelectorAll('.jackpot-time').forEach(function (el) { el.textContent = relTime(el.dataset.ts); });

    var start = (location.hash || '').slice(1);
    if (!start) { try { start = localStorage.getItem('rankingsTab') || ''; } catch (e) { } }
    // older saved value from the previous page
    if (start === 'points') start = 'pat';
    if (start) show(start);
  })();
</script>
</body>
</html>
