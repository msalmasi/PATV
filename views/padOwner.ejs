<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%# The room owner's Pepe control panel (1.99qr, padowner.js): /p/<slug>/owner - the room vault + Top up, royalties, Prime Time,
    the stage, the room's Pepe settings, and "What you can do with Pepe in your room" (generated from Pepe's code). With
    guide = true it is the public guide (/pads/owner-guide): only the capability list. Client: public/js/pad-owner.js. %>
<%- include('layout', { title: guide ? t('owner.guide_title') : t('owner.title', { pad: room.title }), user: user }) %>
<%
  const num = (n) => (t.num ? t.num(Math.round(Number(n) || 0)) : Math.round(Number(n) || 0).toLocaleString('en-US'));
  const dt = (ms) => (locals.tzFmt || new Function(include('../tz-core.js'))()('UTC', 'en').fmt)(ms, 'datetime');
  const dd = (ms) => (locals.tzFmt || new Function(include('../tz-core.js'))()('UTC', 'en').fmt)(ms, 'date');
  const PAT = (n, cls) => `<span class="ds-pat${cls ? ' ' + cls : ''}"><b>${num(n)}</b><small>PAT</small></span>`;
  const href = slug ? '/p/' + encodeURIComponent(slug) : null;
  const sub = (s) => String(s || '').replace('{slug}', encodeURIComponent(slug || 'your-pad'));
  const capT = (c, f) => (t.has('owner.cap.' + c.id + '.' + f) ? t('owner.cap.' + c.id + '.' + f) : t.esc(c[f === 'title' ? 'title' : 'howto'] || ''));
  const AREAS = [['room', '🐸'], ['stage', '📺'], ['vault', '🏦'], ['games', '🎤'], ['feed', '📝'], ['tier', '🚀']];
  const capsList = (caps && caps.capabilities) || [];
%>
<style>
  .po { --ds-ac: var(--ds-green); }
  .po .po-grid { display: grid; gap: var(--ds-sp-3); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1000px) { .po .po-grid.two { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .po .po-why { margin: 0; color: var(--ds-text-2); font-size: 14px; line-height: 1.55; }
  .po .po-why b { color: var(--ds-text-strong); }
  .po details.po-more > summary { cursor: pointer; color: var(--ds-ac-2); font-size: 13.5px; min-height: 32px; display: flex; align-items: center; }
  /* 1.99tf: the Pepe card - groups of rows, a per-row status, the "N more settings" disclosure */
  .po .po-gh { margin: var(--ds-sp-4) 0 2px; }
  .po .po-gh + .ds-meta { margin: 0 0 var(--ds-sp-1); }
  .po .po-here { margin: 0; }
  .po .po-ctl { max-width: 240px; flex: none; }
  .po .po-admin { color: var(--ds-warn); }
  .po .po-st { display: block; min-height: 0; font-size: 12.5px; color: var(--ds-text-muted); }
  .po .po-st:empty { display: none; }
  .po .po-st.wait { color: var(--ds-warn); } .po .po-st.ok { color: var(--ds-ok); } .po .po-st.bad { color: var(--ds-danger); }
  .po .po-set.pending .ds-switch, .po .po-set.pending .po-ctl { opacity: .6; }
  .po .po-note { display: flex; gap: var(--ds-sp-1h); flex: 1 1 280px; max-width: 420px; }
  .po .po-note .ds-in { flex: 1; min-width: 0; }
  .po .po-set-note { flex-wrap: wrap; }
  .po details.po-disc { margin-top: var(--ds-sp-3); border: 1px solid var(--ds-line); border-radius: var(--ds-r-md); background: var(--ds-sunken); }
  .po details.po-disc > summary { list-style: none; width: 100%; justify-content: space-between; border: 0; border-radius: var(--ds-r-md); min-height: var(--ds-tap); }
  .po details.po-disc > summary::-webkit-details-marker { display: none; }
  .po details.po-disc > summary::marker { content: ""; }
  .po .po-chev { width: 9px; height: 9px; border-inline-end: 2px solid currentColor; border-block-end: 2px solid currentColor; transform: rotate(-45deg); transition: transform var(--ds-dur-2) var(--ds-ease); flex: none; margin-inline-end: 4px; }
  [dir="rtl"] .po .po-chev { transform: rotate(135deg); }
  .po details.po-disc[open] > summary .po-chev { transform: rotate(45deg); }
  .po details.po-disc[open] > summary { border-end-start-radius: 0; border-end-end-radius: 0; border-block-end: 1px solid var(--ds-line); }
  .po .po-disc-b { display: grid; gap: var(--ds-sp-2); padding: var(--ds-sp-3); }
  @media (prefers-reduced-motion: reduce) { .po .po-chev { transition: none; } }
  @media (max-width: 520px) { .po .po-set:has(.po-ctl), .po .po-set-note { flex-wrap: wrap; } .po .po-ctl { max-width: 100%; width: 100%; } .po .po-note { max-width: 100%; } }
  .po .po-set { display: flex; align-items: center; justify-content: space-between; gap: var(--ds-sp-3); min-height: 52px; padding: var(--ds-sp-2) 0; border-top: 1px solid var(--ds-line-soft); }
  .po .po-set:first-of-type { border-top: 0; }
  .po .po-set > div { min-width: 0; }
  .po .po-set .ds-meta { margin: 2px 0 0; }
  .po .po-ro { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: var(--ds-sp-1h) var(--ds-sp-3); margin: 0; padding: 0; list-style: none; }
  .po .po-ro li { display: flex; justify-content: space-between; gap: var(--ds-sp-2); font-size: 13.5px; color: var(--ds-text-2); border-bottom: 1px solid var(--ds-line-soft); padding: 6px 0; }
  .po .po-cap { display: grid; gap: var(--ds-sp-1h); padding: var(--ds-sp-3) 0; border-top: 1px solid var(--ds-line-soft); }
  .po .po-cap:first-of-type { border-top: 0; padding-top: 0; }
  .po .po-cap code { font-family: var(--ds-font-mono); font-size: 12.5px; background: var(--ds-sunken); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xs); padding: 1px 6px; overflow-wrap: anywhere; }
  .po .po-cmds { display: flex; flex-wrap: wrap; gap: 6px; }
  .po .po-msg { min-height: 1.2em; font-size: 13px; color: var(--ds-text-muted); overflow-wrap: anywhere; }
  .po .po-msg.ok { color: var(--ds-ok); } .po .po-msg.bad { color: var(--ds-danger); }
  .po .po-hist { margin: 0; padding: 0; list-style: none; }
  .po .po-hist li { display: flex; justify-content: space-between; gap: var(--ds-sp-2); padding: 8px 0; border-top: 1px solid var(--ds-line-soft); font-size: 13.5px; color: var(--ds-text-2); }
  .po .po-hist li:first-child { border-top: 0; }
  .po .po-quick { display: flex; flex-wrap: wrap; gap: var(--ds-sp-1h); }
  .po .ds-subnav .ds-tabs { gap: var(--ds-sp-1h); }
  .po section[id] { scroll-margin-top: 72px; }
</style>
<main class="ds-page po" id="po" <% if (!guide) { %>data-slug="<%= slug %>"<% } %>>
<% if (guide) { %>
  <section class="ds-hero compact">
    <p class="ds-eyebrow"><%- t('owner.guide_eyebrow') %></p>
    <h1><%- t('owner.can_h') %></h1>
    <p class="ds-lead"><%- t('owner.guide_lead') %></p>
    <div class="ds-ctas"><a class="ds-btn" href="/pads/new"><%- t('owner.guide_cta') %></a></div>
  </section>
  <section class="ds-card lg" id="earn" aria-labelledby="poEarnH">
    <h2 class="ds-h2" id="poEarnH"><span class="dot"></span>👑 <%- t('owner.guide_earn_h') %></h2>
    <p class="po-why"><%- t('owner.share_why', { rate: 10, pct: 15, days: 3, active: 3, cap: 25 }) %></p>
    <p class="po-why"><%- t('owner.recipe_why', { owner: 15, gang: 15, streamers: 25, people: 35, games: 10, convoy: '25,000' }) %></p>
    <p class="ds-meta"><%- t('owner.guide_earn_more') %></p>
  </section>
<% } else { %>
  <a class="ds-back" href="<%= href %>">← <%- t('owner.back', { pad: room.title }) %></a>
  <header class="ds-head">
    <p class="ds-eyebrow"><%- t('owner.eyebrow') %></p>
    <h1 class="ds-h1"><%= room.title %></h1>
    <p class="ds-sub"><%- t('owner.lead') %></p>
  </header>
  <% if (!mine && staff) { %><div class="ds-note info"><span class="ds-ic" aria-hidden="true">🛠️</span><div><%- t('owner.staff_view') %></div></div><% } %>
  <nav class="ds-subnav" aria-label="<%- t('owner.sections') %>"><div class="ds-tabs">
    <% if (camfrog) { %><a class="ds-tab" href="#pepe">🐸 <%- t('owner.nav_pepe') %></a><% } %>
    <% if (camfrog) { %><a class="ds-tab" href="#vault">💰 <%- t('owner.nav_vault') %></a><% } %>
    <a class="ds-tab" href="#royalties">👑 <%- t('owner.nav_roy') %></a>
    <% if (camfrog) { %><a class="ds-tab" href="#recipe">💸 <%- t('owner.recipe_h') %></a><% } %>
    <a class="ds-tab" href="#prime">📺 <%- t('owner.nav_prime') %></a>
    <a class="ds-tab" href="#stage">🎬 <%- t('owner.nav_stage') %></a>
    <% if (camfrog) { %><a class="ds-tab" href="#soundboard">🔊 <%- t('owner.nav_sb') %></a><% } %>
    <a class="ds-tab" href="#can">❓ <%- t('owner.nav_can') %></a>
  </div></nav>

  <% if (camfrog) { %>
  <%# 1.99tf: the 🐸 card leads the panel. Every value is Pepe's own last report (padowner.settingsFor), with when he sent it;
      a change shows "waiting for Pepe" until a report newer than his answer confirms it (public/js/pad-owner.js). %>
  <section class="ds-card lg po-pepe" id="pepe" aria-labelledby="poPepeH" <% if (pepe) { %>data-synced="<%= pepe.updated %>"<% } %>>
    <h2 class="ds-h2" id="poPepeH"><span class="dot"></span>🐸 <%- t('owner.pepe_h') %>
      <% if (pepe) { %><span class="ds-chip <%= pepe.stale ? 'warn' : 'ok' %>" id="poSync" title="<%= dt(pepe.updated) %>"><%- t('owner.synced', { when: dt(pepe.updated) }) %></span><% } %></h2>
    <p class="po-why"><%- t('owner.pepe_why') %></p>
    <% if (!pepe) { %>
      <div class="ds-empty"><span aria-hidden="true">🐸</span><b><%- t('owner.pepe_unknown') %></b><p><%- t('owner.pepe_unknown_help') %></p></div>
    <% } else { %>
      <% if (pepe.stale) { %><div class="ds-note warn"><span class="ds-ic" aria-hidden="true">⏳</span><div><%- t('owner.pepe_stale', { when: dt(pepe.updated) }) %></div></div><% } %>
      <p class="ds-meta po-here"><%- pepe.pepe_here ? t('owner.here_yes') : t('owner.here_no') %></p>
      <%
        const ow = pepe.owner || {}, adm = pepe.admin || {};
        const lab = (k) => t('owner.set_' + k), why = (k) => t('owner.set_' + k + '_why');
        const choiceLabel = (k, v) => (k === 'chatty' ? t('owner.chatty_' + v) : t.has('owner.' + (k === 'vibe' ? 'vt_' : 'rm_') + v) ? t('owner.' + (k === 'vibe' ? 'vt_' : 'rm_') + v) : t.esc(v));
        const notes = {
          soundboard: adm.soundboard_master === false ? t('owner.sb_master_off') : '',
          michog: adm.automod ? '' : t('owner.michog_admin_off'),
          strikes: t('owner.strikes_bounds', { min: adm.strike_min || 2, max: adm.strike_max || 5 }),
        };
      %>
      <% GROUPS.forEach(([g, gic, keys]) => { %>
      <h3 class="ds-h4 po-gh"><%= gic %> <%- t('owner.grp_' + g) %></h3>
      <p class="ds-meta"><%- t('owner.grp_' + g + '_why') %></p>
      <div class="po-sets">
        <% keys.forEach((k) => { const v = ow[k], known = v !== undefined && v !== null; %>
        <div class="po-set<%= k === 'greeter_note' ? ' po-set-note' : '' %>" data-po-row="<%= k %>">
          <div>
            <b><%= ICONS[k] || '' %> <%- lab(k) %></b>
            <p class="ds-meta"><%- why(k) %><% if (notes[k]) { %> <span class="po-admin"><%- notes[k] %></span><% } %></p>
            <% if (!known && k !== 'greeter_note') { %><p class="ds-fine"><%- t('owner.unreported') %></p><% } %>
            <span class="po-st" data-po-st="<%= k %>" role="status" aria-live="polite"></span>
          </div>
          <% if (k === 'language') { %>
          <select class="ds-select po-ctl" data-po-set="language" aria-label="<%- lab(k) %>">
            <% LANGS.forEach(([c, n, nat]) => { %><option value="<%= c %>" <%= ow.language === c ? 'selected' : '' %>><%= c === 'auto' ? t('owner.lang_auto') : n + (nat && nat !== n ? ' · ' + nat : '') %></option><% }) %>
          </select>
          <% } else if (k === 'chatty' || k === 'vibe' || k === 'roasts') { %>
          <select class="ds-select po-ctl" data-po-set="<%= k %>" aria-label="<%- lab(k) %>" <%= known ? '' : 'disabled' %>>
            <% (CHOICES[k] || []).forEach((c) => { %><option value="<%= c %>" <%= v === c ? 'selected' : '' %>><%- c === 'auto' ? t('owner.' + (k === 'vibe' ? 'vt_auto' : 'rm_auto')) : choiceLabel(k, c) %></option><% }) %>
          </select>
          <% } else if (k === 'strikes') { %>
          <select class="ds-select po-ctl" data-po-set="strikes" aria-label="<%- lab(k) %>" <%= known ? '' : 'disabled' %>>
            <option value="default"><%- t('owner.strikes_default', { n: adm.strike_default || 3 }) %></option>
            <% for (let n = (adm.strike_min || 2); n <= (adm.strike_max || 5); n++) { %><option value="<%= n %>" <%= v === n ? 'selected' : '' %>><%- t('owner.strikes_n', { n }) %></option><% } %>
          </select>
          <% } else if (k === 'greeter_note') { %>
          <form class="po-note" data-po-note novalidate>
            <input class="ds-in" type="text" maxlength="160" data-po-set="greeter_note" value="<%= v || '' %>" placeholder="<%- t('owner.note_ph') %>" aria-label="<%- lab(k) %>" autocomplete="off">
            <button type="submit" class="ds-btn sm ghost"><%- t('owner.note_save') %></button>
          </form>
          <% } else { %>
          <label class="ds-switch" title="<%- lab(k) %>"><input type="checkbox" data-po-set="<%= k %>" <%= v === true ? 'checked' : '' %> <%= known ? '' : 'disabled' %> aria-label="<%- lab(k) %>"><span></span></label>
          <% } %>
        </div><% }) %>
      </div>
      <% }) %>

      <h3 class="ds-h4 po-gh">🌉 <%- t('owner.bridge_h') %></h3>
      <p class="ds-meta"><%- t('owner.bridge_why') %></p>
      <% if (pepe.bridged === false) { %><div class="ds-note info"><span class="ds-ic" aria-hidden="true">🔌</span><div><%- t('owner.not_bridged') %></div></div><% } %>
      <div class="po-sets" id="poBridge">
        <% [['relay', '💬'], ['mic', '🎙️'], ['cams', '📷'], ['audio', '🔊'], ['transcripts', '📝']].forEach(([k, ic]) => { const v = (pepe.bridge || {})[k]; %>
        <div class="po-set" data-po-row="br:<%= k %>">
          <div><b><%= ic %> <%- t('owner.br_' + k) %></b><p class="ds-meta"><%- t('owner.br_' + k + '_why') %></p>
            <span class="po-st" data-po-st="br:<%= k %>" role="status" aria-live="polite"></span></div>
          <label class="ds-switch"><input type="checkbox" data-po-bridge="<%= k %>" <%= v === true ? 'checked' : '' %> aria-label="<%- t('owner.br_' + k) %>"><span></span></label>
        </div><% }) %>
      </div>

      <% if (readonly) { %>
      <details class="po-disc" id="poMore">
        <summary class="ds-btn ghost po-disc-s"><span><span class="ds-ic" aria-hidden="true">🔧</span> <%- t('owner.ro_more', { n: readonly.count }) %></span><span class="po-chev" aria-hidden="true"></span></summary>
        <div class="po-disc-b">
          <p class="ds-meta"><b><%- t('owner.ro_h') %></b> · <%- t('owner.ro_why') %></p>
          <ul class="po-ro">
            <% readonly.features.forEach(([k, v]) => { %><li><span><%- t.has('owner.f_' + k) ? t('owner.f_' + k) : t.esc(k) %></span><span class="ds-chip <%= v ? 'ok' : 'mute' %>"><%- v ? t('owner.on') : t('owner.off') %></span></li><% }) %>
          </ul>
          <h4 class="ds-h4"><%- t('owner.prices_h') %></h4>
          <ul class="po-ro">
            <% readonly.prices.forEach(([k, v]) => { %><li><span><%- t.has('owner.p_' + k) ? t('owner.p_' + k) : t.esc(k) %></span><%- PAT(v, 'plain') %></li><% }) %>
          </ul>
          <% if (pepe.vibe && pepe.vibe.type) { %><p class="ds-meta"><%- t('owner.vibe', { vibe: t.has('owner.vt_' + pepe.vibe.type) ? t('owner.vt_' + pepe.vibe.type) : t.esc(pepe.vibe.type) }) %></p><% } %>
        </div>
      </details>
      <% } %>
    <% } %>
  </section>
  <% } %>

  <div class="ds-stats" aria-label="<%- t('owner.summary') %>">
    <% if (vault) { %><div class="ds-stat"><span><%- t('owner.s_vault') %></span><b class="gold"><%= num(vault.balance) %></b><small>PAT</small></div><% } %>
    <div class="ds-stat"><span><%- t('owner.s_pending') %></span><b class="gold"><%= share && room.owner_kind === 'user' ? num(share.d7) : '—' %></b><small><%- room.owner_kind === 'user' ? t('owner.v_7d') : t('owner.no_roy_short') %></small></div>
    <div class="ds-stat"><span><%- t('owner.s_payout') %></span><b><%- vault && vault.recipe && vault.recipe.live ? t('owner.share_live') : '—' %></b><small><%- t('owner.s_weekly') %></small></div>
    <div class="ds-stat"><span><%- t('owner.s_prime') %></span><b><%- prime && prime.active ? t('owner.prime_on') : t('owner.prime_off') %></b><small><%- prime && prime.active && prime.ends ? t('owner.until', { when: dd(prime.ends) }) : (prime && prime.comped ? t('owner.comped') : '&nbsp;') %></small></div>
  </div>

  <% if (camfrog) { %>
  <section class="ds-card lg" id="vault" aria-labelledby="poVaultH">
    <h2 class="ds-h2" id="poVaultH"><span class="dot"></span>💰 <%- t('owner.vault_h') %>
      <% if (vault) { %><span class="ds-chip <%= vault.live ? 'ok' : 'warn' %>"><%- vault.live ? t('owner.vault_live') : t('owner.vault_paused') %></span><% } %></h2>
    <p class="po-why"><%- t('owner.vault_why', { cap: num(vault ? vault.cap : 50000000) }) %></p>
    <% if (vault) { %>
    <div class="ds-stats">
      <div class="ds-stat"><span><%- t('owner.v_balance') %></span><b class="gold" data-po="balance"><%= num(vault.balance) %></b><small><%- t('owner.v_of_cap', { cap: num(vault.cap) }) %></small></div>
      <div class="ds-stat"><span><%- t('owner.v_inflow') %></span><b class="up">+<%= num(vault.inflow7) %></b><small><%- t('owner.v_7d') %></small></div>
      <div class="ds-stat"><span><%- t('owner.v_deposits') %></span><b><%= num(vault.deposits7) %></b><small><%- t('owner.v_7d') %></small></div>
      <div class="ds-stat"><span><%- t('owner.v_paid') %></span><b><%= num(vault.paid7) %></b><small><%- t('owner.v_7d') %></small></div>
    </div>
    <div class="ds-bar gold" role="img" aria-label="<%- t('owner.v_fill', { pct: Math.min(100, Math.round(100 * vault.balance / (vault.cap || 1))) }) %>"><span style="width:<%= Math.min(100, (100 * vault.balance / (vault.cap || 1))).toFixed(1) %>%"></span></div>

    <form class="ds-form" id="poTopup" novalidate>
      <h3 class="ds-h3"><%- t('owner.topup_h') %></h3>
      <p class="po-why"><%- t('owner.topup_why', { min: num(vault.deposit_min) }) %></p>
      <% if (!linked) { %>
        <div class="ds-note warn"><span class="ds-ic" aria-hidden="true">🔗</span><div><%- t('owner.topup_link') %></div></div>
      <% } else { %>
      <div class="ds-field">
        <label class="ds-label" for="poAmt"><%- t('owner.topup_amount') %></label>
        <div class="ds-in-group">
          <input class="ds-in" id="poAmt" name="amount" inputmode="numeric" autocomplete="off" placeholder="<%= num(vault.deposit_min * 10) %>"
                 data-min="<%= vault.deposit_min %>" data-room="<%= Math.max(0, vault.cap - vault.balance) %>" data-bal="<%= balance %>" aria-describedby="poAmtHint">
          <span class="ds-in-addon">PAT</span>
        </div>
        <p class="ds-hint" id="poAmtHint"><%- t('owner.topup_hint', { bal: num(balance), login: linked, room: num(Math.max(0, vault.cap - vault.balance)) }) %></p>
        <div class="po-quick">
          <% [10000, 50000, 100000, 500000].filter((q) => q >= vault.deposit_min).forEach((q) => { %><button type="button" class="ds-quick" data-amt="<%= q %>"><%= num(q) %></button><% }) %>
        </div>
      </div>
      <div class="ds-actions"><button type="submit" class="ds-btn gold" <%= vault.live ? '' : 'disabled' %>><span class="ds-ic" aria-hidden="true">🪙</span> <%- t('owner.topup_go') %></button></div>
      <p class="po-msg" id="poTopMsg" role="status" aria-live="polite"><%- vault.live ? '' : t('owner.vault_not_live') %></p>
      <% } %>
    </form>

    <details class="po-more">
      <summary><%- t('owner.v_history') %></summary>
      <% if (!vault.history.length) { %><p class="ds-meta"><%- t('owner.v_none') %></p><% } else { %>
      <ul class="po-hist">
        <% vault.history.forEach((h) => { %><li><span><%- t.has('pad.vault.k_' + h.kind) ? t('pad.vault.k_' + h.kind) : t.esc(h.kind) %><% if (h.flow && h.kind !== 'deposit') { %> · <span class="ds-meta"><%= h.flow %></span><% } %><% if (h.kind === 'deposit' && (h.anon || h.who)) { %> · <span class="ds-meta"><% if (h.anon) { %><%- t('pad.vault.anon') %><% } else { %><%= h.who %><% } %></span><% } %><br><small class="ds-fine"><%= h.ts ? dt(h.ts) : '' %></small></span><%- PAT(h.amount, h.amount < 0 ? 'down' : 'up') %></li><% }) %>
      </ul><% } %>
      <% if (vault.days.length) { %>
      <div class="ds-tbl dense"><table><thead><tr><th><%- t('owner.v_day') %></th><th class="r"><%- t('owner.v_in') %></th><th class="r"><%- t('owner.v_dep') %></th><th class="r"><%- t('owner.v_out') %></th></tr></thead><tbody>
        <% vault.days.slice().reverse().forEach((d) => { %><tr><td><%= d.day %></td><td class="r"><%= num(d.in) %></td><td class="r"><%= num(d.dep) %></td><td class="r"><%= num(d.out) %></td></tr><% }) %>
      </tbody></table></div><% } %>
      <p class="ds-fine"><%- t('owner.v_rate', { rate: vault.rate, href: href + '#vault' }) %></p>
    </details>
    <% } else { %><div class="ds-empty"><b><%- t('owner.v_unavailable') %></b></div><% } %>
  </section>
  <% } %>

  <div class="po-grid two">
  <section class="ds-card lg" id="royalties" aria-labelledby="poRoyH">
    <%
      const rc = vault && vault.recipe ? vault.recipe : null;
      const rcCfg = (rc && rc.cfg) || {};
      const pct = (k, d) => Math.round(100 * (rcCfg[k] != null ? Number(rcCfg[k]) : d));
      const eps = rc ? rc.epochs.slice().reverse() : [];
      const last = eps[0] || null;
      const house = room.owner_kind !== 'user';
    %>
    <h2 class="ds-h2" id="poRoyH"><span class="dot"></span>👑 <%- t('owner.share_h') %>
      <span class="ds-chip <%= rc && rc.live ? 'ok' : 'mute' %>"><%- rc && rc.live ? t('owner.share_live') : t('owner.share_soon') %></span></h2>
    <% if (house) { %>
      <p class="po-why"><%- t('owner.share_house') %></p>
    <% } else { %>
      <p class="po-why"><%- t('owner.share_why', { rate: vault ? vault.rate : 10, pct: pct('owner_pct', 0.15), days: rcCfg.owner_days || 3, active: rcCfg.elig_days || 3, cap: pct('cap_i7', 0.25) }) %></p>
      <div class="ds-stats">
        <div class="ds-stat"><span><%- t('owner.share_7d') %></span><b class="gold"><%= num(share ? share.d7 : 0) %></b><small><%- t('owner.v_7d') %></small></div>
        <div class="ds-stat"><span><%- t('owner.share_30d') %></span><b><%= num(share ? share.d30 : 0) %></b><small>PAT</small></div>
        <div class="ds-stat"><span><%- t('owner.share_present') %></span><b class="<%= last && last.owner_present >= (rcCfg.owner_days || 3) ? 'up' : '' %>"><%= last ? last.owner_present : '—' %> / 7</b><small><%- t('owner.share_need', { n: rcCfg.owner_days || 3 }) %></small></div>
        <div class="ds-stat"><span><%- t('owner.share_active') %></span><b class="<%= last && last.active_days >= (rcCfg.elig_days || 3) ? 'up' : '' %>"><%= last ? last.active_days : '—' %> / 7</b><small><%- t('owner.share_need', { n: rcCfg.elig_days || 3 }) %></small></div>
        <div class="ds-stat"><span><%- t('owner.share_cap') %></span><b><%= last ? num(last.cap) : '—' %></b><small><%- t('owner.share_cap_s', { pct: pct('cap_i7', 0.25), i7: last ? num(last.i7) : '—' }) %></small></div>
      </div>
      <% if (!last) { %><p class="ds-meta"><%- t('owner.share_none_yet') %></p>
      <% } else if (!last.owner && last.why && last.why.owner) { %><div class="ds-note warn"><span class="ds-ic" aria-hidden="true">⏳</span><div><%- t('owner.share_not', { day: last.day, why: t.esc(last.why.owner) }) %></div></div><% } %>
    <% } %>
    <% if (roy) { %>
    <details class="po-more">
      <summary><%- t('owner.roy_old_h') %></summary>
      <% if (roy.frozen) { %><p class="ds-meta"><%- t('owner.roy_frozen', { paid: num(roy.paid) }) %></p>
      <% } else { %>
      <p class="ds-meta"><%- t('owner.roy_until') %></p>
      <p class="po-why"><%- t('owner.roy_why', { stage: roy.config ? roy.config.stage_pct : 20, days: roy.active_days_needed }) %></p>
      <div class="ds-stats">
        <div class="ds-stat"><span><%- t('owner.r_pending') %></span><b class="gold"><%= num(roy.pending) %></b><small>PAT</small></div>
        <div class="ds-stat"><span><%- t('owner.r_period') %></span><b><%= num(roy.this_period.total) %></b><small><%- t('owner.r_period_s') %></small></div>
        <div class="ds-stat"><span><%- t('owner.r_paid') %></span><b><%= num(roy.paid) %></b><small><%- t('owner.r_all_time') %></small></div>
        <div class="ds-stat"><span><%- t('owner.r_days') %></span><b class="<%= roy.active_days >= roy.active_days_needed ? 'up' : '' %>"><%= roy.active_days %> / <%= roy.active_days_needed %></b><small><%- t('owner.r_days_s') %></small></div>
      </div>
      <p class="ds-meta"><%- t('owner.r_next', { when: dt(roy.next_release) }) %></p>
      <% const shares = (roy.owner_shares || []).filter((s) => s.pct > 0); if (shares.length) { %>
      <ul class="po-ro"><% shares.forEach((s) => { %><li><span><%= s.label %></span><b><%= s.pct %>%</b></li><% }) %></ul><% } %>
      <% } %>
    </details>
    <% } %>
  </section>

  <% if (camfrog && vault) { %>
  <section class="ds-card lg" id="recipe" aria-labelledby="poRcH">
    <h2 class="ds-h2" id="poRcH"><span class="dot"></span>💸 <%- t('owner.recipe_h') %></h2>
    <p class="po-why"><%- t('owner.recipe_why', { owner: pct('owner_pct', 0.15), gang: pct('gang_pct', 0.15), streamers: pct('streamer_pct', 0.25), people: pct('people_pct', 0.35), games: pct('games_pct', 0.10), convoy: num(rcCfg.convoy_min || 25000) }) %></p>
    <% if (!eps.length) { %><p class="ds-meta"><%- t('owner.share_none_yet') %></p><% } else { %>
    <div class="ds-tbl dense"><table><thead><tr><th><%- t('owner.rc_day') %></th><th class="r"><%- t('owner.rc_budget') %></th><th class="r"><%- t('owner.rc_owner') %></th><th class="r"><%- t('owner.rc_gang') %></th><th class="r"><%- t('owner.rc_streamers') %></th><th class="r"><%- t('owner.rc_people') %></th><th class="r"><%- t('owner.rc_games') %></th><th class="r"><%- t('owner.rc_paid') %></th><th class="r"><%- t('owner.rc_stayed') %></th></tr></thead><tbody>
      <% eps.forEach((e) => { %><tr><td><%= e.day %><br><small class="ds-fine"><%= e.rate %>% · <%= num(e.balance) %></small></td><td class="r"><%= num(e.B) %></td><td class="r"><%= num(e.owner) %></td><td class="r"><%= num(e.gang) %></td><td class="r"><%= num(e.streamers) %><% if (e.vwm) { %><br><small class="ds-fine"><%= e.vwm %> VWM</small><% } %></td><td class="r"><%= num(e.people) %><% if (e.people_n) { %><br><small class="ds-fine"><%- t('owner.rc_people_count', { count: e.people_n }) %></small><% } %></td><td class="r"><%= num(e.games_allow) %></td><td class="r"><b><%= num(e.paid) %></b><% if (e.topup) { %><br><small class="ds-fine"><%- t('owner.rc_topup', { n: num(e.topup) }) %></small><% } %></td><td class="r"><%= num(e.stays) %></td></tr><% }) %>
    </tbody></table></div>
    <% if (rc && rc.games && rc.games.allow) { %><p class="ds-fine"><%- t('owner.rc_games_left', { left: num(Math.max(0, rc.games.allow - rc.games.used)), allow: num(rc.games.allow) }) %></p><% } %>
    <% } %>
  </section>
  <% } %>

  <section class="ds-card lg" id="prime" aria-labelledby="poPrimeH">
    <h2 class="ds-h2" id="poPrimeH"><span class="dot"></span>📺 <%- t('owner.prime_h') %>
      <% const poOn_ = !!(prime && (prime.active || (prime.plus && prime.plus.active))); %><span class="ds-chip <%= poOn_ ? 'gold' : 'mute' %>"><%- poOn_ ? (prime.plus && prime.plus.active ? '💎 ' : '') + t('owner.prime_on') : t('owner.prime_off') %></span></h2>
    <p class="po-why"><%- t('owner.prime_why2') %></p>
    <%# 1.99tc: the pad's tier perks from the shared perk table (premiumperks.js) - was a hand-written sentence that drifted %>
    <%- include('partials/pad-tier-perks', { padTier: prime && prime.plus && prime.plus.active ? 'prime_plus' : prime && prime.active ? 'prime_time' : null }) %>
    <% if (prime && prime.active) { %>
      <p class="ds-meta"><%- prime.comped ? t('owner.prime_comped') : (prime.renewing ? t('owner.prime_renews', { when: dd(prime.paid_through) }) : t('owner.prime_ends', { when: dd(prime.ends || prime.paid_through) })) %></p>
    <% } else if (primePrice) { %>
      <p class="ds-meta"><%- t('owner.prime_price', { price: PAT(primePrice) }) %></p>
    <% } %>
    <div class="ds-actions"><a class="ds-btn <%= prime && prime.active ? 'ghost' : 'gold' %> sm" href="/premium?pad=<%= encodeURIComponent(slug) %>"><%- prime && prime.active ? t('owner.prime_manage') : t('owner.prime_get') %></a></div>
  </section>
  </div>

  <section class="ds-card lg" id="stage" aria-labelledby="poStageH">
    <h2 class="ds-h2" id="poStageH"><span class="dot"></span>🎬 <%- t('owner.stage_h') %></h2>
    <p class="po-why"><%- t('owner.stage_why') %></p>
    <% if (stage) { %>
    <div class="ds-stats">
      <div class="ds-stat"><span><%- t('owner.st_slots') %></span><b><%= stage.open %> / <%= stage.room.slot_count %></b><small><%- t('owner.st_in_use') %></small></div>
      <div class="ds-stat"><span><%- t('owner.st_featured') %></span><b><%= stage.featured ? stage.featured.display : '—' %></b><small><%- stage.featured ? (stage.featured.live ? t('owner.st_live') : t('owner.st_waiting')) : t('owner.st_none') %></small></div>
      <div class="ds-stat"><span><%- t('owner.st_next') %></span><b><%= stage.upcoming.length %></b><small><%- t('owner.st_booked') %></small></div>
      <div class="ds-stat"><span><%- t('owner.st_requests') %></span><b class="<%= requested ? 'gold' : '' %>"><%= requested %></b><small><%- t('owner.st_to_approve') %></small></div>
    </div>
    <% if (stage.upcoming.length) { %><ul class="po-hist"><% stage.upcoming.slice(0, 3).forEach((u) => { %><li><span><%= u.display %><% if (u.title) { %> · <span class="ds-meta"><%= u.title %></span><% } %></span><span class="ds-meta"><%= u.start_at ? dt(u.start_at) : '' %></span></li><% }) %></ul><% } %>
    <% } %>
    <div class="ds-actions"><a class="ds-btn sm" href="<%= href %>/settings?tab=stage"><%- t('owner.stage_go') %></a></div>
  </section>

<% } %>

  <% if (!guide && locals.camfrog) { %>
  <section class="ds-card lg" id="soundboard" aria-labelledby="poSbH">
    <h2 class="ds-h2" id="poSbH"><span class="dot"></span>🔊 <%- t('owner.sb_h') %></h2>
    <p class="po-why"><%- t('owner.sb_why', { store: '<a href="/soundboards">/soundboards</a>' }) %></p>
    <% if (locals.pepe && pepe.owner && pepe.owner.soundboard !== undefined) { %>
    <div class="po-sets"><div class="po-set" data-po-row="soundboard">
      <div><b>🔊 <%- t('owner.set_soundboard') %></b><p class="ds-meta"><%- t('owner.set_soundboard_why') %><% if (pepe.admin && pepe.admin.soundboard_master === false) { %> <span class="po-admin"><%- t('owner.sb_master_off') %></span><% } %></p>
        <span class="po-st" data-po-st="soundboard" role="status" aria-live="polite"></span></div>
      <label class="ds-switch" title="<%- t('owner.set_soundboard') %>"><input type="checkbox" data-po-set="soundboard" <%= pepe.owner.soundboard === true ? 'checked' : '' %> aria-label="<%- t('owner.set_soundboard') %>"><span></span></label>
    </div></div>
    <% } %>
    <div id="poSb" data-slug="<%= slug %>"><p class="ds-meta"><%- t('owner.sb_loading') %></p></div>
  </section>
  <% } %>

  <section class="ds-card lg" id="can" aria-labelledby="poCanH">
    <h2 class="ds-h2" id="poCanH"><span class="dot"></span>❓ <%- t('owner.can_h') %></h2>
    <p class="po-why"><%- t('owner.can_why') %></p>
    <% AREAS.forEach(([area, ic]) => {
         const pc = capsList.filter((c) => c.area === area), wc = (webCaps || []).filter((c) => c.area === area);
         if (!pc.length && !wc.length) return; %>
      <h3 class="ds-h3"><%= ic %> <%- t('owner.area_' + area) %></h3>
      <% pc.forEach((c) => { %>
      <div class="po-cap" id="cap-<%= c.id %>">
        <b><%- capT(c, 'title') %></b>
        <% if ((c.syntax || []).length) { %><div class="po-cmds"><% c.syntax.forEach((s) => { %><code><%= s %></code><% }) %></div><% } %>
        <p class="po-why"><%- capT(c, 'howto') %></p>
        <% if (c.web && slug) { %><a class="ds-meta" href="<%= sub(c.web) %>"><%- t('owner.on_web') %> →</a><% } %>
      </div><% }) %>
      <% wc.forEach((c) => { %>
      <div class="po-cap" id="cap-<%= c.id %>">
        <b>🌐 <%- t('owner.cap.' + c.id + '.title') %></b>
        <p class="po-why"><%- t('owner.cap.' + c.id + '.howto') %></p>
        <% if (slug) { %><a class="ds-meta" href="<%= sub(c.where) %>"><%- t('owner.open') %> →</a><% } %>
      </div><% }) %>
    <% }) %>
    <h3 class="ds-h3">🔧 <%- t('owner.admin_only_h') %></h3>
    <p class="po-why"><%- t('owner.admin_only_why') %></p>
    <ul class="po-ro"><% ((caps && caps.admin_only) || []).forEach((a, i) => { %><li><span><%- t.has('owner.ao.' + i) ? t('owner.ao.' + i) : t.esc(a) %></span></li><% }) %></ul>
    <p class="ds-fine"><%- t('owner.generated') %></p>
  </section>
</main>
<% if (!guide) { %><script src="/public/js/pad-owner.js?v=2" defer></script><% } %>
<% if (!guide && locals.camfrog) { %><script src="/public/js/pad-sb-owner.js?v=1" defer></script><% } %>
</body>
</html>
