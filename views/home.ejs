<!-- views/home.ejs — the functional homepage (home.js). Explainers live on /about. -->
<%- include('layout', { title: 'Public Access Television', user: username }) %>
<%
  const fmt = (n) => Math.round(Number(n) || 0).toLocaleString('en-US');
  const short = (n) => { n = Number(n) || 0; const a = Math.abs(n);
    return a >= 1e9 ? (n / 1e9).toFixed(a >= 1e10 ? 0 : 1) + 'B' : a >= 1e6 ? (n / 1e6).toFixed(a >= 1e7 ? 0 : 1) + 'M' : a >= 1e4 ? Math.round(n / 1e3) + 'K' : fmt(n); };
  const ago = (ms) => { const s = Math.max(0, Math.round((Date.now() - ms) / 1000)); return s < 90 ? 'just now' : s < 5400 ? Math.round(s / 60) + 'm ago' : s < 172800 ? Math.round(s / 3600) + 'h ago' : Math.round(s / 86400) + 'd ago'; };
  const pic = (a) => (typeof a === 'string' && /^(https?:\/\/|\/)/.test(a) ? a : '/public/img/avatar.png');
  const S0 = S || {};
  const st = stage || { active: false };
  const paid = Array.isArray(slots) ? slots : [];
  const live = !!st.active || paid.length > 0;
  const liveRooms = (rooms || []).filter((r) => r.live);
  const feat = S0.featured;
  const need = me ? xpForNextLevel(me.level) : 1;
  const pct = me ? Math.max(0, Math.min(100, need ? (me.xp / need) * 100 : 0)) : 0;
  const nameCss = me ? cosmeticName(me.username) : '';
  const M = mine || {};
  const wheelHref = me ? '/u/' + encodeURIComponent(me.username) + '/wheel' : '/login';
  // things to do: compact, action-first; `hot` = something live there now, `fresh` = you haven't tried it
  const todo = [
    { href: '/rooms' + (room ? '/' + encodeURIComponent(room.slug) : ''), ic: '📡', t: 'Live rooms', s: room ? room.count + ' in ' + room.name : null, hot: !!(room && room.live) },
    { href: '/markets', ic: '🔮', t: 'Markets', s: S0.markets ? S0.markets + ' open' : null, hot: S0.markets > 0, fresh: me && me.camfrogUsername && !M.bets },
    { href: '/lotto', ic: '🎟️', t: 'Lotto', s: S0.lotto ? short(S0.lotto.jackpot) + ' jackpot' : null, hot: !!(S0.lotto && S0.lotto.open), fresh: me && me.camfrogUsername && !M.tickets },
    { href: wheelHref, ic: '🎡', t: 'Wheel', s: S0.casinoPot ? short(S0.casinoPot) + ' pot' : null },
    { href: '/tables', ic: '🃏', t: 'Casino tables', s: (S0.tables || []).length ? S0.tables.map((t) => t.game).join(' + ') + ' open' : null, hot: (S0.tables || []).length > 0 },
    { href: '/gtf', ic: '🔫', t: 'Grand Theft Frogger', s: null },
    { href: '/bounties', ic: '🎯', t: 'Bounties', s: S0.bounties ? S0.bounties + ' open' : null, hot: S0.bounties > 0 },
    { href: '/wagers', ic: '🤝', t: 'Wagers', s: S0.wagers ? S0.wagers + ' live' : null },
    { href: '/staking', ic: '🏦', t: 'Staking', s: S0.vaults ? short(S0.vaults.house) + ' House' : null },
    { href: '/cosmetics', ic: '🎨', t: 'Cosmetics', s: null },
    { href: '/feed', ic: '🎞️', t: 'Clips & snaps', s: null },
    { href: '/rankings', ic: '🏆', t: 'Rankings', s: null },
  ];
%>
<link href="https://vjs.zencdn.net/8.3.0/video-js.css" rel="stylesheet" />
<script src="https://vjs.zencdn.net/8.3.0/video.min.js" defer></script>
<script src="https://player.twitch.tv/js/embed/v1.js" defer></script>
<script src="/public/js/stage-player.js?v=2"></script>
<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/public/css/arcade-wheel.css?v=aw2">
<%- include('partials/cosmetics-css') %>
<style>
  .hm { --card: #111; --line: #222; --muted: #8a8a8a; --green: #4caf50; --lime: #c6e94f; --gold: #ffd700;
        max-width: 1400px; margin: 0 auto; padding: 14px 16px 56px; font-family: Ubuntu, sans-serif; color: #e6e6e6;
        display: grid; gap: 14px; box-sizing: border-box; width: 100%; }
  .hm *, .hm *::before, .hm *::after { box-sizing: border-box; }
  .hm a { color: #81c784; text-decoration: none; }
  .hm a:hover { color: #a5d6a7; }
  .hm .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; min-width: 0; }
  .hm h2 { margin: 0 0 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); font-family: 'Press Start 2P', monospace; font-size: 10px; line-height: 1.6;
           display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .hm h2 a, .hm h2 small { font-family: Ubuntu, sans-serif; letter-spacing: 0; text-transform: none; font-size: 12.5px; color: #81c784; }
  .hm .muted { color: var(--muted); font-size: 13px; }
  .hm .btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 8px 14px; border-radius: 9px; border: 1px solid #2b2b2b; background: #181818; color: #ddd !important; font-size: 14px; font-weight: bold; cursor: pointer; font-family: inherit; }
  .hm .btn:hover, .hm .btn:focus-visible { border-color: var(--green); }
  .hm .btn.primary { background: var(--green); border-color: var(--green); color: #fff !important; }
  .hm .btn[disabled] { opacity: .5; cursor: not-allowed; }
  .hm .pill { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; padding: 2px 9px; border-radius: 999px; font-weight: bold; letter-spacing: .06em; white-space: nowrap; }
  .hm .pill.on { background: #3a1010; border: 1px solid #7a2222; color: #ffb4b4; }
  .hm .pill.off { background: #1c1c1c; border: 1px solid #333; color: #999; }
  .hm .dot { width: 7px; height: 7px; border-radius: 50%; background: #ff5252; animation: hmPulse 1.6s ease-in-out infinite; }
  .hm .pill.off .dot { background: #666; animation: none; }
  @keyframes hmPulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

  /* ── main stage ── */
  .hm .stage { border: 1px solid var(--line); border-radius: 16px; background: radial-gradient(120% 140% at 0% 0%, #17301a 0%, #0d0d0f 55%); overflow: hidden; }
  .hm .stage .bar { display: flex; align-items: center; gap: 10px 14px; flex-wrap: wrap; padding: 10px 14px; }
  .hm .stage .bar .ttl { font-family: 'Press Start 2P', monospace; font-size: 10px; letter-spacing: .1em; color: var(--lime); }
  .hm .stage .bar .sub { color: #aab3aa; font-size: 13px; }
  .hm .stage .bar .sp { flex: 1; }
  .hm .stage .bar .sub a { color: #c6e94f !important; }
  .hm .stage-admin { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; padding: 0 14px 10px; font-size: 13px; color: #aab3aa; }
  .hm .stage-admin select { background: #0d0d0d; color: #eee; border: 1px solid #333; border-radius: 8px; padding: 6px 8px; font: inherit; font-size: 13px; min-width: 0; max-width: 100%; }
  .hm .stage-admin .btn { padding: 6px 12px; font-size: 13px; }
  .hm .stage-admin .tag { font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: #ffb74d; border: 1px solid #6b5a20; border-radius: 999px; padding: 1px 7px; }
  .hm .stage-body { display: none; grid-template-columns: minmax(0, 1fr) 300px; gap: 12px; padding: 0 12px 12px; }
  .hm .stage.live .stage-body { display: grid; }
  .hm .stage.live .stage-off { display: none; }
  .hm .player { position: relative; width: 100%; max-width: calc((100vh - 190px) * 16 / 9); margin: 0 auto; aspect-ratio: 16 / 9; background: #000; border-radius: 12px; overflow: hidden; border: 1px solid #262626; }
  .hm .player #videoWrapper { position: absolute; inset: 0; display: block; height: auto; }
  .hm .player .video-js { width: 100%; height: 100%; }
  .hm .player #videoOverlay { position: absolute; inset: 0; display: grid; place-items: center; grid-template-rows: none; grid-template-columns: none; cursor: pointer; z-index: 3; background: rgba(0,0,0,.45); }
  .hm .player #videoOverlay img { grid-column: auto; grid-row: auto; width: 56px; height: auto; opacity: .9; }
  .hm .player #twitch { position: absolute; inset: 0; padding: 0; height: auto; }
  .hm .player #twitch iframe { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hm .hide { display: none !important; }
  .hm .stage-side { display: grid; gap: 10px; align-content: start; min-width: 0; }
  .hm .player .reconnect { position: absolute; inset: 0; display: grid; place-items: center; grid-auto-flow: column; gap: 8px; place-content: center;
                           background: rgba(0,0,0,.72); color: #ddd; font-size: 15px; z-index: 4; }
  .hm .player .unmute { position: absolute; inset: 0; z-index: 3; background: rgba(0,0,0,.35); border: 0; cursor: pointer; display: grid; place-items: center; }
  .hm .player .unmute img { width: 56px; height: auto; opacity: .9; }
  .hm .rooms-mini { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .hm .rooms-mini a { display: flex; justify-content: space-between; gap: 8px; color: #ddd !important; font-size: 13.5px; padding: 3px 0; }
  .hm .rooms-mini .n { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .aw-hm .aw-now { width: 100%; font-family: var(--aw-pixel); font-size: 9px; letter-spacing: 1px; color: var(--aw-dim); text-align: center; min-height: 14px; line-height: 1.6; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .aw-hm .aw-now .who { font-family: Ubuntu, sans-serif; font-size: 15px; letter-spacing: 0; font-weight: bold; color: #fff; }
  .hm .aw-hm .aw-now .amt { color: var(--aw-gold); }
  .hm .box { background: rgba(0,0,0,.4); border: 1px solid #1f2a20; border-radius: 12px; padding: 10px 12px; min-width: 0; }
  .hm .box h3 { margin: 0 0 6px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .hm a.box { display: block; color: #ddd !important; }
  .hm a.box:hover { border-color: #2f5a34; }
  .hm .wheel .row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .hm .wheel .res { font-size: 13px; color: #c9d3c9; min-height: 18px; margin-top: 6px; }
  .hm .wheel .res b { color: var(--gold); }
  /* the stage wheel: the Wheel page's coin-op (arcade-wheel.css), compact */
  .hm .aw.aw-hm { display: block; max-width: none; width: 100%; margin: 0; padding: 0; font-size: 18px; }
  .hm .aw.aw-hm::before { display: none; }
  .hm .aw-hm .aw-coinop { display: flex; flex-direction: column; max-width: none; margin: 0; gap: 10px; padding: 12px; }
  .hm .aw-hm .aw-credit { font-size: 24px; padding: 4px 10px; }
  .hm .aw-hm-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center; width: 100%; }
  .hm .aw-hm .aw-door { padding: 10px 8px 8px; }
  .hm .aw-hm .aw-plate { padding: 6px 4px; }
  .hm .aw-hm .aw-plate .p { font-size: 15px; }
  .hm .aw-hm .aw-plate .ins { font-size: 8px; }
  .hm .aw-hm .aw-slot-area { height: 48px; }
  .hm .aw-hm .aw-slot { width: 86px; }
  .hm .aw-hm .aw-coinbtn { color: var(--aw-text) !important; }
  .hm .aw-hm .aw-coinbtn .aw-coin { --s: 72px; }
  .hm .aw-hm .aw-status { min-height: 2.4em; font-size: 18px; }
  .hm .aw-hm a.aw-tool { text-align: center; color: var(--aw-text) !important; }
  .hm .stage-off { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 10px; padding: 0 12px 12px; }
  .hm .stage-off > * { flex: 1 1 240px; min-width: 0; }
  .hm .stage-off > .aw-hm { flex: 0 1 340px; }

  /* ── you ── */
  .hm .me { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 10px 16px; align-items: center; background: linear-gradient(90deg, #121a13, #111 60%); }
  .hm .me .pic { display: flex; gap: 8px; align-items: center; }
  .hm .me .ava { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; border: 3px solid var(--green); background: #0d0d0d; display: block; }
  .hm .me .gtf { width: 52px; height: 52px; border-radius: 10px; overflow: hidden; background: repeating-conic-gradient(#151515 0% 25%, #101010 0% 50%) 50% / 14px 14px; display: grid; place-items: center; }
  .hm .me .gtf svg { width: 48px; height: 48px; image-rendering: pixelated; shape-rendering: crispEdges; }
  .hm .me .who { min-width: 0; display: grid; gap: 5px; }
  .hm .me .top { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline; font-size: 13.5px; color: #bbb; }
  .hm .me .top .nm { font-size: 17px; font-weight: bold; color: #fff; overflow-wrap: anywhere; }
  .hm .me .top b { color: #fff; font-variant-numeric: tabular-nums; }
  .hm .lvl { height: 8px; background: #1c1c1c; border-radius: 999px; overflow: hidden; max-width: 380px; }
  .hm .lvl span { display: block; height: 100%; background: linear-gradient(90deg, #4caf50, #c6e94f); border-radius: 999px; }
  .hm .chips { display: flex; flex-wrap: wrap; gap: 5px; }
  .hm .chip { font-size: 12px; padding: 3px 9px; border-radius: 999px; border: 1px solid #2c3a2d; background: #0f1a10; color: #b9d8bb !important; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .chip.warm { border-color: #6b5a20; background: #1d1a0f; color: #e8d9a0 !important; }
  .hm .chip.mic { border-color: #2f6d3a; background: #12301a; color: #c9f2cf !important; }
  .hm .me .acts { display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; }
  .hm .me .acts .btn { padding: 7px 11px; font-size: 13px; }

  /* ── room + live now ── */
  .hm .main { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 14px; align-items: start; }
  .hm .lr { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 12px; }
  .hm .lr-feed { display: flex; flex-direction: column; gap: 2px; height: 380px; overflow-y: auto; overscroll-behavior: contain; padding-right: 4px; }
  .hm .ln { font-size: 14px; line-height: 1.45; overflow-wrap: anywhere; padding: 3px 6px; border-radius: 6px; }
  .hm .ln:hover { background: #161616; }
  .hm .ln .w { font-weight: bold; margin-right: 6px; }
  .hm .ln .t { color: #666; font-size: 11px; margin-left: 4px; }
  .hm .ln.sys { color: #8a8a8a; font-size: 12.5px; }
  .hm .ln.pepe { background: #0f1a10; }
  .hm .ln.tx { border-left: 3px solid #4f7fa8; background: #0f141b; font-style: italic; color: #c8d6e5; }
  .hm .ln.tx .w { font-style: normal; }
  .hm .ln.tx .w::before { content: "🎙 "; }
  .hm .lr-side { display: grid; gap: 8px; align-content: start; min-width: 0; }
  .hm .ro { font-size: 12px; color: #9fb3c8; margin-top: 6px; }
  .hm .listen { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .hm .listen .btn { padding: 6px 10px; font-size: 12.5px; }
  .hm .tease { display: grid; gap: 10px; justify-items: start; }
  .hm .now { display: grid; gap: 8px; }
  .hm .now a.it { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; gap: 8px; align-items: center; background: #0d0d0d; border: 1px solid #1c1c1c; border-radius: 10px; padding: 7px 10px; color: #ddd !important; font-size: 13.5px; }
  .hm .now a.it:hover { border-color: #2f5a34; }
  .hm .now .q { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .now .v { color: var(--gold); font-size: 12.5px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .hm .top5 { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .hm .top5 li { display: grid; grid-template-columns: 18px 26px minmax(0, 1fr) auto; gap: 8px; align-items: center; font-size: 13.5px; }
  .hm .top5 .rk { color: var(--muted); text-align: center; font-variant-numeric: tabular-nums; }
  .hm .top5 img { width: 26px; height: 26px; border-radius: 50%; object-fit: cover; background: #1c1c1c; display: block; }
  .hm .top5 .n { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #e6e6e6; }
  .hm .top5 .p { color: var(--gold); font-size: 12.5px; white-space: nowrap; }

  /* ── things to do ── */
  .hm .todo { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 8px; }
  .hm .todo a { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 0 8px; align-items: center; background: #111; border: 1px solid #222; border-radius: 10px; padding: 8px 10px; color: #e6e6e6 !important; font-size: 14px; position: relative; }
  .hm .todo a:hover, .hm .todo a:focus-visible { border-color: #2f5a34; }
  .hm .todo .i { font-size: 18px; grid-row: span 2; text-align: center; }
  .hm .todo b { font-size: 13.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .todo small { color: var(--muted); font-size: 11.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .todo a.hot { border-color: #3a5a2a; }
  .hm .todo a.hot small { color: #9ccc65; }
  .hm .todo .tag { position: absolute; top: -7px; right: 8px; font-size: 10px; padding: 1px 7px; border-radius: 999px; background: #6b5a20; color: #fff3c4; font-weight: bold; }
  .hm .tf { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; align-items: end; }
  .hm .tf a { display: grid; justify-items: center; gap: 4px; text-align: center; background: #111; border: 1px solid #222; border-radius: 14px; padding: 12px 8px; color: #e6e6e6 !important; position: relative; }
  .hm .tf a:hover, .hm .tf a:focus-visible { border-color: #2f5a34; }
  .hm .tf .r1 a { border-color: #6b5a20; background: linear-gradient(180deg, #2a2410, #111 70%); padding-top: 20px; }
  .hm .tf .r2 a { border-color: #4a4f55; padding-top: 16px; }
  .hm .tf .r3 a { border-color: #5a4330; padding-top: 14px; }
  .hm .tf .rk { position: absolute; top: 6px; left: 8px; font-family: 'Press Start 2P', monospace; font-size: 11px; color: var(--muted); }
  .hm .tf .r1 .rk { color: #ffd700; } .hm .tf .r2 .rk { color: #cfd8dc; } .hm .tf .r3 .rk { color: #d7a46b; }
  .hm .tf .av { width: 88px; height: 88px; border-radius: 12px; overflow: hidden; display: grid; place-items: center; background: repeating-conic-gradient(#151515 0% 25%, #101010 0% 50%) 50% / 16px 16px; }
  .hm .tf .r1 .av { width: 104px; height: 104px; }
  .hm .tf .av svg { width: 100%; height: 100%; image-rendering: pixelated; shape-rendering: crispEdges; }
  .hm .tf .av img { width: 70%; height: 70%; border-radius: 50%; object-fit: cover; }
  .hm .tf .nm { font-weight: bold; font-size: 14px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .tf .pt { color: var(--gold); font-size: 13px; font-variant-numeric: tabular-nums; }
  .hm .tf .lv { color: var(--muted); font-size: 12px; }
  .hm .pitch { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px 16px; align-items: center; }
  .hm .pitch p { margin: 0; color: #c9d3c9; font-size: 14.5px; line-height: 1.5; }
  .hm .foot { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 13.5px; color: var(--muted); justify-content: center; padding-top: 4px; }
  .hm code { background: #1c1c1c; padding: 1px 5px; border-radius: 4px; }

  @media (max-width: 1100px) {
    .hm .stage-body { grid-template-columns: minmax(0, 1fr); }
    .hm .stage-side { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    .hm .main { grid-template-columns: minmax(0, 1fr); }
    .hm .tf { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .hm .lr { grid-template-columns: minmax(0, 1fr); }
    .hm .me { grid-template-columns: auto minmax(0, 1fr); }
    .hm .me .acts { grid-column: 1 / -1; justify-content: flex-start; }
    .hm .player { max-width: none; }
  }
  @media (max-width: 520px) {
    .hm { padding: 10px 10px 44px; gap: 12px; }
    .hm .me .gtf { display: none; }
    .hm .lr-feed { height: 300px; }
    .hm .todo { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hm .tf { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hm .tf .r1 { grid-column: 1 / -1; }
    .hm .pitch { grid-template-columns: minmax(0, 1fr); }
    .hm .stage-body, .hm .stage-off { padding: 0 8px 8px; }
  }
  /* paid stage slots (1.99al): which stream the stage shows */
  .hm .stabs { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 14px 10px; align-items: center; }
  .hm .stabs:empty { display: none; }
  .hm .stab { display: inline-flex; align-items: center; gap: 6px; max-width: 100%; padding: 5px 11px; border-radius: 999px; border: 1px solid #2b2b2b;
              background: #141414; color: #cfd8cf; font: inherit; font-size: 13px; cursor: pointer; min-width: 0; }
  .hm .stab span.n { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: bold; }
  .hm .stab[aria-selected="true"] { border-color: var(--lime); background: #1b2a12; color: #fff; }
  .hm .stab:focus-visible { outline: 2px solid var(--lime); outline-offset: 2px; }
  .hm .stab .dot { flex: none; }
  .hm .stab.off .dot { background: #666; animation: none; }
  .hm .stabs .adm { display: inline-flex; gap: 6px; margin-left: auto; }
  .hm .stabs .adm button { padding: 5px 10px; border-radius: 8px; border: 1px solid #5a2222; background: #2a1010; color: #ffb4b4; font: inherit; font-size: 12.5px; font-weight: bold; cursor: pointer; }
  .hm .stabs .adm button:hover { border-color: #ff5252; }
  @media (max-width: 520px) { .hm .stabs { padding: 0 10px 8px; } .hm .stabs .adm { margin-left: 0; } }
  @media (prefers-reduced-motion: reduce) { .hm .dot { animation: none; } }
</style>

<main class="hm">
  <!-- ───── main stage ───── -->
  <section class="stage <%= live ? 'live' : 'off' %>" id="stage" aria-labelledby="stTtl">
    <div class="bar">
      <span class="ttl" id="stTtl">📺 MAIN STAGE</span>
      <span class="pill <%= live ? 'on' : 'off' %>" id="stPill"><span class="dot" aria-hidden="true"></span><span id="stPillTxt"><%= live ? 'ON AIR' : 'OFF AIR' %></span></span>
      <span class="sub" id="stSub"><%= live ? (st.since ? 'on air for ' + ago(st.since).replace(' ago', '') : 'live now') : (st.ended ? 'last on air ' + ago(st.ended) : 'nothing streaming right now') %></span>
      <span class="sub" id="stRoom"<% if (!st.room) { %> hidden<% } %>>📡 <% if (st.room && st.room.slug) { %><a href="/rooms/<%= encodeURIComponent(st.room.slug) %>"><%= st.room.name %></a><% } else if (st.room) { %><%= st.room.name %><% } %></span>
      <span class="sp"></span>
      <a class="sub" href="/stage/book">Book the stage ›</a>
      <a class="sub" href="https://twitch.tv/publicaccess_ttv" rel="noopener">Twitch ›</a>
    </div>
    <% if (stageAdmin) { %>
    <form class="stage-admin" id="stAdmin" autocomplete="off">
      <span class="tag">Admin</span>
      <label for="stRoomSel">Stage room</label>
      <select id="stRoomSel">
        <option value="auto"<%= stageAdmin.pinned ? '' : ' selected' %>>Follow the open Camfrog tab (auto)</option>
        <% (stageAdmin.rooms || []).forEach((r) => { %><option value="<%= r.id %>"<%= stageAdmin.pinned && stageAdmin.room === r.id ? ' selected' : '' %>><%= r.name %><%= r.name !== r.id ? ' (' + r.id + ')' : '' %></option><% }) %>
      </select>
      <button type="submit" class="btn"<%= (stageAdmin.rooms || []).length ? '' : ' disabled' %>>Put on stage</button>
      <span id="stAdminMsg" aria-live="polite"><%= (stageAdmin.rooms || []).length ? '' : 'Pepe hasn\'t reported his rooms yet.' %></span>
    </form>
    <% } %>
    <div class="stabs" id="stTabs" role="tablist" aria-label="Stage streams"></div>
    <div class="stage-body">
      <div class="player" id="player">
        <div id="videoWrapper"></div>
        <div class="reconnect hide" id="stReconnect" role="status"><span class="dot" aria-hidden="true"></span> Stream is starting / reconnecting…</div>
        <button type="button" class="unmute hide" id="stUnmute" aria-label="Unmute the stream"><img src="/public/img/mute-icon.png" alt=""></button>
        <div id="twitch" class="hide"></div>
      </div>
      <div class="stage-side" id="stageSide"></div>
    </div>
    <div class="stage-off" id="stageOff"></div>
    <!-- the stage widgets render once and move between the live side panel and the off-air strip -->
    <div class="hide" id="stageWidgets">
      <div class="aw aw-hm" id="wheelBox">
        <% if (me) { %>
        <div class="aw-coinop" id="coinop">
          <div class="aw-credit" aria-hidden="true"><span>CREDIT</span><span class="n" id="creditCount">00</span></div>
          <div class="aw-hm-row">
            <div class="aw-door">
              <div class="aw-plate"><span class="p">5000</span><span class="u">PAT</span><span class="ins">STAGE WHEEL</span></div>
              <div class="aw-slot-area">
                <div class="aw-dropclip" id="dropClip"><div class="aw-coin aw-flycoin" id="clipCoin" aria-hidden="true">PAT</div></div>
                <div class="aw-slot" id="coinSlot" aria-hidden="true"></div>
              </div>
            </div>
            <button type="button" class="aw-coinbtn" id="spinButton" aria-describedby="spinStatus">
              <span class="aw-coin" aria-hidden="true">PAT</span>
              <span class="cap">INSERT COIN</span>
            </button>
          </div>
          <div class="aw-now" id="stSpin" aria-live="polite"></div>
          <div class="aw-status" id="spinStatus" role="status" aria-live="polite">Spin the wheel on stream · you have <span id="balTxt"><%= fmt(me.points_balance) %></span> PAT</div>
          <div class="aw-tools"><button type="button" class="aw-tool" id="muteBtn" aria-pressed="false">SOUND ON</button><a class="aw-tool" href="<%= wheelHref %>">MY WHEEL</a></div>
          <div class="aw-coin aw-flycoin" id="flyCoin" aria-hidden="true">PAT</div>
        </div>
        <% } else { %>
        <div class="aw-coinop">
          <div class="aw-credit" aria-hidden="true"><span>CREDIT</span><span class="n">00</span></div>
          <a class="aw-coinbtn" href="/login"><span class="aw-coin" aria-hidden="true">PAT</span><span class="cap">SIGN IN TO PLAY</span></a>
          <div class="aw-now" id="stSpin" aria-live="polite"></div>
          <div class="aw-status">Spin the stage wheel live on stream.</div>
        </div>
        <% } %>
      </div>
      <% if (feat) { %>
        <a class="box" href="/casino/t/<%= encodeURIComponent(feat.id) %>">
          <h3>🃏 Featured table</h3>
          <b><%= feat.game %></b><span class="muted"> · <%= feat.seats.length %> seated<%= feat.room ? ' · ' + feat.room : '' %></span>
          <div class="muted" style="margin-top:4px">Watch or take a seat ›</div>
        </a>
      <% } %>
      <% if (liveRooms.length >= 2) { %>
        <div class="box">
          <h3>📡 Live rooms</h3>
          <ul class="rooms-mini">
            <% liveRooms.forEach((r) => { %>
              <li><a href="/rooms/<%= encodeURIComponent(r.slug) %>"><span class="n"><%= r.name %></span><span class="muted">👥 <%= r.count %> · 🎙 <%= r.micCount %></span></a></li>
            <% }) %>
          </ul>
        </div>
      <% } %>
    </div>
  </section>

  <!-- ───── you ───── -->
  <% if (me) { %>
  <section class="card me" aria-label="You">
    <div class="pic">
      <a href="/u/<%= encodeURIComponent(me.username) %>/profile" aria-label="Your profile"><img class="ava" src="<%= pic(me.avatar) %>" alt=""></a>
      <% if (M.gtf) { %><a class="gtf" href="/u/<%= encodeURIComponent(me.username) %>/profile" aria-label="Your GTF avatar"><%- M.gtf %></a><% } %>
    </div>
    <div class="who">
      <div class="top"><span class="nm <%= nameCss ? 'cx-name' : '' %>" style="<%= nameCss %>"><%= me.displayname || me.username %></span>
        <span>💰 <b id="balTop"><%= fmt(me.points_balance) %></b> PAT</span><span>⭐ Lv <b><%= me.level %></b> · <%= fmt(me.xp) %>/<%= fmt(need) %> XP</span></div>
      <div class="lvl" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= Math.round(pct) %>" aria-label="XP to the next level"><span style="width: <%= pct.toFixed(1) %>%"></span></div>
      <div class="chips">
        <% if (!me.camfrogUsername) { %><a class="chip warm" href="/u/<%= encodeURIComponent(me.username) %>/profile">🔗 Link Camfrog: type !verify in a room</a><% } %>
        <a class="chip <%= M.tickets ? '' : 'warm' %>" href="/lotto">🎟️ <%= M.tickets ? M.tickets + ' lotto ticket' + (M.tickets === 1 ? '' : 's') : 'no lotto tickets yet' %></a>
        <% if (M.seat) { %><a class="chip mic" href="/casino/t/<%= encodeURIComponent(M.seat.id) %>">🃏 seated at <%= M.seat.game %></a><% } %>
        <% if (M.bets) { %><a class="chip" href="/markets">🔮 <%= M.bets %> open bet<%= M.bets === 1 ? '' : 's' %></a><% } %>
        <a class="chip" href="/achievements">🏅 <%= M.badges %> badges</a>
        <% if (M.pending) { %><span class="chip warm">⏳ <%= M.pending %> waiting for Pepe</span><% } %>
      </div>
    </div>
    <div class="acts">
      <a class="btn primary" href="<%= wheelHref %>">🎡 Arcade wheel</a>
      <a class="btn" href="/lotto">🎟️ Tickets</a>
      <a class="btn" href="/wallet">👛 Wallet</a>
    </div>
  </section>
  <% } else { %>
  <section class="card pitch">
    <p><b>Public Access TV</b> is a community hangout: a live stream, Camfrog rooms where Pepe the frog runs the games, and PAT — the points everyone plays with. <a href="/about">What's this? ›</a></p>
    <div style="display:flex;gap:8px;flex-wrap:wrap"><a class="btn primary" href="/register">Join PATV</a><a class="btn" href="/login">Sign in</a></div>
  </section>
  <% } %>

  <!-- ───── room + live now ───── -->
  <div class="main">
    <% if (room) { %>
    <section class="card" aria-labelledby="lrH">
      <h2 id="lrH"><span>📡 <%= roomOnStage ? 'On stage: ' : '' %><%= room.name %> <span class="pill <%= room.live ? 'on' : 'off' %>" id="lrLive" style="font-family:Ubuntu,sans-serif"><span class="dot" aria-hidden="true"></span><span id="lrLiveTxt"><%= room.live ? 'LIVE' : 'OFFLINE' %></span></span></span>
        <a href="/rooms/<%= encodeURIComponent(room.slug) %>">Open the room ›</a></h2>
      <% if (me) { %>
        <div class="lr">
          <div>
            <div class="lr-feed" id="lrFeed" role="log" aria-live="polite" aria-label="Room chat and mic transcripts" tabindex="0"><p class="muted">Loading the room…</p></div>
            <% if (me.camfrogUsername) { %><div id="lrRelay" style="margin-top:8px;display:grid;gap:4px"></div><div id="lrPtt" style="margin-top:6px;display:grid;gap:4px"></div><% } %>
            <div class="ro">Live from Camfrog — read-only (v1). 🎙 lines are what people said on the mic (auto-transcribed). PMs are never shown; <code>!incognito</code> / <code>!bridge hide</code> users show as "someone".</div>
          </div>
          <div class="lr-side">
            <div class="box"><h3>Topic</h3><div id="lrTopic" style="font-size:13px;overflow-wrap:anywhere"><%= room.topic || '—' %></div></div>
            <div class="box"><h3>On the mic</h3><div class="chips" id="lrMic"></div></div>
            <div id="lrAudioBox"></div>
            <div class="box"><h3>In the room · <span id="lrCount"><%= room.count %></span></h3><div class="chips" id="lrPeople"></div></div>
          </div>
        </div>
      <% } else { %>
        <div class="tease">
          <b style="font-size:16px">Sign in to watch the room live</b>
          <p class="muted" style="margin:0"><%= room.count %> in the room<%= room.micCount ? ' · ' + room.micCount + ' on the mic' : '' %>. The chat, what's said on the mic, and who's here stream to PATV members as it happens.</p>
          <a class="btn primary" href="/login">Sign in</a>
        </div>
      <% } %>
    </section>
    <% } %>
    <aside style="display:grid;gap:14px;align-content:start;min-width:0">
      <section class="card now" aria-labelledby="nowH">
        <h2 id="nowH">Live now</h2>
        <% if (feat) { %><a class="it" href="/casino/t/<%= encodeURIComponent(feat.id) %>"><span>🃏</span><span class="q"><%= feat.game %> table<%= feat.phase ? ' · ' + feat.phase : '' %></span><span class="v"><%= feat.seats.length %> seated</span></a><% } %>
        <% if (S0.lotto) { %><a class="it" href="/lotto"><span>🎟️</span><span class="q">Lotto — draw <%- S0.lotto.next_at ? 'in <span data-until="' + Number(S0.lotto.next_at) + '">…</span>' : 'Sunday' %></span><span class="v"><%= short(S0.lotto.jackpot) %></span></a><% } %>
        <% (S0.closing || []).forEach((m) => { %><a class="it" href="/markets/<%= encodeURIComponent(m.id) %>"><span>🔮</span><span class="q"><%= m.q %></span><span class="v" data-until="<%= Number(m.closes) %>">…</span></a><% }) %>
        <% (S0.topBounties || []).forEach((b) => { %><a class="it" href="/bounties/<%= encodeURIComponent(b.id) %>"><span>🎯</span><span class="q"><%= b.task %></span><span class="v"><%= short(b.pot) %></span></a><% }) %>
        <% if (!feat && !S0.lotto && !(S0.closing || []).length && !(S0.topBounties || []).length) { %><p class="muted" style="margin:0">Quiet right now.</p><% } %>
      </section>
    </aside>
  </div>

  <!-- ───── things to do ───── -->
  <section aria-labelledby="tdH">
    <h2 id="tdH">Things to do <a href="/about">About PATV ›</a></h2>
    <div class="todo">
      <% todo.forEach((t) => { %>
        <a class="<%= t.hot ? 'hot' : '' %>" href="<%= t.href %>">
          <% if (t.fresh) { %><span class="tag">try it</span><% } %>
          <span class="i" aria-hidden="true"><%= t.ic %></span><b><%= t.t %></b><small><%= t.s || (t.hot ? 'live now' : 'open ›') %></small>
        </a>
      <% }) %>
    </div>
  </section>

  <!-- ───── top frogs ───── -->
  <section aria-labelledby="tfH">
    <h2 id="tfH">Top frogs <a href="/rankings">All rankings ›</a></h2>
    <ol class="tf">
      <% (top || []).forEach((u, i) => { const cs = cosmeticName(u.username); %>
        <li class="r<%= i + 1 %>">
          <a href="/u/<%= encodeURIComponent(u.username) %>/profile">
            <span class="rk"><%= i + 1 %></span>
            <span class="av"><% if (u.gtf) { %><%- u.gtf %><% } else { %><img src="<%= pic(u.avatar) %>" alt="" loading="lazy"><% } %></span>
            <span class="nm <%= cs ? 'cx-name' : '' %>" style="<%= cs %>"><%= u.displayname || u.username %></span>
            <span class="pt"><%= short(u.points_balance) %> PAT</span>
            <span class="lv">Level <%= u.level %></span>
          </a>
        </li>
      <% }) %>
    </ol>
  </section>

  <nav class="foot" aria-label="More">
    <a href="/about">About PATV</a><a href="/economy">How PAT works</a><a href="https://pepe.publicaccess.tv" rel="noopener">Pepe's commands</a>
    <a href="https://discord.gg/publicaccess" rel="noopener">Discord</a><a href="/achievements">Achievements</a><a href="/shop">Prize shop</a>
    <span><%= fmt(S0.members) %> members</span>
  </nav>
</main>

<script>
  (function () {
    'use strict';
    // countdowns (lotto draw, markets closing)
    function left(t) { var s = Math.max(0, Math.round(t - Date.now() / 1000)); return s >= 86400 ? Math.floor(s / 86400) + 'd ' + Math.floor(s % 86400 / 3600) + 'h' : s >= 3600 ? Math.floor(s / 3600) + 'h ' + Math.floor(s % 3600 / 60) + 'm' : s > 0 ? Math.max(1, Math.ceil(s / 60)) + 'm' : 'now'; }
    function tick() { document.querySelectorAll('[data-until]').forEach(function (e) { e.textContent = left(Number(e.getAttribute('data-until'))); }); }
    tick(); setInterval(tick, 30000);

    // stage widgets: in the side panel while on air, in the strip while off air
    var stageEl = document.getElementById('stage');
    function placeWidgets() {
      var isLive = stageEl.classList.contains('live');
      var dest = document.getElementById(isLive ? 'stageSide' : 'stageOff');
      ['stageWidgets', isLive ? 'stageOff' : 'stageSide'].forEach(function (id) {
        var src = document.getElementById(id);
        while (src.firstElementChild) dest.appendChild(src.firstElementChild);
      });
    }
    placeWidgets();
    function setPill(on, how) {
      stageEl.classList.toggle('live', on); stageEl.classList.toggle('off', !on);
      document.getElementById('stPill').className = 'pill ' + (on ? 'on' : 'off');
      document.getElementById('stPillTxt').textContent = on ? 'ON AIR' : 'OFF AIR';
      if (how) document.getElementById('stSub').textContent = how;
      placeWidgets();
    }

    // ── the HLS player (public/js/stage-player.js): created on demand, retried every 10 s on any error or stall ──
    // Pepe's stream, and any PAID slots live right now (mainstage.js). During a paid slot the stage
    // shows it; the tabs flip to Pepe's stream (which keeps running as always) and back.
    var PEPE_HLS = 'https://publicaccess.tv/hls/broadcast.m3u8';
    var slots = <%- JSON.stringify(paid.map(function (x) { return { id: x.id, display: x.display, nameCss: x.nameCss, hls: x.hls }; })).replace(/</g, '\\u003c') %>;
    var STAFF = <%= staff ? 'true' : 'false' %>;
    var view = slots.length ? 'slot:' + slots[0].id : 'pepe';
    var twitchLive = false, hlsLive = <%= st.active ? 'true' : 'false' %>;
    function curSlot() {
      if (view.indexOf('slot:') !== 0) return null;
      var id = view.slice(5);
      for (var i = 0; i < slots.length; i++) if (slots[i].id === id) return slots[i];
      return null;
    }
    function src() { var s = curSlot(); return s ? s.hls : PEPE_HLS; }
    function anyLive() { return hlsLive || twitchLive || slots.length > 0; }
    var stagePlayer = PATVStage.player({ wrap: document.getElementById('videoWrapper'), id: 'videoElement', src: src(),
      reconnect: document.getElementById('stReconnect'), unmute: document.getElementById('stUnmute') });
    function startPlayer() { if (twitchLive && !curSlot()) return; stagePlayer.setSrc(src()); stagePlayer.start(); }
    function stopPlayer() { stagePlayer.stop(); }
    var esc = function (t) { return String(t == null ? '' : t).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
    // what the stage shows right now: a paid slot (HLS), or Pepe (Twitch when it's live there, else HLS)
    function show() {
      var s = curSlot(), tw = document.getElementById('twitch');
      if (s) { tw.classList.add('hide'); startPlayer(); setPill(true, null); }
      else if (twitchLive) { stopPlayer(); tw.classList.remove('hide'); setPill(true, 'live on Twitch'); }
      else if (hlsLive) { tw.classList.add('hide'); startPlayer(); setPill(true, null); }
      else { tw.classList.add('hide'); stopPlayer(); setPill(anyLive(), anyLive() ? "Pepe's stream is off air right now" : 'nothing streaming right now'); }
      renderTabs();
    }
    function renderTabs() {
      var box = document.getElementById('stTabs');
      if (!slots.length) { box.innerHTML = ''; return; }
      var h = '';
      slots.forEach(function (s) {
        h += '<button type="button" class="stab" role="tab" data-v="slot:' + esc(s.id) + '" aria-selected="' + (view === 'slot:' + s.id) + '">' +
             '<span class="dot" aria-hidden="true"></span><span class="n' + (s.nameCss ? ' cx-name' : '') + '" style="' + esc(s.nameCss || '') + '">' + esc(s.display) + '</span> is live</button>';
      });
      h += '<button type="button" class="stab' + (hlsLive || twitchLive ? '' : ' off') + '" role="tab" data-v="pepe" aria-selected="' + (view === 'pepe') + '">' +
           '<span class="dot" aria-hidden="true"></span>🐸 Pepe\'s stream' + (hlsLive || twitchLive ? '' : ' (off air)') + '</button>';
      var s = curSlot();
      if (STAFF && s) h += '<span class="adm"><button type="button" data-cut="' + esc(s.id) + '">✂ Cut to Pepe</button><button type="button" data-cut="' + esc(s.id) + '" data-ban="1">Cut + ban</button></span>';
      box.innerHTML = h;
    }
    document.getElementById('stTabs').addEventListener('click', function (e) {
      var b = e.target.closest('button');
      if (!b) return;
      if (b.hasAttribute('data-v')) { view = b.getAttribute('data-v'); show(); return; }
      if (b.hasAttribute('data-cut')) {
        var ban = b.hasAttribute('data-ban');
        if (!confirm(ban ? 'Cut this slot to Pepe AND ban them from booking?' : 'Cut this slot to Pepe? The unused PAT is refunded.')) return;
        b.disabled = true;
        fetch('/api/stage/admin/cut', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: b.getAttribute('data-cut'), ban: ban }) })
          .then(function (r) { return r.json(); }).then(function (j) { if (!j.ok) alert(j.error || 'Could not cut it.'); pollStage(); })
          .catch(function () { alert('Could not reach the server.'); b.disabled = false; });
      }
    });

    // ON AIR = the playlist is actually being written (checked on the server) or Twitch is live
    function pollStage() {
      fetch('/api/stage', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (g) {
        var was = hlsLive, hadSlots = slots.length, cur = curSlot();
        hlsLive = !!g.active;
        var rl = document.getElementById('stRoom');
        if (rl) {
          rl.hidden = !g.room; rl.textContent = g.room ? '📡 ' : '';
          if (g.room) { var x = document.createElement(g.room.slug ? 'a' : 'span'); x.textContent = g.room.name; if (g.room.slug) x.href = '/rooms/' + encodeURIComponent(g.room.slug); rl.appendChild(x); }
        }
        slots = Array.isArray(g.slots) ? g.slots : [];
        if (cur && !curSlot()) view = slots.length ? 'slot:' + slots[0].id : 'pepe';   // that slot ended / was cut
        else if (!hadSlots && slots.length && view === 'pepe') view = 'slot:' + slots[0].id;   // a paid slot just went live
        if (hlsLive !== was || slots.length !== hadSlots || view !== (cur ? 'slot:' + cur.id : 'pepe') || (curSlot() && stagePlayer.src() !== src())) {
          show();
          if (!anyLive() && (was || hadSlots)) setPill(false, 'stream ended just now');
        } else renderTabs();
      }).catch(function () {});
    }
    setInterval(pollStage, 10000);

    // admin: move the stage to another of Pepe's rooms (queued for Pepe; he checks it's safe)
    var adm = document.getElementById('stAdmin');
    if (adm) {
      var admMsg = document.getElementById('stAdminMsg'), admBtn = adm.querySelector('button');
      adm.addEventListener('submit', function (e) {
        e.preventDefault();
        admBtn.disabled = true; admMsg.textContent = 'Sending to Pepe…';
        fetch('/api/stage/room', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' },
                                   body: JSON.stringify({ room: document.getElementById('stRoomSel').value }) })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (!d.ok) { admMsg.textContent = d.error || 'Not sent.'; admBtn.disabled = false; return; }
            var tries = 0;
            (function check() {
              fetch('/api/stage/room/' + d.id, { credentials: 'same-origin', cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (a) {
                if (a.status === 'done') {
                  // Pepe answered; his stage report reaches the site a few seconds later - wait for it so
                  // the reload shows the new room (it used to reload too early and look unchanged)
                  admMsg.textContent = '✓ ' + (a.message || 'Done') + ' — updating the stage…';
                  var want = document.getElementById('stRoomSel').value, waited = 0;
                  (function settle() {
                    fetch('/api/stage/room/' + d.id, { credentials: 'same-origin', cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (b) {
                      var moved = b && (want === 'auto' ? b.pinned === false : b.stageRoomId === want);
                      if (moved || (waited += 1000) > 15000) { location.reload(); return; }
                      setTimeout(settle, 1000);
                    }).catch(function () { location.reload(); });
                  })();
                  return;
                }
                if (a.status === 'failed') { admMsg.textContent = '✗ ' + (a.message || 'Pepe refused'); admBtn.disabled = false; return; }
                if (++tries > 30) { admMsg.textContent = 'Pepe hasn\'t answered yet — is he online?'; admBtn.disabled = false; return; }
                admMsg.textContent = 'Waiting for Pepe…'; setTimeout(check, 2000);
              }).catch(function () { admMsg.textContent = 'Couldn\'t reach the site.'; admBtn.disabled = false; });
            })();
          })
          .catch(function () { admMsg.textContent = 'Couldn\'t reach the site.'; admBtn.disabled = false; });
      });
    }

    window.addEventListener('load', function () {
      show();
      if (!window.Twitch) return;
      var tw = new Twitch.Player('twitch', { channel: 'publicaccess_ttv', width: '100%', height: '100%', muted: true, parent: [location.hostname] });
      tw.addEventListener(Twitch.Player.READY, function () {
        tw.addEventListener(Twitch.Player.ONLINE, function () { twitchLive = true; show(); });
        tw.addEventListener(Twitch.Player.OFFLINE, function () { twitchLive = false; show(); });
      });
    });

    // ── NOW SPINNING / LAST SPIN on the stage wheel, in the spinner's name colour ──
    function spinLine(sp) {
      var box = document.getElementById('stSpin');
      if (!box || !sp || !(sp.display || sp.name)) return;
      box.textContent = '';
      box.appendChild(document.createTextNode(sp.state === 'spinning' || sp.type === 'spinning' ? 'NOW SPINNING \u25B8 ' : 'LAST SPIN \u25B8 '));
      var who = document.createElement('span'); who.className = 'who'; who.textContent = sp.display || sp.name;
      if (sp.nameCss) who.style.cssText = sp.nameCss;
      box.appendChild(who);
      if (sp.result != null && sp.state !== 'spinning' && sp.type !== 'spinning') {
        var a = document.createElement('span'); a.className = 'amt';
        a.textContent = ' \u00B7 ' + (Number(sp.result) > 0 ? '+' + Number(sp.result).toLocaleString('en-US') + ' PAT' : 'no prize');
        box.appendChild(a);
      }
    }
    fetch('/api/g/wheel/last.json', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (d) { spinLine(d.spin); }).catch(function () {});
    try {
      var watch = new EventSource('/events?type=spin&identifier=watch');
      watch.onmessage = function (ev) { try { spinLine(JSON.parse(ev.data)); } catch (e) {} };
    } catch (e) {}
  })();
</script>

<% if (me) { %>
<script>
  // The stage wheel: the Wheel page's coin-op (public/js/coinop.js, unchanged) driving the PUBLIC
  // wheel in OBS - same /api/g/wheel/spin, 5,000 PAT and cooldown as the old homepage arcade.
  (function () {
    'use strict';
    var user = <%- JSON.stringify(me.username).replace(/</g, '\\u003c') %>;
    var onStage = null;
    window.wheelBalance = <%= Number(me.points_balance) || 0 %>;
    window.wheelSpinsLeft = null;
    window.setSpinStatus = function (msg, kind, html) {
      var ss = document.getElementById('spinStatus'); if (!ss) return;
      ss.className = 'aw-status' + (kind ? ' ' + kind : '');
      if (html) ss.innerHTML = msg; else ss.textContent = msg;
    };
    function bal() {
      return fetch('/api/u/' + encodeURIComponent(user) + '/balance').then(function (r) { return r.json(); }).then(function (d) {
        if (d.balance === undefined) return;
        window.wheelBalance = Number(d.balance);
        var t = window.wheelBalance.toLocaleString('en-US');
        var a = document.getElementById('balTxt'); if (a) a.textContent = t;
        var b = document.getElementById('balTop'); if (b) b.textContent = t;
      }).catch(function () {});
    }
    function checkStage() {
      return fetch('/api/g/wheel/listeners').then(function (r) { return r.json(); })
        .then(function (d) { onStage = (Number(d.listeners) || 0) > 0; }).catch(function () { onStage = null; });
    }
    checkStage(); setInterval(checkStage, 30000);
    function fire(name, detail) { document.dispatchEvent(new CustomEvent(name, { detail: detail || {} })); }
    window.userSpin = function () {
      return checkStage().then(function () {
        if (onStage === false) return { ok: false, message: 'The wheel isn\'t on the stage right now - try again when it\'s up.' };
        return fetch('/api/g/wheel/spin', { method: 'POST', headers: { 'content-type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ username: user }) })
          .then(function (r) {
            if (r.redirected || r.status === 401) return { ok: false, login: true, message: 'Sign in again.' };
            return r.ok ? r.json().then(function (d) { return d.spinId ? { ok: true, spinId: d.spinId } : { ok: false, message: 'The wheel is busy.' }; })
                        : r.text().then(function (t) { if (/^\s*</.test(t || '')) t = ''; return { ok: false, message: (t || 'The wheel is busy - try again in a moment.').slice(0, 160) }; });
          })
          .then(function (res) {
            if (!res.ok) return res;
            bal();
            // the coin has dropped: the wheel is spinning on stream now
            Promise.resolve(window.wheelCoinGate).then(function () { fire('wheel:spinstart'); window.setSpinStatus('Spinning on stream…', 'ok'); });
            var es = new EventSource('/events?type=results&identifier=' + encodeURIComponent(res.spinId));
            var guard = setTimeout(function () { es.close(); fire('wheel:result', {}); window.setSpinStatus('No result yet - check the stream.', ''); }, 90000);
            es.onmessage = function (ev) {
              var d = {}; try { d = JSON.parse(ev.data); } catch (e) {}
              clearTimeout(guard); es.close();
              var won = Number(d.result) || 0;
              fire('wheel:result', { result: won });
              window.setSpinStatus(won > 0 ? '+' + won.toLocaleString('en-US') + ' PAT' + (d.xp ? ' · +' + Math.round(d.xp) + ' XP' : '') +
                (d.levelUp && d.levelUp.leveledUp ? ' · LEVEL ' + d.levelUp.newLevel + '!' : '') : 'No prize this time.', won > 0 ? 'win' : '');
              bal();
            };
            es.onerror = function () { clearTimeout(guard); es.close(); fire('wheel:result', {}); };
            return res;
          });
      });
    };
  })();
</script>
<script src="/public/js/coinop.js?v=aw1" defer></script>
<% } %>

<% if (me && room) { %>
<link rel="stylesheet" href="/public/css/room-bridge.css?v=2">
<script src="/public/js/room-bridge.js?v=2"></script>
<script id="lrInit" type="application/json"><%- JSON.stringify(roomLive).replace(/</g, '\\u003c') %></script>
<script>
  // The live room widget: chat + mic transcripts, polled every 3s while the tab is visible (bridge.js).
  (function () {
    'use strict';
    var slug = <%- JSON.stringify(room.slug).replace(/</g, '\\u003c') %>;
    var feed = document.getElementById('lrFeed'), cursor = 0, started = false, timer = null, fails = 0, lastP = '', lastM = '';
    function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
    function label(u) { return !u || u.anon ? 'someone' : (u.display || u.login); }
    function hhmm(ts) { var d = new Date(ts); return ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2); }
    function nameEl(u) {
      var n = el('span', 'w', label(u));
      if (u && u.patv && u.patv.style) { n.classList.add('cx-name'); n.style.cssText = u.patv.style; }
      if (u && !u.anon && u.login && u.display && u.display.toLowerCase() !== u.login.toLowerCase()) n.title = u.login;
      return n;
    }
    function chipTitle(c, u) { if (u && !u.anon && u.login && u.display && u.display.toLowerCase() !== u.login.toLowerCase()) c.title = u.login; return c; }
    function line(it) {
      if (it.k === 'msg' || it.k === 'tx') {
        var d = el('div', 'ln' + (it.k === 'tx' ? ' tx' : '') + (it.u && it.u.self ? ' pepe' : ''));
        if (it.k === 'tx') d.title = 'Said on the mic (auto-transcribed)';
        d.appendChild(nameEl(it.u)); d.appendChild(document.createTextNode(it.k === 'tx' ? '“' + it.text + '”' : it.text)); d.appendChild(el('span', 't', hhmm(it.ts)));
        return d;
      }
      var t = it.k === 'join' ? '→ ' + label(it.u) + ' joined' : it.k === 'leave' ? '← ' + label(it.u) + ' left'
        : it.k === 'mic' ? '🎙️ ' + label(it.u) + ' grabbed the mic' : it.k === 'unmic' ? '🎙️ ' + label(it.u) + ' dropped the mic'
        : it.k === 'topic' ? '📌 topic: ' + it.text : null;
      return t ? el('div', 'ln sys', t + ' · ' + hhmm(it.ts)) : null;
    }
    function chip(u, cls) { return chipTitle(el('span', 'chip' + (cls ? ' ' + cls : ''), label(u)), u); }
    var roomAudio = PATVRoom.audio(document.getElementById('lrAudioBox'), slug);
    var relayHost = document.getElementById('lrRelay'), roomRelay = relayHost ? PATVRoom.relay(relayHost, slug) : null;
    var pttHost = document.getElementById('lrPtt'), roomPtt = pttHost ? PATVRoom.ptt(pttHost, slug) : null;
    function apply(d) {
      var near = !started || feed.scrollHeight - feed.scrollTop - feed.clientHeight < 60;
      if (started && d.cursor < cursor) { started = false; cursor = 0; }
      if (!started) feed.textContent = '';
      (d.feed || []).slice(-80).forEach(function (it) { var n = line(it); if (n) feed.appendChild(n); });
      if (!started && !feed.childNodes.length) feed.appendChild(el('p', 'muted', 'Quiet right now — lines show up here the moment someone talks.'));
      if (started && (d.feed || []).length && feed.firstChild && feed.firstChild.tagName === 'P') feed.removeChild(feed.firstChild);
      while (feed.childNodes.length > 120) feed.removeChild(feed.firstChild);
      if (near) feed.scrollTop = feed.scrollHeight;
      started = true;
      cursor = Math.max(cursor, d.cursor || 0);
      var r = d.room || {};
      document.getElementById('lrTopic').textContent = r.topic || '—';
      document.getElementById('lrCount').textContent = r.count;
      document.getElementById('lrLive').className = 'pill ' + (r.live ? 'on' : 'off');
      document.getElementById('lrLiveTxt').textContent = r.live ? 'LIVE' : 'OFFLINE';
      roomAudio.update(d);
      if (roomRelay) roomRelay.update(d);
      if (roomPtt) roomPtt.update(d);
      var mk = JSON.stringify(d.mic);
      if (mk !== lastM) { lastM = mk; var m = document.getElementById('lrMic'); m.textContent = ''; if (!d.mic.length) m.appendChild(el('span', 'muted', 'Mic is free')); d.mic.forEach(function (u) { m.appendChild(chip(u, 'mic')); }); }
      var pk = JSON.stringify(d.members);
      if (pk !== lastP) {
        lastP = pk; var p = document.getElementById('lrPeople'); p.textContent = '';
        var ms = d.members.filter(function (u) { return !u.self; }).sort(function (a, b) { return (b.on_mic ? 1 : 0) - (a.on_mic ? 1 : 0) || (a.anon ? 1 : 0) - (b.anon ? 1 : 0) || label(a).localeCompare(label(b)); });
        ms.slice(0, 30).forEach(function (u) { p.appendChild(chip(u, u.on_mic ? 'mic' : '')); });
        if (ms.length > 30) p.appendChild(el('span', 'muted', '+' + (ms.length - 30) + ' more'));
        if (!ms.length) p.appendChild(el('span', 'muted', 'Just Pepe'));
      }
    }
    function poll() {
      timer = null;
      if (document.hidden) return;
      fetch('/api/rooms/' + encodeURIComponent(slug) + '/live?after=' + cursor, { credentials: 'same-origin', cache: 'no-store' })
        .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
        .then(function (d) { fails = 0; apply(d); })
        .catch(function () { fails++; })
        .then(function () { if (!timer && !document.hidden) timer = setTimeout(poll, fails ? Math.min(30000, 3000 * Math.pow(2, fails)) : 3000); });
    }
    document.addEventListener('visibilitychange', function () { if (!document.hidden && !timer) poll(); });
    var init = JSON.parse(document.getElementById('lrInit').textContent);
    if (init) apply(init);
    timer = setTimeout(poll, 3000);
  })();
</script>
<% } %>
