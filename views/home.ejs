<script>
  (function () {
    'use strict';
    // countdowns (lotto draw, markets closing)
    function left(t) { var s = Math.max(0, Math.round(t - Date.now() / 1000)); return s >= 86400 ? Math.floor(s / 86400) + 'd ' + Math.floor(s % 86400 / 3600) + 'h' : s >= 3600 ? Math.floor(s / 3600) + 'h ' + Math.floor(s % 3600 / 60) + 'm' : s > 0 ? Math.max(1, Math.ceil(s / 60)) + 'm' : 'now'; }
    function tick() { document.querySelectorAll('[data-until]').forEach(function (e) { e.textContent = left(Number(e.getAttribute('data-until'))); }); }
    tick(); setInterval(tick, 30000);

    // 1.99eo: the stage keeps one layout on and off air; .live / .off on #stage swaps the off-air slate
    // (#stSlate, in the player's box) for the player - the switcher's 10 s poll of /api/stage calls onAir
    var stageEl = document.getElementById('stage');
    function setPill(on, how) {
      stageEl.classList.toggle('live', on); stageEl.classList.toggle('off', !on);
      document.getElementById('stPill').className = 'pill ' + (on ? 'on' : 'off');
      document.getElementById('stPillTxt').textContent = on ? 'ON AIR' : 'OFF AIR';
      if (how) document.getElementById('stSub').textContent = how;
    }
    // the slate's "Next up" time in the viewer's own clock (the server writes UTC)
    document.querySelectorAll('time[data-local-time]').forEach(function (t) {
      var d = new Date(Number(t.getAttribute('data-local-time')));
      if (isNaN(d.getTime())) return;
      var today = new Date().toDateString() === d.toDateString();
      try { t.textContent = (today ? '' : d.toLocaleDateString([], { weekday: 'short' }) + ' ') + d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }); } catch (e) {}
    });

    // ── the stage (public/js/stage-room.js): the FRONT ROOM's stage - its featured slot by default, else
    // Pepe's stream (his HLS + low-latency WHEP, or an admin-chosen YouTube / Twitch embed - 1.99fv: never an automatic
    // Twitch swap); tabs switch between every live stream.
    var initSlots = <%- JSON.stringify(paid).replace(/</g, '\\u003c') %>;
    // 1.99cr: Snap / Clip the stream that's showing (stage-capture.js) - it goes to the FRONT pad's story
    var frontSlug = <%- JSON.stringify(frontInfo ? frontInfo.slug : '').replace(/</g, '\\u003c') %>;
    var stCap = PATVStage.capture({ host: document.getElementById('stCap'), room: function () { return frontSlug; } });
    PATVStage.switcher({
      tabs: document.getElementById('stTabs'), wrap: document.getElementById('videoWrapper'),
      reconnect: document.getElementById('stReconnect'), unmute: document.getElementById('stUnmute'),
      embedHost: document.getElementById('stEmbed'),
      onShow: function (sel) { stCap.update(frontSlug ? sel : null); },
      onPoll: function (g) { if (g && g.front && g.front.slug && g.front.slug !== frontSlug) { frontSlug = g.front.slug; stCap.reload(); } },
      api: '/api/stage', slots: initSlots, pepeOn: <%= st.active ? 'true' : 'false' %>, pepeHere: <%= pepeHere_ ? 'true' : 'false' %>, pepeWhep: <%- JSON.stringify(st.whep || null).replace(/</g, '\\u003c') %>, pepeSrc: <%- JSON.stringify(st.pepe_src || null).replace(/</g, '\\u003c') %>, manage: <%= staff ? 'true' : 'false' %>,
      onAir: function (on, sub) { setPill(on, sub || (on ? 'live now' : 'nothing streaming right now')); }
    });

    // admin: which room the homepage features (a site setting - Pepe's !activeroom is untouched)
    var adm = document.getElementById('stAdmin');
    if (adm) {
      var admMsg = document.getElementById('stAdminMsg'), admBtn = adm.querySelector('button');
      adm.addEventListener('submit', function (e) {
        e.preventDefault();
        admBtn.disabled = true; admMsg.textContent = 'Saving…';
        fetch('/api/rooms/front', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ room: document.getElementById('stRoomSel').value }) })
          .then(function (r) { return r.json(); })
          .then(function (d) { if (!d.ok) { admMsg.textContent = d.error || 'Not saved.'; admBtn.disabled = false; return; } location.reload(); })
          .catch(function () { admMsg.textContent = 'Couldn\'t reach the site.'; admBtn.disabled = false; });
      });
    }

    // ── NOW SPINNING / LAST SPIN on the stage wheel, in the spinner's name colour ──
    function spinLine(sp) {
      var box = document.getElementById('stSpin');
      if (!box || !sp || !(sp.display || sp.name)) return;
      box.textContent = '';
      box.appendChild(document.createTextNode(sp.state === 'spinning' || sp.type === 'spinning' ? 'NOW SPINNING \u25B8 ' : 'LAST SPIN \u25B8 '));
      var who = document.createElement('span'); who.className = 'who'; who.textContent = sp.display || sp.name;
      if (sp.nameCss) who.style.cssText = sp.nameCss;
      box.appendChild(who);
      if (sp.result != null && sp.state !== 'spinning' && sp.type !== 'spinning') {
        var a = document.createElement('span'); a.className = 'amt';
        a.textContent = (Number(sp.result) > 0 ? '+' + Number(sp.result).toLocaleString('en-US') + ' PAT' : 'no prize');
        box.appendChild(a);
      }
    }
    fetch('/api/g/wheel/last.json', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (d) { spinLine(d.spin); }).catch(function () {});
    try {
      var watch = new EventSource('/events?type=spin&identifier=watch');
      watch.onmessage = function (ev) { try { spinLine(JSON.parse(ev.data)); } catch (e) {} };
    } catch (e) {}
  })();
</script>

