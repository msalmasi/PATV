<!-- views/home.ejs — the functional homepage (home.js). Explainers live on /about. -->
<%- include('layout', { title: 'Public Access Television', user: username }) %>
<%
  const fmt = (n) => Math.round(Number(n) || 0).toLocaleString('en-US');
  const short = (n) => { n = Number(n) || 0; const a = Math.abs(n);
    return a >= 1e9 ? (n / 1e9).toFixed(a >= 1e10 ? 0 : 1) + 'B' : a >= 1e6 ? (n / 1e6).toFixed(a >= 1e7 ? 0 : 1) + 'M' : a >= 1e4 ? Math.round(n / 1e3) + 'K' : fmt(n); };
  const ago = (ms) => { const s = Math.max(0, Math.round((Date.now() - ms) / 1000)); return s < 90 ? 'just now' : s < 5400 ? Math.round(s / 60) + 'm ago' : s < 172800 ? Math.round(s / 3600) + 'h ago' : Math.round(s / 86400) + 'd ago'; };
  const pic = (a) => (typeof a === 'string' && /^(https?:\/\/|\/)/.test(a) ? a : '/public/img/avatar.png');
  const S0 = S || {};
  const st = stage || { active: false };
  const paid = Array.isArray(slots) ? slots : [];
  const pepeHere_ = typeof pepeHere === 'undefined' ? true : pepeHere !== false;   // 1.99cj: Pepe is in the featured room
  const live = (!!st.active && pepeHere_) || paid.length > 0;
  // 1.99ek: Top Pads (home.topPads: top 5 live pads, the front pick's order) and the shared 🚀 badge (boostmark.js)
  const tops_ = typeof tops !== 'undefined' && Array.isArray(tops) ? tops : [];
  // 1.99hm: 🎧 on Top Pads rows - room-bridge.js is loaded whenever a row or the room widget needs it
  const tpListen_ = tops_.some((r) => r.audio && r.listen);
  const rbJs_ = tpListen_ || ((typeof me !== 'undefined' && me) || (typeof roomLive !== 'undefined' && roomLive)) && (typeof room !== 'undefined' && room);
  // 1.99eo: the front pad's next scheduled slot ({display, title, start_at}) for the off-air slate, or null
  const nextUp_ = typeof nextUp !== 'undefined' && nextUp && Number(nextUp.start_at) > 0 ? nextUp : null;
  const BM = typeof boostMark === 'function' ? boostMark : () => '';
  const PAV_ = typeof padAv === 'function' ? padAv : () => '';     // 1.99es: a pad's avatar (padlook.js), '' when rendered bare
  const PFX_ = typeof padFx === 'function' ? padFx : () => null;   // 1.99ew: premium pad cosmetics (padcosmetics.fx), null when rendered bare
  const feat = S0.featured;
  const need = me ? xpForNextLevel(me.level) : 1;
  const pct = me ? Math.max(0, Math.min(100, need ? (me.xp / need) * 100 : 0)) : 0;
  const nameCss = me ? cosmeticName(me.username) : '';
  const M = mine || {};
  const wheelHref = me ? '/u/' + encodeURIComponent(me.username) + '/wheel' : '/login';
  // things to do: compact, action-first; `hot` = something live there now, `fresh` = you haven't tried it
  const todo = [
    { href: '/p', ic: '📡', t: 'Pads', s: room ? room.count + ' in ' + room.name : null, hot: !!(room && room.live) },
    { href: '/stage', ic: '🎥', t: 'Go live', s: 'stream to a pad', hot: paid.length > 0 },
    { href: '/markets', ic: '🔮', t: 'Markets', s: S0.markets ? S0.markets + ' open' : null, hot: S0.markets > 0, fresh: me && me.camfrogUsername && !M.bets },
    { href: '/lotto', ic: '🎟️', t: 'Lotto', s: S0.lotto ? short(S0.lotto.jackpot) + ' jackpot' : null, hot: !!(S0.lotto && S0.lotto.open), fresh: me && me.camfrogUsername && !M.tickets },
    { href: wheelHref, ic: '🎡', t: 'Wheel', s: S0.casinoPot ? short(S0.casinoPot) + ' pot' : null },
    { href: '/tables', ic: '🃏', t: 'Casino tables', s: (S0.tables || []).length ? S0.tables.map((t) => t.game).join(' + ') + ' open' : null, hot: (S0.tables || []).length > 0 },
    { href: '/gtf', ic: '🔫', t: 'Grand Theft Frogger', s: null },
    { href: '/bounties', ic: '🎯', t: 'Bounties', s: S0.bounties ? S0.bounties + ' open' : null, hot: S0.bounties > 0 },
    { href: '/wagers', ic: '🤝', t: 'Wagers', s: S0.wagers ? S0.wagers + ' live' : null },
    { href: '/staking', ic: '🏦', t: 'Staking', s: S0.vaults ? short(S0.vaults.house) + ' House' : null },
    { href: '/cosmetics', ic: '🎨', t: 'Cosmetics', s: null },
    { href: '/feed', ic: '📝', t: 'Feed & stories', s: null },
    { href: '/rankings', ic: '🏆', t: 'Rankings', s: null },
  ];
%>
<link href="https://vjs.zencdn.net/8.3.0/video-js.css" rel="stylesheet" />
<script src="https://vjs.zencdn.net/8.3.0/video.min.js" defer></script>
<script src="/public/js/stage-player.js?v=8"></script>
<%# 1.99et: ⚡ Low latency (WebRTC / WHEP) - only while the stage setting webrtc_enabled is on (webrtc.js) %>
<% if (typeof locals.webrtcCfg === 'function' && locals.webrtcCfg()) { %><link rel="stylesheet" href="/public/css/webrtc.css?v=2">
<script src="/public/js/webrtc-client.js?v=2"></script>
<script src="/public/js/stage-lowlat.js?v=2"></script>
<% } %><script src="/public/js/stage-room.js?v=7"></script>
<link rel="stylesheet" href="/public/css/stagecap.css?v=1">
<link rel="stylesheet" href="/public/css/padfx.css?v=2">
<script src="/public/js/stage-capture.js?v=2"></script>
<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/public/css/arcade-wheel.css?v=aw2">
<%- include('partials/cosmetics-css') %>
<style>
  .hm { --card: #111; --line: #222; --muted: #8a8a8a; --green: #4caf50; --lime: #c6e94f; --gold: #ffd700;
        max-width: 1400px; margin: 0 auto; padding: 14px 16px 56px; font-family: Ubuntu, sans-serif; color: #e6e6e6;
        display: grid; gap: var(--cardgap); box-sizing: border-box; width: 100%; }
  .hm *, .hm *::before, .hm *::after { box-sizing: border-box; }
  .hm a { color: #81c784; text-decoration: none; }
  .hm a:hover { color: #a5d6a7; }
  .hm .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: var(--py) var(--px); min-width: 0; }
  .hm h2 { margin: 0 0 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); font-family: 'Press Start 2P', monospace; font-size: 10px; line-height: 1.6;
           display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .hm h2 a, .hm h2 small { font-family: Ubuntu, sans-serif; letter-spacing: 0; text-transform: none; font-size: 12.5px; color: #81c784; }
  .hm .muted { color: var(--muted); font-size: 13px; }
  .hm .btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 8px 14px; border-radius: 9px; border: 1px solid #2b2b2b; background: #181818; color: #ddd !important; font-size: 14px; font-weight: bold; cursor: pointer; font-family: inherit; }
  .hm .btn:hover, .hm .btn:focus-visible { border-color: var(--green); }
  .hm .btn.primary { background: var(--green); border-color: var(--green); color: #fff !important; }
  .hm .btn[disabled] { opacity: .5; cursor: not-allowed; }
  .hm .pill { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; padding: 2px 9px; border-radius: 999px; font-weight: bold; letter-spacing: .06em; white-space: nowrap; }
  .hm .pill.on { background: #3a1010; border: 1px solid #7a2222; color: #ffb4b4; }
  .hm .pill.off { background: #1c1c1c; border: 1px solid #333; color: #999; }
  .hm .dot { width: 7px; height: 7px; border-radius: 50%; background: #ff5252; animation: hmPulse 1.6s ease-in-out infinite; }
  .hm .pill.off .dot { background: #666; animation: none; }
  @keyframes hmPulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

  /* ── main stage ── */
  /* 1.99ds: one padding for every card and the stage (--px / --py), one gap between blocks (--gap) */
  .hm { --px: 16px; --py: 14px; --gap: 12px; --cardgap: 14px; }
  .hm .stage { border: 1px solid var(--line); border-radius: 14px; background: radial-gradient(120% 140% at 0% 0%, #17301a 0%, #0d0d0f 55%); overflow: hidden; }
  .hm .stage .bar { display: flex; align-items: center; gap: 8px 12px; flex-wrap: wrap; padding: var(--py) var(--px) var(--gap); min-width: 0; }
  .hm .stage .bar .ttl { font-family: 'Press Start 2P', monospace; font-size: 10px; letter-spacing: .1em; color: var(--lime); }
  .hm .stage .bar .sub { color: #aab3aa; font-size: 13px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .stage .bar .sub a { color: #c6e94f !important; }
  .hm .stage.live #stSub { display: none; }
  /* admin-only strip: collapsed to one line by default */
  .hm .stage-adm { margin: 0 var(--px) var(--gap); border: 1px solid #2a2618; border-radius: 10px; background: rgba(20, 18, 8, .55); font-size: 13px; color: #aab3aa; min-width: 0; }
  .hm .stage-adm > summary { cursor: pointer; list-style: none; display: flex; align-items: baseline; gap: 6px; padding: 7px 12px; color: #ffcc80; font-weight: bold; min-width: 0;
                             white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hm .stage-adm > summary::-webkit-details-marker { display: none; }
  .hm .stage-adm > summary .muted { font-weight: normal; font-size: 12.5px; overflow: hidden; text-overflow: ellipsis; }
  .hm .stage-adm > summary .gear { display: inline-block; transition: transform .2s; }
  .hm .stage-adm[open] > summary .gear { transform: rotate(60deg); }
  .hm .stage-adm > summary:focus-visible { outline: 2px solid var(--lime); outline-offset: -2px; border-radius: 10px; }
  .hm .stage-admin { display: grid; gap: 8px; padding: 0 12px 10px; min-width: 0; }
  .hm .stage-admin .sa-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; min-width: 0; }
  .hm .stage-admin select { background: #0d0d0d; color: #eee; border: 1px solid #333; border-radius: 8px; padding: 6px 8px; font: inherit; font-size: 13px; min-width: 0; max-width: 100%; }
  .hm .stage-admin .btn { padding: 6px 12px; font-size: 13px; }
  .hm .stage-admin #stAdminMsg:empty { display: none; }
  .hm .stage-admin .sa-link { margin-left: auto; white-space: nowrap; }
  /* 1.99eo: one layout on and off air - the player box (or the off-air slate in its place) + the side column */
  .hm .stage-body { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: var(--gap); padding: 0 var(--px) var(--px); align-items: start; }
  /* the player column: the video, then its Snap / Clip row at the same width */
  .hm .stage-main { width: 100%; max-width: calc((100vh - 190px) * 16 / 9); min-width: 0; justify-self: center; }
  .hm .player { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #000; border-radius: 12px; overflow: hidden; border: 1px solid #262626; }
  .hm .stage-main .stcap { margin: 0; padding: 7px 10px; gap: 6px 8px; background: #0c120c; border: 1px solid #262626; border-top: 0; border-radius: 0 0 12px 12px; }
  .hm .stage-main:has(> .stcap:not(.hide):not(:empty)) .player { border-radius: 12px 12px 0 0; }
  .hm .stage-main .stcap-btn { padding: 5px 11px; font-size: 13px; }
  .hm .stage-main .stcap-secs { padding: 4px 4px; }
  .hm .stage-main .stcap-price { margin-left: auto; text-align: right; }
  @media (max-width: 760px) { .hm .stage-main .stcap-price { margin-left: 0; text-align: left; flex-basis: 100%; } }
  .hm .player #videoWrapper { position: absolute; inset: 0; display: block; height: auto; }
  .hm .player .video-js { width: 100%; height: 100%; }
  .hm .player #videoOverlay { position: absolute; inset: 0; display: grid; place-items: center; grid-template-rows: none; grid-template-columns: none; cursor: pointer; z-index: 3; background: rgba(0,0,0,.45); }
  .hm .player #videoOverlay img { grid-column: auto; grid-row: auto; width: 56px; height: auto; opacity: .9; }
  .hm .hide { display: none !important; }
  .hm .stage-side { display: grid; gap: var(--gap); align-content: start; align-self: start; min-width: 0; }
  .hm .stage-side > * { margin-top: 0; }
  .hm .player .reconnect { position: absolute; inset: 0; display: grid; place-items: center; grid-auto-flow: column; gap: 8px; place-content: center;
                           background: rgba(0,0,0,.72); color: #ddd; font-size: 15px; z-index: 4; }
  .hm .player .unmute { position: absolute; inset: 0; z-index: 3; background: rgba(0,0,0,.35); border: 0; cursor: pointer; display: grid; place-items: center; }
  .hm .player .unmute img { width: 56px; height: auto; opacity: .9; }
  .hm .rooms-mini { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .hm .rooms-mini a { display: flex; justify-content: space-between; gap: 8px; color: #ddd !important; font-size: 13.5px; padding: 3px 0; }
  .hm .rooms-mini .n { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* 1.99es: name + avatar + 🚀 on the left, the 👥 / 🎙 counts in fixed columns on the right */
  .hm .tp .rooms-mini .n { display: inline-flex; align-items: center; gap: 6px; flex: 1 1 auto; }
  .hm .tp .rooms-mini .nt { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .tp .rooms-mini .n .bm { flex: none; }
  .hm .tp .rooms-mini .n .pfx-bs { flex: none; }   /* 1.99ew: pad badges (icons) by the name */
  .hm .tp .rooms-mini a.pfx { border-radius: 8px; }
  /* 1.99hm: 🎧 listen to a pad from the homepage (one room at a time; greyed when its audio relay is off) */
  .hm .tp .rooms-mini li { display: flex; align-items: center; gap: 6px; }
  .hm .tp .rooms-mini li > a { flex: 1 1 auto; min-width: 0; }
  .hm .tp-ls { flex: none; width: 30px; height: 26px; border-radius: 8px; border: 1px solid #2a3a2c; background: #0d0d0d; color: #ddd; cursor: pointer; font-size: 14px; line-height: 1; padding: 0; }
  .hm .tp-ls:hover:not([disabled]) { border-color: #4caf50; }
  .hm .tp-ls[aria-pressed="true"] { background: #1d3a24; border-color: #4caf50; }
  .hm .tp-ls[disabled] { opacity: .45; cursor: not-allowed; }
  .hm #tpAudioBox:empty { display: none; }
  .hm #tpAudioBox { margin-top: 8px; }
  .hm .tp .rooms-mini .v > span { display: inline-block; min-width: 3.2em; text-align: right; }
  .hm .pad-av { width: 20px; height: 20px; flex: none; border-radius: 6px; overflow: hidden; display: inline-grid; place-items: center; background: #1c2a1c; font-size: 11px; font-weight: bold; color: #fff; }
  .hm .pad-av img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* 1.99ek: Top Pads + the shared 🚀 boost badge (boostmark.js) */
  .hm .tp h2 { margin-bottom: 6px; }
  .hm .tp .rooms-mini { grid-template-columns: minmax(0, 1fr); }
  .hm .tp .rooms-mini li { min-width: 0; }
  .hm .tp .rooms-mini a { align-items: center; }
  .hm .rooms-mini .v { display: inline-flex; flex: none; gap: 8px; align-items: center; color: var(--muted); font-size: 12.5px; white-space: nowrap; }
  .hm .bm { display: inline-flex; align-items: center; padding: 1px 8px; border-radius: 999px; border: 1px solid #7a4a1f; background: #20140a; color: #ffd9a8;
            font-size: 12px; font-weight: bold; white-space: nowrap; cursor: help; flex: none; }
  .hm .aw-hm .aw-now { width: 100%; font-family: var(--aw-pixel); font-size: 9px; letter-spacing: 1px; color: var(--aw-dim); text-align: center; min-height: 14px; line-height: 1.6; overflow-wrap: anywhere; }
  .hm .aw-hm .aw-now .who { font-family: Ubuntu, sans-serif; font-size: 15px; letter-spacing: 0; font-weight: bold; color: #fff; }
  .hm .aw-hm .aw-now .amt { color: var(--aw-gold); display: block; white-space: nowrap; }
  .hm .box { background: rgba(0,0,0,.4); border: 1px solid #1f2a20; border-radius: 12px; padding: 10px 12px; min-width: 0; }
  .hm .box h3 { margin: 0 0 6px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .hm a.box { display: block; color: #ddd !important; }
  .hm a.box:hover { border-color: #2f5a34; }
  .hm .wheel .row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .hm .wheel .res { font-size: 13px; color: #c9d3c9; min-height: 18px; margin-top: 6px; }
  .hm .wheel .res b { color: var(--gold); }
  /* the stage wheel: the Wheel page's coin-op (arcade-wheel.css), compact */
  .hm .aw.aw-hm { display: block; max-width: none; width: 100%; margin: 0; padding: 0; font-size: 18px; }
  .hm .aw.aw-hm::before { display: none; }
  .hm .aw-hm .aw-coinop { display: flex; flex-direction: column; max-width: none; margin: 0; gap: 10px; padding: 12px; }
  .hm .aw-hm .aw-credit { font-size: 24px; padding: 4px 10px; }
  .hm .aw-hm-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center; width: 100%; }
  .hm .aw-hm .aw-door { padding: 10px 8px 8px; }
  .hm .aw-hm .aw-plate { padding: 6px 4px; }
  .hm .aw-hm .aw-plate .p { font-size: 15px; }
  .hm .aw-hm .aw-plate .ins { font-size: 8px; }
  .hm .aw-hm .aw-slot-area { height: 48px; }
  .hm .aw-hm .aw-slot { width: 86px; }
  .hm .aw-hm .aw-coinbtn { color: var(--aw-text) !important; }
  .hm .aw-hm .aw-coinbtn .aw-coin { --s: 72px; }
  .hm .aw-hm .aw-status { min-height: 2.4em; font-size: 18px; }
  .hm .aw-hm a.aw-tool { text-align: center; color: var(--aw-text) !important; }
  /* 1.99eo: the off-air slate - fills the player's 16:9 box while nothing plays (the switcher's onAir swaps it
     for the player when a stream comes back: .stage.live hides it) */
  .hm .slate { position: absolute; inset: 0; z-index: 5; display: grid; place-items: center; padding: 14px; text-align: center;
               background: radial-gradient(90% 120% at 50% 0%, #1b2b1c 0%, #0b0d0b 70%), #0b0d0b; }
  .hm .slate::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
                       background: repeating-linear-gradient(0deg, rgba(255,255,255,.025) 0 1px, transparent 1px 3px); }
  .hm .stage.live .slate { display: none; }
  .hm .slate .sl-in { position: relative; display: grid; justify-items: center; gap: 8px; max-width: 460px; min-width: 0; }
  .hm .slate .sl-pad { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; min-width: 0; }
  .hm .slate .sl-pad b { font-size: 20px; color: #fff; overflow-wrap: anywhere; }
  .hm .slate .sl-msg { margin: 0; color: #c9d3c9; font-size: 15px; }
  .hm .slate .sl-acts { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; align-items: center; margin-top: 4px; }
  .hm .slate .golive-btn { font-size: 15px; padding: 9px 18px; }
  .hm .slate .sl-next { font-size: 13px; color: #aab3aa; overflow-wrap: anywhere; }
  .hm .slate .sl-next b { color: #e8d9a0; }
  @media (max-width: 520px) {
    .hm .slate { padding: 8px; }
    .hm .slate .sl-in { gap: 5px; }
    .hm .slate .sl-pad b { font-size: 16px; }
    .hm .slate .sl-msg { font-size: 13px; }
    .hm .slate .sl-acts { margin-top: 2px; gap: 6px; }
    .hm .slate .golive-btn { font-size: 13.5px; padding: 7px 14px; }
    .hm .slate .sl-next, .hm .slate .sl-acts .btn { font-size: 12px; }
    .hm .slate .sl-acts .btn { padding: 6px 10px; }
  }
  /* 1.99eo: the side column runs the player's height on desktop - Top Pads takes the spare room, no void under it */
  @media (min-width: 1101px) {
    .hm .stage-body { align-items: stretch; }
    .hm .stage-main { align-self: start; }
    .hm .stage-side { display: flex; flex-direction: column; align-self: stretch; }
    .hm .stage-side > .tp { flex: 1 1 auto; }
  }
  /* 1.99eo: the Camfrog room's pill is about CHAT, not video: 💬 ROOM ACTIVE (green) / ROOM OFFLINE - LIVE and
     ON AIR only ever mean a video stream is playing */
  .hm .pill.chat { background: #10240f; border: 1px solid #2f6d3a; color: #c9f2cf; }
  .hm .pill.chat .dot { display: none; }

  /* ── you ── */
  .hm .me { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 10px 16px; align-items: center; background: linear-gradient(90deg, #121a13, #111 60%); }
  .hm .me .pic { display: flex; gap: 8px; align-items: center; }
  .hm .me .ava { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; border: 3px solid var(--green); background: #0d0d0d; display: block; }
  .hm .me .gtf { width: 52px; height: 52px; border-radius: 10px; overflow: hidden; background: repeating-conic-gradient(#151515 0% 25%, #101010 0% 50%) 50% / 14px 14px; display: grid; place-items: center; }
  .hm .me .gtf svg { width: 48px; height: 48px; image-rendering: pixelated; shape-rendering: crispEdges; }
  .hm .me .who { min-width: 0; display: grid; gap: 5px; }
  .hm .me .top { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline; font-size: 13.5px; color: #bbb; }
  .hm .me .top .nm { font-size: 17px; font-weight: bold; color: #fff; overflow-wrap: anywhere; }
  .hm .me .top b { color: #fff; font-variant-numeric: tabular-nums; }
  .hm .lvl { height: 8px; background: #1c1c1c; border-radius: 999px; overflow: hidden; max-width: 380px; }
  .hm .lvl span { display: block; height: 100%; background: linear-gradient(90deg, #4caf50, #c6e94f); border-radius: 999px; }
  .hm .chips { display: flex; flex-wrap: wrap; gap: 5px; }
  .hm .chip { font-size: 12px; padding: 3px 9px; border-radius: 999px; border: 1px solid #2c3a2d; background: #0f1a10; color: #b9d8bb !important; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .chip.warm { border-color: #6b5a20; background: #1d1a0f; color: #e8d9a0 !important; }
  .hm .chip.mic { border-color: #2f6d3a; background: #12301a; color: #c9f2cf !important; }
  .hm .me .acts { display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; }
  .hm .me .acts .btn { padding: 7px 11px; font-size: 13px; }

  /* ── room + live now ── */
  .hm .main { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: var(--cardgap); align-items: start; }
  .hm .hm-aside { display: grid; gap: var(--cardgap); align-content: start; min-width: 0; }
  /* 1.99dw: no dead space under the room card - on desktop it stretches to the right column's height and the
     chat log takes the extra room (380 px minimum, scrolls as before) */
  @media (min-width: 1101px) {
    .hm .main { align-items: stretch; }
    .hm .main > .lr-card { display: flex; flex-direction: column; }
    .hm .lr-card > .lr { flex: 1 1 auto; min-height: 0; }
    .hm .lr-card .lr-log { display: flex; flex-direction: column; min-height: 0; }
    .hm .lr-card .lr-log > * { flex: none; }
    .hm .lr-card .lr-log > .lr-feed { flex: 1 1 380px; height: auto; min-height: 380px; }
    .hm .lr-card > .tease { flex: 1 1 auto; align-content: center; }
  }
  .hm .lr { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 12px; }
  .hm .lr-feed { display: flex; flex-direction: column; gap: 2px; height: 380px; overflow-y: auto; overscroll-behavior: contain; padding-right: 4px; }
  .hm .ln { font-size: 14px; line-height: 1.45; overflow-wrap: anywhere; padding: 3px 6px; border-radius: 6px; }
  .hm .ln:hover { background: #161616; }
  .hm .ln .w { font-weight: bold; margin-right: 6px; }
  .hm .ln a.w { color: inherit; text-decoration: none; } .hm .ln a.w:hover { text-decoration: underline; }
  .hm .ln .t { color: #666; font-size: 11px; margin-left: 4px; }
  .hm .ln.sys { color: #8a8a8a; font-size: 12.5px; }
  .hm .ln.pepe { background: #0f1a10; }
  .hm .ln.tx { border-left: 3px solid #4f7fa8; background: #0f141b; font-style: italic; color: #c8d6e5; }
  .hm .ln.tx .w { font-style: normal; }
  .hm .ln.tx .w::before { content: "🎙 "; }
  .hm .lr-side { display: grid; gap: 8px; align-content: start; min-width: 0; }
  .hm .ro { font-size: 12px; color: #9fb3c8; margin-top: 6px; }
  .hm .listen { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .hm .listen .btn { padding: 6px 10px; font-size: 12.5px; }
  .hm .tease { display: grid; gap: 10px; justify-items: start; }
  .hm .now { display: grid; gap: 8px; }
  /* 1.99ci: Hot on PATV (the mini feed) */
  .hm .hh h2 { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .hm .hh-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .hm .hh-it { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 10px; align-items: center; background: #0d0d0d; border: 1px solid #1c1c1c; border-radius: 10px; padding: 6px 8px 6px 6px; color: #ddd !important; }
  .hm .hh-it:hover { border-color: #2f5a34; }
  .hm .hh-th { width: 52px; height: 52px; border-radius: 8px; background: #1a1a1a center / cover no-repeat; display: grid; place-items: center; font-size: 20px; }
  .hm .hh-t { display: grid; gap: 2px; min-width: 0; }
  .hm .hh-t b.hh-fb { font-weight: 500; color: #b8b8b8; }      /* 1.99ex: a fallback label (postlabel.js), not a title */
  .hm .hh-t b { font-size: 13.5px; line-height: 1.3; color: #f0f0f0; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow-wrap: anywhere; }
  .hm .hh-c { font-size: 11.5px; color: #8fbf92; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .hh-m { display: flex; gap: 10px; font-size: 11.5px; color: #8d918d; font-variant-numeric: tabular-nums; }
  .hm .hh-n { font-size: 10px; font-weight: bold; color: #ff8a80; border: 1px solid #5a2222; border-radius: 4px; padding: 0 4px; }
  .hm .now a.it { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; gap: 8px; align-items: center; background: #0d0d0d; border: 1px solid #1c1c1c; border-radius: 10px; padding: 7px 10px; color: #ddd !important; font-size: 13.5px; }
  .hm .now a.it:hover { border-color: #2f5a34; }
  .hm .now .q { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .now .v { color: var(--gold); font-size: 12.5px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .hm .top5 { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .hm .top5 li { display: grid; grid-template-columns: 18px 26px minmax(0, 1fr) auto; gap: 8px; align-items: center; font-size: 13.5px; }
  .hm .top5 .rk { color: var(--muted); text-align: center; font-variant-numeric: tabular-nums; }
  .hm .top5 img { width: 26px; height: 26px; border-radius: 50%; object-fit: cover; background: #1c1c1c; display: block; }
  .hm .top5 .n { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #e6e6e6; }
  .hm .top5 .p { color: var(--gold); font-size: 12.5px; white-space: nowrap; }

  /* ── things to do ── */
  .hm .todo { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 8px; }
  .hm .todo a { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 0 8px; align-items: center; background: #0d0d0d; border: 1px solid #1c1c1c; border-radius: 10px; padding: 8px 10px; color: #e6e6e6 !important; font-size: 14px; position: relative; }
  .hm .todo a:hover, .hm .todo a:focus-visible { border-color: #2f5a34; }
  .hm .todo .i { font-size: 18px; grid-row: span 2; text-align: center; }
  .hm .todo b { font-size: 13.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .todo small { color: var(--muted); font-size: 11.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .todo a.hot { border-color: #3a5a2a; }
  .hm .todo a.hot small { color: #9ccc65; }
  .hm .todo .tag { position: absolute; top: -7px; right: 8px; font-size: 10px; padding: 1px 7px; border-radius: 999px; background: #6b5a20; color: #fff3c4; font-weight: bold; }
  /* 1.99dw: five equal cards, one baseline; #1 is highlighted by border + background only */
  .hm .tf { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; align-items: stretch; }
  .hm .tf li { display: grid; min-width: 0; }
  .hm .tf a { display: grid; grid-template-rows: auto auto auto auto; align-content: start; justify-items: center; gap: 4px; text-align: center; background: #0d0d0d; border: 1px solid #1c1c1c; border-radius: 12px; padding: 14px 8px 12px; color: #e6e6e6 !important; position: relative; min-width: 0; }
  .hm .tf a:hover, .hm .tf a:focus-visible { border-color: #2f5a34; }
  .hm .tf .r1 a { border-color: #6b5a20; background: linear-gradient(180deg, #2a2410, #0d0d0d 70%); }
  .hm .tf .r2 a { border-color: #4a4f55; }
  .hm .tf .r3 a { border-color: #5a4330; }
  .hm .tf .rk { position: absolute; top: 6px; left: 8px; font-family: 'Press Start 2P', monospace; font-size: 11px; color: var(--muted); }
  .hm .tf .r1 .rk { color: #ffd700; } .hm .tf .r2 .rk { color: #cfd8dc; } .hm .tf .r3 .rk { color: #d7a46b; }
  .hm .tf .av { width: 88px; height: 88px; border-radius: 12px; overflow: hidden; display: grid; place-items: center; background: repeating-conic-gradient(#151515 0% 25%, #101010 0% 50%) 50% / 16px 16px; }
  .hm .tf .av svg { width: 100%; height: 100%; image-rendering: pixelated; shape-rendering: crispEdges; }
  .hm .tf .av img { width: 70%; height: 70%; border-radius: 50%; object-fit: cover; }
  .hm .tf .nm { font-weight: bold; font-size: 14px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hm .tf .pt { color: var(--gold); font-size: 13px; font-variant-numeric: tabular-nums; }
  .hm .tf .lv { color: var(--muted); font-size: 12px; }
  .hm .pitch { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px 16px; align-items: center; }
  .hm .pitch p { margin: 0; color: #c9d3c9; font-size: 14.5px; line-height: 1.5; }
  .hm h2 .h2r { display: inline-flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .hm h2 .h2r small { color: var(--muted); }
  /* 1.99dw: the admin Pepe control panel (partials/pepe-control) is a card like the rest */
  .hm .pc { background: var(--card); border-color: var(--line); }
  .hm .pc > summary { padding: var(--py) var(--px); }
  .hm .pc .pc-body { padding: 0 var(--px) var(--py); }
  .hm code { background: #1c1c1c; padding: 1px 5px; border-radius: 4px; }

  @media (max-width: 1100px) {
    .hm .stage-body { grid-template-columns: minmax(0, 1fr); }
    .hm .stage-side { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    .hm .main { grid-template-columns: minmax(0, 1fr); }
    .hm .tf { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .hm .lr { grid-template-columns: minmax(0, 1fr); }
    .hm .me { grid-template-columns: auto minmax(0, 1fr); }
    .hm .me .acts { grid-column: 1 / -1; justify-content: flex-start; }
    .hm .stage-main { max-width: none; }
  }
  @media (max-width: 520px) {
    .hm { padding: 10px 10px 44px; --cardgap: 12px; --px: 12px; --py: 12px; --gap: 10px; }
    .hm .me .gtf { display: none; }
    .hm .lr-feed { height: 300px; }
    .hm .todo { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* top frogs: one row each (same size for all five) */
    .hm .tf { grid-template-columns: minmax(0, 1fr); gap: 6px; }
    .hm .tf a { grid-template-columns: 56px minmax(0, 1fr) auto; grid-template-rows: auto auto; justify-items: start; align-items: center; gap: 0 12px; text-align: left; padding: 8px 12px 8px 34px; }
    .hm .tf .rk { top: 50%; left: 10px; transform: translateY(-50%); }
    .hm .tf .av { width: 56px; height: 56px; grid-row: 1 / span 2; border-radius: 10px; }
    .hm .tf .nm { grid-column: 2; }
    .hm .tf .pt { grid-column: 3; grid-row: 1 / span 2; }
    .hm .tf .lv { grid-column: 2; grid-row: 2; }
    .hm .pitch { grid-template-columns: minmax(0, 1fr); }
  }
  /* paid stage slots (1.99al): which stream the stage shows */
  .hm .stabs { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 var(--px) var(--gap); align-items: center; }
  .hm .stabs:empty { display: none; }
  .hm .stab { display: inline-flex; align-items: center; gap: 6px; max-width: 100%; padding: 5px 11px; border-radius: 999px; border: 1px solid #2b2b2b;
              background: #141414; color: #cfd8cf; font: inherit; font-size: 13px; cursor: pointer; min-width: 0; }
  .hm .stab span.n { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: bold; }
  .hm .stab[aria-selected="true"] { border-color: var(--lime); background: #1b2a12; color: #fff; }
  .hm .stab:focus-visible { outline: 2px solid var(--lime); outline-offset: 2px; }
  .hm .stab .dot { flex: none; }
  .hm .stab.off .dot { background: #666; animation: none; }
  .hm .stabs .adm { display: inline-flex; gap: 6px; margin-left: auto; }
  /* 1.99fv: subtle extras next to Pepe's tab - "Watch on Twitch" (info + link) / his own stream vs an admin embed */
  .hm .stabs .stx { padding: 4px 9px; border-radius: 999px; border: 1px solid #2b2b2b; background: transparent; color: #a99bc9; font: inherit; font-size: 12px; cursor: pointer; text-decoration: none; }
  .hm .stabs .stx:hover, .hm .stabs .stx:focus-visible { border-color: #6b4fa8; color: #e4dcf5; }
  .hm .stabs .adm button { padding: 5px 10px; border-radius: 8px; border: 1px solid #5a2222; background: #2a1010; color: #ffb4b4; font: inherit; font-size: 12.5px; font-weight: bold; cursor: pointer; }
  .hm .stabs .adm button:hover { border-color: #ff5252; }
  @media (max-width: 520px) { .hm .stabs .adm { margin-left: 0; } }
  @media (prefers-reduced-motion: reduce) { .hm .dot { animation: none; } }
  /* 1.99bi: room stages - featured star, embeds, the Go live call to action */
  .hm .stab .star { color: var(--gold); }
  .hm .stab .src { font-size: 11px; color: #9fb3c8; border: 1px solid #2a3442; border-radius: 999px; padding: 0 6px; }
  .hm .stab.feat { border-color: #6b5a20; }
  .hm .stabs .adm button.feat { border-color: #6b5a20; background: #1d1a0f; color: #e8d9a0; }
  .hm .player .embed { position: absolute; inset: 0; z-index: 2; background: #000; }
  .hm .player .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .hm .golive-btn { display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px; border-radius: 999px; font-weight: bold; font-size: 13.5px;
                    background: linear-gradient(90deg, #e53935, #ff7043); color: #fff !important; border: 0; white-space: nowrap; box-shadow: 0 0 0 0 rgba(229,57,53,.5); }
  .hm .golive-btn:hover { filter: brightness(1.08); color: #fff !important; }
  .hm .golive { display: grid; gap: 8px; }
  .hm .golive p { margin: 0; color: #c9d3c9; font-size: 13.5px; line-height: 1.5; }
  .hm .golive .row { display: flex; flex-wrap: wrap; gap: 6px; }
  .hm .golive ul { margin: 0; padding-left: 18px; color: #aab3aa; font-size: 12.5px; line-height: 1.55; }
  /* 1.99es: two zones - the one line, then the buttons (the bullet list is gone) */
  .hm .golive-wide { grid-template-columns: minmax(0, 1fr) auto; gap: 8px 22px; align-items: center; }
  .hm .golive-wide .gl-txt { display: grid; gap: 4px; min-width: 0; }
  .hm .golive-wide h3 { margin: 0; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .hm .golive-wide .row { justify-content: flex-end; align-items: center; }
  .hm .golive-wide .row .btn { padding: 7px 12px; font-size: 13px; border-radius: 999px; }
  @media (max-width: 760px) { .hm .golive-wide { grid-template-columns: minmax(0, 1fr); } .hm .golive-wide .row { justify-content: flex-start; } }
  .hm .stage .bar .room-on { color: #fff; font-weight: bold; }
  .hm .guide-mini { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .hm .guide-mini a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 8px; color: #ddd !important; font-size: 13px; }
  .hm .guide-mini .n { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: bold; }
  .hm .guide-mini .w { grid-column: 1 / -1; color: #9aa59a; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* 1.99ds: the story strip is a card like the others */
  .hm .hm-stories { padding-bottom: 6px; }
  .hm .hm-stories .ss { margin: 0; }
  .hm .hm-stories .ss-h { margin: 0 0 6px; }
  .hm .hm-stories .ss-row { padding: 4px 0 8px; }
</style>

<main class="hm">
  <% if (typeof story !== 'undefined' && story && (story.rooms.length || story.compose)) { %><div class="card hm-stories"><%- include('partials/story-strip', { story, heading: '📸 Stories from the pads', next: '/' }) %></div><% } %>

  <!-- ───── your show (1.99ds: its own card above the stage; the stage header no longer repeats these links) ───── -->
  <section class="card golive golive-wide" id="stageShow" aria-labelledby="gsH">
    <div class="gl-txt">
      <h3 id="gsH">🎥 Your show on PATV</h3>
      <p><b>Anyone can go live.</b> Stream to a pad's stage from OBS or your browser, or put a YouTube / Twitch link on it.</p>
    </div>
    <div class="row"><a class="golive-btn" href="/stage<%= frontInfo ? '?room=' + encodeURIComponent(frontInfo.slug) : '' %>">🎥 Go live</a><a class="btn" href="/p">Pads</a></div>
  </section>

  <!-- ───── main stage ───── -->
  <section class="stage <%= live ? 'live' : 'off' %>" id="stage" aria-labelledby="stTtl">
    <div class="bar">
      <span class="ttl" id="stTtl">📺 MAIN STAGE</span>
      <span class="pill <%= live ? 'on' : 'off' %>" id="stPill"><span class="dot" aria-hidden="true"></span><span id="stPillTxt"><%= live ? 'ON AIR' : 'OFF AIR' %></span></span>
      <% if (frontInfo) { %><span class="sub" id="stRoom">📡 <a class="room-on" href="/p/<%= encodeURIComponent(frontInfo.slug) %>"><%= frontInfo.title %></a></span><%- BM(frontInfo.boost, 'bm') %><% } %>
      <%# the subtitle only shows while off air (the ON AIR pill says it otherwise); setPill() still writes it %>
      <span class="sub" id="stSub"><%= live ? (st.since ? 'on air for ' + ago(st.since).replace(' ago', '') : 'live now') : (st.ended ? 'last on air ' + ago(st.ended) : 'nothing streaming right now') %></span>
    </div>
    <% if (stageAdmin) { %>
    <%# 1.99ds: every admin-only control in one collapsible strip (collapsed by default, remembered per browser) %>
    <details class="stage-adm" id="stAdmBox">
      <summary><span class="gear" aria-hidden="true">⚙</span> Admin <span class="muted">· front page: <%= frontInfo ? frontInfo.title : '—' %> (<%= stageAdmin.front === 'auto' ? 'auto pick' : 'pinned' %>)</span></summary>
      <form class="stage-admin" id="stAdmin" autocomplete="off">
        <div class="sa-row">
          <label for="stRoomSel">Front-page pad</label>
          <select id="stRoomSel">
            <option value="auto"<%= stageAdmin.front === 'auto' ? ' selected' : '' %>>Automatic (most active pad, switches at most every <%= stageAdmin.status && stageAdmin.status.cfg ? stageAdmin.status.cfg.hold_min : 30 %> min)</option>
            <% (stageAdmin.rooms || []).forEach((r) => { %><option value="<%= r.id %>"<%= stageAdmin.front === r.id ? ' selected' : '' %>><%= r.title %><%= r.title !== r.id ? ' (' + r.id + ')' : '' %></option><% }) %>
          </select>
          <button type="submit" class="btn">Feature on the homepage</button>
          <span id="stAdminMsg" aria-live="polite"></span>
          <a class="sa-link" href="/pads/admin">Pads admin ›</a>
        </div>
        <%- include('partials/front-pick', { fp: stageAdmin.status, open: false }) %>
      </form>
    </details>
    <script>
      (function () {
        var d = document.getElementById('stAdmBox'), K = 'patv.home.adminOpen';
        try { if (localStorage.getItem(K) === '1') d.open = true; } catch (e) {}
        d.addEventListener('toggle', function () { try { localStorage.setItem(K, d.open ? '1' : '0'); } catch (e) {} });
      })();
    </script>
    <% } %>
    <div class="stabs" id="stTabs" role="tablist" aria-label="Stage streams"></div>
    <div class="stage-body">
      <%# 1.99ds: the player and its Snap / Clip row share one column, so the row sits under the video at its width %>
      <div class="stage-main">
        <div class="player" id="player">
          <div id="videoWrapper"></div>
          <div class="reconnect hide" id="stReconnect" role="status"><span class="dot" aria-hidden="true"></span> Stream is starting / reconnecting…</div>
          <button type="button" class="unmute hide" id="stUnmute" aria-label="Unmute the stream"><img src="/public/img/mute-icon.png" alt=""></button>
          <div class="embed hide" id="stEmbed"></div>
          <%# 1.99eo: the off-air slate - the player's own 16:9 box, so the layout never collapses; .stage.live hides it %>
          <div class="slate" id="stSlate" role="status" aria-label="The stage is off air">
            <div class="sl-in">
              <div class="sl-pad"><span class="pill off"><span class="dot" aria-hidden="true"></span>OFF AIR</span><b id="slPad"><%= frontInfo ? frontInfo.title : 'Main Stage' %></b></div>
              <p class="sl-msg">Nothing on stage right now</p>
              <div class="sl-acts">
                <a class="golive-btn" href="/stage<%= frontInfo ? '?room=' + encodeURIComponent(frontInfo.slug) : '' %>">🎥 Go live</a>
                <% if (nextUp_) { %><span class="sl-next" id="slNext">Next up: <b><%= nextUp_.display %></b><%= nextUp_.title ? ' · ' + nextUp_.title : '' %> · <time datetime="<%= new Date(nextUp_.start_at).toISOString() %>" data-local-time="<%= Number(nextUp_.start_at) %>"><%= new Date(nextUp_.start_at).toISOString().slice(11, 16) %> UTC</time></span>
                <% } else { %><a class="btn" href="/p" id="slBrowse">Browse Top Pads</a><% } %>
              </div>
            </div>
          </div>
        </div>
        <div class="stcap hide" id="stCap" aria-label="Snap or clip this stream"></div>
      </div>
      <%# 1.99eo: the stage widgets sit in the side column on and off air (they used to move to an off-air strip) %>
      <div class="stage-side" id="stageSide">
      <div class="aw aw-hm" id="wheelBox">
        <% if (me) { %>
        <div class="aw-coinop" id="coinop">
          <div class="aw-credit" aria-hidden="true"><span>CREDIT</span><span class="n" id="creditCount">00</span></div>
          <div class="aw-hm-row">
            <div class="aw-door">
              <div class="aw-plate"><span class="p">5000</span><span class="u">PAT</span><span class="ins">STAGE WHEEL</span></div>
              <div class="aw-slot-area">
                <div class="aw-dropclip" id="dropClip"><div class="aw-coin aw-flycoin" id="clipCoin" aria-hidden="true">PAT</div></div>
                <div class="aw-slot" id="coinSlot" aria-hidden="true"></div>
              </div>
