<%- include('layout', { title: 'Wagers & Pools', user: user}) %>
<style>
  .wg { max-width: 980px; margin: 0 auto; padding: 0 16px 48px; font-family: Ubuntu, sans-serif; overflow-wrap: anywhere; }
  .wg a { color: #81c784; }
  .wg h1 { text-align: center; margin-bottom: 4px; }
  .wg .sub { text-align: center; color: #9a9; margin: 0 0 18px; }
  .wg h2 { color: #ffd700; font-family: 'Press Start 2P', monospace; font-size: 12px; margin: 28px 0 10px; line-height: 1.6; }
  .wg .explain { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
  .wg .explain div { background: #0d0d0d; border: 1px solid #222; border-radius: 10px; padding: 12px 14px; color: #bbb; font-size: 13px; line-height: 1.55; }
  .wg .explain b { color: #fff; }
  .wg .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 12px; }
  .wg .card { background: #111; border: 1px solid #222; border-radius: 10px; padding: 14px 16px; display: grid; gap: 8px; align-content: start; min-width: 0; }
  .wg .card.mine { border-color: #4caf50; }
  .wg .card.offer { border-color: #ffd700; }
  .wg .ref { color: #e0a030; font-family: monospace; font-size: 13px; }
  .wg .vs { font-weight: bold; color: #fff; font-size: 15px; }
  .wg .terms { color: #ddd; font-size: 14px; line-height: 1.4; }
  .wg .pot { font-size: 20px; font-weight: bold; color: #ffd700; font-variant-numeric: tabular-nums; }
  .wg .info { color: #888; font-size: 13px; line-height: 1.6; }
  .wg .pill { font-size: 11px; padding: 2px 8px; border-radius: 10px; border: 1px solid #333; color: #ccc; display: inline-block; }
  .wg .pill.won { border-color: #4caf50; color: #81c784; }
  .wg .pill.late { border-color: #e57373; color: #e57373; }
  .wg .empty { color: #888; }
  .wg .opts { display: grid; gap: 6px; }
  .wg .opt { display: grid; grid-template-columns: minmax(60px, 120px) 1fr auto; gap: 8px; align-items: center; font-size: 13px; }
  .wg .opt .nm { color: #ddd; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wg .bar { height: 10px; background: #1c1c1c; border-radius: 5px; overflow: hidden; }
  .wg .bar span { display: block; height: 100%; background: #4caf50; }
  .wg .opt.won .bar span { background: #ffd700; }
  .wg .num { color: #ccc; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .wg .ai { background: #0e1420; border: 1px solid #2a3a5a; border-radius: 8px; padding: 8px 10px; font-size: 13px; display: grid; gap: 6px; color: #cfd8e8; }
  .wg .ai .who { color: #90caf9; font-weight: bold; }
  .wg .ai .call { color: #fff; }
  .wg .ai .reason { color: #aab; font-style: italic; }
  .wg .ai ul { margin: 0; padding-left: 18px; color: #aab; }
  .wg form { display: grid; gap: 8px; margin: 0; }
  .wg form.inline { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .wg .forms { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
  .wg .forms > form { background: #111; border: 1px solid #222; border-radius: 10px; padding: 14px; align-content: start; }
  .wg input[type=number], .wg input[type=text], .wg select { background: #0d0d0d; color: #eee; border: 1px solid #333; border-radius: 6px; padding: 7px 9px; box-sizing: border-box; max-width: 100%; font: inherit; font-size: 14px; }
  .wg .forms input[type=text], .wg .forms input[type=number] { width: 100%; }
  .wg form.inline input[type=text], .wg form.inline input[type=number] { width: 120px; flex: 1 1 100px; }
  .wg button { background: #4caf50; color: #fff; border: 0; border-radius: 6px; padding: 8px 14px; font-weight: bold; cursor: pointer; font: inherit; font-weight: bold; }
  .wg button.alt { background: #333; color: #ddd; }
  .wg button.danger { background: #5a2a2a; color: #f2b8b8; }
  .wg button.judge { background: #e0a030; color: #111; }
  .wg button.blue { background: #3b6ea8; }
  .wg label { cursor: pointer; font-size: 13px; color: #ccc; }
  .wg .hint { background: #1d1a0f; border: 1px solid #6b5a20; border-radius: 8px; padding: 10px 12px; color: #e8d9a0; font-size: 14px; }
  .wg .tbl { overflow-x: auto; border: 1px solid #222; border-radius: 8px; }
  .wg table { width: 100%; border-collapse: collapse; font-size: 13px; font-variant-numeric: tabular-nums; }
  .wg th, .wg td { padding: 7px 10px; border-bottom: 1px solid #1c1c1c; text-align: left; vertical-align: top; overflow-wrap: normal; }
  .wg td { color: #ddd; }
  .wg th { color: #888; font-weight: normal; white-space: nowrap; }
  .wg td.r, .wg th.r { text-align: right; }
  .wg code { background: #1c1c1c; padding: 1px 5px; border-radius: 4px; }
</style>
<%
  const fmt = (n) => Math.round(Number(n) || 0).toLocaleString();
  const when = (ts) => ts ? new Date(ts * 1000).toISOString().slice(0, 16).replace('T', ' ') : '';
  const left = (t) => { const s = Math.max(0, Math.round(t - now)); return s >= 86400 ? Math.floor(s/86400) + 'd ' + Math.floor(s%86400/3600) + 'h' : s >= 3600 ? Math.floor(s/3600) + 'h ' + Math.floor(s%3600/60) + 'm' : s > 0 ? Math.max(1, Math.floor(s/60)) + 'm' : 'now'; };
  const cd = (t) => '<span data-until="' + Number(t) + '">' + left(t) + '</span>';
  const canAct = !!(signedIn && camfrog);
  const hidden = (cmd) => '<input type="hidden" name="kind" value="cmd"><input type="hidden" name="cmd" value="' + cmd + '"><input type="hidden" name="back" value="/wagers"><input type="hidden" name="tag" value="wagers">';
  const STATUS = { offered: 'waiting for accept', accepting: 'accepting…', active: 'live', settling: 'paying out…', won: 'won', void: 'void — refunded', expired: 'expired', declined: 'declined', cancelled: 'cancelled' };

  // The AI-judge box for a wager (cmd 'wager', ref W1) or pool (cmd 'pool', ref M1).
  const aiBox = (cmd, ref, x, inIt, live) => { const ai = x.ai || {}; const st = ai.state || null; %>
    <div class="ai">
      <span class="who">🤖 Pepe (AI judge, experimental)</span>
      <% if (st === 'thinking') { %><span>Pepe is reading the evidence…</span>
      <% } else if (st === 'unsure') { %><span>Pepe wasn't sure yet<%= ai.reason ? ':' : '.' %></span><% if (ai.reason) { %><span class="reason"><%= ai.reason %></span><% } %>
      <% } else if (st === 'proposed' || st === 'disputed') { %>
        <span class="call">His call: <b><%= ai.result %></b><%= ai.confidence ? ' (' + Math.round(ai.confidence * 100) + '% sure)' : '' %></span>
        <% if (ai.reason) { %><span class="reason"><%= ai.reason %></span><% } %>
        <% if (st === 'proposed' && ai.until) { %><span class="info">Final <%- ai.until > now ? 'in ' + cd(ai.until) : 'any moment now' %> unless someone in it disputes.</span><% } %>
        <% if (st === 'disputed') { %><span class="info">Disputed — the admins will look at it.</span><% } %>
        <% if (ai.disputes && ai.disputes.length) { %><ul><% ai.disputes.forEach((d) => { %><li><b><%= d.nick %></b>: <%= d.why %></li><% }) %></ul><% } %>
        <% if (st === 'proposed' && inIt && canAct && (!ai.until || ai.until > now)) { %>
          <form class="inline" method="post" action="/act"><%- hidden(cmd) %>
            <input type="hidden" name="a0" value="dispute"><input type="hidden" name="a1" value="<%= ref %>">
            <input type="text" name="a2" maxlength="200" placeholder="Why is that wrong?" required>
            <button class="danger" type="submit">Dispute</button>
          </form>
        <% } %>
      <% } else if (st === 'final' || st === 'done') { %><span class="call">Decided: <b><%= ai.result %></b></span><% if (ai.reason) { %><span class="reason"><%= ai.reason %></span><% } %>
      <% } else { %><span class="info">Pepe decides when it's time, or when someone in it asks.</span><% } %>
      <% if ((!st || st === 'unsure') && live && inIt && canAct) { %>
        <form class="inline" method="post" action="/act"><%- hidden(cmd) %>
          <input type="hidden" name="a0" value="ai"><input type="hidden" name="a1" value="<%= ref %>">
          <button class="blue" type="submit">Ask Pepe to decide now</button>
        </form>
      <% } %>
    </div>
  <% };

  const wagerCard = (w, offer) => { %>
    <div class="card<%= offer ? ' offer' : w.inIt ? ' mine' : '' %>">
      <span class="ref"><%= w.ref %> · <%= STATUS[w.status] || w.status %><%= w.room ? ' · ' + w.room : '' %></span>
      <span class="vs"><%= w.creator %> vs <%= w.opponent || 'anyone' %></span>
      <% if (w.terms) { %><span class="terms">“<%= w.terms %>”</span><% } %>
      <span class="pot"><%= fmt(w.amount) %> each · pot <%= fmt(w.pot) %> PAT</span>
      <span class="info">
        <% if (!w.ai_judge) { %>Judge: <b><%= w.judge || '—' %></b><br><% } %>
        <% if (w.status === 'offered' && w.offer_until) { %>Offer open for <%- cd(w.offer_until) %><br><% } %>
        <% if (w.deadline) { %><%- w.deadline > now ? 'Decided by ' + when(w.deadline) + ' UTC (' + cd(w.deadline) + ')' : 'Deadline passed ' + when(w.deadline) + ' UTC — waiting for the judge' %><br><% } %>
        Winner gets <%= fmt(w.payout) %> PAT
      </span>
      <% if (w.ai_judge) aiBox('wager', w.ref, w, w.inIt, w.status === 'active'); %>
      <% if (canAct) { %>
        <% if (offer) { %>
          <div class="row" style="display:flex;gap:8px;flex-wrap:wrap">
            <form class="inline" method="post" action="/act"><%- hidden('wager') %><input type="hidden" name="a0" value="accept"><input type="hidden" name="a1" value="<%= w.ref %>"><button type="submit">Accept — stake <%= fmt(w.amount) %></button></form>
            <form class="inline" method="post" action="/act"><%- hidden('wager') %><input type="hidden" name="a0" value="decline"><input type="hidden" name="a1" value="<%= w.ref %>"><button class="alt" type="submit">Decline</button></form>
          </div>
          <% if (bal !== null && bal < w.amount) { %><span class="info" style="color:#e57373">You have <%= fmt(bal) %> PAT — not enough to accept.</span><% } %>
        <% } %>
        <% if (w.isCreator && w.status === 'offered') { %>
          <form class="inline" method="post" action="/act"><%- hidden('wager') %><input type="hidden" name="a0" value="cancel"><input type="hidden" name="a1" value="<%= w.ref %>"><button class="danger" type="submit">Cancel my offer</button></form>
        <% } %>
        <% if (w.isJudge && w.status === 'active') { %>
          <form class="inline" method="post" action="/act"><%- hidden('wager') %><input type="hidden" name="a0" value="settle"><input type="hidden" name="a1" value="<%= w.ref %>">
            <select name="a2" required>
              <option value="">You're the judge — who won?</option>
              <option value="@<%= w.creator %>"><%= w.creator %></option>
              <% if (w.opponent) { %><option value="@<%= w.opponent %>"><%= w.opponent %></option><% } %>
              <option value="void">void (refund both)</option>
            </select>
            <button class="judge" type="submit">Settle</button>
          </form>
        <% } %>
      <% } %>
    </div>
  <% };

  const poolCard = (m) => { %>
    <div class="card<%= m.inIt ? ' mine' : '' %>">
      <span class="ref"><%= m.ref %> · <%= m.status === 'open' ? 'open — closes in ' : m.status === 'closed' ? 'closed — waiting for the judge' : m.status %><%- m.status === 'open' ? cd(m.closes) : '' %></span>
      <a class="vs" href="/markets/<%= m.id %>" style="color:#fff;text-decoration:none"><%= m.question %></a>
      <div class="opts">
        <% m.options.forEach((o) => { %>
          <div class="opt<%= o.won ? ' won' : '' %>"><span class="nm"><%= o.won ? '🏆 ' : '' %><%= o.name %></span>
            <span class="bar"><span style="width:<%= o.share %>%"></span></span>
            <span class="num"><%= o.share %>% · <%= o.mult ? o.mult.toFixed(2) + '×' : '—' %></span></div>
        <% }) %>
      </div>
      <span class="pot">Pot <%= fmt(m.total) %> PAT</span>
      <span class="info"><%= m.betCount %> bet<%= m.betCount === 1 ? '' : 's' %> from <%= m.bettors %><% if (!m.ai_judge) { %> · judge <b><%= m.judge %></b><% } %> · by <%= m.creator %>
        <% if (m.mine.length) { %><br>You: <%= m.mine.map((x) => fmt(x.amount) + ' on ' + x.option).join(', ') %><% } %></span>
      <% if (m.ai_judge) aiBox('pool', m.ref, m, m.inIt, m.status === 'open' || m.status === 'closed'); %>
      <% if (canAct && m.status === 'open' && m.closes > now) { %>
        <form class="inline" method="post" action="/act"><%- hidden('pool') %><input type="hidden" name="a0" value="<%= m.ref %>">
          <select name="a1" required><% m.options.forEach((o) => { %><option value="<%= o.name %>"><%= o.name %></option><% }) %></select>
          <input type="number" name="a2" min="<%= poolMin %>" step="1" placeholder="PAT (min <%= fmt(poolMin) %>)" required>
          <button type="submit">Bet</button>
        </form>
      <% } %>
      <a class="info" href="/markets/<%= m.id %>">Details & all bets ›</a>
    </div>
  <% };
%>
<div class="wg">
  <h1>Wagers &amp; Pools</h1>
  <p class="sub">Bet PAT against a friend, or open a pool the whole room can bet on.</p>
  <div class="explain">
    <div><b>Wager (1-on-1)</b> — you and your opponent each put up the same stake. The judge picks the winner, who takes the pot minus <%= feePct %>%. Your stake sits in escrow from the moment you offer it; if it isn't accepted it comes back.</div>
    <div><b>Betting pool</b> — anyone bets any amount on an option. When the judge settles it, the winners split the losing side's pot pro rata to their bets, minus <%= feePct %>%, and get their own stake back.</div>
  </div>

  <%- include('partials/actions', { acts, msg }) %>
  <% if (!signedIn) { %><p class="hint"><a href="/login">Sign in</a> to accept, bet and start wagers from here — or use <code>!wager</code> and <code>!pool</code> in a Camfrog room.</p>
  <% } else if (!camfrog) { %><p class="hint">Link your Camfrog name (<code>!verify</code>) to accept, bet and start wagers from here — Pepe runs them as you.</p>
  <% } else if (bal !== null) { %><p class="info" style="text-align:center">Signed in as <b><%= camfrog %></b> · <%= fmt(bal) %> PAT</p><% } %>

  <% if (offers.length) { %>
    <h2>OFFERS WAITING FOR YOU</h2>
    <div class="grid"><% offers.forEach((w) => wagerCard(w, true)) %></div>
  <% } %>

  <h2>LIVE WAGERS</h2>
  <% const liveShown = live.filter((w) => !offers.includes(w)); %>
  <% if (!liveShown.length) { %><p class="empty">No live 1-on-1 wagers right now.</p><% } %>
  <div class="grid"><% liveShown.forEach((w) => wagerCard(w, false)) %></div>

  <h2>LIVE BETTING POOLS</h2>
  <% if (!pools.length) { %><p class="empty">No open pools right now.</p><% } %>
  <div class="grid"><% pools.forEach((m) => poolCard(m)) %></div>

  <h2>START ONE</h2>
  <% if (canAct) { %>
    <div class="forms">
      <form method="post" action="/act" id="wf"><%- hidden('wager') %>
        <b>⚔️ Challenge someone</b>
        <input type="text" name="a0" maxlength="60" placeholder="Opponent's Camfrog name" required>
        <input type="number" name="a1" min="<%= wagerMin %>" step="1" placeholder="Stake each (min <%= fmt(wagerMin) %> PAT)" required>
        <input type="text" name="a2" maxlength="200" placeholder="Terms — e.g. Lakers win tonight" required>
        <input type="text" id="wf-judge" maxlength="60" placeholder="Judge's Camfrog name">
        <label><input type="checkbox" id="wf-ai"> 🤖 Let Pepe judge (AI, experimental)</label>
        <input type="hidden" name="a3" id="wf-a3">
        <label>Decided by <select name="a4">
          <option value="by 1h">1 hour</option><option value="by 1d">1 day</option><option value="by 2d" selected>2 days</option>
          <option value="by 7d">7 days</option><option value="by 30d">30 days</option></select></label>
        <button type="submit">Send challenge</button>
        <span class="info">Your stake goes into escrow now. The judge can't be you or your opponent.</span>
      </form>
      <form method="post" action="/act" id="pf"><%- hidden('pool') %>
        <b>🎲 Start a betting pool</b>
        <input type="hidden" name="a0" value="new">
        <input type="text" name="a1" maxlength="200" placeholder="Question — e.g. Will Brian cam tonight?" required>
        <input type="text" id="pf-opts" maxlength="200" placeholder="Options, split by / (blank = yes/no)">
        <input type="hidden" name="a2" id="pf-a2">
        <input type="text" id="pf-judge" maxlength="60" placeholder="Judge's Camfrog name">
        <label><input type="checkbox" id="pf-ai"> 🤖 Let Pepe judge (AI, experimental)</label>
        <input type="hidden" name="a3" id="pf-a3">
        <label>Betting closes in <select name="a4">
          <option value="closes 1h">1 hour</option><option value="closes 1d" selected>1 day</option><option value="closes 2d">2 days</option>
          <option value="closes 7d">7 days</option><option value="closes 30d">30 days</option></select></label>
        <button type="submit">Open pool</button>
        <span class="info">Minimum bet <%= fmt(poolMin) %> PAT. Up to 6 short options.</span>
      </form>
    </div>
    <script>
      (function () {
        const at = (s) => { s = String(s || '').trim().replace(/^@+/, ''); return s ? '@' + s : ''; };
        function judge(prefix) {
          const ai = document.getElementById(prefix + '-ai'), j = document.getElementById(prefix + '-judge');
          ai.addEventListener('change', () => { j.disabled = ai.checked; });
          return () => ai.checked ? 'judge @pepe' : (at(j.value) ? 'judge ' + at(j.value) : '');
        }
        const wj = judge('wf'), pj = judge('pf');
        document.getElementById('wf').addEventListener('submit', (e) => {
          const f = e.target; f.a0.value = at(f.a0.value); document.getElementById('wf-a3').value = wj();
        });
        document.getElementById('pf').addEventListener('submit', () => {
          const opts = document.getElementById('pf-opts').value.split(/[\/,|]/).map((s) => s.trim()).filter(Boolean);
          document.getElementById('pf-a2').value = opts.length >= 2 ? 'options ' + opts.join('/') : '';
          document.getElementById('pf-a3').value = pj();
        });
      })();
    </script>
  <% } else { %>
    <p class="info">In a Camfrog room: <code>!wager @bob 10k Lakers win judge @carol by 2d</code> · <code>!pool new Will it rain? judge @carol closes 1d</code></p>
  <% } %>

  <h2>RECENTLY SETTLED</h2>
  <% if (!doneW.length && !doneP.length) { %><p class="empty">Nothing settled yet.</p><% } %>
  <% if (doneW.length) { %>
    <div class="tbl"><table>
      <tr><th>Wager</th><th>Who</th><th>Terms</th><th class="r">Pot</th><th>Result</th><th>When (UTC)</th></tr>
      <% doneW.forEach((w) => { %>
        <tr><td class="ref"><%= w.ref %></td><td><%= w.creator %> vs <%= w.opponent %></td><td><%= w.terms %></td><td class="r"><%= fmt(w.pot) %></td>
          <td><%= w.status === 'won' ? '🏆 ' + w.winner : 'void — refunded' %><%= w.settled_by ? ' (' + (w.ai_judge && w.settled_by === w.judge ? '🤖 ' : '') + w.settled_by + ')' : '' %></td><td><%= when(w.ended) %></td></tr>
      <% }) %>
    </table></div>
  <% } %>
  <% if (doneP.length) { %>
    <div class="tbl" style="margin-top:12px"><table>
      <tr><th>Pool</th><th>Question</th><th class="r">Pot</th><th>Result</th><th>When (UTC)</th></tr>
      <% doneP.forEach((m) => { %>
        <tr><td><a href="/markets/<%= m.id %>"><%= m.ref %></a></td><td><%= m.question %></td><td class="r"><%= fmt(m.total) %></td>
          <td><%= m.status === 'settled' ? '🏆 ' + m.result : m.status === 'void' ? 'void — refunded' : m.status %><%= m.settled_by ? ' (' + m.settled_by + ')' : '' %></td><td><%= when(m.ended) %></td></tr>
      <% }) %>
    </table></div>
  <% } %>
</div>
<script>
  (function () {
    const fmt = (s) => s >= 86400 ? Math.floor(s/86400) + 'd ' + Math.floor(s%86400/3600) + 'h' : s >= 3600 ? Math.floor(s/3600) + 'h ' + Math.floor(s%3600/60) + 'm' : s >= 60 ? Math.floor(s/60) + 'm ' + (s%60) + 's' : s > 0 ? s + 's' : 'now';
    const tick = () => document.querySelectorAll('[data-until]').forEach((el) => { el.textContent = fmt(Math.max(0, Math.round(Number(el.dataset.until) - Date.now() / 1000))); });
    tick(); setInterval(tick, 1000);
  })();
</script>
</body>
</html>
