<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('wagers.title'), user: user}) %>
<%# views/wagers.ejs - 1.99ly design pass (bets.css): hero + how-it-works tiles, offers waiting for you first, wager cards
    (challenger VS opponent, the terms, the pot, a status chip, a live countdown with the time in the viewer's zone),
    pool cards with odds bars, the two start forms and the settled tables. Every form posts the same /act command. %>
<link rel="stylesheet" href="/public/css/bets.css?v=3">
<script src="/public/js/bets.js?v=2" defer></script>
<style>
  /* 1.99pp: the wagers & pools amber accent, set with the ds names (bets.css aliases --ac* to them) */
  .wg { --ds-ac: var(--ds-acc-wagers); --ds-ac-2: var(--ds-acc-wagers-2); --ds-ac-bg: rgba(224, 160, 48, .14); --ds-ac-line: var(--ds-warn-line); --ds-on-ac: #1a1200; }
  .wg .explain { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 12px; margin-top: 16px; }
  .wg .explain > div { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 4px 12px; align-items: start; padding: var(--ds-sp-3h) var(--ds-sp-4); border-radius: var(--ds-r-xl); background: var(--ds-glass); border: 1px solid var(--ds-line); color: var(--ds-text-2); font-size: var(--ds-fs-sm); line-height: 1.55; }
  .wg .explain .ic { grid-row: span 2; font-size: 28px; line-height: 1; }
  .wg .explain b { color: var(--ds-text-strong); font-size: 15px; }
  .wg .card.mine { border-color: var(--ds-ok-line); }
  .wg .card.offer { border-color: var(--gold); box-shadow: 0 0 0 1px var(--gold) inset, 0 8px 30px rgba(255, 215, 64, .12); background: linear-gradient(180deg, rgba(255, 215, 64, .07), var(--card) 45%); }
  .wg .vs { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 8px; padding: 10px; border-radius: var(--ds-r-lg); background: var(--ds-sunken); border: 1px solid var(--ds-line-soft); }
  .wg .vs .p { min-width: 0; text-align: center; font-weight: 700; color: var(--ds-text-strong); font-size: 15px; overflow-wrap: anywhere; }
  .wg .vs .x { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--ds-ac); color: var(--ds-on-ac); font: 700 12px/1 var(--ds-font); }
  .wg .vs .p.win { color: var(--goldt); }
  .wg .terms { margin: 0; color: var(--ds-text); font-size: 15px; line-height: 1.45; font-style: italic; }
  .wg .pot { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 10px; }
  .wg .pot .bx-big small { font-size: var(--ds-fs-xs); }
  .wg .pot .each { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); }
  .wg .cd { color: var(--ac2); font-weight: 700; font-variant-numeric: tabular-nums; }
  .wg .info { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); line-height: 1.6; }
  .wg .info b { color: var(--ds-text); }
  .wg .ai { background: var(--ds-info-bg); border: 1px solid var(--ds-info-line); border-radius: var(--ds-r-lg); padding: var(--ds-sp-2h) var(--ds-sp-3); font-size: 13.5px; display: grid; gap: 6px; color: var(--ds-info-ink); }
  .wg .ai .who { color: var(--ds-info); font-weight: 700; }
  .wg .ai .call { color: var(--ds-text-strong); }
  .wg .ai .reason { color: var(--ds-text-muted); font-style: italic; }
  .wg .ai ul { margin: 0; padding-inline-start: 18px; color: var(--ds-text-muted); }
  .wg form.inline { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0; }
  .wg form.inline .bx-in { flex: 1 1 140px; width: auto; }
  .wg .acts { display: flex; flex-wrap: wrap; gap: 8px; }
  .wg .opts { display: grid; gap: 8px; }
  .wg .opt { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 10px; align-items: baseline; font-size: var(--ds-fs-sm); }
  .wg .opt .nm { color: var(--ds-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wg .opt .bar { grid-column: 1 / -1; height: 8px; border-radius: var(--ds-r-pill); background: #1f1f1f; overflow: hidden; }
  .wg .opt .bar span { display: block; height: 100%; background: var(--ac); border-radius: inherit; }
  .wg .opt.won .bar span { background: var(--gold); }
  .wg .opt .num { color: var(--ds-text-2); font-size: var(--ds-fs-meta); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .wg .q { color: var(--ds-text-strong); text-decoration: none; font-weight: 700; font-size: 16px; line-height: 1.35; }
  .wg .forms { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 12px; }
  .wg .forms > form { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-5); align-content: start; }
  .wg .bad { color: var(--red); font-size: var(--ds-fs-meta); }
  .wg .tbl td.ref { color: var(--ac2); font-family: var(--ds-font-mono); }
  .wg .tbl td.wrap { white-space: normal; min-width: 180px; }
  .wg .tbl td { white-space: nowrap; }
</style>
<%
  const fmt = (n) => t.num(Math.round(Number(n) || 0));
  // 1.99ly: times in the viewer's zone with its label (tz.js), as <time> tags
  const tzT = locals.tzTime || new Function(include('../tz-core.js'))()('UTC', 'en').time;
  const when = (ts) => ts ? tzT(ts, 'datetime') : '';
  const left = (tt) => { const s = Math.max(0, Math.round(tt - now)); return s >= 86400 ? t('bx.dur.dh', { d: Math.floor(s / 86400), h: Math.floor(s % 86400 / 3600) }) : s >= 3600 ? t('bx.dur.hm', { h: Math.floor(s / 3600), m: Math.floor(s % 3600 / 60) }) : s > 0 ? t('bx.dur.m', { m: Math.max(1, Math.floor(s / 60)) }) : t('wagers.now'); };
  const cd = (tt) => '<span class="cd" data-until="' + Number(tt) + '">' + left(tt) + '</span>';
  // 1.99wr (connections audit A): wagers / pools run by account on the site while their escrow game is live there (the
  // username is the player); otherwise Pepe runs them as the linked chat login
  const canWager = !!(signedIn && (camfrog || locals.wagersLive));
  const canPool = !!(signedIn && (camfrog || locals.poolsLive));
  const hidden = (cmd) => '<input type="hidden" name="kind" value="cmd"><input type="hidden" name="cmd" value="' + cmd + '"><input type="hidden" name="back" value="/wagers"><input type="hidden" name="tag" value="wagers">';
  const ST = { offered: ['waiting', 'wagers.st.offered'], accepting: ['accepting', 'wagers.st.accepting'], active: ['open', 'wagers.st.active'], settling: ['settling', 'wagers.st.settling'],
               won: ['won', 'wagers.st.won'], void: ['void', 'wagers.st.void'], expired: ['expired', 'wagers.st.expired'], declined: ['declined', 'wagers.st.declined'], cancelled: ['cancelled', 'wagers.st.cancelled'] };
  const chip = (s) => ST[s] ? '<span class="bx-chip c-' + ST[s][0] + '">' + t(ST[s][1]) + '</span>' : '<span class="bx-chip">' + t.esc(s) + '</span>';

  // The AI-judge box for a wager (cmd 'wager', ref W1) or pool (cmd 'pool', ref M1).
  const aiBox = (cmd, ref, x, inIt, live) => { const ai = x.ai || {}; const st = ai.state || null; %>
    <div class="ai">
      <span class="who"><span class="ds-ic" aria-hidden="true">🤖</span> <%- t('wagers.ai.who') %></span>
      <% if (st === 'thinking') { %><span><%- t('wagers.ai.thinking') %></span>
      <% } else if (st === 'unsure') { %><span><%- ai.reason ? t('wagers.ai.unsure_why') : t('wagers.ai.unsure') %></span><% if (ai.reason) { %><span class="reason"><%= ai.reason %></span><% } %>
        <% if (ai.evidence) { %><span class="info"><span class="ds-ic" aria-hidden="true">📈</span> <%= ai.evidence %></span><% } %>
        <% if (ai.escalated) { %><span class="info"><%- t('wagers.ai.escalated') %></span>
        <% } else if (ai.next_try && ai.next_try > now) { %><span class="info"><%- t('wagers.ai.again', { when: tzT(ai.next_try, 'time'), left: cd(ai.next_try) }) %></span><% } %>
      <% } else if (st === 'proposed' || st === 'disputed') { %>
        <span class="call"><%- t('wagers.ai.call', { result: ai.result }) %><%= ai.confidence ? ' (' + Math.round(ai.confidence * 100) + '%)' : '' %></span>
        <% if (ai.reason) { %><span class="reason"><%= ai.reason %></span><% } %>
        <% if (st === 'proposed' && ai.until) { %><span class="info"><%- ai.until > now ? t('wagers.ai.final_in', { left: cd(ai.until) }) : t('wagers.ai.final_soon') %></span><% } %>
        <% if (st === 'disputed') { %><span class="info"><%- t('wagers.ai.disputed') %></span><% } %>
        <% if (ai.disputes && ai.disputes.length) { %><ul><% ai.disputes.forEach((d) => { %><li><b><%- ul(d.nick) %></b>: <%= d.why %></li><% }) %></ul><% } %>
        <% if (st === 'proposed' && inIt && (cmd === 'pool' ? canPool : canWager) && (!ai.until || ai.until > now)) { %>
          <form class="inline" method="post" action="/act"><%- hidden(cmd) %>
            <input type="hidden" name="a0" value="dispute"><input type="hidden" name="a1" value="<%= ref %>">
            <input class="bx-in" type="text" name="a2" maxlength="200" placeholder="<%- t('wagers.ai.why_ph') %>" aria-label="<%- t('wagers.ai.why_ph') %>" required>
            <button class="bx-btn danger sm" type="submit"><%- t('wagers.ai.dispute') %></button>
          </form>
        <% } %>
      <% } else if (st === 'final' || st === 'done') { %><span class="call"><%- t('wagers.ai.decided', { result: ai.result }) %></span><% if (ai.reason) { %><span class="reason"><%= ai.reason %></span><% } %>
      <% } else { %><span class="info"><%- t('wagers.ai.idle') %></span><% } %>
      <% if ((!st || st === 'unsure') && live && inIt && (cmd === 'pool' ? canPool : canWager)) { %>
        <form class="inline" method="post" action="/act"><%- hidden(cmd) %>
          <input type="hidden" name="a0" value="ai"><input type="hidden" name="a1" value="<%= ref %>">
          <button class="bx-btn blue sm" type="submit"><%- t('wagers.ai.ask') %></button>
        </form>
      <% } %>
    </div>
  <% };

  const wagerCard = (w, offer) => { %>
    <div class="card bx-card<%= offer ? ' offer' : w.inIt ? ' mine' : '' %>">
      <div class="bx-top"><span class="bx-ref"><%= w.ref %></span><%- offer ? '<span class="bx-chip c-offer c-plain">' + t('wagers.for_you') + '</span>' : chip(w.status) %>
        <% if (w.room) { %><span class="info" style="margin-left:auto"><%- padLink(w.room) %></span><% } %></div>
      <div class="vs"><span class="p"><%- ul(w.creator) %></span><span class="x" aria-label="<%- t('wagers.vs') %>">VS</span><span class="p"><%- w.opponent ? ul(w.opponent) : t('wagers.anyone') %></span></div>
      <% if (w.terms) { %><p class="terms">“<%= w.terms %>”</p><% } %>
      <div class="pot"><span class="bx-big"><%= fmt(w.pot) %><small>PAT <%- t('wagers.pot') %></small></span><span class="each"><%- t('wagers.each', { n: fmt(w.amount) }) %></span></div>
      <span class="info">
        <% if (!w.ai_judge) { %><%- t('wagers.judge', { who: w.judge ? ul(w.judge) : '—' }) %><br><% } %>
        <% if (w.status === 'offered' && w.offer_until) { %><%- t('wagers.offer_open', { left: cd(w.offer_until) }) %><br><% } %>
        <% if (w.deadline) { %><%- w.deadline > now ? t('wagers.by', { when: when(w.deadline), left: cd(w.deadline) }) : t('wagers.past', { when: when(w.deadline) }) %><br><% } %>
        <%- t('wagers.winner_gets', { n: fmt(w.payout) }) %>
      </span>
      <% if (w.ai_judge) aiBox('wager', w.ref, w, w.inIt, w.status === 'active'); %>
      <% if (canWager) { %>
        <% if (offer) { %>
          <div class="acts">
            <form class="inline" method="post" action="/act"><%- hidden('wager') %><input type="hidden" name="a0" value="accept"><input type="hidden" name="a1" value="<%= w.ref %>"><button class="bx-btn gold" type="submit"><%- t('wagers.accept', { n: fmt(w.amount) }) %></button></form>
            <form class="inline" method="post" action="/act"><%- hidden('wager') %><input type="hidden" name="a0" value="decline"><input type="hidden" name="a1" value="<%= w.ref %>"><button class="bx-btn ghost" type="submit"><%- t('wagers.decline') %></button></form>
          </div>
          <% if (bal !== null && bal < w.amount) { %><span class="bad"><%- t('wagers.short', { n: fmt(bal) }) %></span><% } %>
        <% } %>
        <% if (w.isCreator && w.status === 'offered') { %>
          <form class="inline" method="post" action="/act"><%- hidden('wager') %><input type="hidden" name="a0" value="cancel"><input type="hidden" name="a1" value="<%= w.ref %>"><button class="bx-btn danger sm" type="submit"><%- t('wagers.cancel') %></button></form>
        <% } %>
        <% if (w.isJudge && w.status === 'active') { %>
          <form class="inline" method="post" action="/act"><%- hidden('wager') %><input type="hidden" name="a0" value="settle"><input type="hidden" name="a1" value="<%= w.ref %>">
            <select class="bx-in" name="a2" required aria-label="<%- t('wagers.settle_q') %>">
              <option value=""><%- t('wagers.settle_q') %></option>
              <option value="@<%= w.creator %>"><%= w.creator %></option>
              <% if (w.opponent) { %><option value="@<%= w.opponent %>"><%= w.opponent %></option><% } %>
              <option value="void"><%- t('wagers.settle_void') %></option>
            </select>
            <button class="bx-btn amber" type="submit"><%- t('wagers.settle') %></button>
          </form>
        <% } %>
      <% } %>
    </div>
  <% };

  const poolCard = (m) => { %>
    <div class="card bx-card<%= m.inIt ? ' mine' : '' %>">
      <div class="bx-top"><span class="bx-ref"><%= m.ref %></span>
        <%- m.status === 'open' ? '<span class="bx-chip c-open">' + t('wagers.pool_open') + '</span>' : m.status === 'closed' ? '<span class="bx-chip c-closed">' + t('wagers.pool_closed') + '</span>' : '<span class="bx-chip">' + t.esc(m.status) + '</span>' %>
        <% if (m.ai_judge) { %><span class="bx-chip c-ai c-plain"><span class="ds-ic" aria-hidden="true">🤖</span> AI</span><% } %>
        <% if (m.auto) { %><span class="bx-chip c-ai c-plain"><span class="ds-ic" aria-hidden="true">🤖</span> <%- t('markets.auto_tag') %> · <%- t('markets.auto.cat.' + (['sports','prices','news','trending'].includes(m.auto.cat) ? m.auto.cat : 'news')) %></span><% } %>
        <% if (m.padv) { %><a class="bx-pad" style="margin-inline-start:auto" href="<%= m.padv.url %>" title="<%- t('bx.pad.label') %>"><span class="ds-ic" aria-hidden="true">📍</span> <%= m.padv.title %></a><% } else { %><span class="bx-pad" style="margin-inline-start:auto"><span class="ds-ic" aria-hidden="true">📍</span> <%- t('bx.pad.sitewide') %></span><% } %></div>
      <a class="q" href="/markets/<%= m.id %>"><%= m.question %></a>
      <div class="opts">
        <% m.options.forEach((o) => { %>
          <div class="opt<%= o.won ? ' won' : '' %>"><span class="nm"><% if (o.won) { %><span class="ds-ic" aria-hidden="true">🏆</span> <% } %><%= o.name %></span>
            <span class="num"><b><%= o.share %>%</b> · <%= o.mult ? o.mult.toFixed(2) + '×' : '—' %></span>
            <span class="bar"><span style="width:<%= o.share %>%"></span></span></div>
        <% }) %>
      </div>
      <div class="pot"><span class="bx-big"><%= fmt(m.total) %><small>PAT <%- t('wagers.pot') %></small></span><% if (m.status === 'open') { %><span class="each"><%- t('wagers.closes_in', { left: cd(m.closes) }) %></span><% } %></div>
      <span class="info"><%- t('wagers.pool_bets', { count: m.betCount, n: fmt(m.betCount), who: fmt(m.bettors) }) %><% if (!m.ai_judge) { %> · <%- t('wagers.judge', { who: ul(m.judge) }) %><% } %> · <%- t('wagers.by_who', { who: ul(m.creator) }) %>
        <% if (m.mine.length) { %><br><%- t('wagers.you', { bets: m.mine.map((x) => t('wagers.you_on', { n: fmt(x.amount), o: x.option })).join(', ') }) %><% } %></span>
      <% if (m.ai_judge) aiBox('pool', m.ref, m, m.inIt, m.status === 'open' || m.status === 'closed'); %>
      <% if (canPool && m.status === 'open' && m.closes > now) { %>
        <form class="inline" method="post" action="/act"><%- hidden('pool') %><input type="hidden" name="a0" value="<%= m.ref %>">
          <select class="bx-in" name="a1" required aria-label="<%- t('wagers.pick') %>"><% m.options.forEach((o) => { %><option value="<%= o.name %>"><%= o.name %></option><% }) %></select>
          <input class="bx-in" type="text" name="a2" inputmode="numeric" autocomplete="off" spellcheck="false" pattern="\s*(\d{1,3}(,\d{3})+|\d+(_\d+)*)?(\.\d+)?[kKmMbB]?\s*" placeholder="<%- t('wagers.min_ph', { n: fmt(poolMin) }) %>" aria-label="PAT" required>
          <button class="bx-btn" type="submit"><%- t('wagers.bet') %></button>
        </form>
      <% } %>
      <a class="info" href="/markets/<%= m.id %>"><%- t('wagers.details') %></a>
    </div>
  <% };
  const liveShown = live.filter((w) => !offers.includes(w));
  const potLive = liveShown.reduce((a, w) => a + (w.pot || 0), 0) + pools.reduce((a, m) => a + (m.total || 0), 0);
%>
<main class="bx ds-page flow wg">
  <header class="bx-hero">
    <div class="bx-eyebrow"><span class="ds-ic" aria-hidden="true">🤝</span> <%- t('wagers.eyebrow') %></div>
    <h1><%- t('wagers.h1') %></h1>
    <p class="bx-lead"><%- t('wagers.lead') %></p>
    <div class="bx-stats">
      <span class="bx-stat"><b><%= fmt(liveShown.length + offers.length) %></b><%- t('wagers.stat_w', { count: liveShown.length + offers.length }) %></span>
      <span class="bx-stat"><b><%= fmt(pools.length) %></b><%- t('wagers.stat_p', { count: pools.length }) %></span>
      <span class="bx-stat"><b><%= fmt(potLive) %></b><%- t('wagers.stat_pot') %></span>
    </div>
    <div class="bx-ctas">
      <a class="bx-btn" href="#start"><span class="ds-ic" aria-hidden="true">⚔️</span> <%- t('wagers.cta_new') %></a>
      <a class="bx-btn ghost" href="/markets"><span class="ds-ic" aria-hidden="true">🔮</span> <%- t('wagers.cta_markets') %></a>
    </div>
    <div class="explain">
      <div><span class="ic" aria-hidden="true">⚔️</span><b><%- t('wagers.x_wager_h') %></b><span><%- t('wagers.x_wager', { fee: feePct }) %></span></div>
      <div><span class="ic" aria-hidden="true">🎲</span><b><%- t('wagers.x_pool_h') %></b><span><%- t('wagers.x_pool', { fee: feePct }) %></span></div>
    </div>
  </header>

  <%- include('partials/actions', { acts, msg }) %>
  <% if (!signedIn) { %><p class="bx-note"><%- t('wagers.signin') %></p>
  <% } else if (!camfrog) { %><p class="bx-note"><%- t('wagers.link') %></p>
  <% } else if (bal !== null) { %><p class="info" style="text-align:center;margin:14px 0 0"><%- t('wagers.signed_as', { who: camfrog, n: fmt(bal) }) %></p><% } %>

  <% if (offers.length) { %>
    <h2 class="bx-h"><%- t('wagers.h_offers') %> <span class="bx-n"><%= offers.length %></span></h2>
    <div class="bx-grid"><% offers.forEach((w) => wagerCard(w, true)) %></div>
  <% } %>

  <h2 class="bx-h"><%- t('wagers.h_live') %> <span class="bx-n"><%= liveShown.length %></span></h2>
  <% if (!liveShown.length) { %><div class="bx-empty"><span class="ic" aria-hidden="true">⚔️</span><b><%- t('wagers.empty_live') %></b><a class="bx-btn sm" href="#start"><%- t('wagers.cta_new') %></a></div><% } %>
  <div class="bx-grid"><% liveShown.forEach((w) => wagerCard(w, false)) %></div>

  <h2 class="bx-h" id="pools"><%- t('wagers.h_pools') %> <span class="bx-n"><%= pools.length %></span></h2>
  <%- include('partials/bx-padfilter', { filter: locals.filter || {}, base: '/wagers', voidToggle: true, hash: 'pools' }) %>
  <% if (!pools.length) { %><div class="bx-empty"><span class="ic" aria-hidden="true">🎲</span><b><%- t('wagers.empty_pools') %></b></div><% } %>
  <div class="bx-grid"><% pools.forEach((m) => poolCard(m)) %></div>

  <h2 class="bx-h" id="start"><%- t('wagers.h_start') %></h2>
  <% if (canWager || canPool) { %>
    <div class="forms">
      <% if (canWager) { %>
      <form class="bx-form" method="post" action="/act" id="wf"><%- hidden('wager') %>
        <b><span class="ds-ic" aria-hidden="true">⚔️</span> <%- t('wagers.f_w_h') %></b>
        <label class="bx-field"><%- t('wagers.f_opp') %><input class="bx-in" type="text" name="a0" maxlength="60" placeholder="<%- t('wagers.f_opp_ph') %>" required></label>
        <label class="bx-field"><%- t('wagers.f_stake') %><input class="bx-in" type="text" name="a1" inputmode="numeric" autocomplete="off" spellcheck="false" pattern="\s*(\d{1,3}(,\d{3})+|\d+(_\d+)*)?(\.\d+)?[kKmMbB]?\s*" placeholder="<%- t('wagers.min_ph', { n: fmt(wagerMin) }) %>" required></label>
        <div class="bx-chips"><% [1000, 5000, 10000, 25000].filter((v) => v >= wagerMin).forEach((v) => { %><button type="button" class="bx-qa" data-amt="<%= v %>" data-amt-field="a1"><%= v / 1000 %>k</button><% }) %></div>
        <label class="bx-field"><%- t('wagers.f_terms') %><input class="bx-in" type="text" name="a2" maxlength="200" placeholder="<%- t('wagers.f_terms_ph') %>" required></label>
        <label class="bx-field"><%- t('wagers.f_judge') %><input class="bx-in" type="text" id="wf-judge" maxlength="60" placeholder="<%- t('wagers.f_judge_ph') %>"></label>
        <label class="bx-check"><input type="checkbox" id="wf-ai"> <span class="ds-ic" aria-hidden="true">🤖</span> <%- t('wagers.f_ai') %></label>
        <input type="hidden" name="a3" id="wf-a3">
        <label class="bx-field"><%- t('wagers.f_by') %> <select class="bx-in" name="a4">
          <option value="by 1h"><%- t('bx.d.1h') %></option><option value="by 1d"><%- t('bx.d.1d') %></option><option value="by 2d" selected><%- t('bx.d.2d') %></option>
          <option value="by 7d"><%- t('bx.d.7d') %></option><option value="by 30d"><%- t('bx.d.30d') %></option></select></label>
        <button class="bx-btn" type="submit"><%- t('wagers.f_w_btn') %></button>
        <p class="bx-fine"><%- t('wagers.f_w_fine') %></p>
      </form>
      <% } %>
      <% if (canPool) { %>
      <form class="bx-form" method="post" action="/act" id="pf"><%- hidden('pool') %>
        <b><span class="ds-ic" aria-hidden="true">🎲</span> <%- t('wagers.f_p_h') %></b>
        <input type="hidden" name="a0" value="new">
        <label class="bx-field"><%- t('wagers.f_q') %><input class="bx-in" type="text" name="a1" maxlength="200" placeholder="<%- t('wagers.f_q_ph') %>" required></label>
        <label class="bx-field"><%- t('wagers.f_opts') %><input class="bx-in" type="text" id="pf-opts" maxlength="200" placeholder="<%- t('wagers.f_opts_ph') %>"></label>
        <input type="hidden" name="a2" id="pf-a2">
        <label class="bx-field"><%- t('wagers.f_judge') %><input class="bx-in" type="text" id="pf-judge" maxlength="60" placeholder="<%- t('wagers.f_judge_ph') %>"></label>
        <label class="bx-check"><input type="checkbox" id="pf-ai"> <span class="ds-ic" aria-hidden="true">🤖</span> <%- t('wagers.f_ai') %></label>
        <input type="hidden" name="a3" id="pf-a3">
        <label class="bx-field"><%- t('wagers.f_closes') %> <select class="bx-in" name="a4">
          <option value="closes 1h"><%- t('bx.d.1h') %></option><option value="closes 1d" selected><%- t('bx.d.1d') %></option><option value="closes 2d"><%- t('bx.d.2d') %></option>
          <option value="closes 7d"><%- t('bx.d.7d') %></option><option value="closes 30d"><%- t('bx.d.30d') %></option></select></label>
        <%- include('partials/bx-padpick', { pick: locals.pick || { choices: [], def: '' } }) %>
        <button class="bx-btn" type="submit"><%- t('wagers.f_p_btn') %></button>
        <p class="bx-fine"><%- t('wagers.f_p_fine', { n: fmt(poolMin) }) %></p>
      </form>
      <% } %>
    </div>
    <script>
      (function () {
        const at = (s) => { s = String(s || '').trim().replace(/^@+/, ''); return s ? '@' + s : ''; };
        function judge(prefix) {
          const ai = document.getElementById(prefix + '-ai'), j = document.getElementById(prefix + '-judge');
          ai.addEventListener('change', () => { j.disabled = ai.checked; });
          return () => ai.checked ? 'judge @pepe' : (at(j.value) ? 'judge ' + at(j.value) : '');
        }
        const wf = document.getElementById('wf'), pf = document.getElementById('pf');
        if (wf) {
          const wj = judge('wf');
          wf.addEventListener('submit', (e) => {
            const f = e.target; f.a0.value = at(f.a0.value); document.getElementById('wf-a3').value = wj();
          });
        }
        if (pf) {
          const pj = judge('pf');
          pf.addEventListener('submit', () => {
            const opts = document.getElementById('pf-opts').value.split(/[\/,|]/).map((s) => s.trim()).filter(Boolean);
            document.getElementById('pf-a2').value = opts.length >= 2 ? 'options ' + opts.join('/') : '';
            document.getElementById('pf-a3').value = pj();
          });
        }
      })();
    </script>
  <% } else { %>
    <p class="bx-note"><%- t('wagers.cmds') %></p>
  <% } %>

  <h2 class="bx-h"><%- t('wagers.h_done') %></h2>
  <% if (!doneW.length && !doneP.length) { %><div class="bx-empty"><span class="ic" aria-hidden="true">🏆</span><b><%- t('wagers.empty_done') %></b></div><% } %>
  <% if (doneW.length) { %>
    <div class="tbl bx-tbl"><table>
      <tr><th><%- t('wagers.th_w') %></th><th><%- t('wagers.th_who') %></th><th><%- t('wagers.th_terms') %></th><th class="r"><%- t('wagers.th_pot') %></th><th><%- t('wagers.th_result') %></th><th><%- t('wagers.th_when') %></th></tr>
      <% doneW.forEach((w) => { %>
        <tr><td class="ref"><%= w.ref %></td><td><%- ul(w.creator) %> vs <%- ul(w.opponent) %></td><td class="wrap"><%= w.terms %></td><td class="r"><%= fmt(w.pot) %></td>
          <td><%- w.status === 'won' ? '<span class="ds-ic" aria-hidden="true">🏆</span> ' + ul(w.winner) : t('wagers.void_ref') %><%- w.settled_by ? ' (' + (w.ai_judge && w.settled_by === w.judge ? '<span class="ds-ic" aria-hidden="true">🤖</span> ' : '') + ul(w.settled_by) + ')' : '' %></td><td><%- when(w.ended) %></td></tr>
      <% }) %>
    </table></div>
  <% } %>
  <% if (doneP.length) { %>
    <div class="tbl bx-tbl" style="margin-top:12px"><table>
      <tr><th><%- t('wagers.th_p') %></th><th><%- t('wagers.th_q') %></th><th class="r"><%- t('wagers.th_pot') %></th><th><%- t('wagers.th_result') %></th><th><%- t('wagers.th_when') %></th></tr>
      <% doneP.forEach((m) => { %>
        <tr><td><a href="/markets/<%= m.id %>"><%= m.ref %></a></td><td class="wrap"><%= m.question %></td><td class="r"><%= fmt(m.total) %></td>
          <td><%- m.status === 'settled' ? '<span class="ds-ic" aria-hidden="true">🏆</span> ' + t.esc(m.result) : m.status === 'void' ? t('wagers.void_ref') : t.esc(m.status) %><%= m.settled_by ? ' (' + m.settled_by + ')' : '' %></td><td><%- when(m.ended) %></td></tr>
      <% }) %>
    </table></div>
  <% } %>
  <div class="bx-foot"><%- t('wagers.foot') %></div>
</main>
</body>
</html>
