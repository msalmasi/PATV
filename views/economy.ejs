<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('economy.page_title'), user: user}) %>
<%# 1.99lx design pass: a live, friendly view up top (econpage.js: supply, the Fed band, where PAT sits, the incentive
    budget, the vaults, supply history) in the newer pages' look; the full guide below is unchanged in substance. -%>
<style>
  /* 1.99pr polish: the page is a .ds-page.flow (block flow, so the sticky contents bar works) and reads the ds tokens.
     Section headings: .ds-h2 (one style) under a green .ds-eyebrow.ac kicker; card titles are h3. */
  .eco > * + * { margin-block-start: var(--ds-sp-6); }
  .eco > .guide-h { margin-block-start: var(--ds-sp-12); }
  .eco h1 em { font-style: normal; background: var(--ds-gold-text-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .eco .num { font-variant-numeric: tabular-nums; }
  .eco .muted { color: var(--ds-text-muted); }
  .eco .ds-fine a { font-weight: 500; }

  /* hero + live numbers */
  .eco .ds-hero .ds-stats { grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr)); margin-block-start: var(--ds-sp-2); }
  .eco .ds-hero .ds-stat > b { font-size: clamp(17px, 4.2vw, 22px); }
  .eco .ds-stat > span .ds-ic { font-size: 13px; vertical-align: -.3em; margin-inline-end: 2px; }
  .eco .lv { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--ds-sp-4); }
  .eco .ep { gap: var(--ds-sp-3); }
  .eco .ep p { margin: 0; color: var(--ds-text-2); font-size: var(--ds-fs-sm); line-height: var(--ds-lh-sm); }
  .eco .ep p.fed-now { color: var(--ds-text-strong); font-weight: 500; }
  .eco .ep p.ds-fine { color: var(--ds-text-muted); font-size: var(--ds-fs-xs); }
  .eco .ep .ds-eyebrow + .ds-h2 { margin-block-start: calc(var(--ds-sp-1) * -1); }
  .eco .duo { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: var(--ds-sp-4); }

  /* the money loop */
  .eco .loop { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--ds-sp-6); position: relative; }
  .eco .step { position: relative; display: grid; gap: var(--ds-sp-1h); align-content: start; min-width: 0; padding: var(--ds-sp-3); border-radius: var(--ds-r-lg);
               background: var(--ds-sunken); border: 1px solid var(--ds-line); border-block-start: 3px solid var(--c); }
  .eco .step + .step::before { content: '→'; position: absolute; inset-inline-start: -19px; top: 50%; transform: translateY(-50%); color: var(--ds-gold); font-weight: 700; font-size: 16px; line-height: 1; }
  [dir="rtl"] .eco .step + .step::before { content: '←'; }
  .eco .step .sn { color: var(--c); font: 700 var(--ds-fs-chip)/1.4 var(--ds-font); letter-spacing: var(--ds-ls-label); text-transform: uppercase; }
  .eco .step > b { color: var(--ds-text-strong); font-size: var(--ds-fs-h4); line-height: var(--ds-lh-h4); }
  .eco .step p { font-size: var(--ds-fs-meta); color: var(--ds-text-muted); margin: 0; line-height: var(--ds-lh-meta); }
  .eco .step ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--ds-sp-1); font-size: var(--ds-fs-meta); }
  .eco .step li { display: flex; justify-content: space-between; align-items: center; gap: var(--ds-sp-2); color: var(--ds-text-2); }
  .eco .step li b { font-size: var(--ds-fs-meta); color: var(--ds-gold-text); font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .eco .ep p.loop-back { text-align: center; color: var(--ds-text-muted); font-size: var(--ds-fs-meta); }
  @media (max-width: 760px) {
    .eco .loop { grid-template-columns: minmax(0, 1fr); gap: var(--ds-sp-5); }
    .eco .step + .step::before, [dir="rtl"] .eco .step + .step::before { content: '↓'; inset-inline-start: 50%; top: -18px; transform: translateX(-50%); }
    [dir="rtl"] .eco .step + .step::before { transform: translateX(50%); }
  }

  /* Fed band gauge (a chart: always left-to-right) */
  .eco .gauge, .eco .gscale { direction: ltr; }
  .eco .gauge { position: relative; height: 34px; border-radius: var(--ds-r-md); overflow: hidden; display: flex; border: 1px solid var(--ds-line-strong); }
  .eco .gauge .z { height: 100%; }
  .eco .gauge .z.lo { background: repeating-linear-gradient(135deg, #2a1610 0 6px, #24130e 6px 12px); }
  .eco .gauge .z.ok { background: var(--ds-green-deep); }
  .eco .gauge .z.hi { background: repeating-linear-gradient(45deg, #2a1610 0 6px, #24130e 6px 12px); }
  .eco .gauge .mk { position: absolute; top: -2px; bottom: -2px; width: 4px; margin-left: -2px; background: var(--ds-text-strong); border-radius: 2px; box-shadow: 0 0 0 2px var(--ds-surface); }
  .eco .gscale { position: relative; height: 34px; margin-block-start: var(--ds-sp-1h); font-size: var(--ds-fs-xs); color: var(--ds-text-muted); }
  .eco .gscale span { position: absolute; top: 0; transform: translateX(-50%); white-space: nowrap; text-align: center; line-height: 1.3; }
  .eco .glegend { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); gap: var(--ds-sp-2); }
  .eco .glegend div { font-size: var(--ds-fs-meta); color: var(--ds-text-muted); line-height: var(--ds-lh-meta); padding-inline-start: var(--ds-sp-2h); border-inline-start: 3px solid var(--ds-line-strong); }
  .eco .glegend div.on { border-inline-start-color: var(--ds-gold); color: var(--ds-text); }
  .eco .glegend b { display: block; color: var(--ds-text-strong); }

  /* where PAT sits */
  .eco .stack { display: flex; height: 22px; border-radius: var(--ds-r-xs); overflow: hidden; gap: 2px; background: var(--ds-surface); }
  .eco .stack i { display: block; height: 100%; min-width: 3px; }
  .eco ul.lg { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--ds-sp-2); }
  .eco ul.lg li { display: grid; grid-template-columns: 12px minmax(0, 1fr) auto; gap: var(--ds-sp-2); align-items: baseline; font-size: var(--ds-fs-sm); }
  .eco ul.lg li i { width: 12px; height: 12px; border-radius: 3px; display: inline-block; transform: translateY(1px); }
  .eco ul.lg li small { display: block; color: var(--ds-text-muted); font-size: var(--ds-fs-xs); }
  .eco ul.lg li b { font-variant-numeric: tabular-nums; color: var(--ds-text-strong); white-space: nowrap; }

  /* budget bars */
  .eco ul.bars { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--ds-sp-2h); }
  .eco ul.bars li { display: grid; gap: var(--ds-sp-1); }
  .eco ul.bars .bl { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--ds-sp-1) var(--ds-sp-2); font-size: var(--ds-fs-meta); color: var(--ds-text-2); }
  .eco ul.bars .bl b { color: var(--ds-text-strong); font-weight: 400; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .eco ul.bars .track { display: block; height: 8px; background: #1f1f1f; border-radius: var(--ds-r-pill); overflow: hidden; }
  .eco ul.bars .fill { height: 100%; background: var(--ds-gold-grad); border-radius: var(--ds-r-pill); }
  .eco ul.bars li.hl .bl { color: var(--ds-text-strong); font-weight: 700; }

  /* vault tiles */
  .eco .vts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 130px), 1fr)); gap: var(--ds-sp-2h); }
  .eco .vt { display: grid; gap: 2px; align-content: start; min-width: 0; padding: var(--ds-sp-2h) var(--ds-sp-3); border-radius: var(--ds-r-lg);
             background: var(--ds-sunken); border: 1px solid var(--ds-line); border-block-start: 3px solid var(--c); }
  .eco .vt b { color: var(--ds-text-strong); font-size: var(--ds-fs-sm); }
  .eco .vt .v { font-size: 19px; font-weight: 700; line-height: 1.25; color: var(--ds-gold-text); font-variant-numeric: tabular-nums; }
  .eco .vt small { color: var(--ds-text-muted); font-size: var(--ds-fs-xs); line-height: var(--ds-lh-xs); }

  /* charts (SVGs scale with their box; the text grows on phones so it stays readable after the scale-down) */
  .eco .chart { display: grid; gap: var(--ds-sp-1h); min-width: 0; }
  .eco .chart svg { display: block; width: 100%; height: auto; overflow: visible; }
  .eco .chart svg text { font-family: var(--ds-font); fill: var(--ds-text-muted); font-size: 11px; }
  .eco .chart .ttl { font-size: var(--ds-fs-meta); color: var(--ds-text-2); display: flex; justify-content: space-between; gap: var(--ds-sp-2); flex-wrap: wrap; }
  .eco .chart .ttl b { color: var(--ds-text-strong); }
  .eco .chart .hit { fill: transparent; }
  .eco .chart .hit:hover { fill: rgba(255, 255, 255, .06); }
  @media (max-width: 600px) { .eco .chart svg text { font-size: 19px; } .eco .chart svg text.yl { font-size: 16px; } }
  .eco .key { display: flex; flex-wrap: wrap; gap: var(--ds-sp-1) var(--ds-sp-3h); font-size: var(--ds-fs-xs); color: var(--ds-text-muted); }
  .eco .key i { display: inline-block; width: 12px; height: 3px; vertical-align: middle; margin-inline-end: 5px; border-radius: 2px; }
  .eco .key i.sq { height: 10px; width: 10px; }
  .eco .key i.dash { background: none !important; border-top: 2px dashed var(--ds-text-muted); height: 0; }
  .eco details.data summary { display: flex; align-items: center; min-height: var(--ds-tap); cursor: pointer; color: var(--ds-ac-2); font-size: var(--ds-fs-meta); font-weight: 500; }
  .eco details.data[open] summary { margin-block-end: var(--ds-sp-2); }

  /* the PAT map (Economy v3): new PAT -> the Fed -> the incentive budget / the working vaults -> players -> back */
  .eco .pmap { display: grid; gap: 0; min-width: 0; margin: var(--ds-sp-4) 0 var(--ds-sp-1h); padding: var(--ds-sp-4); border-radius: var(--ds-r-xl);
               background: var(--ds-sunken); border: 1px solid var(--ds-line); scroll-margin-top: 90px; }
  .eco .pmap .pm-top { display: grid; gap: var(--ds-sp-1); margin-block-end: var(--ds-sp-3); }
  .eco .pmap .pm-top p { margin: 0; color: var(--ds-text-muted); font-size: var(--ds-fs-meta); line-height: var(--ds-lh-meta); }
  .eco .pm-box { display: grid; gap: var(--ds-sp-1h); min-width: 0; align-content: start; padding: var(--ds-sp-3) var(--ds-sp-3h); border-radius: var(--ds-r-lg);
                 background: var(--ds-surface); border: 1px solid var(--ds-line); border-inline-start: 4px solid var(--c, var(--ds-text-muted)); }
  .eco .pm-box h4 { margin: 0; font: 700 var(--ds-fs-h4)/var(--ds-lh-h4) var(--ds-font); color: var(--ds-text-strong); }
  .eco .pm-box p { margin: 0; font-size: var(--ds-fs-sm); color: var(--ds-text-2); line-height: var(--ds-lh-sm); }
  .eco .pm-box ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--ds-sp-1h); font-size: var(--ds-fs-sm); color: var(--ds-text-2); line-height: 1.45; }
  .eco .pm-box li { position: relative; padding-inline-start: var(--ds-sp-3h); }
  .eco .pm-box li::before { content: ''; position: absolute; inset-inline-start: 2px; top: .6em; width: 6px; height: 6px; border-radius: 50%; background: var(--c, var(--ds-text-muted)); }
  .eco .pm-box li.soon { padding: var(--ds-sp-1) var(--ds-sp-2); padding-inline-start: 22px; border: 1px dashed #4a4a4a; border-radius: var(--ds-r-sm); color: var(--ds-text-muted); }
  .eco .pm-box li.soon::before { inset-inline-start: 9px; top: 1em; background: transparent; border: 1px dashed var(--c, var(--ds-text-muted)); }
  .eco .pm-box li b { color: var(--ds-text-strong); font-weight: 700; }
  .eco .pm-soon, .eco .new { display: inline-flex; align-items: center; padding: 1px 7px; margin-inline-start: var(--ds-sp-1h); border-radius: var(--ds-r-pill); vertical-align: 1px;
                             font: 700 var(--ds-fs-chip)/1.5 var(--ds-font); letter-spacing: .02em; white-space: nowrap; }
  .eco .pm-soon { background: var(--ds-warn-fill); color: #1a1200; }
  .eco .pm-ar { display: flex; align-items: center; justify-content: center; gap: var(--ds-sp-2); padding: var(--ds-sp-1h) var(--ds-sp-1); color: var(--ds-text-muted); font-size: var(--ds-fs-xs); text-align: center; line-height: 1.35; }
  .eco .pm-ar::before { content: '↓'; flex: none; color: var(--ds-gold); font-weight: 700; font-size: 18px; line-height: 1; }
  .eco .pm-fed { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 220px); gap: var(--ds-sp-3); align-items: stretch; }
  .eco .pm-burn { display: grid; align-content: center; gap: var(--ds-sp-1); min-width: 0; padding: var(--ds-sp-3) var(--ds-sp-3h); border-radius: var(--ds-r-lg);
                  background: #1d0f0b; border: 1px dashed #d65f36; color: #f0b9a3; font-size: var(--ds-fs-sm); line-height: 1.45; }
  .eco .pm-burn b { color: var(--ds-text-strong); }
  .eco .pm-split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--ds-sp-4); }
  .eco .pm-col { display: grid; align-content: start; min-width: 0; }
  .eco .pm-routes { display: grid; }
  .eco .pm-rt { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--ds-sp-1) var(--ds-sp-3); padding: var(--ds-sp-2) 0; border-block-start: 1px dashed var(--ds-line); font-size: var(--ds-fs-sm); color: var(--ds-text-2); line-height: 1.45; }
  .eco .pm-rt:first-child { border-block-start: 0; }
  .eco .pm-rt span:last-child { color: var(--ds-gold-text); }
  .eco .pm-box p.pm-note { margin-block-start: var(--ds-sp-1); font-size: var(--ds-fs-xs); color: var(--ds-text-muted); line-height: var(--ds-lh-xs); }
  .eco .pm-back { --c: var(--ds-green-2); }
  .eco .pm-key { display: flex; flex-wrap: wrap; gap: var(--ds-sp-1) var(--ds-sp-4); margin-block-start: var(--ds-sp-3); font-size: var(--ds-fs-xs); color: var(--ds-text-muted); }
  .eco .pm-key i { display: inline-block; width: 18px; height: 11px; border-radius: 3px; vertical-align: -1px; margin-inline-end: var(--ds-sp-1h); }
  @media (max-width: 700px) {
    .eco .pm-fed, .eco .pm-split { grid-template-columns: minmax(0, 1fr); }
    .eco .pm-split .pm-col + .pm-col { margin-block-start: var(--ds-sp-1); }
  }
  @media (max-width: 520px) {
    .eco .pmap { padding: var(--ds-sp-3); }
    .eco .pm-rt { grid-template-columns: minmax(0, 1fr); }
  }

  /* the guide */
  .eco .guide-h { display: grid; gap: var(--ds-sp-2); }
  .eco .toc { padding: var(--ds-sp-2h) var(--ds-sp-3); border-radius: var(--ds-r-lg); background: rgba(10, 10, 10, .92); border: 1px solid var(--ds-line); }
  .eco .toc .ds-label { margin-block-end: var(--ds-sp-2); }
  .eco .toc ul { list-style: none; margin: 0; }
  .eco .toc li { flex: none; }
  @media (min-width: 900px) {
    .eco .toc { position: sticky; top: var(--ds-sp-2); z-index: var(--ds-z-sticky); box-shadow: var(--ds-e-3); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
    .eco .toc ul { flex-wrap: wrap; overflow: visible; }
  }

  .eco > section { scroll-margin-top: 90px; }
  .eco > section > .ds-eyebrow { margin-block-end: var(--ds-sp-1h); }
  .eco > section > .ds-h2 { margin-block-end: var(--ds-sp-2h); }
  .eco h3 { margin: 0 0 var(--ds-sp-1h); font: 700 var(--ds-fs-h3)/var(--ds-lh-h3) var(--ds-font); color: var(--ds-text-strong); }
  .eco > section p { line-height: var(--ds-lh-body); margin: 0 0 var(--ds-sp-2h); }
  .eco .lead { color: var(--ds-text-2); max-width: 72ch; }
  .eco .new { background: var(--ds-ok); color: var(--ds-on-ac); }
  .eco .new.exp { background: var(--ds-warn-fill); color: #1a1200; }

  .eco .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr)); gap: var(--ds-sp-3); margin-block-start: var(--ds-sp-3); }
  .eco .card { min-width: 0; padding: var(--ds-sp-4); border-radius: var(--ds-r-xl); background: var(--ds-surface); border: 1px solid var(--ds-line); }
  .eco .card > :last-child { margin-block-end: 0; }
  .eco .card p { color: var(--ds-text-2); font-size: var(--ds-fs-sm); line-height: var(--ds-lh-sm); }
  .eco .card ul { margin: 0 0 var(--ds-sp-2h); padding-inline-start: 18px; color: var(--ds-text-2); font-size: var(--ds-fs-sm); line-height: 1.6; }
  .eco .card li + li { margin-block-start: var(--ds-sp-1); }
  .eco .card p.n { margin: 0; font-size: var(--ds-fs-num-lg); line-height: 1.15; font-weight: 700; color: var(--ds-gold-text); font-variant-numeric: tabular-nums; }
  .eco .cmd { margin: var(--ds-sp-2) 0 var(--ds-sp-1h); font-size: var(--ds-fs-meta); color: var(--ds-text-muted); line-height: 1.9; }
  .eco .goes { margin-block-start: var(--ds-sp-2); padding-block-start: var(--ds-sp-2); border-block-start: 1px dashed var(--ds-line-strong); font-size: var(--ds-fs-meta); color: var(--ds-text-2); line-height: var(--ds-lh-meta); }
  .eco .goes b { color: var(--ds-gold); font-weight: 700; }
  .eco .wide { grid-column: 1 / -1; }

  .eco .note { margin: var(--ds-sp-3h) 0 0; padding: var(--ds-sp-3) var(--ds-sp-3h); border-radius: var(--ds-r-lg); border: 1px solid var(--ds-ok-line); background: var(--ds-ok-bg);
               color: var(--ds-ok-ink); font-size: var(--ds-fs-sm); line-height: var(--ds-lh-sm); }
  .eco .note b { color: var(--ds-text-strong); }
  .eco .note.warn { border-color: var(--ds-warn-line); background: var(--ds-warn-bg); color: var(--ds-warn-ink); }

  .eco .ds-tbl { margin-block-start: var(--ds-sp-3); }
  .eco .ds-tbl table { min-width: 520px; }
  .eco .ds-tbl td { vertical-align: top; }
  .eco .ds-tbl td.n { white-space: nowrap; color: var(--ds-ac-2); }
  .eco .cfg { color: var(--ds-warn); font-size: var(--ds-fs-xs); }

  .eco .links { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, clamp(150px, 20vw, 200px)), 1fr)); gap: var(--ds-sp-2h); margin-block-start: var(--ds-sp-3); }
  .eco .links a { display: grid; grid-template-columns: 1.25em minmax(0, 1fr); align-content: center; align-items: center; gap: 2px var(--ds-sp-2); min-height: var(--ds-tap); padding: var(--ds-sp-3) var(--ds-sp-3h);
                  border-radius: var(--ds-r-lg); background: var(--ds-surface); border: 1px solid var(--ds-line); color: var(--ds-text-strong); font-size: var(--ds-fs-sm); font-weight: 700;
                  transition: border-color var(--ds-dur-1), transform var(--ds-dur-1); }
  .eco .links a:hover, .eco .links a:focus-visible { border-color: var(--ds-ac); text-decoration: none; transform: translateY(-1px); }
  .eco .links small { grid-column: 2; color: var(--ds-text-muted); font-size: var(--ds-fs-xs); font-weight: 400; }
  .eco .top { margin-block-start: var(--ds-sp-2); text-align: end; font-size: var(--ds-fs-xs); }
  .eco .top a { display: inline-flex; align-items: center; min-height: 36px; padding-inline: var(--ds-sp-1); color: var(--ds-text-faint); }
  .eco .top a:hover { color: var(--ds-text); }

  .eco .h3s { margin: var(--ds-sp-7) 0 var(--ds-sp-1h); }
  .eco .fig { margin: var(--ds-sp-4) 0 var(--ds-sp-1); padding: var(--ds-sp-3h) var(--ds-sp-3) var(--ds-sp-2h); border-radius: var(--ds-r-xl); background: var(--ds-sunken); border: 1px solid var(--ds-line); }
  .eco .fig svg { display: block; width: 100%; height: auto; max-width: 620px; margin: 0 auto; }
  .eco .fig svg text { font-family: var(--ds-font); }
  .eco .fig figcaption { margin-block-start: var(--ds-sp-2); text-align: center; color: var(--ds-text-muted); font-size: var(--ds-fs-meta); line-height: 1.45; }
  @media (max-width: 520px) { .eco .card { padding: var(--ds-sp-3h); } .eco .fig { padding-inline: var(--ds-sp-2); } }

  /* 1.99px: phone versions of the explainer diagrams. The wide SVGs (.fig-desk) scale to ~8px text at 375, so under
     600px they hide and .fm shows the same content as an HTML stack (or a phone-sized SVG) at readable sizes. */
  .eco .fm { display: none; }
  @media (max-width: 600px) { .eco .fig .fig-desk { display: none; } .eco .fig .fm { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--ds-sp-2); } }
  .eco .fm-legend { display: flex; flex-wrap: wrap; gap: var(--ds-sp-1h) var(--ds-sp-3h); margin: 0; padding: 0; list-style: none; color: var(--ds-text-2); font-size: var(--ds-fs-xs); }
  .eco .fm-legend li { display: inline-flex; align-items: center; gap: var(--ds-sp-1h); }
  .eco .fm-legend i { flex: none; width: 18px; height: 3px; border-radius: 2px; background: var(--c); }
  .eco .fm-legend i.dash { background: repeating-linear-gradient(90deg, var(--c) 0 4px, transparent 4px 7px); }
  .eco .fm-box { display: grid; gap: var(--ds-sp-1); min-width: 0; padding: var(--ds-sp-2h) var(--ds-sp-3); border: 1px solid var(--ds-line); border-inline-start: 3px solid var(--c, var(--ds-line-strong));
                 border-radius: var(--ds-r-lg); background: var(--ds-surface); }
  .eco .fm-box.dashed { border-style: dashed; border-inline-start-style: dashed; }
  .eco .fm-box.hl { border-color: var(--c); border-inline-start-width: 3px; }
  .eco .fm-box > b { color: var(--c, var(--ds-text-strong)); font-size: 15px; line-height: 1.3; }
  .eco .fm-box > .s { color: var(--ds-text-muted); font-size: var(--ds-fs-xs); line-height: 1.4; }
  .eco .fm-box > .fm-note { color: var(--ds-text-muted); font-size: var(--ds-fs-xs); font-style: italic; }
  .eco .fm-mv { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 2px var(--ds-sp-1h); align-items: baseline; color: var(--ds-text-2); font-size: var(--ds-fs-meta); line-height: 1.4; }
  .eco .fm-mv > i { font-style: normal; font-weight: 700; text-align: center; color: var(--c); }
  .eco .fm-mv.in > i { --c: var(--ds-warn-fill); } .eco .fm-mv.out > i { --c: var(--ds-ok); } .eco .fm-mv.fed > i { --c: var(--ds-gold); }
  .eco .fm-mv.fed { color: var(--ds-gold); }
  .eco .fm-mv.soon > span { font-style: italic; }
  .eco .fm-step { justify-self: center; display: inline-flex; align-items: center; gap: var(--ds-sp-1h); color: var(--c, var(--ds-text-muted)); font-size: var(--ds-fs-meta); font-weight: 700; line-height: 1.2; }
  .eco .fm-step::before { content: "↓"; font-size: 18px; }
  .eco .fm-step.back::before { content: "↩"; }
  .eco .fm-dl { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--ds-sp-1h); margin: 0; }
  .eco .fm-dl dt { margin: 0; color: var(--ds-gold); font: 700 11px/1.3 var(--ds-font); letter-spacing: var(--ds-ls-label); text-transform: uppercase; }
  .eco .fm-dl dd { margin: 0; color: var(--ds-text-2); font-size: var(--ds-fs-meta); line-height: 1.45; }
  .eco .fm-dl dd + dt { margin-block-start: var(--ds-sp-1); }
  .eco .fm-svg { display: block; width: 100%; height: auto; }
  .eco .fm-svg text { font-family: var(--ds-font); }
  .eco .fm-lead { margin: 0; color: var(--ds-text-2); font-size: var(--ds-fs-meta); line-height: 1.45; }
  .eco .fm-lead b { color: var(--ds-gold); }
  /* the burn counters: total across the top, 7 / 30 days side by side on phones */
  @media (max-width: 700px) {
    .eco #burnStats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .eco #burnStats > :first-child { grid-column: 1 / -1; }
    .eco #burnStats .card p.n { font-size: clamp(18px, 6vw, 26px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .eco *, .eco *::before, .eco *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
    .eco .links a:hover, .eco .links a:focus-visible { transform: none; }
  }
</style>
<%
  const L = typeof live !== 'undefined' && live ? live : null;
  const nf = (x) => Math.round(Number(x) || 0).toLocaleString('en-US');
  // short numbers for tight spots: 1.2M, 340k
  const sh = (x) => { const n = Number(x) || 0, a = Math.abs(n); return a >= 1e15 ? (n / 1e15).toFixed(2).replace(/\.?0+$/, '') + 'Q' : a >= 1e12 ? (n / 1e12).toFixed(2).replace(/\.?0+$/, '') + 'T' : a >= 1e9 ? (n / 1e9).toFixed(2).replace(/\.?0+$/, '') + 'B' : a >= 1e6 ? (n / 1e6).toFixed(1).replace(/\.0$/, '') + 'M' : a >= 1e3 ? Math.round(n / 1e3) + 'k' : String(Math.round(n)); };
  const P = (L && L.pools) || {};
  const layer = (k) => { const g = L && L.supply ? (L.supply.layers || []).find((x) => x.key === k) : null; return g ? g.amount : null; };
  const INC = L && L.incentives ? L.incentives : null;
  const GROUP = { welcome: t('economy.g.welcome'), levelup: t('economy.g.levelup'), achievements: t('economy.g.achievements'), misc: t('economy.g.misc'),
                  royalties: t('economy.g.royalties'), activity: t('economy.group.activity'), roomgames: t('economy.g.roomgames'), turf: t('economy.g.turf'),
                  season: t('economy.g.season'), launchpad: t('economy.g.launchpad') };
  // Economy v3 numbers for the PAT map and the guide: the live values when Pepe has reported them, else the defaults
  // (Fed band 50M-150M, a 25M weekly incentive target, $1 = 500k PAT + 20% to incentives). The weekly target is the sum
  // of the groups' budgets (on prod the guarantee target equals it).
  const SOON = '<span class="pm-soon">' + t('economy.soon') + '</span>';
  // live from Pepe's routing / launchpad (econpage.js); defaults when the page is rendered without them
  const RS = (typeof roomSplit !== 'undefined' && roomSplit) || { owner: 10, fortknox: 45, room: 45 };
  const LP_ON = typeof launchpadOn !== 'undefined' && !!launchpadOn;
  const V3 = (() => {
    const b = (L && L.band) || {};
    const bs = (INC && INC.budgets) || (typeof treasury !== 'undefined' && treasury && treasury.budgets) || null;
    const bud = bs ? Object.values(bs).reduce((a, x) => a + (Number(x) || 0), 0) : 0;
    const target = bud > 0 ? bud : 25e6;
    const d = (L && L.donation) || {};
    return { floor: b.floor != null ? b.floor : 50e6, ceiling: b.ceiling != null ? b.ceiling : 150e6, target,
             fk: Math.max(2e6, target * 0.6), cv: Math.max(2e6, target * 0.4),
             rate: d.rate != null ? d.rate : 500000, bonus: d.bonus_pct != null ? d.bonus_pct : 20 };
  })();
  const LAYER_C = { players: '#3987e5', fed: '#d95926', treasury: '#199e70', incentive: '#c98500', pots: '#d55181', burn: '#008300' };
%>
<main class="ds-page flow eco" id="top">
  <section class="ds-hero gold" aria-labelledby="ecoH">
    <div class="ds-eyebrow"><%- t('economy.eyebrow') %></div>
    <h1 id="ecoH"><%- t('economy.h1') %></h1>
    <p class="ds-lead"><%- t('economy.lead') %></p>
    <% if (L && L.supply) { %>
      <div class="ds-stats">
        <div class="ds-stat"><span><%- t('economy.tile.supply') %></span><b><%= nf(L.supply.total) %></b>
          <% if (L.month.change != null) { %><small><%- t('economy.tile.change30', { pct: (L.month.change >= 0 ? '+' : '') + (L.month.change * 100).toFixed(2) + '%' }) %></small><% } %></div>
        <div class="ds-stat"><span><%- t('economy.tile.players') %></span><b><%= nf(layer('players')) %></b><small><%- t('economy.tile.players_d') %></small></div>
        <div class="ds-stat"><span><span class="ds-ic" aria-hidden="true">🏛️</span><%- t('economy.tile.fed') %></span><b><%= L.fed == null ? '—' : nf(L.fed) %></b><small><%- t('economy.tile.fed_d') %></small></div>
        <div class="ds-stat"><span><span class="ds-ic" aria-hidden="true">🔥</span><%- t('economy.tile.burned') %></span><b><%= nf(L.supply.burned && L.supply.burned.total) %></b><small><%- t('economy.tile.burned_d') %></small></div>
      </div>
      <p class="ds-fine"><%- t('economy.live_note') %><% if (L.supply.updated) { %> · <%- t('economy.updated', { when: String(L.supply.updated).slice(0, 16) + ' UTC' }) %><% } %></p>
    <% } %>
  </section>

  <% if (L) { %>
  <div class="lv" id="live">
    <!-- the money loop -->
    <section class="ds-card lg ep" aria-labelledby="loopH">
      <div class="ds-eyebrow ac"><%- t('economy.loop.k') %></div>
      <h2 class="ds-h2" id="loopH"><%- t('economy.loop.h') %></h2>
      <div class="loop">
        <div class="step" style="--c:#3a8ad0">
          <span class="sn">1 · <%- t('economy.loop.s1') %></span>
          <b><span class="ds-ic" aria-hidden="true">🏛️</span> <%- t('economy.loop.s1_h') %></b>
          <p><%- t('economy.loop.s1_d') %></p>
          <ul><li><%- t('economy.loop.minted30') %> <b><%= nf(L.month.minted) %></b></li></ul>
        </div>
        <div class="step" style="--c:#ffcf40">
          <span class="sn">2 · <%- t('economy.loop.s2') %></span>
          <b><span class="ds-ic" aria-hidden="true">🏦</span> <%- t('economy.loop.s2_h') %></b>
          <ul>
            <li><span><span class="ds-ic" aria-hidden="true">🎁</span> <%- t('economy.v.incentives') %></span> <b><%= sh(P['vault:incentives'] != null ? P['vault:incentives'] : INC ? INC.balance : 0) %></b></li>
            <li><span><span class="ds-ic" aria-hidden="true">🎰</span> <%- t('economy.v.house') %></span> <b><%= sh(P.jackpot) %></b></li>
            <li><span><span class="ds-ic" aria-hidden="true">🏰</span> <%- t('economy.v.fortknox') %></span> <b><%= sh(L.fortknox) %></b></li>
            <li><span><span class="ds-ic" aria-hidden="true">🎲</span> <%- t('economy.v.casino') %></span> <b><%= sh(P['vault:heist']) %></b></li>
          </ul>
        </div>
        <div class="step" style="--c:#66bb6a">
          <span class="sn">3 · <%- t('economy.loop.s3') %></span>
          <b><span class="ds-ic" aria-hidden="true">👛</span> <%- t('economy.loop.s3_h') %></b>
          <p><%- t('economy.loop.s3_d') %></p>
        </div>
        <div class="step" style="--c:#d65f36">
          <span class="sn">4 · <%- t('economy.loop.s4') %></span>
          <b><span class="ds-ic" aria-hidden="true">🔥</span> <%- t('economy.loop.s4_h') %></b>
          <p><%- t('economy.loop.s4_d') %></p>
          <ul><li><%- t('economy.loop.burned30') %> <b><%= nf(L.month.burned) %></b></li></ul>
        </div>
      </div>
      <p class="loop-back"><%- t('economy.loop.back') %></p>
    </section>

    <div class="duo">
      <!-- the Fed band -->
      <section class="ds-card lg ep" id="fed-band" aria-labelledby="bandH">
        <div class="ds-eyebrow ac"><%- t('economy.band.k') %></div>
        <h2 class="ds-h2" id="bandH"><span class="ds-ic" aria-hidden="true">🏛️</span> <%- t('economy.band.h') %></h2>
        <% const B = L.band; if (B && B.floor != null && B.ceiling != null && L.fed != null) {
             const max = Math.max(B.ceiling * 1.2, L.fed * 1.08, 1);
             const at = (v) => Math.max(0, Math.min(100, v / max * 100));
             const zone = L.fed < B.floor ? 'lo' : L.fed > B.ceiling ? 'hi' : 'ok'; %>
          <p><%- zone === 'lo' ? t('economy.band.now_lo') : zone === 'hi' ? t('economy.band.now_hi') : t('economy.band.now_ok') %></p>
          <div>
            <div class="gauge" role="img" aria-label="<%- t('economy.band.aria', { fed: nf(L.fed), floor: nf(B.floor), ceiling: nf(B.ceiling) }) %>">
              <span class="z lo" style="width:<%= at(B.floor).toFixed(2) %>%"></span>
              <span class="z ok" style="width:<%= (at(B.ceiling) - at(B.floor)).toFixed(2) %>%"></span>
              <span class="z hi" style="flex:1"></span>
              <span class="mk" style="left:<%= at(L.fed).toFixed(2) %>%"></span>
            </div>
            <div class="gscale" aria-hidden="true">
              <span style="left:<%= at(B.floor).toFixed(2) %>%"><%- t('economy.band.floor') %><br><%= sh(B.floor) %></span>
              <span style="left:<%= at(B.ceiling).toFixed(2) %>%"><%- t('economy.band.ceiling') %><br><%= sh(B.ceiling) %></span>
            </div>
          </div>
          <p class="num fed-now"><%- t('economy.band.fed_now', { n: nf(L.fed) }) %></p>
          <div class="glegend">
            <div class="<%= zone === 'lo' ? 'on' : '' %>"><b><%- t('economy.band.lo_h') %></b><%- t('economy.band.lo') %></div>
            <div class="<%= zone === 'ok' ? 'on' : '' %>"><b><%- t('economy.band.ok_h') %></b><%- t('economy.band.ok') %></div>
            <div class="<%= zone === 'hi' ? 'on' : '' %>"><b><%- t('economy.band.hi_h') %></b><%- t('economy.band.hi') %></div>
          </div>
        <% } else { %>
          <p><%- t('economy.band.none') %></p>
        <% } %>
      </section>

      <!-- where PAT sits -->
      <section class="ds-card lg ep" aria-labelledby="sitsH">
        <div class="ds-eyebrow ac"><%- t('economy.sits.k') %></div>
        <h2 class="ds-h2" id="sitsH"><span class="ds-ic" aria-hidden="true">🧭</span> <%- t('economy.sits.h') %></h2>
        <% const LY = L.supply ? (L.supply.layers || []).filter((g) => g.amount > 0) : []; const tot = LY.reduce((a, g) => a + g.amount, 0) || 1; %>
        <% if (LY.length) { %>
          <div class="stack" role="img" aria-label="<%- t('economy.sits.aria') %>">
            <% LY.forEach((g) => { %><i style="flex:<%= g.amount %> 1 0;background:<%= LAYER_C[g.key] || '#888' %>" title="<%= g.label %>: <%= nf(g.amount) %> PAT"></i><% }) %>
          </div>
          <ul class="lg">
            <% LY.forEach((g) => { %>
              <li><i style="background:<%= LAYER_C[g.key] || '#888' %>"></i><span><%= g.label %><small><%= g.blurb %></small></span><b><%= nf(g.amount) %> <span class="muted">· <%= (g.amount / tot * 100).toFixed(1) %>%</span></b></li>
            <% }) %>
          </ul>
          <p class="ds-fine"><%- t('economy.sits.more', { link: '<a href="/rankings#supply">' + t('economy.sits.link') + '</a>' }) %></p>
        <% } else { %><p><%- t('economy.not_reported') %></p><% } %>
      </section>
    </div>

    <div class="duo">
      <!-- incentive budget -->
      <section class="ds-card lg ep" aria-labelledby="ibH">
        <div class="ds-eyebrow ac"><%- t('economy.ib.k') %></div>
        <h2 class="ds-h2" id="ibH"><span class="ds-ic" aria-hidden="true">🎁</span> <%- t('economy.ib.h') %></h2>
        <% if (INC) { const gs = Object.keys(INC.budgets || {}).sort((a, b) => (INC.budgets[b] || 0) - (INC.budgets[a] || 0)); %>
          <p><%- t('economy.ib.lead', { n: nf(INC.balance) }) %></p>
          <ul class="bars">
            <% gs.forEach((g) => { const b = INC.budgets[g] || 0, r = Math.min(b, (INC.remaining || {})[g] || 0); %>
              <li class="<%= g === 'activity' ? 'hl' : '' %>"><span class="bl"><span><%- GROUP[g] || t.esc(g) %><%- g === 'activity' ? SOON : '' %></span><b><%- t('economy.ib.left', { r: sh(r), b: sh(b) }) %></b></span>
                <span class="track" role="img" aria-label="<%- t('economy.ib.aria', { r: nf(r), b: nf(b) }) %>"><span class="fill" style="display:block;width:<%= b ? (r / b * 100).toFixed(1) : 0 %>%"></span></span></li>
            <% }) %>
          </ul>
          <p class="ds-fine"><%- t('economy.ib.foot_v3', { target: sh(V3.target) }) %><% if (INC.share != null) { %> <%- t('economy.ib.share', { n: nf(INC.share) }) %><% } %></p>
        <% } else { %>
          <p><%- t('economy.ib.off') %></p>
        <% } %>
      </section>

      <!-- vaults -->
      <section class="ds-card lg ep" aria-labelledby="vH">
        <div class="ds-eyebrow ac"><%- t('economy.v.k') %></div>
        <h2 class="ds-h2" id="vH"><span class="ds-ic" aria-hidden="true">🏰</span> <%- t('economy.v.h') %></h2>
        <div class="vts">
          <div class="vt" style="--c:#e57373"><b><span class="ds-ic" aria-hidden="true">🎰</span> <%- t('economy.v.house') %></b><span class="v"><%= sh(P.jackpot) %></span><small><%- t('economy.v.house_d') %></small></div>
          <div class="vt" style="--c:#ffcf40"><b><span class="ds-ic" aria-hidden="true">🏰</span> <%- t('economy.v.fortknox') %></b><span class="v"><%= L.fortknox == null ? '—' : sh(L.fortknox) %></span><small><%- t('economy.v.fortknox_d') %></small></div>
          <div class="vt" style="--c:#c98500"><b><span class="ds-ic" aria-hidden="true">🎲</span> <%- t('economy.v.casino') %></b><span class="v"><%= P['vault:heist'] == null ? '—' : sh(P['vault:heist']) %></span><small><%- t('economy.v.casino_d') %></small></div>
          <div class="vt" style="--c:#d55181"><b><span class="ds-ic" aria-hidden="true">🎟️</span> <%- t('economy.v.lotto') %></b><span class="v"><%= P['vault:lotto'] == null ? '—' : sh(P['vault:lotto']) %></span><small><%- t('economy.v.lotto_d') %></small></div>
          <div class="vt" style="--c:#64b5f6"><b><span class="ds-ic" aria-hidden="true">🏦</span> <%- t('economy.v.bank') %></b><span class="v"><%= P['vault:bank'] == null ? '—' : sh(P['vault:bank']) %></span><small><%- t('economy.v.bank_d') %></small></div>
          <div class="vt" style="--c:#81c784"><b><span class="ds-ic" aria-hidden="true">📈</span> <%- t('economy.v.mm') %></b><span class="v"><%= P['vault:mm'] == null ? '—' : sh(P['vault:mm']) %></span><small><%- t('economy.v.mm_d') %></small></div>
        </div>
        <p class="ds-fine"><%- t('economy.v.foot', { link: '<a href="/staking">' + t('economy.v.staking') + '</a>' }) %></p>
      </section>
    </div>

    <!-- supply history -->
    <% const H = L.history || []; %>
    <section class="ds-card lg ep" id="supply-history" aria-labelledby="shH">
      <div class="ds-eyebrow ac"><%- t('economy.sh.k') %></div>
      <h2 class="ds-h2" id="shH"><span class="ds-ic" aria-hidden="true">📈</span> <%- t('economy.sh.h') %></h2>
      <% if (H.length < 1) { %><p><%- t('economy.sh.none') %></p><% } else {
           // one slot per day: points and bars sit at the slot centres, always inside X0..X1, so 1-2 days of data no
           // longer spill over the axis labels; axis labels get enough decimals to differ; burned is labelled below 0.
           const W = 640, X0 = 80, X1 = W - 8, n = H.length, slot = (X1 - X0) / n, xs = (i) => X0 + slot * (i + 0.5);
           const bw = Math.max(1, Math.min(slot * 0.7, 48));
           const line = (vals, y) => vals.map((v, i) => v == null ? null : (xs(i).toFixed(1) + ',' + y(v).toFixed(1))).filter(Boolean).join(' ');
           const ticks = (lo, hi, k) => { const out = []; for (let j = 0; j <= k; j++) out.push(lo + (hi - lo) * j / k); return out; };
           const niceStep = (x) => { const p = Math.pow(10, Math.floor(Math.log10(x))), f = x / p; return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 2.5 ? 2.5 : f <= 5 ? 5 : 10) * p; };
           // tick labels in one unit, with as many decimals as it takes for the ticks to read differently
           const tickLbls = (vals) => {
             const a = Math.max(...vals.map(Math.abs)), U = a >= 1e15 ? [1e15, 'Q'] : a >= 1e12 ? [1e12, 'T'] : a >= 1e9 ? [1e9, 'B'] : a >= 1e6 ? [1e6, 'M'] : a >= 1e3 ? [1e3, 'k'] : [1, ''];
             let out = [];
             for (let d = 0; d <= 6; d++) { out = vals.map((v) => (v / U[0]).toFixed(d) + U[1]); if (new Set(out).size === out.length) break; }
             return out;
           };
           const lbl = (d) => d.slice(5);
           const xl = [...new Set([0, Math.floor((n - 1) / 2), n - 1])];
           const xlx = (i) => n > 6 && i === 0 ? X0 : n > 6 && i === n - 1 ? X1 : xs(i);
           const xla = (i) => n > 6 && i === 0 ? 'start' : n > 6 && i === n - 1 ? 'end' : 'middle';
           // 1) total supply: nice ticks over a span of at least 0.1% of the supply, so nearly flat data stays readable
           const tv = H.map((h) => h.total), tmin = Math.min(...tv), tmax = Math.max(...tv);
           const tspan = Math.max(tmax - tmin, Math.abs(tmax) * 0.001, 10), tstep = niceStep(tspan * 1.3 / 3);
           const tlo = Math.max(0, Math.floor((tmin - tspan * 0.15) / tstep) * tstep), thi = Math.ceil((tmax + tspan * 0.15) / tstep) * tstep;
           const tticks = []; for (let j = 0; tlo + j * tstep <= thi + tstep / 2; j++) tticks.push(tlo + j * tstep);
           const ttl = tickLbls(tticks), ty = (v) => 150 - (v - tlo) / (thi - tlo || 1) * 130;
           // 2) the Fed with its floor and ceiling
           const fv = H.map((h) => h.fed), fmaxv = Math.max(...fv.filter((v) => v != null), ...H.map((h) => h.ceiling || 0), 1);
           const fy = (v) => 150 - v / (fmaxv * 1.1) * 130;
           // 3) minted up, burned down
           const mmax = Math.max(1, ...H.map((h) => Math.max(h.minted, h.burned)));
           const my = (v) => v / mmax * 46; %>
        <div class="chart">
          <div class="ttl"><span><%- t('economy.sh.total') %></span><b class="num"><%= nf(tv[n - 1]) %></b></div>
          <svg viewBox="0 0 <%= W %> 172" role="img" aria-label="<%- t('economy.sh.total_aria', { from: nf(tv[0]), to: nf(tv[n - 1]), days: n }) %>">
            <% tticks.forEach((v, j) => { %><line x1="<%= X0 %>" x2="<%= X1 %>" y1="<%= ty(v).toFixed(1) %>" y2="<%= ty(v).toFixed(1) %>" stroke="#262626"/><text class="yl" x="<%= X0 - 6 %>" y="<%= (ty(v) + 4).toFixed(1) %>" text-anchor="end"><%= ttl[j] %></text><% }) %>
            <% if (n > 1) { %><polyline points="<%= line(tv, ty) %>" fill="none" stroke="#e0a830" stroke-width="2" stroke-linejoin="round"/><% } %>
            <circle cx="<%= xs(n - 1).toFixed(1) %>" cy="<%= ty(tv[n - 1]).toFixed(1) %>" r="3" fill="#e0a830"/>
            <% xl.forEach((i) => { %><text x="<%= xlx(i).toFixed(1) %>" y="168" text-anchor="<%= xla(i) %>"><%= lbl(H[i].day) %></text><% }) %>
            <% H.forEach((h, i) => { %><rect class="hit" x="<%= (X0 + slot * i).toFixed(1) %>" y="10" width="<%= slot.toFixed(1) %>" height="142"><title><%= h.day %>: <%= nf(h.total) %> PAT</title></rect><% }) %>
          </svg>
        </div>
        <div class="chart">
          <div class="ttl"><span><%- t('economy.sh.fed') %></span><b class="num"><%= fv[n - 1] == null ? '—' : nf(fv[n - 1]) %></b></div>
          <div class="key" aria-hidden="true"><span><i style="background:#3a8ad0"></i><%- t('economy.tile.fed') %></span><span><i class="dash"></i><%- t('economy.sh.band') %></span></div>
          <svg viewBox="0 0 <%= W %> 172" role="img" aria-label="<%- t('economy.sh.fed_aria', { to: fv[n - 1] == null ? '—' : nf(fv[n - 1]), days: n }) %>">
            <% const fticks = ticks(0, fmaxv * 1.1, 3), ftl = tickLbls(fticks); fticks.forEach((v, j) => { %><line x1="<%= X0 %>" x2="<%= X1 %>" y1="<%= fy(v).toFixed(1) %>" y2="<%= fy(v).toFixed(1) %>" stroke="#262626"/><text class="yl" x="<%= X0 - 6 %>" y="<%= (fy(v) + 4).toFixed(1) %>" text-anchor="end"><%= j === 0 ? '0' : ftl[j] %></text><% }) %>
            <% const fl = line(H.map((h) => h.floor), fy), cl = line(H.map((h) => h.ceiling), fy); %>
            <% if (fl) { %><polyline points="<%= fl %>" fill="none" stroke="#888" stroke-width="1.5" stroke-dasharray="5 4"/><% } %>
            <% if (cl) { %><polyline points="<%= cl %>" fill="none" stroke="#888" stroke-width="1.5" stroke-dasharray="5 4"/><% } %>
            <% if (n > 1) { %><polyline points="<%= line(fv, fy) %>" fill="none" stroke="#3a8ad0" stroke-width="2" stroke-linejoin="round"/><% } %>
            <% if (fv[n - 1] != null) { %><circle cx="<%= xs(n - 1).toFixed(1) %>" cy="<%= fy(fv[n - 1]).toFixed(1) %>" r="3" fill="#3a8ad0"/><% } %>
            <% const lastB = [...H].reverse().find((h) => h.ceiling != null); if (lastB) { %>
              <text x="<%= X1 %>" y="<%= (fy(lastB.ceiling) - 5).toFixed(1) %>" text-anchor="end"><%- t('economy.band.ceiling') %></text>
              <text x="<%= X1 %>" y="<%= (fy(lastB.floor) - 5).toFixed(1) %>" text-anchor="end"><%- t('economy.band.floor') %></text>
            <% } %>
            <% xl.forEach((i) => { %><text x="<%= xlx(i).toFixed(1) %>" y="168" text-anchor="<%= xla(i) %>"><%= lbl(H[i].day) %></text><% }) %>
            <% H.forEach((h, i) => { %><rect class="hit" x="<%= (X0 + slot * i).toFixed(1) %>" y="10" width="<%= slot.toFixed(1) %>" height="142"><title><%= h.day %>: <%= h.fed == null ? '—' : nf(h.fed) %> PAT<%= h.floor != null ? ' (' + sh(h.floor) + '–' + sh(h.ceiling) + ')' : '' %></title></rect><% }) %>
          </svg>
        </div>
        <div class="chart">
          <div class="ttl"><span><%- t('economy.sh.flows') %></span></div>
          <div class="key" aria-hidden="true"><span><i class="sq" style="background:#3a8ad0"></i><%- t('economy.sh.minted') %></span><span><i class="sq" style="background:#d65f36"></i><%- t('economy.sh.burned') %></span></div>
          <svg viewBox="0 0 <%= W %> 124" role="img" aria-label="<%- t('economy.sh.flows_aria', { m: nf(H.reduce((a, h) => a + h.minted, 0)), b: nf(H.reduce((a, h) => a + h.burned, 0)), days: n }) %>">
            <defs><clipPath id="shFlowClip"><rect x="<%= X0 %>" y="4" width="<%= X1 - X0 %>" height="104"/></clipPath></defs>
            <line x1="<%= X0 %>" x2="<%= X1 %>" y1="56" y2="56" stroke="#444"/>
            <text class="yl" x="<%= X0 - 6 %>" y="14" text-anchor="end"><%= sh(mmax) %></text><text class="yl" x="<%= X0 - 6 %>" y="60" text-anchor="end">0</text><text class="yl" x="<%= X0 - 6 %>" y="106" text-anchor="end">−<%= sh(mmax) %></text>
            <g class="bars" clip-path="url(#shFlowClip)">
            <% H.forEach((h, i) => { const x = (xs(i) - bw / 2).toFixed(1); %>
              <% if (h.minted > 0) { const hh = Math.max(1.5, my(h.minted)); %><rect x="<%= x %>" y="<%= (55 - hh).toFixed(1) %>" width="<%= bw.toFixed(1) %>" height="<%= hh.toFixed(1) %>" rx="1.5" fill="#3a8ad0"/><% } %>
              <% if (h.burned > 0) { const hh = Math.max(1.5, my(h.burned)); %><rect x="<%= x %>" y="57" width="<%= bw.toFixed(1) %>" height="<%= hh.toFixed(1) %>" rx="1.5" fill="#d65f36"/><% } %>
            <% }) %>
            </g>
            <% xl.forEach((i) => { %><text x="<%= xlx(i).toFixed(1) %>" y="120" text-anchor="<%= xla(i) %>"><%= lbl(H[i].day) %></text><% }) %>
            <% H.forEach((h, i) => { %><rect class="hit" x="<%= (X0 + slot * i).toFixed(1) %>" y="4" width="<%= slot.toFixed(1) %>" height="104"><title><%= h.day %>: <%- t('economy.sh.minted') %> <%= nf(h.minted) %><%= Object.keys(h.mints || {}).length ? ' (' + Object.entries(h.mints).filter((e) => e[1] > 0).map((e) => e[0] + ' ' + sh(e[1])).join(', ') + ')' : '' %> · <%- t('economy.sh.burned') %> <%= nf(h.burned) %></title></rect><% }) %>
          </svg>
        </div>
        <details class="data">
          <summary><%- t('economy.sh.table', { n: Math.min(14, n) }) %></summary>
          <div class="ds-tbl"><table>
            <thead><tr><th><%- t('economy.sh.day') %></th><th><%- t('economy.sh.total') %></th><th><%- t('economy.tile.fed') %></th><th><%- t('economy.sh.minted') %></th><th><%- t('economy.sh.burned') %></th></tr></thead>
            <tbody>
              <% H.slice(-14).reverse().forEach((h) => { %><tr><td><%= h.day %></td><td class="n"><%= nf(h.total) %></td><td><%= h.fed == null ? '—' : nf(h.fed) %></td><td><%= nf(h.minted) %></td><td><%= nf(h.burned) %></td></tr><% }) %>
            </tbody>
          </table></div>
        </details>
      <% } %>
    </section>
  </div>
  <% } %>

