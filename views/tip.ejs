<%# views/tip.ejs — send PAT to another user (route: GET/POST /u/:username/tip in index.js) %>
<%- include('layout', { title: `Tip ${displayname || usernameProfile}`, user: username }) %>
<%
  const fmt = (n) => Math.floor(Number(n) || 0).toLocaleString('en-US');
  const name = displayname || usernameProfile;
  const role = (classh || '').toLowerCase();
  const pc = typeof profileCosmetics !== 'undefined' && profileCosmetics ? profileCosmetics : null;
  const cx = (k) => (pc && pc.equipped && pc.equipped[k] ? pc.equipped[k].r : null);
  const cxName = cx('name_color'), cxBorder = cx('profile_border'), cxBanner = cx('profile_banner');
  const showcase = (pc && pc.showcase ? pc.showcase : []).slice(0, 4);
  const av = typeof gtfAvatar !== 'undefined' && gtfAvatar ? gtfAvatar : null;
  const profileHref = '/u/' + encodeURIComponent(usernameProfile);
  const tipHref = '/u/' + encodeURIComponent(usernameProfile) + '/tip';
  const signedIn = !!username;
  const canTip = signedIn && !isSelf;
  const CHIPS = [[1000, '1k'], [5000, '5k'], [10000, '10k'], [50000, '50k'], [100000, '100k']];
  // SQLite "YYYY-MM-DD HH:MM:SS" (UTC) -> ISO
  const iso = (ts) => String(ts || '').replace(' ', 'T') + 'Z';
  // owner's tip-jar dashboard (isSelf); see tipJarData() in index.js
  const J = typeof jar !== 'undefined' && jar ? jar : null;
  const escH = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const nameOf = (u) => !u.username ? 'Someone' : (typeof cosmeticNameHtml === 'function'
    ? cosmeticNameHtml(u.username, u.displayname || u.username) : escH(u.displayname || u.username));
  const profOf = (u) => '/u/' + encodeURIComponent(u.username);
  const isFresh = (t) => !!(J && J.seenAt && t.timestamp > J.seenAt);
%>
<%- include('partials/cosmetics-css') %>
<style>
  .tp { width: 100%; max-width: 640px; margin: 0 auto; padding: 18px 16px 56px; font-family: Ubuntu, sans-serif; color: #e6e6e6; display: grid; gap: 16px; box-sizing: border-box; }
  .tp *, .tp *::before, .tp *::after { box-sizing: border-box; }
  .tp a { color: #81c784; text-decoration: none; }
  .tp a:hover { color: #a5d6a7; }
  .tp .card { background: #111; border: 1px solid #222; border-radius: 14px; padding: 18px 20px; min-width: 0; }
  .tp h2 { margin: 0 0 12px; letter-spacing: .1em; text-transform: uppercase; color: #ffd700; font-family: 'Press Start 2P', monospace; font-size: 11px; line-height: 1.6; overflow-wrap: anywhere; }
  .tp .muted { color: #888; font-size: 13px; }
  .tp .crumb { font-size: 13px; color: #888; }

  /* recipient */
  .tp .hero { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 16px 18px; align-items: center;
              background: radial-gradient(120% 140% at 0% 0%, #17301a 0%, #111 55%); }
  .tp .av { width: 104px; height: 104px; border-radius: 14px; border: 1px solid #2a2a2a; display: grid; place-items: center; overflow: hidden;
            background: repeating-conic-gradient(#151515 0% 25%, #101010 0% 50%) 50% / 16px 16px; }
  .tp .av svg { display: block; width: 96px; height: 96px; image-rendering: pixelated; shape-rendering: crispEdges; }
  .tp .av img { width: 100%; height: 100%; object-fit: cover; }
  .tp .who { min-width: 0; }
  .tp .kicker { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #9a9; }
  .tp .who h1 { margin: 2px 0 0; font-size: 26px; line-height: 1.15; overflow-wrap: anywhere; }
  .tp .handle { color: #9a9; font-size: 14px; margin-top: 2px; overflow-wrap: anywhere; }
  .tp .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .tp .chip { font-size: 12px; padding: 3px 10px; border-radius: 999px; border: 1px solid #2c3a2d; background: #0f1a10; color: #b9d8bb; }
  .tp .chip.admin { border-color: #6b4fa0; background: #1a1326; color: #cbb6f2; }
  .tp .chip.staff { border-color: #2f6d8f; background: #10202a; color: #a9d7f0; }
  .tp .showcase { display: flex; flex-wrap: wrap; gap: 6px; grid-column: 2; margin-top: -8px; min-width: 0; }
  .tp .pin { display: inline-flex; align-items: center; gap: 6px; background: rgba(0,0,0,.35); border: 1px solid #3a3a1c; border-radius: 10px; padding: 3px 9px 3px 3px; font-size: 12px; color: #e8e2b0; max-width: 100%; }
  .tp .pin img { width: 24px; height: 24px; object-fit: contain; image-rendering: pixelated; flex: none; }
  .tp .pin span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* buttons */
  .tp .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 16px; border-radius: 8px; border: 1px solid #2b2b2b;
             background: #181818; color: #ddd !important; font-size: 15px; cursor: pointer; font-family: inherit; min-height: 44px; }
  .tp .btn:hover { border-color: #4caf50; }
  .tp .btn.primary { background: #4caf50; border-color: #4caf50; color: #fff !important; font-weight: bold; }
  .tp .btn.primary:hover { background: #43a047; }
  .tp .btn[disabled] { opacity: .5; cursor: not-allowed; }
  .tp .btn:focus-visible, .tp .amt-chip:focus-visible, .tp input:focus-visible { outline: 2px solid #c6e94f; outline-offset: 2px; }
  .tp .row { display: flex; flex-wrap: wrap; gap: 8px; }
  .tp .row .btn { flex: 1 1 160px; }

  /* send */
  .tp .bal { display: flex; justify-content: space-between; align-items: baseline; gap: 8px 12px; flex-wrap: wrap; margin-bottom: 14px;
             padding: 10px 14px; background: #0d0d0d; border: 1px solid #1f1f1f; border-radius: 10px; }
  .tp .bal .k { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #888; }
  .tp .bal .v { font-size: 20px; font-weight: bold; color: #ffd700; font-variant-numeric: tabular-nums; }
  .tp label.lbl { display: block; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: #aaa; margin: 0 0 6px; }
  .tp .amt-wrap { position: relative; }
  .tp .amt-wrap input { width: 100%; font: inherit; font-size: 24px; font-weight: bold; font-variant-numeric: tabular-nums; color: #fff; background: #0b0b0b;
                        border: 1px solid #2b2b2b; border-radius: 10px; padding: 12px 64px 12px 14px; min-height: 54px; }
  .tp .amt-wrap .unit { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: #ffd700; font-weight: bold; font-size: 14px; pointer-events: none; }
  .tp input[aria-invalid="true"] { border-color: #e57373; }
  .tp .amt-chips { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; margin-top: 10px; }
  .tp .amt-chip { font: inherit; font-size: 14px; font-weight: bold; color: #cfe8d0; background: #0f1a10; border: 1px solid #2c3a2d; border-radius: 999px; padding: 8px 0; min-height: 40px; cursor: pointer; }
  .tp .amt-chip:hover { border-color: #4caf50; }
  .tp .amt-chip[aria-pressed="true"] { background: #4caf50; border-color: #4caf50; color: #fff; }
  .tp .amt-chip[disabled] { opacity: .35; cursor: not-allowed; }
  .tp .hint { min-height: 20px; font-size: 13px; color: #9a9; margin-top: 8px; font-variant-numeric: tabular-nums; }
  .tp .hint.err { color: #ef9a9a; }
  .tp #tp-c-err:empty, .tp #tp-share-msg:empty { display: none; }
  .tp .note-wrap { margin-top: 14px; }
  .tp .note-wrap input { width: 100%; font: inherit; font-size: 15px; color: #eee; background: #0b0b0b; border: 1px solid #2b2b2b; border-radius: 10px; padding: 11px 14px; min-height: 44px; }
  .tp .note-meta { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; color: #777; margin-top: 4px; }
  .tp .send-row { margin-top: 16px; }

  /* confirm */
  .tp .sum { display: grid; gap: 0; background: #0d0d0d; border: 1px solid #1f1f1f; border-radius: 10px; margin-bottom: 14px; }
  .tp .sum > div { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 10px 14px; border-top: 1px solid #1a1a1a; font-variant-numeric: tabular-nums; }
  .tp .sum > div:first-child { border-top: 0; }
  .tp .sum .k { color: #999; font-size: 14px; flex: none; }
  .tp .sum .v { text-align: right; min-width: 0; overflow-wrap: anywhere; }
  .tp .sum .big { font-size: 26px; font-weight: bold; color: #ffd700; }
  .tp .sum .neg { color: #ef9a9a; }
  .tp .sum .note { font-style: italic; color: #d8d3b0; }
  .tp .warn { font-size: 13px; color: #e8cf7a; background: #1d1a10; border: 1px solid #5a4a1c; border-radius: 8px; padding: 8px 12px; margin-bottom: 14px; }

  /* success */
  .tp .done { text-align: center; position: relative; overflow: hidden; }
  .tp .done .big-check { width: 72px; height: 72px; margin: 6px auto 10px; border-radius: 50%; display: grid; place-items: center; font-size: 36px;
                         background: radial-gradient(circle at 35% 30%, #81c784, #2e7d32); box-shadow: 0 0 0 8px rgba(76,175,80,.15); }
  .tp .done h3:focus, .tp h2:focus { outline: none; }
  .tp .done h3 { margin: 0; font-size: 22px; overflow-wrap: anywhere; }
  .tp .done .amt { color: #ffd700; }
  .tp .done p { margin: 8px 0 16px; }
  .tp .burst { position: absolute; inset: 0; pointer-events: none; }
  .tp .burst i { position: absolute; left: 50%; top: 52px; width: 9px; height: 9px; border-radius: 2px; opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .tp .done.go .big-check { animation: tp-pop .45s cubic-bezier(.2, 1.6, .4, 1) both; }
    .tp .done.go .burst i { animation: tp-fly 1.1s ease-out forwards; animation-delay: var(--d, 0s); }
  }
  @keyframes tp-pop { from { transform: scale(.3); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @keyframes tp-fly { 0% { opacity: 1; transform: translate(-50%, 0) rotate(0); }
                      100% { opacity: 0; transform: translate(calc(-50% + var(--x)), var(--y)) rotate(var(--r)); } }

  /* history */
  .tp .totals { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }
  .tp .tot { background: #0d0d0d; border: 1px solid #1f1f1f; border-radius: 10px; padding: 10px 12px; min-width: 0; }
  .tp .tot .k { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: #888; }
  .tp .tot .v { font-size: 18px; font-weight: bold; font-variant-numeric: tabular-nums; margin-top: 2px; overflow-wrap: anywhere; }
  .tp ul.tips { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .tp ul.tips li { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 4px 10px; align-items: center; background: #0d0d0d;
                   border: 1px solid #1f1f1f; border-radius: 8px; padding: 8px 12px; font-size: 14px; }
  .tp ul.tips .ic { font-size: 18px; text-align: center; }
  .tp ul.tips .what { min-width: 0; overflow-wrap: anywhere; }
  .tp ul.tips .when { color: #777; font-size: 12px; }
  .tp ul.tips .pts { font-weight: bold; font-variant-numeric: tabular-nums; text-align: right; }
  .tp ul.tips .pts.out { color: #ef9a9a; }
  .tp ul.tips .pts.in { color: #81c784; }
  .tp ul.tips .tnote { grid-column: 2 / -1; font-size: 13px; font-style: italic; color: #b9b9a0; overflow-wrap: anywhere; }
  .tp ul.tips li.fresh { border-color: #2f5d31; background: #0f1a10; }

  /* owner's tip jar */
  .tp .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .tp .stats .tot.hl { grid-column: 1 / -1; background: radial-gradient(120% 160% at 0% 0%, #2a2410 0%, #0d0d0d 60%); border-color: #3a3a1c; }
  .tp .stats .tot.hl .v { font-size: 28px; color: #ffd700; }
  .tp .stats .sub { font-size: 12px; color: #888; margin-top: 2px; }
  .tp .newpill { display: inline-block; margin-left: 8px; padding: 1px 8px; border-radius: 999px; background: #4caf50; color: #fff; font-family: Ubuntu, sans-serif; font-size: 11px; font-weight: bold; letter-spacing: .04em; vertical-align: middle; }
  .tp ol.top { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .tp ol.top li { display: grid; grid-template-columns: 22px 40px minmax(0, 1fr) auto; gap: 10px; align-items: center; background: #0d0d0d; border: 1px solid #1f1f1f; border-radius: 10px; padding: 8px 12px; }
  .tp ol.top .rk { font-weight: bold; color: #888; text-align: center; font-variant-numeric: tabular-nums; }
  .tp ol.top li:nth-child(1) .rk { color: #ffd700; }
  .tp ol.top li:nth-child(2) .rk { color: #cfd8dc; }
  .tp ol.top li:nth-child(3) .rk { color: #d7a26b; }
  .tp .mini { width: 40px; height: 40px; border-radius: 8px; overflow: hidden; border: 1px solid #2a2a2a; display: grid; place-items: center; background: #101010; flex: none; }
  .tp .mini svg { width: 38px; height: 38px; image-rendering: pixelated; shape-rendering: crispEdges; display: block; }
  .tp .mini img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tp .mini.sm { width: 28px; height: 28px; border-radius: 6px; }
  .tp ol.top .nm, .tp ul.jar .nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: bold; }
  .tp ol.top .nm a, .tp ul.jar .nm a { color: #e6e6e6; }
  .tp ol.top .meta { font-size: 12px; color: #888; font-weight: normal; }
  .tp ol.top .amt, .tp ul.jar .pts { font-weight: bold; font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
  .tp ol.top .amt { color: #ffd700; }
  .tp .tabs { display: flex; gap: 6px; margin: 0 0 12px; border-bottom: 1px solid #222; }
  .tp .tab { font: inherit; font-size: 14px; background: none; border: 0; border-bottom: 2px solid transparent; color: #999; padding: 8px 6px 10px; min-height: 44px; cursor: pointer; margin-bottom: -1px; }
  .tp .tab[aria-selected="true"] { color: #ffd700; border-bottom-color: #ffd700; font-weight: bold; }
  .tp .tab:focus-visible { outline: 2px solid #c6e94f; outline-offset: 2px; }
  .tp .tab .n { color: #777; font-weight: normal; font-size: 12px; }
  .tp ul.jar { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .tp ul.jar li { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 4px 10px; align-items: center; background: #0d0d0d; border: 1px solid #1f1f1f; border-radius: 8px; padding: 8px 12px; font-size: 14px; }
  .tp ul.jar li.fresh { border-color: #2f5d31; background: #0f1a10; }
  .tp ul.jar .line { min-width: 0; display: flex; align-items: baseline; gap: 6px; }
  .tp ul.jar .when { color: #777; font-size: 12px; white-space: nowrap; }
  .tp ul.jar .pts.in { color: #81c784; }
  .tp ul.jar .pts.out { color: #ef9a9a; }
  .tp ul.jar .tnote { grid-column: 2 / -1; font-size: 13px; font-style: italic; color: #b9b9a0; overflow-wrap: anywhere; }
  .tp .more { margin-top: 10px; width: 100%; }
  .tp .empty { text-align: center; padding: 18px 8px 6px; }
  .tp .empty .big { font-size: 40px; line-height: 1; }
  .tp .empty p { margin: 10px 0 14px; }

  .tp [hidden] { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  @media (max-width: 480px) {
    .tp { padding: 12px 12px 48px; gap: 12px; }
    .tp .card { padding: 16px 14px; }
    .tp .hero { grid-template-columns: 76px minmax(0, 1fr); gap: 12px 14px; }
    .tp .av { width: 76px; height: 76px; border-radius: 12px; }
    .tp .av svg { width: 70px; height: 70px; }
    .tp .who h1 { font-size: 22px; }
    .tp .handle { font-size: 13px; }
    .tp .chips { margin-top: 8px; }
    .tp .showcase { grid-column: 1 / -1; margin-top: 0; }
    .tp .cx-banner { margin: -16px -14px 0; }
    .tp .amt-chips { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 5px; }
    .tp .amt-chip { font-size: 13px; }
    .tp .sum .big { font-size: 22px; }
  }
</style>

<main class="tp">
  <div class="crumb"><a href="<%= profileHref %>">&larr; Back to <%= name %>'s profile</a></div>

  <section class="card hero cx-host" aria-labelledby="tp-name">
    <% if (cxBanner) { %><div class="cx-banner" style="<%= cxBanner.css %>" aria-hidden="true"></div><% } %>
    <div class="av">
      <% if (av && av.svg) { %><%- av.svg %><% } else { %><img src="<%= avatar || '/public/img/avatar.png' %>" alt="" onerror="this.src='/public/img/avatar.png'"><% } %>
    </div>
    <div class="who">
      <div class="kicker"><%= isSelf ? '💰 Your tip jar' : '💸 Tip jar' %></div>
      <h1 id="tp-name"><% if (cxName && cxName.css) { %><span class="cx-name" style="<%= cxName.css %>"><%= name %></span><% } else { %><%= name %><% } %></h1>
      <div class="handle"><a href="<%= profileHref %>" style="color:inherit">@<%= usernameProfile %></a><% if (camfrog) { %> · 🐸 <%= camfrog %><% } %></div>
      <div class="chips">
        <span class="chip">Level <%= level %></span>
        <% if (role && role !== 'pleb') { %><span class="chip <%= role %>"><%= classh %></span><% } %>
        <% if (badgeCount) { %><span class="chip">🏅 <%= badgeCount %> badge<%= badgeCount === 1 ? '' : 's' %></span><% } %>
      </div>
    </div>
    <% if (showcase.length) { %>
      <div class="showcase" aria-label="Pinned badges">
        <% showcase.forEach((b) => { %><span class="pin" title="<%= b.description %>"><img src="<%= b.icon %>" alt=""><span><%= b.name %></span></span><% }) %>
      </div>
    <% } %>
    <% if (cxBorder) { %><div class="cx-frame <%= cxBorder.cls %>" style="<%= cxBorder.css %>" aria-hidden="true"></div><% } %>
  </section>

  <% if (!signedIn) { %>
    <section class="card">
      <h2>Send a tip</h2>
      <p class="muted" style="margin-top:0">Sign in to send <%= name %> some PAT.</p>
      <div class="row"><a class="btn primary" href="/login">Sign in to tip</a><a class="btn" href="<%= profileHref %>">View profile</a></div>
    </section>
  <% } else if (isSelf) { const T = (J && J.totals) || {}; %>
    <section class="card" aria-labelledby="tj-title">
      <h2 id="tj-title">Your tip jar<% if (J && J.newCount) { %><span class="newpill"><%= J.newCount %> new</span><% } %></h2>
      <div class="stats">
        <div class="tot hl"><div class="k">Received all-time</div><div class="v"><%= fmt(T.recv) %> PAT</div>
          <div class="sub"><%= fmt(T.recvCount) %> tip<%= T.recvCount == 1 ? '' : 's' %> from <%= fmt(T.tippers) %> <%= T.tippers == 1 ? 'person' : 'people' %></div></div>
        <div class="tot"><div class="k">Last 7 days</div><div class="v" style="color:#81c784"><%= fmt(T.week) %></div></div>
        <div class="tot"><div class="k">Last 30 days</div><div class="v" style="color:#81c784"><%= fmt(T.month) %></div></div>
        <div class="tot"><div class="k">Tippers</div><div class="v"><%= fmt(T.tippers) %></div></div>
        <div class="tot"><div class="k">You've sent</div><div class="v" style="color:#ef9a9a"><%= fmt(T.sent) %></div></div>
      </div>
      <div class="row" style="margin-top:14px">
        <button class="btn primary" type="button" id="tp-share" data-url="<%= tipHref %>">🔗 Copy tip link</button>
        <a class="btn" href="/history">📜 PAT history</a>
      </div>
      <p class="hint" id="tp-share-msg" role="status" aria-live="polite"></p>
    </section>

    <% if (J && J.top && J.top.length) { %>
    <section class="card" aria-labelledby="tj-top-title">
      <h2 id="tj-top-title">Top tippers</h2>
      <ol class="top">
        <% J.top.forEach((u, i) => { %>
          <li>
            <span class="rk"><%= i + 1 %></span>
            <span class="mini" aria-hidden="true"><% if (J.avatars && J.avatars[u.username]) { %><%- J.avatars[u.username] %><% } else { %><img src="<%= u.avatar || '/public/img/avatar.png' %>" alt="" loading="lazy" onerror="this.onerror=null;this.src='/public/img/avatar.png'"><% } %></span>
            <span class="nm"><a href="<%= profOf(u) %>"><%- nameOf(u) %></a><br><span class="meta"><%= fmt(u.n) %> tip<%= u.n == 1 ? '' : 's' %> · last <span class="when" data-ts="<%= iso(u.last) %>"><%= String(u.last || '').slice(0, 10) %></span></span></span>
            <span class="amt"><%= fmt(u.total) %></span>
          </li>
        <% }) %>
      </ol>
    </section>
    <% } %>

    <section class="card" aria-labelledby="tj-list-title">
      <h2 id="tj-list-title" class="sr-only">Tips</h2>
      <div class="tabs" role="tablist" aria-label="Tips">
        <button class="tab" type="button" role="tab" id="tj-tab-received" aria-controls="tj-panel-received" aria-selected="true">Received <span class="n">(<%= fmt(T.recvCount) %>)</span></button>
        <button class="tab" type="button" role="tab" id="tj-tab-sent" aria-controls="tj-panel-sent" aria-selected="false" tabindex="-1">Sent <span class="n">(<%= fmt(T.sentCount) %>)</span></button>
      </div>
      <% [['received', J ? J.received : null], ['sent', J ? J.sent : null]].forEach(([kind, pg]) => { const items = (pg && pg.items) || []; const out = kind === 'sent'; %>
        <div role="tabpanel" id="tj-panel-<%= kind %>" aria-labelledby="tj-tab-<%= kind %>"<%= out ? ' hidden' : '' %>>
          <% if (items.length) { %>
            <ul class="jar" data-kind="<%= kind %>">
              <% items.forEach((t) => { %>
                <li<%- !out && isFresh(t) ? ' class="fresh"' : '' %>>
                  <span class="mini sm" aria-hidden="true"><img src="<%= t.avatar || '/public/img/avatar.png' %>" alt="" loading="lazy" onerror="this.onerror=null;this.src='/public/img/avatar.png'"></span>
                  <span class="line"><span class="nm"><% if (out) { %><span class="muted" style="font-weight:normal">to </span><% } %><% if (t.username) { %><a href="<%= profOf(t) %>"><%- nameOf(t) %></a><% } else { %>Someone<% } %></span><span class="when" data-ts="<%= iso(t.timestamp) %>"><%= String(t.timestamp || '').slice(0, 10) %></span></span>
                  <span class="pts <%= out ? 'out' : 'in' %>"><%= out ? '−' : '+' %><%= fmt(Math.abs(t.points)) %></span>
                  <% if (t.note) { %><span class="tnote">&ldquo;<%= t.note %>&rdquo;</span><% } %>
                </li>
              <% }) %>
            </ul>
            <% if (pg.more) { %><button class="btn more" type="button" data-more="<%= kind %>" data-offset="<%= items.length %>">Load more</button><% } %>
            <p class="hint err" data-more-err="<%= kind %>" role="alert" hidden></p>
          <% } else if (!out) { %>
            <div class="empty">
              <div class="big" aria-hidden="true">🫙</div>
              <p class="muted">No tips yet. Share your tip link in the Camfrog room or on Discord — every tip lands here with who sent it and their message.</p>
            </div>
          <% } else { %>
            <div class="empty"><p class="muted">You haven't tipped anyone yet. Open someone's profile and hit <b>💸 Tip</b>.</p></div>
          <% } %>
        </div>
      <% }) %>
    </section>
  <% } else { %>
    <section class="card" id="tp-card" aria-labelledby="tp-step-title">
      <!-- step 1: amount + note -->
      <form id="tp-form" novalidate>
        <h2 id="tp-step-title">Send a tip</h2>
        <div class="bal"><span class="k">Your balance</span><span class="v"><span id="tp-bal"><%= fmt(balance) %></span> PAT</span></div>

        <label class="lbl" for="tp-amt">Amount</label>
        <div class="amt-wrap">
          <input id="tp-amt" name="amount" type="text" inputmode="decimal" autocomplete="off" spellcheck="false"
                 placeholder="e.g. 25k" aria-describedby="tp-hint" required>
          <span class="unit" aria-hidden="true">PAT</span>
        </div>
        <div class="amt-chips" role="group" aria-label="Quick amounts">
          <% CHIPS.forEach(([v, l]) => { %>
            <button type="button" class="amt-chip" data-v="<%= v %>" aria-pressed="false"<%= v > balance ? ' disabled' : '' %> aria-label="<%= fmt(v) %> PAT"><%= l %></button>
          <% }) %>
        </div>
        <div class="hint" id="tp-hint" aria-live="polite">Type a number — <b>k</b> = thousand, <b>m</b> = million (2.5k = 2,500).</div>

        <div class="note-wrap">
          <label class="lbl" for="tp-note">Message <span style="text-transform:none;letter-spacing:0;color:#777">(optional)</span></label>
          <input id="tp-note" name="note" type="text" maxlength="<%= noteMax %>" autocomplete="off" placeholder="Say thanks, GG, for the DJ set…" aria-describedby="tp-note-meta">
          <div class="note-meta" id="tp-note-meta"><span><%= name %> sees this on their history.</span><span><span id="tp-note-n">0</span>/<%= noteMax %></span></div>
        </div>

        <div class="row send-row"><button class="btn primary" type="submit" id="tp-review">Review tip</button></div>
      </form>

      <!-- step 2: confirm -->
      <div id="tp-confirm" hidden>
        <h2 tabindex="-1" id="tp-confirm-title">Confirm your tip</h2>
        <div class="sum">
          <div><span class="k">To</span><span class="v"><b><%= name %></b> <span class="muted">@<%= usernameProfile %></span></span></div>
          <div><span class="k">Amount</span><span class="v big" id="tp-c-amt"></span></div>
          <div id="tp-c-note-row"><span class="k">Message</span><span class="v note" id="tp-c-note"></span></div>
          <div><span class="k">Your balance</span><span class="v"><span id="tp-c-before"></span> → <b id="tp-c-after"></b></span></div>
        </div>
        <div class="warn" id="tp-c-warn" hidden></div>
        <p class="muted" style="margin-top:0">Tips are instant and can't be undone. No fee — <%= name %> gets the full amount.</p>
        <div class="hint err" id="tp-c-err" role="alert"></div>
        <div class="row">
          <button class="btn primary" type="button" id="tp-send">Send tip</button>
          <button class="btn" type="button" id="tp-back">Back</button>
        </div>
      </div>

      <!-- step 3: done -->
      <div id="tp-done" class="done" hidden>
        <div class="burst" aria-hidden="true" id="tp-burst"></div>
        <div class="big-check" aria-hidden="true">✓</div>
        <h3 tabindex="-1" id="tp-done-title">Sent <span class="amt" id="tp-d-amt"></span> PAT to <%= name %></h3>
        <p class="muted">Your balance is now <b id="tp-d-bal" style="color:#ffd700"></b> PAT.</p>
        <div class="row">
          <button class="btn primary" type="button" id="tp-again">Tip again</button>
          <a class="btn" href="<%= profileHref %>">Back to profile</a>
        </div>
      </div>
    </section>

    <section class="card" aria-labelledby="tp-hist-title">
      <h2 id="tp-hist-title">You &amp; <%= name %></h2>
      <div class="totals">
        <div class="tot"><div class="k">You've tipped</div><div class="v" style="color:#ef9a9a"><span id="tp-sent-tot"><%= fmt(sentTotal) %></span> PAT</div></div>
        <div class="tot"><div class="k">They've tipped you</div><div class="v" style="color:#81c784"><%= fmt(recvTotal) %> PAT</div></div>
      </div>
      <ul class="tips" id="tp-list"<%= recent.length ? '' : ' hidden' %>>
        <% recent.forEach((t) => { const out = t.type === 'tip sent'; %>
          <li>
            <span class="ic" aria-hidden="true"><%= out ? '💸' : '💰' %></span>
            <span class="what"><%= out ? 'You tipped' : 'They tipped you' %> <span class="when" data-ts="<%= iso(t.timestamp) %>"><%= String(t.timestamp || '').slice(0, 10) %></span></span>
            <span class="pts <%= out ? 'out' : 'in' %>"><%= out ? '−' : '+' %><%= fmt(Math.abs(t.points)) %></span>
            <% if (t.note) { %><span class="tnote">&ldquo;<%= t.note %>&rdquo;</span><% } %>
          </li>
        <% }) %>
      </ul>
      <p class="muted" id="tp-empty" style="margin:0"<%= recent.length ? ' hidden' : '' %>>No tips between you two yet — be the first.</p>
    </section>
  <% } %>
</main>

<script>
(function () {
  var fmt = function (n) { return Math.floor(Number(n) || 0).toLocaleString('en-US'); };
  // relative times for the history list
  function ago(iso) {
    var t = Date.parse(iso); if (isNaN(t)) return null;
    var s = Math.max(0, (Date.now() - t) / 1000);
    if (s < 60) return 'just now';
    if (s < 3600) return Math.floor(s / 60) + 'm ago';
    if (s < 86400) return Math.floor(s / 3600) + 'h ago';
    if (s < 86400 * 30) return Math.floor(s / 86400) + 'd ago';
    return new Date(t).toLocaleDateString();
  }
  document.querySelectorAll('.tp .when[data-ts]').forEach(function (el) {
    var a = ago(el.getAttribute('data-ts')); if (a) { el.textContent = '· ' + a; el.title = new Date(el.getAttribute('data-ts')).toLocaleString(); }
  });

  var share = document.getElementById('tp-share');
  if (share) share.addEventListener('click', function () {
    var url = location.origin + share.getAttribute('data-url');
    var msg = document.getElementById('tp-share-msg');
    var ok = function () { msg.textContent = 'Copied: ' + url; };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(url).then(ok, function () { msg.textContent = url; });
    else msg.textContent = url;
  });

  // owner's tip jar: tabs + "load more"
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.tp .tab[role="tab"]'));
  function pick(tab) {
    tabs.forEach(function (t) {
      var on = t === tab;
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
    });
  }
  tabs.forEach(function (t, i) {
    t.addEventListener('click', function () { pick(t); });
    t.addEventListener('keydown', function (e) {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      var n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length]; pick(n); n.focus(); e.preventDefault();
    });
  });
  function jarRow(t, out) {
    var li = document.createElement('li');
    var mini = document.createElement('span'); mini.className = 'mini sm'; mini.setAttribute('aria-hidden', 'true');
    var img = document.createElement('img'); img.alt = ''; img.loading = 'lazy';
    img.onerror = function () { img.onerror = null; img.src = '/public/img/avatar.png'; };
    img.src = t.avatar || '/public/img/avatar.png';
    mini.appendChild(img); li.appendChild(mini);
    var line = document.createElement('span'); line.className = 'line';
    var nm = document.createElement('span'); nm.className = 'nm';
    if (out) { var to = document.createElement('span'); to.className = 'muted'; to.style.fontWeight = 'normal'; to.textContent = 'to '; nm.appendChild(to); }
    if (t.username) {
      var a = document.createElement('a'); a.href = '/u/' + encodeURIComponent(t.username);
      var label = t.displayname || t.username;
      if (t.nameCss) { var c = document.createElement('span'); c.className = 'cx-name'; c.setAttribute('style', t.nameCss); c.textContent = label; a.appendChild(c); }
      else a.textContent = label;
      nm.appendChild(a);
    } else nm.appendChild(document.createTextNode('Someone'));
    line.appendChild(nm);
    var w = document.createElement('span'); w.className = 'when';
    var iso = String(t.timestamp || '').replace(' ', 'T') + 'Z';
    w.textContent = ago(iso) || String(t.timestamp || '').slice(0, 10); w.title = new Date(iso).toLocaleString();
    line.appendChild(w); li.appendChild(line);
    var pts = document.createElement('span'); pts.className = 'pts ' + (out ? 'out' : 'in');
    pts.textContent = (out ? '−' : '+') + fmt(t.points); li.appendChild(pts);
    if (t.note) { var n = document.createElement('span'); n.className = 'tnote'; n.textContent = '“' + t.note + '”'; li.appendChild(n); }
    return li;
  }
  document.querySelectorAll('.tp [data-more]').forEach(function (btn) {
    var kind = btn.getAttribute('data-more');
    var list = document.querySelector('.tp ul.jar[data-kind="' + kind + '"]');
    var err = document.querySelector('.tp [data-more-err="' + kind + '"]');
    btn.addEventListener('click', function () {
      if (btn.disabled) return;
      btn.disabled = true; btn.textContent = 'Loading…'; err.hidden = true;
      var off = Number(btn.getAttribute('data-offset')) || 0;
      fetch('/api/tipjar?kind=' + encodeURIComponent(kind) + '&offset=' + off, { credentials: 'same-origin', headers: { accept: 'application/json' } })
        .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
        .then(function (d) {
          (d.items || []).forEach(function (t) { list.appendChild(jarRow(t, kind === 'sent')); });
          btn.setAttribute('data-offset', off + (d.items || []).length);
          btn.disabled = false; btn.textContent = 'Load more'; btn.hidden = !d.more;
        })
        .catch(function () { btn.disabled = false; btn.textContent = 'Load more'; err.textContent = 'Couldn’t load more tips — try again.'; err.hidden = false; });
    });
  });

  var form = document.getElementById('tp-form');
  if (!form) return;
  var TARGET = <%- JSON.stringify(usernameProfile).replace(/</g, '\\u003c') %>;
  var balance = <%= Number(balance) || 0 %>;
  var amtEl = document.getElementById('tp-amt'), hint = document.getElementById('tp-hint');
  var noteEl = document.getElementById('tp-note'), noteN = document.getElementById('tp-note-n');
  var chips = Array.prototype.slice.call(document.querySelectorAll('.tp .amt-chip'));
  var confirmEl = document.getElementById('tp-confirm'), doneEl = document.getElementById('tp-done');
  var sendBtn = document.getElementById('tp-send'), errEl = document.getElementById('tp-c-err');
  var HINT0 = hint.innerHTML;
  var pending = null;           // { amount, note, key }

  // Same rule as the rest of the site (cosmetics prices): 2500, 2,500, 2.5k, 1m, 1b.
  function parseAmt(v) {
    var m = String(v == null ? '' : v).trim().toLowerCase().replace(/[, _]/g, '').match(/^(\d+(?:\.\d+)?)([kmb])?$/);
    if (!m) return NaN;
    return Math.floor(Number(m[1]) * ({ k: 1e3, m: 1e6, b: 1e9 }[m[2]] || 1));
  }
  function check() {
    var raw = amtEl.value.trim();
    var n = parseAmt(raw);
    var bad = null;
    if (!raw) bad = '';
    else if (isNaN(n)) bad = 'Use a number like 2500, 25k or 1.5m.';
    else if (n < 1) bad = 'Tip at least 1 PAT.';
    else if (n > balance) bad = "That's more than your balance (" + fmt(balance) + ' PAT).';
    chips.forEach(function (c) {
      c.setAttribute('aria-pressed', String(Number(c.getAttribute('data-v')) === n));
      c.disabled = Number(c.getAttribute('data-v')) > balance;
    });
    if (bad === '') { hint.className = 'hint'; hint.innerHTML = HINT0; amtEl.removeAttribute('aria-invalid'); return null; }
    if (bad) { hint.className = 'hint err'; hint.textContent = bad; amtEl.setAttribute('aria-invalid', 'true'); return null; }
    hint.className = 'hint'; amtEl.removeAttribute('aria-invalid');
    hint.textContent = '= ' + fmt(n) + ' PAT · leaves you ' + fmt(balance - n) + ' PAT';
    return n;
  }
  amtEl.addEventListener('input', check);
  chips.forEach(function (c) {
    c.addEventListener('click', function () { amtEl.value = fmt(c.getAttribute('data-v')); check(); });
  });
  noteEl.addEventListener('input', function () { noteN.textContent = Array.from(noteEl.value).length; });

  function newKey() {
    if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
    return Date.now().toString(36) + Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2);
  }
  function show(step) {
    form.hidden = step !== 'form'; confirmEl.hidden = step !== 'confirm'; doneEl.hidden = step !== 'done';
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var n = check();
    if (n === null) {
      if (!amtEl.value.trim()) { hint.className = 'hint err'; hint.textContent = 'Enter an amount to tip.'; amtEl.setAttribute('aria-invalid', 'true'); }
      amtEl.focus(); return;
    }
    var note = noteEl.value.replace(/\s+/g, ' ').trim();
    pending = { amount: n, note: note, key: newKey() };   // one key per confirmed attempt (double-click / retry safe)
    document.getElementById('tp-c-amt').textContent = fmt(n) + ' PAT';
    document.getElementById('tp-c-note').textContent = note ? '“' + note + '”' : '';
    document.getElementById('tp-c-note-row').hidden = !note;
    document.getElementById('tp-c-before').textContent = fmt(balance);
    document.getElementById('tp-c-after').textContent = fmt(balance - n) + ' PAT';
    var warn = document.getElementById('tp-c-warn');
    var big = n >= balance * 0.5 && n >= 10000;
    warn.hidden = !big;
    if (big) warn.textContent = n === balance ? 'Heads up: this is your whole balance.' : 'Heads up: that’s ' + Math.round(n / balance * 100) + '% of your balance.';
    errEl.textContent = '';
    sendBtn.disabled = false; sendBtn.textContent = 'Send ' + fmt(n) + ' PAT';
    show('confirm');
    document.getElementById('tp-confirm-title').focus();
  });

  document.getElementById('tp-back').addEventListener('click', function () {
    pending = null; show('form'); amtEl.focus();
  });

  sendBtn.addEventListener('click', function () {
    if (!pending || sendBtn.disabled) return;
    sendBtn.disabled = true; sendBtn.textContent = 'Sending…'; errEl.textContent = '';
    var p = pending;
    fetch('/u/' + encodeURIComponent(TARGET) + '/tip', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'content-type': 'application/json', 'accept': 'application/json' },
      body: JSON.stringify({ amount: p.amount, note: p.note, idempotency_key: p.key }),
    }).then(function (r) {
      var ct = r.headers.get('content-type') || '';
      return (ct.indexOf('json') >= 0 ? r.json() : r.text().then(function (t) { return { message: t }; }))
        .then(function (d) { return { status: r.status, ok: r.ok, d: d || {} }; });
    }).then(function (res) {
      if (res.ok) return success(p, res.d);
      sendBtn.disabled = false; sendBtn.textContent = 'Try again';
      if (res.status === 409) { errEl.textContent = 'That tip is still going through — check your history before trying again.'; return; }
      if (res.status === 401) { errEl.innerHTML = 'You’ve been signed out. <a href="/login">Sign in</a> and try again.'; return; }
      var m = String(res.d.message || res.d.error || '');
      if (/insufficient/i.test(m)) m = 'You don’t have enough PAT for that any more.';
      else if (!m || m.length > 160) m = 'The tip didn’t go through — nothing was sent.';
      errEl.textContent = m;
      if (res.status !== 500) pending.key = newKey();   // a refused attempt is final; a fresh try gets a fresh key
    }).catch(function () {
      // Network error: we don't know if it landed. Keep the SAME key so a retry can't send twice.
      sendBtn.disabled = false; sendBtn.textContent = 'Retry';
      errEl.textContent = 'Couldn’t reach the server. Retrying is safe — it won’t send twice.';
    });
  });

  function success(p, d) {
    balance = typeof d.balance === 'number' ? d.balance : balance - p.amount;
    document.getElementById('tp-bal').textContent = fmt(balance);
    document.getElementById('tp-d-amt').textContent = fmt(p.amount);
    document.getElementById('tp-d-bal').textContent = fmt(balance);
    var st = document.getElementById('tp-sent-tot');
    st.textContent = fmt(Number(st.textContent.replace(/[^0-9]/g, '')) + p.amount);
    // prepend to the list
    var list = document.getElementById('tp-list');
    var li = document.createElement('li'); li.className = 'fresh';
    li.innerHTML = '<span class="ic" aria-hidden="true">💸</span><span class="what">You tipped <span class="when">· just now</span></span><span class="pts out"></span>';
    li.querySelector('.pts').textContent = '−' + fmt(p.amount);
    if (p.note) { var n = document.createElement('span'); n.className = 'tnote'; n.textContent = '“' + p.note + '”'; li.appendChild(n); }
    list.insertBefore(li, list.firstChild); list.hidden = false;
    while (list.children.length > 8) list.removeChild(list.lastChild);
    document.getElementById('tp-empty').hidden = true;
    pending = null;
    // celebration (CSS only animates when the user hasn't asked for reduced motion)
    var burst = document.getElementById('tp-burst'); burst.innerHTML = '';
    var cols = ['#ffd700', '#4caf50', '#c6e94f', '#81c784', '#ffb300', '#4fc3f7'];
    for (var i = 0; i < 26; i++) {
      var b = document.createElement('i'), a = (i / 26) * Math.PI * 2, dist = 70 + Math.random() * 90;
      b.style.background = cols[i % cols.length];
      b.style.setProperty('--x', Math.round(Math.cos(a) * dist * 1.6) + 'px');
      b.style.setProperty('--y', Math.round(Math.sin(a) * dist + 40) + 'px');
      b.style.setProperty('--r', Math.round(Math.random() * 540 - 270) + 'deg');
      b.style.setProperty('--d', (Math.random() * .15).toFixed(2) + 's');
      burst.appendChild(b);
    }
    doneEl.classList.remove('go'); void doneEl.offsetWidth; doneEl.classList.add('go');
    show('done');
    document.getElementById('tp-done-title').focus();
  }

  document.getElementById('tp-again').addEventListener('click', function () {
    amtEl.value = ''; noteEl.value = ''; noteN.textContent = '0'; check(); show('form'); amtEl.focus();
  });
  check();
})();
</script>
</body>
</html>
