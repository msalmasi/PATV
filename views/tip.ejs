<%# views/tip.ejs — send PAT to another user (route: GET/POST /u/:username/tip in index.js) %>
<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('tip.page_title', { name: displayname || usernameProfile }), user: username }) %>
<%
  const fmt = (n) => Math.floor(Number(n) || 0).toLocaleString('en-US');
  const name = displayname || usernameProfile;
  const role = (classh || '').toLowerCase();
  const pc = typeof profileCosmetics !== 'undefined' && profileCosmetics ? profileCosmetics : null;
  const cx = (k) => (pc && pc.equipped && pc.equipped[k] ? pc.equipped[k].r : null);
  const cxName = cx('name_color'), cxBorder = cx('profile_border'), cxBanner = cx('profile_banner');
  const showcase = (pc && pc.showcase ? pc.showcase : []).slice(0, 4);
  const av = typeof gtfAvatar !== 'undefined' && gtfAvatar ? gtfAvatar : null;
  const profileHref = '/u/' + encodeURIComponent(usernameProfile);
  const tipHref = '/u/' + encodeURIComponent(usernameProfile) + '/tip';
  const signedIn = !!username;
  const canTip = signedIn && !isSelf;
  const CHIPS = [[1000, '1k'], [5000, '5k'], [10000, '10k'], [50000, '50k'], [100000, '100k']];
  // SQLite "YYYY-MM-DD HH:MM:SS" (UTC) -> ISO
  const iso = (ts) => String(ts || '').replace(' ', 'T') + 'Z';
  // owner's tip-jar dashboard (isSelf); see tipJarData() in index.js
  const J = typeof jar !== 'undefined' && jar ? jar : null;
  const escH = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const nameOf = (u) => !u.username ? t('tip.someone') : (typeof cosmeticNameHtml === 'function'
    ? cosmeticNameHtml(u.username, u.displayname || u.username) : escH(u.displayname || u.username));
  const profOf = (u) => '/u/' + encodeURIComponent(u.username);
  const isFresh = (t) => !!(J && J.seenAt && t.timestamp > J.seenAt);
%>
<%- include('partials/cosmetics-css') %>
<style>
  /* tip: a money page - green area accent (links, chips), gold for PAT. Section headings: .ds-pixel-h (one style). */
  .tp { gap: var(--ds-sp-4); }
  .tp .card { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-5); min-width: 0; }
  .tp h2.ds-pixel-h { margin: 0 0 var(--ds-sp-4); overflow-wrap: anywhere; }
  .tp .muted { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); }
  .tp .ds-back { justify-self: start; display: inline-flex; align-items: center; min-height: 36px; font-size: var(--ds-fs-sm); }
  .tp .mut-opt { text-transform: none; letter-spacing: 0; font-weight: 400; color: var(--ds-text-faint); }

  /* recipient */
  .tp .hero { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--ds-sp-4) var(--ds-sp-5); align-items: center; border-radius: var(--ds-r-2xl);
              background: radial-gradient(90% 140% at 100% 0%, var(--ds-ac-bg), transparent 60%), radial-gradient(70% 120% at 0% 100%, rgba(255, 215, 64, .07), transparent 60%), #111; }
  .tp .hero .cx-banner { margin: calc(-1 * var(--ds-sp-5)) calc(-1 * var(--ds-sp-5)) 0; border-radius: 17px 17px 0 0; }
  .tp .av { width: 104px; height: 104px; border-radius: var(--ds-r-xl); border: 1px solid var(--ds-line-strong); display: grid; place-items: center; overflow: hidden;
            background: repeating-conic-gradient(#151515 0% 25%, #101010 0% 50%) 50% / 16px 16px; }
  .tp .av svg { display: block; width: 96px; height: 96px; image-rendering: pixelated; shape-rendering: crispEdges; }
  .tp .av img { width: 100%; height: 100%; object-fit: cover; }
  .tp .who { min-width: 0; display: grid; gap: 2px; }
  .tp .kicker { font: 700 var(--ds-fs-chip)/1.4 var(--ds-font); letter-spacing: var(--ds-ls-label); text-transform: uppercase; color: var(--ds-text-muted); }
  .tp .who h1 { margin: 0; font: 700 var(--ds-fs-h1)/var(--ds-lh-h1) var(--ds-font); color: var(--ds-text-strong); overflow-wrap: anywhere; }
  .tp .handle { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 6px; color: var(--ds-text-muted); font-size: var(--ds-fs-sm); overflow-wrap: anywhere; }
  .tp .handle a { color: inherit; }
  .tp .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-block-start: var(--ds-sp-2); }
  .tp .chips .ds-tag { font-size: var(--ds-fs-xs); padding: 2px 10px; }
  .tp .chips .ds-tag.admin { border-color: #6b4fa0; background: #1a1326; color: #cbb6f2; }
  .tp .chips .ds-tag.staff { border-color: var(--ds-info-line); background: var(--ds-info-bg); color: var(--ds-info); }
  .tp .showcase { display: flex; flex-wrap: wrap; gap: 6px; grid-column: 2; margin-block-start: calc(-1 * var(--ds-sp-2)); min-width: 0; }
  .tp .pin { display: inline-flex; align-items: center; gap: 6px; background: var(--ds-glass); border: 1px solid var(--ds-gold-line); border-radius: var(--ds-r-md); padding: 3px 9px 3px 3px; font-size: var(--ds-fs-xs); color: var(--ds-gold-text); max-width: 100%; }
  .tp .pin img { width: 24px; height: 24px; object-fit: contain; image-rendering: pixelated; flex: none; }
  .tp .pin span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* buttons (.ds-btn) */
  .tp .row { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2h); }
  .tp .row .ds-btn { flex: 1 1 160px; }

  /* send */
  .tp .bal { display: flex; justify-content: space-between; align-items: center; gap: var(--ds-sp-2) var(--ds-sp-3); flex-wrap: wrap; margin-block-end: var(--ds-sp-4);
             padding: var(--ds-sp-2h) var(--ds-sp-3h); background: var(--ds-gold-bg); border: 1px solid var(--ds-gold-line); border-radius: var(--ds-r-md); }
  .tp .bal .k { font: 700 var(--ds-fs-chip)/1.3 var(--ds-font); letter-spacing: var(--ds-ls-label); text-transform: uppercase; color: var(--ds-text-muted); }
  .tp .bal .v { font-size: 20px; font-weight: 700; color: var(--ds-gold-text); font-variant-numeric: tabular-nums; }
  .tp .ds-label { display: block; margin: 0 0 6px; }
  .tp .amt-wrap { position: relative; }
  .tp .amt-wrap .ds-in.ds-in { font-size: 24px; font-weight: 700; color: var(--ds-text-strong); padding-block: 10px; padding-inline: 14px 64px; min-height: 56px; }
  .tp .amt-wrap .unit { position: absolute; inset-inline-end: 14px; top: 50%; transform: translateY(-50%); color: var(--ds-gold); font-weight: 700; font-size: var(--ds-fs-sm); pointer-events: none; }
  .tp .amt-chips { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--ds-sp-2); margin-block-start: var(--ds-sp-2h); }
  .tp .amt-chip { justify-content: center; min-height: 40px; padding: 0 4px; font-size: var(--ds-fs-sm); transition: border-color var(--ds-dur-1), background-color var(--ds-dur-1); }
  .tp .amt-chip:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .tp .amt-chip[aria-pressed="true"] { background: var(--ds-ac); border-color: var(--ds-ac); color: var(--ds-on-ac); }
  .tp .amt-chip[disabled] { color: var(--ds-text-disabled); border-color: var(--ds-line); cursor: not-allowed; }
  .tp .hint { min-height: 20px; font-size: var(--ds-fs-meta); color: var(--ds-text-muted); margin-block-start: var(--ds-sp-2); font-variant-numeric: tabular-nums; }
  .tp .hint.err { color: var(--ds-danger); }
  .tp #tp-c-err:empty, .tp #tp-share-msg:empty { display: none; }
  .tp .note-wrap { margin-block-start: var(--ds-sp-4); }
  .tp .note-meta { display: flex; justify-content: space-between; gap: var(--ds-sp-2); font-size: var(--ds-fs-xs); color: var(--ds-text-faint); margin-block-start: 6px; }
  .tp .send-row { margin-block-start: var(--ds-sp-5); }

  /* confirm */
  .tp .sum { display: grid; background: var(--ds-sunken); border: 1px solid var(--ds-line-soft); border-radius: var(--ds-r-md); margin-block-end: var(--ds-sp-4); }
  .tp .sum > div { display: flex; justify-content: space-between; align-items: baseline; gap: var(--ds-sp-3); padding: var(--ds-sp-2h) var(--ds-sp-3h); border-block-start: 1px solid var(--ds-line-soft); font-variant-numeric: tabular-nums; }
  .tp .sum > div:first-child { border-block-start: 0; }
  .tp .sum .k { color: var(--ds-text-muted); font-size: var(--ds-fs-sm); flex: none; }
  .tp .sum .v { text-align: end; min-width: 0; overflow-wrap: anywhere; }
  .tp .sum .big { font-size: var(--ds-fs-num-lg); font-weight: 700; color: var(--ds-gold-text); }
  .tp .sum .note { font-style: italic; color: var(--ds-text-2); }
  .tp .ds-note.warn { margin-block-end: var(--ds-sp-4); }
  .tp .fine { margin: 0 0 var(--ds-sp-3); }

  /* success */
  .tp .done { text-align: center; position: relative; overflow: hidden; }
  .tp .done .big-check { width: 72px; height: 72px; margin: 6px auto 12px; border-radius: 50%; display: grid; place-items: center; font-size: 36px; color: var(--ds-on-ac);
                         background: radial-gradient(circle at 35% 30%, var(--ds-ok), #2e7d32); box-shadow: 0 0 0 8px var(--ds-green-bg); }
  .tp .done h3:focus, .tp h2:focus { outline: none; }
  .tp .done h3 { margin: 0; font: 700 22px/1.3 var(--ds-font); color: var(--ds-text-strong); overflow-wrap: anywhere; }
  .tp .done .amt, .tp .done .gold { color: var(--ds-gold-text); }
  .tp .done p { margin: var(--ds-sp-2) 0 var(--ds-sp-4); }
  .tp .burst { position: absolute; inset: 0; pointer-events: none; }
  .tp .burst i { position: absolute; left: 50%; top: 52px; width: 9px; height: 9px; border-radius: 2px; opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .tp .done.go .big-check { animation: tp-pop .45s cubic-bezier(.2, 1.6, .4, 1) both; }
    .tp .done.go .burst i { animation: tp-fly 1.1s ease-out forwards; animation-delay: var(--d, 0s); }
  }
  @media (prefers-reduced-motion: reduce) { .tp .amt-chip { transition: none; } }
  @keyframes tp-pop { from { transform: scale(.3); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @keyframes tp-fly { 0% { opacity: 1; transform: translate(-50%, 0) rotate(0); }
                      100% { opacity: 0; transform: translate(calc(-50% + var(--x)), var(--y)) rotate(var(--r)); } }

  /* history + jar tiles */
  .tp .totals { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ds-sp-2); margin-block-end: var(--ds-sp-3); }
  .tp .tot { background: var(--ds-sunken); border: 1px solid var(--ds-line-soft); border-radius: var(--ds-r-md); padding: var(--ds-sp-2h) var(--ds-sp-3); min-width: 0; }
  .tp .tot .k { font: 700 var(--ds-fs-chip)/1.3 var(--ds-font); letter-spacing: var(--ds-ls-label); text-transform: uppercase; color: var(--ds-text-muted); }
  .tp .tot .v { font-size: var(--ds-fs-num); font-weight: 700; color: var(--ds-text-strong); font-variant-numeric: tabular-nums; margin-block-start: 2px; overflow-wrap: anywhere; }
  .tp .tot .v.up { color: var(--ds-ok); } .tp .tot .v.down { color: var(--ds-danger-solid); }
  .tp ul.tips, .tp ul.jar, .tp ol.top { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .tp ul.tips li, .tp ul.jar li { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 4px var(--ds-sp-2h); align-items: center; min-height: 44px;
                   background: var(--ds-sunken); border: 1px solid var(--ds-line-soft); border-radius: var(--ds-r-md); padding: var(--ds-sp-2) var(--ds-sp-3); font-size: var(--ds-fs-sm); }
  .tp ul.tips .ic { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; font-size: 18px; line-height: 1; }
  .tp ul.tips .what { min-width: 0; overflow-wrap: anywhere; }
  .tp .when { color: var(--ds-text-faint); font-size: var(--ds-fs-xs); }
  .tp .pts { font-weight: 700; font-variant-numeric: tabular-nums; text-align: end; white-space: nowrap; }
  .tp .pts.out { color: var(--ds-danger-solid); }
  .tp .pts.in { color: var(--ds-ok); }
  .tp .tnote { grid-column: 2 / -1; font-size: var(--ds-fs-meta); font-style: italic; color: var(--ds-text-2); overflow-wrap: anywhere; }
  .tp li.fresh { border-color: var(--ds-ok-line); background: var(--ds-ok-bg); }

  /* owner's tip jar */
  .tp .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ds-sp-2); }
  .tp .stats .tot.hl { grid-column: 1 / -1; background: radial-gradient(120% 160% at 0% 0%, #2a2208 0%, var(--ds-sunken) 60%); border-color: var(--ds-gold-line); padding: var(--ds-sp-3) var(--ds-sp-3h); }
  .tp .stats .tot.hl .v { font-size: var(--ds-fs-num-lg); color: var(--ds-gold-text); }
  .tp .stats .sub { font-size: var(--ds-fs-xs); color: var(--ds-text-muted); margin-block-start: 2px; }
  .tp .newpill { display: inline-block; margin-inline-start: var(--ds-sp-2); padding: 1px 8px; border-radius: var(--ds-r-pill); background: var(--ds-ac); color: var(--ds-on-ac); font: 700 var(--ds-fs-chip)/1.6 var(--ds-font); letter-spacing: .04em; vertical-align: middle; }
  .tp ol.top li { display: grid; grid-template-columns: 22px 40px minmax(0, 1fr) auto; gap: var(--ds-sp-2h); align-items: center; background: var(--ds-sunken); border: 1px solid var(--ds-line-soft); border-radius: var(--ds-r-md); padding: var(--ds-sp-2) var(--ds-sp-3); }
  .tp ol.top .rk { font-weight: 700; color: var(--ds-text-muted); text-align: center; font-variant-numeric: tabular-nums; }
  .tp ol.top li:nth-child(1) .rk { color: var(--ds-gold); }
  .tp ol.top li:nth-child(2) .rk { color: #cfd8dc; }
  .tp ol.top li:nth-child(3) .rk { color: #d7a26b; }
  .tp .mini { width: 40px; height: 40px; border-radius: var(--ds-r-sm); overflow: hidden; border: 1px solid var(--ds-line-strong); display: grid; place-items: center; background: #101010; flex: none; }
  .tp .mini svg { width: 38px; height: 38px; image-rendering: pixelated; shape-rendering: crispEdges; display: block; }
  .tp .mini img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tp .mini.sm { width: 28px; height: 28px; border-radius: var(--ds-r-xs); }
  .tp ol.top .nm, .tp ul.jar .nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; }
  .tp ol.top .nm a, .tp ul.jar .nm a { color: var(--ds-text); }
  .tp ol.top .meta { font-size: var(--ds-fs-xs); color: var(--ds-text-muted); font-weight: 400; }
  .tp .nm .muted { font-weight: 400; }
  .tp ol.top .amt { font-weight: 700; font-variant-numeric: tabular-nums; text-align: end; white-space: nowrap; color: var(--ds-gold-text); }
  .tp .ds-tabs { margin-block-end: var(--ds-sp-3); }
  .tp ul.jar .line { min-width: 0; display: flex; align-items: baseline; gap: 6px; }
  .tp ul.jar .when { white-space: nowrap; }
  .tp .more { margin-block-start: var(--ds-sp-3); width: 100%; }
  .tp .ds-empty { padding: var(--ds-sp-6) var(--ds-sp-4); }
  .tp .ds-empty p { margin: 0; }

  @media (max-width: 520px) {
    .tp .card { padding: var(--ds-sp-4); }
    .tp .hero { grid-template-columns: 76px minmax(0, 1fr); gap: var(--ds-sp-3) var(--ds-sp-3h); }
    .tp .hero .cx-banner { margin: calc(-1 * var(--ds-sp-4)) calc(-1 * var(--ds-sp-4)) 0; }
    .tp .av { width: 76px; height: 76px; border-radius: var(--ds-r-lg); }
    .tp .av svg { width: 70px; height: 70px; }
    .tp .showcase { grid-column: 1 / -1; margin-block-start: 0; }
    .tp .amt-chips { gap: 6px; }
    .tp .amt-chip { font-size: var(--ds-fs-meta); }
    .tp .sum .big { font-size: 22px; }
    .tp .stats .tot.hl .v { font-size: 24px; }
    .tp .note-wrap .ds-in.ds-in { font-size: 16px; }
  }
</style>

<main class="ds-page narrow tp">
  <a class="ds-back" href="<%= profileHref %>"><%- t('tip.back_profile', { name: name }) %></a>

  <section class="card hero cx-host" aria-labelledby="tp-name">
    <% if (cxBanner) { %><div class="cx-banner" style="<%= cxBanner.css %>" aria-hidden="true"></div><% } %>
    <div class="av">
      <% if (av && av.svg) { %><%- av.svg %><% } else { %><img src="<%= avatar || '/public/img/avatar.png' %>" alt="" onerror="this.src='/public/img/avatar.png'"><% } %>
    </div>
    <div class="who">
      <div class="kicker"><%- isSelf ? t('tip.your_jar') : t('tip.jar') %></div>
      <h1 id="tp-name"><% if (cxName && cxName.css) { %><span class="cx-name" style="<%= cxName.css %>"><%= name %></span><% } else { %><%= name %><% } %></h1>
      <div class="handle"><a href="<%= profileHref %>">@<%= usernameProfile %></a><% if (camfrog) { %><span aria-hidden="true">·</span><span><span class="ds-ic" aria-hidden="true">🐸</span> <%= camfrog %></span><% } %></div>
      <div class="chips">
        <span class="ds-tag ac"><%- t('tip.level', { n: level }) %></span>
        <% if (role && role !== 'pleb') { %><span class="ds-tag <%= role %>"><%= classh %></span><% } %>
        <% if (badgeCount) { %><span class="ds-tag ac"><%- t('tip.badges', { count: badgeCount }) %></span><% } %>
      </div>
    </div>
    <% if (showcase.length) { %>
      <div class="showcase" aria-label="<%- t('tip.pinned') %>">
        <% showcase.forEach((b) => { %><span class="pin" title="<%= b.description %>"><img src="<%= b.icon %>" alt=""><span><%= b.name %></span></span><% }) %>
      </div>
    <% } %>
    <% if (cxBorder) { %><div class="cx-frame <%= cxBorder.cls %>" style="<%= cxBorder.css %>" aria-hidden="true"></div><% } %>
  </section>

  <% if (!signedIn) { %>
    <section class="card">
      <h2 class="ds-pixel-h"><%- t('tip.send_h') %></h2>
      <p class="muted fine"><%- t('tip.signin_send', { name: name }) %></p>
      <div class="row"><a class="ds-btn" href="/login"><%- t('tip.signin_tip') %></a><a class="ds-btn ghost" href="<%= profileHref %>"><%- t('tip.view_profile') %></a></div>
    </section>
  <% } else if (isSelf) { const T = (J && J.totals) || {}; %>
    <section class="card" aria-labelledby="tj-title">
      <h2 class="ds-pixel-h" id="tj-title"><%- t('tip.your_jar_h') %><% if (J && J.newCount) { %><span class="newpill"><%- t('tip.n_new', { n: J.newCount }) %></span><% } %></h2>
      <div class="stats">
        <div class="tot hl"><div class="k"><%- t('tip.recv_all') %></div><div class="v"><%= fmt(T.recv) %> PAT</div>
          <div class="sub"><%- t('tip.n_tips', { count: Number(T.recvCount) || 0, n: fmt(T.recvCount) }) %> <%- t('tip.from_people', { count: Number(T.tippers) || 0, n: fmt(T.tippers) }) %></div></div>
        <div class="tot"><div class="k"><%- t('tip.last7') %></div><div class="v up"><%= fmt(T.week) %></div></div>
        <div class="tot"><div class="k"><%- t('tip.last30') %></div><div class="v up"><%= fmt(T.month) %></div></div>
        <div class="tot"><div class="k"><%- t('tip.tippers') %></div><div class="v"><%= fmt(T.tippers) %></div></div>
        <div class="tot"><div class="k"><%- t('tip.you_sent') %></div><div class="v down"><%= fmt(T.sent) %></div></div>
      </div>
      <div class="row send-row">
        <button class="ds-btn" type="button" id="tp-share" data-url="<%= tipHref %>"><%- t('tip.copy_link') %></button>
        <a class="ds-btn ghost" href="/history"><%- t('tip.history') %></a>
      </div>
      <p class="hint" id="tp-share-msg" role="status" aria-live="polite"></p>
    </section>

    <% if (J && J.top && J.top.length) { %>
    <section class="card" aria-labelledby="tj-top-title">
      <h2 class="ds-pixel-h" id="tj-top-title"><%- t('tip.top') %></h2>
      <ol class="top">
        <% J.top.forEach((u, i) => { %>
          <li>
            <span class="rk"><%= i + 1 %></span>
            <span class="mini" aria-hidden="true"><% if (J.avatars && J.avatars[u.username]) { %><%- J.avatars[u.username] %><% } else { %><img src="<%= u.avatar || '/public/img/avatar.png' %>" alt="" loading="lazy" onerror="this.onerror=null;this.src='/public/img/avatar.png'"><% } %></span>
            <span class="nm"><a href="<%= profOf(u) %>"><%- nameOf(u) %></a><br><span class="meta"><%- t('tip.n_tips', { count: Number(u.n) || 0, n: fmt(u.n) }) %> · <%- t('tip.last') %> <span class="when" data-ts="<%= iso(u.last) %>"><%= String(u.last || '').slice(0, 10) %></span></span></span>
            <span class="amt"><%= fmt(u.total) %></span>
          </li>
        <% }) %>
      </ol>
    </section>
    <% } %>

    <section class="card" aria-labelledby="tj-list-title">
      <h2 id="tj-list-title" class="sr-only"><%- t('tip.tips') %></h2>
      <div class="ds-tabs" role="tablist" aria-label="<%- t('tip.tips') %>">
        <button class="ds-tab tab" type="button" role="tab" id="tj-tab-received" aria-controls="tj-panel-received" aria-selected="true"><%- t('tip.received') %> <span class="ds-count"><%= fmt(T.recvCount) %></span></button>
        <button class="ds-tab tab" type="button" role="tab" id="tj-tab-sent" aria-controls="tj-panel-sent" aria-selected="false" tabindex="-1"><%- t('tip.sent') %> <span class="ds-count"><%= fmt(T.sentCount) %></span></button>
      </div>
      <% [['received', J ? J.received : null], ['sent', J ? J.sent : null]].forEach(([kind, pg]) => { const items = (pg && pg.items) || []; const out = kind === 'sent'; %>
        <div role="tabpanel" id="tj-panel-<%= kind %>" aria-labelledby="tj-tab-<%= kind %>"<%= out ? ' hidden' : '' %>>
          <% if (items.length) { %>
            <ul class="jar" data-kind="<%= kind %>">
              <% items.forEach((tp) => { %>
                <li<%- !out && isFresh(tp) ? ' class="fresh"' : '' %>>
                  <span class="mini sm" aria-hidden="true"><img src="<%= tp.avatar || '/public/img/avatar.png' %>" alt="" loading="lazy" onerror="this.onerror=null;this.src='/public/img/avatar.png'"></span>
                  <span class="line"><span class="nm"><% if (out) { %><span class="muted to"><%- t('tip.to') %> </span><% } %><% if (tp.username) { %><a href="<%= profOf(tp) %>"><%- nameOf(tp) %></a><% } else { %><%- t('tip.someone') %><% } %></span><span class="when" data-ts="<%= iso(tp.timestamp) %>"><%= String(tp.timestamp || '').slice(0, 10) %></span></span>
                  <span class="pts <%= out ? 'out' : 'in' %>"><%= out ? '−' : '+' %><%= fmt(Math.abs(tp.points)) %></span>
                  <% if (tp.note) { %><span class="tnote">&ldquo;<%= tp.note %>&rdquo;</span><% } %>
                </li>
              <% }) %>
            </ul>
            <% if (pg.more) { %><button class="ds-btn quiet more" type="button" data-more="<%= kind %>" data-offset="<%= items.length %>"><%- t('tip.load_more') %></button><% } %>
            <p class="hint err" data-more-err="<%= kind %>" role="alert" hidden></p>
          <% } else if (!out) { %>
            <div class="ds-empty">
              <span class="ds-ic" aria-hidden="true">🫙</span>
              <p class="muted"><%- t('tip.no_tips') %></p>
            </div>
          <% } else { %>
            <div class="ds-empty"><p class="muted"><%- t('tip.none_sent') %></p></div>
          <% } %>
        </div>
      <% }) %>
    </section>
  <% } else { %>
    <section class="card" id="tp-card" aria-labelledby="tp-step-title">
      <!-- step 1: amount + note -->
      <form id="tp-form" novalidate>
        <h2 class="ds-pixel-h" id="tp-step-title"><%- t('tip.send_h') %></h2>
        <div class="bal"><span class="k"><%- t('tip.your_balance') %></span><span class="v"><span id="tp-bal"><%= fmt(balance) %></span> PAT</span></div>

        <label class="ds-label" for="tp-amt"><%- t('tip.amount') %></label>
        <div class="amt-wrap">
          <input id="tp-amt" class="ds-in num" name="amount" type="text" inputmode="decimal" autocomplete="off" spellcheck="false"
                 placeholder="<%- t('tip.amount_ph') %>" aria-describedby="tp-hint" required>
          <span class="unit" aria-hidden="true">PAT</span>
        </div>
        <div class="amt-chips" role="group" aria-label="<%- t('tip.quick') %>">
          <% CHIPS.forEach(([v, l]) => { %>
            <button type="button" class="ds-quick amt-chip" data-v="<%= v %>" aria-pressed="false"<%= v > balance ? ' disabled' : '' %> aria-label="<%= fmt(v) %> PAT"><%= l %></button>
          <% }) %>
        </div>
        <div class="hint" id="tp-hint" aria-live="polite"><%- t('tip.hint') %></div>

        <div class="note-wrap">
          <label class="ds-label" for="tp-note"><%- t('tip.message') %> <span class="mut-opt"><%- t('tip.optional') %></span></label>
          <input id="tp-note" class="ds-in" name="note" type="text" maxlength="<%= noteMax %>" autocomplete="off" placeholder="<%- t('tip.note_ph') %>" aria-describedby="tp-note-meta">
          <div class="note-meta" id="tp-note-meta"><span><%- t('tip.sees', { name: name }) %></span><span><span id="tp-note-n">0</span>/<%= noteMax %></span></div>
        </div>

        <div class="row send-row"><button class="ds-btn gold" type="submit" id="tp-review"><%- t('tip.review') %></button></div>
      </form>

      <!-- step 2: confirm -->
      <div id="tp-confirm" hidden>
        <h2 class="ds-pixel-h" tabindex="-1" id="tp-confirm-title"><%- t('tip.confirm_h') %></h2>
        <div class="sum">
          <div><span class="k"><%- t('tip.to_k') %></span><span class="v"><b><%= name %></b> <span class="muted">@<%= usernameProfile %></span></span></div>
          <div><span class="k"><%- t('tip.amount') %></span><span class="v big" id="tp-c-amt"></span></div>
          <div id="tp-c-note-row"><span class="k"><%- t('tip.message') %></span><span class="v note" id="tp-c-note"></span></div>
          <div><span class="k"><%- t('tip.your_balance') %></span><span class="v"><span id="tp-c-before"></span> → <b id="tp-c-after"></b></span></div>
        </div>
        <div class="ds-note warn" id="tp-c-warn" hidden></div>
        <p class="muted fine"><%- t('tip.fine', { name: name }) %></p>
        <div class="hint err" id="tp-c-err" role="alert"></div>
        <div class="row">
          <button class="ds-btn gold" type="button" id="tp-send"><%- t('tip.send_tip') %></button>
          <button class="ds-btn ghost" type="button" id="tp-back"><%- t('tip.back') %></button>
        </div>
      </div>

      <!-- step 3: done -->
      <div id="tp-done" class="done" hidden>
        <div class="burst" aria-hidden="true" id="tp-burst"></div>
        <div class="big-check" aria-hidden="true">✓</div>
        <h3 tabindex="-1" id="tp-done-title"><%- t('tip.done_h', { amt: '<span class="amt" id="tp-d-amt"></span>', name: name }) %></h3>
        <p class="muted"><%- t('tip.bal_now', { bal: '<b id="tp-d-bal" class="gold"></b>' }) %></p>
        <div class="row">
          <button class="ds-btn" type="button" id="tp-again"><%- t('tip.again') %></button>
          <a class="ds-btn ghost" href="<%= profileHref %>"><%- t('tip.back_to_profile') %></a>
        </div>
      </div>
    </section>

    <section class="card" aria-labelledby="tp-hist-title">
      <h2 class="ds-pixel-h" id="tp-hist-title"><%- t('tip.you_and', { name: name }) %></h2>
      <div class="totals">
        <div class="tot"><div class="k"><%- t('tip.you_tipped_k') %></div><div class="v down"><span id="tp-sent-tot"><%= fmt(sentTotal) %></span> PAT</div></div>
        <div class="tot"><div class="k"><%- t('tip.they_tipped_k') %></div><div class="v up"><%= fmt(recvTotal) %> PAT</div></div>
      </div>
      <ul class="tips" id="tp-list"<%= recent.length ? '' : ' hidden' %>>
        <% recent.forEach((tp) => { const out = tp.type === 'tip sent'; %>
          <li>
            <span class="ic" aria-hidden="true"><%= out ? '💸' : '💰' %></span>
            <span class="what"><%- out ? t('tip.you_tipped') : t('tip.they_tipped') %> <span class="when" data-ts="<%= iso(tp.timestamp) %>"><%= String(tp.timestamp || '').slice(0, 10) %></span></span>
            <span class="pts <%= out ? 'out' : 'in' %>"><%= out ? '−' : '+' %><%= fmt(Math.abs(tp.points)) %></span>
            <% if (tp.note) { %><span class="tnote">&ldquo;<%= tp.note %>&rdquo;</span><% } %>
          </li>
        <% }) %>
      </ul>
      <p class="muted" id="tp-empty" style="margin:0"<%= recent.length ? ' hidden' : '' %>><%- t('tip.none_between') %></p>
    </section>
  <% } %>
</main>

<script>
(function () {
  var _t = typeof __t === 'function' ? __t : function (k, d, v) { return String(d).replace(/\{!?(\w+)\}/g, function (m, n) { return v && v[n] != null ? v[n] : m; }); };
  var fmt = function (n) { return Math.floor(Number(n) || 0).toLocaleString('en-US'); };
  // relative times for the history list
  function ago(iso) {
    var t = Date.parse(iso); if (isNaN(t)) return null;
    var s = Math.max(0, (Date.now() - t) / 1000);
    if (s < 60) return _t('js.tip.just_now', 'just now');
    if (s < 3600) return _t('js.tip.m_ago', '{n}m ago', { n: Math.floor(s / 60) });
    if (s < 86400) return _t('js.tip.h_ago', '{n}h ago', { n: Math.floor(s / 3600) });
    if (s < 86400 * 30) return _t('js.tip.d_ago', '{n}d ago', { n: Math.floor(s / 86400) });
    return new Date(t).toLocaleDateString();
  }
  document.querySelectorAll('.tp .when[data-ts]').forEach(function (el) {
    var a = ago(el.getAttribute('data-ts')); if (a) { el.textContent = '· ' + a; el.title = window.PATVTime ? PATVTime.format(el.getAttribute('data-ts'), 'long') : new Date(el.getAttribute('data-ts')).toLocaleString(); }
  });

  var share = document.getElementById('tp-share');
  if (share) share.addEventListener('click', function () {
    var url = location.origin + share.getAttribute('data-url');
    var msg = document.getElementById('tp-share-msg');
    var ok = function () { msg.textContent = _t('js.tip.copied', 'Copied: {url}', { url: url }); };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(url).then(ok, function () { msg.textContent = url; });
    else msg.textContent = url;
  });

  // owner's tip jar: tabs + "load more"
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.tp .tab[role="tab"]'));
  function pick(tab) {
    tabs.forEach(function (t) {
      var on = t === tab;
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
    });
  }
  tabs.forEach(function (t, i) {
    t.addEventListener('click', function () { pick(t); });
    t.addEventListener('keydown', function (e) {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      var n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length]; pick(n); n.focus(); e.preventDefault();
    });
  });
  function jarRow(t, out) {
    var li = document.createElement('li');
    var mini = document.createElement('span'); mini.className = 'mini sm'; mini.setAttribute('aria-hidden', 'true');
    var img = document.createElement('img'); img.alt = ''; img.loading = 'lazy';
    img.onerror = function () { img.onerror = null; img.src = '/public/img/avatar.png'; };
    img.src = t.avatar || '/public/img/avatar.png';
    mini.appendChild(img); li.appendChild(mini);
    var line = document.createElement('span'); line.className = 'line';
    var nm = document.createElement('span'); nm.className = 'nm';
    if (out) { var to = document.createElement('span'); to.className = 'muted'; to.style.fontWeight = 'normal'; to.textContent = _t('js.tip.to', 'to') + ' '; nm.appendChild(to); }
    if (t.username) {
      var a = document.createElement('a'); a.href = '/u/' + encodeURIComponent(t.username);
      var label = t.displayname || t.username;
      if (t.nameCss) { var c = document.createElement('span'); c.className = 'cx-name'; c.setAttribute('style', t.nameCss); c.textContent = label; a.appendChild(c); }
      else a.textContent = label;
      nm.appendChild(a);
    } else nm.appendChild(document.createTextNode(_t('js.tip.someone', 'Someone')));
    line.appendChild(nm);
    var w = document.createElement('span'); w.className = 'when';
    var iso = String(t.timestamp || '').replace(' ', 'T') + 'Z';
    w.textContent = ago(iso) || String(t.timestamp || '').slice(0, 10); w.title = window.PATVTime ? PATVTime.format(iso, 'long') : new Date(iso).toLocaleString();
    line.appendChild(w); li.appendChild(line);
    var pts = document.createElement('span'); pts.className = 'pts ' + (out ? 'out' : 'in');
    pts.textContent = (out ? '−' : '+') + fmt(t.points); li.appendChild(pts);
    if (t.note) { var n = document.createElement('span'); n.className = 'tnote'; n.textContent = '“' + t.note + '”'; li.appendChild(n); }
    return li;
  }
  document.querySelectorAll('.tp [data-more]').forEach(function (btn) {
    var kind = btn.getAttribute('data-more');
    var list = document.querySelector('.tp ul.jar[data-kind="' + kind + '"]');
    var err = document.querySelector('.tp [data-more-err="' + kind + '"]');
    btn.addEventListener('click', function () {
      if (btn.disabled) return;
      btn.disabled = true; btn.textContent = _t('js.tip.loading', 'Loading…'); err.hidden = true;
      var off = Number(btn.getAttribute('data-offset')) || 0;
      fetch('/api/tipjar?kind=' + encodeURIComponent(kind) + '&offset=' + off, { credentials: 'same-origin', headers: { accept: 'application/json' } })
        .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
        .then(function (d) {
          (d.items || []).forEach(function (t) { list.appendChild(jarRow(t, kind === 'sent')); });
          btn.setAttribute('data-offset', off + (d.items || []).length);
          btn.disabled = false; btn.textContent = _t('js.tip.load_more', 'Load more'); btn.hidden = !d.more;
        })
        .catch(function () { btn.disabled = false; btn.textContent = _t('js.tip.load_more', 'Load more'); err.textContent = _t('js.tip.load_err', 'Couldn’t load more tips — try again.'); err.hidden = false; });
    });
  });

  var form = document.getElementById('tp-form');
  if (!form) return;
  var TARGET = <%- JSON.stringify(usernameProfile).replace(/</g, '\\u003c') %>;
  var balance = <%= Number(balance) || 0 %>;
  var amtEl = document.getElementById('tp-amt'), hint = document.getElementById('tp-hint');
  var noteEl = document.getElementById('tp-note'), noteN = document.getElementById('tp-note-n');
  var chips = Array.prototype.slice.call(document.querySelectorAll('.tp .amt-chip'));
  var confirmEl = document.getElementById('tp-confirm'), doneEl = document.getElementById('tp-done');
  var sendBtn = document.getElementById('tp-send'), errEl = document.getElementById('tp-c-err');
  var HINT0 = hint.innerHTML;
  var pending = null;           // { amount, note, key }

  // Same rule as the rest of the site (cosmetics prices): 2500, 2,500, 2.5k, 1m, 1b.
  function parseAmt(v) {
    var m = String(v == null ? '' : v).trim().toLowerCase().replace(/[, _]/g, '').match(/^(\d+(?:\.\d+)?)([kmb])?$/);
    if (!m) return NaN;
    return Math.floor(Number(m[1]) * ({ k: 1e3, m: 1e6, b: 1e9 }[m[2]] || 1));
  }
  function check() {
    var raw = amtEl.value.trim();
    var n = parseAmt(raw);
    var bad = null;
    if (!raw) bad = '';
    else if (isNaN(n)) bad = _t('js.tip.bad_num', 'Use a number like 2500, 25k or 1.5m.');
    else if (n < 1) bad = _t('js.tip.min', 'Tip at least 1 PAT.');
    else if (n > balance) bad = _t('js.tip.over', 'That\'s more than your balance ({n} PAT).', { n: fmt(balance) });
    chips.forEach(function (c) {
      c.setAttribute('aria-pressed', String(Number(c.getAttribute('data-v')) === n));
      c.disabled = Number(c.getAttribute('data-v')) > balance;
    });
    if (bad === '') { hint.className = 'hint'; hint.innerHTML = HINT0; amtEl.removeAttribute('aria-invalid'); return null; }
    if (bad) { hint.className = 'hint err'; hint.textContent = bad; amtEl.setAttribute('aria-invalid', 'true'); return null; }
    hint.className = 'hint'; amtEl.removeAttribute('aria-invalid');
    hint.textContent = _t('js.tip.calc', '= {n} PAT · leaves you {left} PAT', { n: fmt(n), left: fmt(balance - n) });
    return n;
  }
  amtEl.addEventListener('input', check);
  chips.forEach(function (c) {
    c.addEventListener('click', function () { amtEl.value = fmt(c.getAttribute('data-v')); check(); });
  });
  noteEl.addEventListener('input', function () { noteN.textContent = Array.from(noteEl.value).length; });

  function newKey() {
    if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
    return Date.now().toString(36) + Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2);
  }
  function show(step) {
    form.hidden = step !== 'form'; confirmEl.hidden = step !== 'confirm'; doneEl.hidden = step !== 'done';
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var n = check();
    if (n === null) {
      if (!amtEl.value.trim()) { hint.className = 'hint err'; hint.textContent = _t('js.tip.enter', 'Enter an amount to tip.'); amtEl.setAttribute('aria-invalid', 'true'); }
      amtEl.focus(); return;
    }
    var note = noteEl.value.replace(/\s+/g, ' ').trim();
    pending = { amount: n, note: note, key: newKey() };   // one key per confirmed attempt (double-click / retry safe)
    document.getElementById('tp-c-amt').textContent = fmt(n) + ' PAT';
    document.getElementById('tp-c-note').textContent = note ? '“' + note + '”' : '';
    document.getElementById('tp-c-note-row').hidden = !note;
    document.getElementById('tp-c-before').textContent = fmt(balance);
    document.getElementById('tp-c-after').textContent = fmt(balance - n) + ' PAT';
    var warn = document.getElementById('tp-c-warn');
    var big = n >= balance * 0.5 && n >= 10000;
    warn.hidden = !big;
    if (big) warn.textContent = n === balance ? _t('js.tip.whole', 'Heads up: this is your whole balance.') : _t('js.tip.pct', 'Heads up: that’s {pct}% of your balance.', { pct: Math.round(n / balance * 100) });
    errEl.textContent = '';
    sendBtn.disabled = false; sendBtn.textContent = _t('js.tip.send_n', 'Send {n} PAT', { n: fmt(n) });
    show('confirm');
    document.getElementById('tp-confirm-title').focus();
  });

  document.getElementById('tp-back').addEventListener('click', function () {
    pending = null; show('form'); amtEl.focus();
  });

  sendBtn.addEventListener('click', function () {
    if (!pending || sendBtn.disabled) return;
    sendBtn.disabled = true; sendBtn.textContent = _t('js.tip.sending', 'Sending…'); errEl.textContent = '';
    var p = pending;
    fetch('/u/' + encodeURIComponent(TARGET) + '/tip', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'content-type': 'application/json', 'accept': 'application/json' },
      body: JSON.stringify({ amount: p.amount, note: p.note, idempotency_key: p.key }),
    }).then(function (r) {
      var ct = r.headers.get('content-type') || '';
      return (ct.indexOf('json') >= 0 ? r.json() : r.text().then(function (t) { return { message: t }; }))
        .then(function (d) { return { status: r.status, ok: r.ok, d: d || {} }; });
    }).then(function (res) {
      if (res.ok) return success(p, res.d);
      sendBtn.disabled = false; sendBtn.textContent = _t('js.tip.try_again', 'Try again');
      if (res.status === 409) { errEl.textContent = _t('js.tip.e409', 'That tip is still going through — check your history before trying again.'); return; }
      if (res.status === 401) { errEl.textContent = _t('js.tip.e401', 'You’ve been signed out.') + ' '; var lk = document.createElement('a'); lk.href = '/login'; lk.textContent = _t('js.tip.signin', 'Sign in'); errEl.appendChild(lk); errEl.appendChild(document.createTextNode(' ' + _t('js.tip.e401_tail', 'and try again.'))); return; }
      var m = String(res.d.message || res.d.error || '');
      if (/insufficient/i.test(m)) m = _t('js.tip.insufficient', 'You don’t have enough PAT for that any more.');
      else if (!m || m.length > 160) m = _t('js.tip.failed', 'The tip didn’t go through — nothing was sent.');
      errEl.textContent = m;
      if (res.status !== 500) pending.key = newKey();   // a refused attempt is final; a fresh try gets a fresh key
    }).catch(function () {
      // Network error: we don't know if it landed. Keep the SAME key so a retry can't send twice.
      sendBtn.disabled = false; sendBtn.textContent = _t('js.tip.retry', 'Retry');
      errEl.textContent = _t('js.tip.network', 'Couldn’t reach the server. Retrying is safe — it won’t send twice.');
    });
  });

  function success(p, d) {
    balance = typeof d.balance === 'number' ? d.balance : balance - p.amount;
    document.getElementById('tp-bal').textContent = fmt(balance);
    document.getElementById('tp-d-amt').textContent = fmt(p.amount);
    document.getElementById('tp-d-bal').textContent = fmt(balance);
    var st = document.getElementById('tp-sent-tot');
    st.textContent = fmt(Number(st.textContent.replace(/[^0-9]/g, '')) + p.amount);
    // prepend to the list
    var list = document.getElementById('tp-list');
    var li = document.createElement('li'); li.className = 'fresh';
    li.innerHTML = '<span class="ic" aria-hidden="true">💸</span><span class="what"> <span class="when"></span></span><span class="pts out"></span>';
    var wh = li.querySelector('.what'); wh.insertBefore(document.createTextNode(_t('js.tip.you_tipped', 'You tipped')), wh.firstChild); li.querySelector('.when').textContent = '· ' + _t('js.tip.just_now', 'just now');
    li.querySelector('.pts').textContent = '−' + fmt(p.amount);
    if (p.note) { var n = document.createElement('span'); n.className = 'tnote'; n.textContent = '“' + p.note + '”'; li.appendChild(n); }
    list.insertBefore(li, list.firstChild); list.hidden = false;
    while (list.children.length > 8) list.removeChild(list.lastChild);
    document.getElementById('tp-empty').hidden = true;
    pending = null;
    // celebration (CSS only animates when the user hasn't asked for reduced motion)
    var burst = document.getElementById('tp-burst'); burst.innerHTML = '';
    var cols = ['#ffd700', '#4caf50', '#c6e94f', '#81c784', '#ffb300', '#4fc3f7'];
    for (var i = 0; i < 26; i++) {
      var b = document.createElement('i'), a = (i / 26) * Math.PI * 2, dist = 70 + Math.random() * 90;
      b.style.background = cols[i % cols.length];
      b.style.setProperty('--x', Math.round(Math.cos(a) * dist * 1.6) + 'px');
      b.style.setProperty('--y', Math.round(Math.sin(a) * dist + 40) + 'px');
      b.style.setProperty('--r', Math.round(Math.random() * 540 - 270) + 'deg');
      b.style.setProperty('--d', (Math.random() * .15).toFixed(2) + 's');
      burst.appendChild(b);
    }
    doneEl.classList.remove('go'); void doneEl.offsetWidth; doneEl.classList.add('go');
    show('done');
    document.getElementById('tp-done-title').focus();
  }

  document.getElementById('tp-again').addEventListener('click', function () {
    amtEl.value = ''; noteEl.value = ''; noteN.textContent = '0'; check(); show('form'); amtEl.focus();
  });
  check();
})();
</script>
</body>
</html>
