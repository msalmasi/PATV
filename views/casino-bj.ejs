<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: tableId ? t('casino.bj_title') : t('casino.lobby_title'), user: user}) %>
<%# views/casino-bj.ejs - /casino/blackjack (the lobby) and /casino/blackjack/t/<id> (a table). D10 design pass (2026-10-11): a felt
    with Pepe dealing and six seats on the arc (avatars, names, bets as chips), chip-button betting with the table's limits,
    action buttons with a countdown ring tied to the server's deadline, deal / flip animations and payout pops, a history sheet,
    spectators, and the host's push-to-room / Pepe's-stream tools. Drawn by public/js/casino-ui.js + casinobj.js. %>
<%- include('partials/casino-css') %>
<style>
  .felt.bj { padding: 18px 16px 64px; border-radius: 28px 28px 50% 50% / 28px 28px 22% 22%; min-height: 470px; }
  .bj-shoe { position: absolute; top: 20px; right: 26px; width: 44px; height: 58px; border-radius: 8px; transform: rotate(8deg);
             background: linear-gradient(160deg, #3a2412, #1a0e06); box-shadow: inset 0 0 0 2px var(--rail2), 0 4px 10px rgba(0,0,0,.5); }
  .bj-shoe::after { content: ""; position: absolute; left: 6px; right: 6px; top: 6px; height: 34px; border-radius: 4px; border: 2px solid #fff;
                    background: repeating-linear-gradient(45deg, #9b1c1c 0 4px, #c62828 4px 8px); }
  .bj-dealer { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .bj-dealer .who { display: flex; align-items: center; gap: 8px; }
  .bj-dealer .av { width: 40px; height: 40px; background: #0d2a18; }
  .bj-dealer .cards { min-height: calc(var(--cw) * 1.4); }
  .val { display: inline-block; min-width: 34px; padding: 3px 9px; border-radius: 999px; background: rgba(0,0,0,.6); color: #fff;
         font: bold 13px/1.2 Ubuntu, sans-serif; text-align: center; font-variant-numeric: tabular-nums; }
  .val.bust { background: #8e2424; } .val.bj { background: var(--gold); color: #2a1a00; } .val:empty { display: none; }
  .bj-rules { margin: 10px auto 0; max-width: 560px; text-align: center; color: rgba(255,215,64,.75); font: bold 11px/1.5 Ubuntu, sans-serif; letter-spacing: .16em; text-transform: uppercase; }
  .bj-center { display: flex; align-items: center; justify-content: center; gap: 12px; min-height: 56px; margin: 6px 0; }
  .bj-seats { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; align-items: start; margin-top: 8px; }
  .bj-seats > .seat:nth-child(2), .bj-seats > .seat:nth-child(5) { margin-top: 36px; }
  .bj-seats > .seat:nth-child(3), .bj-seats > .seat:nth-child(4) { margin-top: 58px; }
  .hands { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; min-height: calc(var(--hw) * 1.4 + 26px); --hw: 36px; }
  .hand { display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 3px; border-radius: 10px; --cw: var(--hw); }
  .hand.cur { background: rgba(255,215,64,.14); box-shadow: 0 0 0 2px rgba(255,215,64,.6); }
  .hand .cards { min-height: calc(var(--cw) * 1.4); }
  .hand .meta { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; align-items: center; }
  .oc { padding: 2px 7px; border-radius: 6px; font: 900 11px/1.3 Ubuntu, sans-serif; letter-spacing: .05em; text-transform: uppercase; }
  .oc.win, .oc.blackjack { background: var(--gold); color: #2a1a00; } .oc.lose, .oc.bust { background: #8e2424; color: #fff; } .oc.push { background: #555; color: #fff; }
  .betspot { display: grid; place-items: center; min-width: 64px; height: 30px; padding: 0 4px; border-radius: 999px; border: 2px dashed rgba(255,255,255,.28); }
  .betspot.on { border-style: solid; border-color: rgba(255,215,64,.6); }
  .seat.empty .av { background: transparent; border-style: dashed; color: rgba(255,255,255,.5); font-size: 20px; }
  .seat.empty .plate { background: transparent; border: 0; color: rgba(255,255,255,.6); font-size: 12px; }
  .seat .tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 3px; margin-top: 3px; }
  button.sitbtn { background: transparent; border: 0; padding: 0; cursor: pointer; color: inherit; display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .stakebox { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; }
  .stakebox .amt { font: 900 30px/1 Ubuntu, sans-serif; color: var(--goldt); font-variant-numeric: tabular-nums; min-width: 90px; text-align: center; }
  .chipbtns { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .chipbtn { position: relative; display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; border: 0; padding: 0; cursor: pointer; background: transparent;
             font: 900 13px/1 Ubuntu, sans-serif; color: #111; transition: transform .1s; }
  .chipbtn .chip { position: absolute; inset: 0; width: 100%; height: 100%; }
  .chipbtn span.l { position: relative; z-index: 1; padding: 3px 5px; border-radius: 999px; background: rgba(255,255,255,.92); }
  .chipbtn.hr span.l { background: rgba(0,0,0,.82); color: #ffe082; box-shadow: 0 0 0 1px rgba(255,215,64,.75); }
  .chipbtn span.l { z-index: 2; }
  .chipbtn:hover { transform: translateY(-3px); }
  .chipbtn:active { transform: translateY(1px); }
  .chipbtn[disabled] { opacity: .35; cursor: not-allowed; transform: none; }
  .back { display: inline-block; margin: 0 0 10px; font-size: 14px; }
  @media (max-width: 640px) {
    .felt.bj { border-radius: 24px; min-height: 0; padding: 14px 10px 16px; }
    .bj-shoe { display: none; }
    .bj-seats { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 6px; }
    .bj-seats > .seat:nth-child(n) { margin-top: 0; }
    .hands { --hw: 28px; }
    .plate .nm { max-width: 96px; }
    .bj-rules { font-size: 10px; letter-spacing: .1em; }
    .chipbtn { width: 52px; height: 52px; }
  }
</style>
<main class="cz" id="cb" data-game="bj" data-table="<%= tableId || '' %>" data-signed="<%= signedIn ? '1' : '' %>">
  <%- include('partials/casino-top', { t, game: 'bj', tableId }) %>
  <% if (!tableId) { %><%- include('partials/casino-lobby', { t, game: 'bj', bjOn: locals.bjOn, hmOn: locals.hmOn }) %><% } else { %>
  <section id="cz-table" hidden>
    <a class="back" href="/casino/blackjack">← <%- t('casino.all_tables') %></a>
    <div class="felt bj" id="cz-felt">
      <div class="bj-shoe" aria-hidden="true"></div>
      <div class="bj-dealer">
        <div class="who"><span class="av" aria-hidden="true"><img src="/public/img/pepe.png" alt=""></span><span class="felt-lbl"><%- t('casino.dealer') %></span><span class="val" id="cz-dval"></span></div>
        <span class="cards fan" id="cz-dealer" role="group" aria-label="<%- t('casino.dealer_cards') %>"></span>
      </div>
      <p class="bj-rules"><%- t('casino.bj_felt') %></p>
      <div class="bj-center">
        <div class="clock" id="cz-fclock" hidden><span class="secs"></span></div>
        <div class="felt-msg" id="cz-msg"></div>
      </div>
      <div class="bj-seats" id="cz-seats"></div>
    </div>
    <div class="felt-meta" id="cz-meta"></div>
    <div class="watchbar" id="cz-watchbar" hidden></div>

    <div class="dock" id="cz-dock" hidden>
      <div id="cz-betbox" hidden>
        <div class="stakebox">
          <span class="felt-lbl" id="cz-stakelbl"><%- t('casino.your_bet') %></span>
          <span class="amt" id="cz-stake">0</span>
          <button type="button" class="cz-btn ghost sm" id="cz-clear"><%- t('casino.clear') %></button>
        </div>
        <p class="dock-note" id="cz-limits"></p>
        <div class="dock-row chipbtns" id="cz-chips" role="group" aria-label="<%- t('casino.chips') %>"></div>
        <div class="dock-row">
          <button type="button" class="cz-btn ghost" id="cz-rebet" hidden></button>
          <button type="button" class="cz-btn gold" id="cz-bet"></button>
          <button type="button" class="cz-btn ghost sm" id="cz-auto" aria-pressed="false"></button>
        </div>
      </div>
      <div id="cz-playbox" hidden>
        <div class="dock-row dock-turn">
          <div class="clock" id="cz-dclock" hidden><span class="secs"></span></div>
          <div class="dock-acts">
            <button type="button" class="cz-btn gold" data-v="hit"><%- t('casino.hit') %></button>
            <button type="button" class="cz-btn green" data-v="stand"><%- t('casino.stand') %></button>
            <button type="button" class="cz-btn amber" data-v="double"><%- t('casino.double') %></button>
            <button type="button" class="cz-btn blue" data-v="split"><%- t('casino.split') %></button>
            <button type="button" class="cz-btn ghost" data-v="insurance"><%- t('casino.insurance') %></button>
          </div>
        </div>
      </div>
      <p class="dock-note" id="cz-wait" hidden></p>
      <div class="dock-row" id="cz-misc">
        <button type="button" class="cz-btn ghost sm" id="cz-deal" hidden><%- t('casino.deal_now') %></button>
        <button type="button" class="cz-btn ghost sm" id="cz-autooff" hidden><%- t('casino.autobet_off') %></button>
        <button type="button" class="cz-btn ghost sm" id="cz-leave" hidden><%- t('casino.leave') %></button>
      </div>
    </div>
  </section>
  <%- include('partials/casino-sheets', { t }) %>
  <% } %>
</main>
<script src="/public/js/casino-ui.js?v=2"></script>
<script src="/public/js/casinobj.js?v=5"></script>
