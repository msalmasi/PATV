<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('premium.page_title'), user: user }) %>
<%
  // 1.99iv: /premium - the two paid tiers (premium.js) + 🧸 sticker packs (stickers.js). S = premium.state(), stickers = stickers.pageData()
  const fmt = (n) => Math.round(Number(n) || 0).toLocaleString('en-US');
  const day = (ms) => ms ? new Date(ms).toISOString().slice(0, 10) : '';
  const V = S.viewer || {}, PASS = V.pass, PAD = S.pad, ST = S.stripe || { enabled: false };
  const STK = stickers || { packs: [], signed: false, allowance: null };
  const stkL_ = (k, d) => (t.has(k) ? t(k) : t.esc(d));   // 1.99lf: pack / sticker names from en.json (stk.pack.* / stk.s.*), English from stickers.json
  const statusTxt = (s) => !s ? '' : s.status === 'comped' ? (s.comp_until ? t('premium.status.comped_until', { date: day(s.comp_until) }) : t('premium.status.comped')) : s.status === 'active' ? t('premium.status.active', { date: day(s.paid_through) })
    : s.status === 'grace' ? t('premium.status.grace', { date: day(s.ends) }) : s.status === 'lapsed' ? t('premium.status.lapsed', { date: day(s.paid_through) }) : t('premium.status.inactive');
  const PT_PERKS = [
    ['📺', t('premium.pt.badge'), t('premium.pt.badge_d'), 'live'],
    ['🖼️', t('premium.pt.theme'), t('premium.pt.theme_d'), 'live'],
    ['🎬', t('premium.pt.intro'), t('premium.pt.intro_d'), 'live'],
    ['🏷️', t('premium.pt.badge_slots', { n: S.perks.prime_extra_badges }), t('premium.pt.badge_slots_d', { n: 3 + S.perks.prime_extra_badges }), 'live'],
    ['🎤', t('premium.pt.stage_slots', { n: S.perks.prime_extra_slots }), t('premium.pt.stage_slots_d'), 'live'],
    ['⚡', t('premium.pt.lowlat'), t('premium.pt.lowlat_d'), 'soon'],
    ['⏱️', t('premium.pt.longer'), t('premium.pt.longer_d'), 'soon'],
    ['🏦', t('premium.pt.vault'), t('premium.pt.vault_d'), 'soon'],
    ['🧸', t('premium.pt.sticker'), t('premium.pt.sticker_d'), 'soon'],
    ['📈', t('premium.pt.analytics'), t('premium.pt.analytics_d'), 'soon'],
  ];
  // 1.99qp: 💎 Prime Time Plus (premium.js prime_plus) - everything in Prime Time, plus these
  const PP_PERKS = [
    ['📺', t('premium.pp.all_pt'), t('premium.pp.all_pt_d'), 'live'],
    ['🌉', t('premium.pp.bridge'), t('premium.pp.bridge_d'), 'live'],
    ['🗄️', t('premium.pp.retention'), t('premium.pp.retention_d'), 'live'],
    ['🔊', t('premium.pp.soundboard', { n: S.perks.sb_slots_plus }), t('premium.pp.soundboard_d', { pt: S.perks.sb_slots_prime }), 'soon'],
    ['💎', t('premium.pp.stickers'), t('premium.pp.stickers_d'), 'live'],
    ['✨', t('premium.pp.cosmetics'), t('premium.pp.cosmetics_d'), 'live'],
    ['🏷️', t('premium.pp.flair'), t('premium.pp.flair_d'), 'live'],
  ];
  const PLUS = PAD ? (PAD.plus || null) : null;
  const SP_PERKS = [
    ['🌈', t('premium.sp.name'), t('premium.sp.name_d'), 'live'],
    ['💫', t('premium.sp.ring'), t('premium.sp.ring_d'), 'live'],
    ['🏞️', t('premium.sp.banner'), t('premium.sp.banner_d'), 'live'],
    ['🧸', t('premium.sp.stickers', { count: S.perks.sp_sticker_packs }), t('premium.sp.stickers_d'), 'live'],
    ['📤', t('premium.sp.uploads', { n: S.perks.sp_upload_mult }), t('premium.sp.uploads_d'), 'live'],
    ['🎟️', t('premium.sp.chip'), t('premium.sp.chip_d'), 'live'],
    ['🎨', t('premium.sp.flair'), t('premium.sp.flair_d'), 'soon'],
    ['🐸', t('premium.sp.priority'), t('premium.sp.priority_d'), 'soon'],
  ];
  const routeRow = (r) => r.shares.map((x) => x.pct + '% ' + x.label).join(' · ') + (r.rest ? ' · ' + r.rest + '% 🏛️ Federal Reserve' : '');
%>
<link rel="stylesheet" href="/public/css/padfx.css?v=3">
<style>
  /* 1.99pu polish: ds-page + ds-hero.gold / ds-card / ds-btn / ds-in / ds-tbl. Area accent = premium violet (ink #12002a). */
  .pm { --ds-ac: var(--ds-acc-premium); --ds-ac-2: #cdb2ff; --ds-ac-bg: rgba(179, 136, 255, .13); --ds-ac-line: #4a3577; --ds-on-ac: #12002a; }
  .pm h1 em { font-style: normal; background: linear-gradient(90deg, var(--ds-gold), #ff6a4d 50%, #b388ff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .pm .paused { color: var(--ds-warn); }
  .pm .tiers { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--ds-sp-4); min-width: 0; }
  .pm .card { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-5); display: grid; gap: var(--ds-sp-3);
              align-content: start; min-width: 0; grid-template-columns: minmax(0, 1fr); }
  .pm .card p { margin: 0; }
  .pm .tier.pt { border-color: var(--ds-gold-line); background: linear-gradient(180deg, #1d1606 0%, var(--ds-surface) 40%); }
  .pm .tier.pp { border-color: #2f5f7a; background: linear-gradient(180deg, #0c1a26 0%, var(--ds-surface) 40%); }
  .pm .tier.pp .price { color: #9fe3ff; }
  .pm .tier.sp { border-color: var(--ds-ac-line); background: linear-gradient(180deg, #170f28 0%, var(--ds-surface) 40%); }
  .pm .tier h3 { margin: 0; font: 700 22px/1.25 var(--ds-font); color: var(--ds-text-strong); display: flex; align-items: center; gap: var(--ds-sp-2); flex-wrap: wrap; }
  .pm .price { font-size: var(--ds-fs-num-lg); font-weight: 700; line-height: 1.2; color: var(--ds-gold-text); font-variant-numeric: tabular-nums; }
  .pm .price small { font-size: var(--ds-fs-meta); color: var(--ds-text-muted); font-weight: 400; }
  .pm .perks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--ds-sp-2h); }
  .pm .perks li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: var(--ds-sp-2h); align-items: start; font-size: var(--ds-fs-sm); line-height: 1.45; }
  .pm .perks li b { color: var(--ds-text-strong); }
  .pm .perks li span.d { color: var(--ds-text-muted); display: block; font-size: var(--ds-fs-meta); }
  .pm .perks li.soon b, .pm .perks li.soon > .ds-ic { opacity: .75; }
  .pm .soon-tag { margin-inline-start: 6px; color: var(--ds-warn); border-color: var(--ds-warn-line); }
  .pm .stat { font-size: var(--ds-fs-sm); color: var(--ds-text); background: var(--ds-sunken); border: 1px solid var(--ds-line-soft); border-radius: var(--ds-r-lg); padding: var(--ds-sp-3) var(--ds-sp-3h); }
  .pm .row { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2); align-items: center; min-width: 0; margin: 0; }
  .pm .row > .ds-in { flex: 1 1 140px; width: auto; }
  .pm .row > .ds-check { flex: 1 1 auto; }
  .pm .mut { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); }
  .pm .msg { font-size: var(--ds-fs-sm); min-height: 1em; margin: 0; }
  .pm .msg.ok { color: var(--ds-ok); } .pm .msg.err { color: var(--ds-danger); }
  .pm .msg:empty { display: none; }
  .pm .contrib { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
  .pm .contrib li { font-size: var(--ds-fs-xs); background: #1d1d1d; border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-pill); padding: 2px 8px; }
  .pm .packs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: var(--ds-sp-3); }
  .pm .pack { background: var(--ds-sunken); border-color: var(--ds-line-soft); padding: var(--ds-sp-4); }
  .pm .pack h3 { margin: 0; font: 700 var(--ds-fs-h3)/var(--ds-lh-h3) var(--ds-font); color: var(--ds-text-strong); display: flex; align-items: center; gap: var(--ds-sp-2); flex-wrap: wrap; }
  .pm .pack .sheet { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .pm .pack .sheet img { width: 100%; aspect-ratio: 1; image-rendering: pixelated; background: #1a1a1a; border-radius: var(--ds-r-sm); padding: 4px; }
  .pm .rules { margin: 0; padding-inline-start: 18px; color: var(--ds-text-2); line-height: 1.6; font-size: var(--ds-fs-sm); }
  .pm .rules li + li { margin-block-start: 4px; }
  .pm .card-pay { border-block-start: 1px dashed var(--ds-line-strong); padding-block-start: var(--ds-sp-3); }
  @media (max-width: 520px) { .pm .card { padding: var(--ds-sp-4); } .pm .price { font-size: 22px; } }
  @media (prefers-reduced-motion: reduce) { .pm *, .pm *::before, .pm *::after { animation: none !important; transition: none !important; } }
</style>
<main class="ds-page wide pm" id="pm" data-pad="<%= PAD ? PAD.slug : '' %>">
  <section class="ds-hero gold">
    <span class="ds-eyebrow"><%- t('premium.eyebrow') %></span>
    <h1><%- t('premium.h1') %></h1>
    <p class="ds-lead"><%- t('premium.lead3', { days: S.period_days }) %></p>
    <% if (!S.sales) { %><p class="ds-lead paused"><%- t('premium.paused') %></p><% } %>
  </section>

  <div class="tiers">
    <section class="card tier pt" aria-labelledby="ptH">
      <h3 id="ptH"><span class="ds-ic" aria-hidden="true">📺</span> Prime Time <span class="ds-tag"><%- t('premium.pt.tag') %></span></h3>
      <div class="price"><%= fmt(S.prices.prime_time) %> PAT <small><%- t('premium.pt.per_period', { days: S.period_days, price: fmt(S.day_price.prime_time) }) %></small></div>
      <ul class="perks">
        <% PT_PERKS.forEach((p) => { %><li class="<%= p[3] %>"><span class="ds-ic lg" aria-hidden="true"><%= p[0] %></span><span><b><%- p[1] %></b><% if (p[3] === 'soon') { %><span class="ds-tag soon-tag"><%- t('premium.coming_soon') %></span><% } %><span class="d"><%- p[2] %></span></span></li><% }) %>
      </ul>
      <% if (PAD) { %>
        <div class="stat" id="ptState">
          <div><b>p/<%= PAD.slug %></b><% if (PAD.title && PAD.title !== PAD.slug) { %> · <%= PAD.title %><% } %></div>
          <div><%- statusTxt(PAD) %><% if (PAD.renewing && PAD.status !== 'comped') { %> · <%- t('premium.renews') %><% } %></div>
          <% if (PAD.contributors && PAD.contributors.length) { %><div class="mut" style="margin-block-start:6px"><%- t('premium.backed_by') %></div><ul class="contrib"><% PAD.contributors.forEach((c) => { %><li><% if (c.anon) { %><%- t('premium.anon_backer') %><% } else { %><%= c.name %><% } %> · <%= fmt(c.amount) %></li><% }) %></ul><% } %>
        </div>
        <% if (PLUS && PLUS.active) { %><p class="mut"><%- t('premium.pp.includes_pt') %></p><% } else if (PAD.status !== 'comped') { %>
          <% if (V.signed) { %>
            <div class="row">
              <button type="button" class="ds-btn gold" data-buy="prime_time" data-months="1"><%- t(PAD.mine ? 'premium.get_1' : 'premium.gift_1', { price: fmt(S.prices.prime_time) }) %></button>
              <button type="button" class="ds-btn ghost" data-buy="prime_time" data-months="3"><%- t('premium.periods_3', { price: fmt(S.prices.prime_time * 3) }) %></button>
            </div>
            <div class="row"><label class="mut" for="ptAmt"><%- t('premium.chip_in') %></label><input type="number" class="ds-in num" inputmode="numeric" id="ptAmt" min="<%= S.day_price.prime_time %>" step="1000" value="<%= S.day_price.prime_time * 7 %>" style="max-width:180px"> <span class="mut">PAT</span>
              <button type="button" class="ds-btn gold" data-chip="prime_time"><span class="ds-ic" aria-hidden="true">🤝</span> <%- t('premium.chip_in') %></button></div>
            <div class="row"><label class="ds-check"><input type="checkbox" id="ptRenew"<%= PAD.renewer_me ? ' checked' : '' %>> <%- t('premium.renew_label', { days: S.period_days }) %></label></div>
            <% if (!PAD.mine) { %><div class="row"><label class="ds-check"><input type="checkbox" id="ptAnon"> <%- t('gifts.anon.box_pad') %></label></div><% } %>
            <% if (ST.enabled && ST.tiers && ST.tiers.prime_time && PAD.mine) { %><div class="row card-pay"><button type="button" class="ds-btn quiet" data-card="prime_time"><span class="ds-ic" aria-hidden="true">💳</span> <%- t('premium.pay_card') %><%- ST.test ? ' ' + t('premium.test_mode') : '' %></button><% if (PAD.stripe) { %><button type="button" class="ds-btn ghost" data-portal="prime_time"><%- t('premium.manage_card') %></button><% } %></div><% } %>
          <% } else { %><p><%- t('premium.pt.signin', { link: '<a href="/login?next=' + t.esc(encodeURIComponent('/premium?pad=' + PAD.slug)) + '">' + t('premium.sign_in') + '</a>' }) %></p><% } %>
        <% } %>
        <p class="mut"><a href="/p/<%= encodeURIComponent(PAD.slug) %>"><%- t('premium.pt.back', { pad: PAD.slug }) %></a> · <a href="/premium"><%- t('premium.pt.another') %></a></p>
      <% } else { %>
        <% const MISS = S.pad_missing; if (MISS) { %>
          <div class="stat padmiss" id="ptMiss" role="alert">
            <div><%- MISS.query ? t('premium.pt.no_pad', { pad: MISS.query }) : t('premium.pt.no_pad_empty') %></div>
            <% if (MISS.suggestions && MISS.suggestions.length) { %>
              <div class="mut" style="margin-block-start:6px"><%- t('premium.pt.did_you_mean') %></div>
              <ul class="contrib"><% MISS.suggestions.forEach((x) => { %><li><a href="/premium?pad=<%= encodeURIComponent(x.slug) %>"><b><%= x.title %></b> · p/<%= x.slug %></a></li><% }) %></ul>
            <% } else { %><div class="mut" style="margin-block-start:6px"><%- t('premium.pt.no_pad_help') %></div><% } %>
          </div>
        <% } %>
        <form class="row" action="/premium" method="GET"><label class="mut" for="ptPad"><%- t('premium.pt.which') %></label><input type="text" class="ds-in" id="ptPad" name="pad" placeholder="<%- t('premium.pt.which_ph') %>" autocomplete="off" value="<%= MISS ? MISS.query : '' %>" required><button class="ds-btn"><%- t('premium.pt.go') %></button></form>
        <p class="mut"><%- t('premium.pt.or_open') %></p>
      <% } %>
    </section>

    <section class="card tier pp" id="plus" aria-labelledby="ppH">
      <h3 id="ppH"><span class="ds-ic" aria-hidden="true">💎</span> Prime Time Plus <span class="ds-tag"><%- t('premium.pp.tag') %></span></h3>
      <div class="price"><%= fmt(S.prices.prime_plus) %> PAT <small><%- t('premium.pt.per_period', { days: S.period_days, price: fmt(S.day_price.prime_plus) }) %></small></div>
      <%# 1.99qy: at most ptplus_max_rooms Plus pads at once (Pepe can be in that many Camfrog rooms) %>
      <% const SPOTS = S.plus_spots || { used: 0, max: 5, left: 5, soldOut: false }; const fullForPad = SPOTS.soldOut && !(PLUS && PLUS.active); %>
      <p class="ds-row" id="ppSpots"><span class="ds-tag<%= SPOTS.soldOut ? '' : ' ac' %>"><%- t('premium.pp.spots', { used: SPOTS.used, max: SPOTS.max }) %></span><% if (SPOTS.soldOut) { %> <b><%- t('premium.pp.sold_out') %></b><% } %></p>
      <p class="mut"><%- t('premium.pp.why_cap', { max: SPOTS.max }) %></p>
      <ul class="perks">
        <% PP_PERKS.forEach((p) => { %><li class="<%= p[3] %>"><span class="ds-ic lg" aria-hidden="true"><%= p[0] %></span><span><b><%- p[1] %></b><% if (p[3] === 'soon') { %><span class="ds-tag soon-tag"><%- t('premium.coming_soon') %></span><% } %><span class="d"><%- p[2] %></span></span></li><% }) %>
      </ul>
      <% if (PAD && PLUS) { %>
        <div class="stat" id="ppState">
          <div><b>p/<%= PAD.slug %></b><% if (PAD.title && PAD.title !== PAD.slug) { %> · <%= PAD.title %><% } %></div>
          <div><%- statusTxt(PLUS) %><% if (PLUS.renewing && PLUS.status !== 'comped') { %> · <%- t('premium.renews') %><% } %></div>
          <% if (PLUS.contributors && PLUS.contributors.length) { %><div class="mut" style="margin-block-start:6px"><%- t('premium.backed_by') %></div><ul class="contrib"><% PLUS.contributors.forEach((c) => { %><li><% if (c.anon) { %><%- t('premium.anon_backer') %><% } else { %><%= c.name %><% } %> · <%= fmt(c.amount) %></li><% }) %></ul><% } %>
        </div>
        <% if (PLUS.status !== 'comped' && fullForPad) { %>
          <% if (V.signed) { %><div class="row"><button type="button" class="ds-btn<%= S.plus_waitlisted ? ' ghost' : ' gold' %>" data-plus-wait="<%= S.plus_waitlisted ? '0' : '1' %>"><%- S.plus_waitlisted ? t('premium.pp.waitlist_off') : t('premium.pp.waitlist_on') %></button></div><% } %>
        <% } else if (PLUS.status !== 'comped') { %>
          <% if (V.signed) { %>
            <% if (PLUS.upgrade) { %><p class="mut" id="ppUpgrade"><%- t('premium.pp.upgrade_note', { pt: PLUS.upgrade.pt_days, plus: PLUS.upgrade.plus_days }) %></p><% } %>
            <div class="row">
              <button type="button" class="ds-btn gold" data-buy="prime_plus" data-months="1"><%- t(PLUS.upgrade ? 'premium.pp.upgrade_1' : PAD.mine ? 'premium.get_1' : 'premium.gift_1', { price: fmt(S.prices.prime_plus) }) %></button>
              <button type="button" class="ds-btn ghost" data-buy="prime_plus" data-months="3"><%- t('premium.periods_3', { price: fmt(S.prices.prime_plus * 3) }) %></button>
            </div>
            <%# 1.99qt: chip in to the pad's Plus like Prime Time (amount / plus_price x 30 days, at least one day's worth) %>
            <div class="row"><label class="mut" for="ppAmt"><%- t('premium.chip_in') %></label><input type="number" class="ds-in num" inputmode="numeric" id="ppAmt" min="<%= S.day_price.prime_plus %>" step="1000" value="<%= S.day_price.prime_plus * 7 %>" style="max-width:180px"> <span class="mut">PAT</span>
              <button type="button" class="ds-btn gold" data-chip="prime_plus"><span class="ds-ic" aria-hidden="true">🤝</span> <%- t('premium.chip_in') %></button></div>
            <div class="row"><label class="ds-check"><input type="checkbox" id="ppRenew"<%= PLUS.renewer_me ? ' checked' : '' %>> <%- t('premium.renew_label', { days: S.period_days }) %></label></div>
            <% if (!PAD.mine) { %><div class="row"><label class="ds-check"><input type="checkbox" id="ppAnon"> <%- t('gifts.anon.box_pad') %></label></div><% } %>
          <% } else { %><p><%- t('premium.pt.signin', { link: '<a href="/login?next=' + t.esc(encodeURIComponent('/premium?pad=' + PAD.slug)) + '">' + t('premium.sign_in') + '</a>' }) %></p><% } %>
        <% } %>
      <% } else { %>
        <p class="mut"><%- t('premium.pp.pick') %></p>
      <% } %>
    </section>

    <section class="card tier sp" aria-labelledby="spH">
      <h3 id="spH"><span class="ds-ic" aria-hidden="true">🎟️</span> Season Pass <span class="ds-tag ac"><%- t('premium.sp.tag') %></span></h3>
      <div class="price"><%= fmt(S.prices.season_pass) %> PAT <small><%- t('premium.sp.per_period', { days: S.period_days }) %></small></div>
      <ul class="perks">
        <% SP_PERKS.forEach((p) => { %><li class="<%= p[3] %>"><span class="ds-ic lg" aria-hidden="true"><%= p[0] %></span><span><b><%- p[1] %></b><% if (p[3] === 'soon') { %><span class="ds-tag soon-tag"><%- t('premium.coming_soon') %></span><% } %><span class="d"><%- p[2] %></span></span></li><% }) %>
      </ul>
      <% if (V.signed) { %>
        <div class="stat"><%- t('premium.sp.yours') %> <%- statusTxt(PASS) %><% if (PASS && PASS.renewing && PASS.status !== 'comped') { %> · <%- t('premium.renews') %><% } %><% if (PASS && PASS.active) { %> · <a href="/cosmetics?tab=mine#tabs"><%- t('premium.sp.equip') %></a><% } %></div>
        <% if (!PASS || PASS.status !== 'comped') { %>
          <div class="row">
            <button type="button" class="ds-btn" data-buy="season_pass" data-months="1"><%- t('premium.get_1', { price: fmt(S.prices.season_pass) }) %></button>
            <button type="button" class="ds-btn ghost" data-buy="season_pass" data-months="3"><%- t('premium.periods_3', { price: fmt(S.prices.season_pass * 3) }) %></button>
          </div>
          <div class="row"><label class="ds-check"><input type="checkbox" id="spRenew"<%= PASS && PASS.renewer_me ? ' checked' : '' %>> <%- t('premium.renew_label', { days: S.period_days }) %></label></div>
          <% if (ST.enabled && ST.tiers && ST.tiers.season_pass) { %><div class="row card-pay"><button type="button" class="ds-btn quiet" data-card="season_pass"><span class="ds-ic" aria-hidden="true">💳</span> <%- t('premium.pay_card') %><%- ST.test ? ' ' + t('premium.test_mode') : '' %></button><% if (PASS && PASS.stripe) { %><button type="button" class="ds-btn ghost" data-portal="season_pass"><%- t('premium.manage_card') %></button><% } %></div><% } %>
        <% } %>
        <div class="row"><label class="mut" for="spGift"><%- t('premium.sp.gift_to') %></label><input type="text" class="ds-in" id="spGift" placeholder="<%- t('premium.sp.gift_ph') %>" autocomplete="off"><button type="button" class="ds-btn gold" data-gift="season_pass"><%- t('premium.sp.gift_btn', { price: fmt(S.prices.season_pass) }) %></button></div>
        <div class="row"><label class="ds-check"><input type="checkbox" id="spAnon"> <%- t('gifts.anon.box') %></label></div>
      <% } else { %><p><%- t('premium.sp.signin', { link: '<a href="/login?next=/premium">' + t('premium.sign_in') + '</a>' }) %></p><% } %>
    </section>
  </div>
  <% if (V.signed) { %><p class="msg" id="pmMsg" role="status" aria-live="polite"></p><% } %>

  <section class="card" id="stickers" aria-labelledby="stkH">
    <h2 class="ds-h2 dot" id="stkH"><%- t('premium.stk.heading') %></h2>
    <%# 1.99qp: perk packs (stickers.json perk) are never sold - they come with a Season Pass / Prime Time Plus %>
    <p class="mut"><%- t('premium.stk.intro', { price: fmt(S.prices.sticker_pack) }) %><% if (STK.allowance && STK.allowance.per) { %> · <%- t('premium.stk.left', { count: STK.allowance.left }) %><% } else { %> · <%- t('premium.stk.sp_includes', { n: S.perks.sp_sticker_packs }) %><% } %>.</p>
    <% if (STK.signed) { %><p class="row"><label class="ds-check"><input type="checkbox" id="stkAnon"> <%- t('gifts.anon.box_stk') %></label></p><% } %>
    <div class="packs">
      <% STK.packs.forEach((p) => { %>
        <div class="card pack">
          <h3><span class="ds-ic" aria-hidden="true"><%= p.emoji %></span> <%- stkL_('stk.pack.' + p.id + '.name', p.name) %><% if (p.owned) { %> <span class="ds-tag ac"><%- t('premium.stk.yours') %></span><% } %></h3>
          <p class="mut"><%- stkL_('stk.pack.' + p.id + '.desc', p.desc) %></p>
          <div class="sheet"><% p.stickers.forEach((s) => { const sn_ = stkL_('stk.s.' + p.id + '.' + s.id, s.name); %><img src="<%= s.url %>" alt="<%- sn_ %>" title="<%- sn_ %>" loading="lazy"><% }) %></div>
          <% if (p.perk) { %><p class="row"><span class="ds-tag ac"><%- p.perk === 'prime_plus' ? t('premium.stk.perk_plus') : t('premium.stk.perk_sp') %></span><% if (p.season) { %> <span class="ds-tag"><%- t('premium.stk.seasonal', { label: t.esc(p.season.label || '') }) %></span><% } %></p>
          <% } else if (STK.signed) { %><div class="row">
            <% if (!p.owned) { %>
              <% if (STK.allowance && STK.allowance.left) { %><button type="button" class="ds-btn sm" data-stk="<%= p.id %>" data-free="1"><%- t('premium.stk.claim') %></button><% } %>
              <button type="button" class="ds-btn sm gold" data-stk="<%= p.id %>"><%- t('premium.stk.buy', { price: fmt(p.price) }) %></button>
            <% } %>
            <button type="button" class="ds-btn sm ghost" data-stk-gift="<%= p.id %>"><%- t('premium.stk.gift') %></button>
          </div><% } %>
        </div>
      <% }) %>
    </div>
  </section>

  <% const crNav_ = typeof creatorNav === 'function' ? creatorNav(V.username) : { on: false }; if (crNav_.on) { %>
  <%# 1.99qp: ⭐ PATV Creators - the other way to support someone on PATV %>
  <section class="card" aria-labelledby="crH">
    <h2 class="ds-h2 dot" id="crH">⭐ <%- t('cr.title') %></h2>
    <p class="mut"><%- t('cr.links.premium_blurb') %></p>
    <div class="row"><a class="ds-btn ghost" href="/creators"><%- t('cr.links.browse') %></a><% if (V.signed) { %><a class="ds-btn<%= crNav_.creator ? '' : ' ghost' %>" href="<%= crNav_.creator ? '/creator' : '/creators#apply' %>"><%- crNav_.creator ? t('nav.creator_dash') : t('nav.become_creator') %></a><% } %></div>
  </section>
  <% } %>

  <section class="card" aria-labelledby="rtH">
    <h2 class="ds-h2 dot" id="rtH"><%- t('premium.routes.heading') %></h2>
    <div class="ds-tbl"><table>
      <thead><tr><th><%- t('premium.routes.what') %></th><th><%- t('premium.routes.routing') %></th></tr></thead><tbody>
      <% Object.keys(S.routes).forEach((k) => { const r = S.routes[k]; %><tr><td><%= r.label %></td><td><%= routeRow(r) %></td></tr><% }) %>
    </tbody></table></div>
    <p class="mut"><%- t('premium.routes.note', { link: '<a href="/economy">' + t('premium.routes.economy') + '</a>' }) %></p>
  </section>

  <section class="card" aria-labelledby="rlH">
    <h2 class="ds-h2 dot" id="rlH"><%- t('premium.rules.heading') %></h2>
    <ul class="rules">
      <li><%- t('premium.rules.time', { days: S.period_days }) %></li>
      <li><%- t('premium.rules.renewing') %></li>
      <li><%- t('premium.rules.grace', { count: S.grace_days }) %></li>
      <li><%- t('premium.rules.gifts') %></li>
      <li><%- t('premium.rules.admins') %></li>
    </ul>
  </section>
</main>
<% if (V.signed) { %>
<script>
(function () {
  var _t = typeof __t === 'function' ? __t : function (k, d, v) { return String(d).replace(/\{!?(\w+)\}/g, function (m, n) { return v && v[n] != null ? v[n] : m; }); };
  var root = document.getElementById('pm'), msg = document.getElementById('pmMsg'), pad = root.getAttribute('data-pad');
  function ref() { var a = new Uint8Array(12); crypto.getRandomValues(a); return Array.prototype.map.call(a, function (b) { return ('0' + b.toString(16)).slice(-2); }).join(''); }
  function say(t, ok) { msg.textContent = t; msg.className = 'msg ' + (ok ? 'ok' : 'err'); msg.scrollIntoView({ block: 'nearest' }); }
  function post(url, body) {
    return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json().catch(function () { return { ok: false, error: _t('js.premium.went_wrong', 'Something went wrong.') }; }); });
  }
  function fmt(n) { return Math.round(Number(n) || 0).toLocaleString('en-US'); }
  function done(j, okText) { if (j.ok) { say(okText, true); setTimeout(function () { location.reload(); }, 1100); } else say((j.error || _t('js.premium.didnt_work', 'That didn’t work.')) + (j.hint ? ' ' + j.hint : ''), false); }
  root.addEventListener('click', function (e) {
    var b = e.target.closest('button');
    if (!b || !root.contains(b)) return;
    var tier = b.getAttribute('data-buy') || b.getAttribute('data-gift');
    if (b.hasAttribute('data-buy')) {
      var months = Number(b.getAttribute('data-months')) || 1;
      var renewEl = document.getElementById(tier === 'prime_time' ? 'ptRenew' : tier === 'prime_plus' ? 'ppRenew' : 'spRenew');
      if (!confirm(_t('js.premium.confirm_pay', months > 1 ? 'Pay {price} PAT for {count} periods? Payments are final.' : 'Pay {price} PAT for {count} period? Payments are final.', { price: b.textContent.split('·').pop().trim(), count: months }))) return;
      b.disabled = true;
      var ptAnon = (tier === 'prime_time' || tier === 'prime_plus') && document.getElementById(tier === 'prime_plus' ? 'ppAnon' : 'ptAnon');      // 1.99mt: 🕶 anonymous (someone else's pad only)
      post('/api/premium/buy', { tier: tier, pad: pad || undefined, months: months, ref: ref(), renew: !!(renewEl && renewEl.checked), anon: !!(ptAnon && ptAnon.checked) })
        .then(function (j) { b.disabled = false; done(j, _t(j.upgrade ? 'js.premium.upgraded' : 'js.premium.paid_through', j.upgrade ? 'Upgraded to Prime Time Plus - paid through {date}.' : 'Done - paid through {date}.', { date: j.paid_through ? new Date(j.paid_through).toISOString().slice(0, 10) : '' })); });
    } else if (b.hasAttribute('data-chip')) {
      var chipTier = b.getAttribute('data-chip') === 'prime_plus' ? 'prime_plus' : 'prime_time';      // 1.99qt: Plus too
      var amt = Math.floor(Number(document.getElementById(chipTier === 'prime_plus' ? 'ppAmt' : 'ptAmt').value));
      if (!confirm(chipTier === 'prime_plus'
        ? _t('js.premium.confirm_chip_plus', 'Chip in {amount} PAT to p/{pad}’s Prime Time Plus? Payments are final.', { amount: fmt(amt), pad: pad })
        : _t('js.premium.confirm_chip', 'Chip in {amount} PAT to p/{pad}’s Prime Time? Payments are final.', { amount: fmt(amt), pad: pad }))) return;
      b.disabled = true;
      var chipAnon = document.getElementById(chipTier === 'prime_plus' ? 'ppAnon' : 'ptAnon');
      post('/api/premium/buy', { tier: chipTier, pad: pad, amount: amt, ref: ref(), anon: !!(chipAnon && chipAnon.checked) }).then(function (j) { b.disabled = false; done(j, _t('js.premium.chip_thanks', 'Thanks - p/{pad} is on air a little longer.', { pad: pad })); });
    } else if (b.hasAttribute('data-gift')) {
      var to = document.getElementById('spGift').value.trim();
      if (!to) return say(_t('js.premium.type_username', 'Type a username first.'), false);
      var spAnon = document.getElementById('spAnon'), anonSp = !!(spAnon && spAnon.checked);
      if (!confirm(anonSp ? _t('js.premium.confirm_gift_anon', 'Gift a Season Pass period to {user} anonymously? They won’t see who sent it. Payments are final.', { user: to })
                          : _t('js.premium.confirm_gift', 'Gift a Season Pass period to {user}? Payments are final.', { user: to }))) return;
      b.disabled = true;
      post('/api/premium/buy', { tier: 'season_pass', user: to, months: 1, ref: ref(), anon: anonSp }).then(function (j) { b.disabled = false; done(j, _t('js.premium.gifted', 'Gifted to {user} 🎁', { user: to })); });
    } else if (b.hasAttribute('data-stk')) {
      var free = b.hasAttribute('data-free');
      if (!free && !confirm(_t('js.premium.confirm_stk', 'Buy this sticker pack for {price} PAT?', { price: b.textContent.split('·').pop().trim() }))) return;
      b.disabled = true;
      post('/api/stickers/buy', { pack: b.getAttribute('data-stk'), ref: ref(), allowance: free }).then(function (j) { b.disabled = false; done(j, _t('js.premium.stk_yours', 'It’s yours - find it under 🧸 in the composer.')); });
    } else if (b.hasAttribute('data-stk-gift')) {
      var who = prompt(_t('js.premium.stk_gift_prompt', 'Gift this sticker pack to (username):'));
      if (!who) return;
      b.disabled = true;
      var stkAnon = document.getElementById('stkAnon');
      post('/api/stickers/buy', { pack: b.getAttribute('data-stk-gift'), ref: ref(), to: who.trim(), anon: !!(stkAnon && stkAnon.checked) }).then(function (j) { b.disabled = false; done(j, _t('js.premium.gifted', 'Gifted to {user} 🎁', { user: who.trim() })); });
    } else if (b.hasAttribute('data-plus-wait')) {                 // 1.99qy: sold out -> tell me when a spot frees up
      var onW = b.getAttribute('data-plus-wait') === '1';
      b.disabled = true;
      post('/api/premium/plus/waitlist', { on: onW }).then(function (j) { b.disabled = false; done(j, onW ? _t('js.premium.waitlist_on', 'You’re on the waitlist - we’ll tell you when a spot frees up.') : _t('js.premium.waitlist_off', 'You’re off the waitlist.')); });
    } else if (b.hasAttribute('data-card') || b.hasAttribute('data-portal')) {
      var card = b.hasAttribute('data-card');
      b.disabled = true;
      post(card ? '/api/premium/stripe/checkout' : '/api/premium/stripe/portal', { tier: b.getAttribute(card ? 'data-card' : 'data-portal'), pad: pad || undefined })
        .then(function (j) { b.disabled = false; if (j.ok && j.url) location.href = j.url; else say(j.error || _t('js.premium.no_card', 'Card payments aren’t available.'), false); });
    }
  });
  root.addEventListener('change', function (e) {
    var t = e.target;
    if (t.id !== 'ptRenew' && t.id !== 'spRenew' && t.id !== 'ppRenew') return;
    var tier = t.id === 'ptRenew' ? 'prime_time' : t.id === 'ppRenew' ? 'prime_plus' : 'season_pass';
    post('/api/premium/renew', { tier: tier, pad: pad || undefined, on: t.checked }).then(function (j) {
      if (j.ok) say(t.checked ? _t('js.premium.renew_on', '🔁 It renews from your balance now.') : _t('js.premium.renew_off', 'Renewal switched off.'), true);
      else { t.checked = !t.checked; say(j.error || _t('js.premium.didnt_work', 'That didn’t work.'), false); }
    });
  });
})();
</script>
<% } %>
