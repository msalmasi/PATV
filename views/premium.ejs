<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('premium.page_title'), user: user }) %>
<%
  // 1.99iv: /premium - the two paid tiers (premium.js) + 🧸 sticker packs (stickers.js). S = premium.state(), stickers = stickers.pageData()
  const fmt = (n) => Math.round(Number(n) || 0).toLocaleString('en-US');
  const day = (ms) => ms ? new Date(ms).toISOString().slice(0, 10) : '';
  const V = S.viewer || {}, PASS = V.pass, PAD = S.pad, ST = S.stripe || { enabled: false };
  const STK = stickers || { packs: [], signed: false, allowance: null };
  const statusTxt = (s) => !s ? '' : s.status === 'comped' ? t('premium.status.comped') : s.status === 'active' ? t('premium.status.active', { date: day(s.paid_through) })
    : s.status === 'grace' ? t('premium.status.grace', { date: day(s.ends) }) : s.status === 'lapsed' ? t('premium.status.lapsed', { date: day(s.paid_through) }) : t('premium.status.inactive');
  const PT_PERKS = [
    ['📺', t('premium.pt.badge'), t('premium.pt.badge_d'), 'live'],
    ['🖼️', t('premium.pt.theme'), t('premium.pt.theme_d'), 'live'],
    ['🎬', t('premium.pt.intro'), t('premium.pt.intro_d'), 'live'],
    ['🏷️', t('premium.pt.badge_slots', { n: S.perks.prime_extra_badges }), t('premium.pt.badge_slots_d', { n: 3 + S.perks.prime_extra_badges }), 'live'],
    ['🎤', t('premium.pt.stage_slots', { n: S.perks.prime_extra_slots }), t('premium.pt.stage_slots_d'), 'live'],
    ['⚡', t('premium.pt.lowlat'), t('premium.pt.lowlat_d'), 'soon'],
    ['⏱️', t('premium.pt.longer'), t('premium.pt.longer_d'), 'soon'],
    ['🏦', t('premium.pt.vault'), t('premium.pt.vault_d'), 'soon'],
    ['🧸', t('premium.pt.sticker'), t('premium.pt.sticker_d'), 'soon'],
    ['📈', t('premium.pt.analytics'), t('premium.pt.analytics_d'), 'soon'],
  ];
  const SP_PERKS = [
    ['🌈', t('premium.sp.name'), t('premium.sp.name_d'), 'live'],
    ['💫', t('premium.sp.ring'), t('premium.sp.ring_d'), 'live'],
    ['🏞️', t('premium.sp.banner'), t('premium.sp.banner_d'), 'live'],
    ['🧸', t('premium.sp.stickers', { count: S.perks.sp_sticker_packs }), t('premium.sp.stickers_d'), 'live'],
    ['📤', t('premium.sp.uploads', { n: S.perks.sp_upload_mult }), t('premium.sp.uploads_d'), 'live'],
    ['🎟️', t('premium.sp.chip'), t('premium.sp.chip_d'), 'live'],
    ['🎨', t('premium.sp.flair'), t('premium.sp.flair_d'), 'soon'],
    ['🐸', t('premium.sp.priority'), t('premium.sp.priority_d'), 'soon'],
  ];
  const routeRow = (r) => r.shares.map((x) => x.pct + '% ' + x.label).join(' · ') + (r.rest ? ' · ' + r.rest + '% 🏛️ Federal Reserve' : '');
%>
<link rel="stylesheet" href="/public/css/padfx.css?v=2">
<style>
  .pm { max-width: 1100px; margin: 0 auto; padding: 18px 16px 56px; font-family: Ubuntu, sans-serif; color: #e6e6e6; display: grid; gap: 18px; box-sizing: border-box; width: 100%; }
  .pm *, .pm *::before, .pm *::after { box-sizing: border-box; }
  .pm a { color: #81c784; text-decoration: none; }
  .pm a:hover { text-decoration: underline; }
  .pm .hero { background: radial-gradient(110% 140% at 0% 0%, #2a2208 0%, #111 55%), #111; border: 1px solid #2a2a2a; border-radius: 18px; padding: 22px; }
  .pm .eyebrow { font-family: 'Press Start 2P', monospace; font-size: 10px; letter-spacing: .12em; color: #ffcf40; }
  .pm h1 { font-size: clamp(26px, 4.2vw, 40px); line-height: 1.1; margin: 10px 0; }
  .pm h1 em { font-style: normal; background: linear-gradient(90deg, #ffcf40, #ff6a4d 50%, #9b5de5); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .pm .lead { color: #d3d3c9; font-size: 16px; line-height: 1.6; margin: 0; max-width: 66ch; }
  .pm h2 { margin: 0 0 12px; letter-spacing: .1em; text-transform: uppercase; color: #ffd700; font-family: 'Press Start 2P', monospace; font-size: 11px; line-height: 1.6; }
  .pm .tiers { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
  .pm .card { background: #121212; border: 1px solid #262626; border-radius: 16px; padding: 18px; display: grid; gap: 12px; align-content: start; min-width: 0; }
  .pm .tier.pt { border-color: #5a4210; background: linear-gradient(180deg, #1d1606 0%, #121212 40%); }
  .pm .tier.sp { border-color: #3d2466; background: linear-gradient(180deg, #170f28 0%, #121212 40%); }
  .pm .tier h3 { margin: 0; font-size: 22px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .pm .tag { font-size: 11px; font-weight: bold; padding: 2px 8px; border-radius: 999px; background: #222; color: #bbb; letter-spacing: .02em; }
  .pm .price { font-size: 26px; font-weight: 800; color: #fff; }
  .pm .price small { font-size: 13px; color: #aaa; font-weight: normal; }
  .pm .perks { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .pm .perks li { display: grid; grid-template-columns: 26px 1fr; gap: 8px; align-items: start; font-size: 14px; line-height: 1.45; }
  .pm .perks li b { color: #f2f2f2; }
  .pm .perks li span.d { color: #a9aea9; display: block; font-size: 13px; }
  .pm .perks li.soon { opacity: .72; }
  .pm .soon-tag { font-size: 10px; font-weight: bold; color: #f2d48a; border: 1px solid #5a4a20; border-radius: 999px; padding: 0 6px; margin-left: 4px; white-space: nowrap; }
  .pm .stat { font-size: 14px; color: #ddd; background: #181818; border: 1px solid #2a2a2a; border-radius: 10px; padding: 10px 12px; }
  .pm .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .pm .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 13px; border-radius: 9px; border: 1px solid #2b2b2b; background: #1a1a1a; color: #ddd; font: bold 14px Ubuntu, sans-serif; cursor: pointer; }
  .pm .btn.gold { background: linear-gradient(90deg, #ffcf40, #ff8a3d); color: #2a1600; border-color: #ffcf40; }
  .pm .btn.violet { background: linear-gradient(90deg, #9b5de5, #ff6ad5); color: #fff; border-color: #b77cf0; }
  .pm .btn.ghost { background: none; }
  .pm .btn:disabled { opacity: .5; cursor: default; }
  .pm input[type=text], .pm input[type=number] { background: #0d0d0d; border: 1px solid #333; color: #eee; border-radius: 8px; padding: 8px 10px; font: 14px Ubuntu, sans-serif; min-width: 0; }
  .pm .mut { color: #999; font-size: 13px; }
  .pm .msg { font-size: 14px; min-height: 1em; }
  .pm .msg.ok { color: #9be39f; } .pm .msg.err { color: #ff8a80; }
  .pm .contrib { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
  .pm .contrib li { font-size: 12px; background: #1d1d1d; border: 1px solid #2a2a2a; border-radius: 999px; padding: 2px 8px; }
  .pm .packs { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .pm .pack .sheet { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .pm .pack .sheet img { width: 100%; aspect-ratio: 1; image-rendering: pixelated; background: #1a1a1a; border-radius: 8px; padding: 4px; }
  .pm table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .pm td, .pm th { text-align: left; padding: 8px 6px; border-bottom: 1px solid #222; vertical-align: top; }
  .pm th { color: #aaa; font-weight: normal; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
  .pm .rules { margin: 0; padding-left: 18px; color: #ccc; line-height: 1.6; font-size: 14px; }
  .pm .card-pay { border-top: 1px dashed #333; padding-top: 10px; }
  @media (max-width: 520px) { .pm .hero, .pm .card { padding: 14px; } .pm .price { font-size: 22px; } }
</style>
<main class="pm" id="pm" data-pad="<%= PAD ? PAD.slug : '' %>">
  <section class="hero">
    <div class="eyebrow"><%- t('premium.eyebrow') %></div>
    <h1><%- t('premium.h1') %></h1>
    <p class="lead"><%- t('premium.lead', { days: S.period_days }) %></p>
    <% if (!S.sales) { %><p class="lead" style="color:#f2d48a;margin-top:10px"><%- t('premium.paused') %></p><% } %>
  </section>

  <div class="tiers">
    <section class="card tier pt" aria-labelledby="ptH">
      <h3 id="ptH">📺 Prime Time <span class="tag"><%- t('premium.pt.tag') %></span></h3>
      <div class="price"><%= fmt(S.prices.prime_time) %> PAT <small><%- t('premium.pt.per_period', { days: S.period_days, price: fmt(S.day_price.prime_time) }) %></small></div>
      <ul class="perks">
        <% PT_PERKS.forEach((p) => { %><li class="<%= p[3] %>"><span aria-hidden="true"><%= p[0] %></span><span><b><%- p[1] %></b><% if (p[3] === 'soon') { %><span class="soon-tag"><%- t('premium.coming_soon') %></span><% } %><span class="d"><%- p[2] %></span></span></li><% }) %>
      </ul>
      <% if (PAD) { %>
        <div class="stat" id="ptState">
          <div><b>p/<%= PAD.slug %></b><% if (PAD.title && PAD.title !== PAD.slug) { %> · <%= PAD.title %><% } %></div>
          <div><%- statusTxt(PAD) %><% if (PAD.renewing && PAD.status !== 'comped') { %> · <%- t('premium.renews') %><% } %></div>
          <% if (PAD.contributors && PAD.contributors.length) { %><div class="mut" style="margin-top:6px"><%- t('premium.backed_by') %></div><ul class="contrib"><% PAD.contributors.forEach((c) => { %><li><%= c.name %> · <%= fmt(c.amount) %></li><% }) %></ul><% } %>
        </div>
        <% if (PAD.status !== 'comped') { %>
          <% if (V.signed) { %>
            <div class="row">
              <button type="button" class="btn gold" data-buy="prime_time" data-months="1"><%- t(PAD.mine ? 'premium.get_1' : 'premium.gift_1', { price: fmt(S.prices.prime_time) }) %></button>
              <button type="button" class="btn ghost" data-buy="prime_time" data-months="3"><%- t('premium.periods_3', { price: fmt(S.prices.prime_time * 3) }) %></button>
            </div>
            <div class="row"><label class="mut" for="ptAmt"><%- t('premium.chip_in') %></label><input type="number" id="ptAmt" min="<%= S.day_price.prime_time %>" step="1000" value="<%= S.day_price.prime_time * 7 %>" style="width:150px"> <span class="mut">PAT</span>
              <button type="button" class="btn" data-chip="1">🤝 <%- t('premium.chip_in') %></button></div>
            <div class="row"><label class="mut"><input type="checkbox" id="ptRenew"<%= PAD.renewer_me ? ' checked' : '' %>> <%- t('premium.renew_label', { days: S.period_days }) %></label></div>
            <% if (ST.enabled && ST.tiers && ST.tiers.prime_time && PAD.mine) { %><div class="row card-pay"><button type="button" class="btn" data-card="prime_time">💳 <%- t('premium.pay_card') %><%- ST.test ? ' ' + t('premium.test_mode') : '' %></button><% if (PAD.stripe) { %><button type="button" class="btn ghost" data-portal="prime_time"><%- t('premium.manage_card') %></button><% } %></div><% } %>
          <% } else { %><p><%- t('premium.pt.signin', { link: '<a href="/login?next=' + t.esc(encodeURIComponent('/premium?pad=' + PAD.slug)) + '">' + t('premium.sign_in') + '</a>' }) %></p><% } %>
        <% } %>
        <p class="mut"><a href="/p/<%= encodeURIComponent(PAD.slug) %>"><%- t('premium.pt.back', { pad: PAD.slug }) %></a> · <a href="/premium"><%- t('premium.pt.another') %></a></p>
      <% } else { %>
        <form class="row" action="/premium" method="GET"><label class="mut" for="ptPad"><%- t('premium.pt.which') %></label><input type="text" id="ptPad" name="pad" placeholder="<%- t('premium.pt.which_ph') %>" autocomplete="off" style="flex:1"><button class="btn gold"><%- t('premium.pt.go') %></button></form>
        <p class="mut"><%- t('premium.pt.or_open') %></p>
      <% } %>
    </section>

    <section class="card tier sp" aria-labelledby="spH">
      <h3 id="spH">🎟️ Season Pass <span class="tag"><%- t('premium.sp.tag') %></span></h3>
      <div class="price"><%= fmt(S.prices.season_pass) %> PAT <small><%- t('premium.sp.per_period', { days: S.period_days }) %></small></div>
      <ul class="perks">
        <% SP_PERKS.forEach((p) => { %><li class="<%= p[3] %>"><span aria-hidden="true"><%= p[0] %></span><span><b><%- p[1] %></b><% if (p[3] === 'soon') { %><span class="soon-tag"><%- t('premium.coming_soon') %></span><% } %><span class="d"><%- p[2] %></span></span></li><% }) %>
      </ul>
      <% if (V.signed) { %>
        <div class="stat"><%- t('premium.sp.yours') %> <%- statusTxt(PASS) %><% if (PASS && PASS.renewing && PASS.status !== 'comped') { %> · <%- t('premium.renews') %><% } %><% if (PASS && PASS.active) { %> · <a href="/cosmetics?tab=mine#tabs"><%- t('premium.sp.equip') %></a><% } %></div>
        <% if (!PASS || PASS.status !== 'comped') { %>
          <div class="row">
            <button type="button" class="btn violet" data-buy="season_pass" data-months="1"><%- t('premium.get_1', { price: fmt(S.prices.season_pass) }) %></button>
            <button type="button" class="btn ghost" data-buy="season_pass" data-months="3"><%- t('premium.periods_3', { price: fmt(S.prices.season_pass * 3) }) %></button>
          </div>
          <div class="row"><label class="mut"><input type="checkbox" id="spRenew"<%= PASS && PASS.renewer_me ? ' checked' : '' %>> <%- t('premium.renew_label', { days: S.period_days }) %></label></div>
          <% if (ST.enabled && ST.tiers && ST.tiers.season_pass) { %><div class="row card-pay"><button type="button" class="btn" data-card="season_pass">💳 <%- t('premium.pay_card') %><%- ST.test ? ' ' + t('premium.test_mode') : '' %></button><% if (PASS && PASS.stripe) { %><button type="button" class="btn ghost" data-portal="season_pass"><%- t('premium.manage_card') %></button><% } %></div><% } %>
        <% } %>
        <div class="row"><label class="mut" for="spGift"><%- t('premium.sp.gift_to') %></label><input type="text" id="spGift" placeholder="<%- t('premium.sp.gift_ph') %>" autocomplete="off" style="width:160px"><button type="button" class="btn" data-gift="season_pass"><%- t('premium.sp.gift_btn', { price: fmt(S.prices.season_pass) }) %></button></div>
      <% } else { %><p><%- t('premium.sp.signin', { link: '<a href="/login?next=/premium">' + t('premium.sign_in') + '</a>' }) %></p><% } %>
    </section>
  </div>
  <% if (V.signed) { %><p class="msg" id="pmMsg" role="status" aria-live="polite"></p><% } %>

  <section class="card" id="stickers" aria-labelledby="stkH">
    <h2 id="stkH"><%- t('premium.stk.heading') %></h2>
    <p class="mut" style="margin:0"><%- t('premium.stk.intro', { price: fmt(S.prices.sticker_pack) }) %><% if (STK.allowance && STK.allowance.per) { %> · <%- t('premium.stk.left', { count: STK.allowance.left }) %><% } else { %> · <%- t('premium.stk.sp_includes', { n: S.perks.sp_sticker_packs }) %><% } %>.</p>
    <div class="packs">
      <% STK.packs.forEach((p) => { %>
        <div class="card pack">
          <h3 style="margin:0;font-size:17px"><%= p.emoji %> <%= p.name %><% if (p.owned) { %> <span class="tag"><%- t('premium.stk.yours') %></span><% } %></h3>
          <p class="mut" style="margin:0"><%= p.desc %></p>
          <div class="sheet"><% p.stickers.forEach((s) => { %><img src="<%= s.url %>" alt="<%= s.name %>" title="<%= s.name %>" loading="lazy"><% }) %></div>
          <% if (STK.signed) { %><div class="row">
            <% if (!p.owned) { %>
              <% if (STK.allowance && STK.allowance.left) { %><button type="button" class="btn violet" data-stk="<%= p.id %>" data-free="1"><%- t('premium.stk.claim') %></button><% } %>
              <button type="button" class="btn" data-stk="<%= p.id %>"><%- t('premium.stk.buy', { price: fmt(p.price) }) %></button>
            <% } %>
            <button type="button" class="btn ghost" data-stk-gift="<%= p.id %>"><%- t('premium.stk.gift') %></button>
          </div><% } %>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="card" aria-labelledby="rtH">
    <h2 id="rtH"><%- t('premium.routes.heading') %></h2>
    <table>
      <tr><th><%- t('premium.routes.what') %></th><th><%- t('premium.routes.routing') %></th></tr>
      <% Object.keys(S.routes).forEach((k) => { const r = S.routes[k]; %><tr><td><%= r.label %></td><td><%= routeRow(r) %></td></tr><% }) %>
    </table>
    <p class="mut"><%- t('premium.routes.note', { link: '<a href="/economy">' + t('premium.routes.economy') + '</a>' }) %></p>
  </section>

  <section class="card" aria-labelledby="rlH">
    <h2 id="rlH"><%- t('premium.rules.heading') %></h2>
    <ul class="rules">
      <li><%- t('premium.rules.time', { days: S.period_days }) %></li>
      <li><%- t('premium.rules.renewing') %></li>
      <li><%- t('premium.rules.grace', { count: S.grace_days }) %></li>
      <li><%- t('premium.rules.gifts') %></li>
      <li><%- t('premium.rules.admins') %></li>
    </ul>
  </section>
</main>
<% if (V.signed) { %>
<script>
(function () {
  var _t = typeof __t === 'function' ? __t : function (k, d, v) { return String(d).replace(/\{!?(\w+)\}/g, function (m, n) { return v && v[n] != null ? v[n] : m; }); };
  var root = document.getElementById('pm'), msg = document.getElementById('pmMsg'), pad = root.getAttribute('data-pad');
  function ref() { var a = new Uint8Array(12); crypto.getRandomValues(a); return Array.prototype.map.call(a, function (b) { return ('0' + b.toString(16)).slice(-2); }).join(''); }
  function say(t, ok) { msg.textContent = t; msg.className = 'msg ' + (ok ? 'ok' : 'err'); msg.scrollIntoView({ block: 'nearest' }); }
  function post(url, body) {
    return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json().catch(function () { return { ok: false, error: _t('js.premium.went_wrong', 'Something went wrong.') }; }); });
  }
  function fmt(n) { return Math.round(Number(n) || 0).toLocaleString('en-US'); }
  function done(j, okText) { if (j.ok) { say(okText, true); setTimeout(function () { location.reload(); }, 1100); } else say((j.error || _t('js.premium.didnt_work', 'That didn’t work.')) + (j.hint ? ' ' + j.hint : ''), false); }
  root.addEventListener('click', function (e) {
    var b = e.target.closest('button');
    if (!b || !root.contains(b)) return;
    var tier = b.getAttribute('data-buy') || b.getAttribute('data-gift');
    if (b.hasAttribute('data-buy')) {
      var months = Number(b.getAttribute('data-months')) || 1;
      var renewEl = document.getElementById(tier === 'prime_time' ? 'ptRenew' : 'spRenew');
      if (!confirm(_t('js.premium.confirm_pay', months > 1 ? 'Pay {price} PAT for {count} periods? Payments are final.' : 'Pay {price} PAT for {count} period? Payments are final.', { price: b.textContent.split('·').pop().trim(), count: months }))) return;
      b.disabled = true;
      post('/api/premium/buy', { tier: tier, pad: pad || undefined, months: months, ref: ref(), renew: !!(renewEl && renewEl.checked) })
        .then(function (j) { b.disabled = false; done(j, _t('js.premium.paid_through', 'Done - paid through {date}.', { date: j.paid_through ? new Date(j.paid_through).toISOString().slice(0, 10) : '' })); });
    } else if (b.hasAttribute('data-chip')) {
      var amt = Math.floor(Number(document.getElementById('ptAmt').value));
      if (!confirm(_t('js.premium.confirm_chip', 'Chip in {amount} PAT to p/{pad}’s Prime Time? Payments are final.', { amount: fmt(amt), pad: pad }))) return;
      b.disabled = true;
      post('/api/premium/buy', { tier: 'prime_time', pad: pad, amount: amt, ref: ref() }).then(function (j) { b.disabled = false; done(j, _t('js.premium.chip_thanks', 'Thanks - p/{pad} is on air a little longer.', { pad: pad })); });
    } else if (b.hasAttribute('data-gift')) {
      var to = document.getElementById('spGift').value.trim();
      if (!to) return say(_t('js.premium.type_username', 'Type a username first.'), false);
      if (!confirm(_t('js.premium.confirm_gift', 'Gift a Season Pass period to {user}? Payments are final.', { user: to }))) return;
      b.disabled = true;
      post('/api/premium/buy', { tier: 'season_pass', user: to, months: 1, ref: ref() }).then(function (j) { b.disabled = false; done(j, _t('js.premium.gifted', 'Gifted to {user} 🎁', { user: to })); });
    } else if (b.hasAttribute('data-stk')) {
      var free = b.hasAttribute('data-free');
      if (!free && !confirm(_t('js.premium.confirm_stk', 'Buy this sticker pack for {price} PAT?', { price: b.textContent.split('·').pop().trim() }))) return;
      b.disabled = true;
      post('/api/stickers/buy', { pack: b.getAttribute('data-stk'), ref: ref(), allowance: free }).then(function (j) { b.disabled = false; done(j, _t('js.premium.stk_yours', 'It’s yours - find it under 🧸 in the composer.')); });
    } else if (b.hasAttribute('data-stk-gift')) {
      var who = prompt(_t('js.premium.stk_gift_prompt', 'Gift this sticker pack to (username):'));
      if (!who) return;
      b.disabled = true;
      post('/api/stickers/buy', { pack: b.getAttribute('data-stk-gift'), ref: ref(), to: who.trim() }).then(function (j) { b.disabled = false; done(j, _t('js.premium.gifted', 'Gifted to {user} 🎁', { user: who.trim() })); });
    } else if (b.hasAttribute('data-card') || b.hasAttribute('data-portal')) {
      var card = b.hasAttribute('data-card');
      b.disabled = true;
      post(card ? '/api/premium/stripe/checkout' : '/api/premium/stripe/portal', { tier: b.getAttribute(card ? 'data-card' : 'data-portal'), pad: pad || undefined })
        .then(function (j) { b.disabled = false; if (j.ok && j.url) location.href = j.url; else say(j.error || _t('js.premium.no_card', 'Card payments aren’t available.'), false); });
    }
  });
  root.addEventListener('change', function (e) {
    var t = e.target;
    if (t.id !== 'ptRenew' && t.id !== 'spRenew') return;
    var tier = t.id === 'ptRenew' ? 'prime_time' : 'season_pass';
    post('/api/premium/renew', { tier: tier, pad: pad || undefined, on: t.checked }).then(function (j) {
      if (j.ok) say(t.checked ? _t('js.premium.renew_on', '🔁 It renews from your balance now.') : _t('js.premium.renew_off', 'Renewal switched off.'), true);
      else { t.checked = !t.checked; say(j.error || _t('js.premium.didnt_work', 'That didn’t work.'), false); }
    });
  });
})();
</script>
