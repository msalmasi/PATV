<%- include('layout', { title: 'Pads', user: user }) %>
<% /* 1.99dt: ul() links names (userlinks.js, app.locals); rendered without the app it's the plain name */
   const UL = typeof ul === 'function' ? ul : (n, o) => escapeFn(o && o.text != null ? o.text : (n == null ? '' : n)) + (o && o.web ? ' 🌐' : '');
   /* 1.99ed: inside a pad card (one <a>) names are plain text - no nested links */
   const TXT = (n, d) => escapeFn(d != null && d !== '' ? d : (n == null ? '' : n));
   /* 1.99ek: the shared 🚀 boost badge (boostmark.js) - "" when a pad isn't boosted */
   const BM = typeof boostMark === 'function' ? boostMark : () => ''; %>
<!-- views/rooms.ejs — the Pads (1.99bi as the channel guide; /p since 1.99ck): every pad, what's on its stage now and
     what's booked next, plus the schedule across rooms. Data: roomsweb.guideRows().
     1.99ed: a pad card is ONE link (a.ch) with no buttons and no links inside; fixed rows (head / meta /
     description / NOW-NEXT footer) aligned across a grid row with subgrid; Pepe's presence is a 🐸 icon; the
     per-pad analytics list is gone (each pad's About tab links its analytics). A schedule row is still a
     stretched link on a.rl. -->
<%
  const sched = [];
  rows.forEach((r) => r.next.forEach((n) => sched.push({ ...n, room: r })));
  sched.sort((a, b) => a.start_at - b.start_at);
  const pepeOn = !!(pepe && pepe.active);
%>
<style>
  .cg { --card: #111; --line: #222; --px: 16px; --py: 14px; --cardgap: 14px;
        max-width: 1180px; margin: 0 auto; padding: 18px 16px 56px; font-family: Ubuntu, sans-serif; color: #e6e6e6; display: grid; gap: var(--cardgap); box-sizing: border-box; width: 100%; }
  .cg *, .cg *::before, .cg *::after { box-sizing: border-box; }
  .cg a { color: #81c784; text-decoration: none; }
  .cg a:hover { color: #a5d6a7; }
  .cg h1 { margin: 0; font-size: 26px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .cg .lead { color: #aab3aa; font-size: 14.5px; line-height: 1.55; margin: 4px 0 0; }
  .cg .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: var(--py) var(--px); min-width: 0; }
  .cg h2 { margin: 0 0 10px; letter-spacing: .1em; text-transform: uppercase; color: #ffd700; font-family: 'Press Start 2P', monospace; font-size: 10px; line-height: 1.6;
           display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: baseline; }
  .cg h2 small { font-family: Ubuntu, sans-serif; letter-spacing: 0; text-transform: none; color: #888; font-size: 12.5px; }
  .cg .muted { color: #8a8a8a; font-size: 13px; }
  .cg .cta { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px 18px; align-items: center; padding: var(--py) var(--px); border-radius: 14px;
             background: radial-gradient(120% 160% at 0% 0%, #3a1414 0%, #1a0f0f 45%, #111 80%); border: 1px solid #5a2a22; }
  .cg .cta b.big { font-size: 18px; color: #fff; display: block; margin-bottom: 4px; }
  .cg .cta ol { margin: 6px 0 0; padding-left: 20px; color: #d9c9c3; font-size: 13.5px; line-height: 1.6; }
  .cg .cta .btns { display: flex; flex-direction: column; gap: 8px; }
  .cg .golive-btn { display: inline-flex; justify-content: center; align-items: center; gap: 7px; padding: 10px 16px; border-radius: 999px; font-weight: bold; font-size: 14.5px; white-space: nowrap;
                    background: linear-gradient(90deg, #e53935, #ff7043); color: #fff !important; border: 0; }
  .cg .pepe { display: flex; align-items: center; gap: 10px 14px; flex-wrap: wrap; background: #0f1a10; border: 1px solid #234d2a; border-radius: 14px; padding: 10px var(--px); font-size: 14px; }
  .cg .pepe b { color: #fff; }
  .cg .pill { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; padding: 2px 9px; border-radius: 999px; font-weight: bold; letter-spacing: .06em; white-space: nowrap; }
  .cg .pill.on { background: #3a1010; border: 1px solid #7a2222; color: #ffb4b4; }
  .cg .pill.off { background: #1c1c1c; border: 1px solid #333; color: #999; }
  .cg .dot { width: 7px; height: 7px; border-radius: 50%; background: #ff5252; animation: cgPulse 1.6s ease-in-out infinite; }
  .cg .pill.off .dot { background: #666; animation: none; }
  /* 1.99eo: a pad's Camfrog room pill is about chat (💬 ROOM ACTIVE); LIVE / ON AIR / ON STAGE = video */
  .cg .pill.chat { background: #10240f; border: 1px solid #2f6d3a; color: #c9f2cf; }
  .cg .pill.chat .dot { display: none; }
  @keyframes cgPulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

  /* ── pad cards: 3 / 2 / 1 columns; each card is one link with four fixed rows ── */
  .cg .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .cg a.ch { display: grid; grid-template-rows: auto auto auto 1fr; grid-template-areas: "head" "meta" "desc" "foot"; row-gap: 8px;
             background: #0d0d0d; border: 1px solid #242424; border-radius: 12px; padding: 12px 14px; min-width: 0; color: #e6e6e6 !important;
             transition: border-color .15s, background .15s, transform .15s; }
  /* equal heights + NOW/NEXT aligned across a grid row: each card spans 4 rows of the grid and adopts them */
  @supports (grid-template-rows: subgrid) {
    .cg .grid { row-gap: 0; }
    .cg a.ch { grid-row: span 4; grid-template-rows: subgrid; margin-bottom: 12px; }
    .cg a.ch .ch-foot { align-self: start; } /* the foot track is shared, so NOW / NEXT line up across the row */
  }
  .cg a.ch.live { border-color: #2f4a2f; }
  .cg a.ch.onair { border-color: #7a2222; box-shadow: 0 0 0 1px #3a1010 inset; }
  .cg a.ch:hover, .cg a.ch:focus-visible { border-color: #4caf50; background: #131a13; }
  .cg a.ch.onair:hover, .cg a.ch.onair:focus-visible { border-color: #c64a4a; }
  .cg a.ch:focus-visible { outline: 2px solid #c6e94f; outline-offset: 2px; }
  .cg a.ch:hover .t, .cg a.ch:focus-visible .t { text-decoration: underline; text-underline-offset: 3px; }
  .cg .ch-head { grid-area: head; display: grid; gap: 6px; min-width: 0; align-content: start; }
  .cg .ch-head .t { font-size: 17px; font-weight: bold; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* badges: platform + status, then a free slot for boost / trending marks (.ch-mark) */
  .cg .ch-badges { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; min-width: 0; }
  /* 1.99ek: the 🚀 boost mark (boostmark.js) - active boost PAT, tooltip says how it fades */
  .cg .pill.ch-mark { background: #20140a; border: 1px solid #7a4a1f; color: #ffd9a8; letter-spacing: 0; cursor: help; }
  .cg .ch-meta { grid-area: meta; font-size: 12.5px; color: #9aa59a; display: flex; gap: 4px 10px; flex-wrap: wrap; align-items: center; min-width: 0; }
  .cg .ch-meta .padref { color: #9ccc9f; font-weight: bold; }
  .cg .ch-meta .own { color: #e8d9a0; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cg .ch-meta [title] { cursor: help; }
  .cg .ch-meta .pepe-here { font-size: 14px; line-height: 1; }
  .cg .ch-desc { grid-area: desc; color: #8a8a8a; font-size: 13px; line-height: 1.45; min-height: calc(2 * 1.45em); overflow-wrap: anywhere;
                 display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
  .cg .ch-foot { grid-area: foot; align-self: end; display: grid; gap: 4px; border-top: 1px solid #1e1e1e; padding-top: 8px; min-width: 0; }
  .cg .slotrow { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 8px; align-items: start; font-size: 13px; }
  .cg .slotrow .k { font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: #8a8a8a; padding-top: 3px; }
  .cg .slotrow .k.now { color: #ffb4b4; }
  .cg .slotrow ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; min-width: 0; }
  .cg .slotrow li { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cg .slotrow li .star { color: #ffd700; }
  .cg .slotrow li .src { font-size: 11px; color: #9fb3c8; }
  .cg .slotrow li time { color: #c6e94f; font-variant-numeric: tabular-nums; margin-right: 4px; }

  .cg .btn { display: inline-flex; align-items: center; gap: 6px; padding: 6px 11px; border-radius: 8px; border: 1px solid #2b2b2b; background: #181818; color: #ddd !important; font-size: 13px; font-weight: bold; max-width: 100%; }
  .cg .btn:hover, .cg .btn:focus-visible { border-color: #4caf50; }
  .cg .sched { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  /* 1.99ek: the time column sizes to its content (max-content) and never wraps - "Sun, Oct 11 01:15 PM" stays on one line */
  .cg .sched li { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 12px; align-items: baseline; background: #0d0d0d; border: 1px solid #1f1f1f; border-radius: 10px; padding: 8px 12px; font-size: 13.5px; }
  .cg .sched time { color: #c6e94f; font-variant-numeric: tabular-nums; font-size: 13px; white-space: nowrap; }
  .cg .sched .w { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cg .owned { display: flex; gap: 8px; flex-wrap: wrap; }
  .cg .empty { border: 1px dashed #333; border-radius: 12px; padding: 24px; text-align: center; color: #999; }
  /* a schedule row opens its pad - a stretched link (a.rl::after covers the row); other links sit above it */
  .cg .sched li { position: relative; cursor: pointer; transition: border-color .15s, background .15s; }
  .cg .sched a.rl::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .cg .sched a:not(.rl), .cg .sched button { position: relative; z-index: 2; }
  .cg .sched li:has(a.rl:focus-visible) { outline: 2px solid #c6e94f; outline-offset: 2px; }
  .cg .sched a.rl:focus-visible { outline: none; }
  .cg .sched li:hover, .cg .sched li:focus-within { border-color: #4caf50; background: #131a13; }
  @media (prefers-reduced-motion: no-preference) { .cg a.ch:hover { transform: translateY(-1px); } }
  @media (max-width: 1000px) { .cg .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .cg { padding: 12px 12px 44px; --cardgap: 12px; --px: 12px; --py: 12px; }
    .cg .cta { grid-template-columns: minmax(0, 1fr); }
    .cg .cta .btns { flex-direction: row; flex-wrap: wrap; }
    .cg .grid { grid-template-columns: minmax(0, 1fr); }
    .cg .sched li { grid-template-columns: minmax(0, 1fr); gap: 2px; }
  }
  @media (prefers-reduced-motion: reduce) { .cg .dot { animation: none; } }
  /* 1.99ee: Trending */
  .cg .tr-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  .cg .tr-list li { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; padding: 10px 12px; border-radius: 12px; background: #111; border: 1px solid #222; min-width: 0; }
  .cg .tr-list li.front { border-color: #2f6b3a; background: #0f1a11; }
  .cg .tr-list .t { font-weight: bold; color: #fff; min-width: 0; overflow-wrap: anywhere; flex: 1 1 8em; }
  .cg .tr-list .tags { display: flex; flex-wrap: wrap; gap: 4px; }
  .cg .tr-list .tg { font-size: 11.5px; padding: 1px 8px; border-radius: 999px; border: 1px solid #333; color: #bbb; background: #151515; white-space: nowrap; }
  .cg .tr-list .tg.on { border-color: #2f6b3a; color: #bdf0c6; background: #12301a; }
  .cg .tr-list .tg.boost { border-color: #7a4a1f; color: #ffd9a8; background: #20140a; font-weight: bold; cursor: help; }
  .cg .tr-list .bst { font-size: 12.5px; font-weight: bold; color: #ffd9a8; border: 1px solid #7a4a1f; border-radius: 999px; padding: 3px 10px; white-space: nowrap; }
  .cg .tr-list .bst:hover { border-color: #ff9a3c; color: #fff; }
</style>
<main class="cg">
  <div>
    <h1>📡 Pads</h1>
    <p class="lead">Every PATV pad (p/<i>name</i>) has a feed, a stage anyone can stream to, and Pepe's stream — and most are backed by a Camfrog room whose chat is live on the web.<% if (!signedIn) { %> <a href="/login">Sign in</a> to watch the Camfrog rooms' chat.<% } %></p>
  </div>

  <section class="cta" aria-label="Go live">
    <div>
      <b class="big">🎥 Your show, on PATV</b>
      <span class="muted" style="font-size:14px;color:#d9c9c3">Every pad has stage slots you can stream to (free on most pads). The front page shows the liveliest pad — earned, never bought.</span>
      <ol>
        <li>Pick a pad and a slot: <b>now</b>, <b>later</b>, or join the <b>queue</b>.</li>
        <li>Stream from <b>OBS</b>, straight from your <b>browser</b>, or drop a <b>YouTube / Twitch</b> link.</li>
        <li>Want your pad on the front page? Get people chatting and on the mic. Fans can <b>🚀 boost</b> a pad from its page to tip a close race.</li>
      </ol>
    </div>
    <div class="btns"><a class="golive-btn" href="/stage">🎥 Go live</a></div>
  </section>

  <div class="pepe" role="status">
    <span class="pill <%= pepeOn ? 'on' : 'off' %>"><span class="dot" aria-hidden="true"></span><%= pepeOn ? 'ON AIR' : 'OFF AIR' %></span>
    <span><b>🐸 Pepe's stream</b> plays on the stage of every pad whose Camfrog room he's in<%= rows.some((r) => r.pepe_here) ? ' (🐸 on its card)' : '' %>.</span>
    <a href="/" style="margin-left:auto">Front page ›</a>
  </div>

  <% if (owned && owned.length) { %>
    <section class="card" aria-labelledby="ownH">
      <h2 id="ownH">Your pads <small>you own these</small></h2>
      <div class="owned"><% owned.forEach((r) => { %><a class="btn" href="/p/<%= encodeURIComponent(r.slug) %>/settings">⚙ <%= r.title %></a><% }) %></div>
    </section>
  <% } %>

  <%# 1.99ee: Trending - the front page's automatic pick and the runners-up from its last check (roomsweb.guideRows r.trend) %>
  <% const trend_ = rows.filter((r) => r.trend).sort((a, b) => a.trend.rank - b.trend.rank); %>
  <section class="card trend" id="trending" aria-labelledby="trH">
    <h2 id="trH">🔥 Trending <small>the front page shows the liveliest pad · chat, mic and people decide, 🚀 boosts can tip a close race</small></h2>
    <% if (!trend_.length) { %>
      <div class="empty">No live Camfrog pads right now.</div>
    <% } else { %>
      <ol class="tr-list">
        <% trend_.forEach((r) => { %><li class="<%= r.trend.front ? 'front' : '' %>">
          <a class="t" href="/p/<%= encodeURIComponent(r.slug) %>"><%= r.title %></a>
          <span class="tags"><% if (r.trend.front) { %><span class="tg on">📺 On the front page</span><% } else { %><span class="tg">Trending #<%= r.trend.rank - (trend_[0].trend.front ? 1 : 0) %></span><% } %><%- BM(r.boost_pat, 'tg boost') %><span class="tg">👥 <%= r.count %></span></span>
          <a class="bst" href="/p/<%= encodeURIComponent(r.slug) %>#boost" aria-label="Boost <%= r.title %>">🚀 Boost</a>
        </li><% }) %>
      </ol>
    <% } %>
  </section>

  <section class="card" aria-labelledby="chH">
    <h2 id="chH">Pads <small><%= rows.filter((r) => r.live).length %> live · <%= rows.length %> pad<%= rows.length === 1 ? '' : 's' %><% if (staff) { %> · <a href="/pads/admin">Pads admin ›</a><% } %></small></h2>
    <%# 1.99x: filter by platform - All / Camfrog / Site (Twitch / Discord appear once a pad has them) %>
    <% const plat_ = typeof platform !== 'undefined' ? platform : '', counts_ = typeof counts !== 'undefined' ? counts : {}, PL_ = typeof PAD_PLATFORMS !== 'undefined' ? PAD_PLATFORMS : { camfrog: { icon: '🐸', label: 'Camfrog Pad' }, site: { icon: '🌐', label: 'Site Pad' } };
       const padBadge_ = typeof padBadge === 'function' ? padBadge : (p) => '<span class="pad-plat pp-' + p + '">' + (PL_[p] ? PL_[p].icon + ' ' + PL_[p].label : p) + '</span>'; %>
    <nav class="pad-filter" aria-label="Filter pads by platform">
      <a href="/p"<%- plat_ ? '' : ' class="on" aria-current="page"' %>>All <small><%= typeof allCount !== 'undefined' ? allCount : rows.length %></small></a>
      <% Object.keys(PL_).filter((k) => k === 'camfrog' || k === 'site' || counts_[k] || plat_ === k).forEach((k) => { %>
        <a href="/p?platform=<%= k %>"<%- plat_ === k ? ' class="on" aria-current="page"' : '' %>><%= PL_[k].icon %> <%= PL_[k].label.replace(/ Pad$/, '') %> <small><%= counts_[k] || 0 %></small></a>
      <% }) %>
    </nav>
    <% if (!rows.length) { %>
      <div class="empty"><%= plat_ ? 'No pads on that platform yet.' : 'No pads yet.' %></div>
    <% } else { %>
    <div class="grid">
      <% rows.forEach((r) => { const liveNow = r.now.filter((s) => s.live); const desc = r.description || r.topic || '';
           const pepeTip = "Pepe is in this room — his stream plays here"; %>
        <a class="ch<%= r.live ? ' live' : '' %><%= liveNow.length ? ' onair' : '' %>" href="/p/<%= encodeURIComponent(r.slug) %>">
          <div class="ch-head">
            <span class="t"><%= r.title %></span>
            <span class="ch-badges">
              <%- padBadge_(r.platform || (r.site_only ? 'site' : 'camfrog')) %>
              <% if (!r.site_only) { %><span class="pill <%= r.live ? 'chat' : 'off' %>" title="The pad's Camfrog room (ON STAGE = a video stream)"><span class="dot" aria-hidden="true"></span><%= r.live ? '💬 ROOM ACTIVE' : (r.bridged ? 'QUIET' : 'OFF THE WEB') %></span><% } %>
              <% if (liveNow.length) { %><span class="pill on" title="Someone is streaming on this pad's stage">📺 <%= liveNow.length %> ON STAGE</span><% } %>
              <%# 1.99ek: the boost mark (reserved slot since 1.99ed) - only when the pad is boosted %>
              <%- BM(r.boost_pat, 'pill ch-mark') %>
            </span>
          </div>
          <div class="ch-meta">
            <span class="padref">p/<%= r.slug %></span>
            <% if (r.bridged && r.live && r.count > 0) { %><span title="<%= r.count %> in the Camfrog room" aria-label="<%= r.count %> in the Camfrog room">👥 <%= r.count %></span><% } %>
            <% if (r.bridged && r.live && r.micCount > 0) { %><span title="<%= r.micCount %> on mic" aria-label="<%= r.micCount %> on mic">🎙 <%= r.micCount %></span><% } %>
            <% if (r.house) { %><span class="own" title="House pad — run by Pepe">🏠 House pad</span><% } else if (r.owner) { %><span class="own" title="Pad owner">👑 <%= r.owner %></span><% } %>
            <span title="Stage slots in use / total">🎬 <%= r.now.length %>/<%= r.slot_count %> slots</span>
            <% if (r.pepe_here) { %><span class="pepe-here" role="img" title="<%= pepeTip %>" aria-label="<%= pepeTip %>">🐸</span><% } %>
          </div>
          <div class="ch-desc"><%= desc.slice(0, 200) %></div>
          <div class="ch-foot">
            <div class="slotrow"><span class="k now">Now</span>
              <ul>
                <% if (!r.now.length) { %><li class="muted"><%= r.pepe_here ? "🐸 Pepe's stream" + (pepeOn ? '' : ' (off air)') + ' — slot open' : 'Slot open' %></li><% } %>
                <% r.now.forEach((s) => { %><li><%- s.featured ? '<span class="star" title="featured">★</span> ' : '' %><b><%- TXT(s.username, s.display) %></b><%= s.title ? ' — ' + s.title : '' %> <span class="src"><%= s.mode === 'embed' ? (s.embed_label || 'video') : (s.live ? '● live' : 'starting…') %></span></li><% }) %>
              </ul>
            </div>
            <div class="slotrow"><span class="k">Next</span>
              <ul>
                <% if (!r.next.length) { %><li class="muted">Nothing booked</li><% } %>
                <% r.next.slice(0, 2).forEach((n) => { %><li><time data-ts="<%= n.start_at %>"><%= new Date(n.start_at).toISOString().slice(11, 16) %></time><b><%- TXT(n.username, n.display) %></b><%= n.featured ? ' ★' : '' %><%= n.title ? ' — ' + n.title : '' %></li><% }) %>
                <% if (r.next.length > 2) { %><li class="muted">+<%= r.next.length - 2 %> more booked</li><% } %>
              </ul>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
    <% } %>
  </section>

  <section class="card" aria-labelledby="scH">
    <h2 id="scH">Schedule <small>booked slots, all pads · your local time</small></h2>
    <% if (!sched.length) { %>
      <div class="empty">Nothing booked yet. <a href="/stage">Book the first slot ›</a></div>
    <% } else { %>
      <ul class="sched">
        <% sched.slice(0, 30).forEach((n) => { %>
          <li><time data-ts="<%= n.start_at %>" data-long="1"><%= new Date(n.start_at).toISOString().slice(0, 16).replace('T', ' ') %> UTC</time>
            <span class="w"><b><%- UL(n.username, { text: n.display, user: true }) %></b><%= n.featured ? ' ★' : '' %> in <a class="rl" href="/p/<%= encodeURIComponent(n.room.slug) %>"><%= n.room.title %></a> · <%= n.minutes %> min<%= n.title ? ' · ' + n.title : '' %></span></li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</main>
<script>
  document.querySelectorAll('time[data-ts]').forEach(function (t) {
    var d = new Date(Number(t.getAttribute('data-ts')));
    var hm = d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
    var today = new Date().toDateString() === d.toDateString();
    t.textContent = (t.hasAttribute('data-long') || !today ? d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' }) + ' ' : '') + hm;
  });
</script>
</body>
</html>
