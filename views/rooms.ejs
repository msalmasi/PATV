<%- include('layout', { title: 'Pad Guide', user: user }) %>
<!-- views/rooms.ejs — the Pad Guide (1.99bi as the channel guide; /p since 1.99ck): every pad, what's on its stage now and
     what's booked next, plus the schedule across rooms. Data: roomsweb.guideRows().
     1.99bx: a whole card (and a whole schedule row) opens its room - a stretched link on a.t / a.rl. -->
<%
  const sched = [];
  rows.forEach((r) => r.next.forEach((n) => sched.push({ ...n, room: r })));
  sched.sort((a, b) => a.start_at - b.start_at);
  const pepeOn = !!(pepe && pepe.active);
%>
<style>
  .cg { max-width: 1180px; margin: 0 auto; padding: 18px 16px 56px; font-family: Ubuntu, sans-serif; color: #e6e6e6; display: grid; gap: 16px; box-sizing: border-box; width: 100%; }
  .cg *, .cg *::before, .cg *::after { box-sizing: border-box; }
  .cg a { color: #81c784; text-decoration: none; }
  .cg a:hover { color: #a5d6a7; }
  .cg h1 { margin: 0; font-size: 26px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .cg .lead { color: #aab3aa; font-size: 14.5px; line-height: 1.55; margin: 4px 0 0; }
  .cg h2 { margin: 0 0 10px; letter-spacing: .1em; text-transform: uppercase; color: #ffd700; font-family: 'Press Start 2P', monospace; font-size: 10px; line-height: 1.6;
           display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: baseline; }
  .cg h2 small { font-family: Ubuntu, sans-serif; letter-spacing: 0; text-transform: none; color: #888; font-size: 12.5px; }
  .cg .muted { color: #8a8a8a; font-size: 13px; }
  .cg .cta { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px 18px; align-items: center; padding: 16px 18px; border-radius: 16px;
             background: radial-gradient(120% 160% at 0% 0%, #3a1414 0%, #1a0f0f 45%, #111 80%); border: 1px solid #5a2a22; }
  .cg .cta b.big { font-size: 18px; color: #fff; display: block; margin-bottom: 4px; }
  .cg .cta ol { margin: 6px 0 0; padding-left: 20px; color: #d9c9c3; font-size: 13.5px; line-height: 1.6; }
  .cg .cta .btns { display: flex; flex-direction: column; gap: 8px; }
  .cg .golive-btn { display: inline-flex; justify-content: center; align-items: center; gap: 7px; padding: 10px 16px; border-radius: 999px; font-weight: bold; font-size: 14.5px; white-space: nowrap;
                    background: linear-gradient(90deg, #e53935, #ff7043); color: #fff !important; border: 0; }
  .cg .golive-btn.ghost { background: #1d1a0f; border: 1px solid #6b5a20; color: #f3e3a3 !important; }
  .cg .pepe { display: flex; align-items: center; gap: 10px 14px; flex-wrap: wrap; background: #0f1a10; border: 1px solid #234d2a; border-radius: 14px; padding: 10px 14px; font-size: 14px; }
  .cg .pepe b { color: #fff; }
  .cg .pill { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; padding: 2px 9px; border-radius: 999px; font-weight: bold; letter-spacing: .06em; white-space: nowrap; }
  .cg .pill.on { background: #3a1010; border: 1px solid #7a2222; color: #ffb4b4; }
  .cg .pill.off { background: #1c1c1c; border: 1px solid #333; color: #999; }
  .cg .dot { width: 7px; height: 7px; border-radius: 50%; background: #ff5252; animation: cgPulse 1.6s ease-in-out infinite; }
  .cg .pill.off .dot { background: #666; animation: none; }
  @keyframes cgPulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
  .cg .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 12px; }
  .cg .ch { background: #111; border: 1px solid #222; border-radius: 14px; padding: 12px 14px; display: grid; gap: 8px; min-width: 0; align-content: start; }
  .cg .ch.live { border-color: #2f4a2f; }
  .cg .ch.onair { border-color: #7a2222; box-shadow: 0 0 0 1px #3a1010 inset; }
  .cg .ch .top { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .cg .ch .top a.t { font-size: 17px; font-weight: bold; color: #fff !important; overflow-wrap: anywhere; }
  .cg .ch .sub { font-size: 12.5px; color: #9aa59a; display: flex; gap: 4px 10px; flex-wrap: wrap; }
  .cg .ch .padref { color: #9ccc9f; font-weight: bold; }
  .cg .ch .sub .own { color: #e8d9a0; }
  .cg .slotrow { display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: 8px; align-items: start; font-size: 13.5px; }
  .cg .slotrow .k { font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: #8a8a8a; padding-top: 3px; }
  .cg .slotrow .k.now { color: #ffb4b4; }
  .cg .slotrow ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; min-width: 0; }
  .cg .slotrow li { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cg .slotrow li .star { color: #ffd700; }
  .cg .slotrow li .src { font-size: 11px; color: #9fb3c8; }
  .cg .slotrow li time { color: #c6e94f; font-variant-numeric: tabular-nums; margin-right: 4px; }
  .cg .ch .acts { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 2px; }
  .cg .btn { display: inline-flex; align-items: center; gap: 6px; padding: 6px 11px; border-radius: 8px; border: 1px solid #2b2b2b; background: #181818; color: #ddd !important; font-size: 13px; font-weight: bold; }
  .cg .btn:hover { border-color: #4caf50; }
  .cg .btn.red { border-color: #5a2a22; background: #241210; color: #ffc9b9 !important; }
  .cg .sched { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .cg .sched li { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 10px; align-items: baseline; background: #111; border: 1px solid #1f1f1f; border-radius: 10px; padding: 8px 12px; font-size: 13.5px; }
  .cg .sched time { color: #c6e94f; font-variant-numeric: tabular-nums; font-size: 13px; }
  .cg .sched .w { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cg .owned { display: flex; gap: 8px; flex-wrap: wrap; }
  .cg .empty { background: #111; border: 1px dashed #333; border-radius: 14px; padding: 24px; text-align: center; color: #999; }
  /* 1.99bx: the whole card / schedule row opens the room - a stretched link (the title / room link's
     ::after covers the card); every other link or button inside sits above it and works on its own */
  .cg .ch, .cg .sched li { position: relative; cursor: pointer; transition: border-color .15s, background .15s, transform .15s; }
  .cg .ch a.t::after, .cg .sched a.rl::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .cg .ch a:not(.t), .cg .ch button, .cg .ch input, .cg .ch select, .cg .sched a:not(.rl), .cg .sched button { position: relative; z-index: 2; }
  .cg .ch:hover, .cg .ch:focus-within { border-color: #4caf50; background: #131a13; }
  .cg .ch.onair:hover, .cg .ch.onair:focus-within { border-color: #c64a4a; }
  .cg .ch:hover a.t { text-decoration: underline; text-underline-offset: 3px; }
  .cg .ch:has(a.t:focus-visible), .cg .sched li:has(a.rl:focus-visible) { outline: 2px solid #c6e94f; outline-offset: 2px; }
  .cg .ch a.t:focus-visible, .cg .sched a.rl:focus-visible { outline: none; }
  .cg .sched li:hover, .cg .sched li:focus-within { border-color: #4caf50; background: #131a13; }
  @media (prefers-reduced-motion: no-preference) { .cg .ch:hover { transform: translateY(-1px); } }
  @media (max-width: 640px) {
    .cg { padding: 12px 12px 44px; }
    .cg .cta { grid-template-columns: minmax(0, 1fr); }
    .cg .cta .btns { flex-direction: row; flex-wrap: wrap; }
    .cg .grid { grid-template-columns: minmax(0, 1fr); }
    .cg .sched li { grid-template-columns: minmax(0, 1fr); gap: 2px; }
  }
  @media (prefers-reduced-motion: reduce) { .cg .dot { animation: none; } }
</style>
<main class="cg">
  <div>
    <h1>📡 Pad Guide</h1>
    <p class="lead">Every PATV pad (p/<i>name</i>) has a feed, a stage anyone can stream to, and Pepe's stream — and most are backed by a Camfrog room whose chat is live on the web.<% if (!signedIn) { %> <a href="/login">Sign in</a> to watch the Camfrog rooms' chat.<% } %></p>
  </div>

  <section class="cta" aria-label="Go live">
    <div>
      <b class="big">🎥 Your show, on PATV</b>
      <span class="muted" style="font-size:14px;color:#d9c9c3">Every pad has stage slots you can stream to — and one featured stream that leads the pad (and the front page).</span>
      <ol>
        <li>Pick a pad and a slot: <b>now</b>, <b>later</b>, or join the <b>queue</b>.</li>
        <li>Stream from <b>OBS</b>, straight from your <b>browser</b>, or drop a <b>YouTube / Twitch</b> link.</li>
        <li>Want the spotlight? <b>Get featured</b> — pay per live minute, unused PAT comes back.</li>
      </ol>
    </div>
    <div class="btns"><a class="golive-btn" href="/stage">🎥 Go live</a><a class="golive-btn ghost" href="/stage?feature=1">★ Get featured</a></div>
  </section>

  <div class="pepe" role="status">
    <span class="pill <%= pepeOn ? 'on' : 'off' %>"><span class="dot" aria-hidden="true"></span><%= pepeOn ? 'ON AIR' : 'OFF AIR' %></span>
    <span><b>🐸 Pepe's stream</b> plays on the stage of every pad whose Camfrog room he's in<%= rows.some((r) => r.pepe_here) ? ' (🐸 below)' : '' %>.</span>
    <a href="/" style="margin-left:auto">Front page ›</a>
  </div>

  <% if (owned && owned.length) { %>
    <section aria-labelledby="ownH">
      <h2 id="ownH">Your pads <small>you own these</small></h2>
      <div class="owned"><% owned.forEach((r) => { %><a class="btn" href="/p/<%= encodeURIComponent(r.slug) %>/manage">⚙️ <%= r.title %></a><% }) %></div>
    </section>
  <% } %>

  <section aria-labelledby="chH">
    <h2 id="chH">Pads <small><%= rows.filter((r) => r.live).length %> live · <%= rows.length %> pad<%= rows.length === 1 ? '' : 's' %><% if (staff) { %> · <a href="/pads/admin">Pads admin ›</a><% } %></small></h2>
    <% if (!rows.length) { %>
      <div class="empty">No pads yet.</div>
    <% } else { %>
    <div class="grid">
      <% rows.forEach((r) => { const liveNow = r.now.filter((s) => s.live); %>
        <article class="ch<%= r.live ? ' live' : '' %><%= liveNow.length ? ' onair' : '' %>" aria-label="<%= r.title %>">
          <div class="top">
            <a class="t" href="/p/<%= encodeURIComponent(r.slug) %>"><%= r.title %></a>
            <% if (r.site_only) { %><span class="pill off" title="A pad on the website only - no Camfrog room behind it">🛋️ SITE PAD</span><% } else { %><span class="pill <%= r.live ? 'on' : 'off' %>" title="The pad's Camfrog room"><span class="dot" aria-hidden="true"></span><%= r.live ? 'LIVE' : (r.bridged ? 'QUIET' : 'OFF THE WEB') %></span><% } %>
            <% if (liveNow.length) { %><span class="pill on" title="Someone is streaming on this pad's stage">📺 <%= liveNow.length %> ON STAGE</span><% } %>
          </div>
          <div class="sub">
            <span class="padref">p/<%= r.slug %></span>
            <% if (r.bridged) { %><span title="In the Camfrog room">👥 <%= r.count %></span><span>🎙 <%= r.micCount %></span><% } %>
            <% if (r.house) { %><span class="own" title="Run by Pepe">🐸 House pad</span><% } else if (r.owner) { %><span class="own">👑 <%= r.owner %></span><% } %>
            <span>🎬 <%= r.now.length %>/<%= r.slot_count %> slots</span>
            <% if (r.pepe_here) { %><span title="Pepe is in this pad's Camfrog room - his stream is on its stage">🐸 Pepe's here</span><% } %>
          </div>
          <% if (r.topic || r.description) { %><div class="muted" style="overflow-wrap:anywhere"><%= (r.description || r.topic).slice(0, 140) %></div><% } %>
          <div class="slotrow"><span class="k now">Now</span>
            <ul>
              <% if (!r.now.length) { %><li class="muted"><%= r.pepe_here ? "🐸 Pepe's stream" + (pepeOn ? '' : ' (off air)') + ' — slot open' : 'Slot open' %></li><% } %>
              <% r.now.forEach((s) => { %><li><%- s.featured ? '<span class="star" title="featured">★</span> ' : '' %><b><%= s.display %></b><%= s.title ? ' — ' + s.title : '' %> <span class="src"><%= s.mode === 'embed' ? (s.embed_label || 'video') : (s.live ? '● live' : 'starting…') %></span></li><% }) %>
            </ul>
          </div>
          <div class="slotrow"><span class="k">Next</span>
            <ul>
              <% if (!r.next.length) { %><li class="muted">Nothing booked — <a href="/stage?room=<%= encodeURIComponent(r.slug) %>">book a slot</a></li><% } %>
              <% r.next.forEach((n) => { %><li><time data-ts="<%= n.start_at %>"><%= new Date(n.start_at).toISOString().slice(11, 16) %></time><b><%= n.display %></b><%= n.featured ? ' ★' : '' %><%= n.title ? ' — ' + n.title : '' %></li><% }) %>
            </ul>
          </div>
          <div class="acts">
            <a class="btn" href="/p/<%= encodeURIComponent(r.slug) %>">▶ Open pad</a>
            <a class="btn red" href="/stage?room=<%= encodeURIComponent(r.slug) %>">🎥 Go live here</a>
          </div>
        </article>
      <% }) %>
    </div>
    <% } %>
  </section>

  <section aria-labelledby="scH">
    <h2 id="scH">Schedule <small>booked slots, all pads · your local time</small></h2>
    <% if (!sched.length) { %>
      <div class="empty">Nothing booked yet. <a href="/stage">Book the first slot ›</a></div>
    <% } else { %>
      <ul class="sched">
        <% sched.slice(0, 30).forEach((n) => { %>
          <li><time data-ts="<%= n.start_at %>" data-long="1"><%= new Date(n.start_at).toISOString().slice(0, 16).replace('T', ' ') %> UTC</time>
            <span class="w"><b><%= n.display %></b><%= n.featured ? ' ★' : '' %> in <a class="rl" href="/p/<%= encodeURIComponent(n.room.slug) %>"><%= n.room.title %></a> · <%= n.minutes %> min<%= n.title ? ' · ' + n.title : '' %></span></li>
        <% }) %>
      </ul>
    <% } %>
  </section>
  <%- include('partials/room-analytics-list') %>
</main>
<script>
  document.querySelectorAll('time[data-ts]').forEach(function (t) {
    var d = new Date(Number(t.getAttribute('data-ts')));
    var hm = d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
    var today = new Date().toDateString() === d.toDateString();
    t.textContent = (t.hasAttribute('data-long') || !today ? d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' }) + ' ' : '') + hm;
  });
</script>
</body>
</html>
