<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: 'Edit item', user: user }) %>
<%- include('partials/shop-css') %>
<style>
  /* G6 polish: the staff shop pages on .ds-page (flow) with a .ds-head; shop-css gives the fields, buttons and cards */
  .sh.sa .ds-head h1, .sh.se .ds-head h1 { text-align: start; margin: 0; }
  .sh.sa .ds-head .ds-sub a { font-weight: 700; }
  .sh.sa .formgrid, .sh.se .formgrid { align-items: end; }
  .sh.sa .item.sm { padding: var(--ds-sp-2h) var(--ds-sp-3); }
  .sh.sa .tabs { margin: var(--ds-sp-4) 0 0; }
  .sh.sa .stats { margin: var(--ds-sp-4) 0 0; }
  .sh.sa .ds-empty, .sh.se .ds-empty { margin: 0; }
  .sh.sa .box > .muted { margin: 0; }
  .sh.sa .rm-note { width: 160px; flex: 0 1 160px; }
  .sh.se .ds-back { margin-bottom: var(--ds-sp-2); }
  .sh.se .ds-head { margin-bottom: var(--ds-sp-4); }
</style>
<main class="sh se ds-page mid flow">
  <a class="ds-back" href="/shop/admin#listings">← Shop admin</a>
<% if (!p) { %>
  <div class="ds-empty"><span class="ds-ic" aria-hidden="true">🔍</span><h1 class="ds-h3">Item not found</h1><a class="ds-btn sm ghost" href="/shop/admin#listings">Back to the listings</a></div>
<% } else { %>
  <div class="ds-head">
    <span class="ds-eyebrow">Staff · Prize shop</span>
    <h1 class="ds-h1">Edit <%= p.seller_id ? 'listing' : 'official item' %></h1>
    <p class="ds-sub"><%= p.seller_id ? 'Sold by ' + p.seller_name : 'Official store item' %> · <%= H.lstatus(p.status).label %> · <a href="/shop/item/<%= p.prizeId %>">view</a></p>
  </div>
  <% if (msg) { %><p class="notice"><%= msg %></p><% } %>
  <form class="box" method="POST" action="/shop/listing/<%= p.prizeId %>" style="display:grid;gap:10px">
    <input type="hidden" name="back" value="/shop/admin/edit/<%= p.prizeId %>">
    <div class="formgrid">
      <label class="wide">Title <input type="text" name="title" maxlength="80" required value="<%= p.prize %>"></label>
      <label>Category
        <select name="category"><% categories.forEach((c) => { %><option <%= p.category === c ? 'selected' : '' %>><%= c %></option><% }) %></select>
      </label>
      <label>Price (PAT) <input type="number" name="price" min="1" required value="<%= p.cost %>"></label>
      <label>Stock <input type="number" name="stock" min="0" required value="<%= p.quantity %>"></label>
      <label>Image (https:// link or /public/img/… path, optional) <input type="text" name="image_url" maxlength="500" inputmode="url" autocomplete="off" pattern="https://\S+|/\S+" title="An https:// link or a site path such as /public/img/shop/ps5-pro.svg" value="<%= p.image_url || '' %>"></label>
      <label class="wide">Description <textarea name="description" maxlength="1000"><%= p.description || '' %></textarea></label>
      <% if (p.seller_id) { %><label class="wide">Ask the buyer for <input type="text" name="buyer_prompt" maxlength="120" value="<%= p.buyer_prompt || '' %>"></label><% } %>
    </div>
    <div><button type="submit">Save</button></div>
  </form>
  <% if (!p.seller_id && typeof alerts !== 'undefined' && alerts) { const back = '/shop/admin/edit/' + p.prizeId + '#alerts'; %>
  <%# 1.99tp: Alert on purchase (storealerts.js) - who hears when someone buys this item, and how %>
  <section class="box sa-alerts" id="alerts" aria-labelledby="saH" style="display:grid;gap:12px">
    <h2 id="saH" style="margin:0"><span class="ds-ic" aria-hidden="true">🛎️</span> <%- t('storealert.admin.h') %></h2>
    <p class="muted" style="margin:0"><%- t('storealert.admin.what') %></p>
    <p class="muted" style="margin:0"><b><%- t('storealert.admin.details_h') %></b> <%- t('storealert.admin.details_what') %></p>
    <% if (!alerts.length) { %><p class="ds-empty"><%- t('storealert.admin.none') %></p><% } %>
    <div class="list">
      <% alerts.forEach((a) => { %>
        <div class="item sm">
          <div class="top"><span><b><% if (a.username) { %><a href="/u/<%= encodeURIComponent(a.username) %>"><%= a.username %></a><% } else { %>?<% } %></b><% if (a.camfrog) { %> <span class="muted">· <%= a.camfrog %></span><% } %><% if (a.admin) { %> <span class="pill"><%- t('storealert.admin.is_admin') %></span><% } %><% if (a.details) { %> <span class="pill" style="color:#ffd700"><%- t('storealert.admin.fulfiller') %></span><% } %></span>
            <span class="muted"><%- t('storealert.admin.added', { name: t.esc(a.added_by_name || '?'), when: t.esc(H.day(a.updated)) }) %></span></div>
          <div class="row">
            <form method="POST" action="/shop/admin/alerts/<%= p.prizeId %>/update" class="row" style="flex:1 1 320px">
              <input type="hidden" name="back" value="<%= back %>">
              <input type="hidden" name="userId" value="<%= a.user_id %>">
              <span class="muted"><%- t('storealert.admin.inbox_always') %></span>
              <label class="check"><input type="checkbox" name="tg" value="1" <%= a.tg ? 'checked' : '' %>> <%- t('storealert.admin.tg') %></label>
              <label class="check"><input type="checkbox" name="pm" value="1" <%= a.pm ? 'checked' : '' %>> <%- t('storealert.admin.pm') %></label>
              <label class="check"><input type="checkbox" name="details" value="1" <%= a.details ? 'checked' : '' %>> <%- t('storealert.admin.details') %></label>
              <button class="alt" type="submit"><%- t('storealert.admin.save') %></button>
            </form>
            <form method="POST" action="/shop/admin/alerts/<%= p.prizeId %>/remove" data-q="<%= t('storealert.admin.remove_q', { name: a.username || '?' }) %>" onsubmit="return confirm(this.dataset.q)">
              <input type="hidden" name="back" value="<%= back %>">
              <input type="hidden" name="userId" value="<%= a.user_id %>">
              <button class="bad" type="submit"><%- t('storealert.admin.remove') %></button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
    <form method="POST" action="/shop/admin/alerts/<%= p.prizeId %>/add" style="display:grid;gap:10px">
      <input type="hidden" name="back" value="<%= back %>">
      <div class="formgrid">
        <label class="wide"><%- t('storealert.admin.who') %> <input type="text" name="who" list="saPeople" maxlength="64" required autocomplete="off" spellcheck="false" placeholder="<%= t('storealert.admin.who_ph') %>"></label>
        <label class="check"><input type="checkbox" name="tg" value="1" checked> <%- t('storealert.admin.tg') %></label>
        <label class="check"><input type="checkbox" name="pm" value="1"> <%- t('storealert.admin.pm') %></label>
        <label class="check wide"><input type="checkbox" name="details" value="1"> <%- t('storealert.admin.details') %></label>
      </div>
      <datalist id="saPeople"></datalist>
      <div><button type="submit"><%- t('storealert.admin.add') %></button></div>
    </form>
  </section>
  <script src="/public/js/shop-alerts.js?v=1" defer></script>
  <% } %>
<% } %>
</main>
