<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: o ? t('shop.order.title_n', { id: o.id }) : t('shop.order.title'), user: user }) %>
<%- include('partials/shop-css') %>
<div class="sh">
<% if (!o) { %>
  <h1><%- t('shop.order.not_found') %></h1>
  <p class="sub"><%- t('shop.order.not_found_sub') %> <a href="/shop/orders"><%- t('shop.order.your_orders') %></a></p>
<% } else { const st = H.status(o.status); const back = '/shop/orders/' + o.id; %>
  <div class="links" style="margin:12px 0"><a href="<%= role === 'seller' ? '/shop/seller' : role === 'admin' ? '/shop/admin' : '/shop/orders' %>"><%- t('shop.order.back') %></a><% if (o.prize_id) { %><a href="/shop/item/<%= o.prize_id %>"><%- t('shop.order.item_page') %></a><% } %></div>
  <h1 style="text-align:left;font-size:22px"><%- t('shop.order.title_n', { id: o.id }) %></h1>
  <% if (msg) { %><p class="notice"><%= msg %></p><% } %>
  <div class="box" style="display:grid;gap:10px">
    <div class="top row" style="justify-content:space-between"><b style="color:#fff;font-size:17px"><%= o.title %></b><span class="pill" style="color:<%= st.color %>"><%= st.label %></span></div>
    <div class="kv">
      <span><%- t('shop.order.price') %></span><div class="price"><%= H.fmt(o.price) %> PAT</div>
      <span><%- t('shop.order.buyer') %></span><div><%= o.buyer_name || '?' %></div>
      <span><%- t('shop.order.seller') %></span><div><% if (o.official) { %><%- t('shop.order.official_store') %><% } else { %><%= o.seller_name || '?' %><% } %></div>
      <span><%- t('shop.order.ordered') %></span><div><%- t('shop.order.when_via', { when: H.when(o.created), source: o.source || 'website' }) %></div>
      <% if (!o.official && (role === 'seller' || role === 'admin')) { %>
        <span><%- t('shop.order.fee') %></span><div><%= o.fee_pct %>%<%= o.seller_paid ? ` — ${H.fmt(o.fee)} PAT; seller got ${H.fmt(o.net)}` : ` — seller gets ${H.fmt(o.price - Math.floor(o.price * o.fee_pct / 100))} on fulfilment` %></div>
      <% } %>
      <% if (o.buyer_input) { %><span><%- t('shop.order.buyer_info') %></span><div class="code"><%= o.buyer_input %></div><% } %>
      <% if (o.dispute_reason) { %><span><%- t('shop.order.dispute') %></span><div><%= o.dispute_reason %></div><% } %>
      <% if (o.resolution) { %><span><%- t('shop.order.outcome') %></span><div><%= o.resolution %></div><% } %>
    </div>
    <% if (o.seller_note && (role !== 'buyer' || ['fulfilled', 'completed', 'disputed', 'refunded'].includes(o.status))) { %>
      <div><span class="muted"><%- t('shop.order.seller_note') %></span><div class="pre code"><%= o.seller_note %></div></div>
    <% } %>
    <% if (o.status === 'fulfilled') { %><p class="muted" style="margin:0"><%- t('shop.order.autocomplete', { date: H.day(Number(o.fulfilled_at) + settings.auto_complete_days * 86400000) }) %></p><% } %>
    <%- include('partials/shop-order-actions', { o, role, back, H, settings, staff: me && me.staff }) %>
  </div>
  <h2><%- t('shop.order.timeline') %></h2>
  <ul class="tl">
    <% events.forEach((e) => { %><li style="--c:<%= H.status(e.status).color %>"><b><%= H.status(e.status).label %></b><% if (e.actor) { %> <%- t('shop.order.by', { name: e.actor }) %><% } %><% if (e.note) { %> — <%= e.note %><% } %><small><%= H.when(e.ts) %></small></li><% }) %>
  </ul>
<% } %>
</div>
