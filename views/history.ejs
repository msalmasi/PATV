<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('history.title'), user: user}) %>
<%# 1.99lx design pass: same data, filters and links as before (period, category, staff lookup, pages, counterparty links,
    web-tip notes, "Balance carried over" ledger rows), grouped by day with a daily net, sticky filters and a phone layout.
    The search box only filters the rows already on this page (no new query). -%>
<style>
  /* 1.99pr polish: .ds-page.mid + ds tokens (gold hero, tab-pill filters in a .ds-subnav bar, day cards) */
  .hx { gap: var(--ds-sp-4); }
  .hx a:not(.ds-btn) { text-decoration: none; }
  .hx .hero { gap: var(--ds-sp-2h); }
  .hx .who { color: var(--ds-text-2); margin: 0; font-size: var(--ds-fs-sm); }
  .hx .who b { color: var(--ds-text-strong); }
  .hx .err { margin: 0; }
  .hx .empty { margin: 0; }
  .hx .tot3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--ds-sp-2); max-width: 560px; }
  .hx .tot3 div { background: var(--ds-glass); border: 1px solid #2c2c2c; border-radius: var(--ds-r-md); padding: var(--ds-sp-2h) var(--ds-sp-3); min-width: 0; display: grid; gap: 2px; }
  .hx .tot3 span { color: var(--ds-text-muted); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: var(--ds-ls-label); }
  .hx .tot3 b { font-size: clamp(14px, 3.8vw, 20px); font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hx form.look { display: flex; gap: var(--ds-sp-2); flex-wrap: wrap; margin: 0; }
  .hx form.look input, .hx .frow input { box-sizing: border-box; margin: 0; min-height: var(--ds-tap); min-width: 0; padding: 10px 12px; border-radius: var(--ds-r-md); border: 1px solid var(--ds-line-strong);
       background: var(--ds-sunken); color: #eee; font: 400 15px/1.3 var(--ds-font); }
  .hx form.look input:hover, .hx .frow input:hover { border-color: #444; }
  .hx form.look input:focus, .hx .frow input:focus { outline: none; border-color: var(--ds-ac); box-shadow: 0 0 0 3px var(--ds-ac-bg); }
  .hx input::placeholder { color: #777; }
  .hx form.look input { flex: 1 1 200px; }
  /* sticky filters: period + category pills (the .ds-tab look; .on = current) */
  .hx .filters { display: grid; gap: var(--ds-sp-2); min-width: 0; }
  .hx .chips { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; min-width: 0; padding: 2px; margin: -2px; }
  .hx .chips::-webkit-scrollbar { display: none; }
  .hx .chips a { flex: none; display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 var(--ds-sp-3h); border: 1px solid #2a2a2a; border-radius: var(--ds-r-pill);
       background: #151515; color: #ccc; font: 500 var(--ds-fs-meta)/1 var(--ds-font); white-space: nowrap; transition: border-color var(--ds-dur-1), color var(--ds-dur-1); }
  .hx .chips a:hover { border-color: var(--ds-ac); color: #fff; }
  .hx .chips a.on { border-color: var(--ds-ac); background: var(--ds-ac-bg); color: #fff; }
  .hx .chips a:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .hx .chips a .mut { color: var(--ds-text-muted); font-size: var(--ds-fs-xs); font-variant-numeric: tabular-nums; }
  @media (pointer: coarse) { .hx .chips a { min-height: 40px; } }
  .hx .frow { display: flex; gap: var(--ds-sp-2); align-items: center; flex-wrap: wrap; }
  .hx .frow input { flex: 1 1 180px; min-height: 40px; padding-block: 8px; }
  .hx .frow .cnt { color: var(--ds-text-muted); font-size: var(--ds-fs-xs); }
  /* category totals */
  .hx details.cats summary { cursor: pointer; color: var(--ds-text-2); font-size: var(--ds-fs-sm); min-height: 36px; display: flex; align-items: center; gap: var(--ds-sp-2); }
  .hx details.cats summary::before { content: "▸"; color: var(--ds-text-muted); }
  .hx details.cats[open] summary::before { content: "▾"; }
  .hx details.cats summary::-webkit-details-marker { display: none; }
  .hx details.cats summary { list-style: none; background: none; }
  .hx .sum { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); gap: var(--ds-sp-2); margin-top: var(--ds-sp-2); }
  .hx .sum a { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-lg); padding: var(--ds-sp-2h) var(--ds-sp-3); color: var(--ds-text); display: grid; gap: 3px; min-width: 0;
       transition: border-color var(--ds-dur-1); }
  .hx .sum a.on { border-color: var(--ds-ac); background: linear-gradient(180deg, var(--ds-ac-bg), transparent 70%), var(--ds-surface); }
  .hx .sum a:hover { border-color: var(--ds-ac); }
  .hx .sum .l { font-weight: 700; color: var(--ds-text-strong); }
  .hx .sum .n { font-size: var(--ds-fs-meta); font-variant-numeric: tabular-nums; color: var(--ds-text-muted); }
  .hx .pos { color: var(--ds-ok); } .hx .neg { color: var(--ds-danger-solid); } .hx .mut { color: var(--ds-text-muted); }
  /* day groups */
  .hx #hxList { display: grid; gap: var(--ds-sp-3); }
  .hx .daycard { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); overflow: hidden; }
  .hx .dayh { display: flex; justify-content: space-between; align-items: center; gap: var(--ds-sp-2); padding: var(--ds-sp-2h) var(--ds-sp-4); background: var(--ds-surface-2); border-bottom: 1px solid var(--ds-line-soft); }
  .hx .day { font-size: 10px; }
  .hx .dnet { font-size: var(--ds-fs-meta); font-variant-numeric: tabular-nums; font-weight: 700; white-space: nowrap; }
  .hx .row2 { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; gap: var(--ds-sp-2h); align-items: center; min-height: var(--ds-tap); padding: var(--ds-sp-2h) var(--ds-sp-4); border-bottom: 1px solid var(--ds-line-soft); }
  .hx .row2:last-child { border-bottom: 0; }
  .hx .row2 .ic { width: 36px; height: 36px; border-radius: var(--ds-r-md); display: grid; place-items: center; font-family: var(--ds-font-emoji); font-size: 18px; line-height: 1; background: #1a1a1a; border: 1px solid var(--ds-line); }
  .hx .row2[data-cat=wheel] .ic { background: #241c08; border-color: #4a3a10; }
  .hx .row2[data-cat=casino] .ic { background: #241212; border-color: #4a2020; }
  .hx .row2[data-cat=heist] .ic { background: #16141f; border-color: #2e2840; }
  .hx .row2[data-cat=games] .ic { background: #0f1a24; border-color: #1f3448; }
  .hx .row2[data-cat=tips] .ic { background: #102010; border-color: #234a23; }
  .hx .row2[data-cat=shop] .ic { background: #1f1024; border-color: #3d2048; }
  .hx .row2[data-cat=pepe] .ic { background: #122012; border-color: #2a4a2a; }
  .hx .row2[data-cat=rewards] .ic { background: #24200a; border-color: #4a4210; }
  .hx .row2 .tx { min-width: 0; line-height: 1.4; font-size: var(--ds-fs-sm); color: var(--ds-text); }
  .hx .row2 .tm { display: block; color: var(--ds-text-faint); font-size: var(--ds-fs-xs); font-variant-numeric: tabular-nums; margin-top: 1px; }
  .hx .row2 .am { text-align: end; font-variant-numeric: tabular-nums; font-weight: 700; white-space: nowrap; font-size: var(--ds-fs-sm); }
  .hx .row2 .am small { display: block; font-weight: 700; color: var(--ds-text-faint); font-size: 11px; letter-spacing: .02em; }
  .hx .row2.adj { background: repeating-linear-gradient(135deg, #141414 0 8px, #171717 8px 16px); }
  .hx .row2.adj .ic { background: #1a1a1a; border-style: dashed; }
  .hx .adjb { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 1px 7px; border-radius: var(--ds-r-pill); border: 1px dashed #777; color: var(--ds-text-2); margin-inline-start: 4px; vertical-align: 1px; white-space: nowrap; }
  .hx .cp { color: var(--ds-green-2); border-bottom: 1px dotted #557; }
  .hx a.cp:hover { color: #a5d6a7; }
  .hx .tnote { font-size: var(--ds-fs-xs); color: #b9b9a0; font-style: italic; margin-top: 2px; overflow-wrap: anywhere; }
  .hx .pager { margin-block-start: 0; }
  .hx .pager > span.mut { border: 0; background: none; color: var(--ds-text-muted); font-weight: 500; }
  @media (max-width: 760px) { .hx form.look input, .hx .frow input { font-size: 16px; } }
  @media (max-width: 520px) { .hx .row2 { padding: var(--ds-sp-2h) var(--ds-sp-3); gap: var(--ds-sp-2); grid-template-columns: 32px minmax(0, 1fr) auto; } .hx .row2 .ic { width: 32px; height: 32px; font-size: 16px; } .hx .dayh { padding-inline: var(--ds-sp-3); } }
  @media (prefers-reduced-motion: reduce) { .hx .chips a, .hx .sum a { transition: none; } }
</style>
<main class="ds-page mid hx">
  <section class="ds-hero gold hero" aria-labelledby="hxH">
    <div class="ds-eyebrow"><%- t('history.eyebrow') %></div>
    <h1 id="hxH"><%- t('history.title') %></h1>
    <% if (data) { %>
      <p class="who"><%- t('history.showing') %> <a href="/u/<%= encodeURIComponent(target) %>" style="color:inherit"><b<% if (targetId) { %> class="cp" title="<%= targetId.title %>"<% } %>><%= target %></b></a><% if (targetId && targetId.alt) { %> <span class="mut">(<%= targetId.alt %>)</span><% } %><%- own ? ' ' + t('history.you') : '' %> · <%- t('history.n_tx', { count: data.count, n: data.count.toLocaleString() }) %></p>
      <% let tin = 0, tout = 0; Object.values(data.totals).forEach(x => { tin += x.in; tout += x.out; }); const tnet = tin - tout; %>
      <div class="tot3" role="group" aria-label="<%- t('history.totals_label') %>">
        <div><span><%- t('history.in') %></span><b class="pos">+<%= tin.toLocaleString() %></b></div>
        <div><span><%- t('history.out') %></span><b class="neg">−<%= tout.toLocaleString() %></b></div>
        <div><span><%- t('history.net') %></span><b class="<%= tnet >= 0 ? 'pos' : 'neg' %>"><%= (tnet >= 0 ? '+' : '−') + Math.abs(tnet).toLocaleString() %></b></div>
      </div>
    <% } %>
    <% if (canLookup) { %>
      <form class="look" method="get" action="/history" role="search">
        <input name="user" placeholder="<%- t('history.lookup_ph') %>" aria-label="<%- t('history.lookup_ph') %>" value="<%= target || '' %>">
        <input type="hidden" name="period" value="<%= period %>">
        <button class="ds-btn ghost" type="submit"><%- t('history.lookup') %></button>
      </form>
    <% } %>
  </section>
  <% if (error) { %><p class="ds-note danger err" role="alert"><%= error %></p><% } %>
  <% if (data) { %>
    <% const q = (o) => '/history?' + new URLSearchParams(Object.assign({ user: target, period, cat: cat || '' }, o)).toString();
       const PERIODS = [['7d', t('history.p7')], ['30d', t('history.p30')], ['90d', t('history.p90')], ['all', t('history.pall')]];
       const cats = Object.entries(data.totals).sort((a, b) => (b[1].in + b[1].out) - (a[1].in + a[1].out));
       const sign = (n) => (n >= 0 ? '+' : '−') + Math.abs(n).toLocaleString();
       // the ledger's own bookkeeping rows (carried-over balance, merges, archive/restore) - shown, but marked as adjustments
       const ADJ = /^(ledger-correction|balance-zeroed|stale-reclaim|stale-restore|camfrog-merge|account merge)$/i;
       let ain = 0, aout = 0; Object.values(data.totals).forEach(x => { ain += x.in; aout += x.out; }); %>
    <div class="filters ds-subnav">
      <nav class="chips" aria-label="<%- t('history.period_label') %>">
        <% PERIODS.forEach(([p, l]) => { %>
          <a class="<%= p === period ? 'on' : '' %>" href="<%= q({ period: p, page: 1 }) %>"<%- p === period ? ' aria-current="true"' : '' %>><%- l %></a>
        <% }) %>
      </nav>
      <nav class="chips" aria-label="<%- t('history.cat_label') %>">
        <a class="<%= !cat ? 'on' : '' %>" href="<%= q({ cat: '', page: 1 }) %>"<%- !cat ? ' aria-current="true"' : '' %>><%- t('history.everything') %></a>
        <% cats.forEach(([k, x]) => { %>
          <a class="<%= cat === k ? 'on' : '' %>" href="<%= q({ cat: k, page: 1 }) %>"<%- cat === k ? ' aria-current="true"' : '' %>><%= x.label %> <span class="mut">(<%= x.n %>)</span></a>
        <% }) %>
      </nav>
      <div class="frow">
        <input type="search" id="hxFind" placeholder="<%- t('history.find_ph') %>" aria-label="<%- t('history.find_ph') %>" autocomplete="off">
        <span class="cnt" id="hxCnt" aria-live="polite"></span>
      </div>
    </div>

    <details class="cats">
      <summary><%- t('history.by_cat') %></summary>
      <div class="sum">
        <a class="<%= !cat ? 'on' : '' %>" href="<%= q({ cat: '', page: 1 }) %>">
          <div class="l"><%- t('history.everything') %></div>
          <div class="n"><span class="pos">+<%= ain.toLocaleString() %></span> · <span class="neg">−<%= aout.toLocaleString() %></span>
            · <%- t('history.net_lc') %> <span class="<%= ain - aout >= 0 ? 'pos' : 'neg' %>"><%= sign(ain - aout) %></span></div>
        </a>
        <% cats.forEach(([k, x]) => { const net = x.in - x.out; %>
          <a class="<%= cat === k ? 'on' : '' %>" href="<%= q({ cat: k, page: 1 }) %>">
            <div class="l"><%= x.label %> <span class="mut">(<%= x.n %>)</span></div>
            <div class="n"><span class="pos">+<%= x.in.toLocaleString() %></span> · <span class="neg">−<%= x.out.toLocaleString() %></span>
              · <%- t('history.net_lc') %> <span class="<%= net >= 0 ? 'pos' : 'neg' %>"><%= sign(net) %></span></div>
          </a>
        <% }) %>
      </div>
    </details>

    <% // group the page's rows by day (the viewer's zone, tz.js) with each day's net
       const groups = [];
       data.items.forEach(it => {
         const ts = new Date(String(it.timestamp).replace(' ', 'T') + 'Z');
         // 1.99jx: the viewer's zone (tz.js), the time labelled
         const day = (locals.tzFmt || new Function(include('../tz-core.js'))()('UTC', 'en').fmt)(ts, 'day');
         const tm = (locals.tzTime || new Function(include('../tz-core.js'))()('UTC', 'en').time)(ts, 'time');
         let g = groups[groups.length - 1];
         if (!g || g.day !== day) { g = { day, net: 0, rows: [] }; groups.push(g); }
         g.net += it.points;
         g.rows.push({ it, tm });
       }); %>
    <div id="hxList">
    <% groups.forEach((g) => { %>
      <section class="daycard" aria-label="<%= g.day %>">
        <div class="dayh"><h2 class="ds-pixel-h day"><%= g.day %></h2><span class="dnet <%= g.net >= 0 ? 'pos' : 'neg' %>" title="<%- t('history.day_net') %>"><%= sign(g.net) %></span></div>
        <% g.rows.forEach(({ it, tm }) => { const adj = ADJ.test(String(it.rawType || '')); %>
          <div class="row2<%= adj ? ' adj' : '' %>" data-cat="<%= it.cat %>">
            <div class="ic" aria-hidden="true"><%= it.icon %></div>
            <div class="tx"><%= it.text %><% if (it.cp && it.cpPrep !== null) { %> <%= it.cpPrep %> <% if (it.cp.archived) { %><span class="cp" title="<%= it.cp.title %>"><%= it.cp.name %></span><% } else { %><a class="cp" href="/u/<%= encodeURIComponent(it.cp.name) %>" title="<%= it.cp.title %>"><%= it.cp.name %></a><% } %><% if (it.cp.alt) { %> <span class="mut">(<%= it.cp.alt %>)</span><% } %><% } %><% if (adj) { %> <span class="adjb"><%- t('history.adjustment') %></span><% } %><% if (it.note) { %><div class="tnote">&ldquo;<%= it.note %>&rdquo;</div><% } %><span class="tm"><%- tm %></span></div>
            <div class="am <%= it.points >= 0 ? 'pos' : 'neg' %>"><%= (it.points >= 0 ? '+' : '−') + Math.abs(it.points).toLocaleString() %><small>PAT</small></div>
          </div>
        <% }) %>
      </section>
    <% }) %>
    </div>
    <% if (!data.items.length) { %><p class="ds-empty empty"><%- t('history.nothing') %></p><% } %>
    <p class="ds-empty empty" id="hxNone" hidden><%- t('history.no_match') %></p>
    <nav class="ds-pager pager" aria-label="<%- t('history.pages_label') %>">
      <% if (data.page > 1) { %><a href="<%= q({ page: data.page - 1 }) %>" rel="prev"><%- t('history.newer') %></a><% } %>
      <span class="mut"><%- t('history.page_of', { page: data.page, pages: data.pages }) %></span>
      <% if (data.page < data.pages) { %><a href="<%= q({ page: data.page + 1 }) %>" rel="next"><%- t('history.older') %></a><% } %>
    </nav>
    <script>
    (function () {
      var _t = typeof __t === 'function' ? __t : function (k, d, v) { return String(d).replace(/\{!?(\w+)\}/g, function (m, n) { return v && v[n] != null ? v[n] : m; }); };
      var box = document.getElementById('hxFind'), cnt = document.getElementById('hxCnt'), none = document.getElementById('hxNone');
      if (!box) return;
      var rows = Array.prototype.slice.call(document.querySelectorAll('#hxList .row2'));
      var days = Array.prototype.slice.call(document.querySelectorAll('#hxList .daycard'));
      box.addEventListener('input', function () {
        var q = box.value.trim().toLowerCase(), shown = 0;
        rows.forEach(function (r) { var hit = !q || r.textContent.toLowerCase().indexOf(q) >= 0; r.hidden = !hit; if (hit) shown++; });
        days.forEach(function (d) { d.hidden = !d.querySelector('.row2:not([hidden])'); });
        cnt.textContent = q ? _t('js.history.matches', '{n} on this page', { n: shown }) : '';
        none.hidden = !(q && !shown);
      });
    })();
    </script>
  <% } %>
</main>
</body>
</html>
