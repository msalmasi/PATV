<%# views/messages.ejs — direct messages (messages.js, 1.99cp). The shell only: public/js/messages.js renders the
    conversation list and the chat from `boot` (JSON, below) and the JSON API, with live updates over /events?type=dm. %>
<%- include('layout', { title: title, user: user, inboxUnread: typeof inboxUnread !== 'undefined' ? inboxUnread : 0, dmUnread: dmUnread }) %>
<link rel="stylesheet" href="/public/css/messages.css?v=1">
<main class="dm" id="dm" data-view="<%= boot.open || boot.to ? 'chat' : 'list' %>">
  <aside class="dm-side" aria-label="Conversations">
    <div class="dm-sh">
      <h1>Messages</h1>
      <button type="button" class="dm-ib" id="dmNewBtn" title="New message" aria-label="New message"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17Z"/><path d="m14 8 3 3"/></svg></button>
      <button type="button" class="dm-ib" id="dmGearBtn" title="Message settings" aria-label="Message settings"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 0 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 0 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 0 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 0 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg></button>
    </div>
    <nav class="dm-tabs" aria-label="Inbox sections">
      <a href="/inbox"><span aria-hidden="true">🔔</span> Notices</a>
      <a href="/messages" class="on" aria-current="page"><span aria-hidden="true">💬</span> Messages</a>
    </nav>
    <form class="dm-find" id="dmFind" hidden autocomplete="off">
      <label for="dmFindIn" class="vh">Username to message</label>
      <input id="dmFindIn" name="to" placeholder="Message someone: their username" maxlength="64" spellcheck="false" autocapitalize="off">
      <button type="submit">Go</button>
      <div class="dm-find-msg" id="dmFindMsg" role="status"></div>
    </form>
    <ul class="dm-list" id="dmList"></ul>
    <p class="dm-empty" id="dmListEmpty" hidden>No conversations yet. Press <b>✎</b> to message someone, or use <b>Message</b> on a profile.</p>
    <p class="dm-e2e"><span aria-hidden="true">🔓</span> Messages aren't end-to-end encrypted. Site admins can read a message only if it's reported to them. <a href="/privacy#messages">Privacy</a></p>
  </aside>

  <section class="dm-chat" id="dmChat" aria-label="Chat">
    <div class="dm-none" id="dmNone">
      <div class="big" aria-hidden="true">💬</div>
      <p>Pick a conversation, or press <b>✎</b> to start one.</p>
    </div>
    <header class="dm-ch" id="dmHead" hidden>
      <button type="button" class="dm-back" id="dmBack" aria-label="Back to conversations"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5 8 12l7 7"/></svg></button>
      <span class="av av-l" id="dmHeadAv" aria-hidden="true"></span>
      <div class="dm-who"><a class="dm-name" id="dmHeadName" href="#"></a><span class="dm-handle" id="dmHeadHandle"></span></div>
      <details class="dm-menu" id="dmMenu">
        <summary aria-label="Conversation options"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="5.5" cy="12" r="1.6" fill="currentColor"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><circle cx="18.5" cy="12" r="1.6" fill="currentColor"/></svg></summary>
        <div class="dm-pop" role="menu">
          <a role="menuitem" id="dmMProfile" href="#">View profile</a>
          <button type="button" role="menuitem" data-dm="clear">Clear history (for you)</button>
          <button type="button" role="menuitem" data-dm="hide">Delete conversation (for you)</button>
          <button type="button" role="menuitem" class="danger" data-dm="block" id="dmMBlock">Block</button>
        </div>
      </details>
    </header>
    <div class="dm-scroll" id="dmScroll" hidden>
      <div class="dm-older" id="dmOlder" hidden>Loading older messages…</div>
      <div class="dm-start" id="dmStart" hidden></div>
      <div class="dm-msgs" id="dmMsgs" role="log" aria-live="polite" aria-relevant="additions"></div>
    </div>
    <form class="dm-compose" id="dmCompose" hidden autocomplete="off">
      <div class="dm-refuse" id="dmRefuse" role="status" hidden></div>
      <div class="dm-cbox">
        <label for="dmText" class="vh">Message</label>
        <textarea id="dmText" rows="1" maxlength="<%= boot.maxLen %>" placeholder="Message"></textarea>
        <button type="submit" id="dmSend" aria-label="Send"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12 20 4l-4 16-4-7Z"/><path d="m12 13 8-9"/></svg></button>
      </div>
      <div class="dm-hint"><span><b>Enter</b> sends · <b>Shift+Enter</b> new line</span><span id="dmErr" class="dm-err" role="alert"></span></div>
    </form>
  </section>

  <dialog class="dm-dlg" id="dmSettings" aria-labelledby="dmSetT">
    <form method="dialog" id="dmSetForm">
      <h2 id="dmSetT">Message settings</h2>
      <fieldset>
        <legend>Who can message me</legend>
        <label class="rd"><input type="radio" name="who" value="everyone"> Everyone <span class="mut">(new accounts only if you follow them)</span></label>
        <label class="rd"><input type="radio" name="who" value="following"> Only people I follow</label>
        <label class="rd"><input type="radio" name="who" value="nobody"> Nobody <span class="mut">(people you write to can still reply)</span></label>
      </fieldset>
      <fieldset>
        <legend>Camfrog alerts</legend>
        <label class="ck"><input type="checkbox" name="alerts"> Pepe PMs me in Camfrog when I get a message I haven't read on the site</label>
        <label class="ck sub"><input type="checkbox" name="nopreview"> Alert without preview (who it's from, not what it says)</label>
        <p class="mut" id="dmSetCf">At most one alert per conversation every 10 minutes, and only in a room where you are.</p>
      </fieldset>
      <fieldset>
        <legend>Blocked</legend>
        <ul class="dm-blocks" id="dmBlocks"></ul>
        <p class="mut">Blocking stops messages both ways. They aren't told.</p>
      </fieldset>
      <div class="dm-dlg-acts"><span class="dm-err" id="dmSetMsg" role="status"></span><button type="button" value="cancel" id="dmSetClose">Close</button><button type="submit" value="save" class="pri">Save</button></div>
    </form>
  </dialog>

  <dialog class="dm-dlg" id="dmReport" aria-labelledby="dmRepT">
    <form method="dialog" id="dmRepForm">
      <h2 id="dmRepT">Report this message</h2>
      <p class="mut">It goes to the site admins only (never pad owners). The sender isn't told who reported it. An admin can then read this one message.</p>
      <div class="dm-reasons" id="dmReasons"></div>
      <label class="nt">Anything to add? <span class="mut">(optional)</span><textarea name="note" maxlength="300" rows="2"></textarea></label>
      <div class="dm-dlg-acts"><span class="dm-err" id="dmRepMsg" role="status"></span><button type="button" id="dmRepClose">Cancel</button><button type="submit" class="pri">Report</button></div>
    </form>
  </dialog>
</main>
<script type="application/json" id="dmBoot"><%- JSON.stringify(boot).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029') %></script>
<script src="/public/js/messages.js?v=1" defer></script>
</body>
</html>
