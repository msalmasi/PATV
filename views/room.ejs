  .rm.pad-acc .ibtn:hover, .rm.pad-acc .hd-more[open] > summary { border-color: var(--pad-accent); }
  .rm.pad-acc .golive-btn.ghost { border-color: var(--pad-accent); color: var(--pad-accent) !important; }
  @media (max-width: 640px) { .rm .hero-bn { height: 120px; } .rm .rm-av { width: 46px; height: 46px; border-radius: 13px; } .rm .hero.has-bn .hd { margin-top: -36px; } }
