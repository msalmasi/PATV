  .rm .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; border-radius: 8px; border: 1px solid var(--ds-green); background: var(--ds-green); color: var(--ds-on-ac) !important; font-weight: bold; font-size: 14px; }
  .rm .tease { text-align: center; padding: 34px 18px; display: grid; gap: 10px; justify-items: center; }
  .rm .tease .big { font-size: 44px; }
  .rm .jump { position: sticky; bottom: 4px; align-self: center; background: var(--ds-green); color: var(--ds-on-ac); border: 0; border-radius: 999px; padding: 5px 14px; font: inherit; font-size: 12px; cursor: pointer; display: none; }
  .rm .status { font-size: 12px; color: var(--ds-text-faint); }
