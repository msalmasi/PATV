  .rm .snap video { width: 100%; border-radius: 8px; background: #000; display: block; }
  /* 1.99yh: 📡 ▶ Live (pad-livecam.js) - the live player takes the preview's place while it plays */
  .rm .snap button.live { background: #102a33; border-color: #2c6f80; color: #d3f3fb; font-weight: bold; }
  .rm .snap button.live:hover, .rm .snap button.live:focus-visible { border-color: #5fd0e6; }
  .rm .snap button.live:disabled { opacity: .55; cursor: default; }
  .rm .snap .lc-slots { font-size: 12px; color: #9aa; }
  .rm .snap.lc-on > img { display: none; }
  .rm .snap .lc-wrap { position: relative; }
