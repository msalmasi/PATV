  .rm .an-gate { margin: 0; color: #bbb; font-size: 14px; line-height: 1.6; }
  @media (max-width: 400px) { .rm .an-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* 1.99ec: the Live tab's side cards - the title stays on one line; its action (link / count) sits right of it,
