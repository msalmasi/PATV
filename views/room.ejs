    <div class="plexq" id="rmPlexQ" data-room="<%= room.slug %>" hidden></div>
    <%# 1.99ajy dockmedia: no aria-live on the player (its times redraw every second, the box every 4 s - the Dock keeps it on screen in the Now playing card;
