      .plexq .sact[aria-disabled="true"] { opacity: .5; cursor: default; }
      .plexq .pq-pos { white-space: nowrap; }
      .plexq .pq-br { display: none; }
    </style>
    <script src="/public/js/pad-plexq.js?v=4" defer></script><%# 1.99ajy dockmedia: v3 - the controls group says they are for everyone watching; v4 (verify) - focus kept across a redraw, the same markup never rewritten, ⏮ ⏸ ⏭ ⏹ first, the line's parts in their own spans %>
    <% if (schedule_) { %><%- include('partials/room-schedule', { slug: room.slug, schedule: schedule_ }) %><% } %>
