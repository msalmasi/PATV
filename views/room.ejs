<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%# 1.99ajh dockpop (owner P1): chatOnly = the pad's chat in its own window (bridge.js GET /p/:slug/chat) - this same template, the
    Room Dock's chat card alone: a bare head (partials/popout-head, no navbar / footer), no hero, tabs, stage, cam strip, feed or about,
    and the ONE copy of the live script below (renderer, veils, Reveal, relay, push-to-talk, room PM, person menu, camera sheet...) -%>
<% const chatOnly_ = !!locals.chatOnly; -%>
<% if (chatOnly_) { %><%- include('partials/popout-head', { title: t('pad.chat.window_title', { name: room.name }) }) %><% } else { %><%- include('layout', { title: 'p/' + room.slug + ' — ' + room.name, user: user }) %><% } %>
<% /* 1.99dt: ul() links names (userlinks.js, app.locals); rendered without the app it's the plain name */
   const UL = typeof ul === 'function' ? ul : (n, o) => escapeFn(o && o.text != null ? o.text : (n == null ? '' : n)) + (o && o.web ? ' 🌐' : '');
   const ULE = typeof ulEsc === 'function' ? ulEsc : escapeFn; %>
<%# The pad page (1.99ck, /p/<slug>; was /rooms/<slug> + /feed/c/<slug>). A site pad (the Camfrog Lounge) has no
    Camfrog room: no live section, no "not bridged" note. 1.99x: the header shows the pad's platform badge
    (🐸 Camfrog Pad / 🌐 Site Pad).
    1.99dx: header, then the story strip (fresh captures, only when there are some), then a sticky tab bar
    (public/js/pad-tabs.js) over three panels that are only ever HIDDEN, never unmounted, so polling, push-to-talk,
    the mic, the stage player and the schedule refresh keep running whichever tab shows:
      Live (on pads without a Camfrog room: "Stage") - the Stage card (player, Snap / Clip), right under it the Go live
        card (1.99ee: slot status + 🚀 boost line, Go live here / Book a slot / 🚀 Boost this pad, on now / coming up /
        queue), the DJ booth, the Camfrog chat bridge with the Manage card (collapsed to the topic), "Latest from the
        feed", on the mic, who's in the room
      Feed - composer (collapsed to a "Create post" bar), sorts and posts: ONE centred column (1.99ec - the side
        column with the Rules card and the pad blurb is gone; both are in About)
      About - description, owner, analytics, rules (the #rules anchor, where the header's Rules chip goes), how to
        join the Camfrog room
    The schedule has no tab of its own: it's the lower half of the Go live card. %>
<% const pepeHere_ = typeof pepeHere !== 'undefined' && pepeHere, manage_ = typeof manage !== 'undefined' && manage, roomStage_ = typeof roomStage !== 'undefined' ? roomStage : null, schedule_ = typeof schedule !== 'undefined' ? schedule : null, bridged_ = room.bridged !== false, siteOnly_ = !!room.siteOnly, feed_ = typeof feed !== 'undefined' && feed ? feed : null, dms_ = typeof dms !== 'undefined' && !!dms;
   const PT_ = typeof padTabs !== 'undefined' && padTabs ? padTabs : { tabs: ['live'].concat(feed_ ? ['feed'] : [], ['about']), initial: 'live', active: false, camfrog: !siteOnly_, posts: [] };
   const latest_ = typeof latest !== 'undefined' && latest ? latest : [];
   // 1.99fu: pad visibility (padaccess.js) - liveOpen = this viewer gets the members-tier content (the live room, story
   // pictures, analytics): signed in, or anyone on a Public pad; access.level = public | members | approved
   const liveOpen_ = typeof liveOpen !== 'undefined' ? !!liveOpen : (typeof signedIn !== 'undefined' && !!signedIn);
   // adultgate site: the 18+ gate (adultgate.js; "ok" unless the owner switch is on and this is an 18+ pad)
   const adultGate_ = typeof adultGate !== 'undefined' && (adultGate === 'signin' || adultGate === 'confirm') ? adultGate : 'ok';
   const adultNext_ = typeof adultNext !== 'undefined' && adultNext ? adultNext : '/p/' + encodeURIComponent(room.slug);
   const access_ = typeof access !== 'undefined' && access ? access : { level: 'members' };
   const tabOn_ = (t) => PT_.initial === t;
   // 1.99aej: a site pad whose Live tab holds the chat hub's widget (PT_.lineLive) calls it Live - it is the pad's chat, not only its stage
   const liveLabel_ = PT_.camfrog || PT_.lineLive ? t('pad.tab.live') : t('pad.tab.stage'); %>
<%# 1.99x: the platform badge (pads.js padBadge via fx or app.locals; a plain fallback when rendered bare) %>
<% const padBadge_ = typeof fx !== 'undefined' && fx && fx.padBadge ? fx.padBadge : typeof padBadge === 'function' ? padBadge
     : (p) => '<span class="pad-plat pp-' + p + '">' + (p === 'site' ? '🌐 Site Pad' : '🐸 Camfrog Pad') + '</span>'; %>
<style>
  .rm { max-width: 1120px; margin: 0 auto; padding: 18px 16px 56px; font-family: var(--ds-font); color: var(--ds-text); display: grid; gap: 14px; box-sizing: border-box; width: 100%; }
