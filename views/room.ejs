  .rm .compose { border-top: 1px solid #222; margin-top: 10px; padding-top: 10px; display: grid; gap: 8px; }
  .rm .say { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; }
  .rm .say input { background: #0d0d0d; color: #eee; border: 1px solid var(--ds-line-strong); border-radius: 8px; padding: 9px 10px; font: inherit; font-size: 14px; min-width: 0; }
  .rm .say .btn { cursor: pointer; font-family: inherit; }
  .rm .ic button.cam { background: none; border: 1px solid #2c3a2d; border-radius: 6px; padding: 0 3px; cursor: pointer; font: inherit; line-height: 1.4; }
  .rm .ic button.cam:hover, .rm .ic button.cam:focus-visible { border-color: var(--ds-green); background: #12301a; }
  .rm .snap { position: fixed; z-index: 60; right: 16px; bottom: 16px; width: min(360px, calc(100vw - 32px)); background: #151515; border: 1px solid var(--ds-line-strong); border-radius: 12px;
              box-shadow: 0 12px 40px rgba(0,0,0,.6); padding: 10px; display: grid; gap: 8px; }
