      safe('clip', function () { if (chatClip) chatClip.update(d); });
      cursor = Math.max(cursor, d.cursor);
      // 1.99acb: your room line the site named but this answer didn't carry - ask again from just before it (once per line)
      var miss = roomRelay && roomRelay.refetch ? roomRelay.refetch() : 0;
      if (miss && miss <= cursor) cursor = miss - 1;
    }

    // 1.99ye: a long-poll (?wait=1): the site answers the moment something changes (a line, the people / mic, your
    // message's state) - or after 20 s with nothing - and the page asks again at once. A site that answers without
    // `lp` (older) is polled every 1.5 s as before. v / mv = the room's / your messages' versions the page has seen.
    var lp = { ok: false, v: data && data.ver != null ? data.ver : null, mv: data && data.mver != null ? data.mver : null,
               rs: data && data.rs != null ? data.rs : null }, inflight = false;   // review 2 fix-up: rs = the removed / redo entries it got
    function poll() {
      timer = null;
      if (document.hidden || inflight) return;
      inflight = true;
      var q = '?after=' + cursor + '&wait=1' + (lp.v != null ? '&v=' + lp.v : '') + (lp.mv != null ? '&mv=' + lp.mv : '') + (lp.rs != null ? '&rs=' + lp.rs : '') +
        (roomRelay && roomRelay.wantsMe && roomRelay.wantsMe() ? '&me=1' : '') + (jcTok ? '&jc=' + encodeURIComponent(jcTok) : '');
      fetch('/api/rooms/' + encodeURIComponent(slug) + '/live' + q, { credentials: 'same-origin', cache: 'no-store' })
        .then(function (r) { if (r.status === 401) { location.href = '/login'; throw new Error('signed out'); } if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
        .then(function (d) {
          fails = 0; setStatus('');
          // CL3: the join cursor ran out (24 h) - load the view again, like a fresh page (nothing earlier than its floors)
          if (d.reinit) {
            jcTok = null; cursor = 0; haveC = {}; haveList = []; maxC = 0; feedEl.textContent = ''; resetNext = true; lp.ok = true;
            safe('compose-reset', function () { if (roomRelay && roomRelay.reset) roomRelay.reset(); });
            safe('hist-reset', function () { if (padHist) padHist.reset(); });   // CL8
            return;
          }
          lp.ok = !!d.lp && !d.gone;
          if (d.gone) return;
          if (d.ver != null) lp.v = d.ver;
          if (d.rs != null) lp.rs = d.rs;
          if (d.mver != null) lp.mv = d.mver;
          apply(d, resetNext);
          resetNext = false;
        })
        .catch(function () { fails++; lp.ok = false; setStatus(fails > 2 ? _t('js.pad.chat.reconnecting', 'reconnecting…') : '', fails > 2); })
        .then(function () { inflight = false; schedule(); });
    }
    function setStatus(t, err) { var s = document.getElementById('rmStatus'); if (!s) return; s.textContent = t; s.classList.toggle('err', !!err); }
    function schedule() { if (!timer && !document.hidden) timer = setTimeout(poll, fails ? Math.min(15000, 1500 * Math.pow(2, fails)) : (lp.ok ? 50 : 1500)); }
    document.addEventListener('visibilitychange', function () { if (!document.hidden) { clearTimeout(timer); timer = null; poll(); } });
    window.addEventListener('online', function () { if (fails) { clearTimeout(timer); timer = null; fails = 0; poll(); } });

    try { apply(data, true); } finally { schedule(); }   // the poll always starts
  })();
  </script>
<% } %>
  <%# 1.99za: the story strip (fresh captures) - was between the header and the tabs on every tab; now the end of Live %>
  <% if (feed_ && (((feed_.caps || []).length) || ((feed_.storyRooms || []).length))) { %>
    <section class="card rm-story" aria-label="<%- t('pad.story.aria') %>"><%- include('partials/story-strip', { story: { caps: feed_.caps, rooms: feed_.storyRooms || [], room: feed_.room, signed: !!feed_.viewer, compose: !!feed_.viewer }, heading: t('pad.story.fresh'), next: '/p/' + encodeURIComponent(room.slug) }) %></section>
  <% } %>
  <%# 1.99aae: 🚀 the launchpad card (pad-launch.js fills it; hidden unless this pad is on the launchpad) - the very
      end of Live (was between the header and the tabs on every tab) %>
  <section class="card pad-launch" id="padLaunch" data-slug="<%= room.slug %>" aria-label="<%- t('pad.launchpad') %>" hidden></section>
  </section>
<% if (feed_) { %>
  <section class="ppanel" id="padPanel-feed" role="tabpanel" aria-labelledby="padTab-feed"<%= tabOn_('feed') ? '' : ' hidden' %>>
    <div class="fcol"><%- include('partials/room-feed', { feed: feed_, fx, embeds, host, room, noStory: true, noRules: true }) %></div>
  </section>
<% } %>
  <section class="ppanel about" id="padPanel-about" role="tabpanel" aria-labelledby="padTab-about"<%= tabOn_('about') ? '' : ' hidden' %>>
    <%# 1.99za: this card also holds what the compact header dropped: the address, the platform badge, access, 18+, the
        pad's badges in full, the owner / house pad, and the live-view note (was a banner above the stage) %>
    <section class="card ab-card" id="about" aria-labelledby="abH">
      <h2 id="abH"><span><%- t('pad.about.h', { slug: room.slug }) %></span></h2>
      <% if (room.description) { %><div class="desc"><%= room.description %></div><% } else { %><p class="muted" style="margin:0"><%- t('pad.about.no_desc') %></p><% } %>
      <dl>
        <dt><%- t('pad.about.pad') %></dt><dd><%= room.name %> · <%- padBadge_(room.platform || (siteOnly_ ? 'site' : 'camfrog')) %></dd>
        <dt><%- t('pad.about.address') %></dt><dd><span class="padref">p/<%= room.slug %></span></dd>
        <dt><%- t('pad.about.access') %></dt><dd><span class="ab-tags"><% if (access_.level === 'approved') { %><span class="htag" title="<%- t('pad.hdr.approved_tip') %>"><%- t('pad.hdr.approved') %></span><% } else if (access_.level === 'public') { %><span class="htag" title="<%- t('pad.hdr.public_tip') %>"><%- t('pad.hdr.public') %></span><% } else { %><span class="htag"><%- t('pad.about.members') %></span><% } %><% if (room.adult) { %><span class="htag adult18" title="<%- t('pad.adult.tip') %>"><%- t('pad.adult.badge') %></span><% } %></span></dd>
        <% if (PFX_ && PFX_.badges) { %><dt><%- t('pad.about.badges') %></dt><dd><%- PFX_.badges %></dd><% } %>
        <dt><%- t('pad.about.run_by') %></dt><dd><% if (room.house) { %><%- t('pad.about.house') %><% } else if (room.owner) { %><a href="/u/<%= encodeURIComponent(room.ownerUser) %>">👑 <%= room.owner %></a><% } else { %><span class="muted"><%- t('pad.about.nobody') %></span><% } %></dd>
        <% if (feed_ && feed_.follow) { %><dt><%- t('pad.about.followers') %></dt><dd><%= feed_.follow.followers.toLocaleString('en-US') %></dd><% } %>
        <% if (!siteOnly_) { %><dt><%- t('pad.about.cf_room') %></dt><dd><%= room.camfrogName || room.name %></dd><% } %>
        <% if (typeof twitch !== 'undefined' && twitch && twitch.login) { %><dt>Twitch</dt><dd><a href="https://twitch.tv/<%= twitch.login %>" rel="noopener" target="_blank">twitch.tv/<%= twitch.login %></a></dd><% } %>
        <% if (manage_) { %><dt><%- t('pad.about.settings') %></dt><dd><a href="/p/<%= encodeURIComponent(room.slug) %>/settings"><%- t('pad.about.settings_link') %></a></dd><% } %>
        <% if (manage_) { %><dt><%- t('pad.owner_panel') %></dt><dd><a href="/p/<%= encodeURIComponent(room.slug) %>/owner">👑 <%- t('pad.owner_panel') %></a></dd><% } %>
      </dl>
      <% if (bridged_ && !siteOnly_) { %><p class="ab-note" role="note">📡 <%- t('pad.live.banner') %></p><% } %>
    </section>
    <%# 1.99sn: 💰 the pad vault, public, first card under About (partials/pad-vault-card.ejs; roomvaults.js) %>
    <% if (typeof roomVault !== 'undefined' && roomVault) { %><%- include('partials/pad-vault-card', { rv: roomVault, room, slug: room.slug, signed: giftSigned_, siteOnly: siteOnly_, num: (n) => Math.round(Number(n) || 0).toLocaleString('en-US') }) %><% } %>
    <%# 1.99zm: 🔥 the pad streak + your regular streak here (padstreaks.js, partials/pad-streak-card.ejs) %>
    <% if (!siteOnly_) { %><%- include('partials/pad-streak-card', { slug: room.slug }) %><% } %>
    <%# 1.99wu: 🎤 mic challenges (economy v2 E-8): the pad's latest judged performances + today's prize budget, filled by
        public/js/pad-challenges.js from GET /api/rooms/:slug/challenges (challengepay.js); stays hidden until there is one %>
    <%# adultgate site: not past the 18+ gate - the results name who was on the room's mic (the API refuses them too) %>
    <% if (!siteOnly_ && adultGate_ === 'ok') { %><section class="card pc-card" id="challenges" aria-labelledby="pcH" data-slug="<%= room.slug %>" hidden>
      <h2 id="pcH"><span><%- t('pad.chal.h') %></span></h2>
      <p class="muted pc-budget" data-pc="budget"></p>
      <ol class="pc-list" data-pc="list"></ol>
    </section><% } %>
    <%# 1.99ur: 🔮 the pad's own markets, pools and polls (padbets.js, partials/pad-bets-card.ejs) %>
    <% if (typeof padBets !== 'undefined' && padBets) { %><%- include('partials/pad-bets-card', { pb: padBets, slug: room.slug }) %><% } %>
    <%# 1.99xk: 🎫 the pad's raffles (raffles.forPad, partials/pad-raffles-card.ejs) %>
    <% if (typeof padRaffles !== 'undefined' && padRaffles) { %><%- include('partials/pad-raffles-card', { pr: padRaffles, slug: room.slug }) %><% } %>
    <%# 1.99ew: 🎁 gift a premium cosmetic to this pad (padcosmetics.js, public/js/pad-cosmetics.js); the owner buys from ⚙ settings %>
    <section class="card ab-gift" id="gift" aria-labelledby="giftH">
      <h2 id="giftH"><span><%- t('pad.gift.h') %></span></h2>
      <% if (isOwner_) { %>
        <p class="muted" style="margin:0"><%- t('pad.gift.owner', { link: '<a href="/p/' + encodeURIComponent(room.slug) + '/settings#cosmetics">' + t('pad.gift.owner_link') + '</a>' }) %></p>
      <% } else { %>
        <p class="muted" style="margin:0 0 10px"><%- t('pad.gift.treat', { name: room.name }) %></p>
        <% if (giftSigned_) { %><button type="button" class="ab-btn" data-pad-gift="<%= room.slug %>"><%- t('pad.menu.gift') %></button><% } else { %><a class="ab-btn" href="/login?next=<%= encodeURIComponent('/p/' + room.slug + '?tab=about#gift') %>"><%- t('pad.gift.signin') %></a><% } %>
      <% } %>
    </section>
    <%# 1.99el: Analytics is its own card (was an "Analytics: Pad analytics ›" row above): the 30-day headline numbers
        from roomstats.preview (cached), for signed-in viewers only - visitors get the analytics page's sign-in prompt %>
    <% const anCard_ = typeof roomAnalyticsCard !== 'undefined' && roomAnalyticsCard ? roomAnalyticsCard : null;
       const anSigned_ = liveOpen_;      // 1.99fu: members-tier - signed in, or anyone on a Public pad
       const anS_ = anCard_ && anSigned_ ? anCard_.stats : null; %>
    <% if (analytics_) { %>
    <section class="card an-card" aria-labelledby="anH">
      <h2 id="anH"><span><%- t('pad.an.h') %></span><small><%- t('pad.an.last30') %></small></h2>
      <% if (anS_) { %>
      <div class="an-tiles">
        <div class="an-t"><div class="k"><%- t('pad.an.messages') %></div><div class="v"><%= anS_.msgs30 %></div><div class="s"><% if (anS_.msgsTrend != null) { %><span class="<%= anS_.msgsTrend >= 0 ? 'up' : 'down' %>"><%= anS_.msgsTrend >= 0 ? '▲' : '▼' %> <%= Math.abs(anS_.msgsTrend) %>%</span> <%- t('pad.an.month_before') %><% } else { %><%- t('pad.an.public_chat') %><% } %></div></div>
        <div class="an-t"><div class="k"><%- t('pad.an.visitors') %></div><div class="v"><%= anS_.uniq30 %></div><div class="s"><%- t('pad.an.different') %></div></div>
        <div class="an-t"><div class="k"><%- t('pad.an.mic_time') %></div><div class="v"><%= anS_.mic30 %></div><div class="s"><%- t('pad.an.on_mic') %></div></div>
        <div class="an-t"><div class="k"><%- t('pad.an.typical') %></div><div class="v"><%= anS_.typical %></div><div class="s"><%= anS_.typicalNote %><% if (anS_.peakSize) { %> · <%- t('pad.an.peak', { n: anS_.peakSize }) %><% } %></div></div>
        <div class="an-t an-wide"><div class="k"><%- t('pad.an.busiest') %></div><div class="v sm"><%= anS_.peak %></div><div class="s"><%- t('pad.an.by_messages') %></div></div>
      </div>
      <% } else if (!anSigned_) { %>
      <p class="an-gate"><%- t('pad.an.gate') %> <a href="/login?next=<%= encodeURIComponent('/p/' + room.slug) %>"><%- t('pad.signin') %></a></p>
      <% } %>
      <div class="an-foot"><a class="ab-btn" href="<%= analytics_ %>"><%- t('pad.an.full') %></a></div>
    </section>
    <% } %>
    <% if (feed_ && feed_.rules) { %><%- include('partials/pad-rules', { fx, rules: feed_.rules, slug: room.slug, canEdit: !!(feed_.mod.owner || feed_.mod.admin), open: true, id: 'rules' }) %><% } %>
    <% if (!siteOnly_) { %>
    <section class="card join" aria-labelledby="joinH">
      <h2 id="joinH"><%- t('pad.join.h') %></h2>
      <ol>
        <li><%- t('pad.join.step1', { link: '<a href="https://www.camfrog.com/" rel="noopener">' + t('pad.join.get_it') + '</a>' }) %></li>
        <li><%- t('pad.join.step2', { name: room.camfrogName || room.name }) %></li>
        <li><%- t('pad.join.step3', { cmd: '<code>!help</code>' }) %></li>
      </ol>
    </section>
    <% } %>
  </section>
  <script src="/public/js/pad-tabs.js?v=9"></script>
  <% if (!isOwner_ && giftSigned_) { %><script src="/public/js/pad-cosmetics.js?v=5" defer></script><% } %>
  <% if (typeof roomVault !== 'undefined' && roomVault) { %><script src="/public/js/pad-vault.js?v=2" defer></script><% } %>
  <script src="/public/js/pad-launch.js?v=1" defer></script>
  <% if (!siteOnly_ && adultGate_ === 'ok') { %><script src="/public/js/pad-challenges.js?v=1" defer></script><% } %>
  <script>
  // 1.99ef: the header's ⋯ menu - closes on an outside click / Esc / after a pick; "Copy link" copies the pad's address
  (function () {
    'use strict';
    var _t = typeof __t === 'function' ? __t : function (k, d, v) { return String(d).replace(/\{!?(\w+)\}/g, function (m, n) { return v && v[n] != null ? v[n] : m; }); };
    var m = document.getElementById('rmMore');
    if (!m) return;
    document.addEventListener('click', function (e) { if (m.open && !m.contains(e.target)) m.open = false; });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && m.open) { m.open = false; m.querySelector('summary').focus(); } });
    m.addEventListener('click', function (e) {
      var it = e.target.closest('[role="menuitem"]');
      if (!it) return;
      var path = it.getAttribute('data-copy-link');
      if (path) {
        var url = location.origin + path, done = function () { it.textContent = _t('js.pad.menu.copied', '✅ Link copied'); setTimeout(function () { it.textContent = _t('js.pad.menu.copy', '🔗 Copy link'); m.open = false; }, 1200); };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(url).then(done, function () { window.prompt(_t('js.pad.menu.copy_prompt', 'Copy this link'), url); });
        else window.prompt(_t('js.pad.menu.copy_prompt', 'Copy this link'), url);
        return;
      }
      m.open = false;
    });
  })();
  </script>
  <script>
  (function () {
    'use strict';
    if (!window.PATVPadTabs) return;
    PATVPadTabs.init(<%- JSON.stringify({ slug: room.slug, platform: PT_.camfrog ? 'camfrog' : (room.platform || 'site'), active: !!PT_.active, posts: PT_.posts || [], more: (PT_.posts || []).length >= 10,
                       account: typeof feedSeen !== 'undefined' && feedSeen && feedSeen.scope ? { scope: feedSeen.scope, upto: feedSeen.upto == null ? null : feedSeen.upto } : null,
                       ...(PT_.lineLive ? { lineLive: true } : {}) }).replace(/</g, '\\u003c') %>);<%# S1 V2: lineLive - the Live tab holds the chat hub's widget: a ?line= opens Live (pad-tabs.js) %>
  })();
  </script>
</main>
