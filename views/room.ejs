          <label class="bx-amt"><span class="sr"><%- t('pad.boost.sr') %></span><input type="text" name="amount" data-min="<%= BO_ ? BO_.min : 100 %>" data-max="<%= BO_ ? BO_.max : 1000000 %>" value="5000" inputmode="numeric" autocomplete="off" spellcheck="false" size="9" pattern="\s*(\d{1,3}(,\d{3})+|\d+(_\d+)*)?(\.\d+)?[kKmMbB]?\s*"> <small>PAT</small></label>
          <button type="submit" class="sact primary"><%- t('pad.boost.btn') %></button>
