      .plexq .pq-scrub { width: 100%; accent-color: var(--green, var(--ds-green)); min-height: 28px; }
      .plexq .pq-bar { height: 6px; background: #222; border-radius: 3px; overflow: hidden; }
      .plexq .pq-bar span { display: block; height: 100%; background: var(--green, var(--ds-green)); }
