  /* 1.99ec: About's analytics link is a real button */
  .rm .about .ab-btn { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; border: 1px solid #2f6b3a; background: #12301a;
                       color: #c8efcf !important; font-weight: bold; font-size: 13px; }
  .rm .about .ab-btn:hover, .rm .about .ab-btn:focus-visible { border-color: #4caf50; color: #fff !important; }
  /* 1.99el: About's Analytics card - headline tiles, then the button */
