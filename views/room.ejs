<%# 1.99es: the pad's look (padlook.js via app.locals): accent -> CSS custom properties on <main> (validated hex only),
    an uploaded banner inside the header (behind a scrim, its focal point as object-position), the avatar by the name.
    A pad with no look renders exactly as before (the old link banner above the header). %>
<% const LK_ = typeof padLook === 'function' ? padLook(room.id) : null;
   const avHtml_ = typeof padAv === 'function' ? padAv(room.id, { cls: 'rm-av', fallback: '' }) : '';
   // 1.99ew: premium pad cosmetics (padcosmetics.fx): frame on the header, glow on the name, badges by it; 🎁 gifting for non-owners
   const PFX_ = typeof padFx === 'function' ? padFx(room.id) : null;
   const isOwner_ = !!(room.ownerUser && typeof user !== 'undefined' && user && String(room.ownerUser).toLowerCase() === String(user).toLowerCase());
   const giftSigned_ = typeof signedIn !== 'undefined' ? !!signedIn : (typeof user !== 'undefined' && !!user); %>
<link rel="stylesheet" href="/public/css/padfx.css?v=1">
<main class="rm<%= LK_ && LK_.accent ? ' pad-acc' : '' %>"<% if (LK_ && LK_.vars) { %> style="<%= LK_.vars %>"<% } %>>
  <div class="crumb"><a href="/p">Pads</a> › p/<%= room.slug %></div>
  <% if (room.banner && !(LK_ && LK_.banner)) { %><img class="banner-img" src="<%= room.banner %>" alt="" loading="lazy" referrerpolicy="no-referrer"><% } %>
  <%# 1.99ef: the header is three zones - identity (left: name + LIVE, p/slug + quiet type tags, one description line),
      actions (right: Follow + the follower count as plain text, ⚙ settings with the moderation / approvals badge,
      ⋯ Rules / Pad analytics / Copy link) - and no status: who's in the room / Pepe is here is the Live tab's status
      line, "Camfrog room: X" is in About. %>
  <% const desc_ = (room.description || '').trim(), topic_ = (room.topic || '').trim();
     const sameTxt_ = (a, b) => a.replace(/\s+/g, ' ').toLowerCase() === b.replace(/\s+/g, ' ').toLowerCase();
     const fcount_ = feed_ && feed_.follow ? feed_.follow.followers : 0;
     const queue_ = feed_ && feed_.queue ? feed_.queue : 0, pending_ = schedule_ && schedule_.pending ? schedule_.pending : 0;
     const analytics_ = typeof roomAnalytics !== 'undefined' && roomAnalytics ? roomAnalytics : null;
     const psTitle_ = 'Pad settings: page, stage, feed, Pepe, rules, moderation' + (queue_ ? ' · ' + queue_ + ' waiting in Moderation' : '') + (pending_ ? ' · ' + pending_ + ' to approve' : ''); %>
  <section class="hero<%= LK_ && LK_.banner ? ' has-bn' : '' %><%= PFX_ && PFX_.cls ? ' ' + PFX_.cls : '' %>" aria-labelledby="rmTitle"><%- PFX_ ? PFX_.layer : '' %>
    <% if (LK_ && LK_.banner) { %><div class="hero-bn" aria-hidden="true"><img src="<%= LK_.banner %>" alt="" decoding="async"></div><% } %>
    <div class="hd">
      <div class="hd-id">
        <h1 id="rmTitle"><%- avHtml_ %><% if (PFX_ && PFX_.glow) { %><span class="rm-nm <%= PFX_.glow %>"><%= room.name %></span><% } else { %><%= room.name %><% } %><%- PFX_ ? PFX_.badges : '' %>
          <% if (!siteOnly_) { %><span class="live <%= room.live ? 'chat' : 'off' %>" id="rmLive" title="Is the Camfrog room active? (ON AIR on the stage = a video stream)"><span class="dot" aria-hidden="true"></span><span id="rmLiveTxt"><%= room.live ? '💬 ROOM ACTIVE' : 'ROOM OFFLINE' %></span></span><% } %>
        </h1>
        <div class="hd-ref"><div class="padref">p/<%= room.slug %></div><span class="hd-tags">
          <%- padBadge_(room.platform || (siteOnly_ ? 'site' : 'camfrog')) %>
          <% if (access_.level === 'approved') { %><span class="htag" title="Only members the owner approved can see this pad">🔒 Approved members</span><% } else if (access_.level === 'public') { %><span class="htag" title="Anyone can see this pad, signed in or not">🌐 Public</span><% } %>
          <% if (room.house) { %><span class="htag own" title="Run by Pepe">🐸 House pad</span><% } else if (room.owner) { %><a class="htag own" href="/u/<%= encodeURIComponent(room.ownerUser) %>">👑 Pad owner: <%= room.owner %></a><% } %>
        </span></div>
        <div class="topic" id="rmTopic" data-desc="<%= desc_ %>"><%= topic_ && !sameTxt_(topic_, desc_) ? topic_ : '' %></div>
        <% if (desc_) { %><div class="desc"><%= desc_ %></div><% } %>
      </div>
      <div class="hd-acts">
        <% if (feed_ && feed_.follow) { %><div class="hd-follow"><%- include('partials/follow-btn', { kind: 'room', id: feed_.room, following: feed_.follow.following, signed: !!feed_.viewer, next: '/p/' + encodeURIComponent(room.slug), fwTitle: 'Follow this pad' }) %>
          <span class="hd-fc" title="Follow this pad to get its posts on your Following feed"><b data-follower-count-kind="room" data-follower-count-id="<%= feed_.room %>"><%= fcount_.toLocaleString('en-US') %></b> follower<%= fcount_ === 1 ? '' : 's' %></span></div><% } %>
        <% if (manage_) { %><a class="ibtn ps-link" href="/p/<%= encodeURIComponent(room.slug) %>/settings<%= queue_ ? '#moderation' : '' %>" title="<%= psTitle_ %>" aria-label="<%= psTitle_ %>">⚙<% if (queue_ || pending_) { %><span class="ps-q" aria-hidden="true"><%= queue_ + pending_ %></span><% } %></a><% } %>
        <details class="hd-more" id="rmMore">
          <summary class="ibtn" aria-label="More: rules, analytics, share" title="More">⋯</summary>
          <div class="hd-menu" role="menu">
            <% if (feed_ && feed_.rules) { %><a role="menuitem" href="?tab=about#rules" data-pad-tab="about" data-open="rules">📜 Rules</a><% } %>
            <% if (analytics_) { %><a role="menuitem" href="<%= analytics_ %>">📈 Pad analytics</a><% } %>
            <button type="button" role="menuitem" data-copy-link="/p/<%= encodeURIComponent(room.slug) %>">🔗 Copy link</button>
            <% if (!isOwner_) { %><% if (giftSigned_) { %><button type="button" role="menuitem" data-pad-gift="<%= room.slug %>">🎁 Gift a cosmetic</button><% } else { %><a role="menuitem" href="/login?next=<%= encodeURIComponent('/p/' + room.slug + '?tab=about#gift') %>">🎁 Gift a cosmetic</a><% } %><% } %>
          </div>
        </details>
      </div>
    </div>
  </section>
  <% if (feed_ && (((feed_.caps || []).length) || ((feed_.storyRooms || []).length))) { %>
    <section class="card rm-story" aria-label="Fresh captures from this pad"><%- include('partials/story-strip', { story: { caps: feed_.caps, rooms: feed_.storyRooms || [], room: feed_.room, signed: !!feed_.viewer, compose: !!feed_.viewer }, heading: '📸 Fresh captures', next: '/p/' + encodeURIComponent(room.slug) }) %></section>
  <% } %>
  <nav class="ptabs" id="padTabs" role="tablist" aria-label="Pad sections">
    <% PT_.tabs.forEach((t) => { %><button type="button" class="ptab" role="tab" id="padTab-<%= t %>" data-tab="<%= t %>" aria-controls="padPanel-<%= t %>" aria-selected="<%= tabOn_(t) ? 'true' : 'false' %>" tabindex="<%= tabOn_(t) ? 0 : -1 %>">
      <% if (t === 'live') { %><span class="pdot" aria-hidden="true"<%= PT_.active ? '' : ' hidden' %>></span><%= liveLabel_ %><% } else if (t === 'feed') { %><span class="pnewdot" id="padFeedDot" aria-hidden="true" hidden></span>Feed <span class="pnew" id="padFeedNew" hidden></span><% } else { %>About<% } %></button><% }) %>
  </nav>
  <section class="ppanel" id="padPanel-live" role="tabpanel" aria-labelledby="padTab-live"<%= tabOn_('live') ? '' : ' hidden' %>>
  <%# 1.99ef: the room's live status (was header chips): who's in the Camfrog room, Pepe is here %>
  <% if (!siteOnly_) { const cfName_ = room.camfrogName || room.name; %><p class="lstat" id="rmStatus"><span id="rmStDot" aria-hidden="true"><%= room.live ? '🟢' : '⚪' %></span>
    <% if (bridged_) { %><span><b id="rmCount"><%= room.count %></b> in <b><%= cfName_ %></b></span><% } else { %><span>📡 Camfrog room <b><%= cfName_ %></b></span><% } %>
    <% if (pepeHere_ === true) { %><span class="ls-sep" aria-hidden="true">·</span><span title="Pepe is in the Camfrog room, so his stream is part of this pad's stage">🐸 Pepe is here</span><% } %></p><% } %>
  <% if (bridged_ && !siteOnly_) { %><div class="banner" role="note">📡 <b>Live from the Camfrog room — read-only (v1).</b> What the Camfrog room shows to anyone sitting in it: public chat, who's here, who's on the mic. 🎙 lines are what people said on the mic (auto-transcribed). Private messages are never shown, and anyone who turned on <code>!incognito</code> or typed <code>!bridge hide</code> in the room appears as "someone".</div><% } %>

<% { const st = stage || {}; const RS = roomStage_ || { slots: [], upcoming: [], queue: {} }; const pepeOn_ = !!st.active && pepeHere_ !== false; const live = pepeOn_ || RS.slots.length > 0;
     const fmtT = (ms) => new Date(ms).toISOString(); %>
  <link href="https://vjs.zencdn.net/8.3.0/video-js.css" rel="stylesheet" />
  <script src="https://vjs.zencdn.net/8.3.0/video.min.js" defer></script>
  <script src="/public/js/stage-player.js?v=8"></script>
  <%# 1.99et: ⚡ Low latency (WebRTC / WHEP) - only while the stage setting webrtc_enabled is on (webrtc.js) %>
  <% if (typeof locals.webrtcCfg === 'function' && locals.webrtcCfg()) { %><link rel="stylesheet" href="/public/css/webrtc.css?v=2">
  <script src="/public/js/webrtc-client.js?v=1"></script>
  <script src="/public/js/stage-lowlat.js?v=2"></script>
  <% } %><script src="/public/js/stage-room.js?v=7"></script>
  <link rel="stylesheet" href="/public/css/stagecap.css?v=1">
  <script src="/public/js/stage-capture.js?v=2"></script>
  <section class="card stage <%= live ? 'is-on' : 'is-off' %>" id="rmStage" aria-labelledby="rmStageH">
    <h2 id="rmStageH"><span>📺 <%= room.name %> stage</span>
      <span class="live<%= live ? '' : ' off' %>" id="rmStPill" style="font-family:Ubuntu,sans-serif"><span class="dot" aria-hidden="true"></span><span id="rmStPillTxt"><%= live ? 'ON AIR' : 'OFF AIR' %></span></span></h2>
    <div class="stabs" id="rmTabs" role="tablist" aria-label="Stage streams"></div>
    <div class="player">
      <div class="wrap" id="rmVideo"></div>
      <div class="reconnect hide" id="rmStReconnect" role="status"><span class="dot" aria-hidden="true"></span> Stream is starting / reconnecting…</div>
      <button type="button" class="unmute hide" id="rmStUnmute" aria-label="Unmute the stream"><img src="/public/img/mute-icon.png" alt=""></button>
      <div class="embed hide" id="rmEmbed"></div>
    </div>
    <div class="stcap hide" id="rmCap" aria-label="Snap or clip this stream"></div>
    <div class="off-air"><span id="rmOffTxt">Nothing on this stage right now — be the first: go live here.</span></div>
  </section>
  <%# 1.99ee: go live / slots / schedule are their own card under the stage card (the stage card is the player + Snap / Clip).
      🚀 Boost replaces "★ Get featured": featuring is earned (the front page's automatic ranking); a boost adds to this
      pad's score there (boosts.js). Only Camfrog pads can be on the front page, so only they show the button. %>
  <% const BO_ = RS.boost || null, canBoost_ = !siteOnly_ && (room.platform || 'camfrog') === 'camfrog', signedIn_ = typeof signedIn !== 'undefined' ? !!signedIn : (typeof user !== 'undefined' && !!user); %>
  <section class="card golive-card" id="rmGoLive" aria-labelledby="rmGoLiveH">
    <h2 id="rmGoLiveH" class="gl-h">🎬 Go live</h2>
    <div class="stage-bar">
      <span class="slots"><span id="rmSlotsTxt">🎬 <%= RS.open || 0 %>/<%= (RS.room && RS.room.slot_count) || 1 %> slot<%= ((RS.room && RS.room.slot_count) || 1) === 1 ? '' : 's' %> in use<%= RS.queue && RS.queue.length ? ' · ' + RS.queue.length + ' waiting' : '' %><%= RS.room && RS.room.slot_price ? ' · ' + Number(RS.room.slot_price).toLocaleString('en-US') + ' PAT/min' : ' · free slots' %></span><% if (canBoost_) { %><span class="boosted" id="rmBoostTxt"<%= BO_ && BO_.last_hour > 0 ? '' : ' hidden' %>> · 🚀 boosted · <b><%= BO_ ? Number(BO_.last_hour).toLocaleString('en-US') : 0 %></b> PAT in the last hour</span><% } %></span>
      <div class="stage-acts">
        <a class="sact primary" href="/stage?room=<%= encodeURIComponent(room.slug) %>">🎥 Go live here</a>
        <a class="sact" href="/stage?room=<%= encodeURIComponent(room.slug) %>#whenSet">📅 Book a slot</a>
        <% if (canBoost_) { %><% if (signedIn_) { %><button type="button" class="sact boost" id="rmBoostBtn" aria-expanded="false" aria-controls="rmBoostBox">🚀 Boost this pad</button><% } else { %><a class="sact boost" href="/login?next=<%= encodeURIComponent('/p/' + room.slug + '#boost') %>">🚀 Boost this pad</a><% } %><% } %>
      </div>
      <% if (canBoost_ && signedIn_) { %>
      <form class="boostbox" id="rmBoostBox" data-slug="<%= room.slug %>" hidden autocomplete="off">
        <p class="bx-what">Push <b><%= room.name %></b> up the front-page ranking. Boosts fade by half every hour and only count while people here are chatting or on the mic — they can tip a close race, not carry a quiet pad. Half goes to this pad's room vault, half to Fort Knox.<% if (!siteOnly_) { %> In the Camfrog room: <code>!boost 5000</code>.<% } %></p>
        <div class="bx-row">
          <span class="bx-presets" role="group" aria-label="Amount"><button type="button" data-amt="1000">1,000</button><button type="button" data-amt="5000">5,000</button><button type="button" data-amt="25000">25,000</button></span>
          <label class="bx-amt"><span class="sr">PAT to boost with</span><input type="number" name="amount" min="<%= BO_ ? BO_.min : 100 %>" max="<%= BO_ ? BO_.max : 1000000 %>" step="1" value="5000" inputmode="numeric"> <small>PAT</small></label>
          <button type="submit" class="sact primary">🚀 Boost</button>
        </div>
        <p class="bx-msg" id="rmBoostMsg" role="status" aria-live="polite"></p>
      </form>
      <% } %>
    </div>
    <% if (schedule_) { %><%- include('partials/room-schedule', { slug: room.slug, schedule: schedule_ }) %><% } %>
    <% if (!schedule_ && (RS.upcoming || []).length) { %>
      <ul class="upnext" aria-label="Coming up on this stage">
        <% RS.upcoming.forEach((u) => { %><li><time data-ts="<%= u.start_at %>" datetime="<%= fmtT(u.start_at) %>"><%= fmtT(u.start_at).slice(11, 16) %> UTC</time><b><%- UL(u.username, { text: u.display, user: true }) %></b><span class="muted"><%= u.minutes %> min<%= u.featured ? ' · ★ featured' : '' %><%= u.title ? ' · ' + u.title : '' %></span></li><% }) %>
      </ul>
    <% } %>
  </section>
  <% if (canBoost_ && signedIn_) { %><script src="/public/js/pad-boost.js?v=1" defer></script><% } %>
  <script>
  (function () {
    'use strict';
    var box = document.getElementById('rmStage');
    document.querySelectorAll('.upnext time[data-ts]').forEach(function (t) {
      var d = new Date(Number(t.getAttribute('data-ts')));
      t.textContent = d.toLocaleDateString(undefined, { weekday: 'short' }) + ' ' + d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
    });
    var padSlug = <%- JSON.stringify(room.slug).replace(/</g, '\\u003c') %>;
    // 1.99cr: Snap / Clip the stream that's showing (stage-capture.js; cut on the server, saved to this pad's story)
    var cap = PATVStage.capture({ host: document.getElementById('rmCap'), room: function () { return padSlug; } });
    PATVStage.switcher({
      tabs: document.getElementById('rmTabs'), wrap: document.getElementById('rmVideo'),
      reconnect: document.getElementById('rmStReconnect'), unmute: document.getElementById('rmStUnmute'), embedHost: document.getElementById('rmEmbed'),
      api: '/api/stage?room=' + encodeURIComponent(padSlug), onShow: function (sel) { cap.update(sel); },
      slots: <%- JSON.stringify(RS.slots || []).replace(/</g, '\\u003c') %>, pepeOn: <%= st.active ? 'true' : 'false' %>, pepeHere: <%= pepeHere_ === false ? 'false' : 'true' %>, pepeWhep: <%- JSON.stringify(st.whep || null).replace(/</g, '\\u003c') %>, pepeSrc: <%- JSON.stringify(st.pepe_src || null).replace(/</g, '\\u003c') %>, manage: <%= manage_ ? 'true' : 'false' %>,
      onAir: function (on) {
        box.classList.toggle('is-on', on); box.classList.toggle('is-off', !on);
        document.getElementById('rmStPill').className = 'live' + (on ? '' : ' off');
        document.getElementById('rmStPillTxt').textContent = on ? 'ON AIR' : 'OFF AIR';
      }
    });
  })();
  </script>
<% } %>
<% if (!bridged_ && !siteOnly_) { %>
  <section class="card"><p class="muted" style="margin:0">📡 Pepe isn't bridging this pad's Camfrog room to the website right now, so there's no live chat here — the stage and the feed still work. Join the Camfrog room to hang out.</p></section>
<% } %>

<% if (!bridged_ || siteOnly_) { %>
  <% if (feed_ || latest_.length) { %><%- include('partials/pad-latest', { latest: latest_, slug: room.slug, fx: typeof fx !== 'undefined' ? fx : null }) %><% } %>
<% } else if (!liveOpen_) { %>
  <section class="card tease">
    <div class="big" aria-hidden="true">🐸</div>
    <h2 style="justify-content:center">Sign in to watch the Camfrog room live</h2>
    <p class="muted">The Camfrog room's live chat, who's in it and who's on the mic are for signed-in PATV members.</p>
    <a class="btn" href="/login">Sign in</a>
    <p class="muted">No account? <a href="/register">Make one</a> — then link your Camfrog name with <code>!verify</code>.</p>
  </section>
  <% if (feed_ || latest_.length) { %><%- include('partials/pad-latest', { latest: latest_, slug: room.slug, fx: typeof fx !== 'undefined' ? fx : null }) %><% } %>
<% } else { %>
  <%- include('partials/room-dj', { slug: room.slug, linked: linked }) %>
  <div class="grid">
    <section class="card" aria-labelledby="chatH">
      <h2 id="chatH">Chat <small id="rmStatus" class="status" aria-live="polite"></small></h2>
      <div class="feed" id="rmFeed" role="log" aria-live="polite" aria-relevant="additions" tabindex="0" aria-label="Camfrog room chat"></div>
      <button class="jump" id="rmJump" type="button">New messages ↓</button>
      <div id="rmClip"></div><%# 1.99fp: ✂️ Clip chat + 🔊 mic clips (public/js/chat-clip.js) %>
      <div class="compose hide" id="rmCompose">
        <% if (!signedIn) { %>
          <p class="muted" style="margin:0">💬 This Camfrog room takes messages from the website. <a href="/login?next=<%= encodeURIComponent('/p/' + room.slug) %>">Sign in</a> and link your Camfrog name to join in.</p>
        <% } else if (!linked) { %>
          <p class="muted" style="margin:0">💬 This Camfrog room takes messages from the website. <b>Link your Camfrog name</b> first: type <code>!verify</code> in a room with Pepe.</p>
        <% } else { %>
          <div id="rmRelay"></div>
          <div id="rmPtt"></div>
        <% } %>
      </div>
    </section>
    <aside class="side">
      <%# 1.99co: the Manage panel - filled and shown by public/js/room-mod.js only when Pepe says this viewer moderates the room %>
      <section class="card pm" id="rmMod" hidden></section>
      <% if (feed_ || latest_.length) { %><%- include('partials/pad-latest', { latest: latest_, slug: room.slug, fx: typeof fx !== 'undefined' ? fx : null }) %><% } %>
      <section class="card" aria-labelledby="micH">
        <h2 id="micH"><span class="ht">On the mic</span></h2>
        <div class="mic" id="rmMic"></div>
        <div id="rmAudioBox" style="margin-top:10px"></div>
      </section>
      <section class="card" aria-labelledby="pplH">
        <h2 id="pplH"><span class="ht">In the Camfrog room</span> <small id="rmPplN"></small></h2>
        <ul class="people" id="rmPeople"></ul>
        <p class="muted" id="rmListNote" style="margin:8px 0 0"></p>
      </section>
    </aside>
  </div>
  <link rel="stylesheet" href="/public/css/room-bridge.css?v=4">
  <script src="/public/js/room-bridge.js?v=5"></script>
  <link rel="stylesheet" href="/public/css/quotes.css?v=1">
  <script src="/public/js/chat-clip.js?v=1"></script>
  <link rel="stylesheet" href="/public/css/room-mod.css?v=5">
  <script src="/public/js/room-mod.js?v=5"></script>
  <script id="rmInit" type="application/json"><%- JSON.stringify(initial).replace(/</g, '\\u003c') %></script>
  <script>
  (function () {
    'use strict';
    var slug = <%- JSON.stringify(room.slug).replace(/</g, '\\u003c') %>;
    var data = JSON.parse(document.getElementById('rmInit').textContent);
    var feedEl = document.getElementById('rmFeed'), jump = document.getElementById('rmJump');
    var cursor = 0, timer = null, fails = 0, lastPeople = '', lastMic = '';
    // 1.99fu: signed = the light ⋯ menu (View profile / Open cam / 💸 Tip) for every signed-in viewer, not just mods
    var roomMod = window.PATVRoom && PATVRoom.mod ? PATVRoom.mod(document.getElementById('rmMod'), slug, { dms: <%- JSON.stringify(dms_) %>, collapsible: true, signed: <%= signedIn ? 'true' : 'false' %> }) : null;
    var signedIn = <%= signedIn ? 'true' : 'false' %>;
    // the ⋯ button next to someone (the people list and, 1.99fu, the mic list): mods get their actions too
    function moreBtn(u, canCam, onMic) {
      var mg = el('button', 'pm-mg', '⋯'); mg.type = 'button';
      mg.title = 'Actions for ' + label(u); mg.setAttribute('aria-label', 'Actions for ' + label(u));
      mg.setAttribute('aria-haspopup', 'menu'); mg.setAttribute('data-login', u.login);
      mg.addEventListener('click', function () { roomMod.menu(u, mg, { cam: canCam ? function () { snapOpen(u); } : null, mic: !!onMic }); });
      return mg;
    }
    function wantsMore(u) { return !!(roomMod && (roomMod.active() || signedIn) && u && !u.self && !u.anon && u.login); }
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
    function hue(s) { var h = 0; for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 360; return h; }
    function avatar(u) {
      if (u && u.patv && u.patv.avatar) { var im = el('img', 'av'); im.src = u.patv.avatar; im.alt = ''; im.loading = 'lazy'; return im; }
      var d = el('span', 'av' + (!u || u.anon ? ' anon' : ''), !u || u.anon ? '?' : (u.display || u.login || '?').charAt(0).toUpperCase());
      if (u && !u.anon) d.style.background = 'hsl(' + hue(u.login || '') + ',55%,62%)';
      d.setAttribute('aria-hidden', 'true');
      return d;
    }
    function name(u) {
      if (!u || u.anon) return el('span', 'who', 'someone');
      var n;
      if (u.patv) { n = el('a', 'who'); n.href = '/u/' + encodeURIComponent(u.patv.username); n.textContent = u.display || u.login; }
      else n = el('span', 'who', u.display || u.login);
      if (u.patv && u.patv.style) { n.classList.add('cx-name'); n.style.cssText = u.patv.style; }
      if (u.self) n.title = 'Pepe'; else if (u.display && u.login && u.display.toLowerCase() !== u.login.toLowerCase()) n.title = u.login;
      return n;
    }
    function hhmm(ts) { var d = new Date(ts); return ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2); }
    function dur(ms) { var s = Math.round(ms / 1000); return s < 60 ? s + 's' : s < 3600 ? Math.round(s / 60) + 'm' : (s / 3600).toFixed(1) + 'h'; }
    function label(u) { return !u || u.anon ? 'someone' : (u.display || u.login); }

    function item(it) {
      if (it.k === 'msg' || it.k === 'tx') {
        var row = el('div', 'line' + (it.k === 'tx' ? ' tx' : '') + (it.u && it.u.self ? ' pepe' : ''));
        if (it.k === 'tx') row.title = 'Said on the mic (auto-transcribed)';
        // 1.99fp: what ✂️ Clip chat / 🔊 Clip read (public/js/chat-clip.js) - the server re-reads its own copy by id
        if (it.c) row.setAttribute('data-c', it.c);
        row.setAttribute('data-k', it.k); row.setAttribute('data-name', label(it.u)); row.setAttribute('data-text', it.text);
        if (it.k === 'tx' && it.id) row.setAttribute('data-tx', it.id);
        row.appendChild(avatar(it.u));
        var b = el('div', 'body');
        b.appendChild(name(it.u));
        b.appendChild(document.createTextNode(it.k === 'tx' ? '\u201c' + it.text + '\u201d' : it.text));
        var t = el('time', 'when', hhmm(it.ts)); t.dateTime = new Date(it.ts).toISOString();
        b.appendChild(t);
        row.appendChild(b);
        return row;
      }
      var txt = it.k === 'join' ? '→ ' + label(it.u) + ' joined'
        : it.k === 'leave' ? '← ' + label(it.u) + ' left'
        : it.k === 'mic' ? '🎙️ ' + label(it.u) + ' grabbed the mic'
        : it.k === 'unmic' ? '🎙️ ' + label(it.u) + ' dropped the mic' + (it.ms ? ' after ' + dur(it.ms) : '')
        : it.k === 'topic' ? '📌 topic: ' + it.text : null;
      if (!txt) return null;
      return el('div', 'sys' + (it.k === 'topic' ? ' topic' : ''), txt + ' · ' + hhmm(it.ts));
    }

    function nearBottom() { return feedEl.scrollHeight - feedEl.scrollTop - feedEl.clientHeight < 80; }
    function addFeed(items, first) {
      if (!items || !items.length) { if (first && !feedEl.childNodes.length) feedEl.appendChild(el('p', 'muted', 'Nothing said yet — it shows up here the moment someone talks.')); return; }
      var stick = first || nearBottom();
      if (feedEl.firstChild && feedEl.firstChild.tagName === 'P') feedEl.removeChild(feedEl.firstChild);
      var frag = document.createDocumentFragment();
      items.forEach(function (it) { var n = item(it); if (n) frag.appendChild(n); });
      feedEl.appendChild(frag);
      while (feedEl.childNodes.length > 300) feedEl.removeChild(feedEl.firstChild);
      if (stick) { feedEl.style.scrollBehavior = 'auto'; feedEl.scrollTop = feedEl.scrollHeight; feedEl.style.scrollBehavior = ''; jump.style.display = 'none'; }
      else jump.style.display = 'block';
    }
    jump.addEventListener('click', function () { feedEl.scrollTop = feedEl.scrollHeight; jump.style.display = 'none'; });
    feedEl.addEventListener('scroll', function () { if (nearBottom()) jump.style.display = 'none'; });
    // 1.99dx: the chat fills in while its tab is hidden (no height to scroll) - land on the newest line when it shows
    document.addEventListener('patv:padtab', function (e) {
      if (e.detail && e.detail.tab === 'live') { feedEl.style.scrollBehavior = 'auto'; feedEl.scrollTop = feedEl.scrollHeight; feedEl.style.scrollBehavior = ''; jump.style.display = 'none'; }
    });

    function renderRoom(d) {
      var r = d.room;
      var tpEl = document.getElementById('rmTopic'), tpTxt = (r.topic || '').trim(), norm = function (x) { return String(x || '').replace(/\s+/g, ' ').trim().toLowerCase(); };
      tpEl.textContent = norm(tpTxt) === norm(tpEl.getAttribute('data-desc')) ? '' : tpTxt;   // 1.99ef: no tagline that repeats the description
      document.getElementById('rmCount').textContent = r.count;
      document.getElementById('rmStDot').textContent = r.live ? '🟢' : '⚪';
      var live = document.getElementById('rmLive');
      live.classList.toggle('off', !r.live); live.classList.toggle('chat', !!r.live);
      document.getElementById('rmLiveTxt').textContent = r.live ? '💬 ROOM ACTIVE' : 'ROOM OFFLINE';
      var mk = JSON.stringify(d.mic) + (r.cams ? '1' : '0') + (roomMod ? roomMod.key() : '');
      if (mk !== lastMic) {
        lastMic = mk;
        var mic = document.getElementById('rmMic'); mic.textContent = '';
        if (!d.mic.length) mic.appendChild(el('p', 'muted', 'Nobody on the mic right now.'));
        d.mic.forEach(function (u) {
          var h = el('div', 'holder'); h.appendChild(avatar(u));
          var n = el('span', 'nm'); n.appendChild(name(u)); h.appendChild(n);
          var eq = el('span', 'eq'); eq.setAttribute('aria-label', 'talking');
          if (!reduce) { eq.appendChild(el('i')); eq.appendChild(el('i')); eq.appendChild(el('i')); } else eq.textContent = '🎙️';
          h.appendChild(eq);
          // 1.99fu: the same ⋯ menu as the people list (View profile / Open cam / 💸 Tip; mods: their actions)
          if (wantsMore(u)) h.appendChild(moreBtn(u, !!(r.cams && u.on_cam), true));
          mic.appendChild(h);
        });
      }
      var pk = JSON.stringify(d.members) + (r.cams ? '1' : '0') + (roomMod ? roomMod.key() : '');
      if (pk !== lastPeople) {
        lastPeople = pk;
        var ul = document.getElementById('rmPeople'); ul.textContent = '';
        var ms = d.members.slice().sort(function (a, b) {
          return (b.self ? 1 : 0) - (a.self ? 1 : 0) || (b.on_mic ? 1 : 0) - (a.on_mic ? 1 : 0) || (b.on_cam ? 1 : 0) - (a.on_cam ? 1 : 0)
            || (a.anon ? 1 : 0) - (b.anon ? 1 : 0) || label(a).localeCompare(label(b));
        });
        ms.forEach(function (u) {
          var li = el('li'); li.appendChild(avatar(u));
          var n = el('span', 'nm'); n.appendChild(name(u));
          if (u.src === 'seen') n.appendChild(el('small', null, 'recently'));
          li.appendChild(n);
          var ic = el('span', 'ic');
          var cam;
          if (r.cams && u.on_cam && !u.self && !u.anon && u.login) {
            cam = el('button', 'cam', '📷'); cam.type = 'button';
            cam.title = 'Ask Pepe for a snapshot of ' + label(u) + '\'s cam';
            cam.setAttribute('aria-label', 'Snapshot of ' + label(u) + '\'s cam');
            (function (who) { cam.addEventListener('click', function () { snapOpen(who); }); })(u);
          } else {
            cam = el('span', u.on_cam ? '' : 'off', '📷'); cam.title = u.on_cam ? 'On cam' : (u.on_cam === false ? 'Off cam' : 'Cam unknown');
          }
          ic.appendChild(cam);
          // 1.99dx: moderators (Pepe sent caps for this viewer) get a ⋯ menu next to the cam icon: the actions
          // Pepe allows them on this person (room-mod.js menuItems; the server re-checks every one). The name
          // itself stays the link to the person's profile. 1.99fu: every signed-in viewer gets the ⋯ too - the light
          // menu (View profile / Open cam / 💸 Tip); mods keep their moderation actions in it.
          if (wantsMore(u)) ic.appendChild(moreBtn(u, !!(r.cams && u.on_cam), false));
          var m = el('span', u.on_mic ? '' : 'off', '🎙️'); m.title = u.on_mic ? 'On the mic' : 'Not on the mic'; ic.appendChild(m);
          li.appendChild(ic); ul.appendChild(li);
        });
        document.getElementById('rmPplN').textContent = d.members.length ? '(' + d.members.length + ')' : '';
      }
      // every render, not only when the people change: "checked 3 min ago" has to keep counting
      var note = listNote(r), noteEl = document.getElementById('rmListNote');
      if (noteEl.textContent !== note) noteEl.textContent = note;
    }

    // How far the roster can be trusted. Pepe re-reads each room's participant list every minute or
    // so; when he can't (the list is stale), he only keeps people seen arriving / talking / on the
    // mic within seenTtl and drops the rest - so say which of the two the list on screen is.
    function mins(ms) { var m = Math.max(0, Math.round(ms / 60000)); return m < 120 ? m + ' min' : Math.round(m / 60) + ' h'; }
    function listNote(r) {
      var ttl = mins(r.seenTtl || 15 * 60000), staleAfter = r.listStaleAfter || 10 * 60000;
      var age = r.listAt ? Date.now() - r.listAt : null;
      var fresh = age != null && age < staleAfter && r.listFresh !== false;
      if (fresh) {
        return 'From the room\'s participant list, checked ' + (age < 60000 ? 'just now' : mins(age) + ' ago')
          + ' (' + hhmm(r.listAt) + '). "recently" = arrived or active since that check.';
      }
      if (age != null) {
        return 'List not checked for ' + mins(age) + ' — showing people active in the last ' + ttl + '.';
      }
      return 'Pepe can\'t read this room\'s participant list right now — showing people seen arriving or active in the last ' + ttl + '.';
    }

    var roomAudio = PATVRoom.audio(document.getElementById('rmAudioBox'), slug);
    var chatClip = window.PATVChatClip ? PATVChatClip.init({ feed: feedEl, host: document.getElementById('rmClip'), slug: slug, linked: <%= linked ? 'true' : 'false' %> }) : null;   // 1.99fp
    var relayHost = document.getElementById('rmRelay'), roomRelay = relayHost ? PATVRoom.relay(relayHost, slug) : null;
    // ── cam snapshot popover (click the 📷 of someone on cam) ──
    var snapEl = null, snapTimer = null, snapWho = null;
    function snapClose() { clearTimeout(snapTimer); clearTimeout(saveTimer); clearTimeout(clipTimer); if (snapEl) snapEl.remove(); snapEl = null; snapWho = null; }
    function snapBox(text) {
      if (!snapEl) {
        snapEl = el('div', 'snap'); snapEl.setAttribute('role', 'dialog'); snapEl.setAttribute('aria-label', 'Cam snapshot');
        document.querySelector('.rm').appendChild(snapEl);
      }
      snapEl.textContent = '';
      var top = el('div', 'row'); top.appendChild(el('b', null, '📷 ' + label(snapWho)));
      var x = el('button', null, 'Close'); x.type = 'button'; x.addEventListener('click', snapClose); top.appendChild(x);
      snapEl.appendChild(top);
      if (text) snapEl.appendChild(el('div', 'muted', text));
      return snapEl;
    }
    function snapShow(s) {
      var box = snapBox(s.state === 'ok' ? null : (s.status || 'No picture.'));
      if (s.state === 'ok' && s.img) {
        var im = el('img'); im.alt = label(snapWho) + '\'s cam'; im.src = s.img; box.appendChild(im);
      }
      var row = el('div', 'row');
      var t = new Date(s.ts || Date.now());
      row.appendChild(el('span', null, 'taken ' + ('0' + t.getHours()).slice(-2) + ':' + ('0' + t.getMinutes()).slice(-2) + ':' + ('0' + t.getSeconds()).slice(-2)));
      var rf = el('button', null, 'Refresh'); rf.type = 'button'; rf.addEventListener('click', function () { snapOpen(snapWho, true); }); row.appendChild(rf);
      box.appendChild(row);
      // Save snap (1.99ap): only when the !snap rules let this viewer snap them (the server decides;
      // `save` is null otherwise, and then there's no Download either).
      if (s.state === 'ok' && s.img && s.save) snapSaveRow(box, s);
      // 1.99dr: "✨ Use in Generate" - this frame as the composer's AI reference picture (aigen.js claimCamRef:
      // priced like chat's -cam, the person's opt-out and the room's switches re-checked, never stored)
      if (s.state === 'ok' && s.img && s.gen) snapGenRow(box, s);
      // 1.99ez: 🎬 Clip - Pepe records 10 / 20 / 30 s of this cam (camclip.js); a free preview, pay only to save it
      if (s.state === 'ok' && s.img && s.clip) snapClipRow(box, s);
    }
    var clipTimer = null;
    function snapClipRow(box, s) {
      var who = snapWho, acts = el('div', 'acts'), res = el('div', 'res'), vid = el('div');
      res.setAttribute('role', 'status'); res.setAttribute('aria-live', 'polite');
      var b = el('button', 'clip', '🎬 Clip'); b.type = 'button';
      var sel = el('select', 'clip-secs'); sel.setAttribute('aria-label', 'Clip length');
      (s.clip.secs || [10, 20, 30]).forEach(function (n) { var o = el('option', null, n + ' s'); o.value = n; if (n === s.clip.def) o.selected = true; sel.appendChild(o); });
      b.title = s.clip.off || s.clip.hint || ('Pepe records ' + label(who) + '\'s cam - you see it first and only pay if you save it');
      if (s.clip.off) { b.disabled = true; sel.disabled = true; }
      acts.appendChild(b); acts.appendChild(sel);
      box.appendChild(acts); box.appendChild(vid); box.appendChild(res);
      if (s.clip.off) { res.textContent = s.clip.off; }
      else if (s.clip.hint) { res.className = 'res hint'; res.textContent = s.clip.hint; }   // 1.99fb: an admin while !clip is off
      function say(text, cls, href) {
        res.className = 'res' + (cls ? ' ' + cls : ''); res.textContent = text;
        if (href) { var a = el('a', null, 'Open it ›'); a.href = href; res.appendChild(document.createTextNode(' ')); res.appendChild(a); }
      }
      function alive() { return snapWho === who && res.isConnected; }
      var base = '/api/rooms/' + encodeURIComponent(slug) + '/camclip/';
      function post(url, body) {
        return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' }, body: JSON.stringify(body || {}) })
          .then(function (r) { return r.json(); });
      }
      function watchSave(id, n) {
        clearTimeout(clipTimer);
        fetch(base + encodeURIComponent(id) + '/save', { credentials: 'same-origin', cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (a) {
          if (!alive()) return;
          if (a.status === 'done') return say('Saved to the pad\'s story.', 'ok', a.url || null);
          if (a.status === 'failed') return say(a.message ? a.message.charAt(0).toUpperCase() + a.message.slice(1) + '.' : 'Pepe couldn\'t save it.', 'bad');
          if (n > 60) return say('Pepe hasn\'t answered yet - check the pad\'s story in a minute.');
          clipTimer = setTimeout(function () { watchSave(id, n + 1); }, 1500);
        }).catch(function () { if (alive()) say('Couldn\'t reach the site.', 'bad'); });
      }
      function ready(c) {
        vid.textContent = '';
        var v = el('video'); v.controls = true; v.playsInline = true; v.setAttribute('playsinline', ''); v.preload = 'metadata';
        if (c.poster) v.poster = c.poster;
        v.src = c.video; vid.appendChild(v);
        var row = el('div', 'acts');
        if (c.save) {
          var sv = el('button', 'save', '💾 Save clip' + (c.save.cost ? ' · ' + Number(c.save.cost).toLocaleString() + ' PAT' : ''));
          sv.type = 'button'; sv.title = 'Put this clip in the pad\'s story as a !clip by you' + (c.save.cost ? ' (' + Number(c.save.cost).toLocaleString() + ' PAT, like !clip)' : '');
          sv.addEventListener('click', function () {
            sv.disabled = true; say('Sending to Pepe…');
            post(base + encodeURIComponent(c.id) + '/save', {}).then(function (d) {
              if (!alive()) return;
              if (!d.ok) { sv.disabled = false; return say(d.error || 'Not right now.', 'bad'); }
              say('Pepe is saving it…'); watchSave(c.id, 0);
            }).catch(function () { sv.disabled = false; say('Couldn\'t reach the site.', 'bad'); });
          });
          row.appendChild(sv);
          if (c.save.id) { sv.disabled = true; watchSave(c.id, 0); }
        }
        var dc = el('button', null, 'Discard'); dc.type = 'button';
        dc.addEventListener('click', function () { post(base + encodeURIComponent(c.id) + '/discard', {}).then(function () { if (alive()) { vid.textContent = ''; row.remove(); say('Discarded.'); b.disabled = false; sel.disabled = false; } }); });
        row.appendChild(dc);
        vid.appendChild(row);
        if (!c.save) say(c.saveRule === 'no' ? 'They\'ve opted out - this clip can\'t be saved.' : 'Only you see this preview. You can\'t save clips of them here.');
        else if (!c.save.id) say('Only you see this preview (for 10 minutes). Save it to put it in the pad\'s story.');
      }
      function poll(id, n) {
        clearTimeout(clipTimer);
        fetch(base + encodeURIComponent(id), { credentials: 'same-origin', cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (c) {
          if (!alive()) return;
          if (!c.ok) { b.disabled = false; sel.disabled = false; return say(c.error || 'That clip is gone.', 'bad'); }
          if (c.state === 'ready') return ready(c);
          if (c.state === 'failed' || c.state === 'expired') { b.disabled = false; sel.disabled = false; return say(c.status ? c.status.charAt(0).toUpperCase() + c.status.slice(1) : 'Pepe couldn\'t clip that cam.', 'bad'); }
          say(c.state === 'recording' ? '🔴 Pepe is recording ' + c.secs + ' s…' : c.state === 'encoding' ? 'Encoding the clip…' : 'Asking Pepe to record…');
          if (n > 200) return say('Pepe hasn\'t finished yet - try again later.', 'bad');
          clipTimer = setTimeout(function () { poll(id, n + 1); }, 1500);
        }).catch(function () { if (alive()) clipTimer = setTimeout(function () { poll(id, n + 1); }, 3000); });
      }
      b.addEventListener('click', function () {
        b.disabled = true; sel.disabled = true; vid.textContent = ''; say('Asking Pepe to record…');
        post('/api/rooms/' + encodeURIComponent(slug) + '/camclip', { login: who.login, secs: Number(sel.value) }).then(function (d) {
          if (!alive()) return;
          if (!d.ok) { if (d.id) return poll(d.id, 0); b.disabled = false; sel.disabled = false; return say(d.error || 'Not right now.', 'bad'); }
          poll(d.id, 0);
        }).catch(function () { b.disabled = false; sel.disabled = false; say('Couldn\'t reach the site.', 'bad'); });
      });
      if (typeof s.clip.busy === 'string') { b.disabled = true; sel.disabled = true; poll(s.clip.busy, 0); }
      else if (s.clip.busy) { b.disabled = true; sel.disabled = true; say('Pepe is already clipping their cam - try again in a bit.'); }
    }
    function snapGenRow(box, s) {
      var who = snapWho, acts = el('div', 'acts'), res = el('div', 'res');
      res.setAttribute('role', 'status'); res.setAttribute('aria-live', 'polite');
      var g = el('button', 'gen', '✨ Use in Generate'); g.type = 'button';
      g.title = 'Make an AI picture or video from this frame (Pepe\'s !imagine / !video, priced like -cam in chat)';
      acts.appendChild(g); box.appendChild(acts); box.appendChild(res);
      g.addEventListener('click', function () {
        g.disabled = true; res.className = 'res'; res.textContent = 'Getting it ready…';
        fetch('/api/feed/aigen/camref', { method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' }, body: JSON.stringify({ pad: slug, sid: s.gen.sid }) })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (snapWho !== who || !res.isConnected) return;
            g.disabled = false;
            if (!d.ok) { res.className = 'res bad'; res.textContent = d.error || 'Not right now.'; return; }
            var c = { id: d.id, display: d.display, room: d.room, img: s.img, until: d.until };
            if (document.getElementById('fcGen')) {
              document.dispatchEvent(new CustomEvent('patv:gen-cam', { detail: c }));
              snapClose();
            } else {
              // no composer on this page (signed-out view, feed off): hand it to /feed's composer
              try { sessionStorage.setItem('patvGenCam', JSON.stringify(c)); } catch (e) { /* too big / blocked */ }
              location.href = '/feed';
            }
          }).catch(function () { g.disabled = false; res.className = 'res bad'; res.textContent = 'Couldn\'t reach the site.'; });
      });
    }
    var saveTimer = null;
    function snapSaveRow(box, s) {
      var who = snapWho, acts = el('div', 'acts'), res = el('div', 'res');
      res.setAttribute('role', 'status'); res.setAttribute('aria-live', 'polite');
      var sv = el('button', 'save', '💾 Save snap' + (s.save.cost ? ' · ' + Number(s.save.cost).toLocaleString() + ' PAT' : ''));
      sv.type = 'button';
      sv.title = 'Post this frame to the feed as a !snap by you' + (s.save.cost ? ' (' + Number(s.save.cost).toLocaleString() + ' PAT, like !snap)' : '');
      var dl = el('a', 'dl', '⬇ Download');
      var t = new Date(s.ts || Date.now());
      dl.href = s.img;
      dl.download = 'snap-' + String(who.login || 'cam').replace(/[^A-Za-z0-9._-]+/g, '_') + '-' + t.getFullYear() + ('0' + (t.getMonth() + 1)).slice(-2) + ('0' + t.getDate()).slice(-2)
        + '-' + ('0' + t.getHours()).slice(-2) + ('0' + t.getMinutes()).slice(-2) + ('0' + t.getSeconds()).slice(-2) + '.jpg';
      acts.appendChild(sv); acts.appendChild(dl);
      box.appendChild(acts); box.appendChild(res);
      function say(text, cls, href) {
        res.className = 'res' + (cls ? ' ' + cls : ''); res.textContent = text;
        if (href) { var a = el('a', null, 'Open it on the feed ›'); a.href = href; res.appendChild(document.createTextNode(' ')); res.appendChild(a); }
      }
      function watch(id, n) {
        clearTimeout(saveTimer);
        fetch('/api/rooms/' + encodeURIComponent(slug) + '/snap/save/' + encodeURIComponent(id), { credentials: 'same-origin', cache: 'no-store' })
          .then(function (r) { return r.json(); })
          .then(function (a) {
            if (snapWho !== who || !res.isConnected) return;
            if (a.status === 'done') { sv.textContent = '💾 Saved'; return say('Saved as your snap.', 'ok', a.url || null); }
            if (a.status === 'failed') { sv.disabled = false; return say(a.message ? a.message.charAt(0).toUpperCase() + a.message.slice(1) + '.' : 'Pepe couldn\'t save it.', 'bad'); }
            if (n > 40) { return say('Pepe hasn\'t answered yet — check the feed in a minute.', null); }
            saveTimer = setTimeout(function () { watch(id, n + 1); }, 1500);
          }).catch(function () { if (res.isConnected) say('Couldn\'t reach the site.', 'bad'); sv.disabled = false; });
      }
      sv.addEventListener('click', function () {
        sv.disabled = true; say('Sending to Pepe…');
        fetch('/api/rooms/' + encodeURIComponent(slug) + '/snap/save', { method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' }, body: JSON.stringify({ sid: s.save.sid }) })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (snapWho !== who || !res.isConnected) return;
            if (!d.ok) { sv.disabled = false; return say(d.error || 'Not right now.', 'bad'); }
            say('Pepe is saving it…'); watch(d.id, 0);
          }).catch(function () { sv.disabled = false; say('Couldn\'t reach the site.', 'bad'); });
      });
      if (s.save.id) { sv.disabled = true; say('Checking your save…'); watch(s.save.id, 0); }
    }
    function snapPoll(who, n) {
      fetch('/api/rooms/' + encodeURIComponent(slug) + '/snap/' + encodeURIComponent(who.login), { credentials: 'same-origin', cache: 'no-store' })
        .then(function (r) { return r.json(); })
        .then(function (s) {
          if (snapWho !== who) return;
          if (s.state === 'ok' || s.state === 'refused') return snapShow(s);
          if (n > 30) return snapBox('Pepe didn\'t get a picture in time — try again in a bit.');
          snapTimer = setTimeout(function () { snapPoll(who, n + 1); }, 1500);
        }).catch(function () { snapBox('Couldn\'t reach the site.'); });
    }
    function snapOpen(who, refresh) {
      clearTimeout(snapTimer); clearTimeout(saveTimer);
      snapWho = who;
      snapBox('Asking Pepe to open ' + label(who) + '\'s cam…');
      fetch('/api/rooms/' + encodeURIComponent(slug) + '/snap', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ login: who.login }) })
        .then(function (r) { return r.json().then(function (d) { return { st: r.status, d: d }; }); })
        .then(function (x) {
          if (snapWho !== who) return;
          if (!x.d.ok) return snapBox(x.d.error || 'Not right now.');
          snapPoll(who, 0);
        }).catch(function () { snapBox('Couldn\'t reach the site.'); });
    }
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') snapClose(); });

    // ── talk to the room (relayed by Pepe): text relay + hold-to-talk clips (public/js/room-bridge.js) ──
    var compose = document.getElementById('rmCompose'),
        pttHost = document.getElementById('rmPtt'), roomPtt = pttHost ? PATVRoom.ptt(pttHost, slug) : null;
    function renderCompose(d) {
      var r = d.room;
      compose.classList.toggle('hide', !(r.relay || r.micRelay));
      if (roomRelay) roomRelay.update(d);
      if (roomPtt) roomPtt.update(d);
    }

    function apply(d, first) {
      if (roomMod) roomMod.update(d);          // before the people list: it adds the manage buttons
      renderRoom(d);
      renderCompose(d);
      roomAudio.update(d);
      if (d.cursor < cursor) { feedEl.textContent = ''; cursor = 0; first = true; }   // the site restarted
      addFeed(d.feed, first);
      if (chatClip) chatClip.update(d);
      cursor = Math.max(cursor, d.cursor);
    }

    function poll() {
      timer = null;
      if (document.hidden) return;
      fetch('/api/rooms/' + encodeURIComponent(slug) + '/live?after=' + cursor, { credentials: 'same-origin', cache: 'no-store' })
        .then(function (r) { if (r.status === 401) { location.href = '/login'; throw new Error('signed out'); } if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
        .then(function (d) { fails = 0; setStatus(''); apply(d, false); })
        .catch(function () { fails++; setStatus(fails > 2 ? 'reconnecting…' : '', fails > 2); })
        .then(function () { schedule(); });
    }
    function setStatus(t, err) { var s = document.getElementById('rmStatus'); s.textContent = t; s.classList.toggle('err', !!err); }
    function schedule() { if (!timer && !document.hidden) timer = setTimeout(poll, fails ? Math.min(15000, 1500 * Math.pow(2, fails)) : 1500); }
    document.addEventListener('visibilitychange', function () { if (!document.hidden) { clearTimeout(timer); timer = null; poll(); } });

    apply(data, true);
    schedule();
  })();
  </script>
<% } %>
  </section>
<% if (feed_) { %>
  <section class="ppanel" id="padPanel-feed" role="tabpanel" aria-labelledby="padTab-feed"<%= tabOn_('feed') ? '' : ' hidden' %>>
    <div class="fcol"><%- include('partials/room-feed', { feed: feed_, fx, embeds, host, room, noStory: true, noRules: true }) %></div>
  </section>
<% } %>
  <section class="ppanel about" id="padPanel-about" role="tabpanel" aria-labelledby="padTab-about"<%= tabOn_('about') ? '' : ' hidden' %>>
    <section class="card" aria-labelledby="abH">
      <h2 id="abH"><span>ℹ️ About p/<%= room.slug %></span></h2>
      <% if (room.description) { %><div class="desc"><%= room.description %></div><% } else { %><p class="muted" style="margin:0">No description yet.</p><% } %>
      <dl>
        <dt>Pad</dt><dd><%= room.name %> · <%- padBadge_(room.platform || (siteOnly_ ? 'site' : 'camfrog')) %></dd>
        <dt>Run by</dt><dd><% if (room.house) { %>🐸 Pepe (a house pad)<% } else if (room.owner) { %><a href="/u/<%= encodeURIComponent(room.ownerUser) %>">👑 <%= room.owner %></a><% } else { %><span class="muted">Nobody yet</span><% } %></dd>
        <% if (feed_ && feed_.follow) { %><dt>Followers</dt><dd><%= feed_.follow.followers.toLocaleString('en-US') %></dd><% } %>
        <% if (!siteOnly_) { %><dt>Camfrog room</dt><dd><%= room.camfrogName || room.name %></dd><% } %>
        <% if (manage_) { %><dt>Settings</dt><dd><a href="/p/<%= encodeURIComponent(room.slug) %>/settings">⚙ Pad settings ›</a></dd><% } %>
      </dl>
    </section>
    <%# 1.99ew: 🎁 gift a premium cosmetic to this pad (padcosmetics.js, public/js/pad-cosmetics.js); the owner buys from ⚙ settings %>
    <section class="card ab-gift" id="gift" aria-labelledby="giftH">
      <h2 id="giftH"><span>🎁 Pad cosmetics</span></h2>
      <% if (isOwner_) { %>
        <p class="muted" style="margin:0">Frames, name glows, badges and an animated avatar for your pad: <a href="/p/<%= encodeURIComponent(room.slug) %>/settings#cosmetics">✨ Cosmetics in your pad's settings ›</a></p>
      <% } else { %>
        <p class="muted" style="margin:0 0 10px">Treat <b><%= room.name %></b> to a banner frame, a name glow or a badge. Half of what you pay goes to this pad's room vault, half to Fort Knox. The owner can equip it or decline it — gifts are never refunded.</p>
        <% if (giftSigned_) { %><button type="button" class="ab-btn" data-pad-gift="<%= room.slug %>">🎁 Gift a cosmetic</button><% } else { %><a class="ab-btn" href="/login?next=<%= encodeURIComponent('/p/' + room.slug + '?tab=about#gift') %>">🎁 Sign in to gift a cosmetic</a><% } %>
      <% } %>
    </section>
    <%# 1.99el: Analytics is its own card (was an "Analytics: Pad analytics ›" row above): the 30-day headline numbers
        from roomstats.preview (cached), for signed-in viewers only - visitors get the analytics page's sign-in prompt %>
    <% const anCard_ = typeof roomAnalyticsCard !== 'undefined' && roomAnalyticsCard ? roomAnalyticsCard : null;
       const anSigned_ = liveOpen_;      // 1.99fu: members-tier - signed in, or anyone on a Public pad
       const anS_ = anCard_ && anSigned_ ? anCard_.stats : null; %>
    <% if (analytics_) { %>
    <section class="card an-card" aria-labelledby="anH">
      <h2 id="anH"><span>📈 Analytics</span><small>last 30 days</small></h2>
      <% if (anS_) { %>
      <div class="an-tiles">
        <div class="an-t"><div class="k">Messages</div><div class="v"><%= anS_.msgs30 %></div><div class="s"><% if (anS_.msgsTrend != null) { %><span class="<%= anS_.msgsTrend >= 0 ? 'up' : 'down' %>"><%= anS_.msgsTrend >= 0 ? '▲' : '▼' %> <%= Math.abs(anS_.msgsTrend) %>%</span> on the month before<% } else { %>public chat<% } %></div></div>
        <div class="an-t"><div class="k">Visitors</div><div class="v"><%= anS_.uniq30 %></div><div class="s">different people</div></div>
        <div class="an-t"><div class="k">Mic time</div><div class="v"><%= anS_.mic30 %></div><div class="s">on the mic</div></div>
        <div class="an-t"><div class="k">Typical size</div><div class="v"><%= anS_.typical %></div><div class="s"><%= anS_.typicalNote %><% if (anS_.peakSize) { %> · peak <%= anS_.peakSize %><% } %></div></div>
        <div class="an-t an-wide"><div class="k">Busiest</div><div class="v sm"><%= anS_.peak %></div><div class="s">by messages</div></div>
      </div>
      <% } else if (!anSigned_) { %>
      <p class="an-gate">🔒 Pad analytics are for signed-in members, like the live Camfrog room chat. <a href="/login?next=<%= encodeURIComponent('/p/' + room.slug) %>">Sign in</a></p>
      <% } %>
      <div class="an-foot"><a class="ab-btn" href="<%= analytics_ %>">See full analytics ›</a></div>
    </section>
    <% } %>
    <% if (feed_ && feed_.rules) { %><%- include('partials/pad-rules', { fx, rules: feed_.rules, slug: room.slug, canEdit: !!(feed_.mod.owner || feed_.mod.admin), open: true, id: 'rules' }) %><% } %>
    <% if (!siteOnly_) { %>
    <section class="card join" aria-labelledby="joinH">
      <h2 id="joinH">Join the Camfrog room</h2>
      <ol>
        <li>Open Camfrog (<a href="https://www.camfrog.com/" rel="noopener">get it here</a>) and sign in.</li>
        <li>Open the <b>Room List</b> and search for <b><%= room.camfrogName || room.name %></b>.</li>
        <li>Say hi — Pepe answers <code>!help</code>.</li>
      </ol>
    </section>
    <% } %>
  </section>
  <script src="/public/js/pad-tabs.js?v=4"></script>
  <% if (!isOwner_ && giftSigned_) { %><script src="/public/js/pad-cosmetics.js?v=1" defer></script><% } %>
  <script>
  // 1.99ef: the header's ⋯ menu - closes on an outside click / Esc / after a pick; "Copy link" copies the pad's address
  (function () {
    'use strict';
    var m = document.getElementById('rmMore');
    if (!m) return;
    document.addEventListener('click', function (e) { if (m.open && !m.contains(e.target)) m.open = false; });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && m.open) { m.open = false; m.querySelector('summary').focus(); } });
    m.addEventListener('click', function (e) {
      var it = e.target.closest('[role="menuitem"]');
      if (!it) return;
      var path = it.getAttribute('data-copy-link');
      if (path) {
        var url = location.origin + path, done = function () { it.textContent = '✅ Link copied'; setTimeout(function () { it.textContent = '🔗 Copy link'; m.open = false; }, 1200); };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(url).then(done, function () { window.prompt('Copy this link', url); });
        else window.prompt('Copy this link', url);
        return;
      }
      m.open = false;
    });
  })();
  </script>
  <script>
  (function () {
    'use strict';
    if (!window.PATVPadTabs) return;
    PATVPadTabs.init(<%- JSON.stringify({ slug: room.slug, platform: PT_.camfrog ? 'camfrog' : (room.platform || 'site'), active: !!PT_.active, posts: PT_.posts || [], more: (PT_.posts || []).length >= 10,
                       account: typeof feedSeen !== 'undefined' && feedSeen && feedSeen.scope ? { scope: feedSeen.scope, upto: feedSeen.upto == null ? null : feedSeen.upto } : null }).replace(/</g, '\\u003c') %>);
  })();
  </script>
</main>
