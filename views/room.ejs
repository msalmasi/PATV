    <style>
      .plexq { margin: 10px 0 4px; padding: 10px 12px; border: 1px solid #1f3a20; background: rgba(76,175,80,.08); border-radius: 10px; display: grid; gap: 8px; min-width: 0; overflow-wrap: anywhere; }
