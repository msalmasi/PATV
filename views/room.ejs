  .rm .snap .lc-badge { position: absolute; left: 8px; top: 8px; background: rgba(0,0,0,.65); color: #ddd; font-size: 11.5px; padding: 2px 7px; border-radius: 999px; }
  .rm .snap .lc-badge.on { background: #b3261e; color: #fff; font-weight: bold; letter-spacing: .04em; }
  .rm .snap .lc-x { position: absolute; right: 8px; top: 8px; min-width: 32px; min-height: 32px; background: rgba(0,0,0,.65); color: #fff; border-radius: 999px; }
  .rm .snap button.lc-audio { margin-top: 6px; }
  /* CL3: the 📜 / 🔍 chip in the chat's heading */
  .rm h2 .hist-chip { margin-inline-start: auto; font-family: var(--ds-font); letter-spacing: 0; text-transform: none; font-size: var(--ds-fs-xs);
                      text-decoration: none; color: var(--ds-text-muted); white-space: nowrap; }
  .rm h2 .hist-chip:hover { color: var(--ds-text); }
  .rm h2 .hist-chip .off { text-decoration: line-through; opacity: .7; }
  /* CL8: 📅 jump to a date (scrollback), next to the chip */
  .rm h2 .hist-jump { min-height: 30px; min-width: 36px; padding: 0 8px; font-size: 15px; }
  .rm h2 .hist-chip[hidden] + .hist-jump { margin-inline-start: auto; }
  .rm h2 .hist-chip[hidden] + .hist-jump[hidden] + .hist-jump { margin-inline-start: auto; }   /* CL9: the 🔍 alone */
  .rm h2 .hist-chip[hidden] + .hist-jump[hidden] + .hist-jump[hidden] + .hist-jump { margin-inline-start: auto; }   /* CL10: the ⋯ alone */
  .rm h2 .hist-jump[aria-expanded="true"] { --b-line: var(--ds-ac); }
  @media (max-width: 760px) { .rm h2 .hist-jump { min-height: 44px; min-width: 44px; } }
  .rm .rm-hist .hist-off { margin: 0 0 8px; }
  .rm .people { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; max-height: 46vh; overflow-y: auto; }
  .rm .people { overflow-x: hidden; }
  /* 1.99ex: avatar | name (shrinks, ellipsis) | controls (fixed width, never squeezed or pushed out of the card) */
  .rm .people li { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 8px; align-items: center; padding: 4px 6px; border-radius: 8px; font-size: 14px; min-width: 0; max-width: 100%; box-sizing: border-box; }
  .rm .people li:hover { background: #161616; }
