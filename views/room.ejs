  .rm .upnext time { color: var(--ds-green-2); font-variant-numeric: tabular-nums; min-width: 5.5em; }
  /* 1.99es: the pad's look - banner inside the header behind a scrim, the avatar by the name, the accent (--pad-accent, padlook.js) */
