<%- include('layout', { title: 'p/' + room.slug + ' — ' + room.name, user: user }) %>
<%# The pad page (1.99ck, /p/<slug>; was /rooms/<slug> + /feed/c/<slug>): header, stage + schedule, the live
    Camfrog room behind the pad when there is one (chat, people, mic, DJ booth), then the pad's feed. A
    site pad (the Camfrog Lounge) has no Camfrog room: no live section, no "not bridged" note. 1.99x: the header
    shows the pad's platform badge (🐸 Camfrog Pad / 🌐 Site Pad). %>
<% const pepeHere_ = typeof pepeHere !== 'undefined' && pepeHere, manage_ = typeof manage !== 'undefined' && manage, roomStage_ = typeof roomStage !== 'undefined' ? roomStage : null, schedule_ = typeof schedule !== 'undefined' ? schedule : null, bridged_ = room.bridged !== false, siteOnly_ = !!room.siteOnly, feed_ = typeof feed !== 'undefined' && feed ? feed : null, dms_ = typeof dms !== 'undefined' && !!dms; %>
<%# 1.99x: the platform badge (pads.js padBadge via fx or app.locals; a plain fallback when rendered bare) %>
<% const padBadge_ = typeof fx !== 'undefined' && fx && fx.padBadge ? fx.padBadge : typeof padBadge === 'function' ? padBadge
     : (p) => '<span class="pad-plat pp-' + p + '">' + (p === 'site' ? '🌐 Site Pad' : '🐸 Camfrog Pad') + '</span>'; %>
<style>
  .rm { max-width: 1120px; margin: 0 auto; padding: 18px 16px 56px; font-family: Ubuntu, sans-serif; color: #e6e6e6; display: grid; gap: 14px; box-sizing: border-box; width: 100%; }
  .rm *, .rm *::before, .rm *::after { box-sizing: border-box; }
  .rm a { color: #81c784; text-decoration: none; }
  .rm a:hover { color: #a5d6a7; }
  .rm .crumb { font-size: 13px; color: #888; }
  .rm .hero { background: radial-gradient(120% 160% at 0% 0%, #17301a 0%, #111 55%); border: 1px solid #222; border-radius: 14px; padding: 16px 18px; display: grid; gap: 8px; min-width: 0; }
  .rm .hero h1 { margin: 0; font-size: 26px; line-height: 1.2; overflow-wrap: anywhere; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .rm .topic { color: #cfd8cf; font-size: 15px; overflow-wrap: anywhere; }
  .rm .topic:empty { display: none; }
  .rm .meta { display: flex; flex-wrap: wrap; gap: 6px; }
  .rm .chip { font-size: 12px; padding: 3px 10px; border-radius: 999px; border: 1px solid #2c3a2d; background: #0f1a10; color: #b9d8bb; white-space: nowrap; }
  .rm .live { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; padding: 3px 10px; border-radius: 999px; background: #3a1010; border: 1px solid #7a2222; color: #ffb4b4; font-weight: bold; letter-spacing: .06em; }
  .rm .live.off { background: #1c1c1c; border-color: #333; color: #999; }
  .rm .dot { width: 8px; height: 8px; border-radius: 50%; background: #ff5252; animation: rmPulse 1.6s ease-in-out infinite; }
  .rm .live.off .dot { background: #666; animation: none; }
  @keyframes rmPulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
  .rm .banner { background: #12161d; border: 1px solid #2a3442; border-radius: 10px; padding: 10px 12px; color: #b9c7da; font-size: 13px; line-height: 1.5; }
  .rm .banner b { color: #e3ecf8; }
  .rm .grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 14px; align-items: start; }
  .rm .card { background: #111; border: 1px solid #222; border-radius: 14px; padding: 14px 16px; min-width: 0; }
  .rm h2 { margin: 0 0 10px; letter-spacing: .1em; text-transform: uppercase; color: #ffd700; font-family: 'Press Start 2P', monospace; font-size: 10px; line-height: 1.6; display: flex; justify-content: space-between; gap: 8px; }
  .rm h2 small { font-family: Ubuntu, sans-serif; letter-spacing: 0; text-transform: none; color: #888; font-size: 12px; }
  .rm .feed { height: min(62vh, 640px); overflow-y: auto; overscroll-behavior: contain; display: flex; flex-direction: column; gap: 2px; padding-right: 4px; scroll-behavior: smooth; }
  .rm .line { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 8px; padding: 5px 6px; border-radius: 8px; align-items: start; }
  .rm .line:hover { background: #161616; }
  .rm .line .body { min-width: 0; font-size: 14px; line-height: 1.45; overflow-wrap: anywhere; }
  .rm .line .who { font-weight: bold; margin-right: 6px; }
  .rm .line .when { color: #666; font-size: 11px; margin-left: 4px; white-space: nowrap; }
  .rm .line.pepe { background: #0f1a10; }
  .rm .line.tx { border-left: 3px solid #4f7fa8; background: #0f141b; }
  .rm .line.tx .body { font-style: italic; color: #c8d6e5; }
  .rm .line.tx .who { font-style: normal; }
  .rm .line.tx .who::before { content: "\1F399  "; }
  .rm .listen { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .rm .listen .btn { padding: 7px 12px; font-size: 13px; background: #181818; border-color: #2b2b2b; cursor: pointer; font-family: inherit; }
  .rm .hide { display: none !important; }
  .rm .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .rm .compose { border-top: 1px solid #222; margin-top: 10px; padding-top: 10px; display: grid; gap: 8px; }
  .rm .say { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; }
  .rm .say input { background: #0d0d0d; color: #eee; border: 1px solid #333; border-radius: 8px; padding: 9px 10px; font: inherit; font-size: 14px; min-width: 0; }
  .rm .say .btn { cursor: pointer; font-family: inherit; }
  .rm .ic button.cam { background: none; border: 1px solid #2c3a2d; border-radius: 6px; padding: 0 3px; cursor: pointer; font: inherit; line-height: 1.4; }
  .rm .ic button.cam:hover, .rm .ic button.cam:focus-visible { border-color: #4caf50; background: #12301a; }
  .rm .snap { position: fixed; z-index: 60; right: 16px; bottom: 16px; width: min(360px, calc(100vw - 32px)); background: #151515; border: 1px solid #333; border-radius: 12px;
              box-shadow: 0 12px 40px rgba(0,0,0,.6); padding: 10px; display: grid; gap: 8px; }
  .rm .snap img { width: 100%; border-radius: 8px; background: #000; display: block; }
  .rm .snap .row { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 12.5px; color: #aaa; }
  .rm .snap button { background: #222; color: #ddd; border: 1px solid #333; border-radius: 6px; padding: 4px 8px; cursor: pointer; font: inherit; font-size: 12px; }
  .rm .snap .acts { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 12.5px; }
  .rm .snap button.save { background: #12301a; border-color: #2f6b3a; color: #d7f5dc; font-weight: bold; }
  .rm .snap button.save:hover, .rm .snap button.save:focus-visible { border-color: #4caf50; }
  .rm .snap button.save:disabled { opacity: .55; cursor: default; }
  .rm .snap button.gen { background: #221a3a; border-color: #4b3a8a; color: #e2d8ff; font-weight: bold; }
  .rm .snap button.gen:hover, .rm .snap button.gen:focus-visible { border-color: #9b7bff; }
  .rm .snap button.gen:disabled { opacity: .55; cursor: default; }
  .rm .snap a.dl { color: #9cc7a3; text-decoration: none; white-space: nowrap; }
  .rm .snap a.dl:hover, .rm .snap a.dl:focus-visible { text-decoration: underline; }
  .rm .snap .res { font-size: 12.5px; color: #aaa; overflow-wrap: anywhere; }
  .rm .snap .res.ok { color: #9be3a6; }
  .rm .snap .res.bad { color: #e6a07a; }
  .rm .snap .res a { color: #8fd19a; font-weight: bold; }
  .rm .sys { color: #8a8a8a; font-size: 12.5px; padding: 3px 6px 3px 42px; overflow-wrap: anywhere; }
  .rm .sys.topic { color: #c9b46a; }
  .rm .av { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; font-size: 13px; font-weight: bold; color: #0d0d0d; object-fit: cover; flex: none; overflow: hidden; }
  .rm .av.anon { background: #2a2a2a !important; color: #888; }
  .rm .people { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; max-height: 46vh; overflow-y: auto; }
  .rm .people li { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 8px; align-items: center; padding: 4px 6px; border-radius: 8px; font-size: 14px; }
  .rm .people li:hover { background: #161616; }
  .rm .people .nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rm .people .nm small { color: #777; margin-left: 4px; }
  .rm .ic { display: inline-flex; gap: 4px; font-size: 13px; }
  .rm .ic .off { opacity: .25; filter: grayscale(1); }
  .rm .mic { display: grid; gap: 6px; }
  .rm .mic .holder { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 8px; align-items: center; background: #0f1a10; border: 1px solid #234d2a; border-radius: 10px; padding: 6px 8px; }
  .rm .eq { display: inline-flex; gap: 2px; align-items: flex-end; height: 14px; }
  .rm .eq i { width: 3px; background: #4caf50; border-radius: 1px; animation: rmEq 1s ease-in-out infinite; }
  .rm .eq i:nth-child(2) { animation-delay: .2s; } .rm .eq i:nth-child(3) { animation-delay: .4s; }
  @keyframes rmEq { 0%, 100% { height: 4px; } 50% { height: 14px; } }
  .rm .muted { color: #888; font-size: 13px; }
  .rm .side { display: grid; gap: 14px; }
  .rm .join ol { margin: 6px 0 0; padding-left: 18px; color: #bbb; font-size: 13px; line-height: 1.6; }
  .rm .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; border-radius: 8px; border: 1px solid #4caf50; background: #4caf50; color: #fff !important; font-weight: bold; font-size: 14px; }
  .rm .tease { text-align: center; padding: 34px 18px; display: grid; gap: 10px; justify-items: center; }
  .rm .tease .big { font-size: 44px; }
  .rm .jump { position: sticky; bottom: 4px; align-self: center; background: #4caf50; color: #fff; border: 0; border-radius: 999px; padding: 5px 14px; font: inherit; font-size: 12px; cursor: pointer; display: none; }
  .rm .status { font-size: 12px; color: #777; }
  .rm .status.err { color: #e57373; }
  .cx-name { font-weight: bold; }
  /* the main stage, when this is the stage room (public/js/stage-player.js) */
  .rm .stage { background: radial-gradient(120% 140% at 0% 0%, #17301a 0%, #0d0d0f 55%); }
  .rm .stage h2 { align-items: center; color: #c6e94f; }
  .rm .stage h2 .live { white-space: nowrap; flex: none; }
  .rm .stage .player { position: relative; width: 100%; max-width: calc((100vh - 200px) * 16 / 9); margin: 0 auto; aspect-ratio: 16 / 9; background: #000; border-radius: 12px; overflow: hidden; border: 1px solid #262626; }
  .rm .stage .player .wrap { position: absolute; inset: 0; }
  .rm .stage .player .video-js { width: 100%; height: 100%; }
  .rm .stage .player .reconnect { position: absolute; inset: 0; display: grid; grid-auto-flow: column; gap: 8px; place-content: center; align-items: center;
                                  background: rgba(0,0,0,.72); color: #ddd; font-size: 15px; z-index: 4; }
  .rm .stage .player .unmute { position: absolute; inset: 0; z-index: 3; background: rgba(0,0,0,.35); border: 0; cursor: pointer; display: grid; place-items: center; }
  .rm .stage .player .unmute img { width: 56px; height: auto; opacity: .9; }
  .rm .stage .off-air { display: grid; place-items: center; text-align: center; gap: 6px; min-height: 120px; color: #9aa59a; font-size: 14px; }
  .rm .stage.is-off .player { display: none; }
  .rm .stage.is-on .off-air { display: none; }
  /* paid stage slots (mainstage.js): which stream the stage shows */
  .rm .stabs { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 10px; }
  .rm .stabs:empty { display: none; }
  .rm .stab { display: inline-flex; align-items: center; gap: 6px; max-width: 100%; padding: 5px 11px; border-radius: 999px; border: 1px solid #2b2b2b;
              background: #141414; color: #cfd8cf; font: inherit; font-size: 13px; cursor: pointer; min-width: 0; }
  .rm .stab .n { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: bold; }
  .rm .stab[aria-selected="true"] { border-color: #c6e94f; background: #1b2a12; color: #fff; }
  .rm .stab:focus-visible { outline: 2px solid #c6e94f; outline-offset: 2px; }
  .rm .stab.off .dot { background: #666; animation: none; }
  /* 1.99bi: every room's stage (public/js/stage-room.js), owner bits, the Go live call to action */
  .rm .stab .star { color: #ffd700; }
  .rm .stab .src { font-size: 11px; color: #9fb3c8; border: 1px solid #2a3442; border-radius: 999px; padding: 0 6px; }
  .rm .stab.feat { border-color: #6b5a20; }
  .rm .stabs .adm { display: inline-flex; gap: 6px; margin-left: auto; flex-wrap: wrap; }
  .rm .stabs .adm button { padding: 5px 10px; border-radius: 8px; border: 1px solid #5a2222; background: #2a1010; color: #ffb4b4; font: inherit; font-size: 12.5px; font-weight: bold; cursor: pointer; }
  .rm .stabs .adm button[data-act=feature], .rm .stabs .adm button[data-act=unfeature] { border-color: #6b5a20; background: #1d1a0f; color: #e8d9a0; }
  .rm .stage .player .embed { position: absolute; inset: 0; z-index: 2; background: #000; }
  .rm .stage .player .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .rm .stage-foot { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; margin-top: 10px; font-size: 13px; color: #aab3aa; }
  .rm .stage-foot .sp { flex: 1; }
  .rm .golive-btn { display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px; border-radius: 999px; font-weight: bold; font-size: 13.5px; white-space: nowrap;
                    background: linear-gradient(90deg, #e53935, #ff7043); color: #fff !important; border: 0; }
  .rm .golive-btn.ghost { background: #1d1a0f; border: 1px solid #6b5a20; color: #f3e3a3 !important; }
  .rm .upnext { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 4px; font-size: 13px; }
  .rm .upnext li { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
  .rm .upnext time { color: #c6e94f; font-variant-numeric: tabular-nums; min-width: 5.5em; }
  .rm .banner-img { width: 100%; max-height: 200px; object-fit: cover; border-radius: 12px; display: block; border: 1px solid #222; }
  .rm .desc { color: #bbb; font-size: 14px; line-height: 1.5; white-space: pre-line; overflow-wrap: anywhere; }
  .rm .meta a.chip { color: #b9d8bb; }
  .rm .meta .chip.own { border-color: #6b5a20; background: #1d1a0f; color: #f3e3a3; }
  .rm .padref { font-size: 14px; color: #9ccc9f; font-weight: bold; letter-spacing: .02em; }
  .rm .meta { align-items: center; }
  .rm .meta .fw-btn { font-size: 12px; padding: 3px 12px; }
  @media (max-width: 860px) {
    .rm .grid { grid-template-columns: minmax(0, 1fr); }
    .rm .feed { height: 58vh; }
    .rm .hero h1 { font-size: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rm .dot, .rm .eq i { animation: none; }
    .rm .feed { scroll-behavior: auto; }
  }
</style>
<main class="rm">
  <div class="crumb"><a href="/p">Pads</a> › p/<%= room.slug %></div>
  <% if (room.banner) { %><img class="banner-img" src="<%= room.banner %>" alt="" loading="lazy" referrerpolicy="no-referrer"><% } %>
  <section class="hero" aria-labelledby="rmTitle">
    <h1 id="rmTitle"><%= room.name %>
      <% if (!siteOnly_) { %><span class="live<%= room.live ? '' : ' off' %>" id="rmLive" title="Is the Camfrog room live?"><span class="dot" aria-hidden="true"></span><span id="rmLiveTxt"><%= room.live ? 'LIVE' : 'OFFLINE' %></span></span><% } %>
    </h1>
    <div class="padref">p/<%= room.slug %></div>
    <div class="topic" id="rmTopic"><%= room.topic %></div>
    <% if (room.description) { %><div class="desc"><%= room.description %></div><% } %>
    <div class="meta">
      <% if (feed_ && feed_.follow) { %><%- include('partials/follow-btn', { kind: 'room', id: feed_.room, following: feed_.follow.following, signed: !!feed_.viewer, next: '/p/' + encodeURIComponent(room.slug), fwTitle: 'Follow this pad' }) %>
        <span class="chip" title="Follow this pad to get its posts on your Following feed"><b data-follower-count-kind="room" data-follower-count-id="<%= feed_.room %>"><%= feed_.follow.followers.toLocaleString('en-US') %></b> follower<%= feed_.follow.followers === 1 ? '' : 's' %></span><% } %>
      <%- padBadge_(room.platform || (siteOnly_ ? 'site' : 'camfrog')) %>
      <% if (!siteOnly_) { %><% if (bridged_) { %><span class="chip" id="rmCount">👥 <%= room.count %> in the Camfrog room</span><% } %>
      <span class="chip" title="This pad is backed by a Camfrog room">📡 Camfrog room<%= room.camfrogName && room.camfrogName !== room.name ? ': ' + room.camfrogName : '' %></span><% } %>
      <% if (room.house) { %><span class="chip own" title="Run by Pepe">🐸 House pad</span><% } else if (room.owner) { %><a class="chip own" href="/u/<%= encodeURIComponent(room.ownerUser) %>/profile">👑 Pad owner: <%= room.owner %></a><% } %>
      <% if (pepeHere_ === true && !siteOnly_) { %><span class="chip" title="Pepe is in the Camfrog room, so his stream is part of this pad's stage">🐸 Pepe is here</span><% } %>
      <% if (manage_) { %><a class="chip own ps-link" href="/p/<%= encodeURIComponent(room.slug) %>/settings<%= feed_ && feed_.queue ? '#moderation' : '' %>" title="Everything about this pad: page, stage, feed, Pepe, rules, moderation">⚙ Pad settings<% if (feed_ && feed_.queue) { %> <span class="ps-q" title="Waiting for you in Moderation"><%= feed_.queue %></span><% } %></a><% } %>
      <% if (feed_ && feed_.rules) { %><a class="chip" href="#rules" onclick="var d=document.getElementById('rules');if(d)d.open=true">📜 Rules</a><% } %>
      <% if (feed_) { %><a class="chip" href="#feed">📝 Feed<%= feed_.posts.length ? ' · ' + (feed_.more ? feed_.posts.length + '+' : feed_.posts.length) : '' %></a><% } %>
      <% if (typeof roomAnalytics !== 'undefined' && roomAnalytics) { %><a class="chip" href="<%= roomAnalytics %>">📈 Pad analytics</a><% } %>
    </div>
  </section>
  <% if (bridged_ && !siteOnly_) { %><div class="banner" role="note">📡 <b>Live from the Camfrog room — read-only (v1).</b> What the Camfrog room shows to anyone sitting in it: public chat, who's here, who's on the mic. 🎙 lines are what people said on the mic (auto-transcribed). Private messages are never shown, and anyone who turned on <code>!incognito</code> or typed <code>!bridge hide</code> in the room appears as "someone".</div><% } %>

<% { const st = stage || {}; const RS = roomStage_ || { slots: [], upcoming: [], queue: {} }; const pepeOn_ = !!st.active && pepeHere_ !== false; const live = pepeOn_ || RS.slots.length > 0;
     const fmtT = (ms) => new Date(ms).toISOString(); %>
  <link href="https://vjs.zencdn.net/8.3.0/video-js.css" rel="stylesheet" />
  <script src="https://vjs.zencdn.net/8.3.0/video.min.js" defer></script>
  <script src="/public/js/stage-player.js?v=4"></script>
  <script src="/public/js/stage-room.js?v=4"></script>
  <link rel="stylesheet" href="/public/css/stagecap.css?v=1">
  <script src="/public/js/stage-capture.js?v=2"></script>
  <section class="card stage <%= live ? 'is-on' : 'is-off' %>" id="rmStage" aria-labelledby="rmStageH">
    <h2 id="rmStageH"><span>📺 <%= room.name %> stage</span>
      <span class="live<%= live ? '' : ' off' %>" id="rmStPill" style="font-family:Ubuntu,sans-serif"><span class="dot" aria-hidden="true"></span><span id="rmStPillTxt"><%= live ? 'ON AIR' : 'OFF AIR' %></span></span></h2>
    <div class="stabs" id="rmTabs" role="tablist" aria-label="Stage streams"></div>
    <div class="player">
      <div class="wrap" id="rmVideo"></div>
      <div class="reconnect hide" id="rmStReconnect" role="status"><span class="dot" aria-hidden="true"></span> Stream is starting / reconnecting…</div>
      <button type="button" class="unmute hide" id="rmStUnmute" aria-label="Unmute the stream"><img src="/public/img/mute-icon.png" alt=""></button>
      <div class="embed hide" id="rmEmbed"></div>
    </div>
    <div class="stcap hide" id="rmCap" aria-label="Snap or clip this stream"></div>
    <div class="off-air"><span id="rmOffTxt">Nothing on this stage right now — be the first: go live here.</span></div>
    <div class="stage-foot">
      <span id="rmSlotsTxt">🎬 <%= RS.open || 0 %>/<%= (RS.room && RS.room.slot_count) || 1 %> slot<%= ((RS.room && RS.room.slot_count) || 1) === 1 ? '' : 's' %> in use<%= RS.queue && RS.queue.length ? ' · ' + RS.queue.length + ' waiting' : '' %><%= RS.room && RS.room.slot_price ? ' · ' + Number(RS.room.slot_price).toLocaleString('en-US') + ' PAT/min' : ' · free slots' %></span>
      <span class="sp"></span>
      <a class="golive-btn" href="/stage?room=<%= encodeURIComponent(room.slug) %>">🎥 Go live here</a>
      <% if (!RS.featured) { %><a class="golive-btn ghost" href="/stage?room=<%= encodeURIComponent(room.slug) %>&feature=1">★ Get featured</a><% } %>
    </div>
    <% if (!schedule_ && (RS.upcoming || []).length) { %>
      <ul class="upnext" aria-label="Coming up on this stage">
        <% RS.upcoming.forEach((u) => { %><li><time data-ts="<%= u.start_at %>" datetime="<%= fmtT(u.start_at) %>"><%= fmtT(u.start_at).slice(11, 16) %> UTC</time><b><%= u.display %></b><span class="muted"><%= u.minutes %> min<%= u.featured ? ' · ★ featured' : '' %><%= u.title ? ' · ' + u.title : '' %></span></li><% }) %>
      </ul>
    <% } %>
  </section>
  <script>
  (function () {
    'use strict';
    var box = document.getElementById('rmStage');
    document.querySelectorAll('.upnext time[data-ts]').forEach(function (t) {
      var d = new Date(Number(t.getAttribute('data-ts')));
      t.textContent = d.toLocaleDateString(undefined, { weekday: 'short' }) + ' ' + d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
    });
    var padSlug = <%- JSON.stringify(room.slug).replace(/</g, '\\u003c') %>;
    // 1.99cr: Snap / Clip the stream that's showing (stage-capture.js; cut on the server, saved to this pad's story)
    var cap = PATVStage.capture({ host: document.getElementById('rmCap'), room: function () { return padSlug; } });
    PATVStage.switcher({
      tabs: document.getElementById('rmTabs'), wrap: document.getElementById('rmVideo'),
      reconnect: document.getElementById('rmStReconnect'), unmute: document.getElementById('rmStUnmute'), embedHost: document.getElementById('rmEmbed'),
      api: '/api/stage?room=' + encodeURIComponent(padSlug), onShow: function (sel) { cap.update(sel); },
      slots: <%- JSON.stringify(RS.slots || []).replace(/</g, '\\u003c') %>, pepeOn: <%= st.active ? 'true' : 'false' %>, pepeHere: <%= pepeHere_ === false ? 'false' : 'true' %>, manage: <%= manage_ ? 'true' : 'false' %>,
      onAir: function (on) {
        box.classList.toggle('is-on', on); box.classList.toggle('is-off', !on);
        document.getElementById('rmStPill').className = 'live' + (on ? '' : ' off');
        document.getElementById('rmStPillTxt').textContent = on ? 'ON AIR' : 'OFF AIR';
      }
    });
  })();
  </script>
<% } %>
<% if (schedule_) { %><%- include('partials/room-schedule', { slug: room.slug, schedule: schedule_, manage: manage_ }) %><% } %>
<% if (!bridged_ && !siteOnly_) { %>
  <section class="card"><p class="muted" style="margin:0">📡 Pepe isn't bridging this pad's Camfrog room to the website right now, so there's no live chat here — the stage and the feed still work. Join the Camfrog room to hang out.</p></section>
<% } %>

<% if (!bridged_ || siteOnly_) { %>
<% } else if (!signedIn) { %>
  <section class="card tease">
    <div class="big" aria-hidden="true">🐸</div>
    <h2 style="justify-content:center">Sign in to watch the Camfrog room live</h2>
    <p class="muted">The Camfrog room's live chat, who's in it and who's on the mic are for signed-in PATV members.</p>
    <a class="btn" href="/login">Sign in</a>
    <p class="muted">No account? <a href="/register">Make one</a> — then link your Camfrog name with <code>!verify</code>.</p>
  </section>
<% } else { %>
  <%- include('partials/room-dj', { slug: room.slug, linked: linked }) %>
  <div class="grid">
    <section class="card" aria-labelledby="chatH">
      <h2 id="chatH">Chat <small id="rmStatus" class="status" aria-live="polite"></small></h2>
      <div class="feed" id="rmFeed" role="log" aria-live="polite" aria-relevant="additions" tabindex="0" aria-label="Camfrog room chat"></div>
      <button class="jump" id="rmJump" type="button">New messages ↓</button>
      <div class="compose hide" id="rmCompose">
        <% if (!linked) { %>
          <p class="muted" style="margin:0">💬 This Camfrog room takes messages from the website. <b>Link your Camfrog name</b> first: type <code>!verify</code> in a room with Pepe.</p>
        <% } else { %>
          <div id="rmRelay"></div>
          <div id="rmPtt"></div>
        <% } %>
      </div>
    </section>
    <aside class="side">
      <%# 1.99co: the Manage panel - filled and shown by public/js/room-mod.js only when Pepe says this viewer moderates the room %>
      <section class="card pm" id="rmMod" hidden></section>
      <section class="card" aria-labelledby="micH">
        <h2 id="micH">On the mic</h2>
        <div class="mic" id="rmMic"></div>
        <div id="rmAudioBox" style="margin-top:10px"></div>
      </section>
      <section class="card" aria-labelledby="pplH">
        <h2 id="pplH">In the Camfrog room <small id="rmPplN"></small></h2>
        <ul class="people" id="rmPeople"></ul>
        <p class="muted" id="rmListNote" style="margin:8px 0 0"></p>
      </section>
      <section class="card join" aria-labelledby="joinH">
        <h2 id="joinH">Join the Camfrog room</h2>
        <ol>
          <li>Open Camfrog (<a href="https://www.camfrog.com/" rel="noopener">get it here</a>) and sign in.</li>
          <li>Open the <b>Room List</b> and search for <b><%= room.name %></b>.</li>
          <li>Say hi — Pepe answers <code>!help</code>.</li>
        </ol>
      </section>
    </aside>
  </div>
  <link rel="stylesheet" href="/public/css/room-bridge.css?v=4">
  <script src="/public/js/room-bridge.js?v=5"></script>
  <link rel="stylesheet" href="/public/css/room-mod.css?v=1">
  <script src="/public/js/room-mod.js?v=1"></script>
  <script id="rmInit" type="application/json"><%- JSON.stringify(initial).replace(/</g, '\\u003c') %></script>
  <script>
  (function () {
    'use strict';
    var slug = <%- JSON.stringify(room.slug).replace(/</g, '\\u003c') %>;
    var data = JSON.parse(document.getElementById('rmInit').textContent);
    var feedEl = document.getElementById('rmFeed'), jump = document.getElementById('rmJump');
    var cursor = 0, timer = null, fails = 0, lastPeople = '', lastMic = '';
    var roomMod = window.PATVRoom && PATVRoom.mod ? PATVRoom.mod(document.getElementById('rmMod'), slug, { dms: <%- JSON.stringify(dms_) %> }) : null;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
    function hue(s) { var h = 0; for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 360; return h; }
    function avatar(u) {
      if (u && u.patv && u.patv.avatar) { var im = el('img', 'av'); im.src = u.patv.avatar; im.alt = ''; im.loading = 'lazy'; return im; }
      var d = el('span', 'av' + (!u || u.anon ? ' anon' : ''), !u || u.anon ? '?' : (u.display || u.login || '?').charAt(0).toUpperCase());
      if (u && !u.anon) d.style.background = 'hsl(' + hue(u.login || '') + ',55%,62%)';
      d.setAttribute('aria-hidden', 'true');
      return d;
    }
    function name(u) {
      if (!u || u.anon) return el('span', 'who', 'someone');
      var n;
      if (u.patv) { n = el('a', 'who'); n.href = '/u/' + encodeURIComponent(u.patv.username) + '/profile'; n.textContent = u.display || u.login; }
      else n = el('span', 'who', u.display || u.login);
      if (u.patv && u.patv.style) { n.classList.add('cx-name'); n.style.cssText = u.patv.style; }
      if (u.self) n.title = 'Pepe'; else if (u.display && u.login && u.display.toLowerCase() !== u.login.toLowerCase()) n.title = u.login;
      return n;
    }
    function hhmm(ts) { var d = new Date(ts); return ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2); }
    function dur(ms) { var s = Math.round(ms / 1000); return s < 60 ? s + 's' : s < 3600 ? Math.round(s / 60) + 'm' : (s / 3600).toFixed(1) + 'h'; }
    function label(u) { return !u || u.anon ? 'someone' : (u.display || u.login); }

    function item(it) {
      if (it.k === 'msg' || it.k === 'tx') {
        var row = el('div', 'line' + (it.k === 'tx' ? ' tx' : '') + (it.u && it.u.self ? ' pepe' : ''));
        if (it.k === 'tx') row.title = 'Said on the mic (auto-transcribed)';
        row.appendChild(avatar(it.u));
        var b = el('div', 'body');
        b.appendChild(name(it.u));
        b.appendChild(document.createTextNode(it.k === 'tx' ? '\u201c' + it.text + '\u201d' : it.text));
        var t = el('time', 'when', hhmm(it.ts)); t.dateTime = new Date(it.ts).toISOString();
        b.appendChild(t);
        row.appendChild(b);
        return row;
      }
      var txt = it.k === 'join' ? '→ ' + label(it.u) + ' joined'
        : it.k === 'leave' ? '← ' + label(it.u) + ' left'
        : it.k === 'mic' ? '🎙️ ' + label(it.u) + ' grabbed the mic'
        : it.k === 'unmic' ? '🎙️ ' + label(it.u) + ' dropped the mic' + (it.ms ? ' after ' + dur(it.ms) : '')
        : it.k === 'topic' ? '📌 topic: ' + it.text : null;
      if (!txt) return null;
      return el('div', 'sys' + (it.k === 'topic' ? ' topic' : ''), txt + ' · ' + hhmm(it.ts));
    }

    function nearBottom() { return feedEl.scrollHeight - feedEl.scrollTop - feedEl.clientHeight < 80; }
    function addFeed(items, first) {
      if (!items || !items.length) { if (first && !feedEl.childNodes.length) feedEl.appendChild(el('p', 'muted', 'Nothing said yet — it shows up here the moment someone talks.')); return; }
      var stick = first || nearBottom();
      if (feedEl.firstChild && feedEl.firstChild.tagName === 'P') feedEl.removeChild(feedEl.firstChild);
      var frag = document.createDocumentFragment();
      items.forEach(function (it) { var n = item(it); if (n) frag.appendChild(n); });
      feedEl.appendChild(frag);
      while (feedEl.childNodes.length > 300) feedEl.removeChild(feedEl.firstChild);
      if (stick) { feedEl.style.scrollBehavior = 'auto'; feedEl.scrollTop = feedEl.scrollHeight; feedEl.style.scrollBehavior = ''; jump.style.display = 'none'; }
      else jump.style.display = 'block';
    }
    jump.addEventListener('click', function () { feedEl.scrollTop = feedEl.scrollHeight; jump.style.display = 'none'; });
    feedEl.addEventListener('scroll', function () { if (nearBottom()) jump.style.display = 'none'; });

    function renderRoom(d) {
      var r = d.room;
      document.getElementById('rmTopic').textContent = r.topic || '';
      document.getElementById('rmCount').textContent = '👥 ' + r.count + ' in the Camfrog room';
      var live = document.getElementById('rmLive');
      live.classList.toggle('off', !r.live);
      document.getElementById('rmLiveTxt').textContent = r.live ? 'LIVE' : 'OFFLINE';
      var mk = JSON.stringify(d.mic);
      if (mk !== lastMic) {
        lastMic = mk;
        var mic = document.getElementById('rmMic'); mic.textContent = '';
        if (!d.mic.length) mic.appendChild(el('p', 'muted', 'Nobody on the mic right now.'));
        d.mic.forEach(function (u) {
          var h = el('div', 'holder'); h.appendChild(avatar(u));
          var n = el('span', 'nm'); n.appendChild(name(u)); h.appendChild(n);
          var eq = el('span', 'eq'); eq.setAttribute('aria-label', 'talking');
          if (!reduce) { eq.appendChild(el('i')); eq.appendChild(el('i')); eq.appendChild(el('i')); } else eq.textContent = '🎙️';
          h.appendChild(eq); mic.appendChild(h);
        });
      }
      var pk = JSON.stringify(d.members) + (r.cams ? '1' : '0') + (roomMod ? roomMod.key() : '');
      if (pk !== lastPeople) {
        lastPeople = pk;
        var ul = document.getElementById('rmPeople'); ul.textContent = '';
        var ms = d.members.slice().sort(function (a, b) {
          return (b.self ? 1 : 0) - (a.self ? 1 : 0) || (b.on_mic ? 1 : 0) - (a.on_mic ? 1 : 0) || (b.on_cam ? 1 : 0) - (a.on_cam ? 1 : 0)
            || (a.anon ? 1 : 0) - (b.anon ? 1 : 0) || label(a).localeCompare(label(b));
        });
        ms.forEach(function (u) {
          var li = el('li'); li.appendChild(avatar(u));
          var n = el('span', 'nm'); n.appendChild(name(u));
          if (u.src === 'seen') n.appendChild(el('small', null, 'recently'));
          li.appendChild(n);
          var ic = el('span', 'ic');
          var cam;
          if (r.cams && u.on_cam && !u.self && !u.anon && u.login) {
            cam = el('button', 'cam', '📷'); cam.type = 'button';
            cam.title = 'Ask Pepe for a snapshot of ' + label(u) + '\'s cam';
            cam.setAttribute('aria-label', 'Snapshot of ' + label(u) + '\'s cam');
            (function (who) { cam.addEventListener('click', function () { snapOpen(who); }); })(u);
          } else {
            cam = el('span', u.on_cam ? '' : 'off', '📷'); cam.title = u.on_cam ? 'On cam' : (u.on_cam === false ? 'Off cam' : 'Cam unknown');
          }
          ic.appendChild(cam);
          var m = el('span', u.on_mic ? '' : 'off', '🎙️'); m.title = u.on_mic ? 'On the mic' : 'Not on the mic'; ic.appendChild(m);
          // 1.99co: moderators (Pepe says so) manage someone by clicking them (or their ⋯ button)
          if (roomMod && roomMod.active() && !u.self && !u.anon && u.login) {
            var mg = el('button', 'pm-mg', '⋯'); mg.type = 'button';
            mg.title = 'Manage ' + label(u); mg.setAttribute('aria-label', 'Manage ' + label(u));
            ic.appendChild(mg);
            li.classList.add('pm-can');
            (function (who) {
              li.addEventListener('click', function (e) {
                if (e.target.closest('a') || (e.target.closest('button') && !e.target.closest('.pm-mg'))) return;
                roomMod.open(who);
              });
            })(u);
          }
          li.appendChild(ic); ul.appendChild(li);
        });
        document.getElementById('rmPplN').textContent = d.members.length ? '(' + d.members.length + ')' : '';
      }
      // every render, not only when the people change: "checked 3 min ago" has to keep counting
      var note = listNote(r), noteEl = document.getElementById('rmListNote');
      if (noteEl.textContent !== note) noteEl.textContent = note;
    }

    // How far the roster can be trusted. Pepe re-reads each room's participant list every minute or
    // so; when he can't (the list is stale), he only keeps people seen arriving / talking / on the
    // mic within seenTtl and drops the rest - so say which of the two the list on screen is.
    function mins(ms) { var m = Math.max(0, Math.round(ms / 60000)); return m < 120 ? m + ' min' : Math.round(m / 60) + ' h'; }
    function listNote(r) {
      var ttl = mins(r.seenTtl || 15 * 60000), staleAfter = r.listStaleAfter || 10 * 60000;
      var age = r.listAt ? Date.now() - r.listAt : null;
      var fresh = age != null && age < staleAfter && r.listFresh !== false;
      if (fresh) {
        return 'From the room\'s participant list, checked ' + (age < 60000 ? 'just now' : mins(age) + ' ago')
          + ' (' + hhmm(r.listAt) + '). "recently" = arrived or active since that check.';
      }
      if (age != null) {
        return 'List not checked for ' + mins(age) + ' — showing people active in the last ' + ttl + '.';
      }
      return 'Pepe can\'t read this room\'s participant list right now — showing people seen arriving or active in the last ' + ttl + '.';
    }

    var roomAudio = PATVRoom.audio(document.getElementById('rmAudioBox'), slug);
    var relayHost = document.getElementById('rmRelay'), roomRelay = relayHost ? PATVRoom.relay(relayHost, slug) : null;
    // ── cam snapshot popover (click the 📷 of someone on cam) ──
    var snapEl = null, snapTimer = null, snapWho = null;
    function snapClose() { clearTimeout(snapTimer); clearTimeout(saveTimer); if (snapEl) snapEl.remove(); snapEl = null; snapWho = null; }
    function snapBox(text) {
      if (!snapEl) {
        snapEl = el('div', 'snap'); snapEl.setAttribute('role', 'dialog'); snapEl.setAttribute('aria-label', 'Cam snapshot');
        document.querySelector('.rm').appendChild(snapEl);
      }
      snapEl.textContent = '';
      var top = el('div', 'row'); top.appendChild(el('b', null, '📷 ' + label(snapWho)));
      var x = el('button', null, 'Close'); x.type = 'button'; x.addEventListener('click', snapClose); top.appendChild(x);
      snapEl.appendChild(top);
      if (text) snapEl.appendChild(el('div', 'muted', text));
      return snapEl;
    }
    function snapShow(s) {
      var box = snapBox(s.state === 'ok' ? null : (s.status || 'No picture.'));
      if (s.state === 'ok' && s.img) {
        var im = el('img'); im.alt = label(snapWho) + '\'s cam'; im.src = s.img; box.appendChild(im);
      }
      var row = el('div', 'row');
      var t = new Date(s.ts || Date.now());
      row.appendChild(el('span', null, 'taken ' + ('0' + t.getHours()).slice(-2) + ':' + ('0' + t.getMinutes()).slice(-2) + ':' + ('0' + t.getSeconds()).slice(-2)));
      var rf = el('button', null, 'Refresh'); rf.type = 'button'; rf.addEventListener('click', function () { snapOpen(snapWho, true); }); row.appendChild(rf);
      box.appendChild(row);
      // Save snap (1.99ap): only when the !snap rules let this viewer snap them (the server decides;
      // `save` is null otherwise, and then there's no Download either).
      if (s.state === 'ok' && s.img && s.save) snapSaveRow(box, s);
      // 1.99dr: "✨ Use in Generate" - this frame as the composer's AI reference picture (aigen.js claimCamRef:
      // priced like chat's -cam, the person's opt-out and the room's switches re-checked, never stored)
      if (s.state === 'ok' && s.img && s.gen) snapGenRow(box, s);
    }
    function snapGenRow(box, s) {
      var who = snapWho, acts = el('div', 'acts'), res = el('div', 'res');
      res.setAttribute('role', 'status'); res.setAttribute('aria-live', 'polite');
      var g = el('button', 'gen', '✨ Use in Generate'); g.type = 'button';
      g.title = 'Make an AI picture or video from this frame (Pepe\'s !imagine / !video, priced like -cam in chat)';
      acts.appendChild(g); box.appendChild(acts); box.appendChild(res);
      g.addEventListener('click', function () {
        g.disabled = true; res.className = 'res'; res.textContent = 'Getting it ready…';
        fetch('/api/feed/aigen/camref', { method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' }, body: JSON.stringify({ pad: slug, sid: s.gen.sid }) })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (snapWho !== who || !res.isConnected) return;
            g.disabled = false;
            if (!d.ok) { res.className = 'res bad'; res.textContent = d.error || 'Not right now.'; return; }
            var c = { id: d.id, display: d.display, room: d.room, img: s.img, until: d.until };
            if (document.getElementById('fcGen')) {
              document.dispatchEvent(new CustomEvent('patv:gen-cam', { detail: c }));
              snapClose();
            } else {
              // no composer on this page (signed-out view, feed off): hand it to /feed's composer
              try { sessionStorage.setItem('patvGenCam', JSON.stringify(c)); } catch (e) { /* too big / blocked */ }
              location.href = '/feed';
            }
          }).catch(function () { g.disabled = false; res.className = 'res bad'; res.textContent = 'Couldn\'t reach the site.'; });
      });
    }
    var saveTimer = null;
    function snapSaveRow(box, s) {
      var who = snapWho, acts = el('div', 'acts'), res = el('div', 'res');
      res.setAttribute('role', 'status'); res.setAttribute('aria-live', 'polite');
      var sv = el('button', 'save', '💾 Save snap' + (s.save.cost ? ' · ' + Number(s.save.cost).toLocaleString() + ' PAT' : ''));
      sv.type = 'button';
      sv.title = 'Post this frame to the feed as a !snap by you' + (s.save.cost ? ' (' + Number(s.save.cost).toLocaleString() + ' PAT, like !snap)' : '');
      var dl = el('a', 'dl', '⬇ Download');
      var t = new Date(s.ts || Date.now());
      dl.href = s.img;
      dl.download = 'snap-' + String(who.login || 'cam').replace(/[^A-Za-z0-9._-]+/g, '_') + '-' + t.getFullYear() + ('0' + (t.getMonth() + 1)).slice(-2) + ('0' + t.getDate()).slice(-2)
        + '-' + ('0' + t.getHours()).slice(-2) + ('0' + t.getMinutes()).slice(-2) + ('0' + t.getSeconds()).slice(-2) + '.jpg';
      acts.appendChild(sv); acts.appendChild(dl);
      box.appendChild(acts); box.appendChild(res);
      function say(text, cls, href) {
        res.className = 'res' + (cls ? ' ' + cls : ''); res.textContent = text;
        if (href) { var a = el('a', null, 'Open it on the feed ›'); a.href = href; res.appendChild(document.createTextNode(' ')); res.appendChild(a); }
      }
      function watch(id, n) {
        clearTimeout(saveTimer);
        fetch('/api/rooms/' + encodeURIComponent(slug) + '/snap/save/' + encodeURIComponent(id), { credentials: 'same-origin', cache: 'no-store' })
          .then(function (r) { return r.json(); })
          .then(function (a) {
            if (snapWho !== who || !res.isConnected) return;
            if (a.status === 'done') { sv.textContent = '💾 Saved'; return say('Saved as your snap.', 'ok', a.url || null); }
            if (a.status === 'failed') { sv.disabled = false; return say(a.message ? a.message.charAt(0).toUpperCase() + a.message.slice(1) + '.' : 'Pepe couldn\'t save it.', 'bad'); }
            if (n > 40) { return say('Pepe hasn\'t answered yet — check the feed in a minute.', null); }
            saveTimer = setTimeout(function () { watch(id, n + 1); }, 1500);
          }).catch(function () { if (res.isConnected) say('Couldn\'t reach the site.', 'bad'); sv.disabled = false; });
      }
      sv.addEventListener('click', function () {
        sv.disabled = true; say('Sending to Pepe…');
        fetch('/api/rooms/' + encodeURIComponent(slug) + '/snap/save', { method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' }, body: JSON.stringify({ sid: s.save.sid }) })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (snapWho !== who || !res.isConnected) return;
            if (!d.ok) { sv.disabled = false; return say(d.error || 'Not right now.', 'bad'); }
            say('Pepe is saving it…'); watch(d.id, 0);
          }).catch(function () { sv.disabled = false; say('Couldn\'t reach the site.', 'bad'); });
      });
      if (s.save.id) { sv.disabled = true; say('Checking your save…'); watch(s.save.id, 0); }
    }
    function snapPoll(who, n) {
      fetch('/api/rooms/' + encodeURIComponent(slug) + '/snap/' + encodeURIComponent(who.login), { credentials: 'same-origin', cache: 'no-store' })
        .then(function (r) { return r.json(); })
        .then(function (s) {
          if (snapWho !== who) return;
          if (s.state === 'ok' || s.state === 'refused') return snapShow(s);
          if (n > 30) return snapBox('Pepe didn\'t get a picture in time — try again in a bit.');
          snapTimer = setTimeout(function () { snapPoll(who, n + 1); }, 1500);
        }).catch(function () { snapBox('Couldn\'t reach the site.'); });
    }
    function snapOpen(who, refresh) {
      clearTimeout(snapTimer); clearTimeout(saveTimer);
      snapWho = who;
      snapBox('Asking Pepe to open ' + label(who) + '\'s cam…');
      fetch('/api/rooms/' + encodeURIComponent(slug) + '/snap', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ login: who.login }) })
        .then(function (r) { return r.json().then(function (d) { return { st: r.status, d: d }; }); })
        .then(function (x) {
          if (snapWho !== who) return;
          if (!x.d.ok) return snapBox(x.d.error || 'Not right now.');
          snapPoll(who, 0);
        }).catch(function () { snapBox('Couldn\'t reach the site.'); });
    }
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') snapClose(); });

    // ── talk to the room (relayed by Pepe): text relay + hold-to-talk clips (public/js/room-bridge.js) ──
    var compose = document.getElementById('rmCompose'),
        pttHost = document.getElementById('rmPtt'), roomPtt = pttHost ? PATVRoom.ptt(pttHost, slug) : null;
    function renderCompose(d) {
      var r = d.room;
      compose.classList.toggle('hide', !(r.relay || r.micRelay));
      if (roomRelay) roomRelay.update(d);
      if (roomPtt) roomPtt.update(d);
    }

    function apply(d, first) {
      if (roomMod) roomMod.update(d);          // before the people list: it adds the manage buttons
      renderRoom(d);
      renderCompose(d);
      roomAudio.update(d);
      if (d.cursor < cursor) { feedEl.textContent = ''; cursor = 0; first = true; }   // the site restarted
      addFeed(d.feed, first);
      cursor = Math.max(cursor, d.cursor);
    }

    function poll() {
      timer = null;
      if (document.hidden) return;
      fetch('/api/rooms/' + encodeURIComponent(slug) + '/live?after=' + cursor, { credentials: 'same-origin', cache: 'no-store' })
        .then(function (r) { if (r.status === 401) { location.href = '/login'; throw new Error('signed out'); } if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
        .then(function (d) { fails = 0; setStatus(''); apply(d, false); })
        .catch(function () { fails++; setStatus(fails > 2 ? 'reconnecting…' : '', fails > 2); })
        .then(function () { schedule(); });
    }
    function setStatus(t, err) { var s = document.getElementById('rmStatus'); s.textContent = t; s.classList.toggle('err', !!err); }
    function schedule() { if (!timer && !document.hidden) timer = setTimeout(poll, fails ? Math.min(15000, 1500 * Math.pow(2, fails)) : 1500); }
    document.addEventListener('visibilitychange', function () { if (!document.hidden) { clearTimeout(timer); timer = null; poll(); } });

    apply(data, true);
    schedule();
  })();
  </script>
<% } %>
<% if (typeof feed !== 'undefined' && feed) { %><%- include('partials/room-feed', { feed, fx, embeds, host, room }) %><% } %>
</main>
