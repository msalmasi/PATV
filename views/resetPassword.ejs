<%# views/resetPassword.ejs - choose a new password from an emailed link (GET/POST /reset-password/:token in index.js) -%>
<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('auth.reset.page_title'), user: user }) %>
<%
  const F = (typeof form !== 'undefined' && form) ? form : {};
  const errs = (errors || []).filter(Boolean);
  const FIELDS = ['password', 'confirm_password'];
  const inline = errs.length && FIELDS.includes(F.field) ? F.field : null;
  const errFor = (n) => (inline === n ? errs.join(' ') : '');
  const inv = (n) => (inline === n ? ' aria-invalid="true"' : '');
%>
<%- include('partials/auth-css') %>
<main class="au">
  <section class="au-card" aria-labelledby="au-title">
    <div class="au-brand"><img src="/public/img/pepe.png" alt=""><span class="k">publicaccess.tv</span></div>
    <h1 id="au-title"><%- t('auth.reset.heading') %></h1>
    <p class="sub"><%- t('auth.reset.sub') %></p>

    <% if (errs.length && !inline) { %><div class="au-alert err" role="alert"><%= errs.join(' ') %></div><% } %>

    <form action="/reset-password/<%= encodeURIComponent(token) %>" method="POST" data-au-form>
      <div class="au-field">
        <label for="password"><%- t('auth.reset.new_password') %></label>
        <div class="au-pw">
          <input type="password" id="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password"
                 data-rule="newpass" data-caps="password-caps" data-meter="password-hint" data-autofocus
                 aria-describedby="password-hint password-caps password-err"<%- inv('password') %>>
          <button type="button" class="eye" aria-controls="password" aria-pressed="false" aria-label="<%- t('auth.show_password') %>"><%- t('auth.show') %></button>
        </div>
        <div class="au-hint" id="password-hint"><%- t('auth.password_hint') %></div>
        <div class="au-caps" id="password-caps" hidden><%- t('auth.caps_lock') %></div>
        <div class="au-err" id="password-err" aria-live="polite"><%= errFor('password') %></div>
      </div>
      <div class="au-field">
        <label for="confirm_password"><%- t('auth.reset.confirm_label') %></label>
        <div class="au-pw">
          <input type="password" id="confirm_password" name="confirm_password" required maxlength="72" autocomplete="new-password"
                 data-rule="match" data-match="password" data-caps="password-caps" aria-describedby="confirm_password-err"<%- inv('confirm_password') %>>
          <button type="button" class="eye" aria-controls="confirm_password" aria-pressed="false" aria-label="<%- t('auth.show_password') %>"><%- t('auth.show') %></button>
        </div>
        <div class="au-err" id="confirm_password-err" aria-live="polite"><%= errFor('confirm_password') %></div>
      </div>
      <button type="submit" class="au-btn" data-busy="<%- t('auth.reset.busy') %>"><span class="spin" aria-hidden="true"></span><span class="lbl"><%- t('auth.reset.submit') %></span></button>
    </form>
  </section>
  <p class="au-foot"><a href="/login"><%- t('auth.reset.back') %></a></p>
</main>
<%- include('partials/auth-js') %>
