<%- include('layout', { title: 'Wallet', user: user}) %>
<style>
  .wl { max-width: 980px; width: 100%; min-width: 0; box-sizing: border-box; margin: 0 auto; padding: 0 16px 48px; font-family: Ubuntu, sans-serif; overflow-wrap: anywhere; }
  .wl a { color: #81c784; }
  .wl h1 { text-align: center; margin-bottom: 4px; }
  .wl h2 { color: #ffd700; font-family: 'Press Start 2P', monospace; font-size: 12px; margin: 30px 0 10px; line-height: 1.6; }
  .wl h3 { margin: 18px 0 8px; font-size: 15px; color: #ddd; }
  .wl .bal { text-align: center; margin: 6px 0 4px; }
  .wl .bal b { font-size: 34px; color: #ffd700; font-variant-numeric: tabular-nums; }
  .wl .center { text-align: center; }
  .wl .info { color: #888; font-size: 13px; line-height: 1.6; }
  .wl .explain { background: #0d0d0d; border: 1px solid #222; border-radius: 10px; padding: 12px 14px; color: #bbb; font-size: 13px; line-height: 1.55; margin: 0 0 12px; }
  .wl .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 12px; }
  .wl .card { background: #111; border: 1px solid #222; border-radius: 10px; padding: 14px 16px; display: grid; gap: 10px; align-content: start; min-width: 0; }
  .wl .card.own { border-color: #4caf50; }
  .wl .card.admin { border-color: #e0a030; }
  .wl .ref { color: #e0a030; font-family: monospace; font-size: 13px; }
  .wl .name { font-weight: bold; color: #fff; font-size: 16px; }
  .wl .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 8px; }
  .wl .stat { background: #0d0d0d; border: 1px solid #1c1c1c; border-radius: 8px; padding: 8px 10px; min-width: 0; }
  .wl .stat span { display: block; color: #888; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; }
  .wl .stat b { color: #fff; font-size: 17px; font-variant-numeric: tabular-nums; }
  .wl .stat b.gold { color: #ffd700; } .wl .stat b.green { color: #81c784; } .wl .stat b.red { color: #e57373; }
  .wl .pill { font-size: 11px; padding: 2px 8px; border-radius: 10px; border: 1px solid #333; color: #ccc; display: inline-block; white-space: nowrap; }
  .wl .pill.on { border-color: #4caf50; color: #81c784; } .wl .pill.late, .wl .pill.off { border-color: #e57373; color: #e57373; }
  .wl form { display: grid; gap: 8px; margin: 0; }
  .wl form.inline { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .wl .forms { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 12px; margin-top: 12px; }
  .wl .forms > form { background: #111; border: 1px solid #222; border-radius: 10px; padding: 14px; align-content: start; }
  .wl .forms > form.admin { border-color: #e0a030; }
  .wl input[type=number], .wl input[type=text], .wl select { background: #0d0d0d; color: #eee; border: 1px solid #333; border-radius: 6px; padding: 7px 9px; box-sizing: border-box; max-width: 100%; font: inherit; font-size: 14px; }
  .wl form.inline input[type=text], .wl form.inline input[type=number] { width: 110px; flex: 1 1 90px; }
  .wl .forms input[type=text], .wl .forms input[type=number] { width: 100%; }
  .wl button { background: #4caf50; color: #fff; border: 0; border-radius: 6px; padding: 8px 14px; cursor: pointer; font: inherit; font-weight: bold; }
  .wl button.alt { background: #333; color: #ddd; }
  .wl button.danger { background: #5a2a2a; color: #f2b8b8; }
  .wl button.admin { background: #e0a030; color: #111; }
  .wl label { cursor: pointer; font-size: 13px; color: #ccc; }
  .wl details summary { cursor: pointer; color: #aaa; font-size: 13px; }
  .wl details[open] summary { margin-bottom: 8px; }
  .wl .hint { background: #1d1a0f; border: 1px solid #6b5a20; border-radius: 8px; padding: 10px 12px; color: #e8d9a0; font-size: 14px; }
  .wl .tbl { overflow-x: auto; border: 1px solid #222; border-radius: 8px; }
  .wl table { width: 100%; border-collapse: collapse; font-size: 13px; font-variant-numeric: tabular-nums; }
  .wl th, .wl td { padding: 7px 10px; border-bottom: 1px solid #1c1c1c; text-align: left; vertical-align: top; overflow-wrap: normal; }
  .wl td { color: #ddd; }
  .wl th { color: #888; font-weight: normal; white-space: nowrap; }
  .wl td.r, .wl th.r { text-align: right; white-space: nowrap; }
  .wl tr.tot td { color: #ffd700; font-weight: bold; border-top: 1px solid #333; }
  .wl .up { color: #81c784; } .wl .down { color: #e57373; }
  .wl .spark { background: #0d0d0d; border: 1px solid #222; border-radius: 8px; padding: 8px; margin: 10px 0; }
  .wl .spark svg { display: block; width: 100%; height: 70px; }
  .wl code { background: #1c1c1c; padding: 1px 5px; border-radius: 4px; }
  .wl .login { text-align: center; margin: 60px 0; }
  .wl .card.limit .name { font-size: 15px; line-height: 1.5; }
  .wl .card.limit b.lim { color: #ffd700; white-space: nowrap; }
  .wl table.bd td { padding: 5px 10px; }
  .wl table.bd td:first-child { overflow-wrap: anywhere; }
  .wl .credit { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; align-items: center; }
  .wl .credit .num { font-family: 'Press Start 2P', monospace; font-size: 22px; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .wl .credit .meter { grid-column: 1 / -1; height: 8px; border-radius: 4px; background: linear-gradient(90deg, #e57373 0%, #e0a030 45%, #c9d36a 64%, #81c784 80%, #4caf50 100%); position: relative; }
  .wl .credit .meter i { position: absolute; top: -4px; width: 4px; height: 16px; margin-left: -2px; background: #fff; border-radius: 2px; box-shadow: 0 0 0 2px #111; }
  .wl .band { font-size: 12px; padding: 2px 8px; border-radius: 10px; border: 1px solid #333; display: inline-block; white-space: nowrap; }
  .wl .band.excellent, .wl .band.very-good { border-color: #4caf50; color: #81c784; } .wl .band.good { border-color: #9ccc65; color: #c5e1a5; }
  .wl .band.fair { border-color: #e0a030; color: #ffcc80; } .wl .band.poor { border-color: #e57373; color: #e57373; }
  .wl ul.factors { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; font-size: 13px; }
  .wl ul.factors li { display: flex; justify-content: space-between; gap: 10px; color: #ccc; border-bottom: 1px solid #1c1c1c; padding: 3px 0; }
  .wl ul.factors b { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .wl .welcome { border-color: #6b5a20; }
</style>
<div class="wl">
<% if (!signedIn) { %>
  <h1>Wallet</h1>
  <div class="login">
    <p class="info">Your stashes, staking, loans and market positions live here.</p>
    <p><a href="/login">Sign in</a> to see your wallet.</p>
    <%- include('partials/actions', { acts: [], msg }) %>
  </div>
<% } else {
  const fmt = (n) => Math.round(Number(n) || 0).toLocaleString();
  const pct = (f, d) => ((Number(f) || 0) * 100).toFixed(d == null ? 1 : d) + '%';
  const when = (ts) => ts ? new Date(ts * 1000).toISOString().slice(0, 16).replace('T', ' ') : '';
  const day = (ts) => ts ? new Date(ts * 1000).toISOString().slice(5, 10) : '';
  const left = (t) => { const s = Math.max(0, Math.round(t - now)); return s >= 86400 ? Math.floor(s/86400) + 'd ' + Math.floor(s%86400/3600) + 'h' : s >= 3600 ? Math.floor(s/3600) + 'h ' + Math.floor(s%3600/60) + 'm' : s > 0 ? Math.max(1, Math.floor(s/60)) + 'm' : 'now'; };
  const cd = (t) => '<span data-until="' + Number(t) + '">' + left(t) + '</span>';
  const dur = (s) => { s = Number(s) || 0; return s >= 86400 ? +(s / 86400).toFixed(1) + 'd' : s >= 3600 ? Math.round(s / 3600) + 'h' : Math.round(s / 60) + 'm'; };
  const rate = (l) => l.rate_basis === 'week' ? l.rate + '%/week' : l.rate + '% flat';
  const canAct = !!camfrog;
  const hidden = (cmd) => '<input type="hidden" name="kind" value="cmd"><input type="hidden" name="cmd" value="' + cmd + '"><input type="hidden" name="back" value="/wallet"><input type="hidden" name="tag" value="wallet">';
  const LS = { offered: 'offer', accepting: 'accepting…', funding: 'funding…', active: 'active', repaid: 'repaid', forgiven: 'forgiven', declined: 'declined', cancelled: 'cancelled', expired: 'expired', failed: 'failed' };
  const terms = [1, 3, 7, 14, 30, 60, 90].filter((d) => !reserve || !reserve.max_days || d <= reserve.max_days);
  const VN = { bank: '🏦 Bank', house: '🎰 House', mm: '📈 Market maker', auto: '🤖 Auto' };
  const VK = ['bank', 'house', 'mm', 'auto'];
  const vaultSelect = '<select name="a3" aria-label="Vault">' + VK.map((k) => '<option value="' + k + '"' + (k === 'auto' ? ' selected' : '') + '>' + VN[k] + '</option>').join('') + '</select>';
  const holdLine = (h) => VK.filter((k) => h && h[k]).map((k) => VN[k] + ' ' + fmt(h[k].value)).join(' · ');
  const bandCls = (b) => String(b || '').toLowerCase().replace(/[^a-z]+/g, '-');
  const pts = (p) => (p > 0 ? '+' : p < 0 ? '−' : '±') + Math.abs(p);
  const meterPos = (s, c) => Math.max(0, Math.min(100, ((s - (c.min || 300)) / ((c.max || 850) - (c.min || 300))) * 100)).toFixed(1);
%>
  <h1>Wallet</h1>
  <p class="bal"><b><%= fmt(bal) %></b> PAT</p>
  <p class="center info"><%= camfrog ? 'Camfrog: ' + camfrog + ' · ' : '' %><a href="/history">PAT history ›</a></p>

  <%- include('partials/actions', { acts, msg }) %>
  <% if (welcomeStatus && welcomeStatus.state === 'pending') { const ws = welcomeStatus; %>
    <div class="card welcome" style="margin:12px 0">
      <span class="name">👋 Welcome bonus: PAT <%= fmt(ws.amount) %> — on its way</span>
      <% if (ws.need && ws.need.length) { %>
        <span class="info">It's paid once you've really played here (once per person, from the Federal Reserve). Still to do: <%= ws.need.join(' · ') %>.</span>
      <% } else { %>
        <span class="info">You've done it — it's paid within a few minutes<%= ws.enabled ? '' : ' (paused by the admins right now)' %>.</span>
      <% } %>
      <% if (ws.connectOwed) { %><span class="info">Your Discord/Twitch connect bonus is paid with it.</span><% } %>
    </div>
  <% } else if (welcomeStatus && welcomeStatus.state === 'paid') { %>
    <p class="center info">👋 Welcome bonus paid: PAT <%= fmt(welcomeStatus.amount) %>.</p>
  <% } %>
  <% if (!canAct) { %><p class="hint">Link your Camfrog name (<code>!verify</code>) to use stashes, staking and loans from here — Pepe runs them as you.</p><% } %>

  <!-- ───────── Stashes ───────── -->
  <h2>MY STASHES</h2>
  <% if (canAct) { %>
    <% if (!myStashes.length) { %><p class="info">You don't own or share a stash yet. A stash is a shared PAT account you can stake into the vaults for yield.</p><% } %>
    <div class="grid">
    <% myStashes.forEach((s) => { %>
      <div class="card<%= s.owner_me ? ' own' : '' %>">
        <span class="ref"><%= s.owner %>/<%= s.name %><%= s.owner_me ? ' · yours' : ' · member' %></span>
        <div class="stats">
          <div class="stat"><span>Balance</span><b class="gold"><%= fmt(s.balance) %></b></div>
          <div class="stat"><span>In vaults</span><b class="green"><%= fmt(s.vaulted) %></b></div>
        </div>
        <span class="info"><%= holdLine(s.hold) || 'Nothing staked in the vaults.' %></span>
        <span class="info">Members: <%= [s.owner].concat(s.members || []).join(', ') %></span>
        <form class="inline" method="post" action="/act"><%- hidden('stash') %>
          <select name="a0"><option value="deposit">Deposit</option><option value="withdraw">Withdraw</option></select>
          <input type="hidden" name="a1" value="<%= s.ref %>">
          <input type="text" name="a2" pattern="[Aa][Ll][Ll]|[0-9][0-9,]*[kKmM]?" placeholder="amount or all" required>
          <button type="submit">Go</button>
        </form>
        <form class="inline" method="post" action="/act"><%- hidden('stash') %>
          <select name="a0"><option value="stake">Stake</option><option value="unstake">Unstake</option></select>
          <input type="hidden" name="a1" value="<%= s.ref %>">
          <input type="text" name="a2" pattern="[Aa][Ll][Ll]|[0-9][0-9,]*[kKmM]?" placeholder="amount or all" required>
          <%- vaultSelect %>
          <button type="submit">Queue</button>
        </form>
        <span class="info">Stakes and unstakes run at the next daily cut-off at that day's price; a withdrawal waits if the vault has no free cash.</span>
        <% if (s.owner_me) { %>
          <details><summary>Members &amp; close</summary>
            <form class="inline" method="post" action="/act"><%- hidden('stash') %>
              <select name="a0"><option value="grant">Grant</option><option value="revoke">Revoke</option></select>
              <input type="hidden" name="a1" value="<%= s.name %>">
              <input type="text" name="a2" data-at maxlength="60" placeholder="@member" required>
              <button class="alt" type="submit">Apply</button>
            </form>
            <form class="inline" method="post" action="/act" style="margin-top:8px"><%- hidden('stash') %>
              <input type="hidden" name="a0" value="close"><input type="hidden" name="a1" value="<%= s.name %>">
              <label><input type="checkbox" required> Close <%= s.name %> (balance returns to you)</label>
              <button class="danger" type="submit">Close</button>
            </form>
          </details>
        <% } %>
      </div>
    <% }) %>
    </div>
    <div class="forms">
      <form method="post" action="/act"><%- hidden('stash') %>
        <b>➕ Create a stash</b>
        <input type="hidden" name="a0" value="create">
        <input type="text" name="a1" pattern="[a-z0-9_\-]{1,20}" maxlength="20" placeholder="name (a-z 0-9 _ -, up to 20)" required>
        <button type="submit">Create</button>
      </form>
    </div>
  <% } %>

  <!-- ───────── Staking ───────── -->
  <h2>STAKING</h2>
  <% if (!vaults) { %><p class="info">No staking numbers from Pepe yet. <a href="/staking">Staking dashboard ›</a></p><% } else {
       const ap = (f) => f == null ? '—' : pct(f); %>
    <div class="tbl"><table>
      <tr><th>Vault</th><th class="r">Share price</th><th class="r">APR 7d</th><th class="r">APR 30d</th></tr>
      <% VK.forEach((k) => { const a = (vaults.apr || {})[k] || {}; %>
        <tr><td><%= VN[k] %></td><td class="r"><%= (Number((vaults.prices || {})[k]) || 0).toFixed(4) %></td>
          <td class="r <%= a[7] == null ? '' : a[7] >= 0 ? 'up' : 'down' %>"><%= ap(a[7]) %></td><td class="r <%= a[30] == null ? '' : a[30] >= 0 ? 'up' : 'down' %>"><%= ap(a[30]) %></td></tr>
      <% }) %>
    </table></div>
    <p class="info"><%- vaults.next_epoch ? 'Next cut-off in ' + cd(vaults.next_epoch) + ' · ' : '' %><a href="/staking">Full staking dashboard ›</a></p>
  <% } %>

  <!-- ───────── Loans ───────── -->
  <h2>MY LOANS</h2>
  <% if (canAct) {
       const loanTable = (list, side) => { %>
    <div class="tbl"><table>
      <tr><th>Loan</th><th><%= side === 'b' ? 'Lender' : 'Borrower' %></th><th class="r">Principal</th><th>Rate</th><th class="r">Owed</th><th class="r">Paid</th><th class="r">Left</th><th>Due</th><th></th></tr>
      <% list.forEach((l) => { %>
        <tr>
          <td class="ref"><%= l.ref %> <span class="pill <%= l.status === 'active' ? 'on' : '' %>"><%= LS[l.status] || l.status %></span><%- l.late ? ' <span class="pill late">LATE</span>' : '' %></td>
          <td><%= side === 'b' ? (l.reserve ? '🏦 Federal Reserve' : l.lender) : l.borrower %></td>
          <td class="r"><%= fmt(l.principal) %></td><td><%= rate(l) %> · <%= dur(l.term) %></td>
          <td class="r"><%= fmt(l.owed) %><%= l.penalty ? ' (incl. ' + fmt(l.penalty) + ' late penalty)' : '' %></td><td class="r"><%= fmt(l.paid) %></td><td class="r"><b><%= fmt(l.left) %></b></td>
          <td><%- l.status === 'offered' && l.offer_until ? 'offer ends ' + cd(l.offer_until) : l.due ? (l.due > now ? cd(l.due) : '<span class="down">overdue</span>') : '' %></td>
          <td>
            <% if (side === 'b' && l.status === 'offered' && !l.reserve) { %>
              <form class="inline" method="post" action="/act"><%- hidden('loan') %><input type="hidden" name="a0" value="accept"><input type="hidden" name="a1" value="<%= l.ref %>"><button type="submit">Accept</button></form>
              <form class="inline" method="post" action="/act" style="margin-top:4px"><%- hidden('loan') %><input type="hidden" name="a0" value="decline"><input type="hidden" name="a1" value="<%= l.ref %>"><button class="alt" type="submit">Decline</button></form>
            <% } else if (side === 'b' && l.status === 'active') { %>
              <form class="inline" method="post" action="/act" style="flex-wrap:nowrap"><%- hidden('loan') %><input type="hidden" name="a0" value="repay"><input type="hidden" name="a1" value="<%= l.ref %>">
                <input type="number" name="a2" min="1" step="1" placeholder="all" style="width:90px"><button type="submit">Repay</button></form>
            <% } else if (side === 'l' && l.status === 'active' && !l.reserve) { %>
              <form class="inline" method="post" action="/act" style="flex-wrap:nowrap"><%- hidden('loan') %><input type="hidden" name="a0" value="forgive"><input type="hidden" name="a1" value="<%= l.ref %>">
                <label><input type="checkbox" required> sure</label><button class="danger" type="submit">Forgive</button></form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </table></div>
  <% }; %>
    <h3>Borrowed</h3>
    <% if (borrowed.length) loanTable(borrowed, 'b'); else { %><p class="info">You don't owe anyone.</p><% } %>
    <h3>Lent</h3>
    <% if (lent.length) loanTable(lent, 'l'); else { %><p class="info">No open loans you've made.</p><% } %>
    <div class="forms">
      <form method="post" action="/act" id="lend"><%- hidden('loan') %>
        <b>🤝 Lend to someone</b>
        <input type="text" name="a0" data-at maxlength="60" placeholder="@user" required aria-label="Borrower">
        <span class="info" id="lend-credit" aria-live="polite">Type a name to see their credit score.</span>
        <input type="text" name="a1" pattern="[0-9][0-9,]*[kKmM]?" placeholder="Amount, e.g. 10k" required aria-label="Amount">
        <input type="text" name="a2" pattern="[0-9]+(\.[0-9]+)?%?" placeholder="Interest %, e.g. 10%" required aria-label="Interest">
        <label>Term <select name="a3"><% [1, 3, 7, 14, 30].forEach((d) => { %><option value="<%= d %>d"<%= d === 7 ? ' selected' : '' %>><%= d %> day<%= d === 1 ? '' : 's' %></option><% }) %></select></label>
        <button type="submit">Offer loan</button>
        <span class="info">The amount is held from your balance until they accept (10 min) — same as <code>!loan @bob 10k 10% 7d</code>.</span>
      </form>
    </div>
    <% if (loanHistory.length) { %>
      <details style="margin-top:12px"><summary>Loan history (<%= loanHistory.length %>)</summary>
        <div class="tbl"><table>
          <tr><th>Loan</th><th>With</th><th class="r">Principal</th><th class="r">Paid</th><th>Status</th><th>Ended (UTC)</th></tr>
          <% loanHistory.forEach((l) => { %>
            <tr><td class="ref"><%= l.ref %></td><td><%= l.iBorrow ? 'from ' + (l.reserve ? 'Federal Reserve' : l.lender) : 'to ' + l.borrower %></td>
              <td class="r"><%= fmt(l.principal) %></td><td class="r"><%= fmt(l.paid) %></td><td><%= l.status %><%= l.late ? ' (late)' : '' %></td><td><%= when(l.ended || l.created) %></td></tr>
          <% }) %>
        </table></div>
      </details>
    <% } %>
  <% } %>

  <!-- ───────── Federal Reserve ───────── -->
  <h2>FEDERAL RESERVE</h2>
  <% if (!reserve) { %><p class="info">No Reserve numbers from Pepe yet.</p><% } else { %>
    <div class="stats">
      <div class="stat"><span>Rate</span><b><%= pct(reserve.rate_week) %>/week</b></div>
      <div class="stat"><span>Max term</span><b><%= reserve.max_days %> days</b></div>
      <div class="stat"><span>Lending</span><b class="<%= reserve.enabled ? 'green' : 'red' %>"><%= reserve.enabled ? 'open' : 'closed' %></b></div>
    </div>
    <% const ml = myLimit || { state: 'nodata' }; const bd = ml.breakdown; %>
    <div class="card limit<%= ml.state === 'ok' ? ' own' : '' %>" style="margin-top:12px">
      <% if (ml.state === 'nolink') { %>
        <span class="name">🏦 Your borrow limit</span>
        <span class="info"><a href="/u/<%= encodeURIComponent(user) %>/profile">Link your Camfrog name</a> (<code>!verify</code>) to borrow from the Federal Reserve.</span>
      <% } else if (ml.state === 'nodata') { %>
        <span class="name">🏦 Your borrow limit</span>
        <span class="info">Pepe hasn't sent your limit yet — <code>!loan reserve</code> in a room shows it.</span>
      <% } else if (ml.state === 'ok') { %>
        <span class="name">🏦 Federal Reserve — you can borrow up to <b class="lim">PAT <%= fmt(ml.limit) %></b> instantly</span>
        <span class="info"><%= pct(reserve.rate_week) %> a week (pro rata), for up to <%= reserve.max_days %> days. One Reserve loan open at a time.</span>
      <% } else { %>
        <span class="name">🏦 No instant Reserve loan right now</span>
        <span class="info down"><%= ml.reason.charAt(0).toUpperCase() + ml.reason.slice(1) %>.</span>
        <span class="info"><%= pct(reserve.rate_week) %> a week (pro rata), for up to <%= reserve.max_days %> days.</span>
      <% } %>
      <% if (bd) { %>
        <div class="tbl"><table class="bd">
          <tr><td>Base</td><td class="r"><%= fmt(bd.base) %></td></tr>
          <tr><td>Level <%= bd.level %> bonus (<%= fmt(reserve.per_level) %> a level)</td><td class="r">+ <%= fmt(bd.levelBonus) %></td></tr>
          <tr><td>Reserve loans repaid: <%= bd.repaid %> (+25% each, up to 2×)</td><td class="r">× <%= +bd.mult.toFixed(2) %></td></tr>
          <tr><td>Went late: <%= bd.lates %> (halves it each time)</td><td class="r <%= bd.lates ? 'down' : '' %>">× <%= +bd.penalty.toFixed(4) %></td></tr>
          <tr><td>Cap: <%= bd.capped === 'room' ? 'what the Reserve has left to lend' : 'biggest instant loan' %></td><td class="r"><%= fmt(bd.capped === 'room' ? bd.room : bd.maxAuto) %></td></tr>
          <tr class="tot"><td>Your instant limit<%= bd.capped ? ' (capped)' : '' %></td><td class="r"><%= fmt(ml.limit) %></td></tr>
        </table></div>
      <% } %>
    </div>
    <% if (myCredit) { const c = myCredit; %>
      <div class="card" id="credit" style="margin-top:12px">
        <span class="name">📊 Your credit score</span>
        <div class="credit">
          <span class="num"><%= c.score %></span>
          <span><span class="band <%= bandCls(c.band) %>"><%= c.band %></span> <span class="info">out of <%= c.min %>–<%= c.max %></span></span>
          <div class="meter" role="img" aria-label="Credit score <%= c.score %> of <%= c.max %>"><i style="left:<%= meterPos(c.score, c) %>%"></i></div>
        </div>
        <ul class="factors">
          <% c.factors.forEach((f) => { %>
            <li><span><%= f.label.charAt(0).toUpperCase() + f.label.slice(1) %></span><b class="<%= f.points > 0 ? 'up' : f.points < 0 ? 'down' : '' %>"><%= pts(f.points) %></b></li>
          <% }) %>
        </ul>
        <span class="info">From your loan history (personal and Federal Reserve loans), what you owe now against your level, your account's age and your level. Lenders and the admins see it when you borrow; it doesn't change your instant limit. Bands: 800+ Excellent · 740 Very good · 670 Good · 580 Fair · below Poor.</span>
      </div>
    <% } %>
    <% if (canAct && reserve.enabled) { %>
      <div class="forms">
        <% if (ml.state === 'ok' || ml.state === 'nodata') { %>
        <form method="post" action="/act"><%- hidden('loan') %>
          <b>🏦 Borrow from the Reserve</b>
          <input type="hidden" name="a0" value="reserve">
          <% if (ml.state === 'ok') { %>
            <input type="number" name="a1" min="<%= Math.min(reserve.min || 1, ml.limit) %>" max="<%= ml.limit %>" step="1" value="<%= ml.limit %>" placeholder="Amount (PAT)" aria-label="Amount (PAT)" required>
          <% } else { %>
            <input type="number" name="a1" min="1" step="1" placeholder="Amount (PAT)" required>
          <% } %>
          <label>Term <select name="a2"><% terms.forEach((d) => { %><option value="<%= d %>d"<%= d === 7 ? ' selected' : '' %>><%= d %> day<%= d === 1 ? '' : 's' %></option><% }) %></select></label>
          <button type="submit">Borrow</button>
          <span class="info"><%= ml.state === 'ok' ? 'Up to PAT ' + fmt(ml.limit) + ', paid out at once.' : 'Instant up to your limit (grows with level and repayments).' %> Interest <%= pct(reserve.rate_week) %> per week. Need more? <a href="#reserve-request">Request a bigger loan ›</a></span>
        </form>
        <% } %>
        <form method="post" action="/act" id="reserve-request"><%- hidden('loan') %>
          <b>📝 Ask the admins for a bigger loan</b>
          <input type="hidden" name="a0" value="request">
          <input type="number" name="a1" min="1" step="1" placeholder="Amount (PAT)" required>
          <label>Term <select name="a2"><% terms.forEach((d) => { %><option value="<%= d %>d"<%= d === 7 ? ' selected' : '' %>><%= d %> day<%= d === 1 ? '' : 's' %></option><% }) %></select></label>
          <input type="text" name="a3" maxlength="200" placeholder="What's it for?" required>
          <button type="submit">Send request</button>
        </form>
      </div>
    <% } %>
    <% if (canAct) { %>
      <div class="forms">
        <form method="post" action="/act" id="donate"><%- hidden('donate') %>
          <b>🎁 Give to the casino</b>
          <label>Into <select name="a0"><option value="casino">💰 Casino vault (what casino heists rob)</option><option value="lotto">🎟️ Lotto pot (the jackpot)</option><option value="house">🎰 House (the bankroll)</option></select></label>
          <input type="text" name="a1" pattern="[0-9][0-9,]*[kKmM]?" placeholder="Amount, e.g. 25k" required aria-label="Amount">
          <button type="submit">Donate</button>
          <span class="info">A gift, not a stake — it's gone from your wallet and Pepe thanks you in the room. Same as <code>!donate lotto 25k</code>.</span>
        </form>
      </div>
    <% } %>
    <% if (myRequests.length) { %>
      <h3>My requests</h3>
      <div class="tbl"><table>
        <tr><th>Request</th><th class="r">Amount</th><th>Term</th><th>Why</th><th>Status</th></tr>
        <% myRequests.forEach((r) => { %>
          <tr><td class="ref">LR<%= r.id %></td><td class="r"><%= fmt(r.amount) %></td><td><%= dur(r.term) %></td><td><%= r.why %></td>
            <td><%= r.status === 'approved' ? '✅ approved' + (r.loan ? ' → L' + r.loan : '') : r.status === 'denied' ? '❌ denied' + (r.deny_why ? ': ' + r.deny_why : '') : '⏳ ' + r.status %></td></tr>
        <% }) %>
      </table></div>
    <% } %>
  <% } %>

  <!-- ───────── Market positions ───────── -->
  <h2>MY MARKET POSITIONS</h2>
  <% if (!positions.length) { %><p class="info">No open share positions. <a href="/markets">Browse markets ›</a></p><% } else { %>
    <div class="tbl"><table>
      <tr><th>Market</th><th>Option</th><th class="r">Shares</th><th class="r">Entry</th><th class="r">Price</th><th class="r">Value</th><th class="r">P/L</th></tr>
      <% positions.forEach((p) => { p.mine.forEach((x, i) => { %>
        <tr><td><% if (i === 0) { %><a href="/markets/<%= p.id %>"><%= p.ref %></a> <%= p.question %><%= p.status !== 'open' ? ' (' + p.status + ')' : '' %><% } %></td>
          <td><%= x.option %></td><td class="r"><%= x.shares.toFixed(1) %></td><td class="r"><%= (x.entry * 100).toFixed(1) %>¢</td><td class="r"><%= (x.price * 100).toFixed(1) %>¢</td>
          <td class="r"><%= fmt(x.value) %></td><td class="r <%= x.pnl >= 0 ? 'up' : 'down' %>"><%= (x.pnl >= 0 ? '+' : '') + fmt(x.pnl) %></td></tr>
      <% }) }) %>
    </table></div>
    <p class="info">Entry = what you paid per share (cost ÷ shares). Price = today's market price; a winning share pays 1 PAT.</p>
  <% } %>

  <!-- ───────── Admin ───────── -->
  <% if (admin) { %>
    <h2>ADMIN · RESERVE REQUESTS</h2>
    <% if (!admin.pending.length) { %><p class="info">No pending loan requests.</p><% } %>
    <div class="grid">
      <% admin.pending.forEach((r) => { %>
        <div class="card admin">
          <span class="ref">LR<%= r.id %> · <%= r.status %> · <%= when(r.created) %> UTC</span>
          <span class="name"><%= r.nick %> wants <%= fmt(r.amount) %> PAT for <%= dur(r.term) %></span>
          <% const rc = r.creditLive; if (rc) { %>
            <span class="info">📊 Credit <b><%= rc.score %></b> <span class="band <%= bandCls(rc.band) %>"><%= rc.band %></span>
              <%= rc.factors.filter((f) => f.points).slice(0, 3).map((f) => f.label + ' (' + pts(f.points) + ')').join(' · ') %>
              <%= r.credit != null && r.credit !== rc.score ? '· was ' + r.credit + ' when asked' : '' %></span>
          <% } %>
          <span class="info">“<%= r.why %>”</span>
          <form class="inline" method="post" action="/act"><%- hidden('loan') %>
            <input type="hidden" name="a0" value="approve"><input type="hidden" name="a1" value="LR<%= r.id %>">
            <input type="number" name="a2" min="1" step="1" placeholder="<%= fmt(r.amount) %>" title="Amount (blank = as asked)">
            <input type="text" name="a3" pattern="[0-9]+[hdw]" placeholder="<%= dur(r.term) %>" title="Term like 7d (blank = as asked)">
            <input type="text" name="a4" pattern="[0-9]+(\.[0-9]+)?%?" placeholder="rate %" title="Rate % per week (blank = default)">
            <button class="admin" type="submit">Approve</button>
          </form>
          <form class="inline" method="post" action="/act"><%- hidden('loan') %>
            <input type="hidden" name="a0" value="deny"><input type="hidden" name="a1" value="LR<%= r.id %>">
            <input type="text" name="a2" maxlength="200" placeholder="Reason">
            <button class="danger" type="submit">Deny</button>
          </form>
        </div>
      <% }) %>
    </div>

    <h2>ADMIN · RESERVE BOOK</h2>
    <% if (reserve) { %>
      <div class="stats">
        <div class="stat"><span>Outstanding</span><b class="gold"><%= fmt(reserve.book) %></b></div>
        <div class="stat"><span>Room left</span><b class="green"><%= fmt(reserve.room) %></b></div>
        <div class="stat"><span>Active loans</span><b><%= admin.reserveLoans.length %></b></div>
      </div>
    <% } %>
    <% if (admin.reserveLoans.length) { %>
      <div class="tbl" style="margin-top:10px"><table>
        <tr><th>Loan</th><th>Borrower</th><th class="r">Principal</th><th class="r">Owed</th><th class="r">Paid</th><th class="r">Left</th><th>Due</th></tr>
        <% admin.reserveLoans.forEach((l) => { %>
          <tr><td class="ref"><%= l.ref %><%- l.late ? ' <span class="pill late">LATE</span>' : '' %></td><td><%= l.borrower %></td><td class="r"><%= fmt(l.principal) %></td>
            <td class="r"><%= fmt(l.owed) %></td><td class="r"><%= fmt(l.paid) %></td><td class="r"><%= fmt(l.left) %></td><td><%- l.due ? (l.due > now ? cd(l.due) : '<span class="down">overdue</span>') : '' %></td></tr>
        <% }) %>
      </table></div>
    <% } %>
    <div class="forms">
      <form class="admin" method="post" action="/act"><%- hidden('loan') %>
        <b>🏦 Grant a Reserve loan</b>
        <input type="hidden" name="a0" value="grant">
        <input type="text" name="a1" data-at maxlength="60" placeholder="@user" required>
        <input type="number" name="a2" min="1" step="1" placeholder="Amount (PAT)" required>
        <input type="text" name="a3" pattern="[0-9]+[hdw]" placeholder="Term, e.g. 7d" required>
        <button class="admin" type="submit">Grant</button>
      </form>
    </div>

    <h2>ADMIN · ALL STASHES</h2>
    <% if (!admin.stashes.length) { %><p class="info">No stashes.</p><% } else { %>
      <div class="tbl"><table>
        <tr><th>Stash</th><th class="r">Balance</th><th class="r">In vaults</th><th>Holdings</th><th>Members</th></tr>
        <% admin.stashes.forEach((s) => { %>
          <tr><td><%= s.owner %>/<%= s.name %></td><td class="r"><%= fmt(s.balance) %></td><td class="r"><%= fmt(s.vaulted) %></td>
            <td><%= holdLine(s.hold) %></td><td><%= (s.members || []).join(', ') %></td></tr>
        <% }) %>
        <tr class="tot"><td><%= admin.stashes.length %> stashes</td><td class="r"><%= fmt(admin.totals.balance) %></td><td class="r"><%= fmt(admin.totals.vaulted) %></td><td></td><td></td></tr>
      </table></div>
    <% } %>
  <% } %>

  <script>
    (function () {
      const fmt = (s) => s >= 86400 ? Math.floor(s/86400) + 'd ' + Math.floor(s%86400/3600) + 'h' : s >= 3600 ? Math.floor(s/3600) + 'h ' + Math.floor(s%3600/60) + 'm' : s >= 60 ? Math.floor(s/60) + 'm ' + (s%60) + 's' : s > 0 ? s + 's' : 'now';
      const tick = () => document.querySelectorAll('[data-until]').forEach((el) => { el.textContent = fmt(Math.max(0, Math.round(Number(el.dataset.until) - Date.now() / 1000))); });
      tick(); setInterval(tick, 1000);
      const who = document.querySelector('#lend input[name=a0]'), out = document.getElementById('lend-credit');
      if (who && out) {
        let t = null, last = '';
        const look = () => {
          const v = who.value.trim().replace(/^@+/, '');
          if (!v || v === last) return;
          last = v;
          out.textContent = 'Looking up ' + v + '…';
          fetch('/wallet/credit?u=' + encodeURIComponent(v), { credentials: 'same-origin' }).then((r) => r.json()).then((d) => {
            if (who.value.trim().replace(/^@+/, '') !== v) return;
            out.textContent = d.error ? d.error : ('📊 ' + d.name + "'s credit: " + d.score + ' ' + d.band
              + (d.top && d.top.length ? ' — ' + d.top.map((f) => f.label + ' (' + (f.points > 0 ? '+' : '') + f.points + ')').join(', ') : ''));
          }).catch(() => { out.textContent = "Couldn't look that up."; });
        };
        who.addEventListener('input', () => { clearTimeout(t); t = setTimeout(look, 450); });
        who.addEventListener('change', look);
      }
      document.querySelectorAll('form').forEach((f) => f.addEventListener('submit', () => {
        f.querySelectorAll('[data-at]').forEach((i) => { const v = i.value.trim().replace(/^@+/, ''); if (v) i.value = '@' + v; });
      }));
    })();
  </script>
<% } %>
</div>
</body>
</html>
