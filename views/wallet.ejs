<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('wallet.title'), user: user}) %>
<%# 1.99lx design pass: the wallet in the newer pages' look (/premium, /lotto, the banner) - balance up front, quick actions,
    recent activity, stashes + staking explained. Every form, field and anchor (#lend #reserve-request #credit #donate)
    is the same as before. 1.99xs: the ADMIN sections (#admin-requests #admin-book #admin-stashes) moved to /admin/economy#loans. -%>
<style>
  /* 1.99pr polish: .ds-page + ds tokens; the page classes below only keep what is wallet-specific */
  .wl { gap: var(--ds-sp-6); }
  .wl section.sec { display: grid; gap: var(--ds-sp-3); min-width: 0; scroll-margin-top: 72px; }
  .wl .sec-h { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--ds-sp-1h) var(--ds-sp-3); }
  .wl .sec-h .ds-pixel-h { flex: 1 1 auto; }
  .wl .sec-h a.info { color: var(--ds-green-2); font-weight: 500; }
  .wl h3 { margin: var(--ds-sp-1) 0 0; font: 700 var(--ds-fs-h4)/var(--ds-lh-h4) var(--ds-font); color: var(--ds-text); }
  .wl .center { text-align: center; }
  .wl a:not(.ds-btn):not(.ds-tab) { text-decoration: none; } .wl a:not(.ds-btn):not(.ds-tab):hover { text-decoration: underline; }
  .wl .info { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); line-height: 1.55; }
  .wl p.info { margin: 0; }
  /* hero */
  .wl .hero { gap: var(--ds-sp-3); }
  .wl .hero .bal { flex-wrap: wrap; gap: 4px 10px; }
  .wl .hero .who { color: var(--ds-text-2); font-size: var(--ds-fs-meta); margin: 0; }
  .wl .hero .ds-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 560px; }
  .wl .hero .ds-stat > b { font-size: clamp(15px, 4.4vw, 18px); }
  .wl .hero .ds-stat > b.up { color: var(--ds-ok); } .wl .hero .ds-stat > b.down { color: var(--ds-danger-solid); }
  .wl .quick { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2); }
  .wl .quick .ds-btn.pink:hover { --b-line: var(--ds-acc-support); }
  .wl .login { display: grid; gap: var(--ds-sp-2); margin: var(--ds-sp-2) 0 0; }
  .wl .login p { margin: 0; }
  /* cards */
  .wl .two { align-items: start; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--ds-sp-3); }
  .wl .col { display: grid; gap: var(--ds-sp-3); align-content: start; min-width: 0; }
  .wl .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: var(--ds-sp-3); }
  .wl .card { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); display: grid; gap: var(--ds-sp-2h); align-content: start; min-width: 0; margin: 0; }
  .wl .card.own { border-color: var(--ds-green-line); background: linear-gradient(180deg, var(--ds-green-bg) 0%, var(--ds-surface) 45%); }
  .wl .card.welcome { border-color: var(--ds-gold-line); background: linear-gradient(180deg, var(--ds-gold-bg), transparent 45%), var(--ds-surface); }
  .wl .card-h { display: flex; align-items: center; justify-content: space-between; gap: var(--ds-sp-2); flex-wrap: wrap; }
  .wl .card-h b { font: 700 var(--ds-fs-h3)/var(--ds-lh-h3) var(--ds-font); color: var(--ds-text-strong); }
  .wl .ref { color: var(--ds-acc-wagers-2); font-family: var(--ds-font-mono); font-size: var(--ds-fs-mono); }
  .wl .name { font-weight: 700; color: var(--ds-text-strong); font-size: var(--ds-fs-h4); line-height: var(--ds-lh-h4); }
  .wl b.gold { color: var(--ds-gold-text); } .wl .ds-stat > b.green { color: var(--ds-ok); } .wl .ds-stat > b.red { color: var(--ds-danger-solid); }
  .wl .pill { font: 700 11px/1.6 var(--ds-font); padding: 1px 8px; border-radius: var(--ds-r-pill); border: 1px solid var(--ds-line-strong); color: #ccc; display: inline-block; white-space: nowrap; font-family: var(--ds-font); }
  .wl .pill.on { border-color: var(--ds-ok-line); color: var(--ds-ok); background: var(--ds-ok-bg); } .wl .pill.late, .wl .pill.off { border-color: var(--ds-danger-line); color: var(--ds-danger); background: var(--ds-danger-bg); }
  /* forms (fields keep their names; the page styles them instead of the legacy global input/button rules) */
  .wl .card, .wl .forms > form { grid-template-columns: minmax(0, 1fr); }
  .wl .card > label, .wl .forms > form > label { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ds-sp-1h) var(--ds-sp-2); }
  .wl .card > label select, .wl .forms > form > label select { flex: 1 1 160px; min-width: 0; width: 100%; }
  .wl form { display: grid; gap: var(--ds-sp-2h); margin: 0; }
  .wl form.inline { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2); align-items: center; }
  .wl .row { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2); }
  .wl .forms { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: var(--ds-sp-3); }
  .wl .forms > form { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); align-content: start; }
  .wl .forms > form > b:first-of-type { color: var(--ds-text-strong); font-size: var(--ds-fs-h4); }
  .wl input[type=number], .wl input[type=text], .wl select { box-sizing: border-box; margin: 0; background: var(--ds-sunken); color: #eee; border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-md);
       padding: 10px 12px; min-height: var(--ds-tap); max-width: 100%; min-width: 0; font: 400 15px/1.3 var(--ds-font); }
  .wl input[type=number]:hover, .wl input[type=text]:hover, .wl select:hover { border-color: #444; }
  .wl input[type=number]:focus, .wl input[type=text]:focus, .wl select:focus { border-color: var(--ds-ac); box-shadow: 0 0 0 3px var(--ds-ac-bg); outline: none; }
  .wl input::placeholder { color: #777; }
  .wl input[type=checkbox] { width: 20px; height: 20px; margin: 0; accent-color: var(--ds-ac); }
  .wl form.inline input[type=text], .wl form.inline input[type=number] { width: 110px; flex: 1 1 90px; }
  .wl .forms input[type=text], .wl .forms input[type=number], .wl .card > input[type=text] { width: 100%; }
  .wl button { display: inline-flex; align-items: center; justify-content: center; gap: var(--ds-sp-2); margin: 0; min-height: var(--ds-tap); padding: 0 var(--ds-sp-5);
       border: 1px solid transparent; border-radius: var(--ds-r-pill); background: var(--ds-green); color: var(--ds-on-ac); font: 700 15px/1.1 var(--ds-font); cursor: pointer; white-space: nowrap;
       transition: filter var(--ds-dur-1); }
  .wl button:hover { filter: brightness(1.1); }
  .wl button:disabled, .wl button[aria-busy="true"] { filter: grayscale(.6) brightness(.7); cursor: not-allowed; }
  .wl button.alt { background: #1c1c1f; color: var(--ds-text); border-color: #2c2c2c; }
  .wl button.danger { background: var(--ds-danger-fill); color: var(--ds-danger-ink); border-color: var(--ds-danger-line); }
  .wl button.gold { background: var(--ds-gold-grad); color: var(--ds-on-gold); }
  .wl form.inline button, .wl td button { min-height: 36px; padding: 0 var(--ds-sp-3h); font-size: 13.5px; }
  .wl label { cursor: pointer; font-size: var(--ds-fs-meta); color: var(--ds-text-2); }
  .wl details summary { background: none; padding: 0; border: 0; list-style-position: inside; cursor: pointer; color: var(--ds-text-2); font-size: var(--ds-fs-sm); min-height: 36px; display: flex; align-items: center; gap: var(--ds-sp-2); }
  .wl details[open] > summary { margin-bottom: var(--ds-sp-2); }
  .wl .hint { margin: 0; }
  /* tables: .ds-tbl does the box; these are the wallet's column rules */
  .wl .ds-tbl td { vertical-align: top; }
  .wl .ds-tbl td.q { min-width: 200px; max-width: 320px; overflow-wrap: break-word; }
  .wl .ds-tbl td.q a { font-family: var(--ds-font-mono); font-size: var(--ds-fs-mono); }
  .wl .ds-tbl td.opt { min-width: 90px; }
  .wl .ds-tbl td.ln { min-width: 160px; }
  .wl .up { color: var(--ds-ok); } .wl .down { color: var(--ds-danger-solid); }
  .wl .card.limit .name { line-height: 1.5; }
  .wl .card.limit b.lim { color: var(--ds-gold-text); white-space: nowrap; }
  .wl table.bd td { padding: 6px 10px; }
  .wl table.bd td:first-child { overflow-wrap: anywhere; }
  .wl .credit { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--ds-sp-1h) var(--ds-sp-3h); align-items: center; }
  .wl .credit .num { font-family: var(--ds-font-pixel); font-size: 22px; line-height: 1.2; color: var(--ds-text-strong); }
  .wl .credit .meter { grid-column: 1 / -1; height: 8px; border-radius: var(--ds-r-pill); background: linear-gradient(90deg, #e57373 0%, #e0a030 45%, #c9d36a 64%, #81c784 80%, #4caf50 100%); position: relative; }
  .wl .credit .meter i { position: absolute; top: -4px; width: 4px; height: 16px; margin-inline-start: -2px; background: #fff; border-radius: 2px; box-shadow: 0 0 0 2px #111; }
  [dir="rtl"] .wl .credit .meter { transform: scaleX(-1); }
  .wl .band { font: 700 12px/1.5 var(--ds-font); padding: 1px 8px; border-radius: var(--ds-r-pill); border: 1px solid var(--ds-line-strong); display: inline-block; white-space: nowrap; }
  .wl .band.excellent, .wl .band.very-good { border-color: var(--ds-ok-line); color: var(--ds-ok); } .wl .band.good { border-color: #9ccc65; color: #c5e1a5; }
  .wl .band.fair { border-color: var(--ds-warn-line); color: var(--ds-warn); } .wl .band.poor { border-color: var(--ds-danger-line); color: var(--ds-danger-solid); }
  .wl ul.factors { margin: 0; padding: 0; list-style: none; display: grid; font-size: var(--ds-fs-meta); }
  .wl ul.factors li { display: flex; justify-content: space-between; gap: var(--ds-sp-2h); color: var(--ds-text-2); border-bottom: 1px solid var(--ds-line-soft); padding: 6px 0; }
  .wl ul.factors li:last-child { border-bottom: 0; }
  .wl ul.factors b { white-space: nowrap; font-variant-numeric: tabular-nums; }
  /* recent activity */
  .wl ul.acts { list-style: none; margin: 0; padding: 0; display: grid; }
  .wl ul.acts li { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; gap: var(--ds-sp-2h); align-items: center; min-height: var(--ds-tap); padding: var(--ds-sp-2) 0; border-bottom: 1px solid var(--ds-line-soft); }
  .wl ul.acts li:last-child { border-bottom: 0; }
  .wl ul.acts .tx { min-width: 0; font-size: var(--ds-fs-sm); line-height: 1.35; }
  .wl ul.acts .tx small { display: block; color: var(--ds-text-faint); font-size: var(--ds-fs-xs); }
  .wl ul.acts .am { font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; font-size: var(--ds-fs-sm); }
  /* how-it-works strip */
  .wl details.card > summary b { color: var(--ds-text-strong); font-size: var(--ds-fs-h4); }
  .wl .how { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: var(--ds-sp-2h); }
  .wl .how > div { background: var(--ds-sunken); border: 1px solid var(--ds-line-soft); border-radius: var(--ds-r-lg); padding: var(--ds-sp-3) var(--ds-sp-3h); display: grid; gap: var(--ds-sp-1); align-content: start; }
  .wl .how > div b { color: var(--ds-text-strong); font-size: var(--ds-fs-h4); }
  .wl .how > div p { margin: 0; color: var(--ds-text-muted); font-size: var(--ds-fs-meta); line-height: 1.5; }
  /* vault tiles */
  .wl .vaults { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: var(--ds-sp-3); }
  .wl .vt { background: var(--ds-surface); border: 1px solid var(--ds-line); border-top: 3px solid var(--c, var(--ds-green)); border-radius: var(--ds-r-xl); padding: var(--ds-sp-3) var(--ds-sp-4); display: grid; gap: var(--ds-sp-1h); min-width: 0; }
  .wl .vt .vn { font-weight: 700; color: var(--ds-text-strong); }
  .wl .vt .px { font-size: 22px; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--ds-gold-text); line-height: 1.2; }
  .wl .vt .px small { font-size: 11px; color: var(--ds-text-muted); font-weight: 700; display: block; text-transform: uppercase; letter-spacing: var(--ds-ls-label); }
  .wl .vt .aprs { display: flex; flex-wrap: wrap; gap: 2px 12px; font-size: var(--ds-fs-meta); color: var(--ds-text-muted); font-variant-numeric: tabular-nums; }
  /* the shared partials, in the wallet's look (donate-card is shared with /shop, so it's styled from here) */
  .wl .act-notice, .wl .act-box { margin: 0; }
  .wl .donate-card { margin: 0 !important; border-radius: var(--ds-r-xl) !important; padding: var(--ds-sp-4) !important; background: var(--ds-surface) !important; border-color: #6a3d6a !important; gap: var(--ds-sp-2h) !important; }
  .wl .donate-card h2 { font: 700 var(--ds-fs-h3)/var(--ds-lh-h3) var(--ds-font) !important; }
  .wl .donate-card p { color: var(--ds-text-2) !important; }
  .wl .donate-card a.btn { display: inline-flex; align-items: center; min-height: 36px; padding: 0 var(--ds-sp-3h); border-radius: var(--ds-r-pill); border: 1px solid var(--ds-line-strong); color: var(--ds-text) !important; font-weight: 700; text-decoration: none; }
  .wl .donate-card a.btn:hover { border-color: var(--ds-acc-support); }
  .wl .donate-card input[type=number] { width: 7em; }
  @media (max-width: 760px) { .wl input[type=number], .wl input[type=text], .wl select { font-size: 16px; } }
  @media (prefers-reduced-motion: no-preference) { html:has(.wl) { scroll-behavior: smooth; } }
  @media (prefers-reduced-motion: reduce) { .wl button { transition: none; } }
</style>
<main class="ds-page wl">
<% if (!signedIn) { %>
  <section class="ds-hero gold hero">
    <div class="ds-eyebrow"><%- t('wallet.eyebrow') %></div>
    <h1><%- t('wallet.title') %></h1>
    <div class="login">
      <p class="ds-lead"><%- t('wallet.signed_out') %></p>
      <p><%- t('wallet.sign_in_to_see', { link: '<a href="/login">' + t('wallet.sign_in') + '</a>' }) %></p>
    </div>
  </section>
  <%- include('partials/actions', { acts: [], msg }) %>
<% } else {
  const fmt = (n) => Math.round(Number(n) || 0).toLocaleString();
  const pct = (f, d) => ((Number(f) || 0) * 100).toFixed(d == null ? 1 : d) + '%';
  // 1.99jx: in the viewer's zone with its label (tz.js); print with the raw tag
  const when = (ts) => ts ? (locals.tzTime || new Function(include('../tz-core.js'))()('UTC', 'en').time)(ts, 'datetime') : '';
  const day = (ts) => ts ? new Date(ts * 1000).toISOString().slice(5, 10) : '';
  const left = (tt) => { const s = Math.max(0, Math.round(tt - now)); return s >= 86400 ? Math.floor(s/86400) + 'd ' + Math.floor(s%86400/3600) + 'h' : s >= 3600 ? Math.floor(s/3600) + 'h ' + Math.floor(s%3600/60) + 'm' : s > 0 ? Math.max(1, Math.floor(s/60)) + 'm' : t('wallet.now'); };
  const cd = (t) => '<span data-until="' + Number(t) + '">' + left(t) + '</span>';
  const dur = (s) => { s = Number(s) || 0; return s >= 86400 ? +(s / 86400).toFixed(1) + 'd' : s >= 3600 ? Math.round(s / 3600) + 'h' : Math.round(s / 60) + 'm'; };
  const rate = (l) => l.rate_basis === 'week' ? t('wallet.rate_week', { r: l.rate }) : t('wallet.rate_flat', { r: l.rate });   // HTML-safe
  // 1.99wr (connections audit A): each section shows where its service works for THIS account - loans and the Federal
  // Reserve run by account on the site; stashes + vault staking still belong to a chat login (explained below)
  const linked = typeof locals.linked === 'boolean' ? locals.linked : !!camfrog;
  const canLoan = linked || !!locals.loansOn;
  const canReserve = linked || !!locals.reserveOn;
  const canDonate = linked || !!locals.donateOn;
  const hidden = (cmd) => '<input type="hidden" name="kind" value="cmd"><input type="hidden" name="cmd" value="' + cmd + '"><input type="hidden" name="back" value="/wallet"><input type="hidden" name="tag" value="wallet">';
  const LS = { offered: t('wallet.ls.offered'), accepting: t('wallet.ls.accepting'), funding: t('wallet.ls.funding'), active: t('wallet.ls.active'), repaid: t('wallet.ls.repaid'), forgiven: t('wallet.ls.forgiven'), declined: t('wallet.ls.declined'), cancelled: t('wallet.ls.cancelled'), expired: t('wallet.ls.expired'), failed: t('wallet.ls.failed') };   // HTML-safe
  const stName = (s) => t.has('wallet.status.' + s) ? t('wallet.status.' + s) : t.esc(s);
  const bandName = (b) => { const k = 'wallet.band.' + bandCls(b).replace(/-/g, '_'); return t.has(k) ? t(k) : t.esc(b); };
  const days_ = (d) => t('wallet.n_days', { count: d });
  const terms = [1, 3, 7, 14, 30, 60, 90].filter((d) => !reserve || !reserve.max_days || d <= reserve.max_days);
  const VN = { bank: '🏦 ' + t('wallet.vault.bank'), house: '🎰 ' + t('wallet.vault.house'), mm: '📈 ' + t('wallet.vault.mm'), auto: '🤖 ' + t('wallet.vault.auto') };   // HTML-safe
  const VC = { bank: '#64b5f6', house: '#e57373', mm: '#ffd54f', auto: '#4caf50' };
  const VK = ['bank', 'house', 'mm', 'auto'];
  const vaultSelect = '<select name="a3" aria-label="' + t('wallet.vault') + '">' + VK.map((k) => '<option value="' + k + '"' + (k === 'auto' ? ' selected' : '') + '>' + VN[k] + '</option>').join('') + '</select>';
  const holdLine = (h) => VK.filter((k) => h && h[k]).map((k) => VN[k] + ' ' + fmt(h[k].value)).join(' · ');
  const bandCls = (b) => String(b || '').toLowerCase().replace(/[^a-z]+/g, '-');
  const pts = (p) => (p > 0 ? '+' : p < 0 ? '−' : '±') + Math.abs(p);
  const meterPos = (s, c) => Math.max(0, Math.min(100, ((s - (c.min || 300)) / ((c.max || 850) - (c.min || 300))) * 100)).toFixed(1);
  const inStashes = myStashes.reduce((a, s) => a + (Number(s.balance) || 0), 0);
  const inVaults = myStashes.reduce((a, s) => a + (Number(s.vaulted) || 0), 0);
  const iOwe = borrowed.reduce((a, l) => a + (Number(l.left) || 0), 0);
  const RECENT = typeof recent !== 'undefined' && Array.isArray(recent) ? recent : [];
  const tmOf = (it) => { const ts = new Date(String(it.timestamp).replace(' ', 'T') + 'Z'); return (locals.tzTime || new Function(include('../tz-core.js'))()('UTC', 'en').time)(ts, 'datetime'); };
%>
  <!-- ───────── Balance + quick actions ───────── -->
  <section class="ds-hero gold hero" aria-labelledby="wlH">
    <div class="ds-eyebrow"><%- t('wallet.eyebrow') %></div>
    <h1 id="wlH" class="bal ds-pat xl"><b><%= fmt(bal) %></b> <span>PAT</span></h1>
    <p class="who"><%- camfrog ? t('wallet.hero.camfrog', { name: camfrog }) + ' · ' : '' %><a href="/history"><%- t('wallet.history_link') %></a> · <a href="/subscriptions"><span class="ds-ic" aria-hidden="true">🔁</span> <%- t('subs.title') %></a></p>
    <% if (linked || canLoan) { %>
    <div class="ds-stats">
      <div class="ds-stat"><span><%- t('wallet.hero.in_stashes') %></span><b><%= fmt(inStashes) %></b></div>
      <div class="ds-stat"><span><%- t('wallet.hero.in_vaults') %></span><b class="up"><%= fmt(inVaults) %></b></div>
      <div class="ds-stat"><span><%- t('wallet.hero.owed') %></span><b class="<%= iOwe ? 'down' : '' %>"><%= fmt(iOwe) %></b></div>
    </div>
    <% } %>
    <nav class="quick" aria-label="<%- t('wallet.act.label') %>">
      <a class="ds-btn gold sm" href="#send"><span class="ds-ic" aria-hidden="true">💸</span> <%- t('wallet.act.send') %></a>
      <a class="ds-btn ghost sm" href="#stashes"><span class="ds-ic" aria-hidden="true">🔐</span> <%- t('wallet.act.stashes') %></a>
      <a class="ds-btn ghost sm" href="/history"><span class="ds-ic" aria-hidden="true">🧾</span> <%- t('wallet.act.history') %></a>
      <a class="ds-btn ghost sm pink" href="/support"><span class="ds-ic" aria-hidden="true">💖</span> <%- t('wallet.act.support') %></a>
    </nav>
  </section>

  <%- include('partials/actions', { acts, msg }) %>
  <% if (welcomeStatus && welcomeStatus.state === 'pending') { const ws = welcomeStatus; %>
    <div class="card welcome">
      <span class="name"><span class="ds-ic" aria-hidden="true">👋</span> <%- t('wallet.welcome.pending', { n: fmt(ws.amount) }) %></span>
      <% if (ws.need && ws.need.length) { %>
        <span class="info"><%- t('wallet.welcome.need', { need: ws.need.join(' · ') }) %></span>
      <% } else { %>
        <span class="info"><%- ws.enabled ? t('wallet.welcome.done') : t('wallet.welcome.done_paused') %></span>
      <% } %>
      <% if (ws.connectOwed) { %><span class="info"><%- t('wallet.welcome.connect') %></span><% } %>
    </div>
  <% } else if (welcomeStatus && welcomeStatus.state === 'paid') { %>
    <p class="center info"><span class="ds-ic" aria-hidden="true">👋</span> <%- t('wallet.welcome.paid', { n: fmt(welcomeStatus.amount) }) %></p>
  <% } %>
  <% if (!linked && !locals.stashOn) { %><p class="ds-note hint"><%- t('wallet.link_hint') %></p><% } %>

  <nav class="ds-subnav" aria-label="<%- t('wallet.nav.label') %>"><div class="ds-tabs">
    <a class="ds-tab" href="#activity"><%- t('wallet.nav.activity') %></a>
    <a class="ds-tab" href="#stashes"><%- t('wallet.nav.stashes') %></a>
    <a class="ds-tab" href="#staking"><%- t('wallet.nav.staking') %></a>
    <% if (canLoan) { %><a class="ds-tab" href="#loans"><%- t('wallet.nav.loans') %></a><% } %>
    <a class="ds-tab" href="#reserve"><%- t('wallet.nav.reserve') %></a>
    <a class="ds-tab" href="#positions"><%- t('wallet.nav.markets') %></a>
    <%# 1.99xs: the admins' Reserve desk (requests, the book, all stashes) lives on /admin/economy#loans %>
    <% if (locals.isAdmin) { %><a class="ds-tab" href="/admin/economy#loans">🛠️ <%- t('wallet.nav.admin') %></a><% } %>
  </div></nav>

  <!-- ───────── Recent activity · send / tip · give ───────── -->
  <section class="sec" id="activity" aria-labelledby="actH">
    <div class="two">
      <div class="card">
        <div class="card-h"><b id="actH"><span class="ds-ic" aria-hidden="true">🕒</span> <%- t('wallet.recent.h') %></b><a href="/history"><%- t('wallet.recent.all') %></a></div>
        <% if (!RECENT.length) { %><p class="info"><%- t('wallet.recent.none') %></p><% } else { %>
          <ul class="acts">
            <% RECENT.forEach((it) => { %>
              <li><span class="ds-ic tile" aria-hidden="true"><%= it.icon %></span>
                <span class="tx"><%= it.text %><% if (it.cp && it.cpPrep !== null) { %> <%= it.cpPrep %> <%= it.cp.name %><% } %><small><%- tmOf(it) %></small></span>
                <span class="am <%= it.points >= 0 ? 'up' : 'down' %>"><%= (it.points >= 0 ? '+' : '−') + Math.abs(it.points).toLocaleString() %></span></li>
            <% }) %>
          </ul>
        <% } %>
      </div>
      <div class="col">
        <form class="card" id="send" method="get" action="/search" role="search" aria-labelledby="sendH">
          <b id="sendH" class="name"><span class="ds-ic" aria-hidden="true">💸</span> <%- t('wallet.send.h') %></b>
          <span class="info"><%- t('wallet.send.blurb') %></span>
          <div class="row">
            <input type="text" name="q" id="sendTo" maxlength="60" autocomplete="off" placeholder="<%- t('wallet.send.ph') %>" aria-label="<%- t('wallet.send.ph') %>" required style="flex:1 1 160px">
            <button class="gold" type="submit"><%- t('wallet.send.go') %></button>
          </div>
          <span class="info"><a href="/u/<%= encodeURIComponent(user) %>/tip"><%- t('wallet.send.jar') %></a></span>
        </form>
        <% if (canDonate) { %>
          <form class="card" method="post" action="/act" id="donate"><%- hidden('donate') %>
            <b class="name"><span class="ds-ic" aria-hidden="true">🎁</span> <%- t('wallet.donate.h') %></b>
            <label><%- t('wallet.donate.into') %> <select name="a0"><option value="casino">💰 <%- t('wallet.donate.casino') %></option><option value="lotto">🎟️ <%- t('wallet.donate.lotto') %></option><option value="house">🎰 <%- t('wallet.donate.house') %></option><option value="fortknox">🪙 <%- t('wallet.donate.fortknox') %></option></select></label>
            <input type="text" name="a1" pattern="[0-9][0-9,]*[kKmM]?" placeholder="<%- t('wallet.donate.amount_ph') %>" required aria-label="<%- t('wallet.amount') %>">
            <button type="submit"><%- t('wallet.donate.button') %></button>
            <span class="info"><%- t('wallet.donate.what') %></span>
            <span class="info"><%- t('wallet.donate.info') %></span>
          </form>
        <% } %>
      </div>
    </div>
    <%- include('partials/donate-card', { donate: locals.donate }) %>
  </section>

  <!-- ───────── Stashes ───────── -->
  <% if (!linked && !locals.stashOn) { %>
  <section class="sec" id="stashes" aria-labelledby="stH">
    <div class="sec-h"><h2 id="stH" class="ds-pixel-h"><%- t('wallet.h.stashes') %></h2><a class="info" href="/economy#stash"><%- t('wallet.stash.more') %></a></div>
    <p class="ds-note hint"><%- t('wallet.stash.need_chat', { link: '<a href="/settings/account#connections">' + t('wallet.connections') + '</a>' }) %></p>
  </section>
  <% } else { %>
  <section class="sec" id="stashes" aria-labelledby="stH">
    <div class="sec-h"><h2 id="stH" class="ds-pixel-h"><%- t('wallet.h.stashes') %></h2><a class="info" href="/economy#stash"><%- t('wallet.stash.more') %></a></div>
    <details class="card" <%= myStashes.length ? '' : 'open' %>>
      <summary><b><span class="ds-ic" aria-hidden="true">💡</span> <%- t('wallet.how.h') %></b></summary>
      <div class="how">
        <div><span class="ds-ic lg" aria-hidden="true">👛</span><b>1 · <%- t('wallet.how.wallet_h') %></b><p><%- t('wallet.how.wallet') %></p></div>
        <div><span class="ds-ic lg" aria-hidden="true">🔐</span><b>2 · <%- t('wallet.how.stash_h') %></b><p><%- t('wallet.how.stash') %></p></div>
        <div><span class="ds-ic lg" aria-hidden="true">📈</span><b>3 · <%- t('wallet.how.stake_h') %></b><p><%- t('wallet.how.stake') %></p></div>
      </div>
      <span class="info"><%- t('wallet.stash.stake_info') %></span>
    </details>
    <% if (!myStashes.length) { %><p class="info"><%- t('wallet.stash.none') %></p><% } %>
    <div class="grid">
    <% myStashes.forEach((s) => { %>
      <div class="card<%= s.owner_me ? ' own' : '' %>">
        <div class="card-h"><span class="ref"><%- ul(s.owner) %>/<%= s.name %></span><span class="pill<%= s.owner_me ? ' on' : '' %>"><%- s.owner_me ? t('wallet.stash.yours') : t('wallet.stash.member') %></span></div>
        <div class="ds-stats">
          <div class="ds-stat"><span><%- t('wallet.balance') %></span><b class="gold"><%= fmt(s.balance) %></b></div>
          <div class="ds-stat"><span><%- t('wallet.in_vaults') %></span><b class="green"><%= fmt(s.vaulted) %></b></div>
        </div>
        <span class="info"><%- holdLine(s.hold) || t('wallet.stash.nothing_staked') %></span>
        <span class="info"><%- t('wallet.stash.members', { list: [s.owner_name || s.owner].concat(s.member_names || s.members || []).join(', ') }) %></span>
        <form class="inline" method="post" action="/act"><%- hidden('stash') %>
          <select name="a0" aria-label="<%- t('wallet.stash.deposit') %> / <%- t('wallet.stash.withdraw') %>"><option value="deposit"><%- t('wallet.stash.deposit') %></option><option value="withdraw"><%- t('wallet.stash.withdraw') %></option></select>
          <input type="hidden" name="a1" value="<%= s.ref %>">
          <input type="text" name="a2" pattern="[Aa][Ll][Ll]|[0-9][0-9,]*[kKmM]?" placeholder="<%- t('wallet.stash.amount_or_all') %>" aria-label="<%- t('wallet.amount') %>" required>
          <button type="submit"><%- t('wallet.stash.go') %></button>
        </form>
        <form class="inline" method="post" action="/act"><%- hidden('stash') %>
          <select name="a0" aria-label="<%- t('wallet.stash.stake') %> / <%- t('wallet.stash.unstake') %>"><option value="stake"><%- t('wallet.stash.stake') %></option><option value="unstake"><%- t('wallet.stash.unstake') %></option></select>
          <input type="hidden" name="a1" value="<%= s.ref %>">
          <input type="text" name="a2" pattern="[Aa][Ll][Ll]|[0-9][0-9,]*[kKmM]?" placeholder="<%- t('wallet.stash.amount_or_all') %>" aria-label="<%- t('wallet.amount') %>" required>
          <%- vaultSelect %>
          <button type="submit"><%- t('wallet.stash.queue') %></button>
        </form>
        <% if (s.owner_me) { %>
          <details><summary><%- t('wallet.stash.members_close') %></summary>
            <form class="inline" method="post" action="/act"><%- hidden('stash') %>
              <select name="a0" aria-label="<%- t('wallet.stash.grant') %> / <%- t('wallet.stash.revoke') %>"><option value="grant"><%- t('wallet.stash.grant') %></option><option value="revoke"><%- t('wallet.stash.revoke') %></option></select>
              <input type="hidden" name="a1" value="<%= s.name %>">
              <input type="text" name="a2" data-at maxlength="60" placeholder="@member" aria-label="@member" required>
              <button class="alt" type="submit"><%- t('wallet.stash.apply') %></button>
            </form>
            <form class="inline" method="post" action="/act" style="margin-top:8px"><%- hidden('stash') %>
              <input type="hidden" name="a0" value="close"><input type="hidden" name="a1" value="<%= s.name %>">
              <label><input type="checkbox" required> <%- t('wallet.stash.close_confirm', { name: s.name }) %></label>
              <button class="danger" type="submit"><%- t('wallet.stash.close') %></button>
            </form>
          </details>
        <% } %>
      </div>
    <% }) %>
    </div>
    <div class="forms">
      <form method="post" action="/act"><%- hidden('stash') %>
        <b><span class="ds-ic" aria-hidden="true">➕</span> <%- t('wallet.stash.create_h') %></b>
        <input type="hidden" name="a0" value="create">
        <input type="text" name="a1" pattern="[a-z0-9_\-]{1,20}" maxlength="20" placeholder="<%- t('wallet.stash.name_ph') %>" aria-label="<%- t('wallet.stash.name_ph') %>" required>
        <button type="submit"><%- t('wallet.stash.create') %></button>
      </form>
    </div>
  </section>
  <% } %>

  <!-- ───────── Staking ───────── -->
  <section class="sec" id="staking" aria-labelledby="skH">
    <div class="sec-h"><h2 id="skH" class="ds-pixel-h"><%- t('wallet.h.staking') %></h2><a class="info" href="/staking"><%- t('wallet.staking.full_dashboard') %></a></div>
    <% if (!vaults) { %><p class="info"><%- t('wallet.staking.none') %> <a href="/staking"><%- t('wallet.staking.dashboard') %></a></p><% } else {
         const ap = (f) => f == null ? '—' : pct(f); %>
      <p class="info"><%- t('wallet.staking.lead') %></p>
      <div class="vaults">
        <% VK.forEach((k) => { const a = (vaults.apr || {})[k] || {}; %>
          <div class="vt" style="--c:<%= VC[k] %>">
            <span class="vn"><%- VN[k] %></span>
            <span class="px"><small><%- t('wallet.staking.share_price') %></small><%= (Number((vaults.prices || {})[k]) || 0).toFixed(4) %></span>
            <span class="aprs"><span><%- t('wallet.staking.apr7') %> <b class="<%= a[7] == null ? '' : a[7] >= 0 ? 'up' : 'down' %>"><%= ap(a[7]) %></b></span>
              <span><%- t('wallet.staking.apr30') %> <b class="<%= a[30] == null ? '' : a[30] >= 0 ? 'up' : 'down' %>"><%= ap(a[30]) %></b></span></span>
          </div>
        <% }) %>
      </div>
      <% if (vaults.next_epoch) { %><p class="info"><span class="ds-ic" aria-hidden="true">⏱️</span> <%- t('wallet.staking.next_cutoff', { when: cd(vaults.next_epoch) }) %></p><% } %>
    <% } %>
  </section>

  <!-- ───────── Loans ───────── -->
  <% if (canLoan) {
       const loanTable = (list, side) => { %>
    <div class="ds-tbl"><table>
      <tr><th><%- t('wallet.loan.loan') %></th><th><%- side === 'b' ? t('wallet.loan.lender') : t('wallet.loan.borrower') %></th><th class="r"><%- t('wallet.loan.principal') %></th><th><%- t('wallet.loan.rate') %></th><th class="r"><%- t('wallet.loan.owed') %></th><th class="r"><%- t('wallet.loan.paid') %></th><th class="r"><%- t('wallet.loan.left') %></th><th><%- t('wallet.loan.due') %></th><th></th></tr>
      <% list.forEach((l) => { %>
        <tr>
          <td class="ref"><%= l.ref %> <span class="pill <%= l.status === 'active' ? 'on' : '' %>"><%- LS[l.status] || t.esc(l.status) %></span><%- l.late ? ' <span class="pill late">' + t('wallet.loan.late_pill') + '</span>' : '' %></td>
          <td><%- side === 'b' ? (l.reserve ? '🏦 ' + t('wallet.fed') : ul(l.lender)) : ul(l.borrower) %></td>
          <td class="r"><%= fmt(l.principal) %></td><td><%- rate(l) %> · <%= dur(l.term) %></td>
          <td class="r"><%= fmt(l.owed) %><%- l.penalty ? ' ' + t('wallet.loan.incl_penalty', { n: fmt(l.penalty) }) : '' %></td><td class="r"><%= fmt(l.paid) %></td><td class="r"><b><%= fmt(l.left) %></b></td>
          <td><%- l.status === 'offered' && l.offer_until ? t('wallet.loan.offer_ends', { when: cd(l.offer_until) }) : l.due ? (l.due > now ? cd(l.due) : '<span class="down">' + t('wallet.loan.overdue') + '</span>') : '' %></td>
          <td>
            <% if (side === 'b' && l.status === 'offered' && !l.reserve) { %>
              <form class="inline" method="post" action="/act"><%- hidden('loan') %><input type="hidden" name="a0" value="accept"><input type="hidden" name="a1" value="<%= l.ref %>"><button type="submit"><%- t('wallet.loan.accept') %></button></form>
              <form class="inline" method="post" action="/act" style="margin-top:4px"><%- hidden('loan') %><input type="hidden" name="a0" value="decline"><input type="hidden" name="a1" value="<%= l.ref %>"><button class="alt" type="submit"><%- t('wallet.loan.decline') %></button></form>
            <% } else if (side === 'b' && l.status === 'active') { %>
              <form class="inline" method="post" action="/act" style="flex-wrap:nowrap"><%- hidden('loan') %><input type="hidden" name="a0" value="repay"><input type="hidden" name="a1" value="<%= l.ref %>">
                <input type="number" name="a2" min="1" step="1" placeholder="<%- t('wallet.loan.all') %>" aria-label="<%- t('wallet.amount') %>" style="width:90px"><button type="submit"><%- t('wallet.loan.repay') %></button></form>
            <% } else if (side === 'l' && l.status === 'active' && !l.reserve) { %>
              <form class="inline" method="post" action="/act" style="flex-wrap:nowrap"><%- hidden('loan') %><input type="hidden" name="a0" value="forgive"><input type="hidden" name="a1" value="<%= l.ref %>">
                <label><input type="checkbox" required> <%- t('wallet.loan.sure') %></label><button class="danger" type="submit"><%- t('wallet.loan.forgive') %></button></form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </table></div>
  <% }; %>
  <section class="sec" id="loans" aria-labelledby="lnH">
    <div class="sec-h"><h2 id="lnH" class="ds-pixel-h"><%- t('wallet.h.loans') %></h2></div>
    <h3><%- t('wallet.loan.borrowed') %></h3>
    <% if (borrowed.length) loanTable(borrowed, 'b'); else { %><p class="info"><%- t('wallet.loan.owe_none') %></p><% } %>
    <h3><%- t('wallet.loan.lent') %></h3>
    <% if (lent.length) loanTable(lent, 'l'); else { %><p class="info"><%- t('wallet.loan.lent_none') %></p><% } %>
    <div class="forms">
      <form method="post" action="/act" id="lend"><%- hidden('loan') %>
        <b><span class="ds-ic" aria-hidden="true">🤝</span> <%- t('wallet.lend.h') %></b>
        <input type="text" name="a0" data-at maxlength="60" placeholder="@user" required aria-label="<%- t('wallet.loan.borrower') %>">
        <span class="info" id="lend-credit" aria-live="polite"><%- t('wallet.lend.credit_hint') %></span>
        <input type="text" name="a1" pattern="[0-9][0-9,]*[kKmM]?" placeholder="<%- t('wallet.lend.amount_ph') %>" required aria-label="<%- t('wallet.amount') %>">
        <input type="text" name="a2" pattern="[0-9]+(\.[0-9]+)?%?" placeholder="<%- t('wallet.lend.interest_ph') %>" required aria-label="<%- t('wallet.lend.interest') %>">
        <label><%- t('wallet.term') %> <select name="a3"><% [1, 3, 7, 14, 30].forEach((d) => { %><option value="<%= d %>d"<%= d === 7 ? ' selected' : '' %>><%- days_(d) %></option><% }) %></select></label>
        <button type="submit"><%- t('wallet.lend.offer') %></button>
        <span class="info"><%- t('wallet.lend.info') %></span>
      </form>
    </div>
    <% if (loanHistory.length) { %>
      <details><summary><%- t('wallet.hist.summary', { n: loanHistory.length }) %></summary>
        <div class="ds-tbl"><table>
          <tr><th><%- t('wallet.loan.loan') %></th><th><%- t('wallet.hist.with') %></th><th class="r"><%- t('wallet.loan.principal') %></th><th class="r"><%- t('wallet.loan.paid') %></th><th><%- t('wallet.status') %></th><th><%- t('wallet.hist.ended') %></th></tr>
          <% loanHistory.forEach((l) => { %>
            <tr><td class="ref"><%= l.ref %></td><td><%- l.iBorrow ? t('wallet.hist.from', { who: l.reserve ? t('wallet.fed') : ul(l.lender) }) : t('wallet.hist.to', { who: ul(l.borrower) }) %></td>
              <td class="r"><%= fmt(l.principal) %></td><td class="r"><%= fmt(l.paid) %></td><td><%- stName(l.status) %><%- l.late ? ' ' + t('wallet.hist.late') : '' %></td><td><%- when(l.ended || l.created) %></td></tr>
          <% }) %>
        </table></div>
      </details>
    <% } %>
  </section>
  <% } %>

  <!-- ───────── Federal Reserve ───────── -->
  <section class="sec" id="reserve" aria-labelledby="rsH">
    <div class="sec-h"><h2 id="rsH" class="ds-pixel-h"><%- t('wallet.h.reserve') %></h2></div>
  <% if (!reserve) { %><p class="info"><%- t('wallet.reserve.none') %></p><% } else { %>
    <div class="ds-stats">
      <div class="ds-stat"><span><%- t('wallet.loan.rate') %></span><b><%- t('wallet.reserve.per_week', { rate: pct(reserve.rate_week) }) %></b></div>
      <div class="ds-stat"><span><%- t('wallet.reserve.max_term') %></span><b><%- t('wallet.reserve.max_days', { n: reserve.max_days }) %></b></div>
      <div class="ds-stat"><span><%- t('wallet.reserve.lending') %></span><b class="<%= reserve.enabled ? 'green' : 'red' %>"><%- reserve.enabled ? t('wallet.reserve.open') : t('wallet.reserve.closed') %></b></div>
    </div>
    <% const ml = myLimit || { state: 'nodata' }; const bd = ml.breakdown; %>
    <div class="two">
    <div class="card limit<%= ml.state === 'ok' ? ' own' : '' %>">
      <% if (ml.state === 'nolink') { %>
        <span class="name"><span class="ds-ic" aria-hidden="true">🏦</span> <%- t('wallet.limit.h') %></span>
        <span class="info"><%- t('wallet.limit.nolink', { link: '<a href="/u/' + t.esc(encodeURIComponent(user)) + '">' + t('wallet.limit.link_name') + '</a>' }) %></span>
      <% } else if (ml.state === 'nodata') { %>
        <span class="name"><span class="ds-ic" aria-hidden="true">🏦</span> <%- t('wallet.limit.h') %></span>
        <span class="info"><%- t('wallet.limit.nodata') %></span>
      <% } else if (ml.state === 'ok') { %>
        <span class="name"><span class="ds-ic" aria-hidden="true">🏦</span> <%- t('wallet.limit.ok', { amount: '<b class="lim">PAT ' + t.esc(fmt(ml.limit)) + '</b>' }) %></span>
        <span class="info"><%- t('wallet.limit.terms_one', { rate: pct(reserve.rate_week), days: reserve.max_days }) %></span>
      <% } else { %>
        <span class="name"><span class="ds-ic" aria-hidden="true">🏦</span> <%- t('wallet.limit.no_instant') %></span>
        <span class="info down"><%= ml.reason.charAt(0).toUpperCase() + ml.reason.slice(1) %>.</span>
        <span class="info"><%- t('wallet.limit.terms', { rate: pct(reserve.rate_week), days: reserve.max_days }) %></span>
      <% } %>
      <% if (bd) { %>
        <div class="ds-tbl"><table class="bd">
          <tr><td><%- t('wallet.bd.base') %></td><td class="r"><%= fmt(bd.base) %></td></tr>
          <tr><td><%- t('wallet.bd.level', { level: bd.level, per: fmt(reserve.per_level) }) %></td><td class="r">+ <%= fmt(bd.levelBonus) %></td></tr>
          <tr><td><%- t('wallet.bd.repaid', { n: bd.repaid }) %></td><td class="r">× <%= +bd.mult.toFixed(2) %></td></tr>
          <tr><td><%- t('wallet.bd.lates', { n: bd.lates }) %></td><td class="r <%= bd.lates ? 'down' : '' %>">× <%= +bd.penalty.toFixed(4) %></td></tr>
          <tr><td><%- bd.capped === 'room' ? t('wallet.bd.cap_room') : t('wallet.bd.cap_auto') %></td><td class="r"><%= fmt(bd.capped === 'room' ? bd.room : bd.maxAuto) %></td></tr>
          <tr class="tot"><td><%- bd.capped ? t('wallet.bd.limit_capped') : t('wallet.bd.limit') %></td><td class="r"><%= fmt(ml.limit) %></td></tr>
        </table></div>
      <% } %>
    </div>
    <% if (myCredit) { const c = myCredit; %>
      <div class="card" id="credit">
        <span class="name"><span class="ds-ic" aria-hidden="true">📊</span> <%- t('wallet.credit.h') %></span>
        <div class="credit">
          <span class="num"><%= c.score %></span>
          <span><span class="band <%= bandCls(c.band) %>"><%- bandName(c.band) %></span> <span class="info"><%- t('wallet.credit.out_of', { min: c.min, max: c.max }) %></span></span>
          <div class="meter" role="img" aria-label="<%- t('wallet.credit.aria', { score: c.score, max: c.max }) %>"><i style="left:<%= meterPos(c.score, c) %>%"></i></div>
        </div>
        <ul class="factors">
          <% c.factors.forEach((f) => { %>
            <li><span><%= f.label.charAt(0).toUpperCase() + f.label.slice(1) %></span><b class="<%= f.points > 0 ? 'up' : f.points < 0 ? 'down' : '' %>"><%= pts(f.points) %></b></li>
          <% }) %>
        </ul>
        <span class="info"><%- t('wallet.credit.info') %></span>
      </div>
    <% } %>
    </div>
    <% if (canReserve && reserve.enabled) { %>
      <div class="forms">
        <% if (ml.state === 'ok' || ml.state === 'nodata') { %>
        <form method="post" action="/act"><%- hidden('loan') %>
          <b><span class="ds-ic" aria-hidden="true">🏦</span> <%- t('wallet.borrow.h') %></b>
          <input type="hidden" name="a0" value="reserve">
          <% if (ml.state === 'ok') { %>
            <input type="number" name="a1" min="<%= Math.min(reserve.min || 1, ml.limit) %>" max="<%= ml.limit %>" step="1" value="<%= ml.limit %>" placeholder="<%- t('wallet.amount_pat') %>" aria-label="<%- t('wallet.amount_pat') %>" required>
          <% } else { %>
            <input type="number" name="a1" min="1" step="1" placeholder="<%- t('wallet.amount_pat') %>" aria-label="<%- t('wallet.amount_pat') %>" required>
          <% } %>
          <label><%- t('wallet.term') %> <select name="a2"><% terms.forEach((d) => { %><option value="<%= d %>d"<%= d === 7 ? ' selected' : '' %>><%- days_(d) %></option><% }) %></select></label>
          <button type="submit"><%- t('wallet.borrow.button') %></button>
          <span class="info"><%- ml.state === 'ok' ? t('wallet.borrow.up_to', { n: fmt(ml.limit) }) : t('wallet.borrow.instant') %> <%- t('wallet.borrow.interest', { rate: pct(reserve.rate_week) }) %> <a href="#reserve-request"><%- t('wallet.borrow.request_link') %></a></span>
        </form>
        <% } %>
        <form method="post" action="/act" id="reserve-request"><%- hidden('loan') %>
          <b><span class="ds-ic" aria-hidden="true">📝</span> <%- t('wallet.request.h') %></b>
          <input type="hidden" name="a0" value="request">
          <input type="number" name="a1" min="1" step="1" placeholder="<%- t('wallet.amount_pat') %>" aria-label="<%- t('wallet.amount_pat') %>" required>
          <label><%- t('wallet.term') %> <select name="a2"><% terms.forEach((d) => { %><option value="<%= d %>d"<%= d === 7 ? ' selected' : '' %>><%- days_(d) %></option><% }) %></select></label>
          <input type="text" name="a3" maxlength="200" placeholder="<%- t('wallet.request.why_ph') %>" aria-label="<%- t('wallet.request.why_ph') %>" required>
          <button type="submit"><%- t('wallet.request.send') %></button>
        </form>
      </div>
    <% } %>
    <% if (myRequests.length) { %>
      <h3><%- t('wallet.myreq.h') %></h3>
      <div class="ds-tbl"><table>
        <tr><th><%- t('wallet.myreq.request') %></th><th class="r"><%- t('wallet.amount') %></th><th><%- t('wallet.term') %></th><th><%- t('wallet.myreq.why') %></th><th><%- t('wallet.status') %></th></tr>
        <% myRequests.forEach((r) => { %>
          <tr><td class="ref">LR<%= r.id %></td><td class="r"><%= fmt(r.amount) %></td><td><%= dur(r.term) %></td><td><%= r.why %></td>
            <td><%- r.status === 'approved' ? '✅ ' + t('wallet.myreq.approved') + t.esc(r.loan ? ' → L' + r.loan : '') : r.status === 'denied' ? '❌ ' + t('wallet.myreq.denied') + t.esc(r.deny_why ? ': ' + r.deny_why : '') : '⏳ ' + stName(r.status) %></td></tr>
        <% }) %>
      </table></div>
    <% } %>
  <% } %>
  </section>

  <!-- ───────── Market positions ───────── -->
  <section class="sec" id="positions" aria-labelledby="psH">
    <div class="sec-h"><h2 id="psH" class="ds-pixel-h"><%- t('wallet.h.positions') %></h2><a class="info" href="/markets"><%- t('wallet.pos.browse') %></a></div>
  <% if (!positions.length) { %><p class="info"><%- t('wallet.pos.none') %></p><% } else { %>
    <div class="ds-tbl"><table>
      <tr><th><%- t('wallet.pos.market') %></th><th><%- t('wallet.pos.option') %></th><th class="r"><%- t('wallet.pos.shares') %></th><th class="r"><%- t('wallet.pos.entry') %></th><th class="r"><%- t('wallet.pos.price') %></th><th class="r"><%- t('wallet.pos.value') %></th><th class="r"><%- t('wallet.pos.pl') %></th></tr>
      <% positions.forEach((p) => { p.mine.forEach((x, i) => { %>
        <tr><td class="q"><% if (i === 0) { %><a href="/markets/<%= p.id %>"><%= p.ref %></a> <%= p.question %><%- p.status !== 'open' ? ' (' + stName(p.status) + ')' : '' %><% } %></td>
          <td class="opt"><%= x.option %></td><td class="r"><%= x.shares.toFixed(1) %></td><td class="r"><%= (x.entry * 100).toFixed(1) %>¢</td><td class="r"><%= (x.price * 100).toFixed(1) %>¢</td>
          <td class="r"><%= fmt(x.value) %></td><td class="r <%= x.pnl >= 0 ? 'up' : 'down' %>"><%= (x.pnl >= 0 ? '+' : '') + fmt(x.pnl) %></td></tr>
      <% }) }) %>
    </table></div>
    <p class="info"><%- t('wallet.pos.info') %></p>
  <% } %>
  <% const settledP = typeof settledPositions !== 'undefined' ? settledPositions : []; %>
  <% if (settledP.length) { %>
    <h3><%- t('wallet.settled.h') %></h3>
    <div class="ds-tbl"><table class="settled-pos">
      <tr><th><%- t('wallet.pos.market') %></th><th><%- t('wallet.pos.option') %></th><th class="r"><%- t('wallet.pos.shares') %></th><th class="r"><%- t('wallet.settled.cost') %></th><th class="r"><%- t('wallet.loan.paid') %></th><th class="r"><%- t('wallet.pos.pl') %></th><th><%- t('wallet.settled.result') %></th></tr>
      <% settledP.forEach((p) => { p.mine.forEach((x, i) => { %>
        <tr><td class="q"><% if (i === 0) { %><a href="/markets/<%= p.id %>"><%= p.ref %></a> <%= p.question %><% } %></td>
          <td class="opt"><%= x.option %></td><td class="r"><%= x.shares.toFixed(1) %></td><td class="r"><%= fmt(x.cost) %></td>
          <td class="r"><%= x.state === 'lost' ? '0' : fmt(x.payout) + ' PAT' %></td>
          <td class="r <%= x.pnl >= 0 ? 'up' : 'down' %>"><%= (x.pnl >= 0 ? '+' : '') + fmt(x.pnl) %></td>
          <td><%- x.state === 'won' ? '🏆 ' + t('wallet.settled.won') : x.state === 'lost' ? t('wallet.settled.lost') : t('wallet.settled.refunded') %></td></tr>
      <% }) }) %>
    </table></div>
    <p class="info"><%- t('wallet.settled.info') %></p>
  <% } %>
  </section>

  <script>
    (function () {
      var _t = typeof __t === 'function' ? __t : function (k, d, v) { return String(d).replace(/\{!?(\w+)\}/g, function (m, n) { return v && v[n] != null ? v[n] : m; }); };
      const fmt = (s) => s >= 86400 ? Math.floor(s/86400) + 'd ' + Math.floor(s%86400/3600) + 'h' : s >= 3600 ? Math.floor(s/3600) + 'h ' + Math.floor(s%3600/60) + 'm' : s >= 60 ? Math.floor(s/60) + 'm ' + (s%60) + 's' : s > 0 ? s + 's' : _t('js.wallet.now', 'now');
      const tick = () => document.querySelectorAll('[data-until]').forEach((el) => { el.textContent = fmt(Math.max(0, Math.round(Number(el.dataset.until) - Date.now() / 1000))); });
      tick(); setInterval(tick, 1000);
      // 💸 Send or tip: straight to that member's tip page (without JS the form searches for them)
      const send = document.getElementById('send');
      if (send) send.addEventListener('submit', (e) => {
        const v = String(document.getElementById('sendTo').value || '').trim().replace(/^@+/, '');
        if (!/^[A-Za-z0-9_.\-]{1,60}$/.test(v)) return;
        e.preventDefault();
        location.href = '/u/' + encodeURIComponent(v) + '/tip';
      });
      const who = document.querySelector('#lend input[name=a0]'), out = document.getElementById('lend-credit');
      if (who && out) {
        let t = null, last = '';
        const look = () => {
          const v = who.value.trim().replace(/^@+/, '');
          if (!v || v === last) return;
          last = v;
          out.textContent = _t('js.wallet.looking_up', 'Looking up {name}…', { name: v });
          fetch('/wallet/credit?u=' + encodeURIComponent(v), { credentials: 'same-origin' }).then((r) => r.json()).then((d) => {
            if (who.value.trim().replace(/^@+/, '') !== v) return;
            out.textContent = d.error ? d.error : ('📊 ' + _t('js.wallet.credit_of', "{name}'s credit: {score} {band}", { name: d.name, score: d.score, band: d.band })
              + (d.top && d.top.length ? ' — ' + d.top.map((f) => f.label + ' (' + (f.points > 0 ? '+' : '') + f.points + ')').join(', ') : ''));
          }).catch(() => { out.textContent = _t('js.wallet.lookup_failed', "Couldn't look that up."); });
        };
        who.addEventListener('input', () => { clearTimeout(t); t = setTimeout(look, 450); });
        who.addEventListener('change', look);
      }
      document.querySelectorAll('form').forEach((f) => f.addEventListener('submit', () => {
        f.querySelectorAll('[data-at]').forEach((i) => { const v = i.value.trim().replace(/^@+/, ''); if (v) i.value = '@' + v; });
      }));
    })();
  </script>
<% } %>
</main>
</body>
</html>
