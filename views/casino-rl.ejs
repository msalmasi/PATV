<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', {title:t('casino.rl.title'),user:user}) %>
<%- include('partials/casino-css') %>
<%- include('partials/casino-rl-css') %>
<link rel="stylesheet" href="/public/css/room-mod.css?v=10"><link rel="stylesheet" href="/public/css/pad-dock.css?v=13"><link rel="stylesheet" href="/public/css/person-sheet.css?v=3"><link rel="stylesheet" href="/public/css/flair.css?v=5"><link rel="stylesheet" href="/public/css/casinorl-dock.css?v=2">
<main class="ds-page flow cz rl-page" id="cb" data-game="roulette" data-table="<%= tableId || '' %>" data-signed="<%= signedIn?'1':'' %>" data-user="<%= signedIn && user ? user:'' %>">
<%- include('partials/casino-top',{t,game:'roulette',tableId}) %>
<% if(!tableId){ %><section class="ds-card"><h2><%= t('casino.rl.off') %></h2><a href="/casino"><%= t('casino.all_tables') %></a></section><% }else{ %>
<section id="cz-table" hidden>
  <div class="rl-stage">
    <div class="rl-cabinet">
      <div class="rl-crown" aria-hidden="true">◇</div>
      <div class="rl-wheel-frame"><svg id="rl-wheel" viewBox="-125 -125 250 250" aria-hidden="true"></svg><span class="rl-pin" aria-hidden="true"></span></div>
      <div class="rl-readout"><span id="rl-phase"></span><strong id="cz-msg"></strong><span id="rl-net"></span></div>
    </div>
    <div class="rl-carpet">
      <div class="rl-title"><h2><%= t('casino.rl.title') %></h2><span id="rl-totals"></span></div>
      <div id="rl-modes" class="rl-modes" aria-label="<%= t('casino.rl.mode') %>"></div><output id="rl-instruction"></output>
      <div id="rl-board" class="rl-board"><div id="rl-grid" class="rl-grid"></div><div id="rl-outside" class="rl-outside"></div></div>
      <div class="rl-trail"><span><%= t('casino.history') %></span><ol id="rl-history"></ol><small><%= t('casino.rl.independent') %></small></div>
    </div>
  </div>
  <div id="cz-dock"></div>
  <div class="rl-more"><a href="/casino"><%= t('casino.all_tables') %></a><nav id="rl-wheels" aria-label="<%= t('casino.rl.other') %>"></nav><span id="rl-proof"></span></div>
</section>
<%- include('partials/casino-sheets',{t}) %><%- include('partials/casino-chat',{t}) %>
<% } %></main>
<% if(tableId){ %><script src="/public/js/room-mod.js?v=16"></script><script src="/public/js/pad-tip.js?v=1"></script><% if(signedIn){ %><script src="/public/js/block-sheet.js?v=3"></script><% } %>
<script src="/public/js/casino-ui.js?v=14"></script><script src="/public/js/patamount.js?v=1"></script><script src="/api/casino/rlbets.js?v=2"></script><script src="/public/js/casinorl-dock.js?v=2"></script><script src="/public/js/casinorl.js?v=2"></script><% } %>
