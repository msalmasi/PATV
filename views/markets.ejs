<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('markets.title'), user: user}) %>
<%# views/markets.ejs - 1.99ly design pass (bets.css): a hero with the live numbers, market cards with each outcome's
    odds bar (Yes green / No red, the leader lit), status chips, a live "closes in" countdown and the market's times in
    the viewer's zone; the create form unchanged underneath (same /act post, same fields). %>
<link rel="stylesheet" href="/public/css/bets.css?v=3">
<script src="/public/js/bets.js?v=2" defer></script>
<style>
  /* 1.99pp: design-system tokens (bets.css maps the bx-* classes onto ds.css); markets green accent */
  .mk { --ds-ac: var(--ds-acc-markets); --ds-ac-2: var(--ds-acc-markets-2); --ds-ac-bg: rgba(76, 175, 80, .14); --ds-ac-line: var(--ds-green-line); }
  .mk .card { gap: var(--ds-sp-3); }
  .mk .card .bx-top .room { margin-inline-start: auto; min-width: 0; max-width: 50%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ds-text-muted); font-size: var(--ds-fs-xs); }
  .mk .opts { display: grid; gap: var(--ds-sp-2h); }
  .mk .opt { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 5px var(--ds-sp-2h); align-items: baseline; font-size: var(--ds-fs-sm); }
  .mk .opt .nm { color: var(--ds-text); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mk .opt.lead .nm { color: var(--ds-text-strong); font-weight: 700; }
  .mk .opt .bar { grid-column: 1 / -1; height: 8px; border-radius: var(--ds-r-pill); background: #1f1f1f; overflow: hidden; }
  .mk .opt .bar span { display: block; height: 100%; border-radius: inherit; background: var(--oc, var(--ds-green)); }
  .mk .opt.won .bar span { background: var(--ds-gold); }
  .mk .opt .num { color: var(--ds-text-2); font-size: var(--ds-fs-meta); white-space: nowrap; text-align: end; font-variant-numeric: tabular-nums; }
  .mk .opt .num b { color: var(--ds-text-strong); font-size: 16px; }
  .mk .opt.won .num b { color: var(--ds-gold-text); }
  .mk .foot { display: flex; flex-wrap: wrap; gap: var(--ds-sp-1) var(--ds-sp-3h); align-items: center; justify-content: space-between; padding-block-start: var(--ds-sp-2h); border-top: 1px solid var(--ds-line-soft); color: var(--ds-text-muted); font-size: var(--ds-fs-meta); }
  .mk .cd { color: var(--ds-ok); font-weight: 700; font-variant-numeric: tabular-nums; }
  .mk .mk-times.compact { margin: 0; }
  .mk .done .card { background: var(--ds-sunken); }
  .mk form.newmk { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-5); }
  @media (max-width: 520px) { .mk form.newmk { padding: var(--ds-sp-4); } }
  @media (min-width: 1000px) { .mk .bx-grid.live { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
<%
  const COLORS = ['#4caf50', '#e57373', '#64b5f6', '#ffd54f', '#ba68c8', '#4dd0e1', '#ff8a65', '#aed581'];
  const oColor = (m, o, i) => m.options.length === 2 && /^yes$/i.test(o.name) ? '#4caf50' : m.options.length === 2 && /^no$/i.test(o.name) ? '#e57373' : COLORS[i % COLORS.length];
  const fmt = (n) => t.num(Math.round(Number(n) || 0));
  const left = (s) => { s = Math.max(0, Math.round(s)); return s >= 86400 ? t('bx.dur.dh', { d: Math.floor(s / 86400), h: Math.floor(s % 86400 / 3600) }) : s >= 3600 ? t('bx.dur.hm', { h: Math.floor(s / 3600), m: Math.floor(s % 3600 / 60) }) : t('bx.dur.m', { m: Math.max(1, Math.floor(s / 60)) }); };
  const chip = (m) => m.settle ? (m.settle.kind === 'won' ? ['settled', t('markets.chip.settled', { result: m.settle.result })] : ['void', t('markets.chip.void')])
    : m.status === 'open' && m.closes > now ? ['open', t('markets.chip.open')]
    : m.status === 'open' || m.status === 'closed' ? ['closed', t('markets.chip.judge')]
    : m.status === 'settling' ? ['settling', t('markets.chip.settling')]
    : m.status === 'settled' ? ['settled', t('markets.chip.settled', { result: m.result })] : [m.status, t.esc(m.status)];
  const liveVol = live.reduce((a, m) => a + (Number(m.total) || 0), 0);
  const card = (m) => { const c = chip(m); const lead = m.shares && !m.settle ? Math.max(...m.options.map((o) => o.price || 0)) : null; %>
    <a class="card bx-card" href="/markets/<%= m.id %>">
      <div class="bx-top">
        <span class="bx-ref"><%= m.ref %></span>
        <span class="bx-chip c-<%= c[0] %>"><%- c[1] %></span>
        <% if (m.ai_judge) { %><span class="bx-chip c-ai c-plain"><span class="ds-ic" aria-hidden="true">🤖</span> <%- t('markets.ai_tag') %></span><% } %>
        <% if (m.auto) { %><span class="bx-chip c-ai c-plain"><span class="ds-ic" aria-hidden="true">🤖</span> <%- t('markets.auto_tag') %> · <%- t('markets.auto.cat.' + (['sports','prices','news','trending'].includes(m.auto.cat) ? m.auto.cat : 'news')) %></span><% } %>
        <span class="room bx-pad" title="<%- t('bx.pad.label') %>"><span class="ds-ic" aria-hidden="true">📍</span> <%= m.padv ? m.padv.title : t('bx.pad.sitewide') %></span>
      </div>
      <p class="bx-q"><%= m.question %></p>
      <div class="opts">
        <% m.options.forEach((o, i) => { const isLead = lead != null && o.price === lead && m.options.length > 1; %>
          <div class="opt <%= o.won ? 'won' : '' %><%= isLead ? ' lead' : '' %>" style="--oc: <%= oColor(m, o, i) %>">
            <span class="nm"><% if (o.won) { %><span class="ds-ic" aria-hidden="true">🏆</span> <% } %><%= o.name %></span>
            <% if (m.shares && m.settle && m.settle.kind === 'won') { %>
              <span class="num"><%- o.won ? t('markets.o.won', { last: Math.round(o.last * 100) }) : t('markets.o.lost', { last: Math.round(o.last * 100) }) %></span>
              <div class="bar"><span style="width: <%= o.won ? 100 : 0 %>%"></span></div>
            <% } else if (m.shares && m.settle) { %>
              <span class="num"><%- t('markets.o.void', { last: Math.round(o.last * 100) }) %></span>
              <div class="bar"><span style="width: <%= (o.last * 100).toFixed(1) %>%; background: var(--ds-text-disabled)"></span></div>
            <% } else if (m.shares) { %>
              <span class="num"><%- t('markets.o.price', { pct: Math.round(o.price * 100), price: o.price.toFixed(2) }) %></span>
              <div class="bar"><span style="width: <%= (o.price * 100).toFixed(1) %>%"></span></div>
            <% } else { %>
              <span class="num"><%- t('markets.o.pool', { pct: o.share, pool: fmt(o.pool) }) %><%- o.mult ? ' · ' + t('markets.o.pays', { x: o.mult.toFixed(2) }) : '' %></span>
              <div class="bar"><span style="width: <%= o.share %>%"></span></div>
            <% } %>
          </div>
        <% }) %>
      </div>
      <%- include('partials/mk-times', { m, now, compact: true }) %>
      <div class="foot">
        <span><%- t(m.shares ? 'markets.vol' : 'markets.pool', { n: fmt(m.total) }) %> · <%- t(m.shares ? 'markets.holders' : 'markets.bettors', { count: m.bettors, n: fmt(m.bettors) }) %> · <%- t('markets.judge', { who: m.ai_judge ? '🤖 Pepe' : m.judge }) %></span>
        <% if (c[0] === 'open') { %><span><%- t('markets.closes_in', { left: '<span class="cd" data-until="' + Number(m.closes) + '">' + left(m.closes - now) + '</span>' }) %></span><% } %>
      </div>
    </a>
<% }; %>
<main class="bx ds-page flow mk">
  <header class="bx-hero">
    <div class="bx-eyebrow"><span class="ds-ic" aria-hidden="true">🔮</span><span><%- t('markets.eyebrow') %></span></div>
    <h1><%- t('markets.h1') %></h1>
    <p class="bx-lead"><%- t('markets.lead') %></p>
    <div class="bx-stats">
      <span class="bx-stat"><b><%= fmt(live.length) %></b><%- t('markets.stat_live', { count: live.length }) %></span>
      <span class="bx-stat"><b><%= fmt(liveVol) %></b><%- t('markets.stat_vol') %></span>
      <span class="bx-stat"><b><%= fmt(done.length) %></b><%- t('markets.stat_done') %></span>
    </div>
    <div class="bx-ctas">
      <a class="bx-btn" href="#new"><span class="ds-ic" aria-hidden="true">＋</span><%- t('markets.cta_new') %></a>
      <a class="bx-btn ghost" href="/economy#markets"><%- t('markets.cta_how') %></a>
      <a class="bx-btn ghost" href="/wagers"><span class="ds-ic" aria-hidden="true">🤝</span><%- t('markets.cta_wagers') %></a>
    </div>
  </header>

  <%- include('partials/bx-padfilter', { filter: locals.filter || {}, base: '/markets', voidToggle: true }) %>

  <h2 class="bx-h"><%- t('markets.h_live') %> <span class="bx-n"><%= fmt(live.length) %></span></h2>
  <% if (!live.length) { %>
    <div class="bx-empty"><span class="ic" aria-hidden="true">🔮</span><b><%- t('markets.empty_live') %></b><span><%- t('markets.empty_live_sub') %></span>
      <a class="bx-btn sm" href="#new"><span class="ds-ic" aria-hidden="true">＋</span><%- t('markets.cta_new') %></a></div>
  <% } %>
  <div class="bx-grid live"><% live.forEach((m) => card(m)) %></div>

  <h2 class="bx-h"><%- t('markets.h_done') %></h2>
  <% if (!done.length) { %><div class="bx-empty"><span class="ic" aria-hidden="true">⚖️</span><b><%- t('markets.empty_done') %></b></div><% } %>
  <div class="bx-grid done"><% done.forEach((m) => card(m)) %></div>

  <h2 class="bx-h" id="new"><%- t('markets.h_new') %></h2>
  <%- include('partials/actions', { acts: typeof acts !== 'undefined' ? acts : [], msg: typeof msg !== 'undefined' ? msg : null }) %>
  <% if (!user) { %>
    <div class="bx-empty"><span class="ic" aria-hidden="true">🔑</span><b><%- t('markets.signin') %></b><a class="bx-btn sm" href="/login"><%- t('bx.signin_btn') %></a></div>
  <% } else if (!linked) { %>
    <p class="bx-note"><%- t('markets.link') %></p>
  <% } else { %>
    <form class="newmk bx-form" method="post" action="/act">
      <input type="hidden" name="kind" value="cmd"><input type="hidden" name="cmd" value="market">
      <input type="hidden" name="back" value="/markets<%= locals.filter && filter.slug ? '?pad=' + encodeURIComponent(filter.slug) : '' %>"><input type="hidden" name="tag" value="markets">
      <input type="hidden" name="until" value=""><input type="hidden" name="tz" value="">
      <input type="hidden" name="a0" value="new">
      <label class="bx-field"><%- t('markets.f_q') %> <input class="bx-in" type="text" name="a1" maxlength="200" required placeholder="<%- t('markets.f_q_ph') %>"></label>
      <label class="bx-field"><%- t('markets.f_opts') %> <input class="bx-in" type="text" name="a2" maxlength="190" placeholder="<%- t('markets.f_opts_ph') %>" data-prefix="options "></label>
      <div class="bx-row2">
        <label class="bx-field"><%- t('markets.f_judge') %> <input class="bx-in" type="text" name="a3" maxlength="40" placeholder="@someone" data-prefix="judge "></label>
        <% const B_ = locals.bounds || { close_min_secs: 3600, close_max_secs: 90 * 86400 };
           const presets_ = [['1h', 3600], ['1d', 86400], ['2d', 172800], ['7d', 604800], ['30d', 2592000]].filter((x) => x[1] >= B_.close_min_secs && x[1] <= B_.close_max_secs);
           const human_ = (s) => s % 86400 === 0 ? t('bx.d.days', { count: s / 86400, n: s / 86400 }) : s % 3600 === 0 ? t('bx.d.hours', { count: s / 3600, n: s / 3600 }) : t('bx.d.mins', { count: Math.round(s / 60), n: Math.round(s / 60) });
           const bmsg_ = t('markets.f_bounds', { min: human_(B_.close_min_secs), max: human_(B_.close_max_secs) }); %>
        <div class="bx-field" data-close-pick data-min-secs="<%= B_.close_min_secs %>" data-max-secs="<%= B_.close_max_secs %>" data-bounds-msg="<%= bmsg_ %>">
          <label><%- t('markets.f_closes') %> <select class="bx-in" name="a4">
            <% presets_.forEach((x) => { %><option value="closes <%= x[0] %>"<%= x[0] === '1d' ? ' selected' : '' %>><%- t('bx.d.' + x[0]) %></option><% }) %>
            <option value="custom"<%= presets_.some((x) => x[0] === '1d') ? '' : ' selected' %>><%- t('markets.f_custom') %></option></select></label>
          <label class="bx-close-custom" data-close-custom hidden><span><%- t('markets.f_close_at') %> <span class="bx-fine">(<span data-close-tz>UTC</span>)</span></span>
            <input class="bx-in" type="datetime-local" step="60" aria-describedby="mkBounds"></label>
          <span class="bx-fine" id="mkBounds"><%- bmsg_ %></span>
        </div>
      </div>
      <%- include('partials/bx-padpick', { pick: locals.pick || { choices: [], def: '' } }) %>
      <label class="bx-check"><input type="checkbox" data-ai> <span class="ds-ic" aria-hidden="true">🤖</span> <%- t('markets.f_ai') %></label>
      <div class="bx-row"><button class="bx-btn" type="submit"><%- t('markets.f_submit') %></button></div>
      <p class="bx-fine"><%- t('markets.f_fine') %></p>
    </form>
    <script>
      (() => {
        const f = document.querySelector('form.newmk'), ai = f.querySelector('[data-ai]'), j = f.a3;
        ai.addEventListener('change', () => { j.disabled = ai.checked; j.required = !ai.checked; });
        j.required = true;
        f.addEventListener('submit', () => {
          f.querySelectorAll('[data-prefix]').forEach((el) => {
            const v = el.value.trim().replace(/^(options|judge)\s+/i, '');
            el.value = v ? el.dataset.prefix + v : '';
          });
          if (ai.checked) { j.disabled = false; j.value = 'judge @pepe'; }
        });
      })();
    </script>
  <% } %>
  <div class="bx-foot">
    <div><%- t('markets.foot_wagers') %></div>
    <div><%- t('markets.foot_cmds') %></div>
  </div>
</main>
<%- include('partials/mk-times-script') %>
</body>
</html>
