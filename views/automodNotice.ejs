<%# /feed/automod/:id — one Pepe automod call, for its author, the pad's managers and staff (1.99dc, feedautomod.js).
    The inbox notice links here. Locals: N (feedautomod.noticeFor), G (guidelines.js), user %>
<%- include('layout', { title: 'Automod notice · p/' + N.pad.slug, user: user }) %>
<%
  const verb = { flag: 'flagged', hide: 'hid', remove: 'removed', none: 'looked at' }[N.action] || 'looked at';
  const what = N.kind === 'post' ? 'post' : 'comment';
  const state = N.state === 'reversed' ? 'reversed' : N.action;
  const told = { flag: 'Nothing has changed yet: the pad owner gets a report and decides.', hide: 'It\'s hidden in this pad until the pad owner reviews it.',
                 remove: 'It\'s been taken out of this pad.', none: 'No action was taken - it\'s fine.' }[N.action] || '';
  // 1.99jx: in the viewer's zone with its label (tz.js)
  const when = (locals.tzFmt || new Function(include('../tz-core.js'))()('UTC', 'en').fmt)(N.at, 'long');
%>
<style>
  /* 1.99qb: ds-page.mid, compact hero, ds-card / ds-chip / ds-btn (docs/design-system.md, "Area notes: feed, pads and social") */
  .an .an-k { margin-block-start: var(--ds-sp-2); }
  .an .an-k:first-child { margin-block-start: 0; }
  .an .an-rule { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ds-sp-2); }
  .an .verdict { border-color: var(--ds-info-line); background: linear-gradient(180deg, var(--ds-info-bg), transparent 90px), var(--ds-surface); }
  .an .verdict.reversed { border-color: var(--ds-ok-line); background: linear-gradient(180deg, var(--ds-ok-bg), transparent 90px), var(--ds-surface); }
  .an .why { font-size: var(--ds-fs-body); color: var(--ds-text); }
  .an blockquote { margin: 0; padding: var(--ds-sp-2) var(--ds-sp-3); border-inline-start: 3px solid var(--ds-line-strong); color: var(--ds-text-2); background: var(--ds-sunken);
                   border-start-end-radius: var(--ds-r-sm); border-end-end-radius: var(--ds-r-sm); overflow-wrap: anywhere; }
  .an ol { margin: 0; padding-inline-start: 20px; display: grid; gap: 6px; }
  .an .ds-actions { margin-block-start: var(--ds-sp-1); }
</style>
<main class="ds-page mid an">
  <section class="ds-hero compact">
    <span class="ds-eyebrow"><span class="ds-ic" aria-hidden="true">🤖</span> PEPE AUTOMOD · P/<%= N.pad.slug.toUpperCase() %></span>
    <h1>Pepe <%= verb %> <%= N.mine ? 'your' : 'a' %> <%= what %></h1>
    <p class="ds-meta"><%= when %></p>
    <p class="ds-lead"><%= told %><% if (N.state === 'reversed') { %> <b>Update:</b> the pad's moderators reversed this call<%= N.reversed_by ? ' (' + N.reversed_by + ')' : '' %>.<% } %></p>
  </section>

  <section class="ds-card lg verdict <%= N.state === 'reversed' ? 'reversed' : '' %>" aria-label="The call">
    <div class="ds-label an-k">Rule</div>
    <div class="an-rule"><span class="ds-h3"><%= N.rule_title || 'A rule of this pad' %></span> <span class="ds-chip <%= { flag: 'warn', hide: 'warn', remove: 'danger', none: 'ok', reversed: 'ok' }[state] || 'mute' %>"><%= { flag: 'flagged', hide: 'hidden', remove: 'removed', none: 'fine', reversed: 'reversed' }[state] || state %></span></div>
    <% if (N.ruleDesc) { %><p class="ds-sub"><%= N.ruleDesc %></p><% } %>
    <div class="ds-label an-k">Pepe's reason</div>
    <div class="why"><%= N.reason || '—' %></div>
    <div class="ds-label an-k">The <%= what %></div>
    <blockquote><%= N.what %></blockquote>
    <div class="ds-actions">
      <a class="ds-btn ghost sm" href="<%= N.href %>">Open the <%= what %></a>
      <a class="ds-btn ghost sm" href="/p/<%= encodeURIComponent(N.pad.slug) %>#rules">p/<%= N.pad.slug %>'s rules</a>
      <a class="ds-btn ghost sm" href="<%= N.guidelines %>"><%= G.NAME %></a>
      <% if (N.manage && N.reversible) { %><button type="button" class="ds-btn sm go" id="anReverse" data-id="<%= N.id %>"><span class="ds-ic" aria-hidden="true">↩</span>Reverse this call</button><% } %>
      <% if (N.manage) { %><a class="ds-btn ghost sm" href="/p/<%= encodeURIComponent(N.pad.slug) %>/settings#automodlog">Pad settings › Moderation</a><% } %>
    </div>
  </section>

  <% if (N.mine && N.state !== 'reversed' && N.action !== 'none') { %>
  <section class="ds-card lg" aria-label="Appeal">
    <h2 class="ds-h2 dot">Think Pepe got it wrong?</h2>
    <p class="ds-body" style="margin:0">He's a bot and he's told to give swearing, dark jokes, roasting and hot takes a wide berth — but he can still misread things.</p>
    <ol>
      <li><b>Ask the pad owner.</b> <%= N.house ? 'This is a house pad, run by the site admins' : N.owner ? N.owner + ' runs p/' + N.pad.slug : 'The pad\'s moderators can see this call' %> and can reverse it with one click<% if (N.ownerUser && !N.house) { %> — <a href="/messages?to=<%= encodeURIComponent(N.ownerUser) %>">message them</a><% } %>.</li>
      <li><b>Appeal to the site admins</b> if that doesn't sort it: see <a href="<%= N.appeal %>">Moderation and appeals</a> in the Terms.</li>
    </ol>
    <p class="ds-fine">Pepe's automod never bans anyone, and a flag on its own changes nothing until a person looks at it.</p>
  </section>
  <% } %>
</main>
<% if (N.manage && N.reversible) { %>
<script>
(function () {
  var b = document.getElementById('anReverse');
  if (!b) return;
  b.addEventListener('click', function () {
    var note = window.prompt('Reverse Pepe\'s call? The post or comment goes back, his report is closed and the author is told.\nA note for the log (optional):', '');
    if (note === null) return;
    b.disabled = true;
    fetch('/api/feed/automod/' + encodeURIComponent(b.getAttribute('data-id')) + '/reverse', { method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' }, body: JSON.stringify({ note: note }) })
      .then(function (r) { return r.json(); }).then(function (d) { if (d.ok) location.reload(); else { b.disabled = false; alert(d.error || 'Not reversed.'); } })
      .catch(function () { b.disabled = false; alert('Couldn\'t reach the site.'); });
  });
})();
</script>
<% } %>
</body>
</html>
