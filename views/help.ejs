<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('help.page_title'), user: user, ogPath: '/help' }) %>
<%#
  views/help.ejs - Pepe's command help (1.99fq, help.js). The data is Pepe's (camfrog-bot help/catalog.json, published
  by Pepe with live prices). Cards: id="cmd-<id>" (deep links; /help#cmd-<any command or alias> is resolved by
  help-page.js). The "ask" box ranks locally first (helpsearch.js), then asks Pepe (signed in) via POST /api/help/ask.
  1.99lv design pass: Pepe hero with the filter (#flt) as the main search right under it, category chips, then the
  ask box; cards show syntax, who can use it, price, aliases. help-page.js relies on: .hlp article.card,
  .hlp section.cat, .toc a[data-cat], #flt #role #fltN #noneMsg #askForm #askQ #askOut #askHits #askPepe, [data-copy], .cp.
%>
<%
  const ROLE_LABEL = { mod: t('help.role.mod'), owner: t('help.role.owner'), admin: t('help.role.admin') };
  const copyText = (s) => { const m = /^[^\[<@{]*/.exec(String(s)); const t = (m ? m[0] : String(s)).trim(); return t + (t.length < String(s).trim().length ? ' ' : ''); };
  const asOf = M.at ? new Date(M.at).toISOString().slice(0, 10) : null;
%>
<style>
  /* /help (1.99lv; G6 polish: ds tokens, ds-page.wide.flow, 44px controls, contrast floor, logical properties).
     help-page.js hooks are unchanged (see the comment above). */
  .hlp { --g: var(--ds-green); --g2: var(--ds-green-2); --gold: var(--ds-gold); --ds-w: 1120px; }
  .hlp a { text-decoration: none; }
  .hlp a:hover { text-decoration: underline; }
  .hlp code { background: #1c1c1c; border: 1px solid var(--ds-line); padding: 1px 6px; border-radius: var(--ds-r-xs); font-size: .92em; color: #e8f5e9; white-space: pre-wrap; overflow-wrap: anywhere; font-family: var(--ds-font-mono); }

  /* hero (the ds hero recipe; the filter bar is attached under it) */
  .hlp .hero { box-shadow: none !important; color: var(--ds-text); position: relative; overflow: hidden; border: 1px solid var(--ds-line); border-bottom: 0; border-radius: var(--ds-r-2xl) var(--ds-r-2xl) 0 0; padding: var(--ds-sp-8) var(--ds-sp-8) var(--ds-sp-6);
               background: radial-gradient(90% 140% at 100% 0%, var(--ds-ac-bg), transparent 60%), radial-gradient(70% 120% at 0% 100%, rgba(255, 215, 64, .07), transparent 60%), #111;
               display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--ds-sp-6); align-items: center; }
  .hlp .hero .pepe-art { width: 120px; height: 120px; image-rendering: pixelated; filter: drop-shadow(0 8px 18px rgba(76,175,80,.35)); }
  .hlp .eyebrow { font: var(--ds-fs-eyebrow)/var(--ds-lh-eyebrow) var(--ds-font-pixel); letter-spacing: var(--ds-ls-eyebrow); color: var(--ds-gold); text-transform: uppercase; }
  .hlp h1 { margin: var(--ds-sp-2) 0; font: 700 var(--ds-fs-display)/var(--ds-lh-display) var(--ds-font); letter-spacing: -.01em; color: var(--ds-text-strong); text-wrap: balance; }
  .hlp h1 em { font-style: normal; background: var(--ds-gold-text-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hlp .sub { margin: 0; max-width: 66ch; color: var(--ds-text-2); font-size: var(--ds-fs-lead); line-height: var(--ds-lh-lead); }
  .hlp .stats { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2); margin-top: var(--ds-sp-3h); }
  .hlp .stats > span { display: inline-flex; align-items: baseline; gap: 6px; padding: 7px 13px; border-radius: var(--ds-r-pill); background: var(--ds-glass); border: 1px solid var(--ds-line-strong); color: var(--ds-text-2); font-size: var(--ds-fs-meta); line-height: 1.3; }
  .hlp .stats > span .ds-ic { align-self: center; }
  .hlp .stats b { color: var(--ds-text-strong); font-size: 15px; font-variant-numeric: tabular-nums; }

  /* the search bar, attached under the hero (sticky on desktop) */
  .hlp .bar { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: 0 0 var(--ds-r-2xl) var(--ds-r-2xl); padding: var(--ds-sp-4); margin-bottom: var(--ds-sp-6); display: grid; gap: var(--ds-sp-3); }
  @media (min-width: 1000px) { .hlp .bar { position: sticky; top: 8px; z-index: var(--ds-z-sticky); box-shadow: var(--ds-e-3); } }
  .hlp .bar .row { display: flex; gap: var(--ds-sp-2); flex-wrap: wrap; align-items: center; }
  .hlp .bar .q { position: relative; flex: 1 1 260px; min-width: 0; }
  .hlp .bar .q::before { content: '🔍'; position: absolute; inset-inline-start: 14px; top: 50%; transform: translateY(-50%); font: 15px/1 var(--ds-font-emoji); opacity: .8; pointer-events: none; }
  .hlp .bar input[type=search] { width: 100%; min-height: var(--ds-tap); margin: 0; background: var(--ds-sunken); border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-md); color: #eee;
                                 padding: 10px 12px; padding-inline-start: 42px; font: 16px var(--ds-font); }
  .hlp .bar input[type=search]:hover { border-color: #444; }
  .hlp .bar input[type=search]:focus { outline: none; border-color: var(--ds-ac); box-shadow: 0 0 0 3px var(--ds-ac-bg); }
  .hlp .bar select { min-height: var(--ds-tap); max-width: 100%; margin: 0; background-color: var(--ds-sunken); border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-md); color: #eee; padding: 0 12px; font: 15px var(--ds-font); }
  .hlp .bar select:focus { outline: none; border-color: var(--ds-ac); box-shadow: 0 0 0 3px var(--ds-ac-bg); }
  .hlp .bar .n { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .hlp .toc { list-style: none; margin: 0; padding: 2px; display: flex; flex-wrap: wrap; gap: 6px; }
  .hlp .toc a { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 var(--ds-sp-3h); border: 1px solid #2a2a2a; border-radius: var(--ds-r-pill); background: #151515; color: #ccc; font: 500 var(--ds-fs-meta)/1 var(--ds-font); white-space: nowrap; text-decoration: none; }
  .hlp .toc a .ds-ic { font-size: 15px; }
  .hlp .toc a small { color: var(--ds-text-muted); font-size: var(--ds-fs-xs); font-variant-numeric: tabular-nums; }
  .hlp .toc a:hover { border-color: var(--ds-ac); color: #fff; text-decoration: none; }
  .hlp .toc a:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .hlp .toc a.dim { opacity: .45; }
  @media (pointer: coarse) { .hlp .toc a { min-height: 40px; } }

  /* the ask box (a gold card: Pepe answers) */
  .hlp .ask { border: 1px solid var(--ds-gold-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-5); margin: 0 0 var(--ds-sp-8);
              background: linear-gradient(180deg, rgba(255, 215, 64, .06), transparent 45%), var(--ds-surface); }
  .hlp .ask h2 { display: flex; align-items: center; gap: var(--ds-sp-2); margin: 0 0 var(--ds-sp-1); color: var(--ds-text-strong); font: 700 var(--ds-fs-h3)/var(--ds-lh-h3) var(--ds-font); }
  .hlp .ask p.hint { margin: 0 0 var(--ds-sp-3); color: var(--ds-text-muted); font-size: var(--ds-fs-sm); }
  .hlp .ask form { display: flex; gap: var(--ds-sp-2); }
  .hlp .ask input { flex: 1 1 auto; min-width: 0; min-height: var(--ds-tap); margin: 0; background: var(--ds-sunken); border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-md); color: #eee; padding: 10px 12px; font: 15px var(--ds-font); }
  .hlp .ask input:focus { outline: none; border-color: var(--ds-gold); box-shadow: 0 0 0 3px var(--ds-gold-bg); }
  .hlp .ask button[type=submit] { flex: 0 0 auto; min-height: var(--ds-tap); margin: 0; padding: 0 var(--ds-sp-5); border: 0; border-radius: var(--ds-r-pill); background: var(--ds-gold-grad); color: var(--ds-on-gold); font: 700 15px/1.1 var(--ds-font); cursor: pointer; width: auto; }
  .hlp .ask button[type=submit]:hover { filter: brightness(1.1); }
  .hlp .ask button[type=submit]:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .hlp .ask .eg { margin: var(--ds-sp-2h) 0 0; font-size: var(--ds-fs-meta); color: var(--ds-text-muted); line-height: 1.8; }
  .hlp .ask .eg button { background: none; border: 0; padding: 0; margin: 0; color: var(--ds-ac-2); font: inherit; cursor: pointer; text-decoration: underline dotted; text-underline-offset: 3px; width: auto; min-height: 0; }
  .hlp .ans { margin-top: var(--ds-sp-3); display: grid; gap: var(--ds-sp-2); }
  .hlp .ans[hidden] { display: none; }
  .hlp .pepe { border: 1px solid var(--ds-ok-line); background: var(--ds-ok-bg); border-radius: var(--ds-r-lg); padding: var(--ds-sp-3) var(--ds-sp-3h); color: var(--ds-ok-ink); font-size: var(--ds-fs-sm); line-height: 1.55; }
  .hlp .pepe .who { font-weight: 700; color: var(--ds-ok); margin-inline-end: 4px; }
  .hlp .pepe.wait, .hlp .pepe.note { border-color: var(--ds-line-strong); background: rgba(255, 255, 255, .03); color: var(--ds-text-muted); }
  .hlp .hits { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .hlp .hits a { display: block; background: var(--ds-sunken); border: 1px solid var(--ds-line); border-radius: var(--ds-r-md); padding: var(--ds-sp-2h) var(--ds-sp-3); color: #ddd; text-decoration: none; }
  .hlp .hits a:hover, .hlp .hits a:focus-visible { border-color: var(--ds-ac); }
  .hlp .hits code { color: var(--ds-green-2); }
  .hlp .hits small { display: block; color: var(--ds-text-muted); margin-top: 2px; font-size: var(--ds-fs-meta); }

  /* sections */
  .hlp section.cat { margin: 0 0 var(--ds-sp-10); scroll-margin-top: 150px; }
  .hlp section.cat[hidden] { display: none; }
  .hlp .ch-head { display: flex; align-items: center; gap: var(--ds-sp-3); margin: 0 0 var(--ds-sp-1); }
  .hlp .ch-ic { flex: none; width: 44px; height: 44px; border-radius: var(--ds-r-lg); display: grid; place-items: center; font: 22px/1 var(--ds-font-emoji); background: var(--ds-ac-bg); border: 1px solid var(--ds-ac-line); }
  .hlp h2.ch { margin: 0; color: var(--ds-text-strong); font: 700 var(--ds-fs-h2)/var(--ds-lh-h2) var(--ds-font); }
  .hlp .kicker { margin-top: 2px; color: var(--ds-text-muted); font-size: var(--ds-fs-meta); line-height: 1.4; font-variant-numeric: tabular-nums; }
  .hlp .lead { margin: var(--ds-sp-2) 0 var(--ds-sp-4); max-width: 80ch; color: var(--ds-text-2); line-height: 1.55; }

  /* cards: the ds card with the role colour as a 3px top rule (like .ds-card.top) */
  .hlp .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: var(--ds-sp-3); }
  .hlp .card { --rc: var(--ds-green-line); background: var(--ds-surface); border: 1px solid var(--ds-line); border-top: 3px solid var(--rc); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); min-width: 0;
               scroll-margin-top: 150px; display: flex; flex-direction: column; gap: var(--ds-sp-2h); }
  .hlp .card.r-mod { --rc: #2f6ea8; } .hlp .card.r-owner { --rc: #8a5fc4; } .hlp .card.r-admin { --rc: #c0504d; }
  .hlp .card:hover { border-color: var(--ds-line-strong); border-top-color: var(--rc); }
  .hlp .card[hidden] { display: none; }
  .hlp .card.hl { border-color: var(--ds-gold); box-shadow: 0 0 0 2px rgba(255, 207, 64, .25); }
  .hlp .syn { display: flex; align-items: flex-start; gap: var(--ds-sp-2); }
  .hlp .syn code { flex: 1 1 auto; min-width: 0; font-size: 13.5px; color: var(--ds-green-2); background: var(--ds-sunken); border-color: var(--ds-line-soft); padding: 7px 10px; font-weight: 700; border-radius: var(--ds-r-sm); line-height: 1.45; }
  .hlp .syn:first-child code { font-size: 15px; color: #c8f2cf; }
  .hlp .cp { flex: 0 0 auto; display: inline-flex; align-items: center; min-height: 36px; margin: 0; padding: 0 var(--ds-sp-3); background: #1c1c1f; border: 1px solid var(--ds-line-strong); color: var(--ds-text-2);
             border-radius: var(--ds-r-pill); font: 700 12.5px/1 var(--ds-font); cursor: pointer; width: auto; }
  .hlp .cp:hover { border-color: var(--ds-ac); color: #fff; }
  .hlp .cp:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .hlp .cp.ok { border-color: var(--ds-ok-line); color: var(--ds-ok); }
  @media (pointer: coarse) { .hlp .cp { min-height: 40px; } }
  .hlp .bdg { display: flex; flex-wrap: wrap; gap: 6px; }
  .hlp .b { display: inline-flex; align-items: center; padding: 1px 8px; border-radius: var(--ds-r-pill); border: 1px solid var(--ds-line-strong); color: #ccc; background: transparent; font: 700 11px/1.6 var(--ds-font); white-space: nowrap; }
  .hlp .b.cost { color: var(--ds-gold-text); border-color: #7a6418; background: rgba(255, 215, 64, .1); font-variant-numeric: tabular-nums; }
  .hlp .b.everyone, .hlp .b.web { color: var(--ds-ok); border-color: var(--ds-ok-line); background: var(--ds-ok-bg); }
  .hlp .b.mod { color: var(--ds-info); border-color: var(--ds-info-line); background: var(--ds-info-bg); }
  .hlp .b.owner { color: #e2c4ff; border-color: #4b3a6a; background: rgba(179, 136, 255, .1); }
  .hlp .b.admin { color: var(--ds-danger); border-color: var(--ds-danger-line); background: var(--ds-danger-bg); }
  .hlp .b.gate { color: var(--ds-warn); border-color: var(--ds-warn-line); background: var(--ds-warn-bg); }
  .hlp .card p.s { margin: 0; color: var(--ds-text); font-size: var(--ds-fs-sm); line-height: 1.55; }
  .hlp .al { font-size: var(--ds-fs-meta); color: var(--ds-text-muted); }
  .hlp .ex { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: var(--ds-fs-meta); color: var(--ds-text-muted); }
  .hlp .ex button { background: none; border: 0; padding: 0; margin: 0; cursor: pointer; text-align: start; max-width: 100%; width: auto; min-height: 0; }
  .hlp .ex button code { display: inline-block; font-size: 12.5px; color: #cfe8cf; }
  .hlp .ex button:hover code, .hlp .ex button:focus-visible code { border-color: var(--ds-ac); }
  .hlp .webeq { display: flex; align-items: center; gap: 6px; font-size: var(--ds-fs-meta); }
  .hlp details { font-size: var(--ds-fs-meta); color: var(--ds-text-2); line-height: 1.6; }
  .hlp details summary { display: inline-flex; align-items: center; gap: 4px; min-height: 32px; cursor: pointer; color: var(--ds-ac-2); font-size: var(--ds-fs-meta); font-weight: 700; list-style: none; }
  .hlp details summary::-webkit-details-marker { display: none; }
  .hlp details summary::before { content: '▸'; transition: transform var(--ds-dur-2); }
  .hlp details[open] summary::before { transform: rotate(90deg); }
  [dir="rtl"] .hlp details:not([open]) summary::before { transform: scaleX(-1); }
  .hlp details .d { margin-top: 6px; padding-top: 6px; border-top: 1px dashed var(--ds-line); }
  .hlp .ft { display: flex; justify-content: space-between; align-items: center; gap: var(--ds-sp-2); margin-top: auto; padding-top: var(--ds-sp-2); border-top: 1px solid var(--ds-line-soft); }
  .hlp .lnk { display: inline-grid; place-items: center; min-width: 32px; min-height: 32px; border-radius: var(--ds-r-sm); font-size: var(--ds-fs-meta); color: var(--ds-text-muted); }
  .hlp .lnk:hover { color: var(--ds-ac-2); background: var(--ds-hover); text-decoration: none; }
  .hlp .none { padding: var(--ds-sp-6) var(--ds-sp-4); border: 1px dashed var(--ds-line-strong); border-radius: var(--ds-r-xl); text-align: center; color: var(--ds-text-muted); }
  .hlp .top { margin-top: var(--ds-sp-2); text-align: end; font-size: var(--ds-fs-xs); }
  .hlp .top a { color: var(--ds-text-faint); }
  .hlp .foot { margin-top: var(--ds-sp-8); text-align: center; color: var(--ds-text-faint); font-size: var(--ds-fs-meta); line-height: 1.7; }
  .hlp .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 1000px) { .hlp section.cat, .hlp .card { scroll-margin-top: 190px; } }
  @media (prefers-reduced-motion: no-preference) {
    .hlp .hero .pepe-art { animation: hlp-bob 3.2s ease-in-out infinite; }
    @keyframes hlp-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  }
  @media (prefers-reduced-motion: reduce) { .hlp details summary::before { transition: none; } }
  @media (max-width: 700px) {
    .hlp .hero { grid-template-columns: minmax(0, 1fr); gap: 6px; padding: var(--ds-sp-6) var(--ds-sp-5) var(--ds-sp-5); }
    .hlp .hero .pepe-art { width: 64px; height: 64px; position: absolute; inset-inline-end: 12px; top: 12px; }
    .hlp .eyebrow { padding-inline-end: 70px; }
    .hlp .toc { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    .hlp .toc::-webkit-scrollbar { display: none; }
  }
  @media (max-width: 520px) {
    .hlp .bar select { flex: 1 1 auto; }
    .hlp .ask { padding: var(--ds-sp-4); }
    .hlp .ask form { flex-direction: column; }
  }
</style>
<main class="hlp ds-page wide flow" id="top">
  <header class="hero">
    <img class="pepe-art" src="/public/img/pepe.png" alt="" width="120" height="120">
    <div>
      <div class="eyebrow"><%- t('help.hero.eyebrow') %></div>
      <h1><em><%- t('help.heading') %></em></h1>
      <p class="sub"><%- t('help.intro', { verify: '<a href="#cmd-verify">' + t('help.intro_verify') + '</a>', balance: '<a href="#cmd-balance">!balance</a>', economy: '<a href="/economy">' + t('help.intro_economy') + '</a>' }) %></p>
      <div class="stats">
        <span><%- t('help.hero.commands', { count: M.count, n: '<b>' + M.count + '</b>' }) %></span>
        <span><%- t('help.hero.cats', { count: M.cats.length, n: '<b>' + M.cats.length + '</b>' }) %></span>
        <% if (M.version) { %><span><span class="ds-ic" aria-hidden="true">🐸</span> Pepe <b><%= M.version %></b></span><% } %>
      </div>
    </div>
  </header>

  <nav class="bar" aria-label="<%- t('help.bar.aria') %>">
    <div class="row">
      <div class="q">
        <label class="sr" for="flt"><%- t('help.bar.filter_label') %></label>
        <input id="flt" type="search" placeholder="<%- t('help.bar.filter_ph', { n: M.count }) %>" autocomplete="off">
      </div>
      <label class="sr" for="role"><%- t('help.bar.role_label') %></label>
      <select id="role">
        <option value=""><%- t('help.bar.all_roles') %></option>
        <option value="everyone"><%- t('help.bar.everyone') %></option>
        <option value="mod"><%- t('help.role.mod') %></option>
        <option value="owner"><%- t('help.role.owner') %></option>
        <option value="admin"><%- t('help.role.admin') %></option>
      </select>
      <span class="n" id="fltN" aria-live="polite"></span>
    </div>
    <ul class="toc">
      <% M.cats.forEach((c) => { %><li><a href="#cat-<%= c.id %>" data-cat="<%= c.id %>"><span class="ds-ic" aria-hidden="true"><%= c.icon %></span><%= c.label %> <small><%= c.entries.length %></small></a></li><% }) %>
    </ul>
  </nav>

  <section class="ask" aria-labelledby="askT">
    <h2 id="askT"><span class="ds-ic" aria-hidden="true">🤔</span><%- t('help.ask.heading') %></h2>
    <p class="hint"><%- t('help.ask.hint') %><% if (!signedIn) { %> <%- t('help.ask.signin', { link: '<a href="/login?next=/help">' + t('help.ask.signin_link') + '</a>' }) %><% } %></p>
    <form id="askForm" role="search" autocomplete="off">
      <label class="sr" for="askQ"><%- t('help.ask.label') %></label>
      <input id="askQ" name="q" type="text" maxlength="200" placeholder="<%- t('help.ask.placeholder') %>" value="<%= q %>">
      <button type="submit"><%- t('help.ask.button') %></button>
    </form>
    <p class="eg"><%- t('help.ask.try') %> <button type="button" data-ask="<%- t('help.ask.eg1_q') %>"><%- t('help.ask.eg1') %></button> ·
      <button type="button" data-ask="<%- t('help.ask.eg2_q') %>"><%- t('help.ask.eg2') %></button> ·
      <button type="button" data-ask="<%- t('help.ask.eg3_q') %>"><%- t('help.ask.eg3') %></button> ·
      <button type="button" data-ask="<%- t('help.ask.eg4_q') %>"><%- t('help.ask.eg4') %></button></p>
    <div class="ans" id="askOut" aria-live="polite" hidden>
      <div class="pepe" id="askPepe" hidden></div>
      <ul class="hits" id="askHits"></ul>
    </div>
  </section>

  <% M.cats.forEach((c) => { %>
  <section class="cat" id="cat-<%= c.id %>" aria-labelledby="h-<%= c.id %>">
    <div class="ch-head">
      <span class="ch-ic" aria-hidden="true"><%= c.icon %></span>
      <div><h2 class="ch" id="h-<%= c.id %>"><%= c.label %></h2><div class="kicker"><%- t('help.cat.count', { count: c.entries.length }) %></div></div>
    </div>
    <% if (c.blurb) { %><p class="lead"><%= c.blurb %></p><% } %>
    <div class="grid">
      <% c.entries.forEach((e) => { const more = e.details && e.details.trim() !== e.summary.trim(); %>
      <article class="card r-<%= e.role %>" id="cmd-<%= e.id %>" data-role="<%= e.role %>" data-cmds="<%= [].concat(e.commands, e.aliases || []).join(' ') %>">
        <% e.syntax.forEach((s) => { %>
        <div class="syn"><code><%= s %></code><button type="button" class="cp" data-copy="<%= copyText(s) %>" aria-label="<%- t('help.card.copy_aria', { cmd: copyText(s).trim() }) %>"><%- t('help.card.copy') %></button></div>
        <% }) %>
        <div class="bdg">
          <span class="b <%= e.role %>" title="<%- t('help.bar.role_label') %>"><%- e.role === 'everyone' ? t('help.role.everyone') : (ROLE_LABEL[e.role] || t.esc(e.role)) %></span>
          <% if (e.cost) { %><span class="b cost"><%= fmt(e.cost) %> PAT</span><% } %>
          <% if (e.gates && e.gates.length) { %><span class="b gate" title="<%- t('help.card.gate_title', { gates: e.gates.map((g) => M.gates[g] || g).join(', ') }) %>"><%- t('help.card.gate') %></span><% } %>
          <% if (e.webchat) { %><span class="b web" title="<%- t('help.card.web_title') %>"><%- t('help.card.web') %></span><% } %>
        </div>
        <p class="s"><%- md(e.summary) %></p>
        <% if (e.aliases && e.aliases.length) { %><div class="al"><%- t('help.card.also', { list: e.aliases.join(' · ') }) %></div><% } %>
        <% if (e.examples && e.examples.length) { %>
        <div class="ex"><span><%- t('help.card.eg') %></span><% e.examples.forEach((x) => { %><button type="button" class="cpx" data-copy="<%= x %>" title="<%- t('help.card.copy') %>"><code><%= x %></code></button><% }) %></div>
        <% } %>
        <% if (e.web) { %><div class="webeq"><span class="ds-ic" aria-hidden="true">🌐</span><a href="<%= e.web.url %>"<%- /^https:/.test(e.web.url) ? ' rel="noopener"' : '' %>><%= e.web.label %> ›</a></div><% } %>
        <div class="ft">
          <% if (more) { %><details><summary><%- t('help.card.more') %></summary><div class="d"><%- md(e.details) %></div></details><% } else { %><span></span><% } %>
          <a class="lnk" href="#cmd-<%= e.id %>" aria-label="<%- t('help.card.link_aria', { cmd: e.syntax[0] }) %>">#</a>
        </div>
      </article>
      <% }) %>
    </div>
    <div class="top"><a href="#top"><%- t('help.top') %></a></div>
  </section>
  <% }) %>
  <p class="none" id="noneMsg" hidden><%- t('help.none') %></p>

  <p class="foot">
    <% if (M.version) { %>Pepe <%= M.version %><% if (asOf) { %> · <%- t('help.foot.updated', { date: asOf }) %><% } %> · <% } %>
    <%- t('help.foot.prices', { gate: '<span class="b gate">' + t('help.card.gate') + '</span>' }) %><br>
    <a href="https://pepe.publicaccess.tv/patchnotes" rel="noopener"><%- t('help.foot.patchnotes') %></a> · <a href="/economy"><%- t('help.foot.economy') %></a> ·
    <a href="/gtf">Grand Theft Frogger</a> · <a href="https://pepe.publicaccess.tv/turfwars" rel="noopener"><%- t('help.foot.turfwars') %></a>
  </p>
</main>
<script type="application/json" id="helpIdx"><%- JSON.stringify(M.index).replace(/</g, '\\u003c') %></script>
<script>window.HELP_SIGNED_IN = <%- signedIn ? 'true' : 'false' %>;</script>
<script src="/public/js/helpsearch.js?v=1" defer></script>
<script src="/public/js/help-page.js?v=1" defer></script>
</body>
</html>
