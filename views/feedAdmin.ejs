<%- include('partials/admin-open', { title: 'Feed admin', user: user, section: 'feed', admIsAdmin: isAdmin }) %>
<link rel="stylesheet" href="/public/css/feed.css?v=9">
<%
  const mb = (b) => (b / 1024 / 1024).toFixed(1) + ' MB';
  const gb = (b) => (b === Infinity ? 'unknown' : (b / 1024 ** 3).toFixed(1) + ' GB');
  const F = [
    ['Uploads', [['max_image_mb', 'Picture size cap (MB)'], ['max_audio_mb', 'Audio size cap (MB)'], ['max_video_mb', 'Video size cap (MB)'],
                 ['max_audio_secs', 'Audio length cap (seconds)'], ['max_video_secs', 'Video length cap (seconds)']]],
    ['Storage', [['user_quota_mb', 'Space per user (MB)'], ['global_quota_gb', 'Space for the whole feed (GB)'], ['min_free_gb', 'Refuse uploads below this much free disk (GB)'],
                 ['deleted_purge_days', 'Delete files of removed posts after (days)']]],
    ['Who can post', [['media_min_level', 'Uploads: linked Camfrog name OR at least this level'], ['new_account_hours', 'An unlinked account is "new" for (hours)'],
                      ['new_account_posts_per_day', 'New accounts: posts per day']]],
    ['Rate limits', [['posts_per_hour', 'Posts per hour'], ['posts_per_day', 'Posts per day'], ['comments_per_hour', 'Comments per hour'],
                     ['uploads_per_hour', 'Uploads per hour'], ['upload_mb_per_day', 'Upload MB per day'], ['report_hide_threshold', 'Hide a post after this many reports (pending review)'],
                     ['crosspost_max_pads', 'Crosspost: pads per action (1-25; each one counts as a post)']]],
    ['Reports (anti-abuse)', [['reports_per_hour', 'Reports per hour per account (posts + comments + users)'], ['new_account_reports_per_hour', 'New accounts: reports per hour'],
                              ['reports_per_day', 'Reports per day per account'], ['false_reports_pause', 'Pause reporting after this many bad-faith reports in 30 days']]],
    ['Prices (PAT, 0 = free; to the Federal Reserve)', [['price_post', 'Every post'], ['price_link', 'Per link'], ['price_image', 'Per picture'], ['price_audio', 'Per audio file'], ['price_video', 'Per video']]],
    ['Pepe', [['mention_gap_min', 'Camfrog room mentions: at most one per Camfrog room every (minutes)']]],
    ['Voting & ranking', [['hot_decay_secs', 'Hot: seconds of age worth one order of magnitude of score (Reddit 45000 = 12.5 h)'],
                          ['downvote_min_level', 'Downvotes count from a linked Camfrog name OR this level'],
                          ['votes_per_min', 'Vote changes per minute per account'], ['votes_per_hour', 'Vote changes per hour per account']]],
  ];
%>
<main class="fd fd-admin">
  <div class="crumb"><a href="/admin">Admin</a> › Feed</div>
  <h1>Feed &amp; Trust and Safety</h1>
  <p class="sub">Storage: <b><%= mb(used) %></b> used of <%= C.global_quota_gb %> GB · disk free <b><%= gb(free) %></b> · files in <code><%= dir %></code></p>

  <%# 1.99cc: one block per post, one row of actions per reported target (the post itself, each reported comment). Urgent first. %>
  <section class="fa-card" id="urgent">
    <h2>Reports (<%= reports.length %>)<% const urg = reports.filter((x) => x.urgent).length; if (urg) { %> <span class="tag nsfw">⚠ <%= urg %> urgent</span><% } %></h2>
    <% if (!reports.length) { %><p class="mut">Nothing reported. 🎉</p><% } %>
    <% reports.forEach((x) => { const p = x.post; %>
      <div class="fa-rep<%= x.urgent ? ' urgent' : '' %>" data-id="<%= p.id %>">
        <div class="fa-rep-h">
          <% if (x.urgent) { %><span class="tag nsfw">URGENT</span><% } %>
          <a href="/feed/p/<%= p.id %>"><b><%= p.title || (p.body || '').slice(0, 80) || '(no text)' %></b></a>
          <span class="mut">by <%= p.author.display %> · <%= fx.ago(p.created) %><%= p.hidden ? ' · HIDDEN pending review' : '' %><%= p.deleted ? ' · deleted' : '' %><%= p.nsfw ? ' · NSFW' : '' %></span>
        </div>
        <% (x.targets || []).forEach((g) => { %>
          <div class="fa-tgt" data-post="<%= p.id %>"<% if (g.commentId) { %> data-comment="<%= g.commentId %>"<% } %> data-user="<%= g.comment ? (g.comment.username || '') : p.author.username %>">
            <div class="fa-tgt-h">
              <% if (g.comment) { %>
                <span class="tag warn">Comment</span> by <b><%= g.comment.username || '?' %></b>: “<%= String(g.comment.body || '').slice(0, 160) %>”<%= g.comment.hidden_at ? ' · HIDDEN' : '' %><%= g.comment.deleted_at ? ' · deleted' : '' %>
              <% } else { %>
                <span class="tag pend">Post</span>
              <% } %>
            </div>
            <ul>
              <% g.reports.forEach((r) => { %>
                <li><% if (r.urgent) { %><span class="tag nsfw">urgent</span> <% } else if (r.adminOnly) { %><span class="tag lock" title="Never shown to pad owners">admin-only</span> <% } %><b><%= r.label %></b> from <%= r.reporter || '?' %><%= r.note ? ' — “' + r.note + '”' : '' %> <span class="mut"><%= fx.ago(r.created) %></span></li>
              <% }) %>
            </ul>
            <div class="fa-acts">
              <button type="button" data-fa="r-dismiss" title="It doesn't break the Terms: un-hide it and close the reports">Dismiss</button>
              <button type="button" data-fa="r-false" title="Dismiss, and count it against the reporters (enough bad-faith reports pause their reporting)">Dismiss · bad faith</button>
              <button type="button" class="bad" data-fa="r-remove">Remove <%= g.comment ? 'comment' : 'post' %></button>
              <button type="button" class="bad" data-fa="r-ban">Remove + ban author…</button>
              <% if (!g.comment) { %><button type="button" data-fa="nsfw"><%= p.nsfw ? 'Unmark NSFW' : 'Mark NSFW' %></button><% } %>
              <% if (isAdmin) { %><button type="button" data-safety="details" <%- g.comment ? 'data-comment="' + g.commentId + '"' : 'data-post="' + p.id + '"' %>>🛡 View details</button><% } %>
              <label class="ck fa-tell"><input type="checkbox" name="tell" checked> Tell the reporter<%= new Set(g.reports.map((r) => r.reporter_id)).size === 1 ? '' : 's' %> the outcome (inbox)</label>
            </div>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </section>

  <section class="fa-card" id="users">
    <h2>Reported users (<%= userReports.length %>)</h2>
    <% if (!userReports.length) { %><p class="mut">No account reports.</p><% } %>
    <% userReports.forEach((g) => { %>
      <div class="fa-rep fa-tgt<%= g.urgent ? ' urgent' : '' %>" data-uid="<%= g.userId %>" data-user="<%= g.username %>">
        <div class="fa-rep-h"><% if (g.urgent) { %><span class="tag nsfw">URGENT</span> <% } %><a href="/u/<%= encodeURIComponent(g.username) %>/profile"><b>@<%= g.username %></b></a> <span class="mut"><%= g.reports.length %> report<%= g.reports.length === 1 ? '' : 's' %></span></div>
        <ul>
          <% g.reports.forEach((r) => { %><li><b><%= r.label %></b> from <%= r.reporter || '?' %><%= r.note ? ' — “' + r.note + '”' : '' %> <span class="mut"><%= fx.ago(r.created) %></span></li><% }) %>
        </ul>
        <div class="fa-acts">
          <button type="button" data-fa="u-dismiss">Dismiss</button>
          <button type="button" data-fa="u-false">Dismiss · bad faith</button>
          <button type="button" class="bad" data-fa="u-ban">Ban from the feed…</button>
          <% if (isAdmin) { %><button type="button" data-safety="details" data-user-id="<%= g.userId %>">🛡 View details</button><% } %>
          <label class="ck fa-tell"><input type="checkbox" name="tell" checked> Tell the reporters the outcome</label>
        </div>
      </div>
    <% }) %>
  </section>

  <%# 1.99cp: reported direct messages - site Admins only (never Staff, never pad owners). The text is NOT on this page:
      "Read the reported message" fetches that one message, and the read is logged (content_audit_views). %>
  <% if (isAdmin) { const dmR = typeof dmReports !== 'undefined' ? dmReports : []; %>
  <section class="fa-card" id="dms">
    <h2>Reported messages (<%= dmR.length %>)<% const dmUrg = dmR.filter((x) => x.urgent).length; if (dmUrg) { %> <span class="tag nsfw">⚠ <%= dmUrg %> urgent</span><% } %></h2>
    <p class="mut">Direct messages people reported. Admins only. You can read a reported message (and only that one) - every read is logged below.</p>
    <% if (!dmR.length) { %><p class="mut">No reported messages.</p><% } %>
    <% dmR.forEach((g) => { %>
      <div class="fa-rep fa-dm<%= g.urgent ? ' urgent' : '' %>" data-msg="<%= g.messageId %>" data-user="<%= g.sender %>">
        <div class="fa-rep-h"><% if (g.urgent) { %><span class="tag nsfw">URGENT</span> <% } %><span class="tag lock"><%= g.group ? 'Group DM' : 'DM' %></span> from <a href="/u/<%= encodeURIComponent(g.sender) %>/profile"><b>@<%= g.sender %></b></a>
          <span class="mut">sent <%= g.msgAt ? fx.ago(g.msgAt) : '?' %> ago · <%= g.reports.length %> report<%= g.reports.length === 1 ? '' : 's' %></span></div>
        <ul>
          <% g.reports.forEach((r) => { %><li><% if (r.urgent) { %><span class="tag nsfw">urgent</span> <% } %><b><%= r.label %></b> from <%= r.reporter %><%= r.note ? ' — “' + r.note + '”' : '' %> <span class="mut"><%= fx.ago(r.created) %></span></li><% }) %>
        </ul>
        <div class="fa-dm-body" hidden></div>
        <div class="fa-acts">
          <button type="button" data-dmfa="read">🔒 Read the reported message (logged)</button>
          <button type="button" data-dmfa="dismiss">Dismiss</button>
          <button type="button" data-dmfa="false">Dismiss · bad faith</button>
          <button type="button" class="bad" data-dmfa="remove">Remove message</button>
          <button type="button" class="bad" data-dmfa="ban">Remove + ban sender…</button>
          <label class="ck fa-tell"><input type="checkbox" name="tell" checked> Tell the reporter<%= new Set(g.reports.map((r) => r.reporter)).size === 1 ? '' : 's' %> the outcome</label>
        </div>
      </div>
    <% }) %>
  </section>
  <% } %>

  <% if (isAdmin) { %>
  <section class="fa-card" id="audit">
    <h2>Details access log</h2>
    <p class="mut">Every time an admin opens the private details (IP, browser, shared accounts) of a post, comment or user, or reads a reported direct message. Kept 2 years.</p>
    <% if (!viewLog.length) { %><p class="mut">No views yet.</p><% } else { %>
      <div class="fa-scroll"><table class="fa-t"><thead><tr><th>When</th><th>Admin</th><th>Looked at</th><th>Whose</th></tr></thead><tbody>
        <% viewLog.forEach((v) => { %><tr><td><%= new Date(v.at).toISOString().slice(0, 16).replace('T', ' ') %></td><td><%= v.admin_name || '?' %></td><td><%= v.target_kind %> <code><%= v.target_id %></code></td><td><%= v.subject || '?' %></td></tr><% }) %>
      </tbody></table></div>
    <% } %>
  </section>
  <% } %>

  <%# 1.99cg: Pepe on the feed - the All settings, global caps, where he's on, every action he took (pepefeed.js) %>
  <% if (pepe) { const G = pepe.global, U = pepe.used; %>
  <section class="fa-card pf-card" id="pepe">
    <h2><img class="av av-pepe" src="/public/img/pepe.png" alt="" width="22" height="22"> Pepe on the feed</h2>
    <p class="sub">Account <a href="/u/<%= encodeURIComponent(pepe.account.username) %>/profile"><%= pepe.account.username %></a> · last 24 h: <b><%= U.posts %></b> posts, <b><%= U.comments %></b> comments, <b>$<%= Number(U.cost || 0).toFixed(4) %></b> of $<%= Number(G.llm_budget_usd).toFixed(2) %> LLM budget</p>
    <% if (!isAdmin) { %><p class="mut">Only site Admins can change these.</p><% } %>
    <h3 class="pf-h">Site-wide caps (win over every pad)</h3>
    <form class="pf-form fa-cfg" data-url="/api/feed/admin/pepe" data-wrap="global">
      <fieldset<%= isAdmin ? '' : ' disabled' %>>
        <label class="ck"><input type="checkbox" name="enabled"<%= G.enabled ? ' checked' : '' %>> Pepe is on (off = he never posts, comments or answers anywhere)</label>
        <label><span>His posts per day, all scopes</span><input type="number" name="posts_per_day" min="0" max="100" value="<%= G.posts_per_day %>"></label>
        <label><span>His comments per day, all scopes</span><input type="number" name="comments_per_day" min="0" max="1000" value="<%= G.comments_per_day %>"></label>
        <label><span>LLM budget per day for the feed (USD, spend tagged "feed")</span><input type="number" name="llm_budget_usd" min="0" max="100" step="0.01" value="<%= G.llm_budget_usd %>"></label>
        <label><span>Seconds between two mention replies</span><input type="number" name="reply_gap_secs" min="0" max="3600" value="<%= G.reply_gap_secs %>"></label>
        <label><span>Hard cap: writes per minute</span><input type="number" name="writes_per_min" min="1" max="60" value="<%= G.writes_per_min %>"></label>
      </fieldset>
      <% if (isAdmin) { %><div class="cm-row"><span class="fc-err" role="alert"></span><button type="submit" class="btn-s">Save caps</button></div><% } %>
    </form>
    <h3 class="pf-h">All (site-wide: Pepe's own pads and the Camfrog Lounge follow these unless they have their own)</h3>
    <%- include('partials/pepe-feed-settings', { s: { ...pepe.main, used: (U.byScope[''] || { posts: 0, comments: 0 }), quiet: PF.quietNow(pepe.main), global: G }, where: 'All', url: '/api/feed/admin/pepe', wrap: 'main', admin: isAdmin, roomScope: false }) %>
    <h3 class="pf-h">Pads where he's on</h3>
    <% if (!pepe.rooms.length) { %><p class="mut">None yet - pad owners switch him on in their pad's settings (⚙ Pad settings › Pepe); admins can too, from any pad's settings, and can lock it.</p><% } else { %>
      <div class="fa-scroll"><table class="fa-t"><thead><tr><th>Pad</th><th>Mentions</th><th>On his own</th><th>24 h</th><th></th></tr></thead><tbody>
        <% pepe.rooms.forEach((r) => { %><tr><td><%= r.title %><%= r.house ? " (Pepe's)" : '' %><%= r.admin_lock ? ' 🔒' : '' %></td><td><%= r.respond ? 'on' : 'off' %></td><td><%= r.auto ? 'on' : 'off' %></td>
          <td><%= r.used.posts %>p · <%= r.used.comments %>c</td><td><% if (r.slug) { %><a href="/p/<%= encodeURIComponent(r.slug) %>/settings#pepe">Pad settings ›</a><% } %></td></tr><% }) %>
      </tbody></table></div>
    <% } %>
    <h3 class="pf-h">What he did</h3>
    <% if (!pepe.log.length) { %><p class="mut">Nothing yet.</p><% } else { %>
      <div class="fa-scroll"><table class="fa-t pf-log"><thead><tr><th>When (UTC)</th><th>What</th><th>Where</th><th>On</th><th>Cost</th></tr></thead><tbody>
        <% pepe.log.forEach((r) => { %><tr>
          <td class="mut"><%= new Date(r.at).toISOString().slice(5, 16).replace('T', ' ') %></td>
          <td class="a-<%= r.action %>"><%= r.action %><%= r.why ? ' · ' + r.why : '' %><%= r.kind ? ' · ' + r.kind : '' %><%= r.by ? ' by ' + r.by : '' %><% if (r.note && r.action !== 'post' && r.action !== 'comment') { %><div class="mut pf-note"><%= String(r.note).replace(/[{}"]/g, "").replace(/,/g, ", ").slice(0, 160) %></div><% } %></td>
          <td><%= r.scopeTitle %></td>
          <td><% if (r.href) { %><a class="<%= r.postDeleted || r.commentDeleted ? 'del' : '' %>" href="<%= r.href %>"><%= r.postTitle || r.post_id %><%= r.comment_id ? ' (comment)' : '' %></a><%= r.postDeleted || r.commentDeleted ? ' · deleted' : '' %><% } else { %><span class="mut">-</span><% } %></td>
          <td class="mut"><%= r.cost ? '$' + Number(r.cost).toFixed(4) : '' %></td></tr><% }) %>
      </tbody></table></div>
    <% } %>
  </section>
  <% } %>

  <%# 1.99dc: Pepe's feed automod (feedautomod.js) - global caps, the All scope, every call %>
  <% if (typeof automod !== 'undefined' && automod) { const AG = automod.global, AU = automod.used, AMM = automod.main;
       const amLabel = { none: 'Do nothing', flag: 'Flag it', hide: 'Hide until reviewed', remove: 'Remove (clear-cut only)' }; %>
  <section class="fa-card pf-card" id="automod">
    <h2>🛡️ Pepe automod</h2>
    <p class="sub">Pepe checks new posts and comments in pads that switch it on, against the pad's rules or <a href="/guidelines">Padiquette</a>. Last 24 h: <b><%= AU.count %></b> checks, <b>$<%= Number(AU.cost || 0).toFixed(4) %></b> of $<%= Number(AG.budget_usd).toFixed(2) %> (spend tag <code>feed_automod</code>). Pad owners set theirs in ⚙ Pad settings › Pepe; site staff get the same hub for any pad.</p>
    <% if (!isAdmin) { %><p class="mut">Only site Admins can change these.</p><% } %>
    <h3 class="pf-h">Site-wide caps</h3>
    <form class="pf-form fa-cfg" data-url="/api/feed/admin/automod" data-wrap="global">
      <fieldset<%= isAdmin ? '' : ' disabled' %>>
        <label class="ck"><input type="checkbox" name="enabled"<%= AG.enabled ? ' checked' : '' %>> Automod is allowed (off = no pad gets checked, whatever its setting)</label>
        <label><span>Model budget per day (USD)</span><input type="number" name="budget_usd" min="0" max="20" step="0.01" value="<%= AG.budget_usd %>"></label>
        <label><span>Checks per day, all pads</span><input type="number" name="per_day" min="0" max="5000" value="<%= AG.per_day %>"></label>
      </fieldset>
      <% if (isAdmin) { %><div class="cm-row"><span class="fc-err" role="alert"></span><button type="submit" class="btn-s">Save caps</button></div><% } %>
    </form>
    <h3 class="pf-h">All (house pads without settings of their own follow this; owners' pads are opt-in)</h3>
    <form class="pf-form fa-cfg" data-url="/api/feed/admin/automod" data-wrap="main">
      <fieldset<%= isAdmin ? '' : ' disabled' %>>
        <label class="ck"><input type="checkbox" name="on"<%= AMM.on ? ' checked' : '' %>> Automod on for All</label>
        <% ['minor', 'serious', 'severe'].forEach((k) => { %><label><span><%= k[0].toUpperCase() + k.slice(1) %></span><select name="<%= k %>"><% automod.AM.ACTIONS.forEach((a) => { %><option value="<%= a %>"<%= AMM[k] === a ? ' selected' : '' %>><%= amLabel[a] %></option><% }) %></select></label><% }) %>
      </fieldset>
      <% if (isAdmin) { %><div class="cm-row"><span class="fc-err" role="alert"></span><button type="submit" class="btn-s">Save All</button></div><% } %>
    </form>
    <h3 class="pf-h">Recent calls</h3>
    <% if (!automod.list.length) { %><p class="mut">None yet.</p><% } else { %>
      <div class="fa-scroll"><table class="fa-t pf-log"><thead><tr><th>When (UTC)</th><th>Pad</th><th>What</th><th>Rule · reason</th><th>Did</th></tr></thead><tbody>
        <% automod.list.forEach((r) => { %><tr><td class="mut"><%= new Date(r.at).toISOString().slice(5, 16).replace('T', ' ') %></td>
          <td><a href="/p/<%= encodeURIComponent(r.pad.slug) %>/settings#automodlog"><%= r.pad.title %></a></td>
          <td><a href="<%= r.href %>"><%= r.kind === 'post' ? '📝' : '💬' %> <%= r.what %></a></td>
          <td><%= r.rule_title || '' %><% if (r.reason) { %><div class="mut pf-note"><%= r.reason %></div><% } %></td>
          <td><%= r.state === 'reversed' ? '↩ reversed by ' + r.reversed_by : r.action === 'none' ? '✓ fine' : r.action %></td></tr><% }) %>
      </tbody></table></div>
    <% } %>
  </section>
  <% } %>

  <section class="fa-card" id="bans">
    <h2>Feed bans</h2>
    <form id="faBan" class="fa-inline">
      <input name="user" placeholder="username or Camfrog name" required aria-label="User">
      <input name="days" type="number" min="0" max="3650" placeholder="days (0 = forever)" aria-label="Days">
      <input name="reason" placeholder="reason" maxlength="200" aria-label="Reason">
      <button type="submit" class="btn-s">Ban from the whole feed</button>
    </form>
    <% if (!bans.length) { %><p class="mut">Nobody is banned.</p><% } else { %>
      <div class="fa-scroll"><table class="fa-t" aria-label="Feed bans"><thead><tr><th>User</th><th>Where</th><th>Until</th><th>Reason</th><th>By</th><th></th></tr></thead><tbody>
        <% bans.forEach((b) => { const R = roomsById.get(b.room_id); %>
          <tr><td><%= b.username %></td><td><%= b.room_id ? (R ? R.title : b.room_id) : 'whole feed' %></td><td><%= b.until ? new Date(b.until).toISOString().slice(0, 10) : 'forever' %></td>
              <td><%= b.reason || '' %></td><td><%= b.by %></td><td><button type="button" data-fa="unban" data-uid="<%= b.user_id %>" data-room="<%= R ? R.slug : '' %>">Lift</button></td></tr>
        <% }) %>
      </tbody></table></div>
    <% } %>
  </section>

  <section class="fa-card" id="settings">
    <h2>Settings</h2>
    <form id="faCfg" class="fa-cfg">
      <label class="ck"><input type="checkbox" name="enabled"<%= C.enabled ? ' checked' : '' %>> Posting is on (off = only staff can post)</label>
      <label class="ck"><input type="checkbox" name="require_link_to_post"<%= C.require_link_to_post ? ' checked' : '' %>> Text posts and comments need a linked Camfrog name too</label>
      <%# 1.99cf: the Terms gate (terms.js). Off = /terms and /privacy say "Draft", nobody is asked to accept. %>
      <% const tph = typeof termsPH !== 'undefined' ? termsPH : []; const tblocked = !C.terms_enforced && tph.length > 0; %>
      <fieldset class="fa-terms"><legend>Terms of Service</legend>
        <label class="ck"><input type="checkbox" name="terms_enforced"<%= C.terms_enforced ? ' checked' : '' %><%= tblocked ? ' disabled' : '' %>> Require accepting the <a href="/terms" target="_blank" rel="noopener">Terms</a> before posting or commenting (sign-up and the composer say so)</label>
        <% if (C.terms_enforced && typeof termsLive !== 'undefined' && !termsLive) { %>
          <p class="fc-err">Switched on, but NOT in force: placeholders are back in the pages. Nobody is asked until they're filled in.</p>
        <% } %>
        <% if (tph.length) { %>
          <p class="mut">Can't be switched on yet: <b><%= tph.length %></b> [[placeholder]]<%= tph.length === 1 ? '' : 's' %> left. Fill these in (views/terms.ejs, views/privacy.ejs) and deploy:</p>
          <ul class="fa-ph">
            <% tph.forEach((x) => { %><li><a href="/<%= x.page %>" target="_blank" rel="noopener">/<%= x.page %></a>: <code>[[<%= x.text %>]]</code></li><% }) %>
          </ul>
        <% } else if (!C.terms_enforced) { %>
          <p class="mut">No placeholders left: the switch can go on.</p>
        <% } %>
      </fieldset>
      <%# 1.99cv: the numeric groups fold away (one collapsible block each); the form still saves them all at once %>
      <% F.forEach(([h, rows]) => { %>
        <details class="adm-adv"><summary><%= h %> <span class="mut">(<%= rows.length %>)</span></summary><div class="adm-adv-body">
        <fieldset>
          <% rows.forEach(([k, l]) => { %><label><span><%= l %></span><input type="number" name="<%= k %>" value="<%= C[k] %>" min="0" placeholder="<%= D[k] %>"></label><% }) %>
        </fieldset>
        </div></details>
      <% }) %>
      <div><button type="submit" class="btn-s">Save settings</button> <span class="fc-err" id="faMsg" role="status"></span></div>
    </form>
  </section>
</main>
