<%- include('partials/admin-open', { title: 'Pads admin', user: user, section: 'pads', admIsAdmin: !!(typeof isAdmin !== 'undefined' && isAdmin) }) %>
<!-- views/roomsAdmin.ejs — site staff (1.99bi): room owners, the homepage's featured room, royalty
     rates. Stage money settings stay on /stage/admin. -->
<link rel="stylesheet" href="/public/css/stage.css?v=6">
<% const fmt = (n) => Math.round(Number(n) || 0).toLocaleString('en-US'); %>
<main class="sb" id="ra">
  <div class="sb-head">
    <h1>🏠 Pads admin</h1>
    <p class="lede">Who owns each pad, which pad the homepage features, and pad owner royalties. <a href="/stage/admin">Stage admin ›</a> · <a href="/p">Pads ›</a></p>
  </div>

  <section class="sb-card" id="front" aria-labelledby="frontT">
    <h2 id="frontT">Front-page pad</h2>
    <form id="frontForm" class="row">
      <select name="room" aria-label="Front-page pad" style="max-width:100%;min-width:0">
        <option value="auto"<%= front === 'auto' ? ' selected' : '' %>>Automatic (most active pad, switches at most every <%= fp && fp.cfg ? fp.cfg.hold_min : 30 %> min)</option>
        <% list.forEach((r) => { %><option value="<%= r.id %>"<%= front === r.id ? ' selected' : '' %>><%= r.title %> (<%= r.id %>)</option><% }) %>
      </select>
      <button type="submit" class="btn primary">Save</button><span class="msg" id="frontMsg" role="status"></span>
    </form>
    <p class="muted">The homepage shows this pad's stage (its featured stream, else Pepe's - Pepe's stream is on the stage of every pad whose Camfrog room he's in) and its live chat. Picking a pad pins it. It does <b>not</b> move Pepe — <code>!activeroom</code> stays his window/mic setting in chat, and the automatic pick ignores it.</p>
    <%- include('partials/front-pick', { fp, open: true }) %>
    <% const FC = (fp && fp.cfg) || { w: {} }; %>
    <details class="adm-adv" id="front-tuning"><summary id="fcT">Advanced: automatic pick tuning</summary><div class="adm-adv-body">
    <form id="fcForm" class="settings" aria-labelledby="fcT">
      <label>Hold a pick at least (min)<input type="number" name="hold_min" min="0" max="1440" step="1" value="<%= FC.hold_min %>"></label>
      <label>Switch when another scores ≥ (×)<input type="number" name="lead_ratio" min="1" max="10" step="0.05" value="<%= FC.lead_ratio %>"></label>
      <label>…for this many checks in a row<input type="number" name="lead_evals" min="1" max="30" step="1" value="<%= FC.lead_evals %>"></label>
      <label>Quiet = no chat / mic for (min)<input type="number" name="dead_min" min="1" max="240" step="1" value="<%= FC.dead_min %>"></label>
      <label>Activity window (min)<input type="number" name="window_min" min="5" max="90" step="1" value="<%= FC.window_min %>"></label>
      <label>Check every (s)<input type="number" name="eval_sec" min="15" max="900" step="5" value="<%= FC.eval_sec %>"></label>
      <label>Weight: unique chatter<input type="number" name="w_chatters" min="0" max="100" step="0.05" value="<%= FC.w.chatters %>"></label>
      <label>Weight: chat line<input type="number" name="w_lines" min="0" max="100" step="0.05" value="<%= FC.w.lines %>"></label>
      <label>Weight: mic minute<input type="number" name="w_mic" min="0" max="100" step="0.05" value="<%= FC.w.mic %>"></label>
      <label>Weight: person in the Camfrog room<input type="number" name="w_people" min="0" max="100" step="0.05" value="<%= FC.w.people %>"></label>
      <% const FB = FC.boost || { on: true, k: 0.1, cap: 25, rel: 0.5, half_min: 60 }; %>
      <label class="chk"><input type="checkbox" name="boost_on" <%= FB.on ? 'checked' : '' %>> 🚀 Boosts count in the score</label>
      <label>Boost: k (points per √PAT)<input type="number" name="boost_k" min="0" max="10" step="0.01" value="<%= FB.k %>"></label>
      <label>Boost: cap (points)<input type="number" name="boost_cap" min="0" max="1000" step="1" value="<%= FB.cap %>"></label>
      <label>Boost: at most × the pad's activity<input type="number" name="boost_rel" min="0" max="5" step="0.05" value="<%= FB.rel %>"></label>
      <label>Boost half-life (min)<input type="number" name="boost_half_min" min="5" max="1440" step="1" value="<%= FB.half_min %>"></label>
      <div class="row" style="grid-column: 1 / -1"><button type="submit" class="btn primary">Save tuning</button><span class="msg" id="fcMsg" role="status"></span></div>
    </form>
    </div></details>
  </section>

  <%# 1.99ee: boosts (boosts.js) - the money switch and what's been routed so far %>
  <section class="sb-card" id="boosts" aria-labelledby="boostT">
    <h2 id="boostT">🚀 Boosts &amp; slot fees</h2>
    <p class="muted">Featuring is earned (the automatic pick above); people boost pads instead. Every boost and stage slot fee is a room flow: half goes to the Federal Reserve (Fort Knox's stand-in until economy v2 E-1), half is held in the pad's room-vault escrow (room_flow_ledger) until E-3 opens room vaults. An owner paying in their own pad: all of it to the Reserve.</p>
    <form id="boostCfg" class="row"><label class="chk"><input type="checkbox" name="pay" id="boostPay"> Boosting on (PAT moves)</label><button type="submit" class="btn primary">Save</button><span class="msg" id="boostMsg" role="status"></span></form>
    <p class="muted" id="boostSum">Loading…</p>
  </section>

  <section class="sb-card" id="owners" aria-labelledby="ownT">
    <h2 id="ownT">Pads &amp; owners</h2>
    <div class="tblwrap"><table><thead><tr><th>Pad</th><th>Owner</th><th>Stage</th><th>Now</th><th></th></tr></thead><tbody>
      <% list.forEach((r) => { const g = guide.find((x) => x.id === r.id) || {}; %>
        <tr>
          <td><a href="/p/<%= encodeURIComponent(g.slug || r.slug) %>"><b><%= r.title %></b></a><br><span class="muted"><%= r.id %></span></td>
          <td><form class="row ownForm" data-room="<%= r.id %>" style="margin:0">
              <input type="text" name="owner" value="<%= r.house ? 'house' : r.owner ? r.owner.username : '' %>" placeholder="username, Camfrog name, house, or empty" aria-label="Owner of <%= r.title %>">
              <button type="submit" class="btn">Set</button></form>
              <span class="muted"><%= r.house ? "🐸 Pepe / site admins" : r.owner ? '👑 ' + (r.owner.display || r.owner.username) + (r.owner.camfrog ? ' · CF ' + r.owner.camfrog : '') : 'no owner' %></span></td>
          <td><%= r.slot_count %> slot<%= r.slot_count === 1 ? '' : 's' %> · <%= r.slot_price ? fmt(r.slot_price) + ' PAT/min' : 'free' %><%= r.approval ? ' · approval' : '' %></td>
          <td><%= g.live ? '● live' : (g.bridged ? 'bridged' : '—') %><%= g.count ? ' · 👥 ' + g.count : '' %><%= (g.now || []).length ? ' · 📺 ' + g.now.length : '' %></td>
          <td><a class="btn" href="/p/<%= encodeURIComponent(g.slug || r.slug) %>/settings">Settings</a></td>
        </tr>
      <% }) %>
    </tbody></table></div>
    <form id="addForm" class="row"><input type="text" name="room" placeholder="Camfrog room id (e.g. plant_based_chatting)" required aria-label="Camfrog room id">
      <input type="text" name="title" placeholder="title" aria-label="Title"><button type="submit" class="btn">Add pad</button><span class="msg" id="addMsg" role="status"></span></form>
    <p class="muted">Pads for the Camfrog rooms Pepe bridges are added automatically (no owner). Owner = one PATV account (matched by username, display name or Camfrog/Discord/Twitch name); <code>house</code> = Pepe's (site admins run it, no royalties). Owners sync to Pepe within ~2 minutes for chat <code>!stage</code> commands.</p>
  </section>

  <%# 1.99iy: pad addresses (+ 1.99iz creation, 1.99ja connections) - padcfg.js %>
  <% if (typeof padsCfg !== 'undefined' && padsCfg) { %><%- include('partials/pads-admin-cfg', { padsCfg, isAdmin: typeof isAdmin !== 'undefined' && isAdmin }) %><% } %>
  <%- include('partials/pads-admin-conn') %>

  <section class="sb-card" id="royalties" aria-labelledby="royT">
    <h2 id="royT">Pad owner royalties</h2>
    <form id="royForm" class="settings">
      <label class="chk"><input type="checkbox" name="enabled" <%= roy.enabled ? 'checked' : '' %>> Royalties on</label>
      <label>% of paid stage time<input type="number" name="stage_pct" min="0" max="50" step="0.5" value="<%= roy.stage_pct %>"></label>
      <label>Payout period (days)<input type="number" name="period_days" min="1" max="31" value="<%= roy.period_days %>"></label>
      <label>Active days needed<input type="number" name="min_active_days" min="0" max="31" value="<%= roy.min_active_days %>"></label>
      <label>Active day = minutes live ≥<input type="number" name="active_minutes" min="0" max="1440" value="<%= roy.active_minutes %>"></label>
      <label>…and peak people ≥<input type="number" name="active_peak" min="0" value="<%= roy.active_peak %>"></label>
      <label>Cap per payout (PAT)<input type="number" name="cap_per_period" min="0" value="<%= roy.cap_per_period %>"></label>
      <label>Expire unpaid after (periods)<input type="number" name="keep_periods" min="1" max="52" value="<%= roy.keep_periods %>"></label>
      <div class="row" style="grid-column: 1 / -1"><button type="submit" class="btn primary">Save royalties</button><span class="msg" id="royMsg" role="status"></span></div>
    </form>
    <details class="adm-adv"><summary>How owner royalties are booked and paid</summary><div class="adm-adv-body">
    <p class="muted"><b>What owners earn on pad spending is set in one place: Pepe's PAT Routing table</b> (Pepe's admin panel). Every pad flow there (paid commands, song requests, per-use voices, DJ shout-outs, !sponsor) keeps its turf / Reserve shares and sends a <code>room_owner</code> share (default 10%, sponsor 0%) to the owner of the pad it was spent in. That share is deposited in the Federal Reserve and booked here; the weekly release above pays it back out of the Reserve (payout flow <code>room_owner</code>). A pad with no owner, a house pad, or the owner paying in their own pad: nothing is booked and the share stays in the Reserve. Website stage time is the one spend Pepe doesn't route - its share is the % above. A refunded charge voids its royalty. Changing the period length re-buckets future periods.</p>
    </div></details>
    <% const osh = (sum && sum.owner_shares) || []; if (osh.length) { %><p class="muted">Pepe's current room_owner shares: <%= osh.map((x) => x.label + ' ' + x.pct + '%').join(' · ') %>.</p><% } %>

    <h3 id="flowT">Royalty flows</h3>
    <% const T = (sum && sum.totals) || {}; const Wn = (sum && sum.windows) || {}; %>
    <p>Pending <b><%= fmt(T.pending) %></b> · paid out by the Fed <b><%= fmt(T.paid) %></b> · expired <%= fmt(T.expired) %> · earned all-time <%= fmt(T.earned) %><% if (sum && sum.next_release) { %> · next release <%= new Date(sum.next_release).toISOString().slice(0, 16).replace('T', ' ') %> UTC<% } %></p>
    <div class="tblwrap"><table aria-labelledby="flowT"><thead><tr><th>Window</th><th class="num">Accrued</th><th class="num">On spend of</th><th class="num">Paid (Fed)</th><th class="num">Expired</th><th class="num">Website Reserve payouts</th><th class="num">Royalty share</th></tr></thead><tbody>
      <% [['today', 'Last 24h'], ['7d', '7 days'], ['30d', '30 days']].forEach(([k, label]) => { const w = Wn[k] || {}; %>
      <tr><td><%= label %></td><td class="num"><%= fmt(w.accrued) %></td><td class="num"><%= fmt(w.base) %></td><td class="num"><%= fmt(w.paid) %></td><td class="num"><%= fmt(w.expired) %></td><td class="num"><%= fmt(w.website_reserve_out) %></td><td class="num"><%= w.website_reserve_out ? w.website_share_pct + '%' : '—' %></td></tr>
      <% }) %>
    </tbody></table></div>
    <p class="muted">The share of ALL Reserve outflows (Pepe's own payouts included) is on Pepe's admin panel under Vault flows.</p>
    <div class="tblwrap"><table><thead><tr><th>Flow (30 days)</th><th class="num">Spend</th><th class="num">Owner share</th><th class="num">Effective</th></tr></thead><tbody>
      <% const fc = (sum && sum.categories) || []; if (!fc.length) { %><tr><td colspan="4" class="muted">Nothing booked in 30 days.</td></tr><% } %>
      <% fc.forEach((c) => { %><tr><td><%= c.label %></td><td class="num"><%= fmt(c.base_30d) %></td><td class="num"><%= fmt(c.accrued_30d) %></td><td class="num"><%= c.base_30d ? (Math.round(10000 * c.accrued_30d / c.base_30d) / 100) + '%' : '—' %></td></tr><% }) %>
    </tbody></table></div>
    <div class="tblwrap"><table><thead><tr><th>Pad</th><th>Owner</th><th class="num">7d</th><th class="num">30d</th><th class="num">Pending</th><th class="num">Paid</th><th class="num">Expired</th></tr></thead><tbody>
      <% const rr = (sum && sum.rooms) || []; if (!rr.length) { %><tr><td colspan="7" class="muted">Nothing earned yet.</td></tr><% } %>
      <% rr.forEach((o) => { %><tr><td><%= o.title %></td><td><%= o.owner %></td><td class="num"><%= fmt(o.accrued_7d) %></td><td class="num"><%= fmt(o.accrued_30d) %></td><td class="num"><%= fmt(o.pending) %></td><td class="num"><%= fmt(o.paid) %></td><td class="num"><%= fmt(o.expired) %></td></tr><% }) %>
    </tbody></table></div>
  </section>
</main>
<script>
(function () {
  'use strict';
  function post(url, body) {
    return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}), credentials: 'same-origin' })
      .then(function (r) { return r.json().catch(function () { return { ok: false, error: 'Server error (' + r.status + ')' }; }); });
  }
  function formJson(f) { var o = {}; Array.prototype.forEach.call(f.elements, function (el) { if (el.name) o[el.name] = el.type === 'checkbox' ? el.checked : el.value; }); return o; }
  document.getElementById('frontForm').addEventListener('submit', function (e) {
    e.preventDefault();
    post('/api/rooms/front', formJson(e.target)).then(function (j) { document.getElementById('frontMsg').textContent = j.ok ? 'Saved.' : (j.error || 'Not saved.'); });
  });
  // 1.99ee: boosts
  fetch('/api/boost/admin', { credentials: 'same-origin', cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (j) {
    if (!j.ok) { document.getElementById('boostSum').textContent = j.error || 'Not available.'; return; }
    document.getElementById('boostPay').checked = !!j.config.pay;
    var E = j.escrow, f = function (n) { return Math.round(Number(n) || 0).toLocaleString('en-US'); };
    document.getElementById('boostSum').textContent = 'Routed so far: ' + f(E.total) + ' PAT · to the Reserve (Fort Knox half): ' + f(E.fortknox) +
      ' · held for room vaults: ' + f(E.room_vault) + (E.rooms.length ? ' (' + E.rooms.filter(function (r) { return r.room_vault > 0; }).map(function (r) { return r.room_id + ' ' + f(r.room_vault); }).join(', ') + ')' : '');
  }).catch(function () { document.getElementById('boostSum').textContent = 'Could not load.'; });
  document.getElementById('boostCfg').addEventListener('submit', function (e) {
    e.preventDefault();
    post('/api/boost/admin', { pay: document.getElementById('boostPay').checked }).then(function (j) { document.getElementById('boostMsg').textContent = j.ok ? 'Saved.' : (j.error || 'Not saved.'); });
  });
  document.getElementById('fcForm').addEventListener('submit', function (e) {
    e.preventDefault();
    post('/api/rooms/front/config', formJson(e.target)).then(function (j) { document.getElementById('fcMsg').textContent = j.ok ? 'Saved - applies from the next check.' : (j.error || 'Not saved.'); });
  });
  document.querySelectorAll('.ownForm').forEach(function (f) {
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      post('/api/rooms/admin/owner', { room: f.getAttribute('data-room'), owner: f.elements.owner.value }).then(function (j) { if (!j.ok) alert(j.error || 'Not saved.'); else location.reload(); });
    });
  });
  document.getElementById('addForm').addEventListener('submit', function (e) {
    e.preventDefault();
    post('/api/rooms/admin/add', formJson(e.target)).then(function (j) { if (!j.ok) document.getElementById('addMsg').textContent = j.error || 'Not added.'; else location.reload(); });
  });
  document.getElementById('royForm').addEventListener('submit', function (e) {
    e.preventDefault();
    post('/api/rooms/admin/royalties', formJson(e.target)).then(function (j) { document.getElementById('royMsg').textContent = j.ok ? 'Saved.' : (j.error || 'Not saved.'); });
  });
})();
</script>
<%- include('partials/admin-close') %>
</body>
</html>
