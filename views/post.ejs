<%- include('layout', { title: (p.title || (p.link && p.link.title) || ('Post by ' + p.author.display)).slice(0, 80) + ' — PATV feed', user: user}) %>
<link rel="stylesheet" href="/public/css/feed.css?v=13">
<%
  const signed = !!viewer;
  const cs = typeof csort !== 'undefined' ? csort : 'best';
  const backRoom = p.rooms.length ? p.rooms[0] : null;
%>
<main class="fd fd-detail">
  <nav class="crumb" aria-label="Back">
    <% if (backRoom) { %><a href="/p/<%= encodeURIComponent(backRoom.slug) %>"><%- fx.icon('back') %>p/<%= backRoom.slug %></a>
    <% } else { %><a href="/feed"><%- fx.icon('back') %>Feed</a><% } %>
  </nav>
  <%- include('partials/feed-post', { p, fx, embeds, host, viewer, modRooms, detail: true, ctxRoom: null, pepeMuted: typeof pepeMuted !== 'undefined' ? pepeMuted : false }) %>

  <section class="fd-comments" id="comments" aria-labelledby="cH">
    <div class="cm-top">
      <h2 id="cH">Comments <span class="n"><%= fx.num(p.comments) %></span></h2>
      <% if (comments.length > 1) { %>
        <nav class="cm-sort" aria-label="Sort comments">
          <span class="mut">Sort by</span>
          <% fx.CSORTS.forEach((s) => { %><a class="<%= cs === s ? 'on' : '' %>" href="?<%= s === 'best' ? '' : 'csort=' + s %>#comments"<%= cs === s ? ' aria-current=true' : '' %>><%= fx.CSORT_LABELS[s] %></a><% }) %>
        </nav>
      <% } %>
    </div>
    <% if (p.locked) { %>
      <p class="cm-locked"><%- fx.icon('lock') %>Comments are locked<%= p.lockedBy ? ' by ' + p.lockedBy : '' %>.</p>
    <% } else if (signed) { %>
      <form class="cm-new composer" data-act="comment" data-post="<%= p.id %>">
        <textarea name="body" maxlength="2000" rows="2" placeholder="Add a comment…" aria-label="Your comment" required></textarea>
        <div class="cbar"><span class="hint mut">Commenting as <b><%= viewer.display %></b><% if (typeof termsEnforced !== 'undefined' && termsEnforced) { %> · by commenting you agree to the <a href="/terms" target="_blank" rel="noopener">Terms</a><%= typeof termsNeeded !== 'undefined' && termsNeeded ? ' (you’ll be asked once)' : '' %><% } %></span><span class="fc-err" role="alert"></span><button type="submit" class="btn-s">Comment</button></div>
      </form>
    <% } else { %>
      <div class="cm-signin"><span>Join the conversation</span><a class="btn-s" href="/login?next=<%= encodeURIComponent(p.url + '#comments') %>">Sign in to comment</a></div>
    <% } %>
    <% if (!comments.length) { %><p class="cm-empty mut">No comments yet<%= p.locked ? '' : ' — start the conversation' %>.</p><% } %>
    <ol class="cm-list">
      <% comments.forEach((c) => { %><%- include('partials/feed-comment', { c, p, fx, viewer, staff, modRooms, reply: false }) %><% }) %>
    </ol>
  </section>
</main>
<script type="application/json" id="fdReasons"><%- JSON.stringify(reasons).replace(/</g, '\\u003c') %></script>
<%- include('partials/feed-js', { viewer }) %>
</body>
</html>
