<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('polls.title'), user: user}) %>
<%# views/polls.ejs - 1.99ly design pass (bets.css): hero, the current poll as a big card where each option is one tappable
    row (option, count, %, tally bar; the whole row is the vote button - the same poll.vote post), the winner and your vote
    marked, the start form when nothing is running, past polls as compact cards. %>
<link rel="stylesheet" href="/public/css/bets.css?v=2">
<style>
  /* 1.99pp: the polls cyan accent with the ds names; .ds-page.mid (900) */
  .pl { --ds-ac: var(--ds-acc-polls); --ds-ac-2: var(--ds-acc-polls-2); --ds-ac-bg: rgba(79, 195, 247, .13); --ds-ac-line: #1f5a73; --ds-on-ac: #04202c; }
  .pl .card.live { border-color: var(--ds-ac-line); box-shadow: 0 0 0 1px var(--ds-ac-line) inset; padding: var(--ds-sp-5); }
  @media (max-width: 520px) { .pl .card.live { padding: var(--ds-sp-4); } }
  .pl .q { margin: 0; font-weight: 700; color: var(--ds-text-strong); font-size: clamp(19px, 4.4vw, 24px); line-height: 1.3; overflow-wrap: anywhere; }
  .pl .past .q { font-size: 16px; font-weight: 700; }
  .pl .info { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); line-height: 1.6; }
  .pl .opts { display: grid; gap: 8px; margin: 6px 0 0; }
  .pl .opt { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 10px; align-items: center; width: 100%; padding: var(--ds-sp-3) var(--ds-sp-3h); border-radius: var(--ds-r-lg);
             border: 1px solid var(--ds-line); background: var(--ds-sunken); color: inherit; text-align: start; font: inherit; }
  .pl .past .opt { padding: 8px 10px; }
  .pl .opt .txt { color: var(--ds-text); overflow-wrap: anywhere; min-width: 0; font-size: 15px; }
  .pl .opt .num { color: var(--ds-text-2); font-variant-numeric: tabular-nums; white-space: nowrap; font-size: 13.5px; }
  .pl .opt .num b { color: var(--ds-text-strong); font-size: 16px; }
  .pl .opt .bar { grid-column: 1 / -1; height: 8px; background: #1f1f1f; border-radius: var(--ds-r-pill); overflow: hidden; }
  .pl .opt .bar span { display: block; height: 100%; background: var(--ac); border-radius: inherit; transition: width .5s ease; }
  .pl .opt.mine { border-color: var(--ds-ac-line); background: #0c171d; }
  .pl .opt.mine .txt { color: var(--ac2); font-weight: 700; }
  .pl .opt.won { border-color: var(--ds-gold-line); background: linear-gradient(90deg, rgba(255, 215, 64, .1), var(--card2) 70%); }
  .pl .opt.won .txt { color: var(--goldt); font-weight: 700; }
  .pl .opt.won .bar span { background: var(--gold); }
  .pl .tag { display: inline-block; font-size: 11px; padding: 1px 8px; border-radius: var(--ds-r-pill); border: 1px solid var(--ds-ac-line); color: var(--ac2); margin-inline-start: 6px; font-weight: 700; vertical-align: 1px; }
  .pl .opt.won .tag.w { border-color: var(--gold); color: var(--goldt); }
  .pl form.vote { margin: 0; }
  .pl .votebtn { cursor: pointer; transition: border-color .12s, background .12s; }
  .pl .votebtn:hover, .pl .votebtn:focus-visible { border-color: var(--ac); background: #0e1a20; }
  .pl .votebtn:focus-visible { outline: 2px solid var(--ds-focus); outline-offset: 2px; }
  .pl .votebtn:disabled { cursor: default; }
  .pl .vlbl { display: inline-block; margin-inline-start: 8px; padding: 3px 10px; border-radius: var(--ds-r-pill); background: var(--ac); color: var(--acink); font-size: var(--ds-fs-xs); font-weight: 700; }
  .pl .opt.mine .vlbl { background: transparent; color: var(--ac2); border: 1px solid var(--ds-ac-line); }
  .pl .endbtn { justify-self: start; }
  .pl .hint { margin-top: 12px; }
  @media (max-width: 420px) { .pl .live .opt { grid-template-columns: minmax(0, 1fr); } .pl .live .opt .num { justify-self: start; } }
  .pl .past-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 12px; }
</style>
<%
  const linked = !!(me && me.camfrogUsername);
  const fmt = (n) => t.num(Number(n) || 0);
  const bars = (p, voting) => { %>
    <div class="opts">
      <% p.rows.forEach((r, i) => { const won = p.status !== 'active' && r.lead;
           const inner = '<span class="txt">' + (i + 1) + '. ' + t.esc(r.text) + (won ? '<span class="tag w">' + t('polls.winner') + '</span>' : '') + (r.mine ? '<span class="tag">' + t('polls.your_vote') + '</span>' : '') + '</span>'
             + '<span class="num"><b>' + r.pct + '%</b> · ' + t('polls.votes', { count: r.count, n: fmt(r.count) })
             + (voting ? '<span class="vlbl">' + (r.mine ? t('polls.voted') : (p.mineIdx >= 0 ? t('polls.switch') : t('polls.vote'))) + '</span>' : '') + '</span>'
             + '<span class="bar"><span style="width: ' + r.pct + '%"></span></span>'; %>
        <% if (voting) { %>
          <form class="vote" method="post" action="/act">
            <input type="hidden" name="kind" value="poll.vote">
            <input type="hidden" name="a0" value="<%= p.id %>"><input type="hidden" name="a1" value="<%= i + 1 %>">
            <input type="hidden" name="back" value="/polls"><input type="hidden" name="tag" value="polls">
            <button class="opt votebtn<%= r.mine ? ' mine' : '' %>" type="submit"<%= r.mine ? ' disabled' : '' %> aria-label="<%- t('polls.vote_for', { o: r.text }) %>"><%- inner %></button>
          </form>
        <% } else { %>
          <div class="opt<%= r.mine ? ' mine' : '' %><%= won ? ' won' : '' %>"><%- inner %></div>
        <% } %>
      <% }) %>
    </div>
<% }; %>
<main class="bx ds-page flow mid pl">
  <header class="bx-hero">
    <div class="bx-eyebrow"><span class="ds-ic" aria-hidden="true">🗳️</span> <%- t('polls.eyebrow') %></div>
    <h1><%- t('polls.h1') %></h1>
    <p class="bx-lead"><%- t('polls.lead') %></p>
    <div class="bx-stats">
      <span class="bx-stat"><b><%= active ? fmt(active.total) : '0' %></b><%- t('polls.stat_votes', { count: active ? active.total : 0 }) %></span>
      <span class="bx-stat"><b><%= fmt(past.length) %></b><%- t('polls.stat_past') %></span>
    </div>
  </header>

  <%- include('partials/actions', { acts, msg }) %>

  <h2 class="bx-h"><%- t('polls.h_current') %><% if (active) { %> <span class="bx-chip c-open"><%- t('polls.live') %></span><% } %></h2>
  <% if (active) { %>
    <div class="card bx-card live">
      <p class="q"><%= active.question %></p>
      <div class="info"><%- t('polls.started_by', { who: t.esc(active.creator || t('polls.someone')) }) %><%- active.created_at ? ' · ' + t.esc(active.created_at) : '' %> · <%- t('polls.votes', { count: active.total, n: fmt(active.total) }) %></div>
      <% bars(active, !!me) %>
      <% if (!user) { %>
        <p class="info" style="margin:0"><%- t('polls.signin') %></p>
      <% } else if (me && !linked) { %>
        <p class="info" style="margin:0"><%- t('polls.web_vote', { who: '🌐' + me.username }) %></p>
      <% } else if (me) { %>
        <p class="info" style="margin:0"><%- t('polls.tap') %></p>
      <% } %>
      <% if (canEnd) { %>
        <form method="post" action="/act" onsubmit="return confirm(<%= JSON.stringify(t('polls.end_confirm')) %>)">
          <input type="hidden" name="kind" value="poll.end"><input type="hidden" name="a0" value="<%= active.id %>">
          <input type="hidden" name="back" value="/polls"><input type="hidden" name="tag" value="polls">
          <button class="bx-btn danger sm endbtn" type="submit"><%- t('polls.end') %></button>
        </form>
      <% } %>
    </div>
  <% } else { %>
    <div class="bx-empty"><span class="ic" aria-hidden="true">🗳️</span><b><%- t('polls.empty') %></b><span><%- t('polls.empty_sub') %></span></div>
    <% if (linked) { %>
      <form class="create bx-form bx-card" method="post" action="/act" id="pl-create" style="margin-top:12px">
        <b><%- t('polls.f_h') %></b>
        <p class="bx-fine"><%- t('polls.f_note') %></p>
        <input type="hidden" name="kind" value="poll.create">
        <input type="hidden" name="back" value="/polls"><input type="hidden" name="tag" value="polls">
        <label class="bx-field"><%- t('polls.f_q') %><input class="bx-in" type="text" name="a0" maxlength="200" placeholder="<%- t('polls.f_q_ph') %>" required></label>
        <div class="bx-row2">
          <% for (let i = 1; i <= maxOptions; i++) { %>
            <input class="bx-in" type="text" name="a<%= i %>" maxlength="100" aria-label="<%- t('polls.f_opt', { n: i }) %>" placeholder="<%- i > 2 ? t('polls.f_opt_opt', { n: i }) : t('polls.f_opt', { n: i }) %>"<%= i <= 2 ? ' required' : '' %>>
          <% } %>
        </div>
        <div class="bx-row"><button class="bx-btn" type="submit"><%- t('polls.f_btn') %></button></div>
      </form>
    <% } else if (user) { %>
      <p class="bx-note hint"><%- t('polls.link') %></p>
    <% } %>
  <% } %>

  <h2 class="bx-h"><%- t('polls.h_past') %> <span class="bx-n"><%= past.length %></span></h2>
  <% if (!past.length) { %><div class="bx-empty"><span class="ic" aria-hidden="true">📜</span><b><%- t('polls.empty_past') %></b></div><% } %>
  <div class="past-grid">
  <% past.forEach((p) => { %>
    <div class="card bx-card past">
      <p class="q"><%= p.question %></p>
      <div class="info"><%- t('polls.by', { who: /^🌐/.test(p.creator || '') ? ul(p.creator, { user: p.creator.replace(/^🌐/, '') }) : ul(p.creator || t('polls.someone')) }) %><%- p.created_at ? ' · ' + t.esc(p.created_at) : '' %> · <%- t('polls.votes', { count: p.total, n: fmt(p.total) }) %></div>
      <% bars(p, false) %>
    </div>
  <% }) %>
  </div>

  <div class="bx-foot"><%- t('polls.foot') %></div>
</main>
</body>
</html>
