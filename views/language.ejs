<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('lang.title') + ' · Public Access TV', user: user, ogPath: '/language' }) %>
<%# 1.99jo: the language picker (i18n.js). Each choice is a plain link, so it works without JS. %>
<style>
  /* 1.99pm: on the design system - tool page recipe (.ds-head + a grid of 44px choice tiles) */
  .lp .lp-auto { justify-self: start; }
  .lp ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: var(--ds-sp-2); }
  .lp ul a { display: flex; justify-content: space-between; align-items: center; gap: var(--ds-sp-2); min-height: var(--ds-tap); padding: var(--ds-sp-2h) var(--ds-sp-3);
             border-radius: var(--ds-r-md); border: 1px solid var(--ds-line); background: var(--ds-surface); color: var(--ds-text); text-decoration: none;
             transition: border-color var(--ds-dur-1), color var(--ds-dur-1); }
  .lp ul a:hover { border-color: var(--ds-ac); color: var(--ds-text-strong); text-decoration: none; }
  .lp ul a.on { border-color: var(--ds-ac); background: var(--ds-ac-bg); color: var(--ds-text-strong); }
  .lp .en { color: var(--ds-text-muted); font-size: var(--ds-fs-xs); text-align: end; }
  @media (prefers-reduced-motion: reduce) { .lp ul a { transition: none; } }
</style>
<main class="ds-page read lp">
  <% if (user) { %><a class="ds-back" href="/settings">← <%- t('sethub.back') %></a><% } %>
  <div class="ds-head">
    <h1 class="ds-h1"><span class="ds-ic" aria-hidden="true">🌐</span> <%- t('lang.heading') %></h1>
    <p class="ds-sub"><%- t('lang.intro') %></p>
  </div>
  <div class="ds-stack">
    <a class="ds-btn ghost sm lp-auto" href="/lang/auto?next=<%= encodeURIComponent(next || '/') %>"><%- t('lang.auto') %></a>
    <ul>
      <% for (const L of (locals.i18nLangs || [{ code: 'en', name: 'English', english: 'English' }])) { %>
        <li><a href="/lang/<%= L.code %>?next=<%= encodeURIComponent(next || '/') %>" lang="<%= L.code %>"<%- L.dir === 'rtl' ? ' dir="rtl"' : '' %><%- L.code === t.lang ? ' class="on" aria-current="true"' : '' %>>
          <span><%= L.name %></span><span class="en" lang="en"><%= L.english %><%= L.code === t.lang ? ' · ' : '' %><%- L.code === t.lang ? t('lang.current') : '' %></span></a></li>
      <% } %>
    </ul>
    <p class="ds-fine"><%- user ? t('lang.saved_note') : t('lang.cookie_note') %></p>
  </div>
</main>
</body>
</html>
