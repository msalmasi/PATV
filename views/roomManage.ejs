<%- include('layout', { title: 'Manage pad · ' + room.title, user: user }) %>
<!-- views/roomManage.ejs — a room owner's dashboard (1.99bi): the room's stage (slots, featuring, cuts,
     approvals, queue, bans), its stage settings, its page, its website-bridge switches and royalties.
     Live parts are drawn by /public/js/room-manage.js from /api/rooms/:slug/owner-state. -->
<link rel="stylesheet" href="/public/css/stage.css?v=5">
<%
  const fmt = (n) => Math.round(Number(n) || 0).toLocaleString('en-US');
  const day = (ms) => new Date(ms).toISOString().slice(0, 10);
%>
<main class="sb" id="rmg" data-slug="<%= slug %>">
  <div class="sb-head">
    <h1>⚙️ <%= room.title %></h1>
    <p class="lede"><% if (room.house) { %>🐸 House pad — run by Pepe and the site admins.<% } else if (room.owner) { %>👑 Owned by <b><%= room.owner.display || room.owner.username %></b>.<% } else { %>No owner yet.<% } %>
      <a href="/p/<%= encodeURIComponent(slug) %>">Pad page ›</a> · <a href="/stage?room=<%= encodeURIComponent(slug) %>">Go live here ›</a>
      <% if (analytics) { %> · <a href="/p/<%= encodeURIComponent(slug) %>/analytics">📊 Pad analytics ›</a><% } %>
      <% if (staff) { %> · <a href="/pads/admin">Pads admin ›</a><% } %></p>
  </div>

  <section class="sb-card" aria-labelledby="nowT">
    <h2 id="nowT">On the stage now</h2>
    <p class="muted">Feature any slot for free — it becomes the pad's main stream (and the front page's, when this is the front-page pad). Unfeaturing a paid feature refunds the unused minutes. Cut = end the slot (unused PAT refunded); Cut + ban = also block them from this pad's stage.</p>
    <div class="tblwrap"><table><thead><tr><th>Who</th><th>Status</th><th>Source</th><th class="num">Live</th><th class="num">Charged / held</th><th></th></tr></thead>
      <tbody id="openRows"></tbody></table></div>
    <p class="msg" id="nowMsg" role="status" aria-live="polite"></p>
  </section>

  <section class="sb-card" aria-labelledby="reqT">
    <h2 id="reqT">Bookings</h2>
    <h3 class="muted" style="margin:0 0 6px">Waiting for your OK</h3>
    <ul class="mylist" id="reqList"></ul>
    <h3 class="muted" style="margin:12px 0 6px">Scheduled</h3>
    <ul class="mylist" id="schedList"></ul>
    <h3 class="muted" style="margin:12px 0 6px">Queue (next up when a slot frees)</h3>
    <ul class="mylist" id="queueList"></ul>
  </section>

  <section class="sb-card" aria-labelledby="setT">
    <h2 id="setT">Stage settings</h2>
    <form id="stageForm" class="settings">
      <label>User slots (1–<%= C.max_slots_per_room %>)<input type="number" name="slot_count" min="1" max="<%= C.max_slots_per_room %>" value="<%= room.slot_count %>"></label>
      <label>Ordinary slot price (PAT / live min, 0 = free; max <%= fmt(C.price_per_min) %>)<input type="number" name="slot_price" min="0" max="<%= C.price_per_min %>" value="<%= room.slot_price %>"></label>
      <label class="chk"><input type="checkbox" name="approval" <%= room.approval ? 'checked' : '' %>> Bookings for later need my approval</label>
      <div class="row" style="grid-column: 1 / -1"><button type="submit" class="btn primary">Save stage settings</button><span class="msg" id="stageMsg" role="status"></span></div>
    </form>
    <p class="muted">Pepe's stream is always on every pad's stage. Paid featuring costs <%= fmt(C.price_per_min) %> PAT per live minute (site-wide price). In chat, <code>!stage</code>, <code>!stage feature &lt;name&gt;</code>, <code>!stage unfeature</code>, <code>!stage cut</code> and <code>!stage slots &lt;n&gt;</code> work for you in this pad's Camfrog room.</p>
  </section>

  <section class="sb-card" aria-labelledby="pageT">
    <h2 id="pageT">Pad page</h2>
    <form id="pageForm" class="book2">
      <label class="fld">Title<input type="text" name="title" maxlength="60" value="<%= room.title %>"></label>
      <label class="fld">Description<textarea name="description" maxlength="500"><%= room.description %></textarea></label>
      <label class="fld">Banner image (an https:// link, shown on top of the pad page)<input type="text" name="banner" maxlength="300" value="<%= room.banner %>" placeholder="https://…"></label>
      <div class="row"><button type="submit" class="btn primary">Save page</button><span class="msg" id="pageMsg" role="status"></span></div>
    </form>
  </section>

  <section class="sb-card" aria-labelledby="brT">
    <h2 id="brT">Website bridge</h2>
    <% if (!bridge) { %>
      <p class="note">Pepe isn't bridging this pad's Camfrog room right now — these switches appear when he is (an admin types <code>!bridge on</code> in the Camfrog room).</p>
    <% } else { %>
      <p class="muted">What website visitors can do in your Camfrog room. Pepe applies a change within a few seconds.</p>
      <div class="toggles" id="toggles">
        <% [['relay', 'Website chat lines (relayed by Pepe)', bridge.relay], ['mic', 'Website voice clips on the mic', bridge.mic], ['cams', 'Cam snapshots', bridge.cams],
            ['audio', 'Camfrog room audio to the website', bridge.audio], ['transcripts', 'Mic transcripts in the feed', bridge.transcripts]].forEach((t) => { %>
          <div class="toggle"><span><%= t[1] %><br><span class="<%= t[2] ? 'on' : 'off' %>" data-state="<%= t[0] %>"><%= t[2] ? 'ON' : 'OFF' %></span></span>
            <button type="button" class="btn" data-sw="<%= t[0] %>" data-on="<%= t[2] ? 0 : 1 %>"><%= t[2] ? 'Turn off' : 'Turn on' %></button></div>
        <% }) %>
      </div>
      <p class="msg" id="brMsg" role="status" aria-live="polite"></p>
    <% } %>
  </section>

  <section class="sb-card" id="royalties" aria-labelledby="royT">
    <h2 id="royT">Royalties</h2>
    <% if (!roy) { %>
      <p class="note"><%= room.house ? "House pads don't earn royalties — their share stays in the Federal Reserve." : 'Royalties go to a pad owner. This pad has none yet.' %></p>
    <% } else { const R = roy, pct = Math.min(100, R.active_days_needed ? (R.active_days / R.active_days_needed) * 100 : 100); %>
      <p class="muted"><% const osh = (R.owner_shares || []).filter((x) => x.pct > 0); %>You earn <b><%= R.config.stage_pct %>%</b> of what people pay for stage time here<% if (osh.length) { %> and a share of the PAT spent on Pepe's paid commands, song requests, voices and DJ shout-outs in this pad's Camfrog room<% } %> (your own spending doesn't count).<% if (osh.length) { %> <span class="muted">Shares: <%= osh.map((x) => x.label + ' ' + x.pct + '%').join(' · ') %>.</span><% } %> The Federal Reserve pays it out every <%= R.config.period_days %> days if the pad was active on at least <b><%= R.active_days_needed %></b> days (<%= R.config.active_minutes %>+ minutes live with <%= R.config.active_peak %>+ people). Max <%= fmt(R.config.cap_per_period) %> PAT per payout; unpaid royalties expire after <%= R.config.keep_periods %> periods.</p>
      <div class="facts">
        <div class="fact"><span class="k">This period</span><span class="v"><%= fmt(R.this_period.total) %> <small>PAT (stage <%= fmt(R.this_period.stage) %> · commands <%= fmt(R.this_period.spend) %>)</small></span></div>
        <div class="fact"><span class="k">Waiting to be paid</span><span class="v"><%= fmt(R.pending) %> <small>PAT</small></span></div>
        <div class="fact"><span class="k">Paid so far</span><span class="v"><%= fmt(R.paid) %> <small>PAT</small></span></div>
        <div class="fact"><span class="k">Next payout</span><span class="v"><small><%= day(R.next_release) %> UTC</small></span></div>
      </div>
      <div style="display:grid;gap:4px"><span class="muted">Active days this period: <b><%= R.active_days %></b> / <%= R.active_days_needed %></span>
        <div class="meter2" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= Math.round(pct) %>"><span style="width:<%= pct.toFixed(0) %>%"></span></div></div>
      <% if (R.recent.length) { %>
      <div class="tblwrap" style="margin-top:10px"><table><thead><tr><th>When</th><th>What</th><th class="num">Base</th><th class="num">Royalty</th></tr></thead><tbody>
        <% R.recent.forEach((x) => { %><tr><td><%= day(x.created) %></td><td><%= x.kind === 'accrue' ? (x.source === 'stage' ? 'Stage time' : 'Pepe commands') : x.kind === 'release' ? '✅ Paid by the Reserve' : '⌛ Expired' %><%= x.detail ? ' · ' + x.detail : '' %></td>
          <td class="num"><%= x.base ? fmt(x.base) : '' %></td><td class="num"><%= x.kind === 'accrue' ? '+' : '' %><%= fmt(x.amount) %></td></tr><% }) %>
      </tbody></table></div>
      <% } %>
    <% } %>
  </section>

  <section class="sb-card" aria-labelledby="banT">
    <h2 id="banT">Banned from this pad's stage</h2>
    <form id="banForm" class="row"><input type="text" name="username" placeholder="PATV or Camfrog name" required aria-label="Name to ban">
      <input type="text" name="reason" placeholder="reason (optional)" aria-label="Reason"><button type="submit" class="btn danger">Ban</button></form>
    <div class="tblwrap"><table><thead><tr><th>User</th><th>Reason</th><th>By</th><th></th></tr></thead><tbody id="banRows"></tbody></table></div>
  </section>

  <section class="sb-card" aria-labelledby="logT">
    <h2 id="logT">Recent</h2>
    <div class="tblwrap"><table><thead><tr><th>When</th><th>What</th><th>By</th><th>Detail</th></tr></thead><tbody id="evRows">
      <% (events || []).forEach((e) => { %><tr><td><%= new Date(e.ts).toISOString().slice(0, 16).replace('T', ' ') %></td><td><%= e.what %></td><td><%= e.actor || '' %></td><td><%= e.detail || '' %></td></tr><% }) %>
    </tbody></table></div>
  </section>
</main>
<script id="rmgState" type="application/json"><%- JSON.stringify(st).replace(/</g, '\\u003c') %></script>
<script src="/public/js/room-manage.js?v=1" defer></script>
</body>
</html>
