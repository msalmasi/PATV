<%- include('layout', { title: HOP.name + ' · ' + label + ' · PATV', user }) %>
<%#
  Hop's own page (1.99eq: /hop, /feed/following/hop, /p/<pad>/hop, /u/<user>/hop; hop.js). The viewer opens straight
  away over it from #hopInit (public/js/hop.js); without JS this is a plain list of the posts.
  Locals: HOP, scope, base, back, label, sort, t, post, first {items, next}, signed
%>
<%- include('partials/hop-boot', { HOP }) %>
<main class="ds-page read hop-page">
  <div class="ds-head">
    <a class="ds-back" href="<%= back %>">‹ Back to the feed</a>
    <h1 class="ds-h1"><span class="ds-ic" aria-hidden="true"><%= HOP.icon %></span> <%= HOP.name %> · <%= label %></h1>
  </div>
  <% if (!first.items.length) { %><p class="ds-empty">No pictures or videos here yet.</p><% } else { %>
    <ul class="ds-card ds-list hop-fallback"><% first.items.forEach((it) => { %><li><a class="grow" href="<%= it.url %>"><%= it.title || 'A post' %></a> <span class="ds-meta">by <%= it.author.display %><%= it.pad ? ' in ' + it.pad.label : '' %></span></li><% }) %></ul>
  <% } %>
</main>
<script type="application/json" id="hopInit"><%- JSON.stringify({ scope, base, back, label, sort, t, post, items: first.items, next: first.next, signed })
  .replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029') %></script>
</body>
</html>
