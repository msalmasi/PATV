<%- include('layout', { title: title, user: user}) %>
<style>
  /* 1.99pz polish: Pepe's Camfrog tables (tables.js) on the design system (docs/design-system.md, "Area notes: games" > Casino).
     main.ds-page.flow.cz in the casino accent; the classes casino.js writes (.card .hint .info .row .lbl .tag .b .seat ...) keep
     their names and read tokens. */
  .cz { --ds-ac: var(--ds-acc-casino); --ds-ac-2: var(--ds-acc-casino); --ds-ac-bg: rgba(126,224,138,.12); --ds-ac-line: #2e6b31; --ds-on-ac: #0b0f0c; }
  .cz a:not([class]) { color: var(--ds-green-2); }
  .cz .cz-head { display: grid; justify-items: center; gap: var(--ds-sp-1h); text-align: center; margin: var(--ds-sp-2) 0 var(--ds-sp-4); }
  .cz .cz-head .ds-h1 { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: var(--ds-sp-2); }
  .cz h2 { margin: var(--ds-sp-8) 0 var(--ds-sp-3); }
  .cz h3 { display: flex; align-items: center; gap: var(--ds-sp-2); margin: var(--ds-sp-4) 0 var(--ds-sp-1h); font: 700 var(--ds-fs-h4)/var(--ds-lh-h4) var(--ds-font); color: var(--ds-text-strong); }
  .cz .card h3:first-child { margin-top: 0; }
  .cz .info { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); line-height: 1.6; }
  .cz .info b.me-name { color: var(--ds-text-strong); } .cz .info b.gold { color: var(--ds-gold-text); }
  .cz .card { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); min-width: 0; }
  .cz .hint, .cz .warn { margin: 0 0 var(--ds-sp-3); padding: var(--ds-sp-3) var(--ds-sp-3h); border-radius: var(--ds-r-lg); font-size: var(--ds-fs-sm); line-height: var(--ds-lh-sm); }
  .cz .hint { background: var(--ds-gold-bg); border: 1px solid var(--ds-gold-line); color: var(--ds-warn-ink); }
  .cz .warn { background: var(--ds-danger-bg); border: 1px solid var(--ds-danger-line); color: var(--ds-danger-ink); }
  .cz .tabs { justify-content: center; margin: 0 0 var(--ds-sp-4); }
  .cz .status { min-height: 22px; text-align: center; font-size: var(--ds-fs-sm); color: #cfe8cf; margin: var(--ds-sp-1) 0 var(--ds-sp-2); }
  .cz .status.bad { color: var(--ds-danger); }

  /* ── the felt ── */
  .felt-wrap { position: relative; padding: 92px 76px 104px; }
  .felt-wrap.bjw { padding-top: 20px; padding-bottom: 120px; }
  .felt { position: relative; aspect-ratio: 2.05 / 1; border-radius: 999px; background:
            radial-gradient(ellipse at 50% 40%, #1f7a43 0%, #145c31 55%, #0d4023 100%);
          box-shadow: inset 0 0 0 10px #4a2c16, inset 0 0 0 12px #2a180b, inset 0 0 60px rgba(0,0,0,.55), 0 14px 40px rgba(0,0,0,.6); }
  .felt-c { position: absolute; inset: 18% 16%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; }
  .felt .ttl { color: rgba(255,255,255,.55); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .felt .msg { color: #fff; font-size: 15px; text-shadow: 0 1px 2px #000; }
  .board { display: flex; gap: 6px; justify-content: center; min-height: calc(var(--cw) * 1.4); }
  .slot { width: var(--cw); height: calc(var(--cw) * 1.4); border-radius: 6px; border: 1px dashed rgba(255,255,255,.22); }
  .pot { display: inline-flex; align-items: center; gap: 6px; background: rgba(0,0,0,.45); color: var(--ds-gold); border-radius: 999px; padding: 4px 12px;
         font-weight: bold; font-variant-numeric: tabular-nums; }
  .pots { color: rgba(255,255,255,.7); font-size: 12px; }
  .chip { display: inline-block; width: 14px; height: 14px; border-radius: 50%; background: radial-gradient(circle, var(--ds-gold) 0 35%, #c62828 36% 60%, #fff 61% 70%, #c62828 71%);
          box-shadow: 0 1px 2px #000; flex: none; }

  .cz { --cw: 42px; }
  .cd { position: relative; display: inline-flex; flex-direction: column; justify-content: center; align-items: center; width: var(--cw); height: calc(var(--cw) * 1.4);
        border-radius: 6px; background: linear-gradient(160deg, #fff 0%, #f1f1f1 100%); color: #111; box-shadow: 0 2px 4px rgba(0,0,0,.5); flex: none; font-weight: bold; line-height: 1; }
  .cd .cr { position: absolute; top: 3px; left: 4px; font-size: calc(var(--cw) * .32); }
  .cd .cs { font-size: calc(var(--cw) * .55); margin-top: calc(var(--cw) * .18); }
  .cd.red { color: #c62828; }
  .cd.back { background: repeating-linear-gradient(45deg, #b71c1c 0 4px, #d32f2f 4px 8px); border: 2px solid #fff; box-sizing: border-box; }
  .cd.back::after { content: ""; position: absolute; inset: 4px; border: 1px solid rgba(255,255,255,.55); border-radius: 3px; }
  .cd.sm { --cw: 30px; }
  .cd.dim { filter: grayscale(.8) brightness(.55); }
  @media (prefers-reduced-motion: no-preference) {
    .cd.new { animation: deal .32s ease-out both; }
    @keyframes deal { from { transform: translateY(-14px) rotate(-6deg); opacity: 0; } to { transform: none; opacity: 1; } }
    .seat.turn { animation: pulse 1.6s ease-in-out infinite; }
    @keyframes pulse { 50% { box-shadow: 0 0 0 3px var(--ds-gold), 0 0 22px rgba(255,215,0,.55); } }
  }

  .seat { position: absolute; transform: translate(-50%, -50%); width: 132px; background: rgba(12,12,12,.92); border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-md);
          padding: 6px 8px 7px; text-align: center; box-shadow: 0 6px 16px rgba(0,0,0,.5); z-index: 2; }
  .seat.me { border-color: var(--ds-green); box-shadow: 0 0 0 1px var(--ds-green), 0 6px 16px rgba(0,0,0,.5); }
  .seat.turn { border-color: var(--ds-gold); box-shadow: 0 0 0 2px var(--ds-gold); }
  .seat.winner { border-color: var(--ds-gold); background: #2a2208; }
  .seat.folded, .seat.waiting { opacity: .62; }
  .seat .nm { font-weight: bold; font-size: 13px; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .seat .st { font-size: 12px; color: var(--ds-gold); font-variant-numeric: tabular-nums; }
  .seat .tags { display: flex; gap: 4px; justify-content: center; flex-wrap: wrap; min-height: 0; margin-top: 2px; }
  .tag { font-size: 10.5px; font-weight: 700; line-height: 1; padding: 3px 5px; border-radius: var(--ds-r-xs); background: #333; color: #ddd; text-transform: uppercase; letter-spacing: .03em; }
  .tag.d { background: #fff; color: #111; border-radius: 50%; width: 16px; height: 16px; padding: 0; display: inline-flex; align-items: center; justify-content: center; font-weight: bold; }
  .tag.gold { background: var(--ds-gold); color: #111; } .tag.red { background: #c62828; color: #fff; } .tag.green { background: #2e7d32; color: #fff; }
  .seat .hc { display: flex; gap: 3px; justify-content: center; margin: 5px 0 2px; --cw: 32px; }
  .seat .hn { font-size: 11px; color: var(--ds-gold); }
  .seat .bet { position: absolute; left: 50%; transform: translateX(-50%); top: -26px; display: inline-flex; align-items: center; gap: 4px; background: rgba(0,0,0,.7);
               color: #fff; font-size: 12px; padding: 2px 8px 2px 4px; border-radius: 999px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .seat.top .bet { top: auto; bottom: -26px; }
  .tbar { height: 4px; background: #333; border-radius: 2px; margin-top: 5px; overflow: hidden; }
  .tbar i { display: block; height: 100%; background: var(--ds-gold); width: 100%; transition: width .25s linear; }
  .tbar.low i { background: #e53935; }
  .clock { font-variant-numeric: tabular-nums; }
  .bjh { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 3px 0; border-radius: 6px; }
  .bjh.cur { background: rgba(255,215,0,.12); outline: 1px solid rgba(255,215,0,.5); }
  .bjh .cards { display: flex; justify-content: center; --cw: 32px; }
  .bjh .cards .cd + .cd { margin-inline-start: -12px; }
  .bjh .v { font-size: 12px; color: #ddd; }
  .dealer .cards { display: flex; gap: 6px; justify-content: center; }
  .seat .hl { font-size: 10px; color: #bbb; text-transform: uppercase; letter-spacing: .04em; }
  .bjh.cur .hl { color: var(--ds-gold); }
  .bjh .pay { font-size: 11px; color: #ccc; }
  .bjh.last, .dealer.last { opacity: .8; }
  .result.lastr .tag { margin-inline-end: 4px; }
  .result.lastr .shown { margin-top: 4px; }
  .result.lastr .shown .cd { vertical-align: middle; }

  /* ── controls ── */
  .ctl { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-3) var(--ds-sp-4); display: grid; gap: 10px; margin-top: 12px; }
  .ctl .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .ctl .lbl { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); }
  /* game controls: the ds .square button shape (radius 10) - every fill passes AA with its ink */
  .cz button.b { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: var(--ds-tap); min-width: 88px; margin: 0; padding: 0 16px; border-radius: var(--ds-r-md); border: 0;
                 font: 700 15px/1.1 var(--ds-font); cursor: pointer; color: #fff; background: #3a3a3a; transition: filter var(--ds-dur-1); }
  .cz button.b:hover { filter: brightness(1.1); }
  .cz button.b.go { background: #2e7d32; } .cz button.b.warn { background: #9a5a00; } .cz button.b.stop { background: #8e2424; } .cz button.b.gold { background: var(--ds-gold-grad); color: var(--ds-on-gold); }
  .cz button.b.ghost { background: transparent; border: 1px solid var(--ds-line-strong); color: var(--ds-text); }
  .cz button.b.mini { min-height: 36px; min-width: 0; padding: 0 10px; font-size: 13px; }
  .cz button.b:disabled { opacity: .45; cursor: not-allowed; filter: none; }
  .cz button.b:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  /* fields the script writes: reset the legacy global input rule (margins, #ddd border, black text) */
  .cz input[type=number], .cz input[type=text], .cz select { margin: 0; background: var(--ds-sunken); color: #eee; border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-md); padding: 0 10px; min-height: var(--ds-tap);
        font: 400 15px/1.3 var(--ds-font); box-sizing: border-box; max-width: 100%; }
  .cz input[type=number]:focus, .cz input[type=text]:focus, .cz select:focus { outline: none; border-color: var(--ds-ac); box-shadow: 0 0 0 3px var(--ds-ac-bg); }
  .cz input[type=number] { width: 140px; }
  .cz input[type=range] { flex: 1 1 200px; min-width: 160px; accent-color: var(--ds-gold); height: 32px; }
  .raise { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; background: var(--ds-sunken); border: 1px solid var(--ds-line); border-radius: var(--ds-r-md); padding: 8px; }
  .mycards { display: flex; gap: 6px; align-items: center; --cw: 46px; }

  /* ── lobby, log ── */
  .grid2 { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--ds-sp-4); margin-top: var(--ds-sp-3); }
  .log { max-height: 280px; overflow-y: auto; font-size: 13px; display: grid; gap: 2px; }
  .log div { padding: 4px 2px; border-bottom: 1px solid var(--ds-line-soft); color: #ccc; }
  .log time { color: var(--ds-text-faint); font-size: 11px; margin-inline-end: 6px; font-variant-numeric: tabular-nums; }
  .acts div { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 2px 6px; padding: 5px 0; border-bottom: 1px solid var(--ds-line-soft); font-size: 13px; }
  .acts .lab { font-family: var(--ds-font-mono); color: var(--ds-text-muted); } .acts .m { grid-column: 2; } .acts .failed .m { color: var(--ds-danger); }
  .tlist { display: grid; gap: 8px; }
  .trow { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; align-items: center; min-height: var(--ds-tap); background: var(--ds-sunken); border: 1px solid var(--ds-line-soft); border-radius: var(--ds-r-md); padding: 10px 12px; }
  .trow b { color: #fff; }
  form.start { display: grid; gap: 10px; }
  form.start .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .result { background: rgba(0,0,0,.55); border: 1px solid var(--ds-gold); border-radius: var(--ds-r-sm); padding: 6px 10px; color: #ffe57a; font-size: 13px; max-width: 100%; }
  .howto { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--ds-sp-3); }
  .howto ul { margin: 6px 0; padding-inline-start: 20px; color: var(--ds-text-2); font-size: var(--ds-fs-sm); line-height: 1.65; }
  .howto p { color: var(--ds-text-2); font-size: var(--ds-fs-sm); line-height: 1.6; margin: 6px 0; }
  .seats-list { display: none; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (prefers-reduced-motion: reduce) { .cz *, .cz *::before, .cz *::after { animation: none !important; transition: none !important; } }
  @media (max-width: 760px) {
    .cz { --cw: 34px; }
    .felt-wrap, .felt-wrap.bjw { padding: 8px 0 0; }
    .felt { aspect-ratio: auto; min-height: 210px; border-radius: 40px; }
    .felt-c { position: static; padding: 26px 16px; }
    .felt .seat { display: none; }
    .seats-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 12px; }
    .seats-list .seat { position: relative; transform: none; width: auto; left: auto; top: auto; }
    .seats-list .seat .bet { position: static; transform: none; display: inline-flex; margin-top: 4px; }
    .grid2 { grid-template-columns: minmax(0, 1fr); }
    .cz input[type=number] { width: 120px; }
    .cz button.b { min-width: 0; flex: 1 1 auto; }
  }
</style>
<main class="ds-page flow cz" id="cz" data-focus="<%= focus %>" data-signed="<%= user ? 1 : 0 %>" data-table="<%= tableId || '' %>">
  <div class="cz-head">
    <h1 class="ds-h1"><span class="ds-ic" aria-hidden="true"><%= focus === 'holdem' ? '🃏' : focus === 'bj' ? '🂡' : '🎰' %></span><%= focus === 'holdem' ? "Texas Hold'em" : focus === 'bj' ? 'Blackjack' : 'Casino tables' %></h1>
    <p class="ds-sub">Pepe deals in Camfrog — play from chat or right here. Same table, same chips: PAT.</p>
  </div>
  <nav class="ds-tabs wrap tabs" aria-label="Casino pages">
    <%# 1.99ol: the other tabs go where the casino front-end setting sends that game (casino/routes.js casinoPath) %>
    <% const _cp = (g, own) => typeof casinoPath === 'function' ? casinoPath(g) : own; %>
    <a href="<%= focus === 'lobby' ? '/tables' : _cp('lobby', '/tables') %>" class="ds-tab"<%- focus === 'lobby' ? ' aria-current="page"' : '' %>>Lobby</a>
    <a href="<%= focus === 'holdem' ? '/poker' : _cp('holdem', '/poker') %>" class="ds-tab"<%- focus === 'holdem' ? ' aria-current="page"' : '' %>>Texas Hold'em</a>
    <a href="<%= focus === 'bj' ? '/blackjack' : _cp('bj', '/blackjack') %>" class="ds-tab"<%- focus === 'bj' ? ' aria-current="page"' : '' %>>Blackjack</a>
  </nav>

  <% if (!user) { %>
    <p class="hint">You're watching. <a href="/login">Sign in</a> and link your Camfrog name to take a seat.</p>
  <% } else if (!me || !me.camfrogUsername) { %>
    <p class="hint">To play from here, link your Camfrog name: type <code>!verify</code> in a Camfrog room with Pepe. You play as that name — the same seat, balance and rules as in chat. Until then you can watch.</p>
  <% } else if (me.casino_banned) { %>
    <p class="warn">You're banned from the casino, so you can watch but not play.</p>
  <% } else { %>
    <p class="info" style="text-align:center">Playing as <b class="me-name"><%= me.camfrogUsername %></b> · balance <b class="gold"><%= Math.round(Number(me.points_balance) || 0).toLocaleString() %> PAT</b> when the page loaded.</p>
  <% } %>

  <div class="status" id="cz-status" role="status" aria-live="polite"></div>
  <section id="cz-live" aria-label="Live table"><div class="card"><p class="info" style="text-align:center;margin:0">Loading the table…</p></div></section>

  <div class="grid2">
    <section aria-labelledby="cz-lobby-h">
      <h2 id="cz-lobby-h" class="ds-pixel-h">TABLES</h2>
      <div id="cz-lobby"></div>
    </section>
    <section aria-labelledby="cz-log-h">
      <h2 id="cz-log-h" class="ds-pixel-h">TABLE LOG</h2>
      <div class="card"><div class="log" id="cz-log"><span class="info">Nothing yet.</span></div></div>
      <div id="cz-acts-wrap" hidden>
        <h2 class="ds-pixel-h">YOUR MOVES</h2>
        <div class="card acts" id="cz-acts"></div>
      </div>
    </section>
  </div>

  <h2 id="how" class="ds-pixel-h">HOW TO PLAY</h2>
  <div class="howto">
    <%
      const holdemCard = () => { %>
      <div class="card">
        <h3><span class="ds-ic" aria-hidden="true">🃏</span>Texas Hold'em (No-Limit)</h3>
        <p>In a Camfrog room with Pepe:</p>
        <ul>
          <li><code>!holdem start 25/50</code> opens a table (small/big blind; up to 5,000/10,000). 💎 High Rollers open High Roller tables: <code>!holdem start 100k/200k</code>, then 250K/500K, 500K/1M, 1M/2M, 2.5M/5M or 5M/10M (High Rollers only; anyone can watch).</li>
          <li><code>!sit 2000</code> buys in: 20–200 big blinds. Chips are PAT, 1:1, held by Pepe while you're seated. <code>!sit</code> again tops you up.</li>
          <li><code>!holdem deal</code> starts a hand once two players have chips; after that the next hand deals itself 15 s after the last.</li>
          <li>On your turn: <code>!check</code> <code>!call</code> <code>!bet 200</code> <code>!raise 600</code> (raise <i>to</i>) <code>!allin</code> <code>!fold</code>. You have 60 s; if time runs out you check, or fold and sit out after the hand.</li>
          <li>Your two hole cards come by private message (<code>!cards</code> resends them).</li>
          <li><code>!stand</code> cashes your chips back to PAT (after the hand if you're in one). <code>!holdem status</code> shows the table; the host or an admin can <code>!holdem end</code> it between hands.</li>
        </ul>
        <p>Up to 9 seats. A 2% rake comes off pots that reach a showdown and goes to the casino. A table with no hand running for 5 minutes closes and pays everyone out.</p>
      </div>
    <% }; const bjCard = () => { %>
      <div class="card">
        <h3><span class="ds-ic" aria-hidden="true">🂡</span>Blackjack (Pepe is the dealer)</h3>
        <p>In a Camfrog room with Pepe:</p>
        <ul>
          <li><code>!blackjack start</code> (or <code>!bj start</code>) opens a table.</li>
          <li><code>!bet 500</code> each round: 100–100,000 PAT. 💎 <code>!bj start hr</code> opens a High Roller table: 100,000–1,000,000 a hand, High Rollers only. The first betting window is 30 s, then 10 s between rounds; <code>!bj deal</code> deals straight away. A bet placed mid-round is held for the next one.</li>
          <li>On your turn: <code>!hit</code> <code>!stand</code> <code>!double</code> <code>!split</code>. When Pepe shows an Ace, <code>!insurance</code> costs half your bet and pays 2:1.</li>
          <li><code>!autobet 500</code> re-bets every round (<code>!autobet off</code> stops). <code>!bj leave</code> leaves; the host or an admin can <code>!bj end</code>.</li>
        </ul>
        <p>6-deck shoe shuffled fresh every round, blackjack pays 3:2, Pepe hits soft 17, split up to 4 hands with doubling after a split, no surrender. 30 s per decision (time out = stand; three in a row and you're removed; three rounds without a bet and you're removed). The casino jackpot is the house bank: losing bets go into it and wins are paid from it, so a table only takes bets the jackpot can cover.</p>
      </div>
    <% }; %>
    <% if (focus === 'bj') { bjCard(); holdemCard(); } else { holdemCard(); bjCard(); } %>
    <div class="card">
      <h3><span class="ds-ic" aria-hidden="true">🌐</span>Playing from this page</h3>
      <ul>
        <li>Sign in and link your Camfrog name (<code>!verify</code> in a room). You play <i>as</i> that name: same seat, same PAT balance, same limits, fees and timers as typing the commands in chat.</li>
        <li>Your moves go to Pepe and land in a second or two; the room sees them like any chat move, and Camfrog players' moves show up here.</li>
        <li>Your hole cards are shown only to you, once you're signed in. Nobody else can fetch them — not other players, not spectators.</li>
        <li>Closing the tab doesn't stop the clock: the turn timer treats you exactly like an idle chat player.</li>
        <li>Tables run in one Camfrog room at a time, and one at a time overall: Hold'em and Blackjack can't both be open, and neither can start while another Pepe game (a heist, trivia…) is running.</li>
      </ul>
    </div>
    <div class="card">
      <h3><span class="ds-ic" aria-hidden="true">🎲</span>Fair dealing</h3>
      <p>The deck lives only inside Pepe. Every hand (and every blackjack round) is shuffled from a fresh secret seed drawn from the operating system's random generator, and each deal is recorded so it can be audited afterwards. The website never sees cards that haven't been dealt — it only shows what's already on the table.</p>
      <h3><span class="ds-ic" aria-hidden="true">💬</span>Discord</h3>
      <p>Pepe's tables aren't on Discord. The Discord server has its own separate games: <code>!bj 500</code> in the #blackjack channel is a solo hand against the Discord dealer bot (up to 5,000 PAT; the High Roller role lifts that), and PokerNow tables in #poker use <code>/buyin</code> and <code>/cashout</code>.</p>
      <% if (focus === 'holdem' && pokerNow && pokerNow.length) { %>
        <p class="info">Discord PokerNow tables from the last 12 hours:</p>
        <ul><% pokerNow.forEach((g) => { %><li><a href="<%= g.url %>" rel="noopener"><%= g.blinds %></a> — started by <%- ul(g.username, { text: g.displayname || g.username, user: true }) %></li><% }) %></ul>
      <% } %>
    </div>
  </div>
</main>
<script src="/public/js/casino.js?v=7"></script>
