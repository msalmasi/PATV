<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('err.notfound.title'), user: user}) %>
<%# 1.99pm: on the design system - a centred .ds-empty-style landing (docs/design-system.md, "Profile, account and auth") %>
<style>
  .nf { text-align: center; justify-items: center; padding-block-start: var(--ds-sp-12); }
  .nf .nf-frog { font-size: 64px; width: auto; height: auto; line-height: 1; }
  .nf .ds-stack { justify-items: center; }
  .nf .ds-h1 { margin: var(--ds-sp-1) 0 0; }
  .nf .ds-lead { margin: 0 auto; max-width: 46ch; }
  .nf .ds-actions { justify-content: center; margin-block-start: var(--ds-sp-2); }
  .nf code { color: var(--ds-text); }
</style>
<main class="ds-page narrow nf">
  <div class="ds-stack">
    <span class="ds-ic nf-frog" aria-hidden="true">🐸</span>
    <h1 class="ds-h1"><% if (heading) { %><%= heading %><% } else { %><%- t('err.notfound.heading') %><% } %></h1>
    <%# 1.99add: `message` is TEXT and always escaped (/p/<slug> put the raw path in it: reflected XSS); markup the
        caller built and escaped itself goes in `messageHtml` (index.js notFound(): the profile pages' <code>name</code>). %>
    <p class="ds-lead"><% if (locals.messageHtml) { %><%- messageHtml %><% } else if (message) { %><%= message %><% } else { %><%- t('err.notfound.message') %><% } %></p>
    <div class="ds-actions">
      <a class="ds-btn" href="/"><%- t('err.notfound.home') %></a>
      <a class="ds-btn ghost" href="/markets"><%- t('nav.markets') %></a>
      <% if (user) { %><a class="ds-btn ghost" href="/u/<%= encodeURIComponent(user) %>"><%- t('nav.your_profile') %></a><% } %>
    </div>
  </div>
</main>
</body>
</html>
