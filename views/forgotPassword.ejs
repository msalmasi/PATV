<%# views/forgotPassword.ejs - ask for a reset link (GET/POST /forgot-password in index.js) -%>
<%- include('layout', { title: 'Reset your password · Public Access TV', user: user }) %>
<%
  const F = (typeof form !== 'undefined' && form) ? form : {};
  const errs = (errors || []).filter(Boolean), oks = (success || []).filter(Boolean);
  const inline = errs.length && F.field === 'email';
%>
<%- include('partials/auth-css') %>
<main class="au">
  <section class="au-card" aria-labelledby="au-title">
    <div class="au-brand"><img src="/public/img/pepe.png" alt=""><span class="k">publicaccess.tv</span></div>
    <h1 id="au-title">Forgot your password?</h1>
    <p class="sub">Enter the email on your account and we'll send you a link to choose a new one.</p>

    <% if (oks.length) { %><div class="au-alert ok" role="status"><%= oks.join(' ') %></div><% } %>
    <% if (errs.length && !inline) { %><div class="au-alert err" role="alert"><%= errs.join(' ') %></div><% } %>

    <form action="/forgot-password" method="POST" data-au-form>
      <div class="au-field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= F.email || '' %>" required
               autocomplete="email" autocapitalize="none" spellcheck="false" maxlength="254" inputmode="email"
               data-rule="email" aria-describedby="email-err"<% if (inline) { %> aria-invalid="true"<% } %><% if (!F.sent) { %> data-autofocus<% } %>>
        <div class="au-err" id="email-err" aria-live="polite"><%= inline ? errs.join(' ') : '' %></div>
      </div>
      <button type="submit" class="au-btn" data-busy="Sending…"><span class="spin" aria-hidden="true"></span><span class="lbl"><%= F.sent ? 'Send another link' : 'Send reset link' %></span></button>
    </form>
    <p class="au-oauth-note">Signed up with Discord or Twitch? You don't need a password - just <a href="/login">sign in</a> with those.</p>
  </section>
  <p class="au-foot">Remembered it? <a href="/login">Sign in</a> · <a href="/register">Create an account</a></p>
</main>
<%- include('partials/auth-js') %>
