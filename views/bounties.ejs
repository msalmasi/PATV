<%- include('layout', { title: 'Bounty Board', user: user}) %>
<style>
  .bt { max-width: 980px; margin: 0 auto; padding: 0 16px 48px; font-family: Ubuntu, sans-serif; }
  .bt h1 { text-align: center; margin-bottom: 4px; }
  .bt .sub { text-align: center; color: #9a9; margin: 0 0 22px; }
  .bt h2 { color: #ffd700; font-family: 'Press Start 2P', monospace; font-size: 12px; margin: 26px 0 10px; }
  .bt .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
  .bt .card { background: #111; border: 1px solid #222; border-radius: 10px; padding: 14px 16px; display: grid; gap: 8px; color: inherit; text-decoration: none; }
  .bt .card:hover { border-color: #e0a030; }
  .bt .ref { color: #e0a030; font-family: monospace; font-size: 13px; }
  .bt .task { font-weight: bold; color: #fff; font-size: 15px; line-height: 1.35; min-width: 0; overflow-wrap: anywhere; }
  .bt .pot { font-size: 22px; font-weight: bold; color: #ffd700; font-variant-numeric: tabular-nums; }
  .bt .info { color: #888; font-size: 13px; }
  .bt .pill { font-size: 11px; padding: 2px 8px; border-radius: 10px; border: 1px solid #333; color: #ccc; justify-self: start; }
  .bt .pill.resolved { border-color: #4caf50; color: #81c784; }
  .bt .empty { color: #888; text-align: center; }
  .bt .how { color: #888; font-size: 13px; text-align: center; margin-top: 26px; }
  .bt code { background: #1c1c1c; padding: 1px 5px; border-radius: 4px; }
  .bt form.newbt { background: #111; border: 1px solid #222; border-radius: 10px; padding: 14px; display: grid; gap: 10px; }
  .bt form.newbt label { display: grid; gap: 4px; font-size: 13px; color: #bbb; min-width: 0; }
  .bt form.newbt .row2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; }
  .bt form.newbt input, .bt form.newbt select { background: #0d0d0d; color: #eee; border: 1px solid #333; border-radius: 6px; padding: 8px 10px; width: 100%; box-sizing: border-box; }
  .bt .vline { font-size: 12px; color: #8fc3ff; overflow-wrap: anywhere; }
  .bt form.newbt button { background: #e0a030; color: #111; border: 0; border-radius: 6px; padding: 9px 16px; font-weight: bold; cursor: pointer; justify-self: start; }
</style>
<%
  const left = (t) => { const s = Math.max(0, Math.round(t - now)); return s >= 86400 ? Math.floor(s/86400) + 'd ' + Math.floor(s%86400/3600) + 'h' : s >= 3600 ? Math.floor(s/3600) + 'h ' + Math.floor(s%3600/60) + 'm' : Math.max(1, Math.floor(s/60)) + 'm'; };
  const card = (b) => { %>
    <a class="card" href="/bounties/<%= b.id %>">
      <span class="ref"><%= b.ref %> · posted by <%= b.creator %></span>
      <span class="task"><%= b.task %></span>
      <span class="pot"><%= b.total.toLocaleString() %> PAT</span>
      <% const vchk = (b.claims || []).filter((c) => c.check && ['verified', 'creator', 'admin'].includes(c.check.state)).length;
         const vev = (b.claims || []).filter((c) => c.evidence && (c.evidence.links || []).length).length; %>
      <% if (b.verify || vev || b.auto) { %><span class="vline"><%= b.verify ? '🔎 Pepe verifies' : '' %><%= b.auto ? ' · paid on Pepe’s check' : (vchk ? ' · ' + vchk + ' matching claim' + (vchk === 1 ? '' : 's') : '') %><%= vev ? ' · 🔗 ' + vev + ' with evidence' : '' %></span><% } %>
      <span class="info">
        <% if (b.status === 'open') { %><%= b.claims.length %> claim<%= b.claims.length === 1 ? '' : 's' %> · <%= b.backers.length %> backer<%= b.backers.length === 1 ? '' : 's' %> · ends in <%= left(b.deadline) %>
        <% } else if (b.status === 'resolved') { %>paid to <%= (b.hunters || []).join(', ') %>
        <% } else { %><%= b.status %> — refunded<% } %>
      </span>
      <% if (b.status !== 'open') { %><span class="pill <%= b.status %>"><%= b.status %></span><% } %>
    </a>
<% }; %>
<div class="bt">
  <h1>Bounty Board</h1>
  <p class="sub"><a href="#new" style="color:#e0a030">＋ Post a bounty</a> · Put PAT on a job. Anyone can chip in to the pot, hunters claim it, and the poster pays whoever did it.</p>
  <h2>OPEN BOUNTIES</h2>
  <% if (!live.length) { %><p class="empty">No open bounties right now.</p><% } %>
  <div class="grid"><% live.forEach((b) => card(b)) %></div>
  <h2>RECENTLY CLOSED</h2>
  <% if (!done.length) { %><p class="empty">Nothing closed yet.</p><% } %>
  <div class="grid"><% done.forEach((b) => card(b)) %></div>
  <h2 id="new">POST A BOUNTY</h2>
  <%- include('partials/actions', { acts: typeof acts !== 'undefined' ? acts : [], msg: typeof msg !== 'undefined' ? msg : null }) %>
  <% if (!user) { %>
    <p class="empty"><a href="/login" style="color:#81c784">Sign in</a> to post a bounty.</p>
  <% } else if (typeof linked === 'undefined' || !linked) { %>
    <p class="empty">Link your Camfrog name (type <code>!verify</code> in a Camfrog room) to post bounties from here.</p>
  <% } else { %>
    <form class="newbt" method="post" action="/act">
      <input type="hidden" name="kind" value="cmd"><input type="hidden" name="cmd" value="bounty">
      <input type="hidden" name="back" value="/bounties"><input type="hidden" name="tag" value="bounties">
      <label>The job <input type="text" name="a0" maxlength="200" required placeholder="get Brian on cam tonight"></label>
      <div class="row2">
        <label>Reward (PAT) <input type="number" name="a1" min="100" step="100" required placeholder="10000"></label>
        <label>Expires in <select name="a2"><option value="by 1d">1 day</option><option value="by 2d">2 days</option><option value="by 7d" selected>7 days</option><option value="by 30d">30 days</option></select></label>
      </div>
      <button type="submit">Post bounty</button>
      <span class="info">The reward is held in escrow. You pay whoever pulls it off (5% fee); cancel or let it expire and everyone is refunded.</span>
    </form>
  <% } %>
  <p class="how">Post one in a Camfrog room: <code>!bounty get Brian on cam tonight 10k by 2d</code> · the pot sits in escrow until it's paid, cancelled or expires (then everyone is refunded).</p>
</div>
</body>
</html>
