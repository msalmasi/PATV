<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('bounties.title'), user: user}) %>
<%# views/bounties.ejs - 1.99ly design pass (bets.css): a "wanted board" - hero with the open pot total, bounty cards like
    posters (the reward big, the job, status chip, verification line, claims / backers, a live countdown with the end
    time in the viewer's zone), closed ones dimmed, and the post form (same /act !bounty command). %>
<link rel="stylesheet" href="/public/css/bets.css?v=1">
<script src="/public/js/bets.js?v=1" defer></script>
<style>
  .bt { --ac: #ffb300; --ac2: #ffd54f; --acbg: rgba(255, 179, 0, .13); --acink: #2a1600; }
  .bt .card { position: relative; overflow: hidden; gap: 10px; border-top: 3px solid var(--ac); }
  .bt .card::after { content: ""; position: absolute; right: -30px; top: -30px; width: 110px; height: 110px; border-radius: 50%; background: radial-gradient(circle, rgba(255, 179, 0, .12), transparent 70%); pointer-events: none; }
  .bt .wanted { font: 900 11px/1 Ubuntu, sans-serif; letter-spacing: .2em; color: var(--ac2); text-transform: uppercase; }
  .bt .pot { font: 900 30px/1.05 Ubuntu, sans-serif; color: var(--goldt); font-variant-numeric: tabular-nums; }
  .bt .pot small { font-size: 14px; color: var(--mut); margin-left: 4px; }
  .bt .task { font-weight: bold; color: #fff; font-size: 16px; line-height: 1.4; overflow-wrap: anywhere; margin: 0; }
  .bt .info { color: var(--mut); font-size: 13px; line-height: 1.6; }
  .bt .info b { color: #ddd; }
  .bt .vline { font-size: 12.5px; color: #8fc3ff; overflow-wrap: anywhere; }
  .bt .cd { color: var(--ac2); font-weight: bold; font-variant-numeric: tabular-nums; }
  .bt .done .card { border-top-color: #444; background: #101010; }
  .bt .done .card .pot { color: #cfcfcf; font-size: 24px; }
  .bt form.newbt { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 18px; }
</style>
<%
  const fmt = (n) => t.num(Math.round(Number(n) || 0));
  const left = (tt) => { const s = Math.max(0, Math.round(tt - now)); return s >= 86400 ? t('bx.dur.dh', { d: Math.floor(s / 86400), h: Math.floor(s % 86400 / 3600) }) : s >= 3600 ? t('bx.dur.hm', { h: Math.floor(s / 3600), m: Math.floor(s % 3600 / 60) }) : t('bx.dur.m', { m: Math.max(1, Math.floor(s / 60)) }); };
  const chipOf = (b) => b.status === 'open' ? (b.deadline > now ? ['open', t('bounties.st.open')] : ['closed', t('bounties.st.expiring')]) : b.status === 'resolved' ? ['resolved', t('bounties.st.resolved')]
    : b.status === 'cancelled' ? ['cancelled', t('bounties.st.cancelled')] : b.status === 'expired' ? ['expired', t('bounties.st.expired')] : ['', t.esc(b.status)];
  const potOpen = live.reduce((a, b) => a + (b.total || 0), 0);
  const card = (b) => { const c = chipOf(b); %>
    <a class="card bx-card" href="/bounties/<%= b.id %>">
      <div class="bx-top"><span class="bx-ref"><%= b.ref %></span><span class="bx-chip c-<%= c[0] %>"><%- c[1] %></span><span class="wanted" style="margin-left:auto"><%- t('bounties.wanted') %></span></div>
      <div class="pot"><%= fmt(b.total) %><small>PAT</small></div>
      <p class="task"><%= b.task %></p>
      <% const vchk = (b.claims || []).filter((c) => c.check && ['verified', 'creator', 'admin'].includes(c.check.state)).length;
         const vev = (b.claims || []).filter((c) => c.evidence && (c.evidence.links || []).length).length; %>
      <% if (b.verify || vev || b.auto) { %><span class="vline"><%- [b.verify ? '🔎 ' + t('bounties.v_pepe') : '', b.auto ? t('bounties.v_auto') : (vchk ? t('bounties.v_match', { count: vchk }) : ''), vev ? '🔗 ' + t('bounties.v_ev', { count: vev }) : ''].filter(Boolean).join(' · ') %></span><% } %>
      <span class="info">
        <%- t('bounties.posted_by', { who: b.creator }) %><br>
        <% if (b.status === 'open') { %><%- t('bounties.claims', { count: b.claims.length }) %> · <%- t('bounties.backers', { count: b.backers.length }) %><% if (b.deadline > now) { %> · <%- t('bounties.ends_in', { left: '<span class="cd" data-until="' + Number(b.deadline) + '">' + left(b.deadline) + '</span>' }) %><% } %>
        <% } else if (b.status === 'resolved') { %><%- t('bounties.paid_to', { who: t.esc((b.hunters || []).join(', ')) }) %>
        <% } else { %><%- t('bounties.refunded') %><% } %>
      </span>
    </a>
<% }; %>
<main class="bx bt">
  <header class="bx-hero">
    <div class="bx-eyebrow">🎯 <%- t('bounties.eyebrow') %></div>
    <h1><%- t('bounties.h1') %></h1>
    <p class="bx-lead"><%- t('bounties.lead') %></p>
    <div class="bx-stats">
      <span class="bx-stat"><b><%= fmt(live.length) %></b><%- t('bounties.stat_open', { count: live.length }) %></span>
      <span class="bx-stat"><b><%= fmt(potOpen) %></b><%- t('bounties.stat_pot') %></span>
    </div>
    <div class="bx-ctas"><a class="bx-btn" href="#new">＋ <%- t('bounties.cta_new') %></a><a class="bx-btn ghost" href="/gtf"><%- t('bounties.cta_gtf') %></a></div>
  </header>
  <h2 class="bx-h"><%- t('bounties.h_open') %> <span class="bx-n"><%= live.length %></span></h2>
  <% if (!live.length) { %><div class="bx-empty"><span class="ic" aria-hidden="true">🎯</span><b><%- t('bounties.empty_open') %></b><a class="bx-btn sm" href="#new">＋ <%- t('bounties.cta_new') %></a></div><% } %>
  <div class="bx-grid"><% live.forEach((b) => card(b)) %></div>
  <h2 class="bx-h"><%- t('bounties.h_done') %></h2>
  <% if (!done.length) { %><div class="bx-empty"><span class="ic" aria-hidden="true">📜</span><b><%- t('bounties.empty_done') %></b></div><% } %>
  <div class="bx-grid done"><% done.forEach((b) => card(b)) %></div>
  <h2 class="bx-h" id="new"><%- t('bounties.h_new') %></h2>
  <%- include('partials/actions', { acts: typeof acts !== 'undefined' ? acts : [], msg: typeof msg !== 'undefined' ? msg : null }) %>
  <% if (!user) { %>
    <div class="bx-empty"><span class="ic" aria-hidden="true">🔑</span><b><%- t('bounties.signin') %></b><a class="bx-btn sm" href="/login"><%- t('bx.signin_btn') %></a></div>
  <% } else if (typeof linked === 'undefined' || !linked) { %>
    <p class="bx-note"><%- t('bounties.link') %></p>
  <% } else { %>
    <form class="newbt bx-form" method="post" action="/act">
      <input type="hidden" name="kind" value="cmd"><input type="hidden" name="cmd" value="bounty">
      <input type="hidden" name="back" value="/bounties"><input type="hidden" name="tag" value="bounties">
      <label class="bx-field"><%- t('bounties.f_job') %> <input class="bx-in" type="text" name="a0" maxlength="200" required placeholder="<%- t('bounties.f_job_ph') %>"></label>
      <div class="bx-row2">
        <label class="bx-field"><%- t('bounties.f_reward') %> <input class="bx-in" type="text" name="a1" inputmode="numeric" autocomplete="off" spellcheck="false" pattern="\s*(\d{1,3}(,\d{3})+|\d+(_\d+)*)?(\.\d+)?[kKmMbB]?\s*" required placeholder="10,000"></label>
        <label class="bx-field"><%- t('bounties.f_exp') %> <select class="bx-in" name="a2"><option value="by 1d"><%- t('bx.d.1d') %></option><option value="by 2d"><%- t('bx.d.2d') %></option><option value="by 7d" selected><%- t('bx.d.7d') %></option><option value="by 30d"><%- t('bx.d.30d') %></option></select></label>
      </div>
      <div class="bx-chips"><% [1000, 5000, 10000, 50000].forEach((v) => { %><button type="button" class="bx-qa" data-amt="<%= v %>" data-amt-field="a1"><%= v / 1000 %>k</button><% }) %></div>
      <div class="bx-row"><button class="bx-btn" type="submit"><%- t('bounties.f_btn') %></button></div>
      <p class="bx-fine"><%- t('bounties.f_fine') %></p>
    </form>
  <% } %>
  <div class="bx-foot"><%- t('bounties.foot') %></div>
</main>
</body>
</html>
