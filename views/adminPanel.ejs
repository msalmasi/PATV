<%- include('layout', { title: 'Admin Panel', user: user}) %>
<body>
    <div class="panel">
    <h1>Admin Panel</h1>
    <h2>Welcome, <%= user %>!</h2>
    <% if (errors != "") { %>
        <div class="alert alert-danger"><br><br><%= errors %></div>
    <% } %>
    <% if (success != "") { %>
        <div class="alert alert-success"><br><br><%= success %></div>
    <% } %>
        </div>

        
    <div class="panel" id="welcome-admin">
        <h3>Welcome bonus</h3>
        <p style="font-size:13px;color:#aaa;line-height:1.5">New accounts start at 0. The welcome bonus vests after real play (level, active days, account age) and is paid once per person from the Federal Reserve; an account that matches one that already got it (Camfrog identity, Discord, Twitch, email, browser, or too many from one network) is marked duplicate - you can still pay it. Connect bonuses: once per Discord/Twitch id, held until the welcome vests.</p>
        <form id="welcome-config" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px;align-items:end">
            <label>On <select name="enabled"><option value="1">yes</option><option value="0">no (pending ones wait)</option></select></label>
            <label>Amount (PAT) <input type="number" name="amount" min="0" step="1000"></label>
            <label>Min level <input type="number" name="min_level" min="0"></label>
            <label>Active days <input type="number" name="min_days" min="0"></label>
            <label>Min account age (h) <input type="number" name="min_age_hours" min="0"></label>
            <label>Per network <input type="number" name="ip_max" min="0"></label>
            <label>...per days <input type="number" name="ip_window_days" min="1"></label>
            <label>Expire after (days) <input type="number" name="expire_days" min="1"></label>
            <label>Connect bonus (PAT) <input type="number" name="connect_amount" min="0" step="1000"></label>
            <button type="submit">Save</button>
        </form>
        <p id="welcome-stats" style="font-size:13px;color:#ccc"></p>
        <div style="overflow-x:auto"><table id="welcome-recent" style="width:100%;font-size:12px;border-collapse:collapse"></table></div>
    </div>
    <script>
    (function () {
        const host = document.getElementById('welcome-admin');
        const form = document.getElementById('welcome-config');
        const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'})[c]);
        const when = (t) => t ? new Date(Number(t)).toISOString().slice(0, 16).replace('T', ' ') : '';
        async function load() {
            const r = await fetch('/api/admin/welcome');
            if (r.status === 403) { host.querySelector('p').insertAdjacentHTML('afterend', '<p>Admins only.</p>'); form.remove(); return; }
            const d = await r.json();
            for (const [k, v] of Object.entries(d.config || {})) if (form.elements[k]) form.elements[k].value = v;
            const c = d.counts || {};
            document.getElementById('welcome-stats').textContent = 'Pending ' + (c.pending || 0) + ' · paid ' + (c.paid || 0) + ' · duplicate ' + (c.duplicate || 0)
                + ' · expired ' + (c.expired || 0) + ' · legacy ' + (c.legacy || 0) + ' — last 7 days: ' + d.paid7.n + ' paid, '
                + Number(d.paid7.total).toLocaleString() + ' PAT (' + Number(d.paid7.perDay).toLocaleString() + '/day)';
            document.getElementById('welcome-recent').innerHTML = '<tr><th align="left">Account</th><th align="left">State</th><th align="left">Why</th><th>When (UTC)</th><th></th></tr>'
                + (d.recent || []).map((x) => '<tr style="border-top:1px solid #333"><td>' + esc(x.displayname || x.username || x.userId) + ' <small>(' + esc(x.source || '') + ')</small></td><td>' + esc(x.state)
                + (x.amount ? ' ' + Number(x.amount).toLocaleString() : '') + '</td><td>' + esc(x.reason || '') + (x.dup_name ? ' → ' + esc(x.dup_name) : '') + '</td><td>' + when(x.decided || x.created) + '</td><td>'
                + (x.state === 'duplicate' || x.state === 'expired' ? '<button data-pay="' + esc(x.userId) + '">Pay anyway</button>' : '') + '</td></tr>').join('');
        }
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const body = {};
            for (const el of form.elements) if (el.name) body[el.name] = Number(el.value);
            const r = await fetch('/api/admin/welcome/config', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)});
            alert(r.ok ? 'Saved.' : 'Not saved.');
            load();
        });
        host.addEventListener('click', async (e) => {
            const id = e.target && e.target.dataset && e.target.dataset.pay;
            if (!id || !confirm('Pay this account its welcome bonus anyway?')) return;
            const r = await (await fetch('/api/admin/welcome/pay', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({userId: id})})).json();
            alert(r.ok ? 'Paid ' + Number(r.amount).toLocaleString() + ' PAT.' : 'Not paid: ' + (r.why || r.error));
            load();
        });
        load().catch(() => {});
    })();
    </script>

    <div class="panel" id="stale-admin">
        <h3>Stale-account cleanup</h3>
        <p style="font-size:13px;color:#aaa;line-height:1.5">Accounts nobody has used (auto Camfrog accounts with no activity, junk web sign-ups, ownerless ghosts, Twitch/Discord-bot accounts without real activity and 100k+ PAT) are warned first, then archived: their PAT goes back to the Federal Reserve and signing in brings it back. Any activity in the warning window (sign-in, a site visit, Camfrog, Twitch, Discord, linking) clears the warning. Empty tier-A accounts are deleted after the purge date. Run by <code>migrate-stale-accounts.js</code> on the server (dry run by default).</p>
        <p id="stale-dates" style="font-size:14px;color:#eee">Loading…</p>
        <div style="overflow-x:auto"><table id="stale-counts" style="width:100%;font-size:12px;border-collapse:collapse"></table></div>
        <p id="stale-vias" style="font-size:12px;color:#aaa"></p>
    </div>
    <script>
    (function () {
        const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'})[c]);
        const n = (x) => Number(x || 0).toLocaleString('en-US');
        fetch('/api/admin/stale').then((r) => r.status === 403 ? null : r.json()).then((d) => {
            const dates = document.getElementById('stale-dates');
            if (!d) { dates.textContent = 'Admins only.'; return; }
            const m = d.meta;
            if (!m) { dates.textContent = 'No warning window started yet.'; return; }
            dates.innerHTML = 'Warning window <b>' + esc(m.run_id) + '</b> started ' + esc(new Date(m.started_at).toISOString().slice(0, 10))
                + ' · <b>archive on ' + esc(m.apply_on) + '</b> · <b>purge from ' + esc(m.purge_on) + '</b> (empty tier-A accounts) · tiers ' + esc((m.tiers || []).join('+'))
                + (d.archived ? ' · archived now: ' + n(d.archived.n) + ' (' + n(d.archived.pat) + ' PAT in the Reserve)' : '');
            const by = {};
            for (const r of d.rows || []) { const t = by[r.tier] || (by[r.tier] = {}); t[r.state] = r; }
            const states = ['pending', 'cleared', 'archived'];
            document.getElementById('stale-counts').innerHTML = '<tr><th align="left">Tier</th>' + states.map((s) => '<th align="right">' + s + '</th>').join('') + '</tr>'
                + Object.keys(by).sort().map((t) => '<tr style="border-top:1px solid #333"><td>' + esc(t) + '</td>'
                + states.map((s) => '<td align="right">' + (by[t][s] ? n(by[t][s].n) + ' <small>(' + n(by[t][s].pat) + ' PAT)</small>' : '-') + '</td>').join('') + '</tr>').join('');
            document.getElementById('stale-vias').textContent = (d.vias || []).length ? 'Cleared by: ' + d.vias.map((v) => (v.via || '?') + ' ' + v.n).join(' · ') : '';
        }).catch(() => {});
    })();
    </script>

    <div class="panel">
        <h3>Create Redemption Code</h3>
    <form id="redemption-codes" action="/api/admin/redemption-codes" method="post">
        <input type="text" id="code" name="code" placeholder="Enter code" required>
        <input type="number" id="points" name="points" placeholder="Point value" required>
        <input type="number" id="uses_allowed" name="uses_allowed" placeholder="Number of uses" required>
        <input type="date" id="expiration_date" name="expiration_date" placeholder="Expiration date">
        <button type="submit">Save Code</button>
    </form>
    <div id="codeStatus" class="spin-status"></div>
    </div>

    <div class="panel">
        <h3>Existing Redemption Codes</h3>
    <div id="redemptionCodesList"></div>
    </div>

    <script>
        document.getElementById('redemption-codes').addEventListener('submit', function(event) {
        event.preventDefault();
        var code = document.getElementById('code').value;
        var points = document.getElementById('points').value;
        var uses_allowed = document.getElementById('uses_allowed').value;
        var expiration_date = document.getElementById('expiration_date').value;

        fetch('/api/admin/redemption-codes', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({code: code, points: points, uses_allowed: uses_allowed, expiration_date: expiration_date})
        })
        .then(response => {
                if (!response.ok) { // Handle non-200 responses
                    throw new Error('Failed to add the redemption code.');
                }
                return response.json();
            })
            .then(data => {
                const message = data.message;
                if (message.includes("successfully")) { // Check that the spin actually happened / is not in progress. Don't update spinId if so.
                document.getElementById('codeStatus').style.visibility = 'hidden'; // Remove the animation element after it completes
                document.getElementById('codeStatus').textContent = 'Added redemption code successfully.'; // Display error message
                document.getElementById('codeStatus').style.visibility = 'visible'; // Make the status message visible
                }
            })
            .catch(error => {
                console.error('Error making the POST request:', error);
                document.getElementById('codeStatus').textContent = 'Failed to add the redemption code.........'; // Display error message
                document.getElementById('codeStatus').style.visibility = 'visible'; // Make the status message visible
                setTimeout(() => {
                    document.getElementById('codeStatus').style.visibility = 'hidden'; // Remove the animation element after it completes
            }, 2000); 
            });
    });
    </script>

