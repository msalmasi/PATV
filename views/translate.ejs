<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('translate.title') + ' · Public Access TV', user: user, ogPath: '/translate' }) %>
<%#
  views/translate.ejs - 1.99kf: "Suggest a better translation" (i18nfeedback.js). The strings of the page the user just
  left + a search; each row shows English, the current translation and a plain form (works without JS).
  Catalog values are trusted HTML-safe text (printed raw like every view does); js.* strings are plain text (escaped).
%>
<%
  const _lang = t.lang;
  const _dirAttr = t.dir === 'rtl' ? ' dir="rtl"' : '';
  const _show = (it, v) => v == null ? '' : (typeof v === 'object' ? Object.keys(v).map((c) => c + ': ' + (it.js ? t.esc(v[c]) : v[c])).join(' · ') : (it.js ? t.esc(v) : v));
  const _err = locals.error || null;
  const _row = (it) => {
    const mine = _err && _err.key === it.key ? _err : null;
    const prev = (c) => mine && mine.body ? (c ? mine.body['text_' + c] : mine.body.text) : (it.cur == null ? '' : (c ? (typeof it.cur === 'object' ? it.cur[c] || '' : '') : (typeof it.cur === 'string' ? it.cur : '')));
    let h = '<li class="ds-card tr-item" id="k-' + t.esc(it.key) + '"><div class="tr-key"><code>' + t.esc(it.key) + '</code>'
      + (it.improved ? ' <span class="ds-chip ok">' + t('translate.improved') + '</span>' : '') + '</div>'
      + '<div class="tr-pair"><div><b>' + t('translate.english') + '</b><span lang="en" dir="ltr">' + _show(it, it.en) + '</span></div>'
      + '<div><b>' + t('translate.current') + '</b><span lang="' + t.esc(_lang) + '"' + _dirAttr + '>' + (it.cur == null ? '<i>' + t('translate.fallback') + '</i>' : _show(it, it.cur)) + '</span></div></div>';
    if (locals.sent && locals.sent === it.key) h += '<p class="ds-note ok tr-ok" role="status">' + t('translate.sent') + '</p>';
    if (mine) {
      h += '<div class="ds-note danger tr-err" role="alert"><div>' + t.esc(mine.message || '') + (mine.problems && mine.problems.length ? '<ul>' + mine.problems.map((p) => '<li lang="en">' + t.esc(p) + '</li>').join('') + '</ul>' : '') + '</div></div>';
    }
    if (!signedIn) return h + '</li>';
    h += '<details' + (mine ? ' open' : '') + '><summary class="ds-btn ghost sm">' + t('translate.suggest_btn') + '</summary>'
      + '<form method="post" action="/translate/suggest" class="ds-form tr-form">'
      + '<input type="hidden" name="lang" value="' + t.esc(_lang) + '"><input type="hidden" name="key" value="' + t.esc(it.key) + '">'
      + '<input type="hidden" name="page" value="' + t.esc(locals.pagePath || '') + '"><input type="hidden" name="q" value="' + t.esc(locals.q || '') + '">';
    if (it.plural) {
      for (const c of it.cats.indexOf('other') >= 0 ? it.cats : it.cats.concat(['other'])) {
        h += '<label class="ds-field"><span class="ds-label">' + t('translate.plural_form', { cat: c }) + '</span><textarea class="ds-textarea" name="text_' + t.esc(c) + '" rows="2" lang="' + t.esc(_lang) + '"' + _dirAttr + ' maxlength="2000">' + t.esc(prev(c)) + '</textarea></label>';
      }
    } else {
      h += '<label class="ds-field"><span class="ds-label">' + t('translate.yours') + '</span><textarea class="ds-textarea" name="text" rows="3" lang="' + t.esc(_lang) + '"' + _dirAttr + ' maxlength="2000" required>' + t.esc(prev('')) + '</textarea></label>';
    }
    h += '<label class="ds-field"><span class="ds-label">' + t('translate.note') + '</span><input class="ds-in" type="text" name="note" maxlength="300" placeholder="' + t('translate.note_ph') + '" value="' + t.esc(mine && mine.body ? mine.body.note || '' : '') + '"></label>'
      + '<p class="ds-fine tr-hint">' + t('translate.hint') + '</p>'
      + '<div class="ds-actions"><button class="ds-btn sm" type="submit">' + t('translate.submit') + '</button></div></form></details></li>';
    return h;
  };
%>
<style>
  /* 1.99pm: on the design system - tool page recipe; each string is a .ds-card (key · English | current · suggest form) */
  .trp .tr-search { display: flex; gap: var(--ds-sp-2); flex-wrap: wrap; }
  .trp .tr-search .ds-in { flex: 1 1 240px; width: auto; }
  .tr-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--ds-sp-3); }
  .tr-key { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ds-sp-2); }
  .tr-key code { font-size: var(--ds-fs-xs); color: var(--ds-text-muted); }
  .tr-pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ds-sp-3); }
  .tr-pair b { display: block; margin-block-end: 2px; font: 700 11px/1.3 var(--ds-font); text-transform: uppercase; letter-spacing: var(--ds-ls-label); color: var(--ds-text-muted); }
  .tr-pair i { color: var(--ds-text-muted); }
  @media (max-width: 600px) { .tr-pair { grid-template-columns: 1fr; } }
  .tr-item details > summary { list-style: none; justify-self: start; display: inline-flex; }
  .tr-item details > summary::-webkit-details-marker { display: none; }
  .tr-item details[open] > summary { margin-block-end: var(--ds-sp-3); }
  .tr-err ul { margin: 4px 0 0; padding-inline-start: 18px; }
</style>
<main class="ds-page mid trp">
  <div class="ds-head">
    <h1 class="ds-h1"><span class="ds-ic" aria-hidden="true">🌐</span> <%- t('translate.heading') %></h1>
    <p class="ds-sub"><%- t('translate.intro') %></p>
  </div>
  <% if (isEn) { %>
    <p class="ds-note info"><span class="ds-ic" aria-hidden="true">ℹ️</span><span><%- t('translate.en_only') %> <a href="/language?next=%2Ftranslate"><%- t('translate.choose_language') %></a></span></p>
  <% } else { %>
    <% if (!signedIn) { %><p class="ds-sub"><%- t('translate.signin', { link: '<a href="/login?next=%2Ftranslate">' + t('translate.signin_link') + '</a>' }) %></p><% } %>
    <form class="tr-search" method="get" action="/translate" role="search">
      <label class="sr-only" for="trQ"><%- t('translate.search_label') %></label>
      <input class="ds-in" id="trQ" type="search" name="q" value="<%= q %>" minlength="2" maxlength="80" placeholder="<%- t('translate.search_ph') %>" aria-label="<%- t('translate.search_label') %>">
      <button class="ds-btn" type="submit"><%- t('translate.search_btn') %></button>
    </form>
    <% if (one.length) { %>
      <ul class="tr-list"><%- one.map(_row).join('') %></ul>
    <% } %>
    <% if (q) { %>
      <section class="ds-stack"><h2 class="ds-h2"><%- t('translate.results', { count: results.length }) %></h2>
      <% if (!results.length) { %><p class="ds-empty"><%- t('translate.no_results') %></p><% } else { %><ul class="tr-list"><%- results.map(_row).join('') %></ul><% } %></section>
    <% } else if (!one.length) { %>
      <% if (pageItems.length) { %>
        <section class="ds-stack"><h2 class="ds-h2"><%- t('translate.from_page', { page: pagePath }) %></h2>
        <ul class="tr-list"><%- pageItems.map(_row).join('') %></ul></section>
      <% } else { %>
        <p class="ds-empty"><%- t('translate.from_page_none') %></p>
      <% } %>
    <% } %>
  <% } %>
</main>
</body>
</html>
