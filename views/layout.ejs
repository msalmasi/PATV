<!-- views/layout.ejs -->
<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<!DOCTYPE html>
<html lang="<%= t.lang %>"<%- t.dir === 'rtl' ? ' dir="rtl"' : '' %>>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" type="image/png" sizes="192x192" href="/public/img/icon-192.png">
    <link rel="apple-touch-icon" href="/public/img/apple-touch-icon.png">
    <title><%= title %></title>
    <%
      // Link previews (og.js): a page can set `og`; everything else gets a generic card.
      const _og = (typeof og !== 'undefined' && og) ? og : (typeof ogBase !== 'undefined' ? {
        title: title, description: 'Public Access TV — live streams, Pepe the frog, PAT games, markets and more.',
        image: ogBase + '/og/page.png?t=' + encodeURIComponent(String(title).slice(0, 80)), url: ogBase + (typeof ogPath !== 'undefined' ? ogPath : '/') } : null);
    %>
    <% if (_og) { %>
    <meta property="og:site_name" content="Public Access TV">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= _og.title %>">
    <meta property="og:description" content="<%= _og.description %>">
    <meta name="description" content="<%= _og.description %>">
    <meta property="og:image" content="<%= _og.image %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content="<%= _og.url %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= _og.title %>">
    <meta name="twitter:description" content="<%= _og.description %>">
    <meta name="twitter:image" content="<%= _og.image %>">
    <meta name="theme-color" content="#18181b">
    <% } %>
    <%# 1.99pj design system: ds.css (tokens + ds-* components, docs/design-system.md, /styleguide) loads first, then the old
        global styles.css, then each page's own CSS. Ubuntu in its real 400/500/700 weights (the old css?family=Ubuntu link
        loaded 400 only, so every bold on the site was a synthesized faux-bold) + Press Start 2P, one request. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Ubuntu:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/public/css/ds.css?v=2">
    <link rel="stylesheet" href="/public/css/styles.css?v=6">
    <%# 1.99jo: page scripts translate with __t(key, englishDefault, vars), key = js.<area>.<name> - PATV_I18N holds the page language's
        "js.*" strings (nothing for English: the defaults are the English). Plain text: put it in textContent, or escape it. %>
    <% if (t.lang !== 'en') { %><script>window.PATV_I18N = <%- locals.i18nClient ? i18nClient(['js.'].concat(locals.i18nJs || [])) : '{"lang":"en","dir":"ltr","s":{}}' %>;</script><% } %>
    <%# 1.99jx: times in the viewer's own zone with its label (tz.js + public/js/localtime.js); PATV_TZ_SAVED = Edit profile -> Time zone %>
    <script>window.PATV_TZ_SAVED = <%- JSON.stringify(locals.tzSaved || null) %>;</script>
    <script src="/public/js/localtime.js?v=1"></script>
    <script>window.__t = function (k, d, v) { var I = window.PATV_I18N, s = I && I.s ? I.s[k] : null; if (s == null || s === '') s = d;
        if (s && typeof s === 'object') { var n = v && v.count != null ? +v.count : NaN, c = 'other'; try { if (!isNaN(n)) c = new Intl.PluralRules(I ? I.lang : 'en').select(n); } catch (e) {} s = s[c] != null ? s[c] : s.other; }
        return String(s == null ? k : s).replace(/\{!?(\w+)\}/g, function (m, n) { return v && v[n] != null ? String(v[n]) : m; }); };</script>
</head>
<body>
    <header>
        <nav class="navbar">
            <%
              const wheelHref = (typeof user == 'undefined' || !user) ? '/login' : '/u/' + user + '/wheel';
              // 1.99jo: labels come from locales/<lang>.json (HTML-safe text, so no escaping here)
              const _in = typeof user !== 'undefined' && !!user;
              const T = {   // the top-bar icons (desktop); the ☰ menu lists them in their sections below
                watch: ['/', '📺', t('nav.watch')],
                pads: ['/p', '📡', t('nav.pads')],
                wheel: [wheelHref, '<img src="/public/img/star.gif" height="16" alt="">', t('nav.wheel')],
                feed: ['/feed', '📝', t('nav.feed')],
                markets: ['/markets', '🔮', t('nav.markets')],
                wagers: ['/wagers', '🤝', t('nav.wagers')],
                gtf: ['/gtf', '🔫', t('nav.gtf')],
                rankings: ['/rankings', '🏆', t('nav.rankings')],
              };
              const main = [T.watch, T.pads, T.wheel, T.feed, T.markets, T.wagers, T.gtf, T.rankings];
              // 1.99kz: "Support PATV" (/support) while a donation rail (card or stablecoins) is on - app.locals.supportOn (cryptoweb.js)
              const _supportOn = typeof supportOn === 'function' ? !!supportOn() : false;
              const _rafflesOn = typeof rafflesOn === 'function' ? !!rafflesOn() : false;
              // casino front end per game (casino/routes.js app.locals.casinoOn): 1.99ol bj_front / hm_front on /admin/games, "auto" = the engine flag; cached
              const _casino = (g) => typeof casinoOn === 'function' ? !!casinoOn(g) : false;
              // 1.99qp: ⭐ PATV Creators links (creators.navFor via app.locals.creatorNav) - hidden while the feature is off
              const _cr = typeof creatorNav === 'function' ? creatorNav(_in ? user : null) : { on: false, creator: false };
              const _here = typeof ogPath !== 'undefined' && ogPath && ogPath !== '/language' ? ogPath : '';
              // 1.99ti: "My pads" - each pad this account owns. 1.99za: + the pads you follow (follows.navPads ->
              // res.locals.followedPadIds), live ones first, capped with "See all"; each opens the pad, yours keep a 👑
              // shortcut to the owner panel (padowner.navPads via app.locals; myPads is the older owned-only list)
              const _folIds = _in && typeof followedPadIds !== 'undefined' && Array.isArray(followedPadIds) ? followedPadIds : [];
              const _padNav = !_in ? { items: [], more: false } : typeof navPads === 'function' ? navPads(user, _folIds)
                : { items: (typeof myPads === 'function' ? myPads(user) : []).map((p) => ({ ...p, href: '/p/' + encodeURIComponent(p.slug), owned: true, owner: p.href })), more: false };
              const _padItem = (p) => [p.href, p.live ? '<span class="nav-livedot" role="img" aria-label="' + t('nav.pad_live') + '"></span>' : p.owned ? '👑' : '📡',
                t.esc(p.title), p.live ? 'nav-pad nav-padlive' : 'nav-pad',
                p.owner ? '<a href="' + p.owner + '" class="nav-sub" title="' + t('nav.owner_panel_of', { pad: p.title }) + '" aria-label="' + t('nav.owner_panel_of', { pad: p.title }) + '">⚙</a>' : ''];
              const _myPadItems = _padNav.items.map(_padItem).concat(_padNav.more || _folIds.length ? [['/p#following', '›', t('nav.mypads_all'), 'nav-seeall']] : []);
              // 2026-10-11: More and ☰ share one grouped list - [id, heading, items, class]; falsy items are gated off.
              // More skips the top-bar items (they're already on the bar); ☰ shows everything. Staff last, hidden until /api/u/.../profile says Admin.
              const sections = [
                ['watch', t('nav.sec_watch'), [T.watch, T.pads, T.feed,
                  ['/plex', '📼', t('nav.plex')],   // 1.99kp: the Plex hub (plexhub.js)
                  _cr.on && ['/creators', '⭐', t('nav.creators')],   // 1.99qp: PATV Creators
                ]],
                _padNav.items.length && ['mypads', t('nav.sec_mypads'), _myPadItems],   // 1.99za: right under Watch - pads are what people come for
                ['play', t('nav.sec_play'), [T.wheel, T.markets, T.wagers, T.gtf,
                  ['/gtf/leaderboards', '🏆', t('nav.gtf_boards')],   // 1.99wg: the GTF leaderboards (gtfboards.js)
                  ['/lotto', '🎟️', t('nav.lotto')],
                  ['/bingo', '🎱', t('nav.bingo')],   // 1.99abn: the live Bingo page (bingo.js)
                  // D10/1.99ol: the PATV casino (/casino/<game>) when that game's front end is it, else Pepe's tables (tables.js)
                  [_casino('bj') ? '/casino/blackjack' : '/blackjack', '🂡', t('nav.blackjack')],
                  [_casino('holdem') ? '/casino/holdem' : '/poker', '🃏', t('nav.poker')],
                  ['/bounties', '🎯', t('nav.bounties')],
                  ['/polls', '🗳️', t('nav.polls')],     // 2026-10-11: the user - polls are interactive, so Play (was Info & links)
                  _rafflesOn && ['/raffles', '🎫', t('nav.raffles')],   // 1.99xk: 🎫 PAT Raffles (raffles.js; the feature switch)
                ]],
                // 1.99za: You moved below Play (the user: Watch & hang out + your pads come first on a phone)
                ['you', t('nav.sec_you'), [
                  _in && ['/u/' + user, '👤', t('nav.your_profile')],
                  _in && ['/settings', '⚙️', t('nav.settings')],   // 1.99vz: the settings hub (settingshub.js)
                  ['/wallet', '👛', t('nav.wallet')],
                  ['/staking', '🏦', t('nav.staking')],
                  ['/history', '📜', t('nav.history')],
                  _in && ['/subscriptions', '🔁', t('subs.title')],   // 1.99jr: signed in only
                  _in && _cr.on && (_cr.creator ? ['/creator', '⭐', t('nav.creator_dash')] : ['/creators#apply', '🌟', t('nav.become_creator')]),
                  ['/achievements', '🏅', t('nav.achievements')],
                  _in && ['/settings/telegram', '✈️', t('nav.telegram')],
                ]],
                ['shop', t('nav.sec_shop'), [
                  ['/shop', '🏪', t('nav.shop')],
                  ['/premium', '💎', t('nav.premium')],
                  ['/cosmetics', '🎨', t('nav.cosmetics')],
                  // 1.99ta: the soundboard + voice store pages (soundboards.js / voicestore.js, 1.99rh) were linked from nowhere
                  ['/soundboards', '🔊', t('nav.soundboards')],
                  ['/voices', '🗣️', t('nav.voices')],
                  _supportOn && ['/support', '💖', t('nav.support')],
                ]],
                ['info', t('nav.sec_info'), [T.rankings,
                  ['/help', '<img src="/public/img/pepe.png" height="16" alt="">', t('nav.help')],
                  ['/economy', '📘', t('nav.economy')],
                  ['/about', '🐸', t('nav.about')],
                  ['/info', '📄', t('nav.info'), 'infoLink'],
                  ['https://discord.gg/publicaccess', '<img src="/public/img/discord.png" height="16" alt="">', 'Discord'],
                  ['https://twitch.tv/publicaccess_ttv', '<img src="/public/img/twitch.png" height="16" alt="">', 'Twitch'],
                  ['/language' + (_here ? '?next=' + encodeURIComponent(_here) : ''), '🌐', t('nav.language')],
                ]],
                ['staff', t('nav.sec_staff'), [['/admin', '🛠️', 'Admin', 'adminLink']], 'adminLink'],
              ];
              const item = (l, labelled) => '<a href="' + l[0] + '" class="nav-link' + (l[3] ? ' ' + l[3] : '') + '"'
                + (l[3] === 'adminLink' ? ' hidden' : '') + (l[0].startsWith('http') ? ' rel="noopener"' : '')
                + ' title="' + l[2] + '"><span class="ic">' + l[1] + '</span>'
                + (labelled ? '<span class="nav-lbl">' + l[2] + '</span>' : '') + '</a>';
              const groups = (pre, skipMain) => '<div class="nav-secs">' + sections.filter(Boolean).map((s) => {
                const its = s[2].filter((l) => l && !(skipMain && main.includes(l)));
                return its.length ? '<div class="nav-sec' + (s[3] ? ' ' + s[3] : '') + '" role="group" aria-labelledby="' + pre + s[0] + '"'
                  + (s[3] === 'adminLink' ? ' hidden' : '') + '><div class="nav-sec-h" id="' + pre + s[0] + '">' + s[1] + '</div>'
                  + '<div class="nav-sec-items">' + its.map((l) => (l[4] ? '<div class="nav-row">' + item(l, true) + l[4] + '</div>' : item(l, true))).join('') + '</div></div>' : '';
              }).join('') + '</div>';
            %>
            <div class="navbar-left">
                <a href="/" id="logo"><span class="logo-full">publicaccess.tv</span><span class="logo-short">PATV</span></a>
                <div class="nav-main"><%- main.map((l) => item(l, false)).join('') %></div>
                <details class="nav-more">
                    <summary><span class="nav-more-lbl"><%- t('nav.more') %></span> <span aria-hidden="true">▾</span></summary>
                    <div class="nav-pop">
                        <%# 1.99is: search (search.js) - in both menus, so every width has it %>
                        <form class="nav-psearch" action="/search" method="get" role="search"><input type="search" name="q" maxlength="100" placeholder="<%- t('nav.search_ph') %>" aria-label="<%- t('nav.search_aria') %>" autocomplete="off"><button type="submit" aria-label="<%- t('nav.search') %>">🔍</button></form>
                        <div class="nav-sep"></div>
                        <%- groups('nm-', true) %>
                    </div>
                </details>
            </div>
            <div class="navbar-right">
                <%# 1.99is: search - a box on wide screens, a 🔍 button on medium ones; narrower, it's in the ☰ / More menus %>
                <form class="nav-search" action="/search" method="get" role="search"><span class="nav-s-ic" aria-hidden="true">🔍</span><input type="search" name="q" maxlength="100" placeholder="<%- t('nav.search') %>" aria-label="<%- t('nav.search_aria') %>" autocomplete="off"></form>
                <a href="/search" class="nav-sbtn" title="<%- t('nav.search_aria') %>" aria-label="<%- t('nav.search') %>"><span aria-hidden="true">🔍</span></a>
                <%# 1.99ec: "✏️ Post" - the create-post page; on a pad's pages (/p/<pad>/...) it preselects that pad %>
                <% const _pm = typeof ogPath !== 'undefined' && ogPath ? /^\/p\/([A-Za-z0-9._~%-]+)/.exec(ogPath) : null; %>
                <a href="<%= _pm ? '/p/' + _pm[1] + '/submit' : '/submit' %>" class="nav-post" title="<%- _pm ? t('nav.create_post_in', { pad: _pm[1].replace(/%[0-9A-Fa-f]{2}/g, '').toLowerCase() }) : t('nav.create_post') %>"><span class="cta-ic" aria-hidden="true">✏️</span><span class="nav-lbl"><%- t('nav.post') %></span></a>
                <a href="/stage" class="nav-golive" title="<%- t('nav.golive_title') %>"><span class="cta-ic" aria-hidden="true">🎥</span><span class="nav-lbl"><%- t('nav.golive') %></span></a>
                <% if (typeof user == 'undefined' || !user) { %>
                    <a href="/login<%= (typeof ogPath !== 'undefined' && ogPath && ogPath !== '/' && !/^\/(login|register|forgot-password|reset-password)/.test(ogPath)) ? '?next=' + encodeURIComponent(ogPath) : '' %>" class="nav-signin"><%- t('nav.signin') %></a>
                <% } else { const _ib = (typeof inboxUnread !== 'undefined' && inboxUnread > 0) ? inboxUnread : 0; const _dm = (typeof dmUnread !== 'undefined' && dmUnread > 0) ? dmUnread : 0; %>
                    <a href="/messages" id="navDm" class="nav-bell<%= _dm ? ' has' : '' %>" title="<%- _dm ? t('nav.messages_unread', { n: _dm }) : t('nav.messages') %>" aria-label="<%- _dm ? t('nav.messages_unread_aria', { n: _dm }) : t('nav.messages') %>"><span aria-hidden="true">💬</span><% if (_dm) { %><span class="nav-badge"><%= _dm > 99 ? '99+' : _dm %></span><% } %></a>
                    <%# 1.99cu: both open the one inbox at /messages - 💬 the conversations, 🔔 its pinned Notices item %>
                    <a href="/messages/notices" id="navBell" class="nav-bell<%= _ib ? ' has' : '' %>" title="<%- _ib ? t('nav.notices_unread', { n: _ib }) : t('nav.notices') %>" aria-label="<%- _ib ? t('nav.notices_unread_aria', { n: _ib }) : t('nav.notices') %>"><span aria-hidden="true">🔔</span><% if (_ib) { %><span class="nav-badge"><%= _ib > 99 ? '99+' : _ib %></span><% } %></a>
                    <div class="avatar">
                        <a href="/u/<%= user %>" title="<%- t('nav.your_profile') %>"><img id="userAvatar" src="/public/img/coin.png" alt="<%- t('nav.your_profile') %>"></a>
                    </div>
                <% } %>
                <details class="nav-burger">
                    <summary aria-label="<%- t('nav.menu') %>">☰</summary>
                    <div class="nav-pop">
                        <form class="nav-psearch" action="/search" method="get" role="search"><input type="search" name="q" maxlength="100" placeholder="<%- t('nav.search_ph') %>" aria-label="<%- t('nav.search_aria') %>" autocomplete="off"><button type="submit" aria-label="<%- t('nav.search') %>">🔍</button></form>
                        <div class="nav-sep"></div>
                        <%- groups('nb-', false) %>
                    </div>
                </details>
            </div>
        </nav>
        <style>
            /* Nav (2026-10): main icons + "More" on desktop, one ☰ menu on phones.
               1.99pj design system: colours, radii, shadows and type from ds.css tokens; logical properties (RTL);
               every control is a >= 40px box with its glyph centred (.ic / .cta-ic are fixed squares); gold focus rings. */
            header { background-color: var(--ds-surface-2); box-shadow: var(--ds-e-1); border-block-end: 1px solid #202024; }
            .navbar { gap: 12px; padding: 12px 20px; min-height: 64px; box-sizing: border-box; position: relative; z-index: 50; font-family: var(--ds-font); }
            .navbar-left { display: flex; align-items: center; gap: 4px; min-width: 0; }
            .navbar-right { display: flex; align-items: center; gap: 8px; margin-right: 0; margin-inline-end: 0; }
            .navbar a { margin-right: 0; }
            #logo { margin-inline-end: 14px; white-space: nowrap; color: var(--ds-brand); font: 700 20px/1 var(--ds-font); letter-spacing: -.01em; }
            .nav-main { display: flex; align-items: center; gap: 2px; }
            .nav-link { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; box-sizing: border-box; padding: 0 9px; border-radius: var(--ds-r-sm);
                        color: #9b9ba3; font-size: 15px; line-height: 1.25; transition: background-color var(--ds-dur-1), color var(--ds-dur-1); }
            .nav-link:hover, .nav-link:focus-visible { background: var(--ds-hover); color: #fff; }
            .nav-link.current { color: #fff; background: #1f2b22; box-shadow: inset 0 -2px 0 var(--ds-brand); }
            .nav-link .ic { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 20px; height: 20px; font-size: 17px; line-height: 1; text-align: center; }
            .nav-link .ic img { display: block; width: 16px; height: 16px; object-fit: contain; }
            .nav-link[hidden] { display: none; }
            .navbar :is(a, summary, button, input):focus-visible { outline: 2px solid var(--ds-focus); outline-offset: 2px; }
            .logo-short { display: none; }
            .nav-more, .nav-burger { position: relative; }
            .nav-more > summary, .nav-burger > summary { list-style: none; cursor: pointer; color: #aaa; display: inline-flex; align-items: center; gap: 6px; min-height: 40px;
                                                        box-sizing: border-box; padding: 0 10px; border-radius: var(--ds-r-sm); user-select: none; font-size: 15px; }
            .nav-more > summary::-webkit-details-marker, .nav-burger > summary::-webkit-details-marker { display: none; }
            .nav-more > summary:hover, .nav-burger > summary:hover, .nav-more[open] > summary, .nav-burger[open] > summary { background: var(--ds-hover); color: #fff; }   /* scoped: an unscoped details[open] > summary greyed every open <details> on the site */
            .nav-more > summary [aria-hidden] { font-size: 11px; transition: transform var(--ds-dur-2); }
            .nav-more[open] > summary [aria-hidden] { transform: rotate(180deg); }
            .nav-pop { position: absolute; top: calc(100% + 8px); min-width: 220px; background: var(--ds-surface-3); border: 1px solid var(--ds-line-menu);
                       border-radius: var(--ds-r-lg); padding: 6px; display: grid; gap: 2px; box-shadow: var(--ds-e-3); }
            .nav-more .nav-pop { inset-inline-start: 0; }
            .nav-burger .nav-pop { inset-inline-end: 0; }
            .nav-pop .nav-link { padding: 0 10px; color: #c4c4cc; font-size: 14px; }
            .nav-sep { height: 1px; background: var(--ds-line-menu); margin: 4px 2px; }
            /* 2026-10-11: grouped menus - small-caps muted headings; More is two columns of sections when there's room */
            .nav-sec { break-inside: avoid; padding: 0 0 6px; }
            .nav-sec[hidden] { display: none; }
            .nav-sec-h { padding: 10px 10px 4px; color: #9a9aa6; font: 700 11px/1.2 var(--ds-font); letter-spacing: .08em; text-transform: uppercase; }
            .nav-sec-items { display: grid; gap: 2px; }
            /* 1.99za: My pads - a pad row with the owner-panel ⚙ beside it, the live dot, the See all row */
            .nav-row { display: flex; align-items: center; gap: 2px; min-width: 0; }
            .nav-row > .nav-link { flex: 1 1 auto; min-width: 0; }
            .nav-pop .nav-sub { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 40px; height: 40px; border-radius: var(--ds-r-sm); color: #9b9ba3; font-size: 15px; }
            .nav-pop .nav-sub:hover, .nav-pop .nav-sub:focus-visible { background: var(--ds-hover); color: #fff; }
            .nav-livedot { display: block; width: 10px; height: 10px; border-radius: 50%; background: var(--ds-live); box-shadow: 0 0 0 3px rgba(255,82,82,.18); }
            .nav-pop .nav-link.nav-padlive { color: #fff; }
            .nav-pop .nav-link.nav-seeall { color: var(--ds-green-2); font-size: 13px; }
            .nav-pop .nav-pad .nav-lbl { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
            .nav-pop { grid-template-columns: minmax(0, 1fr); }   /* the search box's intrinsic width mustn't widen the menu past its scrollbar */
            .nav-more .nav-pop { width: 280px; max-width: calc(100vw - 24px); max-height: calc(100vh - 90px); overflow-y: auto; overscroll-behavior: contain; }
            @media (min-width: 1100px) { .nav-more .nav-pop { width: 520px; } .nav-more .nav-secs { columns: 2; column-gap: 8px; } }
            .nav-burger { display: none; }
            .nav-burger > summary { font-size: 22px; line-height: 1; padding: 6px 10px; justify-content: center; min-width: 40px; }
            /* 1.99ek: Post and Go live share one pill base - same height, padding, font, radius, icon box and
               min-width; only the colours differ (Post: green outline, Go live: red gradient). `.navbar a.nav-*` outranks
               styles.css's `.navbar a { font-size: 16px; margin-right: 20px }` */
            .navbar a.nav-post, .navbar a.nav-golive { display: inline-flex; align-items: center; justify-content: center; gap: 6px; box-sizing: border-box;
                                height: 34px; min-width: 104px; padding: 0 14px; margin-right: 0; border-radius: 999px; border: 1px solid transparent;
                                font: bold 14px/1 Ubuntu, sans-serif; white-space: nowrap; transition: filter var(--ds-dur-1), border-color var(--ds-dur-1); }
            .nav-post .cta-ic, .nav-golive .cta-ic { display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; font-size: 15px; line-height: 1; flex: none; }
            .navbar a.nav-golive { background: linear-gradient(90deg, var(--ds-live), var(--ds-live-2)); color: #fff !important; }
            .navbar a.nav-golive:hover, .navbar a.nav-golive:focus-visible { filter: brightness(1.1); color: #fff !important; }
            /* 1.99ec: the secondary sibling of Go live */
            .navbar a.nav-post { border-color: #3c7a46; background: #12301a; color: #c8efcf !important; }
            .navbar a.nav-post:hover, .navbar a.nav-post:focus-visible { border-color: var(--ds-green); color: #fff !important; }
            /* 1.99ej: icon-only up to 500px (was 420 - signed in, 421-485px still overflowed with the labels); 1.99ek: equal squares */
            /* 1.99jo: translated labels can be longer than English - they ellipsize instead of widening the bar */
            .nav-post .nav-lbl, .nav-golive .nav-lbl, .nav-signin, .nav-more-lbl { display: inline-block; max-width: 7.5em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; }
            .nav-pop .nav-lbl { overflow-wrap: anywhere; }
            @media (max-width: 500px) { .nav-golive .nav-lbl, .nav-post .nav-lbl { display: none; } .navbar a.nav-post, .navbar a.nav-golive { width: 34px; min-width: 0; padding: 0; } }
            .navbar a.nav-signin { display: inline-flex; align-items: center; height: 34px; box-sizing: border-box; color: #fff; padding: 0 14px; border: 1px solid #3a3a42;
                                   border-radius: 999px; white-space: nowrap; font: 700 14px/1 var(--ds-font); }
            .navbar a.nav-signin:hover, .navbar a.nav-signin:focus-visible { border-color: var(--ds-green); background: var(--ds-hover); }
            .navbar .avatar { display: flex; }
            .navbar .avatar a { display: flex; border-radius: 50%; }
            .navbar .avatar img { margin-left: 0; display: block; object-fit: cover; box-shadow: 0 0 0 1px #2c2c33; }
            .nav-bell { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px;
                        border-radius: var(--ds-r-sm); font-size: 19px; line-height: 1; color: #aaa; filter: grayscale(.6); }
            .nav-bell:hover, .nav-bell:focus-visible { background: var(--ds-hover); filter: none; }
            .nav-bell.has { filter: none; }
            .nav-bell .nav-badge { position: absolute; top: 2px; inset-inline-end: 0; min-width: 18px; height: 18px; box-sizing: border-box; padding: 0 5px; border-radius: 9px;
                                   background: var(--ds-badge); color: #fff; font: bold 11px/18px Ubuntu, sans-serif; text-align: center; font-variant-numeric: tabular-nums; box-shadow: 0 0 0 2px var(--ds-surface-2); }
            @media (max-width: 760px) {
                .nav-main, .nav-more { display: none; }
                .nav-burger { display: block; }
                .navbar { padding: 10px 12px; min-height: 58px; }
                #logo { display: inline !important; font-size: 18px; }
                .logo-full { display: none; }
                .logo-short { display: inline; }
                .nav-burger .nav-pop { position: fixed; top: 58px; left: 10px; right: 10px; min-width: 0; max-height: calc(100vh - 80px); max-height: calc(100dvh - 80px); overflow-y: auto;
                                      overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
                /* two links a row per section on phones - half the scrolling; long labels wrap inside their cell */
                .nav-burger .nav-sec-items { grid-template-columns: repeat(2, minmax(0, 1fr)); }
                .nav-burger .nav-pop .nav-link { padding: 8px; min-height: 44px; align-items: center; line-height: 1.25; }
            }
            /* 1.99ej: 851-~915px (styles.css shows the logo again above 850) the full "publicaccess.tv" logo pushed a
               signed-in navbar past the viewport - the short PATV logo until there's room */
            @media (min-width: 761px) and (max-width: 960px) { .logo-full { display: none; } .logo-short { display: inline; } }
            /* 1.99ej: signed in, the right side (Post, Go live, 💬, 🔔, avatar, ☰) was ~29px wider than a 360-375px phone -
               tighter gaps, padding and icon boxes so it fits at 360px+ with no page scroll; the bell and avatar stay */
            @media (max-width: 420px) {
                .navbar { padding: 10px 8px; gap: 6px; }
                .navbar-right { gap: 3px; }
                #logo { margin-right: 4px; margin-inline-end: 4px; }
                .navbar a.nav-post, .navbar a.nav-golive { width: 32px; height: 32px; }
                .nav-bell { width: 34px; }
                .nav-burger > summary { padding: 6px 7px; min-width: 36px; }
                .navbar .avatar img { width: 36px; height: 36px; }
                .navbar a.nav-signin { padding: 0 10px; }
            }
        </style>
        <style>
            /* 1.99is: search in the navbar (search.js). Hidden by default; the box from 1280px, the 🔍 button 1000-1279px;
               narrower it lives at the top of the ☰ menu (and of More) so the bar's fit rules above are untouched */
            .nav-search { display: none; position: relative; align-items: center; margin: 0; }
            .nav-search input { width: 150px; height: 34px; box-sizing: border-box; padding: 0; padding-inline: 32px 12px; border-radius: 999px; border: 1px solid #3a3a42;
                                background: #141417; color: #eee; font: 14px var(--ds-font); transition: width .15s ease, border-color var(--ds-dur-1); }
            .nav-search input::placeholder { color: #8e8e96; }
            .nav-search input:hover { border-color: #4a4a54; }
            .nav-search input:focus { outline: none; border-color: var(--ds-green); width: 210px; box-shadow: 0 0 0 3px var(--ds-green-bg); }
            .nav-s-ic { position: absolute; inset-inline-start: 11px; top: 50%; transform: translateY(-50%); display: inline-flex; font-size: 13px; line-height: 1; pointer-events: none; filter: grayscale(.7); }
            .navbar a.nav-sbtn { display: none; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--ds-r-sm); font-size: 18px; line-height: 1; filter: grayscale(.6); }
            .navbar a.nav-sbtn:hover, .navbar a.nav-sbtn:focus-visible { background: var(--ds-hover); filter: none; }
            @media (min-width: 1000px) and (max-width: 1279px) { .navbar a.nav-sbtn { display: inline-flex; } }
            @media (min-width: 1280px) { .nav-search { display: inline-flex; } }
            @media (prefers-reduced-motion: reduce) { .nav-search input { transition: none; } .nav-more > summary [aria-hidden] { transition: none; } }
            .nav-psearch { display: flex; gap: 6px; padding: 4px 4px 2px; }
            .nav-psearch input { flex: 1 1 auto; min-width: 0; height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: var(--ds-r-md); border: 1px solid #3a3a42;
                                 background: #121215; color: #eee; font: 16px var(--ds-font); }
            .nav-psearch input:focus { outline: none; border-color: var(--ds-green); box-shadow: 0 0 0 3px var(--ds-green-bg); }
            .nav-psearch button { flex: none; width: 40px; height: 40px; border-radius: var(--ds-r-md); border: 1px solid #3a3a42; background: var(--ds-hover); cursor: pointer; font-size: 15px;
                                  padding: 0 !important; margin: 0; display: grid; place-items: center; line-height: 1; text-align: center; }   /* the menu's generic button padding pushed the 🔍 off-centre */
            .nav-psearch button:hover { border-color: var(--ds-green); }
        </style>
        <style>
            /* 1.99cc: the site footer (Terms / Privacy on every page). Built here, moved to the end of <body> below.
               1.99pj: tokens; #777 text failed contrast (4.3:1) -> --ds-text-faint; links get a 32px-tall hit area */
            .site-foot { margin: 48px 0 0; padding: 20px var(--ds-gutter) calc(28px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--ds-line);
                         background: #0c0c0e; color: var(--ds-text-faint); font: 13px/1.6 var(--ds-font); text-align: center; }
            .site-foot nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 6px; max-width: 760px; margin: 0 auto 2px; }
            .site-foot nav a { display: inline-flex; align-items: center; min-height: 32px; padding: 0 8px; border-radius: var(--ds-r-xs); }
            .site-foot a { color: #a3a3a3; text-decoration: none; }
            .site-foot a:hover, .site-foot a:focus-visible { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
            .site-foot a:focus-visible, .site-lang select:focus-visible { outline: 2px solid var(--ds-focus); outline-offset: 2px; }
            .site-foot > div { margin-top: 6px; }
            .site-lang { margin-top: 10px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px 14px; }
            .site-lang label { display: inline-flex; align-items: center; gap: 6px; }
            .site-lang select { height: 36px; box-sizing: border-box; background: #18181c; color: #ddd; border: 1px solid #3a3a42; border-radius: var(--ds-r-sm); padding: 0 8px; font: 13px var(--ds-font); max-width: 220px; cursor: pointer; }
            .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        </style>
        <template id="siteFootTpl">
            <footer class="site-foot" role="contentinfo">
                <nav aria-label="<%- t('foot.policies_aria') %>">
                    <a href="/terms"><%- t('foot.terms') %></a>
                    <a href="/privacy"><%- t('foot.privacy') %></a>
                    <a href="/guidelines"><%- t('foot.guidelines') %></a>
                    <a href="/terms#reporting"><%- t('foot.report') %></a>
                    <%# 1.99ta: the TAKE IT DOWN form (takedown.js) - no account needed, so it sits with the policies %>
                    <a href="/takedown"><%- t('foot.takedown') %></a>
                    <a href="/about"><%- t('nav.about') %></a>
                    <a href="/economy"><%- t('nav.economy') %></a>
                </nav>
                <%# 1.99dw: the homepage's old link row lives here now, on every page %>
                <nav aria-label="<%- t('foot.more_aria') %>">
                    <a href="/help"><%- t('foot.help') %></a>
                    <a href="https://discord.gg/publicaccess" rel="noopener">Discord</a>
                    <a href="/achievements"><%- t('nav.achievements') %></a>
                    <a href="/shop"><%- t('nav.shop') %></a>
                    <a href="/plex"><%- t('nav.plex') %></a>
                    <% if (_supportOn) { %><a href="/support"><%- t('foot.support') %></a><% } %>
                </nav>
                <div><%- t('foot.tagline') %></div>
                <%# 1.99jo: the language switcher (i18n.js); the select needs JS, the link always works %>
                <div class="site-lang"><label><span aria-hidden="true">🌐</span> <span class="sr-only"><%- t('foot.language') %></span>
                    <select aria-label="<%- t('foot.language') %>" onchange="location.href='/lang/' + this.value + '?next=' + encodeURIComponent(location.pathname + location.search)">
                        <% for (const L of (locals.i18nLangs || [{ code: 'en', name: 'English' }])) { %><option value="<%= L.code %>"<%= L.code === t.lang ? ' selected' : '' %>><%= L.name %></option><% } %>
                    </select></label>
                    <a href="/language<%= _here ? '?next=' + encodeURIComponent(_here) : '' %>"><%- t('foot.all_languages') %></a>
                    <%# 1.99kf: "Suggest a better translation" (i18nfeedback.js) - only when the page isn't in English %>
                    <% if (t.lang !== 'en') { %><a href="/translate" class="site-lang-suggest"><%- t('foot.suggest_translation') %></a><% } %></div>
            </footer>
        </template>
        <script>
            // Put the footer after the page's own content (pages include this layout first).
            document.addEventListener('DOMContentLoaded', function () {
                var t = document.getElementById('siteFootTpl');
                if (t && t.content && !document.querySelector('.site-foot')) document.body.appendChild(t.content.cloneNode(true));
            });
        </script>
        <script>
            // Highlight the page you're on; close an open menu when clicking elsewhere.
            (function () {
                var p = location.pathname;
                document.querySelectorAll('.navbar .nav-link').forEach(function (a) {
                    var h = a.getAttribute('href');
                    if (h && h.charAt(0) === '/' && (h === '/' ? p === '/' : p === h || p.indexOf(h + '/') === 0 || (h.indexOf('/wheel') > 0 && p.indexOf('/wheel') > 0))) a.classList.add('current');
                });
                document.addEventListener('click', function (e) {
                    document.querySelectorAll('.navbar details[open]').forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute('open'); });
                });
                // 1.99pj: Escape closes an open menu and puts focus back on its button
                document.addEventListener('keydown', function (e) {
                    if (e.key !== 'Escape') return;
                    document.querySelectorAll('.navbar details[open]').forEach(function (d) { d.removeAttribute('open'); var s = d.querySelector('summary'); if (s && d.contains(document.activeElement)) s.focus(); });
                });
            })();
        </script>
        <% if (typeof staleNotice !== 'undefined' && staleNotice) { %>
        <div class="stale-banner" role="status">
            <strong><%- t('stale.title') %></strong>
            <%- t('stale.due', { date: staleNotice.apply_on }) %>
            <% if (staleNotice.balance > 0) { %><%- t('stale.balance', { amount: t.num(Number(staleNotice.balance)) }) %><% } %>.
            <%- t('stale.active') %>
            <a href="/messages/notices"><%- t('nav.notices') %></a>
            <button type="button" aria-label="<%- t('common.dismiss') %>" onclick="this.parentNode.remove()">×</button>
        </div>
        <style>
            .stale-banner { margin: 10px 20px; padding: 10px 14px; padding-inline-end: 44px; border-radius: var(--ds-r-lg); background: var(--ds-green-bg); border: 1px solid var(--ds-green-line);
                            color: var(--ds-ok-ink); font: 14px/1.5 var(--ds-font); position: relative; }
            .stale-banner strong { color: #fff; }
            .stale-banner a { color: var(--ds-green-2); margin-inline-start: 6px; }
            .stale-banner button { position: absolute; top: 4px; inset-inline-end: 4px; width: 36px; height: 36px; padding: 0; display: grid; place-items: center; border-radius: var(--ds-r-sm);
                                   background: none; border: 0; color: #aaa; font-size: 20px; line-height: 1; cursor: pointer; }
            .stale-banner button:hover { background: var(--ds-hover); color: #fff; }
            @media (max-width: 600px) { .stale-banner { margin: 8px 16px; } }
        </style>
        <% } %>
    </header>

</body>
<% if (typeof user == 'undefined' || !user) { %>

<% } else { %>
    <script>
        document.addEventListener('DOMContentLoaded', function() {

        fetch('/api/u/<%= user %>/profile')
            .then(response => response.json())
            .then(data => {
                if (data.avatar) {
                    document.getElementById('userAvatar').src = data.avatar;
                }
                if (data.class === "Admin") {
                    document.querySelectorAll('.adminLink').forEach(function (el) { el.hidden = false; });
                    document.querySelectorAll('.infoLink').forEach(function (el) { el.hidden = true; });
                }
            })
            .catch(error => console.error('Failed to fetch user data:', error));
        });
    </script>
    <% } %>
</html>
