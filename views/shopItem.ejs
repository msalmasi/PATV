<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: p ? p.prize : t('shop.item.title'), user: user }) %>
<%- include('partials/shop-css') %>
<div class="sh">
<% if (!p) { %>
  <h1><%- t('shop.item.not_found') %></h1>
  <p class="sub"><%- t('shop.item.not_found_sub') %> <a href="/shop"><%- t('shop.back') %></a></p>
<% } else { const official = !p.seller_id; const mine = me && me.userId === p.seller_id; %>
  <div class="bar" style="margin-top:12px">
    <div class="links"><a href="/shop"><%- t('shop.item.back') %></a><% if (!official) { %><a href="/shop/seller/<%= encodeURIComponent(p.seller_name || '') %>"><%- t('shop.item.more_from', { name: p.seller_name }) %></a><% } %></div>
    <% if (me) { %><div><%- t('shop.balance', { bal: '<span class="bal" id="shopBalance">' + t.esc(H.fmt(me.points_balance)) + '</span>' }) %></div><% } %>
  </div>
  <% if (msg) { %><p class="notice"><%= msg %></p><% } %>
  <% if (p.status !== 'active') { const ls = H.lstatus(p.status); %>
    <p class="warn"><%- t('shop.item.hidden', { status: '<b style="color:' + t.esc(ls.color) + '">' + t.esc(ls.label) + '</b>' }) %><% if (p.review_note) { %> <%- t('shop.item.note', { note: p.review_note }) %><% } %></p>
  <% } %>

  <div style="display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));align-items:start">
    <div class="box" style="padding:0;overflow:hidden">
      <div class="thumb" style="aspect-ratio:4/3;font-size:64px"><% if (p.image_url) { %><img src="<%= p.image_url %>" alt="" referrerpolicy="no-referrer" onerror="this.remove()"><% } else { %><%= official ? '🎁' : '🛍️' %><% } %></div>
    </div>
    <div style="display:grid;gap:10px;min-width:0">
      <div>
        <h1 style="text-align:left;margin:0 0 6px;font-size:24px"><%= p.prize %></h1>
        <div class="row">
          <span class="price" style="font-size:24px"><%= H.fmt(p.cost) %> PAT</span>
          <% if (official) { %><span class="pill official"><%- t('shop.item.official_store') %></span><% } %>
          <% if (p.category) { %><a class="chip" href="/shop?cat=<%= encodeURIComponent(p.category) %>"><%= p.category %></a><% } %>
        </div>
      </div>
      <% if (p.escalating) { %>
        <p class="muted" style="margin:0"><%- me ? t('shop.item.your_price') : '' %> <%- t('shop.item.escalating', { price: H.fmt(p.list_cost) }) %></p>
      <% } %>
      <div class="muted"><span class="<%= p.quantity > 0 ? '' : 'oos' %>" data-stock="<%= p.prizeId %>"><%- p.quantity > 0 ? t('shop.n_left', { n: H.fmt(p.quantity) }) : t('shop.out_of_stock') %></span><%- p.sold ? ' · ' + t('shop.n_sold', { n: H.fmt(p.sold) }) : '' %>
        · <%- official ? t('shop.item.instant') : t('shop.item.seller_delivers') %></div>

      <div id="shopStatus" class="status-msg" role="status" aria-live="polite"></div>
      <% if (!me) { %>
        <a class="btn" href="/login"><%- t('shop.item.signin_buy') %></a>
      <% } else if (mine) { %>
        <div class="row"><a class="btn alt" href="/shop/seller?edit=<%= p.prizeId %>#edit"><%- t('shop.item.edit') %></a></div>
      <% } else if (p.status === 'active' && p.quantity > 0) { %>
        <% if (p.buyer_prompt) { %>
          <label><%- t('shop.item.seller_needs', { what: '<b style="color:#ddd">' + t.esc(p.buyer_prompt) + '</b>' }) %>
            <input type="text" id="buyerInput" maxlength="300" required data-prompt="<%= p.buyer_prompt %>" placeholder="<%= p.buyer_prompt %>">
          </label>
        <% } %>
        <div><button class="buy-btn" data-product="<%= p.prizeId %>" data-name="<%= p.prize %>" data-cost="<%= p.cost %>"><%- t('shop.item.buy_for', { price: H.fmt(p.cost) }) %></button></div>
        <% if (typeof sub !== 'undefined' && sub) { %>
        <div><button class="buy-btn alt" data-subscribe="1" data-days="<%= sub.days %>" data-product="<%= p.prizeId %>" data-name="<%= p.prize %>" data-cost="<%= p.cost %>"><%- t('shop.item.subscribe_btn', { price: H.fmt(p.cost), days: sub.days }) %></button></div>
        <p class="muted" style="margin:0"><%- t('shop.item.subscribe_note', { days: sub.days, link: '<a href="/subscriptions">' + t('shop.item.subscribe_link') + '</a>' }) %></p>
        <% } %>
        <% if (!official) { %><p class="muted" style="margin:0"><%- t('shop.item.cancel_note', { days: settings.auto_complete_days }) %></p><% } %>
      <% } %>

      <div class="box seller">
        <% if (official) { %>
          <img src="/public/img/coin.png" alt="">
          <div><b style="color:#fff"><%- t('shop.item.patv_store') %></b><div class="muted"><%- t('shop.item.patv_store_sub') %></div></div>
        <% } else { %>
          <img src="<%= H.av(p.seller_avatar) %>" alt="" onerror="this.src='/public/img/avatar.png'">
          <div style="min-width:0">
            <a href="/shop/seller/<%= encodeURIComponent(p.seller_name || '') %>" style="color:#fff;font-weight:bold"><%= p.seller_display || p.seller_name %></a>
            <div class="muted">@<%= p.seller_name %> · <%- t('shop.item.completed_sales', { count: sales, n: H.fmt(sales) }) %></div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <% if (p.description) { %>
    <h2><%- t('shop.item.description') %></h2>
    <div class="pre"><%= p.description %></div>
  <% } %>

  <% if (more && more.length) { %>
    <h2><%- official ? t('shop.item.more_store') : t('shop.item.more_from', { name: p.seller_name }) %></h2>
    <div class="grid">
      <% more.forEach((m) => { %>
        <a class="card" href="/shop/item/<%= m.prizeId %>">
          <div class="thumb"><% if (m.image_url) { %><img src="<%= m.image_url %>" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()"><% } else { %><%= official ? '🎁' : '🛍️' %><% } %></div>
          <div class="body"><span class="t"><%= m.prize %></span><span class="price"><%= H.fmt(m.cost) %> PAT</span></div>
        </a>
      <% }) %>
    </div>
  <% } %>
<% } %>
</div>
<%- include('partials/shop-buy-js') %>
