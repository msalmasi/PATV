<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: tableId ? t('casino.hm_title') : t('casino.lobby_title'), user: user}) %>
<%# views/casino-hm.ejs - /casino/holdem (the lobby) and /casino/holdem/t/<id> (a table). D10 design pass (2026-10-11): an oval felt
    with nine seats (you at the bottom), the dealer button and blinds, the board, the pot with side pots and uncalled bets
    spelled out, your hole cards only to you (face down for everyone else), an action bar with a bet slider and presets and
    a countdown ring on the server's deadline, the buy-in / top-up sheet, the showdown reveal, history with the rake,
    spectators, and the host's push-to-room / Pepe's-stream tools. Drawn by public/js/casino-ui.js + casinohm.js.
    h22 (1.99alz): 🏁 Sit & Go - the lobby's section + its Create sheet (casino-ui.js), a sit & go table's header + results card
    (casinohm.js); each in one marked block below. h22 phase 2 (1.99??): 🏆 the scheduled tournaments' block (casinomtt.js), marked below. %>
<%- include('partials/casino-css') %>
<%# 1.99ajw casino2: the Room Dock's person menu on the seats (room-mod.js + the 💸 Tip modal pad-tip.js; pad-dock.css body.cz-pm = its look) %>
<link rel="stylesheet" href="/public/css/room-mod.css?v=10">
<link rel="stylesheet" href="/public/css/pad-dock.css?v=11"><%# 1.99ajy dockmedia: v9 (the Room Dock's Now playing / stage media bar rules; the same file as the pad); pausebars: v11 (the pad's current file - dock3 v10 + no mic bars while paused) %>
<link rel="stylesheet" href="/public/css/person-sheet.css?v=3"><%# 1.99ajw casino2 rework: the 🚫 Block sheet (block-sheet.js) %>
<link rel="stylesheet" href="/public/css/flair.css?v=5"><%# (the person menu header's pad flair chip) %>
<%# 1.99amf h20: a themed table's look (casino/themes.js; routes.js page passes `theme` - classic pages load none of it) %>
<% if (locals.theme && theme !== 'classic') { %><link rel="stylesheet" href="/public/css/casino-themes.css?v=3"><% } %>
<style>
  .hm-wrap { position: relative; padding: 64px 64px 104px; }
  .felt.hm { position: relative; aspect-ratio: 2.15 / 1; border-radius: 999px; padding: 0; }
  .felt.hm::after { border-radius: 999px; }
  .hm-center { position: absolute; left: 50%; top: 48%; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; gap: 8px;
               width: 62%; text-align: center; }
  .board { display: flex; gap: 6px; justify-content: center; --cw: 50px; }
  .board .pc.slot .pc-f { background: rgba(0,0,0,.18); box-shadow: inset 0 0 0 2px rgba(255,255,255,.14); }
  .pot { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .pot .main { display: inline-flex; align-items: center; gap: 8px; padding: 5px 14px; border-radius: 999px; background: rgba(0,0,0,.55); font: 700 16px/1.2 var(--ds-font); color: #fff; font-variant-numeric: tabular-nums; }
  .pot .main .chip { width: 18px; height: 18px; }
  .pot .parts { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; }
  .pot .parts .tag { background: rgba(0,0,0,.4); color: #fff; font-weight: normal; text-transform: none; letter-spacing: 0; font-size: 12px; }
  .pot .parts .tag.unc { color: rgba(255,255,255,.65); font-style: italic; }
  .hm-logo { color: rgba(255,215,64,.28); font: 700 12px/1 var(--ds-font); letter-spacing: .3em; text-transform: uppercase; }
  .hm-seat { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%); width: 118px; z-index: 2; }
  .hm-seat .hole { display: flex; gap: 2px; justify-content: center; min-height: calc(var(--cw) * 1.4); --cw: 30px; margin-bottom: -10px; position: relative; z-index: 1; }
  .hm-seat.me .hole { --cw: 40px; }
  .hm-seat .hand { margin-top: 3px; font-size: 11px; color: var(--goldt); background: rgba(0,0,0,.7); border-radius: 6px; padding: 2px 6px; max-width: 100%; }
  .hm-seat .st { display: inline-flex; gap: 4px; flex-wrap: wrap; justify-content: center; }
  .hm-seat.empty .av { background: rgba(0,0,0,.2); border-style: dashed; color: rgba(255,255,255,.45); font-size: 20px; }
  .hm-seat.empty .plate { background: transparent; border: 0; color: rgba(255,255,255,.6); font-size: 12px; }
  .dbtn { position: absolute; inset-inline-end: 14px; top: 4px; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; z-index: 3;
          background: radial-gradient(circle at 35% 30%, #fff, #ddd); color: #111; font: 700 11px/1 var(--ds-font); box-shadow: 0 2px 4px rgba(0,0,0,.6); }
  .hm-bet { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%); z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 2px;
            transition: left .35s, top .35s, opacity .35s; }
  .hm-bet .bl { font: 700 10px/1 var(--ds-font); color: rgba(255,255,255,.85); letter-spacing: .08em; }
  .p0 { --x: 50%; --y: 99%; } .p1 { --x: 20%; --y: 93%; } .p2 { --x: 2%; --y: 62%; } .p3 { --x: 7%; --y: 20%; } .p4 { --x: 32%; --y: 1%; }
  .p5 { --x: 68%; --y: 1%; } .p6 { --x: 93%; --y: 20%; } .p7 { --x: 98%; --y: 62%; } .p8 { --x: 80%; --y: 93%; }
  .b0 { --x: 50%; --y: 74%; } .b1 { --x: 30%; --y: 72%; } .b2 { --x: 17%; --y: 58%; } .b3 { --x: 21%; --y: 33%; } .b4 { --x: 37%; --y: 24%; }
  .b5 { --x: 63%; --y: 24%; } .b6 { --x: 79%; --y: 33%; } .b7 { --x: 83%; --y: 58%; } .b8 { --x: 70%; --y: 72%; }
  .hm-res { padding: 6px 12px; border-radius: 12px; background: rgba(0,0,0,.6); border: 1px solid rgba(255,215,64,.5); color: var(--goldt); font-size: 13px; line-height: 1.4; }
  .hm-res b { color: #fff; }
  .mine { display: flex; align-items: center; gap: 10px; --cw: 52px; }
  .mine .lbl { color: var(--mut); font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
  .dock-row.raise { display: grid; gap: 8px; width: 100%; max-width: 620px; margin-inline: auto; }
  .raise-row { display: flex; align-items: center; gap: 8px; }
  .raise input[type=range] { flex: 1; min-width: 0; height: 36px; accent-color: var(--gold); }
  .raise input[type=text] { width: 120px; min-height: 44px; margin: 0; padding: 0 10px; border-radius: 12px; border: 1px solid var(--line); background: #06100a; color: #fff;
                              font: 700 16px var(--ds-font); text-align: center; }
  .presets { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
  .presets button { min-height: 40px; margin: 0; padding: 0 12px; border-radius: 999px; border: 1px solid var(--line); background: rgba(0,0,0,.35); color: var(--txt); font: 700 13px var(--ds-font); cursor: pointer; }
  .presets button:hover { border-color: var(--gold); }
  /* 1.99ov: the chip rack (tap a chip to add it to the raise); 💎 chips for High Rollers */
  .rack { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  .rchip { position: relative; display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 0; padding: 0; cursor: pointer;
           background: transparent; font: 700 11px/1 var(--ds-font); color: #111; transition: transform .1s; }
  .rchip .chip { position: absolute; inset: 0; width: 100%; height: 100%; }
  .rchip span.l { position: relative; z-index: 2; padding: 2px 4px; border-radius: 999px; background: rgba(255,255,255,.92); }
  .rchip.hr span.l { background: rgba(0,0,0,.82); color: #ffe082; box-shadow: 0 0 0 1px rgba(255,215,64,.7); }
  .rchip:hover { transform: translateY(-2px); }
  .buyamt { font: 700 30px/1 var(--ds-font); color: var(--goldt); text-align: center; margin: 6px 0; font-variant-numeric: tabular-nums; }
  .back { display: inline-flex; align-items: center; gap: 4px; min-height: 36px; margin: 0 0 6px; font-size: var(--ds-fs-sm); text-decoration: none; }
  .back:hover { text-decoration: underline; }
  @media (max-width: 760px) {
    .hm-wrap { padding: 56px 34px 96px; }
    .felt.hm { aspect-ratio: .74 / 1; max-height: 560px; margin: 0 auto; }
    .hm-center { width: 78%; top: 46%; }
    .board { --cw: 40px; gap: 4px; }
    .hm-seat { width: 74px; }
    .hm-seat .hole { --cw: 22px; }
    .hm-seat.me .hole { --cw: 30px; }
    .hm-seat .plate { padding: 3px 5px; }
    .hm-seat .plate .nm { max-width: 66px; font-size: 11px; }
    .hm-seat .plate .sub { font-size: 11px; }
    .hm-seat .tag { font-size: 9px; padding: 1px 4px; }
    .p0 { --x: 50%; --y: 99%; } .p1 { --x: 8%; --y: 84%; } .p2 { --x: 0%; --y: 58%; } .p3 { --x: 4%; --y: 30%; } .p4 { --x: 28%; --y: 4%; }
    .p5 { --x: 72%; --y: 4%; } .p6 { --x: 96%; --y: 30%; } .p7 { --x: 100%; --y: 58%; } .p8 { --x: 92%; --y: 84%; }
    .b0 { --x: 50%; --y: 81%; } .b1 { --x: 25%; --y: 75%; } .b2 { --x: 19%; --y: 58%; } .b3 { --x: 22%; --y: 36%; } .b4 { --x: 35%; --y: 21%; }
    .b5 { --x: 65%; --y: 21%; } .b6 { --x: 78%; --y: 36%; } .b7 { --x: 81%; --y: 58%; } .b8 { --x: 75%; --y: 75%; }
    .mine { --cw: 44px; }
    .hm-seat.empty > .who > .plate { display: none; }   /* an open seat you can't take: just the dashed ring */
    #cz-minerow { display: none !important; }   /* your cards are already big at your seat; keep the thumb bar short */
    .dock-acts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .dock-acts .cz-btn { padding: 0 6px; font-size: 15px; }
    .dock-row.raise { gap: 6px; }
  }
  @media (max-width: 420px) { .hm-wrap { padding: 56px 30px 96px; } .board { --cw: 36px; } .hm-seat { width: 68px; } }
  /* 1.99ajw casino2 review: the felt narrowed by the docked 💬 Chat (1100-1365px: about 540-850px wide) keeps its landscape oval with the
     seats, cards and plates a size down - the viewport queries above never see that narrowing (plates covered the flop) */
  @media (min-width: 1100px) and (max-width: 1365px) {
    body.cz-chat-dock:not(.cz-chat-mini) .hm-wrap { padding: 54px 48px 92px; }
    body.cz-chat-dock:not(.cz-chat-mini) .felt.hm { aspect-ratio: 1.8 / 1; }   /* (a little taller: the top seats' tags clear the board) */
    body.cz-chat-dock:not(.cz-chat-mini) .hm-logo { display: none; }
    body.cz-chat-dock:not(.cz-chat-mini) .hm-center { width: 58%; gap: 4px; top: 50%; }
    body.cz-chat-dock:not(.cz-chat-mini) .board { --cw: 40px; gap: 4px; }
    body.cz-chat-dock:not(.cz-chat-mini) .hm-seat { width: 96px; }
    body.cz-chat-dock:not(.cz-chat-mini) .hm-seat .av { width: 40px; height: 40px; font-size: 15px; }
    body.cz-chat-dock:not(.cz-chat-mini) .hm-seat .hole { --cw: 22px; margin-bottom: -8px; }
    body.cz-chat-dock:not(.cz-chat-mini) .hm-seat.me .hole { --cw: 32px; }
    body.cz-chat-dock:not(.cz-chat-mini) .hm-seat .plate { padding: 3px 6px; }
    body.cz-chat-dock:not(.cz-chat-mini) .hm-seat .plate .nm { max-width: 86px; font-size: 11.5px; }
    body.cz-chat-dock:not(.cz-chat-mini) .hm-seat .plate .sub { font-size: 11px; }
    body.cz-chat-dock:not(.cz-chat-mini) .hm-seat .tag { font-size: 9px; padding: 1px 4px; }
    body.cz-chat-dock:not(.cz-chat-mini) .pot .main { padding: 4px 12px; font-size: 14px; }
    body.cz-chat-dock:not(.cz-chat-mini) .hm-center .felt-msg { margin: 0; font-size: 14px; }
    body.cz-chat-dock:not(.cz-chat-mini) .hm-center .felt-msg small { font-size: 12px; }
    body.cz-chat-dock:not(.cz-chat-mini) .hm-center .clock { width: 36px; height: 36px; font-size: 13px; }
    body.cz-chat-dock:not(.cz-chat-mini) .mine { --cw: 44px; }
  }
</style>
<main class="ds-page flow cz" id="cb" data-game="holdem" data-table="<%= tableId || '' %>" data-signed="<%= signedIn ? '1' : '' %>" data-user="<%= signedIn && user ? user : '' %>">
  <%- include('partials/casino-top', { t, game: 'holdem', tableId }) %>
  <% if (!tableId) { %><%- include('partials/casino-lobby', { t, game: 'holdem', bjOn: locals.bjOn, hmOn: locals.hmOn }) %>
  <%# ── h22 phase 2 (1.99??): 🏆 scheduled tournaments - the lobby's block (casinomtt.js moves it above the Sit & Go section; GET /api/casino/mtt) ── %>
  <section class="mtt-sec" id="cz-mtt" hidden aria-labelledby="cz-mtt-h">
    <h2 class="lob-h mtt" id="cz-mtt-h"><a id="mtt" class="mtt-anchor"></a><%- t('casino.mtt.h') %></h2>
    <p class="sng-note" id="cz-mtt-note"><%- t('casino.mtt.note') %></p>
    <div class="mtt-tabs" role="tablist"><button type="button" role="tab" data-tab="list" aria-selected="true"><%- t('casino.mtt.tab_list') %></button><button type="button" role="tab" data-tab="board" aria-selected="false"><%- t('casino.mtt.tab_board') %></button></div>
    <div class="lob-grid" id="cz-mtts" aria-live="off"></div>
    <div id="cz-mtt-board" hidden></div>
  </section>
  <%# ── /h22 phase 2 ── %>
  <%# ── h22 (1.99alz): 🏁 Sit & Go - the lobby's section (casino-ui.js moves it after the tables) and the Create sheet ── %>
  <section class="sng-sec" id="cz-sng" hidden aria-labelledby="cz-sng-h">
    <h2 class="lob-h sng" id="cz-sng-h"><%- t('casino.sng_h') %></h2>
    <p class="sng-note" id="cz-sng-note"><%- t('casino.sng_note') %></p>
    <div class="lob-grid" id="cz-sngs" aria-live="off"></div>
    <div class="sng-new">
      <button type="button" class="cz-btn gold" id="cz-sng-open" hidden><%- t('casino.sng_create') %></button>
      <a class="cz-btn ghost cz-signin" href="/login"><%- t('casino.signin_open') %></a>
    </div>
  </section>
  <dialog class="sheet" id="cz-sngnew" aria-labelledby="cz-sngnew-h">
    <div class="sheet-h"><h2 id="cz-sngnew-h">🏁 <%- t('casino.sng_new_h') %></h2><button type="button" class="sheet-x" data-close aria-label="<%- t('casino.close') %>">×</button></div>
    <div class="sheet-b">
      <label class="lbl" for="cz-sng-size"><%- t('casino.sng_size') %></label>
      <select id="cz-sng-size"><% for (let n = 2; n <= 9; n++) { %><option value="<%= n %>"<%= n === 6 ? ' selected' : '' %>><%= n %></option><% } %></select>
      <label class="lbl" id="cz-sng-buyin-l"><%- t('casino.sng_buyin') %></label>
      <div class="blinds" id="cz-sng-buyins" role="group" aria-labelledby="cz-sng-buyin-l"></div>
      <label class="sng-chk"><input type="checkbox" id="cz-sng-turbo"> <span id="cz-sng-turbo-l"><%- t('casino.sng_turbo') %></span></label>
      <label class="lbl" for="cz-sng-at"><%- t('casino.sng_start') %></label>
      <select id="cz-sng-at"></select>
      <p class="fine sng-sum" id="cz-sng-sum" aria-live="polite"></p>
      <p class="fine"><%- t('casino.sng_rules') %></p>
      <div class="rowb"><button type="button" class="cz-btn gold wide" id="cz-sng-go"><%- t('casino.sng_create_go') %></button></div>
    </div>
  </dialog>
  <%# ── /h22 ── %>
  <% } else { %>
  <section id="cz-table" hidden>
    <a class="back" href="/casino/holdem">← <%- t('casino.all_tables') %></a>
    <%# h22 (1.99alz): a 🏁 Sit & Go's header (level, blinds, next level, players left, prizes; while it registers: who's in, Register /
        Unregister) and its results card - casinohm.js sngHead, hidden at a cash table %>
    <div class="sng-head" id="cz-snghead" hidden aria-live="off"></div>
    <div class="sng-res" id="cz-sngres" hidden></div>
    <div class="hm-wrap">
      <div class="felt hm" id="cz-felt">
        <div class="hm-center">
          <span class="hm-logo" aria-hidden="true">publicaccess.tv</span>
          <div class="board" id="cz-board" role="group" aria-label="<%- t('casino.board') %>"></div>
          <div class="pot" id="cz-pot" aria-live="off"></div>
          <div class="felt-msg" id="cz-msg"></div>
          <div class="clock" id="cz-fclock" hidden><span class="secs"></span></div>
        </div>
        <div id="cz-bets"></div>
        <div id="cz-seats"></div>
      </div>
    </div>
    <div class="felt-meta" id="cz-meta"></div>
    <div class="watchbar" id="cz-watchbar" hidden></div>

    <div class="dock" id="cz-dock" hidden>
      <div class="dock-row" id="cz-minerow" hidden>
        <div class="mine"><span class="lbl"><%- t('casino.your_cards') %></span><span class="cards row" id="cz-mine"></span></div>
      </div>
      <div id="cz-playbox" hidden>
        <div class="dock-row dock-turn">
          <div class="clock" id="cz-dclock" hidden><span class="secs"></span></div>
          <div class="dock-acts">
            <button type="button" class="cz-btn red" data-v="fold"><%- t('casino.fold') %></button>
            <button type="button" class="cz-btn green" data-v="check"><%- t('casino.check') %></button>
            <button type="button" class="cz-btn green" data-v="call"></button>
            <button type="button" class="cz-btn gold" data-v="raise"></button>
          </div>
        </div>
        <details class="dock-row raise" id="cz-raisebox" open>
          <summary><%- t('casino.sizing') %></summary>
          <div class="presets" id="cz-presets" role="group" aria-label="<%- t('casino.presets') %>">
            <button type="button" data-p="min"><%- t('casino.p_min') %></button>
            <button type="button" data-p="half"><%- t('casino.p_half') %></button>
            <button type="button" data-p="pot"><%- t('casino.p_pot') %></button>
            <button type="button" data-p="all"><%- t('casino.p_all') %></button>
          </div>
          <div class="rack" id="cz-rack" role="group" aria-label="<%- t('casino.chips') %>"></div>
          <div class="raise-row">
            <input type="range" id="cz-slider" aria-label="<%- t('casino.raise_to') %>">
            <input type="text" id="cz-raise" aria-label="<%- t('casino.raise_to') %>" autocomplete="off" spellcheck="false">
          </div>
        </details>
      </div>
      <p class="dock-note" id="cz-wait" hidden></p>
      <div class="dock-row presets" id="cz-pre" hidden role="group" aria-label="<%- t('casino.premove') %>">
        <% [['check_fold','pre_checkfold'],['check','check'],['call','call'],['call_any','pre_callany'],['fold','fold']].forEach(([k,l]) => { %>
        <label><input type="checkbox" data-pre="<%= k %>"> <span><%- t('casino.' + l) %></span></label>
        <% }) %>
      </div>
      <div class="dock-row" id="cz-misc">
        <button type="button" class="cz-btn ghost sm" id="cz-myhandsbtn"><%- t('casino.my_hands') %></button>
        <label id="cz-showlabel"><input type="checkbox" id="cz-showhand"> <%- t('casino.show_hand') %></label>
        <button type="button" class="cz-btn gold" id="cz-sit" hidden><%- t('casino.sit_down') %></button>
        <button type="button" class="cz-btn green sm" id="cz-deal" hidden><%- t('casino.deal_now') %></button>
        <button type="button" class="cz-btn ghost sm" id="cz-topup" hidden><%- t('casino.top_up') %></button>
        <button type="button" class="cz-btn ghost sm" id="cz-leave" hidden><%- t('casino.stand_up') %></button>
        <button type="button" class="cz-btn ghost sm" id="cz-sitout" hidden><%- t('casino.sitout_next') %></button>
        <button type="button" class="cz-btn green sm" id="cz-sitin" hidden><%- t('casino.im_back') %></button>
        <button type="button" class="cz-btn ghost sm" id="cz-postnow" hidden><%- t('casino.post_now') %></button>
      </div>
    </div>
  </section>
  <%- include('partials/casino-sheets', { t }) %>
  <dialog class="sheet" id="cz-buy" aria-labelledby="cz-buy-h">
    <div class="sheet-h"><h2 id="cz-buy-h"><%- t('casino.buy_in') %></h2><button type="button" class="sheet-x" data-close aria-label="<%- t('casino.close') %>">×</button></div>
    <div class="sheet-b">
      <p class="fine" id="cz-buynote"></p>
      <div class="buyamt" id="cz-buyamt">0</div>
      <input type="range" id="cz-buyslider" aria-label="<%- t('casino.buy_amount') %>" style="width:100%;accent-color:var(--gold)">
      <div class="presets" id="cz-buypresets" style="margin-top:8px"></div>
      <label class="lbl" for="cz-buyin"><%- t('casino.buy_amount') %></label>
      <input type="number" id="cz-buyin" inputmode="numeric">
      <p class="fine" id="cz-buyhr" hidden><%- t('casino.buy_hr_v2') %></p>
      <div class="rowb"><button type="button" class="cz-btn gold wide" id="cz-buygo"></button></div>
    </div>
  </dialog>
  <%- include('partials/casino-chat', { t }) %>
  <% if (locals.theme && theme !== 'classic') { %><%- include('partials/casino-theme-' + theme, { t }) %><% } %>
  <dialog class="sheet" id="cz-myhands" aria-labelledby="cz-myhands-h">
    <div class="sheet-h"><h2 id="cz-myhands-h"><%- t('casino.my_hands') %></h2><button type="button" class="sheet-x" data-close aria-label="<%- t('casino.close') %>">×</button></div>
    <div class="sheet-b">
      <label for="cz-handselect"><%- t('casino.choose_hand') %></label><select id="cz-handselect"></select>
      <div id="cz-replay" aria-live="polite"></div>
      <div class="dock-row"><button type="button" class="cz-btn ghost sm" id="cz-replayprev"><%- t('casino.previous_action') %></button><button type="button" class="cz-btn ghost sm" id="cz-replaynext"><%- t('casino.next_action') %></button></div>
      <p class="fine"><%- t('casino.muck_note') %></p>
    </div>
  </dialog>
  <% } %>
