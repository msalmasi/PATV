<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('settings.page_title'), user: username }) %>
<%
  // equipped cosmetics, same as the profile hero
  const pc = typeof profileCosmetics !== 'undefined' && profileCosmetics ? profileCosmetics : null;
  const cx = (k) => (pc && pc.equipped && pc.equipped[k] ? pc.equipped[k].r : null);
  const cxName = cx('name_color'), cxBorder = cx('profile_border'), cxDeco = cx('avatar_decoration'), cxBanner = cx('profile_banner'), cxFx = cx('profile_effect');
  const role = (typeof classh !== 'undefined' && classh ? classh : '').toLowerCase();
  const lay = typeof layout !== 'undefined' && layout ? layout : { order: [], hidden: [], priv: [] };
  const secs = typeof sections !== 'undefined' ? sections : [];
  const subs = typeof subSections !== 'undefined' ? subSections : {};
  const privs = typeof privPanels !== 'undefined' && privPanels ? privPanels : [];
  const byId = Object.fromEntries(secs.map((s) => [s.id, s]));
  const isHidden = (id) => lay.hidden.includes(id);
  // privacy panels: public (default) / private (only me & admins) / hidden
  const stateOf = (id) => (isHidden(id) ? 'hidden' : (lay.priv || []).includes(id) ? 'private' : 'public');
  // labels / tips are HTML-safe catalog text (printed raw)
  const VIS = [['public', '🌐', t('settings.vis.public'), t('settings.vis.public_tip')], ['private', '🔒', t('settings.vis.private'), t('settings.vis.private_tip')],
               ['hidden', '🚫', t('settings.vis.hidden'), t('settings.vis.hidden_tip')]];
  const camfrogName = typeof camfrogUsername !== 'undefined' && camfrogUsername ? camfrogUsername : '';
  // section / panel names and descriptions come from profilelayout.js; the catalog has them by id (HTML-safe, printed raw)
  const lbl_ = (o) => t.has('settings.layout.label.' + o.id) ? t('settings.layout.label.' + o.id) : t.esc(o.label);
  const desc_ = (o) => t.has('settings.layout.desc.' + o.id) ? t('settings.layout.desc.' + o.id) : t.esc(o.desc || '');
%>
<%- include('partials/cosmetics-css') %>
<%- include('partials/account-css') %>

<main class="ds-page mid pe">
  <a class="ds-back" href="/settings">← <%- t('sethub.back') %></a>
  <div class="top">
    <h1 class="ds-h1"><%- t('profile.edit_profile') %></h1>
    <span class="top-acts"><a class="btn" href="/settings"><span class="ds-ic" aria-hidden="true">⚙️</span> <%- t('sethub.h1') %></a> <a class="btn" href="/u/<%= username %>"><%- t('settings.view_profile') %></a></span>
  </div>

  <%- include('partials/account-flash', { errors: errors, success: success }) %>

  <!-- live preview of the profile hero -->
  <section class="card hero cx-host" aria-label="<%- t('settings.preview_aria') %>">
    <% if (cxBanner) { %><div class="cx-banner" style="<%= cxBanner.css %>" aria-hidden="true"></div><% } %>
    <% if (cxFx) { %><div class="cx-fx cx-fx-<%= cxFx.effect %>" aria-hidden="true"></div><% } %>
    <span class="cx-av">
      <% if (cxDeco && cxDeco.conic) { %><span class="cx-conic<%= cxDeco.spin ? ' cx-spin' : '' %>" style="<%= cxDeco.conic %>" aria-hidden="true"></span><% } %>
      <img class="avatar" id="pvAvatar" src="<%= avatar %>" alt="<%- t('settings.your_avatar') %>" onerror="this.src='/public/img/avatar.png'"<% if (cxDeco && cxDeco.ring) { %> style="<%= cxDeco.ring %>"<% } %>>
      <% if (cxDeco && cxDeco.emoji) { %><span class="cx-emoji" aria-hidden="true"><%= cxDeco.emoji %></span><% } %>
    </span>
    <div class="who">
      <div class="nm"><% if (cxName && cxName.css) { %><span class="cx-name" id="pvName" style="<%= cxName.css %>"><%= displayname || username %></span><% } else { %><span id="pvName"><%= displayname || username %></span><% } %></div>
      <div class="handle">@<span id="pvHandle"><%= username %></span><% if (camfrogName) { %> · 🐸 <%- t('profile.on_camfrog', { name: camfrogName }) %><% } %></div>
      <div class="chips">
        <span class="chip chip-preview"><%- t('settings.preview') %></span>
        <% if (typeof level !== 'undefined' && level != null) { %><span class="chip"><%- t('settings.level_n', { n: level }) %></span><% } %>
        <% if (role && role !== 'pleb') { %><span class="chip <%= role %>"><%= classh %></span><% } %>
      </div>
    </div>
    <div class="hero-foot">
      <span class="muted"><%- t('settings.cosmetics_note') %></span>
      <a class="btn" href="/cosmetics?tab=mine#tabs"><span class="ds-ic" aria-hidden="true">🎨</span> <%- t('profile.menu.cosmetics') %></a>
    </div>
    <% if (cxBorder) { %><div class="cx-frame <%= cxBorder.cls %>" style="<%= cxBorder.css %>" aria-hidden="true"></div><% } %>
  </section>

  <nav class="jump" aria-label="<%- t('settings.sections_aria') %>">
    <a href="#account"><%- t('settings.name_h') %></a><a href="#avatar"><%- t('settings.avatar') %></a><a href="#layout"><%- t('settings.layout') %></a><a href="#elsewhere"><%- t('settings.elsewhere_h') %></a>
  </nav>

  <section class="card" id="account">
    <h2><%- t('settings.name_h') %></h2>
    <p class="lede"><%- t('settings.name.lede') %></p>
    <div>
      <form class="field" id="displaynameForm" action="/api/u/<%= username %>/update/displayname" method="post">
        <label class="lbl" for="displayname"><%- t('settings.account.displayname') %></label>
        <div class="row"><input type="text" id="displayname" name="displayname" value="<%= displayname %>" maxlength="32" required><button class="btn primary" type="submit"><%- t('settings.save') %></button></div>
      </form>
    </div>
  </section>

  <section class="card" id="avatar">
    <h2><%- t('settings.avatar') %></h2>
    <p class="lede"><%- t('settings.avatar.lede') %></p>
    <form id="uploadForm" class="avup" enctype="multipart/form-data">
      <img id="avPreview" src="<%= avatar %>" alt="" onerror="this.src='/public/img/avatar.png'">
      <div style="display:grid;gap:8px;min-width:0">
        <div class="row" style="flex-wrap:wrap">
          <span class="file"><span class="btn">📁 <%- t('settings.avatar.choose') %></span><input type="file" id="avatarFile" name="avatar" accept="image/*" required aria-label="<%- t('settings.avatar.choose_aria') %>"></span>
          <button class="btn primary" type="submit" id="avSave" disabled><%- t('settings.avatar.upload') %></button>
        </div>
        <div class="status" id="uploadStatus" role="status" aria-live="polite"></div>
      </div>
    </form>
  </section>

  <section class="card" id="layout">
    <h2><%- t('settings.layout') %></h2>
    <p class="lede"><%- t('settings.layout.lede') %></p>
    <p class="lede"> <%- t('settings.layout.lede2') %></p>
    <form id="layoutForm" action="/api/u/<%= username %>/update/layout" method="post">
      <div class="lay-fixed"><span class="ds-ic" aria-hidden="true">🔒</span><span><b><%- t('settings.layout.header') %></b> <%- t('settings.layout.header_desc') %></span></div>
      <ol class="lay" id="layList" aria-describedby="layHelp">
        <% lay.order.forEach((id, i) => { const s = byId[id]; if (!s) return; const off = isHidden(id); %>
        <li class="lay-item<%= off ? ' off' : '' %>" data-id="<%= id %>" data-label="<%- lbl_(s) %>">
          <input type="hidden" name="order" value="<%= id %>">
          <button type="button" class="lay-grip" aria-label="<%- t('settings.layout.reorder_aria', { label: lbl_(s) }) %>" title="<%- t('settings.layout.drag') %>">⠿</button>
          <span class="lay-ico" aria-hidden="true"><%= s.icon %></span>
          <div class="lay-txt">
            <b><%- lbl_(s) %></b><small><%- desc_(s) %></small>
            <% if (subs[id] && subs[id].length) { %>
              <div class="lay-subs" role="group" aria-label="<%- t('settings.layout.panels_aria', { label: lbl_(s) }) %>">
                <% subs[id].forEach((p) => { %>
                  <label><input type="checkbox" name="show" value="<%= p.id %>"<%= isHidden(p.id) ? '' : ' checked' %>><%- lbl_(p) %></label>
                <% }) %>
              </div>
            <% } %>
          </div>
          <label class="sw"><input type="checkbox" name="show" value="<%= id %>"<%= off ? '' : ' checked' %> aria-label="<%- t('settings.layout.show_aria', { label: lbl_(s) }) %>"><span class="tr" aria-hidden="true"></span><span class="st"><%- off ? t('settings.layout.hidden') : t('settings.layout.visible') %></span></label>
          <span class="mv"><button type="button" class="up" aria-label="<%- t('settings.layout.up_aria', { label: lbl_(s) }) %>">▲</button><button type="button" class="dn" aria-label="<%- t('settings.layout.down_aria', { label: lbl_(s) }) %>">▼</button></span>
          <% const privsHere = privs.filter((p) => (p.sec || 'analytics') === id); if (privsHere.length) { %>
          <div class="lay-priv" role="group" aria-label="<%- t('settings.layout.priv') %>">
            <div class="lay-priv-h"><%- t('settings.layout.priv') %> <span>· <%- t('settings.layout.priv_who') %></span></div>
            <% privsHere.forEach((p) => { const st = stateOf(p.id); %>
            <fieldset class="pv is-<%= st %>" data-pv="<%= p.id %>">
              <legend class="sr"><%- t('settings.layout.priv_legend', { label: lbl_(p) }) %></legend>
              <div class="pv-txt" aria-hidden="true"><b><%= p.icon %> <%- lbl_(p) %></b><small><%- desc_(p) %></small></div>
              <div class="seg">
                <% VIS.forEach(([v, ico, lbl, tip]) => { %>
                <label class="s-<%= v %>" title="<%- tip %>"><input type="radio" name="vis_<%= p.id %>" value="<%= v %>"<%= st === v ? ' checked' : '' %>><span aria-hidden="true"><%= ico %></span><%- lbl %></label>
                <% }) %>
              </div>
            </fieldset>
            <% }) %>
          </div>
          <% } %>
        </li>
        <% }) %>
      </ol>
      <p class="sr" id="layHelp"><%- t('settings.layout.help') %></p>
      <div class="sr" id="layLive" aria-live="polite"></div>
      <div class="lay-actions">
        <button class="btn primary" type="submit"><%- t('settings.layout.save') %></button>
        <a class="btn" href="/u/<%= username %>?preview=visitor">👁 <%- t('profile.bar.preview') %></a>
        <button class="btn ghost" type="submit" name="reset" value="1" id="layReset"><%- t('settings.layout.reset') %></button>
        <span class="dirty" id="layDirty"><%- t('settings.layout.unsaved') %></span>
      </div>
      <p class="lay-note"><%- t('settings.layout.note') %></p>
    </form>
  </section>

  <%# 1.99vz: one home per setting - the account side lives in Settings %>
  <section class="card" id="elsewhere">
    <h2><%- t('settings.elsewhere_h') %></h2>
    <p class="lede"><%- t('settings.elsewhere.lede') %></p>
    <div class="top-acts"><a class="btn primary" href="/settings/account"><span class="ds-ic" aria-hidden="true">🔐</span> <%- t('setacct.h1') %></a> <a class="btn" href="/settings"><span class="ds-ic" aria-hidden="true">⚙️</span> <%- t('sethub.h1') %></a></div>
  </section>
</main>

<script>
  var _t = typeof __t === 'function' ? __t : function (k, d, v) { return String(d).replace(/\{!?(\w+)\}/g, function (m, n) { return v && v[n] != null ? v[n] : m; }); };

  (function () {
    // live preview: display name
    var dn = document.getElementById('displayname'), pvName = document.getElementById('pvName');
    var fallback = <%- JSON.stringify(String(username)).replace(/</g, '\\u003c') %>;
    if (dn && pvName) dn.addEventListener('input', function () { pvName.textContent = dn.value.trim() || fallback; });

    // avatar: preview the chosen file, upload it, then show it in the hero
    var form = document.getElementById('uploadForm'), file = document.getElementById('avatarFile');
    var img = document.getElementById('avPreview'), pv = document.getElementById('pvAvatar');
    var save = document.getElementById('avSave'), status = document.getElementById('uploadStatus');
    var oldSrc = img ? img.src : '', obj = null;
    function say(t, ok) { status.textContent = t; status.className = 'status ' + (ok ? 'ok' : 'err'); }
    if (file) file.addEventListener('change', function () {
      var f = file.files && file.files[0];
      if (obj) { URL.revokeObjectURL(obj); obj = null; }
      if (!f) { img.src = oldSrc; save.disabled = true; return; }
      if (!/^image\//.test(f.type)) { say(_t('js.settings.avatar.not_image', 'That is not an image.'), false); save.disabled = true; return; }
      obj = URL.createObjectURL(f);
      img.src = obj; if (pv) pv.src = obj;
      save.disabled = false; say(_t('js.settings.avatar.looks_good', 'Looks good? Hit Upload.'), true);
    });
    if (form) form.addEventListener('submit', function (e) {
      e.preventDefault();
      var f = file.files && file.files[0];
      if (!f) return;
      var fd = new FormData(); fd.append('avatar', f);
      save.disabled = true; say(_t('js.settings.avatar.uploading', 'Uploading…'), true);
      fetch('/api/u/' + encodeURIComponent(fallback) + '/update/avatar', { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function (r) {
          // 1.99fc: a picture the image safety check refused (422) says why
          if (r.status === 422) return r.json().then(function (d) { var e = new Error(); e.msg = (d && d.message) || ''; throw e; });
          if (!r.ok) throw new Error(); return r.json();
        })
        .then(function (d) {
          if (d && /success/i.test(d.message || '')) { say(_t('js.settings.avatar.updated', 'Avatar updated.'), true); oldSrc = img.src; }
          else throw new Error();
        })
        .catch(function (e) { say((e && e.msg) || _t('js.settings.avatar.failed', "Upload failed — try a smaller image."), false); save.disabled = false; });
    });

    // ── profile layout: drag (pointer) + keyboard + up/down buttons ──
    var list = document.getElementById('layList');
    if (!list) return;
    var live = document.getElementById('layLive'), dirty = document.getElementById('layDirty');
    var initial = snapshot();
    function items() { return Array.prototype.slice.call(list.children); }
    function snapshot() {
      return items().map(function (li) { return li.getAttribute('data-id'); }).join(',') + '|' +
        Array.prototype.map.call(list.querySelectorAll('input[type=checkbox], input[type=radio]'), function (c) { return c.checked ? 1 : 0; }).join('');
    }
    function refresh(announceLi) {
      var all = items();
      all.forEach(function (li, i) {
        li.querySelector('.up').disabled = i === 0;
        li.querySelector('.dn').disabled = i === all.length - 1;
      });
      dirty.classList.toggle('on', snapshot() !== initial);
      if (announceLi) live.textContent = _t('js.settings.layout.moved', '{label} moved to position {n} of {total}', { label: announceLi.getAttribute('data-label'), n: all.indexOf(announceLi) + 1, total: all.length });
    }
    function move(li, dir) {
      if (dir < 0 && li.previousElementSibling) list.insertBefore(li, li.previousElementSibling);
      else if (dir > 0 && li.nextElementSibling) list.insertBefore(li.nextElementSibling, li);
      else return false;
      refresh(li);
      return true;
    }
    list.addEventListener('click', function (e) {
      var b = e.target.closest('.up, .dn');
      if (!b) return;
      var li = b.closest('.lay-item');
      move(li, b.classList.contains('up') ? -1 : 1);
      b.focus();
    });
    list.addEventListener('keydown', function (e) {
      var g = e.target.closest('.lay-grip');
      if (!g) return;
      if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
        e.preventDefault();
        move(g.closest('.lay-item'), e.key === 'ArrowUp' ? -1 : 1);
        g.focus();
      }
    });
    list.addEventListener('change', function (e) {
      var c = e.target;
      if (c.type === 'radio') {
        var fs = c.closest('.pv');
        if (fs) fs.className = 'pv is-' + c.value;
        refresh();
        return;
      }
      if (c.type !== 'checkbox') return;
      var li = c.closest('.lay-item');
      if (c.closest('.sw')) {
        li.classList.toggle('off', !c.checked);
        li.querySelector('.sw .st').textContent = c.checked ? _t('js.settings.layout.visible', 'Visible') : _t('js.settings.layout.hidden', 'Hidden');
      }
      refresh();
    });
    // pointer drag on the handle (mouse, pen and touch alike)
    var drag = null;
    list.addEventListener('pointerdown', function (e) {
      var g = e.target.closest('.lay-grip');
      if (!g || (e.pointerType === 'mouse' && e.button !== 0)) return;
      e.preventDefault();
      var li = g.closest('.lay-item');
      drag = { li: li, id: e.pointerId, g: g };
      li.classList.add('dragging');
      try { g.setPointerCapture(e.pointerId); } catch (err) {}
    });
    list.addEventListener('pointermove', function (e) {
      if (!drag || e.pointerId !== drag.id) return;
      var y = e.clientY;
      var others = items().filter(function (x) { return x !== drag.li; });
      var before = null;
      for (var i = 0; i < others.length; i++) {
        var r = others[i].getBoundingClientRect();
        if (y < r.top + r.height / 2) { before = others[i]; break; }
      }
      if (before !== drag.li.nextElementSibling) {
        if (before) list.insertBefore(drag.li, before); else list.appendChild(drag.li);
        refresh();
      }
      // keep the item in view while dragging near the edges
      if (y < 60) window.scrollBy(0, -12); else if (y > window.innerHeight - 60) window.scrollBy(0, 12);
    });
    function end(e) {
      if (!drag || (e && e.pointerId !== drag.id)) return;
      drag.li.classList.remove('dragging');
      refresh(drag.li);
      drag = null;
    }
    list.addEventListener('pointerup', end);
    list.addEventListener('pointercancel', end);

    var reset = document.getElementById('layReset');
    if (reset) reset.addEventListener('click', function (e) {
      if (!confirm(_t('js.settings.layout.reset_confirm', 'Reset your profile layout to the default order with everything visible?'))) e.preventDefault();
    });
    document.getElementById('layoutForm').addEventListener('submit', function () { initial = snapshot(); });
    window.addEventListener('beforeunload', function (e) {
      if (snapshot() !== initial) { e.preventDefault(); e.returnValue = ''; }
    });
    refresh();
  })();
</script>
<script>
  // 1.99vz: these cards moved - old links (#connections, #password, ...) forward to their one home
  (function () {
    var h = (location.hash || '').slice(1), to = null;
    if (/^(connections|password|security|timezone|camfrogDiv|plexDiv|googleDiv|appleDiv|telegramDiv|cryptoDiv)$/.test(h)) to = '/settings/account#' + h;
    else if (h === 'language') to = '/language?next=' + encodeURIComponent(location.pathname);
    else if (h === 'privacy') to = '/settings#privacy';
    if (to) location.replace(to);
  })();
</script>
</body>
</html>
