<%- include('layout', { title: 'Clips & Snaps', user: user}) %>
<style>
  .fd { max-width: 1100px; margin: 0 auto; padding: 0 16px 48px; font-family: Ubuntu, sans-serif; }
  .fd h1 { text-align: center; margin-bottom: 4px; }
  .fd .sub { text-align: center; color: #9a9; margin: 0 0 18px; }
  .fd .filters { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; margin-bottom: 20px; }
  .fd .filters a { padding: 5px 11px; border: 1px solid #333; border-radius: 14px; color: #ccc; text-decoration: none; font-size: 13px; }
  .fd .filters a.on { border-color: #4caf50; color: #fff; background: #1b2b1b; }
  .fd .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .fd .card { background: #111; border: 1px solid #222; border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; min-width: 0; }
  .fd .media { background: #000; aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center; }
  .fd .media img, .fd .media video { width: 100%; height: 100%; object-fit: contain; display: block; }
  .fd .media audio { width: 92%; }
  .fd .meta { padding: 9px 11px; font-size: 13px; color: #ccc; display: grid; gap: 3px; }
  .fd .meta b { color: #fff; }
  .fd .meta .mut { color: #888; }
  .fd .meta a { color: #81c784; text-decoration: none; }
  .fd .empty, .fd .login { text-align: center; color: #888; margin-top: 40px; }
  .fd .login a { color: #81c784; }
</style>
<div class="fd">
  <h1>Clips &amp; Snaps</h1>
  <p class="sub">Everything Pepe has captured in the rooms that hasn't expired yet. Newest first.</p>
  <% if (needLogin) { %>
    <p class="login">These are webcam captures, so the feed is for PATV members. <a href="/login">Sign in</a> to see it.</p>
  <% } else { %>
    <% const q = (o) => '/feed?' + new URLSearchParams(Object.assign({ kind: kind || '', room: room || '' }, o)).toString(); %>
    <div class="filters">
      <a class="<%= !kind ? 'on' : '' %>" href="<%= q({ kind: '' }) %>">Everything</a>
      <a class="<%= kind === 'clip' ? 'on' : '' %>" href="<%= q({ kind: 'clip' }) %>">📹 Clips</a>
      <a class="<%= kind === 'photo' ? 'on' : '' %>" href="<%= q({ kind: 'photo' }) %>">📸 Snaps</a>
      <a class="<%= kind === 'audio' ? 'on' : '' %>" href="<%= q({ kind: 'audio' }) %>">🔊 Audio</a>
      <% rooms.forEach((r) => { %>
        <a class="<%= room === r ? 'on' : '' %>" href="<%= q({ room: room === r ? '' : r }) %>"><%= r %></a>
      <% }) %>
    </div>
    <% if (!items.length) { %>
      <p class="empty">Nothing here right now. Captures expire, so check back after the next !snap or !clip.</p>
    <% } else { %>
      <div class="grid">
        <% items.forEach((it) => { const src = '/media/' + it.id + '/raw'; %>
          <div class="card">
            <div class="media">
              <% if (it.kind === 'clip') { %>
                <video src="<%= src %>" controls playsinline preload="metadata" muted></video>
              <% } else if (it.kind === 'audio') { %>
                <audio src="<%= src %>" controls preload="none"></audio>
              <% } else { %>
                <a href="/media/<%= it.id %>"><img src="<%= src %>" alt="Snap of <%= it.subject %>" loading="lazy"></a>
              <% } %>
            </div>
            <div class="meta">
              <div><b><%= it.subject || 'someone' %></b> <span class="mut">· <%= it.room || 'a room' %></span></div>
              <div class="mut">by <%= it.by_user || '?' %><%= it.secs ? ' · ' + Math.round(it.secs) + 's' : '' %> · expires in <%= it.ttl %></div>
              <div><a href="/media/<%= it.id %>">Open ›</a></div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  <% } %>
</div>
</body>
</html>
