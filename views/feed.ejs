<%- include('layout', { title: tab === 'following' ? 'Following — feed' : room ? room.title + ' — feed' : 'Feed', user: user}) %>
<link rel="stylesheet" href="/public/css/feed.css?v=4">
<link rel="stylesheet" href="/public/css/stories.css?v=1">
<%
  // 1.99bz: tabs = Posts | Following. Pepe's clips & snaps are the story strip on top (no separate tab;
  // ?tab=captures redirects here). Room filter, tabs, sort and pager swap #fdTop/#fdList in place
  // (public/js/feed-composer.js) so the composer's draft is never lost.
  const base = { tab: tab === 'following' ? 'following' : '', room: room ? room.slug : '', sort: sort === 'hot' ? '' : sort, t: fx.TIMED.has(sort) ? top : '', by: author ? author.username : '' };
  const q = (o) => { const x = Object.assign({}, base, o); Object.keys(x).forEach((k) => { if (!x[k]) delete x[k]; }); const s = new URLSearchParams(x).toString(); return '/feed' + (s ? '?' + s : ''); };
  const here = q({});
%>
<main class="fd">
  <h1>Feed</h1>
  <div id="fdTop">
    <p class="sub"><%= tab === 'following' ? 'Posts from the people and rooms you follow.' : room ? 'Posts in ' + room.title + ', and what Pepe captured there.' : 'Posts from the PATV community, and Pepe\'s snaps & clips from the rooms.' %></p>
    <%- include('partials/story-strip', { story, heading: room ? '📸 Fresh from ' + room.title : '📸 Stories', next: here }) %>
    <nav class="fd-tabs" aria-label="Feed sections">
      <a data-swap class="<%= tab === 'posts' ? 'on' : '' %>" href="<%= q({ tab: '', p: '' }) %>"<%- tab === 'posts' ? ' aria-current="page"' : '' %>>📝 Posts</a>
      <a data-swap class="<%= tab === 'following' ? 'on' : '' %>" href="<%= q({ tab: 'following', room: '', by: '', p: '' }) %>"<%- tab === 'following' ? ' aria-current="page"' : '' %>>⭐ Following</a>
    </nav>
    <% if (tab === 'posts') { %>
      <div class="fd-filters" aria-label="Rooms">
        <a data-swap class="<%= !room ? 'on' : '' %>" href="<%= q({ room: '', p: '' }) %>">Everywhere</a>
        <% rooms.forEach((r) => { %><a data-swap class="<%= room && room.id === r.id ? 'on' : '' %>" href="<%= q({ room: r.slug, p: '' }) %>">📡 <%= r.title %></a><% }) %>
      </div>
      <% if (author) { %><p class="sub">Posts by <b><%= author.displayname || author.username %></b><% if (authorFollow !== null) { %> <%- include('partials/follow-btn', { kind: 'user', id: author.username, following: authorFollow, signed: true, next: here, small: true }) %><% } %> · <a data-swap href="<%= q({ by: '' }) %>">show everyone</a></p><% } %>
    <% } %>
  </div>

  <div class="fd-col">
    <%- include('partials/feed-composer', { composer: composer, next: here }) %>
    <div id="fdList">
      <% if (tab === 'following' && !viewer) { %>
        <p class="login">⭐ Follow rooms and people to get a feed of just their posts. <a href="/login?next=<%= encodeURIComponent(here) %>">Sign in</a> to see yours.</p>
      <% } else { %>
        <% if (tab === 'following') { %><%- include('partials/following-panel', { follow, here }) %><% } %>
        <%- include('partials/feed-sort', { fx, sort, top, swap: true, href: (s, t) => q({ sort: s === 'hot' ? '' : s, t: t || '', p: '' }) }) %>
        <% if (!posts.length) { %>
          <p class="empty"><%= page > 1 ? 'No more posts.' : tab === 'following' ? ((follow && (follow.rooms.length || follow.people.length)) ? 'Nothing new from the people and rooms you follow.' : 'You don\'t follow anyone yet — tap “+ Follow” on a room, a profile or a post\'s author.') : 'Nothing posted here yet — be the first.' %></p>
        <% } else { %>
          <div class="fd-list">
            <% posts.forEach((p) => { %><%- include('partials/feed-post', { p, fx, embeds, host, viewer, modRooms, detail: false, ctxRoom: room ? room.id : null }) %><% }) %>
          </div>
        <% } %>
        <nav class="fd-pager">
          <% if (page > 1) { %><a data-swap href="<%= q({ p: page - 1 }) %>">‹ Newer</a><% } %>
          <% if (more) { %><a data-swap href="<%= q({ p: page + 1 }) %>">Older ›</a><% } %>
        </nav>
      <% } %>
    </div>
  </div>
</main>
<script src="/public/js/stories.js?v=1" defer></script>
<%- include('partials/feed-js', { viewer }) %>
</body>
</html>
