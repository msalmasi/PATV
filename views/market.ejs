<%- include('layout', { title: m ? m.ref + ' · ' + m.question : 'Market not found', user: user}) %>
<style>
  .mk { max-width: 892px; width: 100%; box-sizing: border-box; min-width: 0; margin: 0 auto; padding: 0 16px 48px; font-family: Ubuntu, sans-serif; }   /* a grid item with auto margins is sized to its content: width 100% keeps the trades table scrolling inside .tbl at 375 px instead of widening the page */
  .mk a { color: #81c784; }
  .mk .ref { color: #81c784; font-family: monospace; }
  .mk h1 { font-size: 22px; margin: 18px 0 4px; }
  .mk h3 { margin: 22px 0 8px; }
  .mk .info { color: #888; font-size: 13px; line-height: 1.7; }
  .mk .opts { display: grid; gap: 8px; margin: 18px 0; }
  .mk .opt { display: grid; grid-template-columns: minmax(70px, 160px) 1fr auto; gap: 10px; align-items: center; }
  .mk .bar { height: 12px; background: #1c1c1c; border-radius: 6px; overflow: hidden; }
  .mk .bar span { display: block; height: 100%; background: #4caf50; }
  .mk .opt.won .bar span { background: #ffd700; }
  .mk .num { color: #ccc; font-variant-numeric: tabular-nums; white-space: nowrap; font-size: 13px; }
  .mk .price { font-size: 20px; font-weight: bold; color: #fff; font-variant-numeric: tabular-nums; }
  .mk .tbl { overflow-x: auto; border: 1px solid #222; border-radius: 8px; }
  .mk table { width: 100%; border-collapse: collapse; font-size: 13px; font-variant-numeric: tabular-nums; }
  .mk th, .mk td { padding: 7px 10px; border-bottom: 1px solid #1c1c1c; text-align: left; }
  .mk th { color: #888; font-weight: normal; }
  .mk td.r, .mk th.r { text-align: right; }
  .mk .up { color: #81c784; } .mk .down { color: #e57373; }
  .mk .notice { background: #13200f; border: 1px solid #4caf50; border-radius: 8px; padding: 10px 12px; }
  .mk form.bet { background: #111; border: 1px solid #222; border-radius: 10px; padding: 14px; margin: 14px 0; display: grid; gap: 10px; }
  .mk form.judge { border-color: #e0a030; }
  .mk .opts-pick { display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .mk .opts-pick label { cursor: pointer; }
  .mk form .row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .mk form input[type=number], .mk form input[type=text] { background: #0d0d0d; color: #eee; border: 1px solid #333; border-radius: 6px; padding: 8px 10px; width: 180px; }
  .mk form button { background: #4caf50; color: #fff; border: 0; border-radius: 6px; padding: 9px 16px; font-weight: bold; cursor: pointer; }
  .mk form button.sell { background: #b85c38; padding: 5px 10px; }
  .mk form.judge button { background: #e0a030; color: #111; }
  .mk form.inline { display: flex; gap: 6px; align-items: center; justify-content: flex-end; margin: 0; }
  .mk form.inline input[type=text] { width: 70px; padding: 5px 8px; }
  .mk .chart { background: #0d0d0d; border: 1px solid #222; border-radius: 8px; padding: 8px; }
  .mk .chart svg { display: block; width: 100%; height: 180px; }
  .mk .legend { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 12px; color: #ccc; margin-top: 6px; }
  .mk .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 5px; vertical-align: -1px; }
  /* 1.99dy: settled market - the result banner, the viewer's result card, the settlement in the trade history */
  .mk .settled { border: 2px solid var(--oc, #888); background: #121212; border-radius: 12px; padding: 14px 16px; margin: 16px 0; overflow-wrap: anywhere; }
  .mk .settled .s-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }
  .mk .settled .s-out { font-size: 28px; font-weight: bold; letter-spacing: .5px; color: var(--oc, #fff); line-height: 1.15; }
  .mk .settled .s-out small { font-size: 14px; color: #aaa; font-weight: normal; letter-spacing: 0; }
  .mk .settled .s-meta { color: #bbb; font-size: 13px; }
  .mk .settled .s-rule { margin: 10px 0 0; font-size: 15px; color: #eee; }
  .mk .settled .s-why { margin: 10px 0 0; padding: 8px 10px; background: #0d0d0d; border-left: 3px solid #3a4a7a; border-radius: 4px; font-size: 13px; color: #ccc; }
  .mk .settled .s-why a { white-space: nowrap; }
  .mk .s-stats { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 10px; font-size: 13px; color: #999; }
  .mk .s-stats b { display: block; font-size: 18px; color: #fff; font-variant-numeric: tabular-nums; }
  .mk .myres { border-radius: 12px; padding: 14px 16px; margin: 16px 0; border: 1px solid #333; background: #111; }
  .mk .myres.won { border-color: #ffd700; background: #1d1a08; }
  .mk .myres.lost { border-color: #7a3a3a; background: #1c1010; }
  .mk .myres.refunded { border-color: #666; }
  .mk .myres .m-head { font-size: 22px; font-weight: bold; }
  .mk .myres .m-nums { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 8px; font-size: 13px; color: #999; }
  .mk .myres .m-nums b { display: block; font-size: 20px; color: #fff; font-variant-numeric: tabular-nums; }
  .mk .myres .m-nums b.up { color: #81c784; } .mk .myres .m-nums b.down { color: #e57373; }
  .mk .myres .m-rows { margin-top: 8px; font-size: 13px; color: #bbb; }
  .mk tr.settle-ev td { background: #1a1708; color: #ffe082; border-bottom: 1px solid #4a3f10; font-weight: bold; white-space: normal; }
  .mk tr.settle-ev.void td { background: #161616; color: #ccc; border-bottom-color: #333; }
  .mk tr.payout td { background: #121208; }
  .mk tr.payout td.pay { color: #ffd700; white-space: nowrap; }
  .mk tr.settle-ord td { background: #121208; color: #ffe082; }
</style>
<%
  const COLORS = ['#4caf50', '#e57373', '#64b5f6', '#ffd54f', '#ba68c8', '#4dd0e1', '#ff8a65', '#aed581'];
  const pc = (p) => (p * 100).toFixed(p >= 0.995 || p <= 0.005 ? 1 : 0) + '%';
  const fmt = (n) => Math.round(n).toLocaleString();
  const when = (ts) => ts ? new Date(ts * 1000).toISOString().slice(0, 16).replace('T', ' ') : '';
  // 1.99dt: E escapes; \u0001 in an escaped status line marks where the linked "(by <who>)" goes
  const E = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const byWho = () => (m && m.settled_by ? ' (by ' + ul(m.settled_by) + ')' : '');
  const judgeOk = typeof judgeMe !== 'undefined' && judgeMe && m && (m.status === 'open' || m.status === 'closed');
  // 1.99dy: adaptive price precision (0.00415, not 0.004 / 0.000) - markets.fmtPrice, passed in by the route
  const fp = typeof fmtPrice === 'function' ? fmtPrice : (x) => Number(x).toFixed(3);
  const S = m && m.shares ? m.settle : null;
  const sIdx = S && S.kind === 'won' ? m.options.findIndex((o) => o.name === S.result) : -1;
  const sColor = sIdx >= 0 ? (m.options.length === 2 && /^no$/i.test(S.result) ? '#e57373' : m.options.length === 2 && /^yes$/i.test(S.result) ? '#4caf50' : COLORS[sIdx % COLORS.length]) : '#9e9e9e';
  const sBy = () => S && S.byAi ? '🤖 Pepe (AI judge)' : S && S.by ? ul(S.by) : 'the judge';
  const sWhen = S && S.at ? when(S.at) + ' UTC' : '';
  const sPaid = S ? (S.kind === 'void' ? 'refunded ' : '') + fmt(S.paid || 0) + ' PAT ' + (S.kind === 'void' ? 'to ' : 'paid to ') + S.winners + ' holder' + (S.winners === 1 ? '' : 's') : '';
%>
<div class="mk">
  <p><a href="/markets">‹ All markets</a></p>
  <% if (!m) { %>
    <h1>Market not found</h1>
    <p class="info">It may have been settled more than 60 days ago.</p>
  <% } else if (m.shares) { %>
    <h1><span class="ref"><%= m.ref %></span> <%= m.question %></h1>
    <% if (S) { %>
      <div class="settled <%= S.kind %>" id="settlement" style="--oc: <%= sColor %>">
        <div class="s-top">
          <div class="s-out"><% if (S.kind === 'won') { %>⚖ Resolved: <%= S.result.toUpperCase() %><% } else { %>⚖ Voided <small>— holders refunded</small><% } %></div>
          <div class="s-meta">judged by <%- sBy() %><%= sWhen ? ' · settled ' + sWhen : '' %></div>
        </div>
        <p class="s-rule"><% if (S.kind === 'won') { %>Each <b><%= S.result %></b> share paid <b>1 PAT</b>; <%= m.options.filter((o) => !o.won).map((o) => o.name).join(' / ') %> shares are worth 0.<% } else { %><%= S.reason ? 'Reason: ' + S.reason + '. ' : '' %>Trading fees are kept; holders got back what they put in (net of the 2% fee)<%= S.ratio < 1 ? ', scaled to ' + (S.ratio * 100).toFixed(0) + '% because the pot after the Reserve\'s seed couldn\'t cover it all' : '' %>.<% } %></p>
        <% if (S.why) { %>
          <p class="s-why">🤖 <%= S.why %> <a href="#judgement">Full judgement ›</a></p>
        <% } %>
        <div class="s-stats">
          <span><b><%= fmt(S.paid || 0) %></b><%= S.kind === 'void' ? 'PAT refunded' : 'PAT paid out' %></span>
          <span><b><%= S.winners %></b><%= S.kind === 'void' ? 'holder' + (S.winners === 1 ? '' : 's') + ' refunded' : 'winning holder' + (S.winners === 1 ? '' : 's') %></span>
          <span><b><%= fmt(m.total) %></b>PAT traded</span>
        </div>
      </div>
      <% if (m.myResult) { const R = m.myResult; %>
        <div class="myres <%= R.state %>" id="my-result">
          <div class="m-head"><%= R.state === 'won' ? (R.pnl >= 0 ? '🏆 You won' : '🏆 Your ' + S.result + ' shares won') : R.state === 'lost' ? 'You lost' : '↩ You were refunded' %></div>
          <div class="m-nums">
            <span><b><%= fmt(R.payout) %> PAT</b><%= R.state === 'refunded' ? (S.approx ? 'refund (≈)' : 'refund') : 'paid to you' %></span>
            <span><b class="<%= R.pnl >= 0 ? 'up' : 'down' %>"><%= (R.pnl >= 0 ? '+' : '−') + fmt(Math.abs(R.pnl)) %><%= R.cost ? ' (' + (R.pnl / R.cost * 100).toFixed(0) + '%)' : '' %></b>net P/L on <%= fmt(R.cost) %> PAT in</span>
          </div>
          <div class="m-rows"><%= R.rows.map((r) => fmt(r.shares) + ' ' + r.option + ' shares → ' + (r.state === 'won' ? 'paid ' + fmt(r.payout) + ' PAT' : r.state === 'lost' ? 'worth 0' : 'refunded ' + fmt(r.payout) + ' PAT')).join(' · ') %> · <a href="#your-position">details</a></div>
        </div>
      <% } %>
    <% } %>
    <div class="info">
      <% if (!S) { %><%- E(m.settle && m.settle.kind === 'won' ? 'Resolved: ' + m.settle.result + '\u0001' + ' — each ' + m.settle.result + ' share paid 1 PAT' + (m.settle.total ? ' (' + fmt(m.settle.total) + ' PAT paid out)' : '')
         : m.settle && m.settle.kind === 'void' ? 'Voided' + (m.settle.reason ? ' (' + m.settle.reason + ')' : '') + ' — holders were refunded' + (m.settle.total != null ? ' ' + fmt(m.settle.total) + ' PAT' : '')
         : m.status === 'open' ? 'Trading open — closes ' + new Date(m.closes * 1000).toUTCString()
         : m.status === 'settled' || m.status === 'resolved' ? 'Resolved: ' + m.result + '\u0001'
         : m.status === 'void' ? 'Voided — holders were refunded'
         : m.status === 'settling' ? 'Paying out…' : 'Trading closed — waiting for the judge').split('\u0001').join(byWho()) %><br><% } %>
      Volume <%= fmt(m.total) %> PAT · <%= m.betCount %> trade<%= m.betCount === 1 ? '' : 's' %> · <%= m.bettors %> holder<%= m.bettors === 1 ? '' : 's' %> · judge <%- ul(m.judge) %> · created by <%- ul(m.creator) %> in <%- padLink(m.room, 'a room') %>
    </div>
    <% const lastTraded = 'last traded ' + m.options.map((o) => Math.round(o.last * 100)).join('/'); %>
    <div class="opts">
      <% m.options.forEach((o, i) => { %>
        <div class="opt <%= o.won ? 'won' : '' %> <%= m.settle ? 'final' : '' %>">
          <div><%= o.won ? '🏆 ' : '' %><b><%= o.name %></b></div>
          <% if (m.settle && m.settle.kind === 'won') { %>
            <div class="bar"><span style="width: <%= o.won ? 100 : 0 %>%; background: <%= o.won ? '#ffd700' : COLORS[i % COLORS.length] %>"></span></div>
            <div class="num"><span class="price"><%= o.won ? '100%' : '0%' %></span> · <%= o.won ? 'paid 1 PAT/share' : 'worth 0' %></div>
          <% } else if (m.settle && m.settle.kind === 'void') { %>
            <div class="bar"><span style="width: <%= (o.last * 100).toFixed(1) %>%; background: #555"></span></div>
            <div class="num">void · refunded</div>
          <% } else { %>
            <div class="bar"><span style="width: <%= (o.price * 100).toFixed(1) %>%; background: <%= o.won ? '#ffd700' : COLORS[i % COLORS.length] %>"></span></div>
            <div class="num"><span class="price"><%= pc(o.price) %></span> · <%= fp(o.price) %> PAT/share</div>
          <% } %>
        </div>
      <% }) %>
      <% if (m.settle) { %><div class="info">Final result<%= m.settle.kind === 'void' ? ' (void)' : '' %> · <%= lastTraded %> before it closed</div><% } %>
    </div>
    <% if (m.history.length > 1) {
      const W = 600, H = 170, t0 = m.history[0][0], t1 = Math.max(m.history[m.history.length - 1][0], t0 + 1);
      const x = (t) => ((t - t0) / (t1 - t0) * W).toFixed(1), y = (p) => (H - p * H).toFixed(1); %>
      <div class="chart">
        <svg viewBox="0 0 <%= W %> <%= H %>" preserveAspectRatio="none" aria-label="Price history">
          <line x1="0" y1="<%= H / 2 %>" x2="<%= W %>" y2="<%= H / 2 %>" stroke="#333" stroke-dasharray="4 4" fill="none" vector-effect="non-scaling-stroke"/>
          <% m.options.forEach((o, i) => { %>
            <polyline fill="none" stroke="<%= COLORS[i % COLORS.length] %>" stroke-width="2" vector-effect="non-scaling-stroke"
              points="<%= m.history.map((h) => x(h[0]) + ',' + y(h[1][o.name] != null ? h[1][o.name] : 0)).join(' ') %>"/>
          <% }) %>
        </svg>
        <div class="legend">
          <% m.options.forEach((o, i) => { %><span><i style="background: <%= COLORS[i % COLORS.length] %>"></i><%= o.name %></span><% }) %>
          <span style="margin-left:auto;color:#888">since <%= when(t0) %> UTC · dashed = 50%</span>
        </div>
      </div>
    <% } %>
    <% if (msg) { %><p class="notice"><%= msg %></p><% } %>
    <%- include('partials/aijudge', { m, kind: 'market', inIt: typeof inIt !== 'undefined' && inIt, judgeMe: typeof judgeMe !== 'undefined' && judgeMe, now }) %>

    <% if (m.mine && m.mine.length && m.settle) { %>
      <h3 id="your-position">Your position</h3>
      <p class="info settled-line"><% if (S.kind === 'won') { %>Settled <b><%= S.result %></b>: <%= S.result %> shares paid 1 PAT each; <%= m.options.filter((o) => !o.won).map((o) => o.name).join(' / ') %> shares are worth 0.<% } else { %>Voided: trading fees are kept, holders got back what they put in (net of the 2% fee)<%= S.ratio < 1 ? ', scaled to ' + (S.ratio * 100).toFixed(0) + '% because the pot after the Reserve\'s seed couldn\'t cover it all' : '' %>.<% } %></p>
      <div class="tbl"><table>
        <tr><th>Outcome</th><th class="r">Shares</th><th class="r">Entry</th><th class="r">Now</th><th class="r">Cost</th><th class="r"><%= S.kind === 'void' ? 'Refund' : 'Value' %></th><th class="r">P/L</th><th>Status</th></tr>
        <% m.mine.forEach((p) => { %>
          <tr class="<%= p.state %>"><td><b><%= p.option %></b></td><td class="r"><%= fmt(p.shares) %></td>
              <td class="r"><%= fp(p.entry) %></td><td class="r"><%= p.price == null ? '—' : p.price === 1 ? '1.000' : '0' %></td>
              <td class="r"><%= fmt(p.cost) %></td>
              <td class="r"><%= p.state === 'won' ? 'Paid ' + fmt(p.payout) + ' PAT' : p.state === 'refunded' ? (S.known ? '' : '≈ ') + 'Refunded ' + fmt(p.payout) + ' PAT' : '0' %></td>
              <td class="r <%= p.pnl >= 0 ? 'up' : 'down' %>"><%= (p.pnl >= 0 ? '+' : '−') + fmt(Math.abs(p.pnl)) %><%= p.cost ? ' (' + (p.pnl / p.cost * 100).toFixed(0) + '%)' : '' %></td>
              <td><%= p.state === 'won' ? '🏆 Won' : p.state === 'lost' ? 'Lost' : 'Refunded' %></td></tr>
        <% }) %>
      </table></div>
    <% } else if (m.mine && m.mine.length) { %>
      <h3>Your position</h3>
      <div class="tbl"><table>
        <tr><th>Outcome</th><th class="r">Shares</th><th class="r">Entry</th><th class="r">Now</th><th class="r">Cost</th><th class="r">Value</th><th class="r">P/L</th><% if (m.status === 'open') { %><th class="r">Sell</th><% } %></tr>
        <% m.mine.forEach((p) => { %>
          <tr><td><b><%= p.option %></b></td><td class="r"><%= fmt(p.shares) %></td>
              <td class="r"><%= fp(p.entry) %></td><td class="r"><%= fp(p.price) %></td>
              <td class="r"><%= fmt(p.cost) %></td><td class="r"><%= fmt(p.value) %></td>
              <td class="r <%= p.pnl >= 0 ? 'up' : 'down' %>"><%= (p.pnl >= 0 ? '+' : '−') + fmt(Math.abs(p.pnl)) %> (<%= p.cost ? (p.pnl / p.cost * 100).toFixed(0) : 0 %>%)</td>
              <% if (m.status === 'open') { %><td class="r">
                <form class="inline" method="post" action="/markets/<%= m.id %>/sell">
                  <input type="hidden" name="option" value="<%= p.option %>">
                  <input type="text" name="shares" value="all" aria-label="Shares to sell" inputmode="decimal">
                  <button class="sell" type="submit">Sell</button>
                </form></td><% } %></tr>
        <% }) %>
      </table></div>
      <p class="info">Entry = what you paid per share, fee included. Value = shares × today's price. A sale returns a bit less, because your own sale moves the price and there's a 2% fee. If your outcome wins, each share pays 1 PAT.</p>
    <% } %>

    <% if (m.status === 'open') { %>
      <% if (user) { %>
        <form class="bet" method="post" action="/markets/<%= m.id %>/bet" id="buy">
          <div class="opts-pick">
            <% m.options.forEach((o, i) => { %>
              <label><input type="radio" name="option" value="<%= o.name %>" <%= i === 0 ? 'checked' : '' %>> <%= o.name %> · <%= pc(o.price) %></label>
            <% }) %>
          </div>
          <div class="row">
            <input type="number" name="amount" min="<%= minBet %>" step="100" placeholder="PAT to spend (min <%= minBet.toLocaleString() %>)" required>
            <button type="submit">Buy shares</button>
            <% if (bal !== null) { %><span class="info">You have <%= bal.toLocaleString() %> PAT</span><% } %>
          </div>
          <p class="info" id="est">Each share pays 1 PAT if its outcome wins. Sell any time before trading closes.</p>
        </form>
        <script>
          (() => {
            const b = <%- JSON.stringify(m.b) %>, q = <%- JSON.stringify(m.q).replace(/</g, '\\u003c') %>, fee = 0.02;
            const f = document.getElementById('buy'), out = document.getElementById('est');
            const upd = () => {
              const opt = (f.querySelector('input[name=option]:checked') || {}).value, spend = Number(f.amount.value) || 0;
              if (!opt || spend <= 0) return;
              const vals = Object.values(q).map((v) => v / b), mx = Math.max(...vals);
              const S = vals.reduce((a, v) => a + Math.exp(v - mx), 0), Ei = Math.exp(q[opt] / b - mx);
              const net = spend * (1 - fee), d = b * Math.log(1 + S * (Math.exp(net / b) - 1) / Ei);
              out.textContent = `≈ ${Math.round(d).toLocaleString()} ${opt} shares at ${(() => { const x = spend / d; return x >= 0.1 ? x.toFixed(3) : String(Number(x.toPrecision(3))); })()} PAT each. They pay ${Math.round(d).toLocaleString()} PAT (+${Math.round(d - spend).toLocaleString()}) if ${opt} wins.`;
            };
            f.addEventListener('input', upd);
          })();
        </script>
      <% } else { %>
        <p class="info"><a href="/login">Sign in</a> to trade here, or in the Camfrog room: <code>!market <%= m.ref %> <%= m.options[0] ? m.options[0].name : 'yes' %> 5k</code></p>
      <% } %>
    <% } %>

    <% if (judgeOk) { %>
      <form class="bet judge" method="post" action="/markets/<%= m.id %>/resolve">
        <b>⚖️ Resolve this market</b>
        <div class="opts-pick">
          <% m.options.forEach((o) => { %><label><input type="radio" name="outcome" value="<%= o.name %>" required> <%= o.name %> won</label><% }) %>
          <label><input type="radio" name="outcome" value="void"> void</label>
        </div>
        <input type="text" name="reason" maxlength="160" placeholder="Reason (required to void)" style="width:100%;box-sizing:border-box">
        <p class="info" style="margin:0">Void: trading fees are kept, the Federal Reserve takes back its seed first, and holders split what's left — up to what they put in.</p>
        <div class="row"><button type="submit">Resolve</button>
          <span class="info">Only the judge (<%- ul(m.judge) %>) or an admin sees this. It pays out at once and can't be undone.</span></div>
      </form>
    <% } %>

    <%- include('partials/actions', { acts: typeof acts !== 'undefined' ? acts : [], msg: null }) %>
    <% if (orders && orders.length) { %>
      <h3>Your website orders</h3>
      <div class="tbl"><table>
        <tr><th>Order</th><th>Outcome</th><th class="r">Amount</th><th>Status</th></tr>
        <% if (S && m.myResult) { const R = m.myResult; %>
          <tr class="settle-ord"><td>settled</td><td><%= S.kind === 'void' ? 'void' : S.result %></td>
              <td class="r"><%= fmt(R.payout) %> PAT</td>
              <td>⚖ <%= R.state === 'won' ? 'paid ' + fmt(R.payout) + ' PAT' : R.state === 'lost' ? 'lost — nothing paid' : 'refunded ' + (S.approx ? '≈ ' : '') + fmt(R.payout) + ' PAT' %> · net <%= (R.pnl >= 0 ? '+' : '−') + fmt(Math.abs(R.pnl)) %> · <%= sWhen %></td></tr>
        <% } %>
        <% orders.forEach((o) => { const k = o.kind || 'buy'; %>
          <tr><td><%= k %></td><td><%= k === 'resolve' ? o.outcome : o.option %></td>
              <td class="r"><%= k === 'buy' ? Number(o.amount).toLocaleString() + ' PAT' : k === 'sell' ? (o.shares || 'all') + ' sh' : '' %></td>
              <td><%= o.status === 'placed' ? '✅ ' + (o.message || 'done') : o.status === 'failed' ? '❌ ' + (o.message || 'failed') : '⏳ waiting for Pepe' %></td></tr>
        <% }) %>
      </table></div>
      <% if (orders.some((o) => o.status === 'pending' || o.status === 'claimed')) { %><script>setTimeout(() => location.replace(location.pathname), 4000)</script><% } %>
    <% } %>

    <h3>Trades</h3>
    <div class="tbl"><table>
      <tr><th>Who</th><th>Side</th><th>Outcome</th><th class="r">Shares</th><th class="r">PAT</th><th class="r">Price</th><th class="r">When (UTC)</th></tr>
      <% if (S) { %>
        <tr class="settle-ev <%= S.kind %>"><td colspan="7">⚖ <%= S.kind === 'void' ? 'Voided' : 'Settled ' + S.result.toUpperCase() %> by <%- sBy() %><%= sWhen ? ' · ' + sWhen : '' %> · <%= sPaid %><%= S.kind === 'won' ? ' (1 PAT per ' + S.result + ' share)' : '' %></td></tr>
        <% S.payouts.slice(0, 50).forEach((p) => { %>
          <tr class="payout"><td><%- ul(p.nick) %></td><td class="pay"><%= S.kind === 'void' ? 'refund' : 'payout' %></td><td><%= p.option || 'void' %></td>
              <td class="r"><%= p.shares == null ? '' : fmt(p.shares) %></td><td class="r pay"><%= S.approx ? '≈ ' : '' %><%= fmt(p.amount) %></td>
              <td class="r"><%= S.kind === 'void' ? '' : '1.000' %></td><td class="r"><%= when(S.at) %></td></tr>
        <% }) %>
        <% if (S.payouts.length > 50) { %><tr class="payout"><td colspan="7" style="color:#888">… and <%= S.payouts.length - 50 %> more</td></tr><% } %>
      <% } %>
      <% m.trades.slice(0, 100).forEach((t) => { %>
        <tr><td><%- ul(t.nick, { web: t.web }) %></td><td class="<%= t.side === 'buy' ? 'up' : 'down' %>"><%= t.side %></td><td><%= t.option %></td>
            <td class="r"><%= fmt(t.shares) %></td><td class="r"><%= fmt(t.pat) %></td>
            <td class="r"><%= t.shares ? fp(t.pat / t.shares) : '' %></td><td class="r"><%= when(t.ts) %></td></tr>
      <% }) %>
      <% if (!m.trades.length && !S) { %><tr><td colspan="7" style="color:#888">No trades yet.</td></tr><% } %>
    </table></div>
  <% } else { %>
    <h1><span class="ref"><%= m.ref %></span> <%= m.question %></h1>
    <div class="info">
      <%- E(m.status === 'open' ? 'Open — closes ' + new Date(m.closes * 1000).toUTCString()
         : m.status === 'settled' ? 'Settled: ' + m.result + '\u0001'
         : m.status === 'void' ? 'Voided — everyone was refunded' : 'Closed — waiting for the judge').split('\u0001').join(byWho()) %><br>
      Pool <%= m.total.toLocaleString() %> PAT · <%= m.betCount %> bet<%= m.betCount === 1 ? '' : 's' %> from <%= m.bettors %> · judge <%- ul(m.judge) %> · created by <%- ul(m.creator) %> in <%- padLink(m.room, 'a room') %>
      · <i><%= m.model === 'pool' ? 'betting pool' : 'pool market (from before share trading)' %></i>
    </div>
    <div class="opts">
      <% m.options.forEach((o) => { %>
        <div class="opt <%= o.won ? 'won' : '' %>">
          <div><%= o.won ? '🏆 ' : '' %><b><%= o.name %></b></div>
          <div class="bar"><span style="width: <%= o.share %>%"></span></div>
          <div class="num"><%= o.share %>% · <%= o.pool.toLocaleString() %> PAT<%= o.mult ? ' · pays ' + o.mult.toFixed(2) + 'x' : '' %></div>
        </div>
      <% }) %>
    </div>
    <% if (msg) { %><p class="notice"><%= msg %></p><% } %>
    <%- include('partials/aijudge', { m, kind: 'pool', inIt: typeof inIt !== 'undefined' && inIt, judgeMe: typeof judgeMe !== 'undefined' && judgeMe, now }) %>
    <% if (m.status === 'open') { %>
      <% if (user) { %>
        <form class="bet" method="post" action="/markets/<%= m.id %>/bet">
          <div class="opts-pick">
            <% m.options.forEach((o, i) => { %>
              <label><input type="radio" name="option" value="<%= o.name %>" <%= i === 0 ? 'checked' : '' %>> <%= o.name %><%= o.mult ? ' · ' + o.mult.toFixed(2) + 'x' : '' %></label>
            <% }) %>
          </div>
          <div class="row">
            <input type="number" name="amount" min="<%= minBet %>" step="100" placeholder="PAT (min <%= minBet.toLocaleString() %>)" required>
            <button type="submit">Place bet</button>
            <% if (bal !== null) { %><span class="info">You have <%= bal.toLocaleString() %> PAT</span><% } %>
          </div>
          <p class="info">Your PAT goes into escrow until the judge settles. Winners split the losing side's pool minus 5%.</p>
        </form>
      <% } else { %>
        <p class="info"><a href="/login">Sign in</a> to bet here, or in the Camfrog room: <code>!market <%= m.ref %> <%= m.options[0] ? m.options[0].name : 'yes' %> 5k</code></p>
      <% } %>
    <% } %>
    <% if (judgeOk) { %>
      <form class="bet judge" method="post" action="/markets/<%= m.id %>/resolve">
        <b>⚖️ Settle this market</b>
        <div class="opts-pick">
          <% m.options.forEach((o) => { %><label><input type="radio" name="outcome" value="<%= o.name %>" required> <%= o.name %> won</label><% }) %>
          <label><input type="radio" name="outcome" value="void"> void (refund every stake in full)</label>
        </div>
        <input type="text" name="reason" maxlength="160" placeholder="Reason (required to void)" style="width:100%;box-sizing:border-box">
        <div class="row"><button type="submit">Settle</button><span class="info">Only the judge (<%- ul(m.judge) %>) or an admin sees this. It pays out at once and can't be undone.</span></div>
      </form>
    <% } %>
    <%- include('partials/actions', { acts: typeof acts !== 'undefined' ? acts : [], msg: null }) %>
    <% if (orders && orders.length) { %>
      <h3>Your website orders</h3>
      <div class="tbl"><table>
        <tr><th>On</th><th class="r">PAT</th><th>Status</th></tr>
        <% orders.forEach((o) => { %>
          <tr><td><%= (o.kind === 'resolve' ? 'settle: ' + o.outcome : o.option) %></td><td class="r"><%= o.kind === 'resolve' ? '' : Number(o.amount).toLocaleString() %></td>
              <td><%= o.status === 'placed' ? '✅ ' + (o.message || 'placed') : o.status === 'failed' ? '❌ ' + (o.message || 'failed') : '⏳ waiting for Pepe' %></td></tr>
        <% }) %>
      </table></div>
      <% if (orders.some((o) => o.status === 'pending' || o.status === 'claimed')) { %><script>setTimeout(() => location.replace(location.pathname), 4000)</script><% } %>
    <% } %>
    <h3>Bets</h3>
    <div class="tbl"><table>
      <tr><th>Who</th><th>On</th><th class="r">PAT</th><th class="r">When (UTC)</th></tr>
      <% (m.bets || []).slice().sort((a, b) => b.ts - a.ts).forEach((b) => { %>
        <tr><td><%- ul(b.nick, { web: b.web }) %></td><td><%= b.option %></td>
            <td class="r"><%= Number(b.amount).toLocaleString() %></td><td class="r"><%= when(b.ts) %></td></tr>
      <% }) %>
      <% if (!(m.bets || []).length) { %><tr><td colspan="4" style="color:#888">No bets yet.</td></tr><% } %>
    </table></div>
  <% } %>
</div>
</body>
</html>
