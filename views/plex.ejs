<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%# /plex — 1.99kp (plexhub.js): the 📼 Plex hub. Requests (mediarequests.js), your requests, your Plex access
    (plexmembers.js / subscriptions.js), 📼 Play from Plex on the Go-live page (medialib.js) and the members' perks.
    Read-only: every action links to its own page. %>
<%- include('layout', { title: title, user: user }) %>
<%- include('partials/plex-css') %>
<style>
  .px .it { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; justify-content: space-between; min-height: 44px; padding: var(--ds-sp-2) 0; border-top: 1px solid var(--ds-line-soft); }
  .px .it:first-of-type { border-top: 0; }
  .px .it .w { min-width: 0; flex: 1 1 240px; overflow-wrap: anywhere; }
  .px .it b { color: #fff; }
  .px .st { font-size: var(--ds-fs-sm); color: var(--ds-text-2); }
  .px .st.ok { color: var(--ds-ok); } .px .st.warn { color: var(--ds-warn); } .px .st.off { color: var(--ds-text-muted); }
  .px .chip { display: inline-flex; align-items: center; padding: 2px 10px; border-radius: var(--ds-r-pill); background: linear-gradient(90deg, #cc7b19, var(--ds-plex)); color: #1a1200; font-size: var(--ds-fs-meta); font-weight: 700; }
  .px ul.perks { margin: 0; padding-inline-start: 20px; display: grid; gap: 6px; font-size: var(--ds-fs-body); line-height: 1.5; }
  .px .rq-row { display: flex; gap: 10px; align-items: center; }
  .px .rq-row img, .px .rq-ph { width: 34px; height: 51px; object-fit: cover; border-radius: var(--ds-r-xs); flex: none; background: #1a1a1a; }
  .px .rq-ph { display: inline-flex; align-items: center; justify-content: center; font-size: 16px; color: var(--ds-text-faint); border: 1px solid #2a2a2a; box-sizing: border-box; }
  .px .pxi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 112px), 1fr)); gap: var(--ds-sp-2); margin-top: var(--ds-sp-2); }
  .px .pxi-it { background: var(--ds-sunken); border: 1px solid var(--ds-line); border-radius: var(--ds-r-md); padding: 6px; cursor: pointer; text-align: start; color: #ddd; font: inherit; display: grid; gap: 4px; align-content: start; min-width: 0; }
  .px .pxi-it:hover { border-color: var(--ds-ac); }
  .px .pxi-it:focus-visible { outline: 2px solid var(--ds-focus); outline-offset: 2px; }
  .px .pxi-it img, .px .pxi-it .pxi-ph { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; border-radius: var(--ds-r-xs); background: #1a1a1a; display: flex; align-items: center; justify-content: center; font-size: 26px; color: var(--ds-text-faint); }
  .px .pxi-it b { font-size: 12.5px; line-height: 1.3; overflow-wrap: anywhere; }
  .px .pxi-it small { color: var(--ds-text-muted); font-size: 11.5px; }
  .px .pxi-form { display: grid; gap: var(--ds-sp-2); border-top: 1px solid var(--ds-line-soft); margin-top: var(--ds-sp-2h); padding-top: var(--ds-sp-2h); }
  .px .pxi-form .row { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2); align-items: center; }
  .px .pxi-form textarea { width: 100%; min-height: 76px; }
  .px .pxi-search { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2); }
  .px .pxi-search input { flex: 1 1 200px; min-width: 0; }
  .px .pxi-mine { list-style: none; margin: var(--ds-sp-2) 0 0; padding: 0; display: grid; gap: var(--ds-sp-2h); }
  .px .pxi-mine li { border-top: 1px solid var(--ds-line-soft); padding-top: var(--ds-sp-2); overflow-wrap: anywhere; }
  .px .pxi-cm { margin: 4px 0 0; margin-inline-start: 12px; font-size: var(--ds-fs-meta); color: #bbb; }
  .px .pxi-msg { min-height: 1.2em; font-size: var(--ds-fs-sm); }
</style>
<%
  const fmt = (n) => t.num(Math.round(Number(n) || 0));
  const d = (ms) => ms ? t.date(Number(ms), { dateStyle: 'medium' }) : '';
  const R_ = requests;
  const live = plex && plex.member;
  const rows = (plex && plex.rows) || [];
  const price_ = (n) => Number(n) > 0 ? t('plex.req.price', { n: fmt(n) }) : t('plex.req.free');
  const stKey_ = (s) => ['submitting', 'pending', 'approved', 'partial', 'available', 'declined', 'failed', 'removed', 'error'].includes(s) ? 'plex.st.' + s : null;
%>
<main class="ds-page pxh px">
  <section class="ds-hero" aria-labelledby="pxH">
    <span class="ds-eyebrow"><%- t('plex.eyebrow') %></span>
    <h1 id="pxH"><%- t('plex.h1') %></h1>
    <p class="ds-lead"><%- t('plex.lead') %></p>
  </section>

  <div class="pxh-grid">
  <section class="ds-card lg" aria-labelledby="pxReqH" id="request">
    <h2 id="pxReqH"><span class="ds-ic" aria-hidden="true">🍿</span><%- t('plex.req.h') %></h2>
    <% if (!R_.on) { %>
      <p class="st off"><%- t('plex.req.off') %></p>
    <% } else { %>
      <p><%- t('plex.req.what') %></p>
      <div class="it"><div class="w"><b><%- t('plex.req.movie') %></b></div><span><%- price_(R_.price.movie) %></span></div>
      <div class="it"><div class="w"><b><%- t('plex.req.show') %></b></div><span><%- price_(R_.price.tv) %></span></div>
      <p class="mut"><%- roles.scout ? t('plex.req.no_limit') : t('plex.req.per_day', { n: R_.perDay }) %><% if (signedIn && (R_.credits.movie || R_.credits.tv)) { %> · <%- t('plex.req.credits', { movie: R_.credits.movie, tv: R_.credits.tv }) %><% } %></p>
    <% } %>
    <% if (roles.scout) { %><p class="st ok"><%- t('plex.req.scout') %></p><% } %>
    <% if (roles.curator) { %><p class="st ok"><%- t('plex.req.curator') %></p><% } %>
    <div class="acts"><a class="bt pri" href="/requests"><%- t('plex.req.go') %></a><% if (manage) { %><a class="bt" href="/plex/manage"><%- t('plex.manage.go') %></a><% } %></div>
  </section>

  <section class="ds-card lg" aria-labelledby="pxMineH" id="mine">
    <h2 id="pxMineH"><span class="ds-ic" aria-hidden="true">📋</span><%- t('plex.mine.h') %></h2>
    <% if (!signedIn) { %>
      <p class="mut"><%- t('plex.mine.signin', { link: '<a href="/login?next=%2Fplex">' + t('nav.signin') + '</a>' }) %></p>
    <% } else if (!R_.mine.length) { %>
      <p class="mut"><%- t('plex.mine.none') %></p>
    <% } else { %>
      <% R_.mine.forEach((r) => { const k_ = stKey_(r.status); %>
      <div class="it"><div class="w rq-row"><% if (r.poster_url) { %><img src="<%= r.poster_url %>" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'rq-ph',textContent:'🎬'}))"><% } else { %><span class="rq-ph" aria-hidden="true"><%= r.type === 'tv' ? '📺' : '🎬' %></span><% } %><span><b><%= r.title %></b><%= r.year ? ' (' + r.year + ')' : '' %> <span class="mut">· <%- r.type === 'tv' ? t('plex.req.show') : t('plex.req.movie') %> · <%= d(r.created) %></span></span></div>
        <span class="pill st-<%= r.status %>"><%- k_ ? t(k_) : r.label %></span>
        <% if (issues.may && (r.status === 'available' || r.status === 'partial')) { %><a class="bt sm" href="#issues" data-pxi-report="<%= r.type %>:<%= r.tmdb %>" data-pxi-title="<%= r.title %>"><%- t('plex.iss.report') %></a><% } %></div>
      <% }) %>
      <div class="acts"><a class="bt" href="/requests#mine"><%- t('plex.mine.all') %></a></div>
    <% } %>
  </section>
  </div>

  <section class="ds-card lg" aria-labelledby="pxIssH" id="issues">
    <h2 id="pxIssH"><span class="ds-ic" aria-hidden="true">🛠️</span><%- t('plex.iss.h') %></h2>
    <p><%- t('plex.iss.what') %></p>
    <% if (!issues.on) { %>
      <p class="st off"><%- t('plex.iss.off') %></p>
    <% } else if (!signedIn) { %>
      <p class="mut"><%- t('plex.iss.signin', { link: '<a href="/login?next=%2Fplex%23issues">' + t('nav.signin') + '</a>' }) %></p>
    <% } else if (!issues.may) { %>
      <p class="mut"><%- t('plex.iss.members', { link: '<a href="/u/' + t.esc(encodeURIComponent(user)) + '/edit#connections">' + t('plex.acc.link') + '</a>' }) %></p>
    <% } else { %>
      <div id="pxi" data-ok="1">
        <form class="pxi-search" id="pxiForm" role="search" autocomplete="off">
          <input type="search" name="q" minlength="2" maxlength="100" placeholder="<%- t('plex.iss.search_ph') %>" aria-label="<%- t('plex.iss.search_ph') %>">
          <button type="submit"><%- t('plex.iss.search') %></button>
        </form>
        <div class="mut" style="margin-top:var(--ds-sp-2)" id="pxiListH"><%- t('plex.iss.recent') %></div>
        <div class="pxi-grid" id="pxiList" aria-live="polite"></div>
        <form class="pxi-form" id="pxiPick" hidden></form>
        <p class="pxi-msg" id="pxiMsg" role="status" aria-live="polite"></p>
        <h3><%- t('plex.iss.mine_h') %></h3>
        <ul class="pxi-mine" id="pxiMine"><li class="mut"><%- t('plex.iss.loading') %></li></ul>
      </div>
    <% } %>
  </section>

  <% if (manage) { %>
  <section class="ds-card lg" aria-labelledby="pxManH" id="manage">
    <h2 id="pxManH"><span class="ds-ic" aria-hidden="true">🎟️</span><%- t('plex.manage.h') %></h2>
    <p><%- t('plex.manage.what') %></p>
    <div class="acts"><a class="bt pri" href="/plex/manage"><%- t('plex.manage.go') %></a></div>
  </section>
  <% } %>

  <section class="ds-card lg" aria-labelledby="pxAccH" id="access">
    <h2 id="pxAccH"><span class="ds-ic" aria-hidden="true">🔑</span><%- t('plex.acc.h') %></h2>
    <% if (!signedIn) { %>
      <p class="mut"><%- t('plex.acc.signin', { link: '<a href="/login?next=%2Fplex">' + t('nav.signin') + '</a>' }) %></p>
    <% } else if (live) { %>
      <p class="st ok"><span class="chip">📼 Plex</span> <%- t('subs.plex_member', { plex: live.username || '?' }) %>
        <%- live.access === 'owner' ? t('subs.plex_owner') : live.access === 'lifetime' ? t('subs.plex_lifetime') : (live.access === 'manual' || live.access === 'pre-existing') ? t('subs.plex_kept') : live.expires ? t('subs.plex_until', { date: d(live.expires) }) : '' %></p>
    <% } else if (rows.some((r) => r.pending)) { %>
      <p class="st warn"><%- t('subs.plex_pending', { plex: rows.find((r) => r.pending).username || '?' }) %></p>
    <% } else if (rows.length) { %>
      <p class="st off"><%- t('subs.plex_linked_off', { plex: rows[0].username || '?' }) %></p>
    <% } else { %>
      <p class="st off"><%- t('subs.plex_none') %></p>
    <% } %>
    <% if (sub && sub.live) { %><p class="mut"><span class="ds-ic" aria-hidden="true">🔁</span> <%- t('plex.acc.sub', { date: d(sub.until) }) %></p><% } %>
    <% if (invites.length) { %>
      <h3><%- t('subs.plex_get_h') %></h3>
      <% invites.forEach((x) => { %>
      <div class="it"><div class="w"><b><%= x.title %></b> <span class="mut">· <%= fmt(x.price) %> PAT<%- x.days ? ' · ' + t('plex.acc.days', { n: x.days }) : ' · ' + t('plex.acc.lifetime') %></span></div>
        <a class="bt" href="/shop/item/<%= encodeURIComponent(x.prize_id) %>"><%- t('subs.view') %></a></div>
      <% }) %>
    <% } else if (!invitesOn) { %>
      <p class="mut"><%- t('plex.acc.no_items') %></p>
    <% } %>
    <div class="acts">
      <% if (signedIn) { %><a class="bt pri" href="/subscriptions#plex"><%- t('plex.acc.manage') %></a><% } %>
      <a class="bt" href="/shop"><%- t('nav.shop') %></a>
      <% if (signedIn) { %><a class="bt" href="/u/<%= encodeURIComponent(user) %>/edit#connections"><%- t('plex.acc.link') %></a><% } %>
    </div>
  </section>

  <div class="pxh-grid">
  <section class="ds-card lg" aria-labelledby="pxPlayH" id="play">
    <h2 id="pxPlayH"><%- t('stage.px.choice') %></h2>
    <p><%- t('plex.play.what') %></p>
    <% if (!library.open) { %>
      <p class="st off"><%- t('plex.play.off') %></p>
    <% } else if (play && play.ok && play.member) { %>
      <p class="st ok"><%- t('plex.play.member', { n: library.freeCap }) %></p>
    <% } else if (play && play.ok && play.free) { %>
      <p class="st ok"><%- t('plex.play.free') %></p>
    <% } else { %>
      <p class="mut"><%- t('plex.play.price', { price: fmt(library.price), n: library.paidCap }) %> <%- t('plex.play.member_free', { n: library.freeCap }) %></p>
    <% } %>
    <div class="acts"><a class="bt pri" href="/stage?mode=plex#srcSet"><%- t('plex.play.go') %></a></div>
  </section>

  <section class="ds-card lg" aria-labelledby="pxPerkH" id="perks">
    <h2 id="pxPerkH"><span class="ds-ic" aria-hidden="true">✨</span><%- t('plex.perks.h') %></h2>
    <ul class="perks">
      <li><%- t('plex.perks.server') %></li>
      <li><%- t('plex.perks.play', { n: library.freeCap }) %></li>
      <% if (perks.flair) { %><li><%- t('plex.perks.flair') %></li><% } %>
      <li><%- t('plex.perks.ach', { link: '<a href="/achievements">' + t('subs.plex_ach_link') + '</a>' }) %></li>
      <% if (perks.sso) { %><li><%- t('plex.perks.sso') %></li><% } %>
    </ul>
  </section>
  </div>
</main>
<% if (issues.on && issues.may) { %><script src="/public/js/plex-issues.js?v=1" defer></script><% } %>
</body>
</html>
