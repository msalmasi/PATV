<%#
  The post composer (1.99bv). Locals: composer (feedweb.composerFor or null when signed out), next (return path)
%><% const cp = composer; %>
<% if (!cp) { %>
  <div class="fc fc-out">✍️ <a href="/login?next=<%= encodeURIComponent(next) %>">Sign in</a> to post to the feed — text, links, pictures, audio or video.</div>
<% } else if (cp.refusal) { %>
  <div class="fc fc-out">✍️ <%= cp.refusal %></div>
<% } else { %>
  <form class="fc" id="fcForm" novalidate data-user="<%= cp.user %>" data-chunk="<%= cp.chunk %>" data-caps="<%= JSON.stringify(cp.caps) %>" data-prices="<%= JSON.stringify(cp.prices) %>" data-max-images="<%= cp.maxImages %>" data-home="<%= cp.room || '' %>">
    <div class="fc-row">
      <input name="title" maxlength="140" placeholder="Title (optional)" aria-label="Title" autocomplete="off">
    </div>
    <textarea name="body" maxlength="5000" rows="3" placeholder="<%= cp.room && /^u\//.test(cp.room) ? 'Post something to your profile…' : cp.room ? 'Post something to this pad…' : 'What\'s going on?' %>" aria-label="Text"></textarea>
    <div class="fc-link hide" id="fcLinkRow">
      <input name="link" type="url" inputmode="url" placeholder="https://… (YouTube and Twitch links play right here)" aria-label="Link" autocomplete="off">
      <div class="fc-pv" id="fcPv" aria-live="polite"></div>
    </div>
    <ul class="fc-files" id="fcFiles" aria-live="polite"></ul>
    <div class="fc-tools">
      <button type="button" class="fc-tool" data-tool="link" aria-label="Add a link">🔗 Link</button>
      <% if (!cp.mediaRefusal) { %>
        <label class="fc-tool">🖼 Picture<input type="file" accept="image/jpeg,image/png,image/gif,image/webp,image/avif,image/heic,image/heif,.heic,.heif" multiple data-kind="image" hidden></label>
        <label class="fc-tool">🔊 Audio<input type="file" accept="audio/*,.mp3,.m4a,.ogg,.opus,.wav,.flac" data-kind="audio" hidden></label>
        <label class="fc-tool">🎬 Video<input type="file" accept="video/mp4,video/quicktime,video/webm,.mp4,.mov,.webm,.mkv" data-kind="video" hidden></label>
      <% } %>
      <label class="fc-tool ck" title="Blurred until someone clicks it"><input type="checkbox" name="nsfw"> 🔞 NSFW</label>
    </div>
    <% if (cp.mediaRefusal) { %><p class="fc-note">📎 <%= cp.mediaRefusal %></p><% } %>
    <%# 1.99ci: every post lives in exactly ONE pad (Reddit-style; Crosspost shares it into others). The picker
        lists the pads this account may post in (the owners' who-can-post settings, bans) and searches them. %>
    <fieldset class="fc-where">
      <legend>Pad</legend>
      <% const sel_ = cp.rooms.find((r) => r.id === cp.room) || null; %>
      <details class="fc-comm"<%= sel_ ? '' : ' data-empty' %>>
        <summary aria-label="Choose a pad"><span class="fc-comm-cur" data-comm-cur><% if (sel_) { %><span class="cbadge sm" style="--h:<%= fx.hue(sel_.slug) %>" aria-hidden="true"><%= fx.cBadge(sel_) %></span><b><%= sel_.title %></b><small><%= sel_.label || 'p/' + sel_.slug %></small><% } else { %><span class="cbadge sm all" aria-hidden="true">?</span><b>Choose a pad</b><% } %></span><%- fx.icon('chevron', 'chev') %></summary>
        <div class="fc-comm-menu" role="radiogroup" aria-label="Pads you can post in">
          <label class="cb-search"><%- fx.icon('search') %><input type="search" placeholder="Search pads" aria-label="Search pads" data-comm-search autocomplete="off"></label>
          <% cp.rooms.forEach((r, i_) => { const lab_ = r.label || 'p/' + r.slug; %>
            <%# 1.99df: "Your profile (u/<username>)" heads the list - only you post there %>
            <label class="fc-comm-it<%= r.profile ? ' is-profile' : '' %>" data-name="<%= (r.title + ' ' + r.slug + ' ' + lab_).toLowerCase() %>"><input type="radio" name="community" value="<%= r.id %>" data-slug="<%= r.slug %>" data-label="<%= lab_ %>" data-title="<%= r.title %>" data-badge="<%= r.profile ? '👤' : fx.cBadge(r) %>" data-hue="<%= fx.hue(r.slug) %>"<%= cp.room === r.id ? ' checked' : '' %>>
              <span class="cbadge sm" style="--h:<%= fx.hue(r.slug) %>" aria-hidden="true"><%= r.profile ? '👤' : fx.cBadge(r) %></span><span class="t"><b><%= r.title %><%= r.profile ? ' (' + lab_ + ')' : '' %></b><small><% if (r.profile) { %>Only you post here · your followers see it<% } else { %><%- fx.padBadge(r, { compact: true }) %> <%= lab_ %> · <%= fx.num(r.followers) %> follower<%= r.followers === 1 ? '' : 's' %><% } %></small></span></label>
            <% if (r.profile && cp.rooms.length > 1) { %><div class="fc-comm-sep" role="separator"></div><% } %>
          <% }) %>
          <p class="cb-none hide" data-comm-none>No pad matches.</p>
        </div>
      </details>
      <% if (cp.roomRefusal) { %><p class="fc-note">✋ <%= cp.roomRefusal %> You can still pick another pad.</p><% } %>
      <%# 1.99cu: the announce checkbox is always there for the picked pad: enabled + ticked when Pepe can announce
          it (pad announcements on - the default for Camfrog pads - and Pepe in the room), otherwise greyed out
          with the reason (owners/admins get a link to switch it on in Moderate) %>
      <% if (cp.rooms.length) { %>
        <div class="fc-anns">
          <% cp.rooms.forEach((r) => { if (r.profile) return; const a_ = r.ann || { ok: !!r.announce, why: 'Announcements are off for this pad' }; %>
            <span class="fc-ann-w<%= cp.room === r.id ? '' : ' hide' %>" data-ann-for="<%= r.id %>">
              <% if (a_.ok) { %>
                <label class="fc-ann" title="Pepe posts a short line in the Camfrog room about new posts (at most one every few minutes)"><input type="checkbox" name="announce" value="<%= r.id %>" checked> 🐸📣 Pepe announces it in the Camfrog room</label>
              <% } else { %>
                <label class="fc-ann off" aria-disabled="true" title="<%= a_.why %>"><input type="checkbox" name="announce" value="<%= r.id %>" disabled> 🐸📣 Pepe announces it in the Camfrog room</label>
                <small class="fc-ann-why" data-ann-code="<%= a_.code || 'off' %>"><%= a_.why %><% if (a_.manage) { %> · <a href="/p/<%= encodeURIComponent(r.slug) %>/settings#announce">turn on in Pad settings</a><% } %></small>
              <% } %>
            </span>
          <% }) %>
        </div>
        <%# 1.99dc: the picked pad's rules (its own, or Padiquette) - one line, follows the picker %>
        <div class="fc-rules-w">
          <% cp.rooms.forEach((r) => { if (r.profile) { %>
            <%# 1.99df: a profile follows Padiquette; "Also show in All" is per post (default on) %>
            <p class="fc-rules<%= cp.room === r.id ? '' : ' hide' %>" data-rules-for="<%= r.id %>">📜 Posting on <b>your profile</b> (<%= r.label %>): it follows <a href="/guidelines" target="_blank" rel="noopener">Padiquette</a>. Your followers see it in Following.</p>
            <label class="fc-inall ck<%= cp.room === r.id ? '' : ' hide' %>" data-rules-for="<%= r.id %>" title="Off: it stays on your profile and in your followers' Following tab, but not in All"><input type="checkbox" name="inAll" checked> 🌐 Also show in All</label>
          <% return; } %>
            <p class="fc-rules<%= cp.room === r.id ? '' : ' hide' %>" data-rules-for="<%= r.id %>">📜 Posting in <b>p/<%= r.slug %></b>: <a href="/p/<%= encodeURIComponent(r.slug) %>#rules" target="_blank" rel="noopener"><% if (r.rules) { %>read its <%= r.rules %> rule<%= r.rules === 1 ? '' : 's' %></a><% } else { %>read the rules</a> (it follows <a href="/guidelines" target="_blank" rel="noopener">Padiquette</a>)<% } %></p>
          <% }) %>
        </div>
      <% } %>
    </fieldset>
    <% if (cp.terms && cp.terms.needed) { %>
      <label class="fc-terms ck"><input type="checkbox" name="acceptTerms" required> I've read and agree to the <a href="/terms" target="_blank" rel="noopener">Terms of Service</a> (I'm 18+). You'll only be asked once.</label>
    <% } else if (cp.terms && cp.terms.enforced) { %><%# 1.99cf: nothing while the Terms aren't enforced (admin switch, default off) %>
      <p class="fc-terms">By posting you agree to the <a href="/terms" target="_blank" rel="noopener">Terms of Service</a>.</p>
    <% } %>
    <div class="fc-send">
      <span class="fc-cost mut" id="fcCost"><%= cp.paid ? '' : 'Posting is free.' %></span>
      <span class="fc-err" id="fcErr" role="alert"></span>
      <button type="submit" class="btn-s" id="fcGo">Post</button>
    </div>
    <p class="fc-note">Pictures up to <%= cp.caps.image %> MB, audio up to <%= cp.caps.audio %> MB (<%= Math.round(cp.caps.audioSecs / 60) %> min), video up to <%= cp.caps.video %> MB (<%= Math.round(cp.caps.videoSecs / 60) %> min). Files are re-encoded and their metadata (camera, GPS location) is removed. iPhone HEIC photos are fine. Your draft is kept on this device until you post it.</p>
  </form>
<% } %>
