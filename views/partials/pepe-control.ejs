<%#
  views/partials/pepe-control.ejs - admin-only Pepe control panel (pepecontrol.js), included once at
  the bottom of the homepage. Emits NOTHING unless the viewer's account (fresh from the DB) is Admin;
  the API checks the role again on every call.
%><% if (typeof me !== 'undefined' && me && me.class === 'Admin' && typeof pepeCtlCsrf === 'function') { %>
<style>
  .pc { --pc-bg: #0b0d0c; --pc-line: #232a26; --pc-muted: #8a948e; --pc-ok: #4caf50; --pc-warn: #ffb74d; --pc-bad: #ef5350;
        background: var(--pc-bg); border: 1px solid var(--pc-line); border-radius: 14px; color: #e6e6e6; font-family: Ubuntu, sans-serif; min-width: 0; }
  .pc > summary { list-style: none; cursor: pointer; padding: 12px 16px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .pc > summary::-webkit-details-marker { display: none; }
  .pc > summary:focus-visible { outline: 2px solid var(--pc-ok); outline-offset: 2px; border-radius: 14px; }
  .pc .pc-t { font-family: 'Press Start 2P', monospace; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: #ffd700; }
  .pc .pc-chev { margin-left: auto; color: var(--pc-muted); font-size: 12px; }
  .pc[open] .pc-chev::after { content: 'hide'; } .pc:not([open]) .pc-chev::after { content: 'show'; }
  .pc .pc-dot { width: 9px; height: 9px; border-radius: 50%; background: #555; display: inline-block; flex: none; }
  .pc .pc-dot.ok { background: var(--pc-ok); box-shadow: 0 0 6px var(--pc-ok); } .pc .pc-dot.bad { background: var(--pc-bad); } .pc .pc-dot.warn { background: var(--pc-warn); }
  .pc .pc-sum { font-size: 13px; color: var(--pc-muted); }
  .pc .pc-body { padding: 0 16px 16px; display: grid; gap: 14px; }
  .pc .pc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 8px; }
  .pc .pc-kv { background: #121614; border: 1px solid var(--pc-line); border-radius: 10px; padding: 8px 10px; min-width: 0; }
  .pc .pc-kv b { display: block; font-size: 11px; color: var(--pc-muted); font-weight: normal; text-transform: uppercase; letter-spacing: .05em; }
  .pc .pc-kv span { display: block; font-size: 14px; margin-top: 2px; overflow-wrap: anywhere; }
  .pc .pc-act { display: grid; gap: 10px; }
  .pc .pc-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .pc .pc-seg { display: inline-flex; border: 1px solid var(--pc-line); border-radius: 9px; overflow: hidden; }
  .pc .pc-seg label { padding: 7px 12px; font-size: 13px; cursor: pointer; color: #ccc; }
  .pc .pc-seg input { position: absolute; opacity: 0; pointer-events: none; }
  .pc .pc-seg input:checked + span { color: #fff; }
  .pc .pc-seg label:has(input:checked) { background: #1d2a21; color: #fff; }
  .pc .pc-seg label:has(input:focus-visible) { outline: 2px solid var(--pc-ok); outline-offset: -2px; }
  .pc button { font: inherit; font-size: 14px; font-weight: bold; padding: 9px 14px; border-radius: 9px; border: 1px solid #2f3a33; background: #18201b; color: #e6e6e6; cursor: pointer; }
  .pc button:hover:not([disabled]), .pc button:focus-visible { border-color: var(--pc-ok); }
  .pc button[disabled] { opacity: .5; cursor: not-allowed; }
  .pc button.pc-danger { background: #5a1414; border-color: #8b2323; color: #fff; }
  .pc button.pc-danger:hover:not([disabled]) { border-color: #ff7b7b; }
  .pc .pc-confirm { border: 1px solid #6b2a2a; background: #170d0d; border-radius: 12px; padding: 12px; display: grid; gap: 10px; }
  .pc .pc-confirm[hidden], .pc [hidden] { display: none !important; }
  .pc .pc-confirm input[type=password] { font: inherit; font-size: 16px; padding: 9px 11px; border-radius: 9px; border: 1px solid #3a3a3a; background: #0f0f0f; color: #eee; width: 100%; max-width: 320px; }
  .pc .pc-msg { font-size: 13.5px; padding: 8px 10px; border-radius: 9px; background: #121614; border: 1px solid var(--pc-line); }
  .pc .pc-msg.err { border-color: #7a2222; color: #ffb4b4; } .pc .pc-msg.ok { border-color: #2e6b31; color: #b9f6ca; } .pc .pc-msg.run { border-color: #7a5a1a; color: #ffe0a3; }
  .pc .pc-muted { color: var(--pc-muted); font-size: 12.5px; }
  .pc h3 { margin: 0 0 6px; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--pc-muted); }
  .pc .pc-log { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .pc .pc-log td, .pc .pc-log th { text-align: left; padding: 5px 6px; border-top: 1px solid var(--pc-line); vertical-align: top; }
  .pc .pc-log th { color: var(--pc-muted); font-weight: normal; }
  .pc .pc-logwrap { overflow-x: auto; max-height: 260px; overflow-y: auto; }
  /* Pepe's look (1.99bv) */
  .pc .pl { border: 1px solid var(--pc-line); border-radius: 12px; padding: 12px; display: grid; gap: 12px; background: #0e1210; min-width: 0; }
  .pc .pl-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .pc .pl-head h3 { margin: 0; }
  .pc .pl-off { font-size: 12px; font-weight: bold; color: var(--pc-bad); border: 1px solid #7a2222; border-radius: 999px; padding: 2px 9px; }
  .pc .pl-now { display: flex; flex-wrap: wrap; gap: 6px; }
  .pc .pl-chip { font-size: 12.5px; padding: 4px 9px; border-radius: 999px; background: #121614; border: 1px solid var(--pc-line); color: #ccc; }
  .pc .pl-chip b { color: var(--pc-muted); font-weight: normal; margin-right: 4px; }
  .pc .pl-chip.on { border-color: #2e6b31; color: #b9f6ca; }
  .pc .pl-lab { font-size: 11px; color: var(--pc-muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 6px; }
  .pc .pl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(86px, 1fr)); gap: 8px; }
  .pc .pl-c { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 6px 4px 7px; font-size: 11.5px; font-weight: normal; line-height: 1.2; min-width: 0; text-align: center; }
  .pc .pl-c .pl-img { width: 60px; height: 60px; display: grid; place-items: center; background: radial-gradient(circle at 50% 45%, #1f3324, #121614 70%); border-radius: 8px; color: var(--pc-muted); font-size: 22px; }
  .pc .pl-c img { width: 60px; height: 60px; image-rendering: pixelated; display: block; }
  .pc .pl-c span.n { overflow-wrap: anywhere; }
  .pc .pl-row { display: flex; flex-wrap: wrap; gap: 6px; }
  .pc .pl-p { font-size: 12.5px; font-weight: normal; padding: 6px 10px; }
  .pc .pl-p small { color: var(--pc-muted); margin-left: 4px; }
  .pc button[aria-pressed=true] { border-color: var(--pc-ok); background: #1d2a21; color: #fff; box-shadow: inset 0 0 0 1px var(--pc-ok); }
  .pc .pl-tog { font-size: 13px; font-weight: normal; }
  .pc .pl-hist { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: 12.5px; }
  .pc .pl-hist li { border-top: 1px solid var(--pc-line); padding-top: 4px; overflow-wrap: anywhere; }
  .pc .pl-hist .st-failed { color: #ffb4b4; } .pc .pl-hist .st-done { color: #b9f6ca; } .pc .pl-hist .st-run { color: #ffe0a3; }
  @media (max-width: 560px) {
    .pc .pl-grid { grid-template-columns: repeat(auto-fill, minmax(74px, 1fr)); }
    .pc .pl-c .pl-img, .pc .pl-c img { width: 50px; height: 50px; }
  }
  @media (max-width: 560px) {
    .pc .pc-log thead { display: none; }
    .pc .pc-log tr { display: grid; grid-template-columns: 1fr auto; border-top: 1px solid var(--pc-line); padding: 4px 0; }
    .pc .pc-log td { border: 0; padding: 2px 4px; }
    .pc .pc-log td.r { grid-column: 1 / -1; }
    .pc .pc-row button { flex: 1 1 100%; }
  }
</style>
<details class="pc" id="pepeCtl" data-csrf="<%= pepeCtlCsrf(me.username) %>">
  <summary><span class="pc-dot" id="pcDot" aria-hidden="true"></span><span class="pc-t">Pepe control panel</span><span class="pc-sum" id="pcSum">admin only</span><span class="pc-chev" aria-hidden="true"></span></summary>
  <div class="pc-body">
    <div class="pc-grid" id="pcGrid" aria-live="polite"><div class="pc-kv"><b>Status</b><span>loading…</span></div></div>
    <div class="pc-act">
      <div class="pc-row">
        <span class="pc-muted">When:</span>
        <div class="pc-seg" role="radiogroup" aria-label="When to restart">
          <label><input type="radio" name="pcMode" value="games" checked><span>Between games (safe)</span></label>
          <label><input type="radio" name="pcMode" value="now"><span>Force now</span></label>
        </div>
      </div>
      <div class="pc-row">
        <button type="button" data-kind="pepe" class="pc-go">Restart Pepe…</button>
        <button type="button" data-kind="full" class="pc-go">Restart Camfrog + Pepe…</button>
      </div>
      <div class="pc-confirm" id="pcConfirm" hidden>
        <div><b id="pcWhat"></b><div class="pc-muted">Runs on the VM supervisor, so it works even if Pepe is hung. Pepe posts a notice in his rooms first when he can.</div></div>
        <label class="pc-muted" for="pcPw">Confirm with your account password</label>
        <input type="password" id="pcPw" autocomplete="current-password" maxlength="200">
        <div class="pc-row"><button type="button" class="pc-danger" id="pcYes">Yes, restart</button><button type="button" id="pcNo">Cancel</button></div>
      </div>
      <div class="pc-msg" id="pcMsg" hidden role="status"></div>
      <div class="pc-muted" id="pcRate"></div>
    </div>
    <section class="pl" id="plBox" aria-labelledby="plTitle">
      <div class="pl-head"><h3 id="plTitle">Pepe's look</h3><span class="pl-off" id="plOff" hidden>Pepe offline</span></div>
      <div class="pl-now" id="plNow" aria-live="polite"><span class="pl-chip">loading…</span></div>
      <div><div class="pl-lab" id="plCosLab">Costume</div><div class="pl-grid" id="plCostumes" role="group" aria-labelledby="plCosLab"></div></div>
      <div><div class="pl-lab" id="plPerLab">Persona</div><div class="pl-row" id="plPersonas" role="group" aria-labelledby="plPerLab"></div></div>
      <div class="pl-row">
        <button type="button" class="pl-tog" id="plVoice" aria-pressed="false">Persona voice</button>
        <button type="button" class="pl-tog" id="plLink" aria-pressed="false">Costume ↔ persona linked</button>
        <button type="button" class="pl-tog" id="plReset">Reset to default</button>
      </div>
      <div class="pc-msg" id="plMsg" hidden role="status"></div>
      <div class="pc-muted">Each change runs the admin chat command through Pepe as you (<code>!costume</code>, <code>!persona</code>, <code>!avatar reset</code>). No password needed; it's logged below.</div>
      <div><div class="pl-lab">Recent look changes</div><ul class="pl-hist" id="plHist"></ul></div>
    </section>
    <div>
      <h3>Audit log</h3>
      <div class="pc-logwrap"><table class="pc-log"><thead><tr><th>When</th><th>Admin</th><th>Event</th><th>IP hash</th></tr></thead><tbody id="pcLog"></tbody></table></div>
    </div>
  </div>
</details>
<script>
(function () {
  'use strict';
  var box = document.getElementById('pepeCtl');
  if (!box) return;
  var csrf = box.getAttribute('data-csrf');
  var $ = function (id) { return document.getElementById(id); };
  var timer = null, pending = null, nonce = null, lastActive = null, watching = null;
  function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
  function ago(ms) { if (!ms) return '—'; var s = Math.max(0, Math.round((Date.now() - ms) / 1000)); return s < 60 ? s + 's ago' : s < 5400 ? Math.round(s / 60) + 'm ago' : s < 172800 ? Math.round(s / 3600) + 'h ago' : Math.round(s / 86400) + 'd ago'; }
  function dur(sec) { if (sec == null || !isFinite(sec)) return '—'; sec = Math.max(0, Math.round(sec)); var d = Math.floor(sec / 86400), h = Math.floor(sec % 86400 / 3600), m = Math.floor(sec % 3600 / 60); return d ? d + 'd ' + h + 'h' : h ? h + 'h ' + m + 'm' : m + 'm ' + (sec % 60) + 's'; }
  function when(ms) { if (!ms) return '—'; var d = new Date(ms); return d.toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }); }
  function api(path, body) {
    var o = { credentials: 'same-origin', cache: 'no-store', headers: { 'x-csrf-token': csrf } };
    if (body) { o.method = 'POST'; o.headers['Content-Type'] = 'application/json'; o.body = JSON.stringify(body); }
    return fetch(path, o).then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok) throw new Error(j.error || ('HTTP ' + r.status)); return j; }); });
  }
  function msg(text, cls) { var m = $('pcMsg'); if (!text) { m.hidden = true; return; } m.hidden = false; m.className = 'pc-msg ' + (cls || ''); m.textContent = text; }
  function kv(k, v) { var d = el('div', 'pc-kv'); d.appendChild(el('b', null, k)); d.appendChild(el('span', null, v)); return d; }
  var STATE = { pending: 'Sent - waiting for the VM to pick it up', claimed: 'Picked up by the VM', accepted: 'Accepted by the VM supervisor', running: 'Restarting', waiting: 'Waiting for the current game to finish', done: 'Done', failed: 'Failed', expired: 'Expired - the VM did not pick it up within 2 minutes', superseded: 'Superseded by a newer restart' };

  function render(d) {
    var s = d.status || {}, p = s.pepe || {}, sup = s.supervisor || {}, dep = s.deploy || {}, cf = s.camfrog || {};
    var pepeUp = d.online && p.running;
    $('pcDot').className = 'pc-dot ' + (!d.online ? 'bad' : pepeUp ? 'ok' : 'warn');
    $('pcSum').textContent = !d.online ? 'VM offline (last seen ' + ago(d.last_seen) + ')' : pepeUp ? 'Pepe online' + (s.version ? ' · v' + s.version : '') : 'VM online · Pepe not running';
    var g = $('pcGrid'); g.textContent = '';
    g.appendChild(kv('VM supervisor', d.online ? 'online · heartbeat ' + ago(d.last_seen) : 'OFFLINE · last heartbeat ' + ago(d.last_seen)));
    g.appendChild(kv('Pepe', !p.pid ? 'not running' : (p.running ? 'running' : 'stopped') + (p.hung ? ' · no output ' + dur(p.silent_s) : '') + ' · pid ' + p.pid));
    g.appendChild(kv('Version', (s.version ? 'v' + s.version : '?') + (s.sha ? ' (' + String(s.sha).slice(0, 7) + ')' : '') + (s.env === 'staging' ? ' · STAGING' : '')));
    g.appendChild(kv('Pepe uptime', p.started ? dur(d.now / 1000 - p.started) : '—'));
    g.appendChild(kv('Camfrog', cf.pid ? 'running' + (cf.hung ? ' · NOT RESPONDING' : '') + (cf.started ? ' · up ' + dur(d.now / 1000 - cf.started) : '') : 'not running'));
    var rooms = (p.rooms || []);
    g.appendChild(kv('Rooms joined', rooms.length ? rooms.join(', ') : (p.live_ts ? 'none' : 'unknown')));
    var busy = (p.busy || []);
    g.appendChild(kv('Games running', busy.length ? busy.join(', ') : 'none'));
    var dtxt = dep.probation ? 'on probation until ' + when(dep.probation.until * 1000) : 'stable';
    if (dep.pending) dtxt += ' · update ' + String(dep.pending.sha || '').slice(0, 7) + ' pending';
    if (dep.current && dep.current.ts) dtxt += ' · deployed ' + ago(dep.current.ts * 1000);
    g.appendChild(kv('Deploy', dtxt));
    var L = d.last;
    g.appendChild(kv('Last restart', L ? (L.username || '?') + ' · ' + ago(L.finished_at || L.created_at) + ' · ' + L.status + (L.detail ? ' (' + L.detail + ')' : '') : (p.start_reason ? p.start_reason : 'none from the website')));
    g.appendChild(kv('Supervisor', sup.started ? 'up ' + dur(d.now / 1000 - sup.started) + (sup.age_s > 30 ? ' · busy ' + dur(sup.age_s) : '') : '—'));

    var a = d.active;
    var lockBtns = !!(a && a.status !== 'waiting');
    document.querySelectorAll('#pepeCtl .pc-go').forEach(function (b) { b.disabled = lockBtns || d.rate.used >= d.rate.max; });
    $('pcRate').textContent = d.rate.used + ' of ' + d.rate.max + ' restarts used in the last ' + d.rate.window_min + ' min.';
    var w = a || (watching && d.commands.find(function (c) { return c.id === watching; }));
    if (w) {
      var t = STATE[w.status] || w.status;
      var cls = w.status === 'done' ? 'ok' : (w.status === 'failed' || w.status === 'expired') ? 'err' : 'run';
      msg((d.kinds[w.kind] || w.kind) + ' (' + (d.modes[w.mode] || w.mode) + '): ' + t + (w.detail ? ' - ' + w.detail : ''), cls);
      if (!a) watching = null;
    }
    lastActive = a;
    var tb = $('pcLog'); tb.textContent = '';
    (d.audit || []).forEach(function (r) {
      var tr = el('tr');
      tr.appendChild(el('td', null, when(r.at)));
      tr.appendChild(el('td', null, r.username || 'VM'));
      tr.appendChild(el('td', 'r', r.action + (r.result ? ': ' + r.result : '')));
      tr.appendChild(el('td', null, r.ip_hash || ''));
      tb.appendChild(tr);
    });
    if (!(d.audit || []).length) { var tr = el('tr'); var td = el('td', 'pc-muted', 'Nothing yet.'); td.colSpan = 4; tr.appendChild(td); tb.appendChild(tr); }
    renderLook(d);
  }

  // ── Pepe's look (1.99bv): goes through Pepe's website-action queue, no password ──
  var look = null, lookBusy = false, lookSig = '';
  function chip(k, v, on) { var c = el('span', 'pl-chip' + (on ? ' on' : '')); c.appendChild(el('b', null, k)); c.appendChild(document.createTextNode(v)); return c; }
  function cosName(c) { return String(c.desc || c.id).split(' — ')[0].replace(/^the /, '').slice(0, 26); }
  function thumb(id, fallback) {
    var w = el('span', 'pl-img'), i = document.createElement('img');
    i.alt = ''; i.loading = 'lazy'; i.width = 60; i.height = 60; i.src = '/public/img/pepe-looks/' + encodeURIComponent(id) + '.png';
    i.addEventListener('error', function () { w.textContent = fallback; });
    w.appendChild(i); return w;
  }
  function lookBtns() { return box.querySelectorAll('#plBox button'); }
  function renderLook(d) {
    look = d.look || null;
    var off = !look;
    $('plOff').hidden = !off;
    var now = $('plNow'); now.textContent = '';
    if (off) {
      now.appendChild(chip('', 'Pepe offline — his look can be changed while he is running.'));
    } else {
      var cos = (look.costumes || []).find(function (c) { return c.id === look.costume; });
      now.appendChild(chip('Costume', look.costume ? (cos ? cosName(cos) : look.costume) : 'none', !!look.costume));
      now.appendChild(chip('Persona', look.persona_name || look.persona || 'Pepe', look.persona && look.persona !== 'pepe'));
      now.appendChild(chip('Voice', !look.persona_voice ? 'persona voices off' : (look.voice || 'room default'), !!look.voice));
      now.appendChild(chip('Link', look.follow_costume ? 'costume ↔ persona' : 'unlinked', !!look.follow_costume));
      if (look.dj) now.appendChild(chip('Auto', 'DJ headphones', true));
      if (look.balaclava) now.appendChild(chip('Auto', 'heist balaclava', true));
      if (look.bottleservice) now.appendChild(chip('Auto', 'bottle service', true));
      if (look.game_look) now.appendChild(chip('Game look', look.game_look, true));
      if (look.overlay_clients != null) now.appendChild(chip('OBS overlay', look.overlay_clients ? look.overlay_clients + ' connected' : 'not connected', look.overlay_clients > 0));
    }
    // costume + persona pickers: rebuilt only when Pepe's lists change (keeps focus between polls)
    var lists = look || d.look_known || {};       // offline: his last known lists, shown disabled
    var sig = JSON.stringify([lists.costumes, lists.personas]);
    if (sig !== lookSig) {
      lookSig = sig;
      var g = $('plCostumes'); g.textContent = '';
      var none = el('button', 'pl-c'); none.type = 'button'; none.setAttribute('data-verb', 'costume'); none.setAttribute('data-value', 'off');
      none.appendChild(thumb('pepe', '🐸')); none.appendChild(el('span', 'n', 'No costume')); none.title = 'Plain Pepe (!costume off)';
      g.appendChild(none);
      (lists.costumes || []).forEach(function (c) {
        var b = el('button', 'pl-c'); b.type = 'button'; b.setAttribute('data-verb', 'costume'); b.setAttribute('data-value', c.id);
        b.title = c.desc || c.id; b.appendChild(thumb(c.id, cosName(c).charAt(0).toUpperCase())); b.appendChild(el('span', 'n', cosName(c)));
        g.appendChild(b);
      });
      var pr = $('plPersonas'); pr.textContent = '';
      (lists.personas || [{ id: 'pepe', name: 'Pepe' }]).forEach(function (p) {
        var b = el('button', 'pl-p'); b.type = 'button'; b.setAttribute('data-verb', 'persona'); b.setAttribute('data-value', p.id);
        b.textContent = p.id === 'pepe' ? 'Plain Pepe' : (p.name || p.id);
        if (p.voice) b.appendChild(el('small', null, 'voice'));
        b.title = p.costume ? 'Linked costume: ' + p.costume : 'No costume of its own';
        pr.appendChild(b);
      });
    }
    box.querySelectorAll('#plCostumes .pl-c').forEach(function (b) {
      var v = b.getAttribute('data-value');
      b.setAttribute('aria-pressed', String(!!look && (v === 'off' ? !look.costume : look.costume === v)));
    });
    box.querySelectorAll('#plPersonas .pl-p').forEach(function (b) { b.setAttribute('aria-pressed', String(!!look && (look.persona || 'pepe') === b.getAttribute('data-value'))); });
    $('plVoice').setAttribute('aria-pressed', String(!!(look && look.persona_voice)));
    $('plVoice').textContent = 'Persona voice: ' + (look ? (look.persona_voice ? 'on' : 'off') : '—');
    $('plLink').setAttribute('aria-pressed', String(!!(look && look.follow_costume)));
    $('plLink').textContent = 'Costume ↔ persona link: ' + (look ? (look.follow_costume ? 'on' : 'off') : '—');
    lookBtns().forEach(function (b) { b.disabled = off || lookBusy; });
    var h = $('plHist'); h.textContent = '';
    (d.looks || []).forEach(function (a) {
      var li = el('li'), st = a.status === 'done' ? 'done' : a.status === 'failed' ? 'failed' : 'run';
      li.appendChild(el('span', 'pc-muted', when(a.created) + ' · ' + (a.username || '?') + ' · '));
      li.appendChild(el('code', null, a.label || 'look'));
      li.appendChild(el('span', 'st-' + st, ' — ' + (st === 'run' ? 'waiting for Pepe' : (a.message || a.status))));
      h.appendChild(li);
    });
    if (!(d.looks || []).length) h.appendChild(el('li', 'pc-muted', 'Nothing yet.'));
  }
  function lmsg(text, cls) { var m = $('plMsg'); if (!text) { m.hidden = true; return; } m.hidden = false; m.className = 'pc-msg ' + (cls || ''); m.textContent = text; }
  function lookSend(verb, value) {
    if (lookBusy || !look) return;
    lookBusy = true; lookBtns().forEach(function (b) { b.disabled = true; });
    var what = verb === 'reset' ? 'Reset to default' : verb + ' ' + value;
    lmsg('Sending to Pepe: ' + what + '…', 'run');
    var tries = 0;
    function done(text, cls) { lookBusy = false; lmsg(text, cls); clearTimeout(timer); load(); }
    function poll(id) {
      api('/api/pepe/control/look/' + id).then(function (j) {
        var a = j.action;
        if (a.status === 'done') return done('Pepe: ' + (a.message || 'done'), 'ok');
        if (a.status === 'failed') return done('Pepe: ' + (a.message || 'that did not work'), 'err');
        if (++tries > 30) return done('Still waiting for Pepe — the result will show under Recent look changes.', 'run');
        lmsg((a.status === 'claimed' ? 'Pepe is on it: ' : 'Waiting for Pepe to pick it up: ') + a.label + '…', 'run');
        setTimeout(function () { poll(id); }, 2000);
      }).catch(function (e) { done(e.message, 'err'); });
    }
    api('/api/pepe/control/look', { verb: verb, value: value || '' })
      .then(function (j) { lmsg('Sent to Pepe: ' + j.action.label + ' — waiting for his answer…', 'run'); poll(j.action.id); })
      .catch(function (e) { done(e.message, 'err'); });
  }
  $('plBox').addEventListener('click', function (e) {
    var b = e.target.closest && e.target.closest('button[data-verb]');
    if (b && !b.disabled) lookSend(b.getAttribute('data-verb'), b.getAttribute('data-value'));
  });
  $('plVoice').addEventListener('click', function () { if (look) lookSend('voice', look.persona_voice ? 'off' : 'on'); });
  $('plLink').addEventListener('click', function () { if (look) lookSend('link', look.follow_costume ? 'off' : 'on'); });
  $('plReset').addEventListener('click', function () { if (look && window.confirm('Reset Pepe\'s look? Costume off, plain Pepe persona, stuck accessories cleared.')) lookSend('reset', ''); });
  function load() {
    timer = null;
    return api('/api/pepe/control/status').then(render).catch(function (e) { $('pcSum').textContent = 'status unavailable: ' + e.message; })
      .then(function () { if (box.open && !document.hidden) timer = setTimeout(load, lastActive || watching ? 2500 : 10000); });
  }
  box.addEventListener('toggle', function () { if (box.open) { if (!timer) load(); } else { clearTimeout(timer); timer = null; cancel(); } });
  document.addEventListener('visibilitychange', function () { if (!document.hidden && box.open && !timer) load(); });

  function mode() { var r = box.querySelector('input[name=pcMode]:checked'); return r ? r.value : 'games'; }
  function cancel() { pending = null; nonce = null; $('pcConfirm').hidden = true; $('pcPw').value = ''; }
  box.querySelectorAll('.pc-go').forEach(function (b) {
    b.addEventListener('click', function () {
      // step 1: arm - fetch a single-use nonce and show the in-page confirm
      pending = { kind: b.getAttribute('data-kind'), mode: mode() };
      $('pcWhat').textContent = (pending.kind === 'full' ? 'Restart Camfrog + Pepe' : 'Restart Pepe') + ' - ' + (pending.mode === 'now' ? 'force now' : 'between games (waits for a running game to finish)');
      $('pcConfirm').hidden = false; msg('');
      api('/api/pepe/control/nonce', {}).then(function (j) { nonce = j.nonce; $('pcPw').focus(); }).catch(function (e) { msg(e.message, 'err'); cancel(); });
    });
  });
  $('pcNo').addEventListener('click', cancel);
  $('pcPw').addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); $('pcYes').click(); } });
  $('pcYes').addEventListener('click', function () {
    // step 2: confirm with the password; the nonce is spent whatever the answer
    if (!pending || !nonce) { msg('Start again.', 'err'); return; }
    var body = { kind: pending.kind, mode: pending.mode, nonce: nonce, password: $('pcPw').value };
    $('pcYes').disabled = true;
    api('/api/pepe/control/command', body).then(function (j) { watching = j.command.id; msg(STATE.pending + ' (expires in 2 min)', 'run'); cancel(); clearTimeout(timer); load(); })
      .catch(function (e) { msg(e.message, 'err'); cancel(); })
      .then(function () { $('pcYes').disabled = false; });
  });
})();
</script>
<% } %>
