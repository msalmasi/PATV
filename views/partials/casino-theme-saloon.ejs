<%# views/partials/casino-theme-saloon.ejs - hand-off 20 (owner 2026-11-04, NL-5): the western saloon's art, original and drawn (inline SVG,
    no image, no font download, nothing fetched). casino-ui.js CZ.theme clones it into a saloon table: .cz-scene behind the felt (a
    dim saloon in silhouette - the back bar with its bottles and mirror, a wagon-wheel lamp, the swinging half-doors, the floor;
    low contrast so the table stays the focus; on phones a wood-panel background instead - public/css/casino-themes.css) and
    .cz-sign, the "Pepe's Saloon" sign in place of the felt's lettering, out of the flow (Hold'em: on the felt between the top
    seats; blackjack: over the top rail; on phones the scene's .cz-wallsign in the table's top row instead - the top seats leave no
    room on a narrow felt). Decoration only: aria-hidden, no pointer events.
    Locals: t (or the English prelude above). %>
<%  // h20 verify (review 4): the sign's words come from the locale (casino.theme_saloon_sign, synced to every language). The English
    // (209 of the 260 units, between the brass studs at 15 / 245) is drawn as it is; a longer translation is set smaller and fitted
    // to 216 units (SVG textLength) so it never runs over the studs. Widths: Georgia bold's advances in hundredths of an em for
    // ASCII 32-126; other letters by case, CJK / Hangul / kana / fullwidth 1 em; + the 1.5 letter-spacing.
    const SIGN_W = [25,38,51,70,64,88,80,27,45,45,48,70,33,38,33,47,70,49,63,62,65,60,65,55,68,65,37,37,70,70,70,55,97,76,76,72,83,72,67,81,91,45,60,82,69,102,
                    84,82,70,82,80,65,68,83,76,113,81,73,69,45,47,45,70,70,50,60,65,53,66,57,39,58,68,35,35,63,34,102,69,64,66,65,52,51,40,68,57,86,59,56,53,50,39,50,70];
    const signText = t('casino.theme_saloon_sign');
    const sign = (function (html) {
      const raw = String(html).replace(/&#(\d+);|&#x([0-9a-f]+);|&(amp|lt|gt|quot|apos);/gi, (m, d, x, n) =>
        d ? String.fromCodePoint(+d) : x ? String.fromCodePoint(parseInt(x, 16)) : { amp: "&", lt: "<", gt: ">", quot: '"', apos: "'" }[n.toLowerCase()]);
      const chars = Array.from(raw);
      let em = 0;
      for (const ch of chars) {
        const c = ch.codePointAt(0);
        em += c >= 32 && c <= 126 ? SIGN_W[c - 32] / 100
          : /[\u1100-\u11ff\u2e80-\u9fff\uac00-\ud7af\uf900-\ufaff\uff00-\uffef]/.test(ch) ? 1
          : ch !== ch.toLowerCase() ? 0.82 : 0.64;
      }
      const w = em * 27 + 1.5 * Math.max(0, chars.length - 1);
      if (w <= 216) return { fs: 27, fit: "" };
      const fs = Math.max(17, Math.min(27, Math.floor((27 * 216) / w)));
      return { fs, fit: ' textLength="216" lengthAdjust="spacingAndGlyphs"' };
    })(signText);
    const signY = Math.round((32 + sign.fs * 0.37) * 10) / 10; %>
