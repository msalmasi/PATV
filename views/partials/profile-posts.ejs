<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<%#
  The profile feed (1.99df; was the 1.99bz Posts panel - layout section "posts", Public / Hidden like the other
  sections: hidden = the server loads nothing for visitors). Reddit's u/ page: full post cards (votes, comments,
  share, crosspost), sorts, and two views - "All posts" (every post they made, in any pad, as before) and
  "Profile" (only what they posted to their own profile, u/<username>). The owner gets the composer with
  "Your profile" picked and the profile's settings (Pepe answering mentions, who's blocked from commenting).
  Query: ?psort ?pt ?pp ?pview (profile). 1.99dv: its page is /u/<username>/posts (the Posts tab - also the default tab of
  /u/<username>); the old /u/<username>/profile#posts lands on the tab.
  Locals: social (feedweb.profileSocial), usernameProfile, displayname, isMe
%><%
  const S_ = social || { posts: [], more: false, sort: 'new', top: 'week', page: 1, view: 'all' };
  const fx_ = S_.fx;
  const base_ = '/u/' + encodeURIComponent(usernameProfile) + '/posts';
  const pq = (o) => {
    const x = Object.assign({ pview: S_.view === 'profile' ? 'profile' : '', psort: S_.sort === 'new' ? '' : S_.sort, pt: fx_ && fx_.TIMED.has(S_.sort) ? S_.top : '', pp: '' }, o);
    if (x.psort === 'new') x.psort = '';
    if (x.pview === 'all') x.pview = '';
    Object.keys(x).forEach((k) => { if (!x[k] || x[k] === 1) delete x[k]; });
    const s = new URLSearchParams(x).toString();
    return base_ + (s ? '?' + s : '');
  };
  const name_ = displayname || usernameProfile;
%>
<link rel="stylesheet" href="/public/css/feed.css?v=17">
<section class="card rf pp" id="posts" aria-labelledby="ppH">
  <%# 1.99du: the owner's composer heads the Posts tab ("Your profile" picked); visitors get the feed %>
  <% if (S_.composer) { %>
    <div class="pp-compose" aria-label="<%- t('profile.posts.compose_aria') %>">
      <%- include('feed-composer', { composer: S_.composer, next: base_, fx: fx_ }) %>
    </div>
  <% } %>
  <h2 id="ppH"><span>📝 <%- t('profile.tab.posts') %> · <span class="pp-u">u/<%= usernameProfile %></span></span><a class="pp-all" href="/feed?by=<%= encodeURIComponent(usernameProfile) %>"><%- t('profile.posts.on_feed') %></a></h2>
  <nav class="pp-views" aria-label="<%- t('profile.posts.which') %>">
    <a class="pp-view<%= S_.view === 'all' ? ' on' : '' %>" href="<%= pq({ pview: 'all', pp: '' }) %>"<%- S_.view === 'all' ? ' aria-current="page"' : '' %>><%- t('profile.posts.all') %></a>
    <a class="pp-view<%= S_.view === 'profile' ? ' on' : '' %>" href="<%= pq({ pview: 'profile', pp: '' }) %>"<%- S_.view === 'profile' ? ' aria-current="page"' : '' %>>👤 <%- t('profile.posts.profile_only') %></a>
  </nav>
  <% if (fx_) { %><%- include('feed-sort', { fx: fx_, sort: S_.sort, top: S_.top, href: (s, t) => pq({ psort: s, pt: t || '', pp: '' }), label: t('profile.posts.sort_label', { name: name_ }), hop: 'u/' + usernameProfile, gallery: S_.gallery || null }) %><% } %>
  <% if (!S_.posts.length) { %>
    <p class="empty"><%- S_.page > 1 ? t('profile.posts.no_more') : isMe ? (S_.view === 'profile' ? t('profile.posts.empty_own_profile') : t('profile.posts.empty_own')) : (S_.view === 'profile' ? t('profile.posts.empty_their_profile', { name: name_ }) : t('profile.posts.empty')) %></p>
  <% } else { %>
    <div class="fd-list">
      <% S_.posts.forEach((p) => { %><%- include('feed-post', { p, fx: fx_, embeds: S_.embeds, host: S_.host, viewer: S_.viewer, modRooms: S_.modRooms, detail: false, ctxRoom: S_.view === 'profile' ? S_.padId : null }) %><% }) %>
    </div>
  <% } %>
  <nav class="fd-pager">
    <% if (S_.page > 1) { %><a href="<%= pq({ pp: S_.page - 1 }) %>"><%- t('profile.posts.newer') %></a><% } %>
    <% if (S_.more) { %><a href="<%= pq({ pp: S_.page + 1 }) %>"><%- t('profile.posts.older') %></a><% } %>
  </nav>
  <% if (S_.settings) { const ST = S_.settings; %>
    <details class="pp-set" id="profile-settings">
      <summary>⚙ <%- t('profile.posts.settings') %></summary>
      <div class="pp-set-b" data-pp-settings data-slug="<%= ST.slug || '' %>">
        <label class="ck"><input type="checkbox" data-pp-pepe<%= ST.pepe ? ' checked' : '' %>> <span>🐸 <%- t('profile.posts.pepe_reply') %></span></label>
        <label class="ck"><input type="checkbox" data-pp-roomgen<%= ST.roomgenOff ? ' checked' : '' %>> <span>✨ <%- t('profile.posts.roomgen') %></span></label>
        <p class="mut"><%- t('profile.posts.rules', { link: '<a href="/guidelines">Padiquette</a>' }) %></p>
        <h3><%- t('profile.posts.bans_h') %></h3>
        <% if (!ST.bans.length) { %><p class="mut"><%- t('profile.posts.nobody') %></p><% } else { %>
          <ul class="pp-bans">
            <% ST.bans.forEach((b) => { %><li><a href="/u/<%= encodeURIComponent(b.username || '') %>"><%= b.username %></a><span class="mut"><%- b.until ? ' ' + t('profile.posts.until', { date: new Date(b.until).toISOString().slice(0, 10) }) : ' · ' + t('profile.posts.for_good_lc') %></span><button type="button" class="btn-g" data-pp-unban="<%= b.userId %>"><%- t('profile.posts.unblock') %></button></li><% }) %>
          </ul>
        <% } %>
        <form class="pp-ban" data-pp-ban novalidate>
          <input name="user" placeholder="<%- t('profile.posts.username') %>" aria-label="<%- t('profile.posts.username_aria') %>" autocomplete="off" maxlength="40">
          <select name="days" aria-label="<%- t('profile.posts.how_long') %>"><option value="1"><%- t('profile.posts.d1') %></option><option value="7"><%- t('profile.posts.w1') %></option><option value="30"><%- t('profile.posts.d30') %></option><option value="0" selected><%- t('profile.posts.for_good') %></option></select>
          <button type="submit" class="btn-s"><%- t('profile.posts.block') %></button>
          <span class="fc-err" role="alert"></span>
        </form>
      </div>
    </details>
  <% } %>
</section>
<style>
  .pf .pp-compose { display: grid; gap: 8px; padding-bottom: 14px; border-bottom: 1px solid #1f1f1f; }
  .pf .pp-compose-h { font-size: 14px; font-weight: bold; color: #cfe8cf; }
  .pf .pp-compose .fc { margin-bottom: 0; }
  .pf .pp h2 { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 0; }
  .pf .pp .pp-u { font-family: Ubuntu, sans-serif; letter-spacing: 0; text-transform: none; color: #9ccc9c; font-size: 12px; }
  .pf .pp .pp-all { font-family: Ubuntu, sans-serif; font-size: 12px; letter-spacing: 0; text-transform: none; }
  .pf .pp-views { display: flex; gap: 6px; flex-wrap: wrap; }
  .pf .pp-view { padding: 5px 12px; border-radius: 999px; border: 1px solid #2b2b2b; background: #151515; color: #ccc !important; font-size: 13px; }
  .pf .pp-view.on { border-color: #4caf50; background: #17301a; color: #e6ffe6 !important; }
  .pf .pp-set { border: 1px solid #262626; border-radius: 12px; background: #0f0f0f; }
  .pf .pp-set > summary { cursor: pointer; padding: 10px 14px; font-size: 14px; color: #ddd; }
  .pf .pp-set-b { padding: 0 14px 14px; display: grid; gap: 10px; font-size: 14px; }
  .pf .pp-set-b h3 { margin: 4px 0 0; font-size: 13px; color: #bbb; }
  .pf .pp-set .ck { display: flex; gap: 8px; align-items: flex-start; }
  .pf .pp-bans { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .pf .pp-bans li { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .pf .pp-bans .btn-g { margin-left: auto; }
  .pf .pp-ban { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .pf .pp-ban input, .pf .pp-ban select { background: #151515; border: 1px solid #2b2b2b; color: #ddd; border-radius: 8px; padding: 6px 10px; font: 14px Ubuntu, sans-serif; min-width: 0; }
  .pf .pp-ban input { flex: 1 1 140px; }
  .pf .pp .mut { color: #888; margin: 0; }
</style>
<% if (S_.settings) { %><script src="/public/js/profile-feed.js?v=2" defer></script><% } %>
<% if (fx_) { %><%- include('feed-js', { viewer: S_.viewer }) %><% } %>
