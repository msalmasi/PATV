<%# views/partials/auth-oauth.ejs - "Continue with Discord / Twitch" (routes /auth/discord, /auth/twitch in
    index.js). Locals: next (safe local path or ""), verb ("Sign in" / "Sign up"). %>
<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<% const q = next ? '?next=' + encodeURIComponent(next) : ''; %>
<div class="au-or" role="separator"><%- t('auth.oauth.or') %></div>
<div class="au-oauths">
  <a class="au-oauth discord" href="/auth/discord<%= q %>">
    <svg viewBox="0 -28.5 256 256" aria-hidden="true" focusable="false"><path fill="#fff" d="M216.856339,16.5966031 C200.285002,8.84328665 182.566144,3.2084988 164.041564,0 C161.766523,4.11318106 159.108624,9.64549908 157.276099,14.0464379 C137.583995,11.0849896 118.072967,11.0849896 98.7430163,14.0464379 C96.9108417,9.64549908 94.1925838,4.11318106 91.8971895,0 C73.3526068,3.2084988 55.6133949,8.86399117 39.0420583,16.6376612 C5.61752293,67.146514 -3.4433191,116.400813 1.08711069,164.955721 C23.2560196,181.510915 44.7403634,191.567697 65.8621325,198.148576 C71.0772151,190.971126 75.7283628,183.341335 79.7352139,175.300261 C72.104019,172.400575 64.7949724,168.822202 57.8887866,164.667963 C59.7209612,163.310589 61.5131304,161.891452 63.2445898,160.431257 C105.36741,180.133187 151.134928,180.133187 192.754523,160.431257 C194.506336,161.891452 196.298154,163.310589 198.110326,164.667963 C191.183787,168.842556 183.854737,172.420929 176.223542,175.320965 C180.230393,183.341335 184.861538,190.991831 190.096624,198.16893 C211.238746,191.588051 232.743023,181.531619 254.911949,164.955721 C260.227747,108.668201 245.831087,59.8662432 216.856339,16.5966031 Z M85.4738752,135.09489 C72.8290281,135.09489 62.4592217,123.290155 62.4592217,108.914901 C62.4592217,94.5396472 72.607595,82.7145587 85.4738752,82.7145587 C98.3405064,82.7145587 108.709962,94.5189427 108.488529,108.914901 C108.508531,123.290155 98.3405064,135.09489 85.4738752,135.09489 Z M170.525237,135.09489 C157.88039,135.09489 147.510584,123.290155 147.510584,108.914901 C147.510584,94.5396472 157.658606,82.7145587 170.525237,82.7145587 C183.391518,82.7145587 193.761324,94.5189427 193.539891,108.914901 C193.539891,123.290155 183.391518,135.09489 170.525237,135.09489 Z"/></svg>
    <span>Discord</span><span class="sr-only"> - <%- verb === 'Sign up' ? t('auth.oauth.signup_discord') : verb === 'Sign in' ? t('auth.oauth.signin_discord') : t.esc(verb) + ' with Discord' %></span>
  </a>
  <a class="au-oauth twitch" href="/auth/twitch<%= q %>">
    <svg viewBox="0 0 2400 2800" aria-hidden="true" focusable="false"><path fill="#fff" d="M500,0L0,500v1800h600v500l500-500h400l900-900V0H500z M2200,1300l-400,400h-400l-350,350v-350H600V200h1600V1300z"/><rect fill="#fff" x="1700" y="550" width="200" height="600"/><rect fill="#fff" x="1150" y="550" width="200" height="600"/></svg>
    <span>Twitch</span><span class="sr-only"> - <%- verb === 'Sign up' ? t('auth.oauth.signup_twitch') : verb === 'Sign in' ? t('auth.oauth.signin_twitch') : t.esc(verb) + ' with Twitch' %></span>
  </a>
  <% if (locals.googleSso) { %><%# 1.99lb: Sign in with Google (googlesso.js - OpenID Connect) %>
  <a class="au-oauth google" href="/auth/google<%= q %>">
    <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
    <span><%- verb === 'Sign up' ? t('auth.oauth.signup_google') : t('auth.oauth.signin_google') %></span>
  </a>
  <% } %>
  <% if (locals.tgSso && tgSso.botId) { %><%# 1.99lb: Sign in with Telegram (telegramsso.js - the official Login Widget's popup; public/js/tg-login.js) %>
  <button type="button" class="au-oauth telegram" data-tg-login data-bot="<%= tgSso.botId %>" data-next="<%= next || '' %>" data-lang="<%= locals.lang || 'en' %>">
    <svg viewBox="0 0 240 240" aria-hidden="true" focusable="false"><path fill="#fff" d="M54 117c35-15 58-25 70-30 33-14 40-16 45-16 1 0 3 0 5 2 1 1 1 2 2 4v6c-2 20-10 69-15 91-2 10-6 13-9 13-8 1-14-5-21-10-12-8-18-12-30-20-13-9-5-14 3-22 2-2 37-34 38-37 0-1 0-2-1-3h-3c-1 0-21 14-60 40-6 4-11 6-15 6-5 0-14-3-21-5-8-3-15-4-14-9 0-2 4-5 10-7z"/></svg>
    <span><%- verb === 'Sign up' ? t('auth.oauth.signup_telegram') : t('auth.oauth.signin_telegram') %></span>
  </button>
  <% } %>
  <% if (locals.plexSso) { %><%# 1.99jr: Sign in with Plex (plexsso.js) %>
  <a class="au-oauth plex" href="/auth/plex<%= q %>">
    <span aria-hidden="true" class="plex-ic">▶</span>
    <span><%- verb === 'Sign up' ? t('auth.oauth.signup_plex') : t('auth.oauth.signin_plex') %></span>
  </a>
  <% } %>
</div>
<p class="au-oauth-note"><%- t('auth.oauth.note') %></p>
<% if (locals.tgSso && tgSso.botId) { %>
<p class="au-oauth-note" data-tg-msg role="status" aria-live="polite" hidden></p>
<script async src="https://telegram.org/js/telegram-widget.js?22"></script>
<script src="/public/js/tg-login.js" defer></script>
<% } %>
