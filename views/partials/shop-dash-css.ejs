<%# 1.99mv: the shop's "my stuff" pages (My orders, an order, the seller dashboard) in the newer look (/shop, /wallet).
    Prefix sd-. Loaded after shop-css; the page wraps in <main class="ds-page sh sd"> (ds-page: width, gutter, 24px section gap).
    1.99pm polish (G5): on the ds tokens - hero = .ds-hero recipe (gold variant), cards 16/16, pill buttons, the .ds-subnav bar. %>
<style>
  .sh.sd { color: var(--ds-text); }
  .sd .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .sd h2 { margin: 0; }
  .sd section.sd-sec { display: grid; gap: var(--ds-sp-3); min-width: 0; scroll-margin-top: 70px; }
  .sd .sd-sec-h { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 12px; }
  .sd .sd-sec-h .muted a, .sd .sd-sec-h a.muted { white-space: nowrap; }
  .sd .sd-sec-h a.muted { color: var(--ds-green-2); display: inline-flex; align-items: center; gap: 4px; min-height: 32px; font-size: var(--ds-fs-sm); text-decoration: none; }
  .sd .sd-sec-h a.muted:hover { text-decoration: underline; }
  .sd .notice, .sd .warn { margin: 0; }
  .sd .links a { min-height: 36px; }

  /* hero (the .ds-hero.gold recipe) */
  .sd .sd-hero { background: radial-gradient(110% 140% at 0% 0%, #2a2208 0%, #111 55%), #111; border: 1px solid var(--ds-line); border-radius: var(--ds-r-2xl);
    padding: var(--ds-sp-6) var(--ds-sp-5) var(--ds-sp-5); display: grid; gap: var(--ds-sp-3); min-width: 0; }
  @media (min-width: 700px) { .sd .sd-hero { padding: var(--ds-sp-8) var(--ds-sp-8) var(--ds-sp-7); } }
  .sd .sd-hero.pink { background: radial-gradient(110% 140% at 0% 0%, #2a0f24 0%, #111 55%), #111; }
  .sd .sd-eyebrow { font: var(--ds-fs-eyebrow)/var(--ds-lh-eyebrow) var(--ds-font-pixel); letter-spacing: var(--ds-ls-eyebrow); text-transform: uppercase; color: var(--ds-gold); margin: 0; }
  .sd .sd-hero h1 { text-align: start; margin: 0; font: 700 var(--ds-fs-display)/var(--ds-lh-display) var(--ds-font); letter-spacing: -.01em; text-wrap: balance; }
  .sd .sd-hero h1 em { font-style: normal; background: var(--ds-gold-text-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .sd .sd-lead { color: var(--ds-text-2); font-size: var(--ds-fs-lead); line-height: var(--ds-lh-lead); margin: 0; max-width: 64ch; }
  .sd .sd-minis { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 130px), 1fr)); gap: var(--ds-sp-2); }
  .sd .sd-mini { background: var(--ds-glass); border: 1px solid #2c2c2c; border-radius: var(--ds-r-md); padding: var(--ds-sp-2h) var(--ds-sp-3); min-width: 0; }
  .sd .sd-card .sd-mini { background: var(--ds-sunken); border-color: var(--ds-line-soft); }
  .sd .sd-mini span { display: block; color: var(--ds-text-muted); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: var(--ds-ls-label); }
  .sd .sd-mini b { display: block; font-size: clamp(17px, 4.4vw, 21px); font-weight: 700; font-variant-numeric: tabular-nums; color: #fff; line-height: 1.25; }
  .sd .sd-mini b small { font-size: 12px; color: #d9c88a; font-weight: 700; white-space: nowrap; }
  .sd .sd-mini b.gold { color: var(--ds-gold-text); } .sd .sd-mini b.green { color: var(--ds-ok); } .sd .sd-mini b.pink { color: #ff9ee0; }
  .sd .sd-mini b.pink small { color: #d9a8c8; }
  .sd .sd-mini em { display: block; color: var(--ds-text-faint); font-size: var(--ds-fs-xs); font-style: normal; }
  .sd .sd-mini.hot { border-color: var(--ds-gold-line); background: rgba(60,45,5,.45); }
  .sd .sd-quick { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2h); }
  .sd .qbtn { display: inline-flex; align-items: center; gap: var(--ds-sp-2); padding: 0 var(--ds-sp-5); min-height: var(--ds-tap); border-radius: var(--ds-r-pill); border: 1px solid var(--ds-line-strong); background: transparent;
    color: var(--ds-text); font: 700 15px/1.1 var(--ds-font); text-decoration: none; transition: border-color var(--ds-dur-1), filter var(--ds-dur-1); }
  .sd .qbtn:hover { border-color: var(--ds-gold); background: rgba(255, 255, 255, .03); }
  .sd .qbtn.gold { background: var(--ds-gold-grad); color: var(--ds-on-gold); border-color: transparent; }
  .sd .qbtn.gold:hover { filter: brightness(1.1); }
  .sd .btn.gold, .sd button.gold { background: var(--ds-gold-grad); color: var(--ds-on-gold); }
  .sd .btn.ghost, .sd button.ghost { background: transparent; color: var(--ds-text); border: 1px solid var(--ds-line-strong); }
  .sd .ds-ic { flex: none; }

  /* section chips (anchors / views) - the .ds-subnav bar, current = gold fill (the shop's look) */
  .sd .sd-subnav { position: sticky; top: 0; z-index: var(--ds-z-sticky); background: rgba(10,10,10,.92); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    border: 1px solid #222; border-radius: var(--ds-r-lg); padding: 6px; display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
  .sd .sd-subnav::-webkit-scrollbar { display: none; }
  .sd .sd-subnav a { flex: none; display: inline-flex; align-items: center; gap: 6px; padding: 0 var(--ds-sp-3h); min-height: 36px; border-radius: var(--ds-r-pill); border: 1px solid #2a2a2a;
    background: #151515; color: #ccc; font-size: var(--ds-fs-meta); font-weight: 500; text-decoration: none; white-space: nowrap; }
  .sd .sd-subnav a:hover { border-color: var(--ds-gold); color: #fff; }
  .sd .sd-subnav a:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .sd .sd-subnav a[aria-current="true"] { background: var(--ds-gold); border-color: var(--ds-gold); color: var(--ds-on-gold); font-weight: 700; }
  .sd .sd-subnav a .n { font-size: 11px; font-weight: 700; opacity: .8; font-variant-numeric: tabular-nums; }
  .sd .sd-subnav a .n.hot { opacity: 1; background: var(--ds-badge); color: #fff; border-radius: var(--ds-r-pill); padding: 0 6px; line-height: 18px; min-width: 18px; text-align: center; }
  @media (pointer: coarse) { .sd .sd-subnav a { min-height: 40px; } }

  /* status badge (the server picks the colour) */
  .sd .sd-badge { --c: #ccc; display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; letter-spacing: var(--ds-ls-chip); text-transform: uppercase;
    padding: 3px 10px; border-radius: var(--ds-r-pill); white-space: nowrap;
    color: var(--c); border: 1px solid color-mix(in srgb, var(--c) 55%, transparent); background: color-mix(in srgb, var(--c) 12%, var(--ds-sunken)); line-height: 1.6; }
  .sd .sd-badge::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--c); flex: none; }
  .sd .sd-badge.live::before { box-shadow: 0 0 0 0 var(--c); animation: sd-pulse 1.8s infinite; }
  @keyframes sd-pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--c) 70%, transparent); } 70% { box-shadow: 0 0 0 6px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }

  /* item art */
  .sd .sd-thumb { position: relative; display: block; width: 100%; aspect-ratio: 4 / 3; border-radius: var(--ds-r-md); overflow: hidden; background: radial-gradient(circle at 50% 42%, #2a2a2a, var(--ds-sunken) 70%);
    border: 1px solid var(--ds-line); flex: none; }
  .sd .sd-thumb img { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; object-fit: cover; display: block; }   /* over the emoji, which shows if it fails */
  .sd .sd-thumb .ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 30px; line-height: 1; font-family: var(--ds-font-emoji); }
  .sd .sd-thumb .ribbon { position: absolute; z-index: 2; inset-inline-end: 4px; bottom: 4px; font-size: 15px; background: rgba(0,0,0,.72); border-radius: var(--ds-r-sm); padding: 1px 5px; line-height: 1.3; }

  /* an order card */
  .sd .sd-list { display: grid; gap: var(--ds-sp-3); }
  .sd .sd-order { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: var(--ds-sp-4); min-width: 0; }
  .sd .sd-order.open { border-color: #4a3f16; }
  .sd .sd-order.bad { border-color: var(--ds-danger-line); }
  .sd .sd-order.gift { border-color: #5a2f52; background: linear-gradient(180deg, #1a0f18 0%, var(--ds-surface) 40%); }
  .sd .sd-ob { display: grid; gap: var(--ds-sp-2h); min-width: 0; align-content: start; }
  .sd .sd-oh { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: flex-start; justify-content: space-between; }
  .sd .sd-oh h3 { margin: 0; font-size: var(--ds-fs-h3); line-height: var(--ds-lh-h3); color: #fff; min-width: 0; }
  .sd .sd-oh h3 a { color: #fff; text-decoration: none; }
  .sd .sd-oh h3 a:hover { text-decoration: underline; }
  .sd .sd-meta { display: flex; flex-wrap: wrap; gap: 2px 12px; color: var(--ds-text-muted); font-size: var(--ds-fs-meta); align-items: baseline; }
  .sd .sd-meta .price { font-size: 15px; color: var(--ds-gold-text); }
  .sd .sd-meta .price small { color: #d9c88a; font-size: .78em; }
  .sd .sd-meta .id { font-family: var(--ds-font-mono); color: var(--ds-text-faint); }
  .sd .sd-gift { display: flex; gap: var(--ds-sp-2h); align-items: flex-start; background: rgba(155,93,229,.1); border: 1px solid #4a2f5a; border-radius: var(--ds-r-lg); padding: var(--ds-sp-2h) var(--ds-sp-3); font-size: var(--ds-fs-sm); color: #f0d7ff; }
  .sd .sd-gift .ic { font-size: 17px; line-height: 1.2; flex: none; font-family: var(--ds-font-emoji); }
  .sd .sd-gift .anon { display: inline-block; font-size: 11.5px; color: #c9b3e6; border: 1px solid #5a3f6e; border-radius: var(--ds-r-pill); padding: 0 7px; margin-inline-start: 4px; white-space: nowrap; }
  .sd .sd-gift q { display: block; color: #e6d6f2; font-style: italic; margin-top: 3px; quotes: "“" "”"; }
  .sd .sd-deliv { font-size: var(--ds-fs-meta); color: var(--ds-ok); display: flex; gap: 6px; align-items: baseline; }
  .sd .sd-note { display: grid; gap: 4px; }
  .sd .sd-note .lbl { color: var(--ds-text-muted); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: var(--ds-ls-label); }
  .sd .pre { margin: 0; }
  .sd .sd-acts { display: grid; gap: var(--ds-sp-2); }
  .sd .sd-acts:empty { display: none; }
  .sd .sd-acts > form, .sd .sd-acts > details { margin: 0; }

  /* progress stepper */
  .sd .sd-steps { list-style: none; margin: 2px 0 0; padding: 0; display: flex; gap: 0; counter-reset: st; font-size: var(--ds-fs-xs); }
  .sd .sd-steps li { flex: 1 1 0; min-width: 0; display: grid; gap: 4px; justify-items: start; color: var(--ds-text-faint); position: relative; padding-top: 16px; }
  .sd .sd-steps li::before { content: ""; position: absolute; inset-inline: 0; top: 4px; height: 3px; background: #2a2a2a; border-radius: 3px; }
  .sd .sd-steps li::after { content: ""; position: absolute; inset-inline-start: 0; top: 0; width: 11px; height: 11px; border-radius: 50%; background: #2a2a2a; border: 2px solid var(--ds-surface); }
  .sd .sd-steps li + li { margin-inline-start: 4px; }
  .sd .sd-steps li.done { color: var(--ds-ok); } .sd .sd-steps li.done::before, .sd .sd-steps li.done::after { background: var(--ds-green); }
  .sd .sd-steps li.cur { color: var(--ds-gold); font-weight: 700; } .sd .sd-steps li.cur::after { background: var(--ds-gold); }
  .sd .sd-steps li.cur::before { background: linear-gradient(90deg, var(--ds-gold) 30%, #2a2a2a 30%); }
  [dir="rtl"] .sd .sd-steps li.cur::before { background: linear-gradient(270deg, var(--ds-gold) 30%, #2a2a2a 30%); }
  .sd .sd-steps li.bad { color: var(--ds-danger); font-weight: 700; } .sd .sd-steps li.bad::before, .sd .sd-steps li.bad::after { background: var(--ds-danger-solid); }
  .sd .sd-steps li.grey { color: var(--ds-text-muted); font-weight: 700; } .sd .sd-steps li.grey::before, .sd .sd-steps li.grey::after { background: #777; }
  .sd .sd-steps small { display: block; color: var(--ds-text-faint); font-weight: 400; font-size: 11px; }

  /* timeline */
  .sd details.sd-more > summary { font-size: var(--ds-fs-meta); color: var(--ds-text-muted); list-style: none; display: inline-flex; gap: 6px; align-items: center; min-height: 32px; }
  .sd details.sd-more > summary:hover { color: #fff; }
  .sd details.sd-more > summary::-webkit-details-marker { display: none; }
  .sd details.sd-more > summary::after { content: "▾"; color: var(--ds-text-faint); }
  .sd details.sd-more[open] > summary::after { content: "▴"; }
  .sd .sd-acts details > summary { min-height: 36px; }

  .sd .tl li { line-height: 1.45; }

  /* empty state (the .ds-empty recipe) */
  .sd .sd-empty { text-align: center; border: 1px dashed var(--ds-line-strong); border-radius: var(--ds-r-xl); padding: var(--ds-sp-6) var(--ds-sp-4); display: grid; gap: 8px; justify-items: center; }
  .sd .sd-empty .big { font-size: 30px; line-height: 1; font-family: var(--ds-font-emoji); }
  .sd .sd-empty b, .sd .sd-empty h1 { color: #ddd; font-size: 15px; margin: 0; }
  .sd .sd-empty p { margin: 0; color: var(--ds-text-muted); font-size: var(--ds-fs-sm); max-width: 46ch; line-height: 1.5; }
  .sd .sd-empty .sd-quick { justify-content: center; margin-top: var(--ds-sp-2); }
  .sd .sd-empty .qbtn { min-height: 36px; padding: 0 var(--ds-sp-3h); font-size: 13.5px; }

  /* cards + tables (seller dashboard) */
  .sd .sd-card { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); display: grid; gap: var(--ds-sp-2h); min-width: 0; }
  .sd .sd-card.gold { border-color: var(--ds-gold-line); background: linear-gradient(180deg, rgba(255, 215, 64, .06), transparent 45%), var(--ds-surface); }
  .sd .sd-card > summary { font-weight: 700; color: var(--ds-gold); font-size: 15px; list-style: none; min-height: 36px; display: flex; align-items: center; gap: 6px; cursor: pointer; }
  .sd .sd-card > summary::-webkit-details-marker { display: none; }
  .sd .sd-card h3 { margin: 0; font-size: var(--ds-fs-h3); color: #fff; }
  .sd .sd-two { display: grid; gap: var(--ds-sp-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); align-items: start; }
  .sd .sd-tbl { border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); background: var(--ds-surface); overflow: hidden; }
  .sd table.sd-t { width: 100%; border-collapse: collapse; font-size: 13.5px; line-height: 1.4; font-variant-numeric: tabular-nums; }
  .sd .sd-t th, .sd .sd-t td { padding: 10px 12px; border-bottom: 1px solid var(--ds-line-soft); text-align: start; vertical-align: middle; overflow-wrap: normal; }
  .sd .sd-t tr:last-child td { border-bottom: 0; }
  .sd .sd-t th { color: var(--ds-text-muted); font-weight: 700; white-space: nowrap; font-size: 11.5px; text-transform: uppercase; letter-spacing: var(--ds-ls-label); background: #151515; }
  .sd .sd-t tbody tr:hover td { background: rgba(255, 255, 255, .02); }
  .sd .sd-t td.r, .sd .sd-t th.r { text-align: end; white-space: nowrap; }
  .sd .sd-t tr.off td { opacity: .6; }
  .sd .sd-t .price { color: var(--ds-gold-text); }
  .sd .sd-t .itm { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 10px; align-items: center; min-width: 0; }
  .sd .sd-t .itm .sd-thumb { border-radius: var(--ds-r-sm); }
  .sd .sd-t .itm .sd-thumb .ph { font-size: 22px; }
  .sd .sd-t .itm a { color: #fff; font-weight: 700; text-decoration: none; overflow-wrap: anywhere; }
  .sd .sd-t .itm a:hover { text-decoration: underline; }
  .sd .sd-t .itm small { display: block; color: var(--ds-text-muted); font-size: var(--ds-fs-xs); }
  .sd .sd-t .acts { display: flex; flex-wrap: nowrap; gap: 6px; justify-content: flex-end; }
  .sd .sd-t .acts form { margin: 0; }
  .sd .sd-t .acts .btn, .sd .sd-t .acts button { padding: 0 var(--ds-sp-3); min-height: 36px; font-size: var(--ds-fs-meta); }
  .sd .sd-t .lowstock { color: #ffb36b; font-weight: 700; } .sd .sd-t .nostock { color: var(--ds-danger-solid); font-weight: 700; }
  .sd .sd-t .review { color: var(--ds-warn-ink); font-size: var(--ds-fs-xs); margin-top: 4px; }
  /* revenue bars */
  .sd .sd-bars { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--ds-sp-2h); }
  .sd .sd-bars li { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 10px; align-items: center; }
  .sd .sd-bars .sd-thumb .ph { font-size: 18px; }
  .sd .sd-bars .nm { font-size: var(--ds-fs-sm); color: #eee; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sd .sd-bars .bar { height: 6px; border-radius: var(--ds-r-pill); background: #1f1f1f; overflow: hidden; margin-top: 5px; }
  .sd .sd-bars .bar i { display: block; height: 100%; border-radius: var(--ds-r-pill); background: var(--ds-gold-grad); }
  .sd .sd-bars .am { text-align: end; font-size: var(--ds-fs-meta); color: var(--ds-text-muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .sd .sd-bars .am b { color: var(--ds-gold-text); display: block; font-size: var(--ds-fs-sm); }
  /* recent orders feed */
  .sd .sd-feed { list-style: none; margin: 0; padding: 0; display: grid; }
  .sd .sd-feed li { display: grid; grid-template-columns: 52px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: var(--ds-sp-2h) 0; border-bottom: 1px solid var(--ds-line-soft); }
  .sd .sd-feed li:last-child { border-bottom: 0; }
  .sd .sd-feed .sd-thumb .ph { font-size: 18px; }
  .sd .sd-feed .tx { min-width: 0; font-size: var(--ds-fs-sm); line-height: 1.35; }
  .sd .sd-feed .tx a { color: #fff; text-decoration: none; }
  .sd .sd-feed .tx a:hover { text-decoration: underline; }
  .sd .sd-feed .tx small { display: block; color: var(--ds-text-muted); font-size: var(--ds-fs-xs); }
  .sd .sd-feed .am { text-align: end; display: grid; gap: 4px; justify-items: end; font-variant-numeric: tabular-nums; }
  .sd .sd-feed .am b { color: var(--ds-gold-text); font-size: var(--ds-fs-sm); white-space: nowrap; }
  /* how it works */
  .sd .sd-how { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: var(--ds-sp-3); }
  .sd .sd-how > div { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); }
  .sd .sd-how b { display: block; color: #fff; font-size: 15px; margin-bottom: 4px; }
  .sd .sd-how p { margin: 0; color: var(--ds-text-muted); font-size: var(--ds-fs-meta); line-height: 1.5; }
  .sd .sd-how .ico { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--ds-r-md); background: #1a1a1a;
    font-size: 18px; line-height: 1; font-family: var(--ds-font-emoji); margin-bottom: var(--ds-sp-2); }
  /* order detail */
  .sd .sd-detail { display: grid; grid-template-columns: minmax(0, 260px) minmax(0, 1fr); gap: var(--ds-sp-6); align-items: start; }
  .sd .sd-detail .sd-thumb { border-radius: var(--ds-r-lg); }
  .sd .sd-detail .sd-thumb .ph { font-size: 64px; }
  .sd .sd-detail h1 { font-size: var(--ds-fs-h1); line-height: var(--ds-lh-h1); }
  .sd .kv { gap: 6px 14px; font-size: var(--ds-fs-sm); }

  @media (max-width: 600px) {
    .sd .sd-order { grid-template-columns: 76px minmax(0, 1fr); gap: var(--ds-sp-3); }
    .sd .sd-thumb .ph { font-size: 24px; }
    .sd .sd-detail { grid-template-columns: minmax(0, 1fr); }
    .sd .sd-subnav { position: static; flex-wrap: wrap; overflow: visible; }
    .sd .sd-detail .sd-thumb { max-width: 260px; }
  }
  @media (max-width: 760px) {
    /* the listings table becomes cards */
    .sd table.sd-t, .sd .sd-t tbody, .sd .sd-t tr, .sd .sd-t td { display: block; width: 100%; }
    .sd .sd-t thead { display: none; }
    .sd .sd-t tr { padding: var(--ds-sp-3); border-bottom: 1px solid var(--ds-line-soft); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px 10px; }
    .sd .sd-t tr:last-child { border-bottom: 0; }
    .sd .sd-t td { border: 0; padding: 0; }
    .sd .sd-t td.full { grid-column: 1 / -1; }
    .sd .sd-t td.r { text-align: start; }
    .sd .sd-t td[data-l]::before { content: attr(data-l); display: block; color: var(--ds-text-muted); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: var(--ds-ls-label); }
