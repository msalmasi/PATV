<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<%#
  The Following tab's own panel (1.99bz): the inbox-notice switch and the viewer's OWN lists (who they
  follow, who follows them) - only ever rendered for the signed-in user themselves. Locals: follow
  ({rooms, people, followers, prefs} from follows.lists + prefs), here
%><% const F_ = follow || { rooms: [], people: [], followers: [], prefs: { notify: false } }; %>
<section class="fl" aria-label="<%- t('feed.fl.aria') %>">
  <label class="fl-notify"><input type="checkbox" data-follow-notify<%= F_.prefs.notify ? ' checked' : '' %>> 🔔 <%- t('feed.fl.notify') %></label>
  <details class="fl-lists">
    <summary><%- t('feed.following') %> <b><%= F_.rooms.length + F_.people.length %></b> · <%- t('feed.fl.followers') %> <b><%= F_.followers.length %></b> <span class="mut"><%- t('feed.fl.only_you') %></span></summary>
    <div class="fl-cols">
      <div>
        <h3><%- t('feed.fl.pads') %></h3>
        <% if (!F_.rooms.length) { %><p class="mut"><%- t('feed.fl.no_pads') %></p><% } %>
        <ul><% F_.rooms.forEach((r) => { %><li><a href="<%= r.href %>"><%= r.label %></a> <%- include('follow-btn', { kind: 'room', id: r.id, following: true, signed: true, next: here, small: true }) %></li><% }) %></ul>
      </div>
      <div>
        <h3><%- t('feed.fl.people') %></h3>
        <% if (!F_.people.length) { %><p class="mut"><%- t('feed.fl.no_people') %></p><% } %>
        <ul><% F_.people.forEach((u) => { %><li><a href="<%= u.href %>"><%= u.label %></a> <%- include('follow-btn', { kind: 'user', id: u.username, following: true, signed: true, next: here, small: true }) %></li><% }) %></ul>
      </div>
      <div>
        <h3><%- t('feed.fl.your_followers') %></h3>
        <% if (!F_.followers.length) { %><p class="mut"><%- t('feed.fl.nobody') %></p><% } %>
        <ul><% F_.followers.forEach((u) => { %><li><a href="<%= u.href %>"><%= u.label %></a></li><% }) %></ul>
      </div>
    </div>
  </details>
</section>
