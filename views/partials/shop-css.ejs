<%# Shared styles for the shop pages (/shop, item, storefront, seller/buyer dashboards, admin). Prefix sh-.
    1.99pm polish (G5): on the ds tokens (docs/design-system.md). The shop's area accent is the loot gold (--ds-ac = gold);
    links stay green. Pages that also carry .ds-page (/shop, item, storefront, orders, seller) take their width, gutter and
    font from it; /shop/admin and /shop/edit keep the legacy .sh box until they are polished. %>
<style>
  .sh { --ds-ac: var(--ds-gold); --ds-ac-2: var(--ds-gold-text); --ds-ac-bg: rgba(255, 207, 64, .12); --ds-ac-line: var(--ds-gold-line); --ds-on-ac: var(--ds-on-gold);
        --sh-on-green: #04150a;   /* the default --ds-on-ac (dark ink on green), kept for the green buttons now --ds-on-ac is gold ink */
        font-family: var(--ds-font); overflow-wrap: anywhere; box-sizing: border-box; color: var(--ds-text); }
  .sh:not(.ds-page) { max-width: 1040px; margin: 0 auto; padding: 0 var(--ds-sp-4) var(--ds-sp-12); }
  .sh *, .sh *::before, .sh *::after { box-sizing: border-box; }
  .sh a { color: var(--ds-green-2); text-underline-offset: 3px; }
  .sh h1 { text-align: center; margin: 10px 0 4px; color: var(--ds-text-strong); }
  /* one section-heading style for every shop page: the pixel heading (.ds-pixel-h) */
  .sh h2 { color: var(--ds-gold); font: var(--ds-fs-pixel-h)/1.6 var(--ds-font-pixel); letter-spacing: var(--ds-ls-pixel-h); text-transform: uppercase; margin: 28px 0 10px; }
  .sh h3 { margin: 14px 0 8px; font-size: var(--ds-fs-h4); color: var(--ds-text); }
  .sh .sub { text-align: center; color: var(--ds-text-muted); font-size: var(--ds-fs-meta); margin: 0 0 14px; }
  .sh .muted { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); }
  .sh .notice { background: var(--ds-ok-bg); border: 1px solid var(--ds-ok-line); border-radius: var(--ds-r-lg); padding: var(--ds-sp-3) var(--ds-sp-3h); margin: 10px 0; color: var(--ds-ok-ink); font-size: var(--ds-fs-sm); }
  .sh .warn { background: var(--ds-gold-bg); border: 1px solid var(--ds-gold-line); border-radius: var(--ds-r-lg); padding: var(--ds-sp-3) var(--ds-sp-3h); color: var(--ds-warn-ink); font-size: var(--ds-fs-sm); margin: 10px 0; }
  .sh .bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; margin: 8px 0 12px; }
  .sh .links { display: flex; flex-wrap: wrap; gap: 6px; }
  .sh .links a, .sh .chip { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; background: #151515; color: #ccc; border-radius: var(--ds-r-pill); padding: 0 var(--ds-sp-3h);
    font-size: var(--ds-fs-meta); text-decoration: none; white-space: nowrap; border: 1px solid #2a2a2a; }
  .sh .links a:hover, .sh a.chip:hover { border-color: var(--ds-ac); color: #fff; }
  .sh .chip.on, .sh .links a.on { background: var(--ds-ac-bg); color: #fff; border-color: var(--ds-ac); }
  .sh .bal { color: var(--ds-gold-text); font-weight: 700; font-variant-numeric: tabular-nums; }
  .sh .box { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); margin: 10px 0; min-width: 0; }
  .sh form { margin: 0; }
  /* fields: beat styles.css's legacy input[type=...] (black text, #ddd border, margins) */
  .sh input[type=text], .sh input[type=number], .sh input[type=url], .sh input[type=search], .sh select, .sh textarea {
    margin: 0; background: var(--ds-sunken); color: #eee; border: 1px solid var(--ds-line-strong); border-radius: var(--ds-r-md); padding: 9px 12px; min-height: 40px;
    width: 100%; max-width: 100%; font: inherit; font-size: 15px; transition: border-color var(--ds-dur-1), box-shadow var(--ds-dur-1); }
  .sh input:hover, .sh select:hover, .sh textarea:hover { border-color: #444; }
  .sh input:focus, .sh select:focus, .sh textarea:focus { outline: none; border-color: var(--ds-ac); box-shadow: 0 0 0 3px var(--ds-ac-bg); }
  .sh input::placeholder, .sh textarea::placeholder { color: #8a8a8a; }
  .sh textarea { min-height: 90px; resize: vertical; line-height: 1.5; }
  .sh input[type=checkbox], .sh input[type=radio] { width: 18px; height: 18px; margin: 0; accent-color: var(--ds-green); flex: none; }
  .sh label { display: grid; gap: 6px; font-size: var(--ds-fs-meta); color: #b9b9b9; min-width: 0; }
  .sh label.check { display: flex; gap: 10px; align-items: center; min-height: 36px; color: var(--ds-text); }
