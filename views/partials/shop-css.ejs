  .sh .thumb { aspect-ratio: 4 / 3; background: var(--ds-sunken) center / cover no-repeat; display: flex; align-items: center; justify-content: center; font-size: 34px; color: var(--ds-line-strong); }
  .sh .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sh .card .body { padding: 10px 12px 12px; display: grid; gap: 4px; flex: 1; align-content: start; }
  .sh .card .t { color: #fff; font-weight: 700; font-size: 14px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .sh .price { color: var(--ds-gold-text); font-weight: 700; font-variant-numeric: tabular-nums; }
  .sh .card .price { font-size: 15px; }
  .sh .card .meta { color: var(--ds-text-muted); font-size: var(--ds-fs-xs); }
  .sh .pill { font-size: 11px; font-weight: 700; padding: 2px 9px; border-radius: var(--ds-r-pill); border: 1px solid currentColor; display: inline-flex; align-items: center; white-space: nowrap; line-height: 1.5; letter-spacing: var(--ds-ls-chip); text-transform: uppercase; }
  .sh .official { color: var(--ds-gold); }
  .sh .oos { color: var(--ds-danger-solid); }
  .sh .pager { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin: 18px 0; }
  .sh .pager a, .sh .pager span { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; padding: 0 12px; border-radius: var(--ds-r-pill);
    border: 1px solid var(--ds-line-strong); background: #151515; color: #ccc; text-decoration: none; font: 700 var(--ds-fs-meta)/1 var(--ds-font); font-variant-numeric: tabular-nums; }
  .sh .pager a:hover { border-color: var(--ds-ac); color: #fff; }
  .sh .pager span.cur { border-color: var(--ds-ac); background: var(--ds-ac-bg); color: #fff; }
  .sh .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px; }
  .sh .stat { background: var(--ds-sunken); border: 1px solid var(--ds-line-soft); border-radius: var(--ds-r-md); padding: var(--ds-sp-2h) var(--ds-sp-3); min-width: 0; }
  .sh .stat span { display: block; color: var(--ds-text-muted); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: var(--ds-ls-label); }
  .sh .stat b { color: #fff; font-size: var(--ds-fs-num); font-variant-numeric: tabular-nums; }
  .sh .stat em { display: block; color: var(--ds-text-muted); font-size: var(--ds-fs-xs); font-style: normal; }
  .sh .list { display: grid; gap: 10px; }
  .sh .item { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-3) var(--ds-sp-4); display: grid; gap: 8px; min-width: 0; }
  .sh .item .top { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: baseline; justify-content: space-between; }
  .sh .item .top b { color: #fff; }
  .sh .kv { display: grid; grid-template-columns: auto 1fr; gap: 3px 10px; font-size: var(--ds-fs-meta); }
  .sh .kv > span { color: var(--ds-text-muted); } .sh .kv > div { color: #ddd; min-width: 0; }
  .sh .pre { white-space: pre-wrap; color: #ddd; font-size: var(--ds-fs-sm); line-height: 1.5; background: var(--ds-sunken); border: 1px solid var(--ds-line-soft); border-radius: var(--ds-r-lg); padding: 10px 12px; }
  .sh .code { font-family: var(--ds-font-mono); }
  .sh .tl { list-style: none; margin: 0; padding: 0; padding-inline-start: 14px; border-inline-start: 2px solid #2a2a2a; display: grid; gap: 8px; font-size: var(--ds-fs-meta); }
  .sh .tl li { position: relative; color: #ccc; }
  .sh .tl li::before { content: ""; position: absolute; inset-inline-start: -20px; top: 5px; width: 10px; height: 10px; border-radius: 50%; background: var(--c, #666); }
  .sh .tl li small { color: var(--ds-text-faint); display: block; }
  .sh details > summary { cursor: pointer; color: var(--ds-green-2); font-size: var(--ds-fs-sm); min-height: 32px; display: flex; align-items: center; gap: 6px; }
  .sh details[open] > summary { margin-bottom: 8px; }
  .sh .seller { display: flex; gap: 12px; align-items: center; min-width: 0; }
  .sh .seller img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px var(--ds-bg), 0 0 0 4px var(--ds-green); flex: none; background: var(--ds-sunken); }
  .sh .tabs { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0 4px; }
  .sh .tabs a { display: inline-flex; align-items: center; min-height: 36px; background: #151515; border: 1px solid #2a2a2a; color: #ccc; border-radius: var(--ds-r-pill); padding: 0 var(--ds-sp-3h); font-size: var(--ds-fs-meta); text-decoration: none; }
  .sh .tabs a:hover { border-color: var(--ds-ac); color: #fff; }
  .sh .status-msg { min-height: 1.4em; font-weight: 700; margin: 6px 0; }
  @media (max-width: 420px) { .sh h2 { font-size: 11px; } .sh .grid { gap: 8px; } }
  @media (prefers-reduced-motion: reduce) { .sh button, .sh .btn, .sh input, .sh select, .sh textarea { transition: none; } }
</style>
