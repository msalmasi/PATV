  .sh button, .sh .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 40px; margin: 0; background: var(--ds-green); color: var(--sh-on-green);
    border: 1px solid transparent; border-radius: var(--ds-r-pill); padding: 0 var(--ds-sp-4); cursor: pointer; font: 700 14px/1.1 var(--ds-font); text-decoration: none; text-align: center;
    transition: filter var(--ds-dur-1), border-color var(--ds-dur-1), background-color var(--ds-dur-1); }
  .sh button:hover, .sh .btn:hover { filter: brightness(1.1); }
  .sh button.alt, .sh .btn.alt { background: #1c1c1f; color: var(--ds-text); border-color: #2c2c2c; }
  .sh button.alt:hover, .sh .btn.alt:hover { background: var(--ds-hover); filter: none; }
  .sh button.bad, .sh .btn.bad { background: var(--ds-danger-fill); color: var(--ds-danger-ink); border-color: var(--ds-danger-line); }
  .sh button:disabled { filter: grayscale(.6) brightness(.7); cursor: not-allowed; }
  .sh a:focus-visible, .sh button:focus-visible, .sh summary:focus-visible { outline: 2px solid var(--ds-focus); outline-offset: 2px; }
  .sh .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
