<%# 1.99lz: the prize shop's storefront look (/shop, /shop/item/:id, a seller's storefront). Prefix st-. Loaded after shop-css.
    1.99pm polish (G5): on the ds tokens; the wrapper is <div class="ds-page wide flow sh st"> (block flow - the sections keep
    their own rhythm below). Same look as 1.99lz/1.99mv: gold-glow hero, gold shelf chips, picture cards. %>
<style>
  .sh.st { color: var(--ds-text); }
  .st .st-hero { position: relative; background: radial-gradient(120% 150% at 0% 0%, #2a2208 0%, #111 55%), #111; border: 1px solid var(--ds-line);
    border-radius: var(--ds-r-2xl); padding: var(--ds-sp-6) var(--ds-sp-5) var(--ds-sp-5); display: grid; gap: var(--ds-sp-4); grid-template-columns: minmax(0, 1fr) auto; align-items: start; overflow: hidden; }
  @media (min-width: 700px) { .st .st-hero { padding: var(--ds-sp-8) var(--ds-sp-8) var(--ds-sp-7); } }
  .st .st-eyebrow { font: var(--ds-fs-eyebrow)/var(--ds-lh-eyebrow) var(--ds-font-pixel); letter-spacing: var(--ds-ls-eyebrow); text-transform: uppercase; color: var(--ds-gold); margin: 0; }
  .st .st-hero h1 { text-align: start; font: 700 var(--ds-fs-display)/var(--ds-lh-display) var(--ds-font); letter-spacing: -.01em; text-wrap: balance; margin: 10px 0 8px; }
  .st .st-hero h1 em { font-style: normal; background: var(--ds-gold-text-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .st .st-lead { color: var(--ds-text-2); font-size: var(--ds-fs-lead); line-height: var(--ds-lh-lead); margin: 0; max-width: 60ch; }
  .st .st-wallet { background: var(--ds-glass); border: 1px solid var(--ds-gold-line); border-radius: var(--ds-r-lg); padding: var(--ds-sp-3) var(--ds-sp-3h); min-width: 220px; display: grid; gap: 6px; }
  .st .st-wallet .lbl { color: var(--ds-text-muted); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: var(--ds-ls-label); }
  .st .st-wallet .bal { font-size: var(--ds-fs-num-lg); line-height: 1.1; }
  .st .st-wallet .bal small { font-size: .5em; color: #d9c88a; font-weight: 700; }
  .st .st-wallet nav { display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .st .st-wallet nav a { font-size: var(--ds-fs-meta); display: inline-flex; align-items: center; gap: 4px; min-height: 32px; }
  .st .st-search { grid-column: 1 / -1; display: flex; gap: 8px; }
  .st .st-search input[type=search] { flex: 1 1 auto; min-width: 0; min-height: var(--ds-tap); font-size: 16px; padding: 10px 16px; border-radius: var(--ds-r-pill); background: var(--ds-sunken); border-color: var(--ds-line-strong); }
  .st .st-search button { min-height: var(--ds-tap); padding: 0 var(--ds-sp-5); flex: none; font-size: 15px; }
  .st .btn.gold, .st button.gold { background: var(--ds-gold-grad); color: var(--ds-on-gold); }
  .st .btn.ghost, .st button.ghost { background: transparent; color: var(--ds-text); border: 1px solid var(--ds-line-strong); }
  .st .btn.ghost:hover, .st button.ghost:hover { border-color: var(--ds-ac); background: rgba(255, 255, 255, .03); filter: none; }
  .st a:focus-visible, .st button:focus-visible, .st summary:focus-visible { outline: 2px solid var(--ds-focus); outline-offset: 2px; }
  .st .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .st > h2 { margin: var(--ds-sp-8) 0 var(--ds-sp-3); }

  /* featured */
  .st .st-feat { display: grid; gap: var(--ds-sp-3); grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); margin: 0 0 6px; }
  .st .st-top { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); background: var(--ds-surface); border: 1px solid #5a4210; border-radius: var(--ds-r-xl); overflow: hidden; min-width: 0; }
  .st .st-top .st-img { aspect-ratio: 4 / 3; align-self: center; border-radius: 0; }   /* the whole picture, never cropped (its corner tag) */
  .st .st-top .st-tb { padding: var(--ds-sp-4); display: grid; gap: 8px; align-content: center; justify-items: start; min-width: 0; }
  .st .st-top h3 { margin: 0; font-size: 21px; line-height: 1.2; }
  .st .st-top h3 a { color: #fff; text-decoration: none; }
  .st .st-top .desc { color: var(--ds-text-2); font-size: var(--ds-fs-sm); line-height: 1.45; margin: 0; }
  .st .st-top .btn { min-height: var(--ds-tap); padding: 0 var(--ds-sp-5); font-size: 15px; }
  .st .st-side { display: grid; gap: 10px; align-content: start; min-width: 0; }
  .st .st-mini { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 0; background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-lg); overflow: hidden; color: inherit; text-decoration: none; min-width: 0;
    transition: border-color var(--ds-dur-2); }
  .st .st-mini:hover { border-color: var(--ds-gold); }
  .st .st-mini .st-img { aspect-ratio: 4 / 3; border-radius: 0; height: 100%; }
  .st .st-mini div { padding: 8px 12px; display: grid; gap: 2px; align-content: center; min-width: 0; }
  .st .st-mini b { color: #fff; font-size: var(--ds-fs-sm); line-height: 1.25; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .st .st-tag { font: 9px/1.6 var(--ds-font-pixel); letter-spacing: .08em; text-transform: uppercase; color: var(--ds-gold); }

  /* shelves (chips) */
  /* 1.99mv: the chips row - no native scrollbar (it was a fat white bar that clipped the last chip); edge fades + arrows
     (desktop, only while it overflows), wheel / drag scrolling (st-chips-js in shop.ejs) */
  .st .st-chipwrap { position: relative; margin: var(--ds-sp-6) 0 0; min-width: 0; }
  .st .st-chips { display: flex; gap: 6px; overflow-x: auto; overflow-y: hidden; padding: 4px 2px 6px; margin: 0; scrollbar-width: none; -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; scroll-padding-inline: 44px; --fl: 0px; --fr: 0px;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 var(--fl), #000 calc(100% - var(--fr)), transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0, #000 var(--fl), #000 calc(100% - var(--fr)), transparent 100%); }
  .st .st-chips::-webkit-scrollbar { display: none; height: 0; }
  .st .st-chips::after { content: ""; flex: 0 0 2px; }             /* room after the last chip, so it never sits under the fade */
  .st .st-chipwrap.fl .st-chips { --fl: 36px; }
  .st .st-chipwrap.fr .st-chips { --fr: 36px; }
  .st .st-chips.drag { cursor: grabbing; user-select: none; }
  .st .st-chips.drag a { pointer-events: none; }
  .st .st-chip-arr { position: absolute; top: 4px; width: 36px; height: 36px; min-height: 0; padding: 0; border-radius: var(--ds-r-pill); display: none; align-items: center; justify-content: center;
    background: var(--ds-surface-3); color: var(--ds-gold); border: 1px solid #3a3a3a; font-size: 16px; line-height: 1; z-index: 2; box-shadow: var(--ds-e-3); cursor: pointer; }
  .st .st-chip-arr:hover { border-color: var(--ds-gold); background: #262212; filter: none; }
  .st .st-chip-arr.l { inset-inline-start: 0; } .st .st-chip-arr.r { inset-inline-end: 0; }
  [dir="rtl"] .st .st-chip-arr { transform: scaleX(-1); }
  @media (hover: hover) and (pointer: fine) {
    .st .st-chipwrap.fl .st-chip-arr.l, .st .st-chipwrap.fr .st-chip-arr.r { display: inline-flex; }
    .st .st-chipwrap.fl .st-chips { --fl: 56px; }
    .st .st-chipwrap.fr .st-chips { --fr: 56px; }
  }
  .st .st-chips a { flex: none; display: inline-flex; align-items: center; gap: 6px; background: #151515; border: 1px solid #2a2a2a; color: #ccc; border-radius: var(--ds-r-pill);
    padding: 0 var(--ds-sp-3h); font-size: var(--ds-fs-sm); font-weight: 500; text-decoration: none; white-space: nowrap; min-height: 36px; -webkit-user-drag: none;
    transition: border-color var(--ds-dur-1), color var(--ds-dur-1); }
  .st .st-chips a:hover { border-color: var(--ds-gold); color: #fff; }
  .st .st-chips a:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .st .st-chips a[aria-current="true"] { background: var(--ds-gold); border-color: var(--ds-gold); color: var(--ds-on-gold); font-weight: 700; }
  .st .st-chips a .n { font-size: var(--ds-fs-xs); opacity: .75; font-variant-numeric: tabular-nums; }
  .st .st-chips a.afford { border-color: var(--ds-green-line); color: var(--ds-green-2); }
  .st .st-chips a.afford[aria-current="true"] { background: var(--ds-green); border-color: var(--ds-green); color: var(--sh-on-green); }
  @media (pointer: coarse) { .st .st-chips a { min-height: 40px; } }
  .st .st-tools { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; justify-content: space-between; margin: var(--ds-sp-3) 0; }
  .st .st-tools form { display: flex; gap: 8px; align-items: center; }
  .st .st-tools select { width: auto; min-height: 36px; padding: 6px 10px; font-size: var(--ds-fs-sm); }
  .st details.st-more { margin: 0 0 var(--ds-sp-3); padding: var(--ds-sp-2) var(--ds-sp-4); }
  .st details.st-more[open] { padding-block-end: var(--ds-sp-4); }
  .st details.st-more .filters label.check { font-size: var(--ds-fs-sm); }

  /* item cards */
  .st .st-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); gap: var(--ds-sp-3); }
  .st .st-card { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); overflow: hidden; display: flex; flex-direction: column; min-width: 0;
    transition: border-color var(--ds-dur-2), transform var(--ds-dur-2), box-shadow var(--ds-dur-2); }
  .st .st-card:hover { border-color: #4a4a4a; transform: translateY(-1px); box-shadow: var(--ds-e-2); }
  .st .st-card.can { border-color: #2a4a2c; }
  .st .st-card.oos { opacity: .62; }
  .st .st-img { position: relative; display: block; aspect-ratio: 4 / 3; background: var(--ds-sunken); overflow: hidden; }
  .st .st-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .st .st-img .ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 46px; line-height: 1; font-family: var(--ds-font-emoji); background: radial-gradient(circle at 50% 42%, #2a2a2a, var(--ds-sunken) 70%); }
  .st .st-badges { position: absolute; inset-inline: 8px; top: 8px; display: flex; flex-wrap: wrap; gap: 5px; pointer-events: none; }
  .st .st-badge { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: var(--ds-r-pill); background: rgba(0,0,0,.72); color: #eee; border: 1px solid rgba(255,255,255,.14); line-height: 1.5; }
  .st .st-badge.gold { color: var(--ds-gold); border-color: rgba(255,207,64,.45); }
  .st .st-badge.red { color: var(--ds-danger); border-color: rgba(229,115,115,.5); }
  .st .st-cb { padding: var(--ds-sp-3) var(--ds-sp-3) var(--ds-sp-3h); display: grid; gap: 6px; flex: 1; align-content: start; }
  .st .st-cb h3 { margin: 0; font-size: 15px; line-height: 1.3; }
  .st .st-cb h3 a { color: #fff; text-decoration: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .st .st-cb h3 a:hover { text-decoration: underline; }
  .st .st-sub { color: var(--ds-text-muted); font-size: 12.5px; line-height: 1.4; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .st .st-price { color: var(--ds-gold-text); font-weight: 700; font-size: 18px; font-variant-numeric: tabular-nums; line-height: 1.2; }
  .st .st-price small { font-size: .7em; font-weight: 700; color: #d9c88a; }
  .st .st-price .note { font-size: var(--ds-fs-xs); font-weight: 400; color: var(--ds-text-muted); }
  .st .st-meta { color: var(--ds-text-muted); font-size: var(--ds-fs-xs); }
  .st .st-act { margin-top: auto; padding-top: 6px; display: flex; gap: 6px; }
  .st .st-act > * { flex: 1; min-height: 40px; padding: 0 var(--ds-sp-3); }

  /* "can you afford it" */
  .st .st-aff { display: grid; gap: 4px; font-size: 12.5px; }
  .st .st-aff .bar { height: 6px; border-radius: var(--ds-r-pill); background: #1f1f1f; overflow: hidden; }
  .st .st-aff .bar i { display: block; height: 100%; background: var(--ds-gold-grad); border-radius: var(--ds-r-pill); }
  .st .st-aff.ok { color: var(--ds-ok); }
  .st .st-aff.no { color: #c9a98a; }

  /* buy anywhere */
  .st .st-any { display: grid; gap: var(--ds-sp-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .st .st-any > div { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); font-size: var(--ds-fs-sm); line-height: 1.55; color: #ccc; min-width: 0; }
  .st .st-any b { color: #fff; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 2px; }
  .st code { background: #1c1c1c; border: 1px solid #2c2c2c; border-radius: var(--ds-r-xs); padding: 1px 6px; color: var(--ds-gold-text); font-family: var(--ds-font-mono); font-size: .9em; white-space: nowrap; }
  .st #codeform { display: flex; gap: 8px; padding: var(--ds-sp-3); }
  .st #codeform input { min-height: var(--ds-tap); flex: 1 1 200px; }
  .st #codeform button { min-height: var(--ds-tap); padding: 0 var(--ds-sp-5); }
  .st .st-links { margin-top: var(--ds-sp-6); display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .st .st-links a { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; }

  /* item page */
  .st .crumbs { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: var(--ds-fs-meta); color: var(--ds-text-muted); margin: 0 0 var(--ds-sp-4); padding: 0; list-style: none; }
  .st .crumbs li { display: inline-flex; align-items: center; gap: 6px; min-height: 28px; }
  .st .crumbs li + li::before { content: "›"; color: var(--ds-text-faint); }
  [dir="rtl"] .st .crumbs li + li::before { content: "‹"; }
  .st .st-detail { display: grid; gap: var(--ds-sp-6); grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: start; }
  .st .st-gal { display: grid; gap: 8px; min-width: 0; }
  .st .st-gal .main { position: relative; display: block; border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); overflow: hidden; background: var(--ds-sunken); padding: 0; min-height: 0; cursor: zoom-in; width: 100%; }
  .st .st-gal .main:hover { filter: none; border-color: #444; }
  .st .st-gal .main .st-img { aspect-ratio: 4 / 3; }
  .st .st-gal .main .zoom { position: absolute; inset-inline-end: 10px; top: 10px; background: rgba(0,0,0,.72); color: #eee; border-radius: var(--ds-r-pill); padding: 4px 10px; font-size: var(--ds-fs-xs); font-weight: 400; }
  .st .st-thumbs { display: flex; gap: 8px; flex-wrap: wrap; }
  .st .st-thumbs button { width: 76px; min-height: 0; padding: 0; border-radius: var(--ds-r-md); overflow: hidden; border: 2px solid #2a2a2a; background: var(--ds-sunken); }
  .st .st-thumbs button[aria-pressed="true"] { border-color: var(--ds-gold); }
  .st .st-thumbs img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .st .st-panel { display: grid; gap: var(--ds-sp-3); min-width: 0; }
  .st .st-panel h1 { text-align: start; margin: 0; font: 700 var(--ds-fs-h1)/var(--ds-lh-h1) var(--ds-font); text-wrap: balance; }
  .st .st-panel .st-price { font-size: 30px; }
  .st .st-buy { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); display: grid; gap: 10px; }
  .st .st-buy .status-msg:empty { min-height: 0; }
  .st .st-buy .buy-btn, .st .st-buy .btn { width: 100%; min-height: var(--ds-tap); font-size: 15px; }
  .st .st-gift { border-top: 1px solid var(--ds-line-soft); padding-top: 10px; }
  .st .st-gift summary { color: #ffb3e6; font-weight: 700; list-style: none; display: flex; align-items: center; gap: 6px; min-height: 40px; }
  .st .st-gift summary::-webkit-details-marker { display: none; }
  .st .st-gift summary::after { content: "▾"; margin-inline-start: auto; color: var(--ds-text-faint); }
  .st .st-gift[open] summary::after { content: "▴"; }
  .st .st-gift .fields { display: grid; gap: 8px; margin-top: 8px; }
  .st .st-gift .st-anon { display: flex; align-items: center; gap: 10px; min-height: 36px; color: #ccc; font-weight: 400; }
  .st .st-gift button { background: linear-gradient(90deg, #9b5de5, #ff6ad5); color: #1a0016; }
  .st .st-what { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); display: grid; gap: 10px; }
  .st .st-what p { margin: 0; line-height: 1.55; }
  .st .st-what ul { margin: 0; padding-inline-start: 20px; display: grid; gap: 6px; line-height: 1.55; }
  .st .st-what .lead { color: #fff; font-weight: 700; font-size: 16px; }
  .st dialog.st-lb { border: 1px solid var(--ds-line-menu); border-radius: var(--ds-r-2xl); padding: 0; background: var(--ds-sunken); max-width: min(92vw, 900px); width: 100%; color: #eee; box-shadow: var(--ds-e-4); }
  .st dialog.st-lb::backdrop { background: rgba(0,0,0,.8); }
  .st dialog.st-lb img { width: 100%; display: block; }
  .st dialog.st-lb form { position: absolute; inset-inline-end: 8px; top: 8px; }

  /* 1.99mv: a seller's storefront - the hero (photo, name style, level, badges, stats) + best sellers */
  .st .st-back { margin: 0 0 var(--ds-sp-3); }
  .st .st-store { background: radial-gradient(120% 150% at 0% 0%, #10261a 0%, #111 55%), #111; }
  .st .st-sh { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--ds-sp-4); align-items: center; min-width: 0; }
  .st .st-sav { --h: 120; position: relative; width: 96px; height: 96px; border-radius: 50%; overflow: hidden; display: grid; place-items: center; flex: none;
    background: hsl(var(--h) 45% 26%); color: #fff; font: 700 38px var(--ds-font); box-shadow: 0 0 0 3px var(--ds-surface), 0 0 0 5px var(--ds-gold), var(--ds-e-2); }
  .st .st-sav img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .st .st-store h1 { margin: 0; font-size: var(--ds-fs-h1); line-height: var(--ds-lh-h1); }
  .st .st-who { display: flex; flex-wrap: wrap; gap: 4px 12px; color: var(--ds-text-muted); font-size: var(--ds-fs-sm); align-items: center; }
  .st .st-lvl { font: 9px/1.4 var(--ds-font-pixel); color: var(--ds-on-gold); background: var(--ds-gold); border-radius: var(--ds-r-xs); padding: 4px 6px; letter-spacing: .04em; text-transform: uppercase; }
  .st .st-pins { display: flex; flex-wrap: wrap; gap: 6px; }
  .st .st-pins .pin { display: inline-flex; align-items: center; gap: 6px; background: var(--ds-glass); border: 1px solid #3a3a1c; border-radius: var(--ds-r-md); padding: 3px 9px 3px 3px; font-size: var(--ds-fs-xs); color: #e8e2b0; }
  .st .st-pins img { width: 24px; height: 24px; object-fit: contain; image-rendering: pixelated; }
  .st .st-sstats { grid-template-columns: 1fr 1fr; align-content: start; }
  .st .st-sstats .bal { display: block; font-variant-numeric: tabular-nums; color: var(--ds-gold-text); }
  .st .st-sstats .btn { grid-column: 1 / -1; text-align: center; }
  .st .st-sbest { display: grid; gap: var(--ds-sp-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); margin: 0 0 6px; }
  .st .st-sbest .st-mini { grid-template-columns: 130px minmax(0, 1fr); }
  .st .st-sbest .st-mini.top { border-color: #5a4210; }
  .st .st-empty { text-align: center; border: 1px dashed var(--ds-line-strong); border-radius: var(--ds-r-xl); padding: var(--ds-sp-6) var(--ds-sp-4); display: grid; gap: 8px; justify-items: center; margin: var(--ds-sp-4) 0 var(--ds-sp-3); }
  .st .st-empty > span { font-size: 30px; line-height: 1; font-family: var(--ds-font-emoji); }
  .st .st-empty b { color: #ddd; font-size: 15px; }
  .st .st-empty p { margin: 0; color: var(--ds-text-muted); font-size: var(--ds-fs-sm); max-width: 46ch; line-height: 1.5; }
  .st .st-empty .btn { margin-top: var(--ds-sp-2); min-height: 36px; }
  .st .st-sbest .st-mini .ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 34px; }

  @media (max-width: 760px) {
    .st .st-hero { grid-template-columns: minmax(0, 1fr); }
    .st .st-wallet { min-width: 0; }
    .st .st-feat { grid-template-columns: minmax(0, 1fr); }
