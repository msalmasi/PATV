<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<%#
  A Follow / Following button (1.99bz, public/js/follow.js). Locals: kind ('user' | 'room'), id (username or
  room id), following (bool), signed (bool), next (sign-in return path), small (bool, optional),
  fwTitle (tooltip, optional - e.g. 'Follow this pad')
%><% const sm_ = typeof small !== 'undefined' && small ? ' sm' : '', tt_ = typeof fwTitle !== 'undefined' && fwTitle ? ' title="' + String(fwTitle).replace(/[&<>"]/g, '') + '"' : ''; %><% if (signed) { %><button type="button"<%- tt_ %> class="fw-btn<%= sm_ %><%= following ? ' on' : '' %>" data-follow-kind="<%= kind %>" data-follow-id="<%= id %>" aria-pressed="<%= following ? 'true' : 'false' %>"><span class="fw-l"><%- following ? t('feed.follow.following') : t('feed.follow.follow') %></span></button><% } else { %><a<%- tt_ %> class="fw-btn<%= sm_ %>" href="/login?next=<%= encodeURIComponent(next || '/') %>"><%- t('feed.follow.follow') %></a><% } %>
