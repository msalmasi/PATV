<%#
  views/partials/admin-nav.ejs - the admin area's sections (1.99cv). Sidebar on desktop, a top bar on phones.
  Params: section (the current key), admIsAdmin (the page's "is an admin" flag - only the test fallback below uses it).
  1.99ack: every entry and sub-link names the capabilities (siteperms.js) that open it, and the viewer sees only what
  they can use (an Assistant: the pages of their own capabilities - banner / soundboard / pad connection review).
  Sub-links are anchors on that section's page; old anchors on /feed/admin (#urgent #users #dms #audit #pepe) are kept.
%><%
  const _can = locals.can || new Function(include('../../siteperms-core.js'))().viewCan(locals);
  const _sec = typeof section !== 'undefined' ? section : '';
  const AREA = 'admin.area', SENS = 'admin.sensitive_overview';
  // [key, href, icon, label, [sub-links: [href, label, capability?]], [capabilities that open the page]]
  const ALL_ = [
    ['overview', '/admin', '🧭', 'Overview', [], [AREA]],
    ['users', '/admin/users', '👥', 'Users & Accounts', [['#roles', 'Roles & classes'], ['#xp', 'XP', 'users.xp'], ['#welcome-admin', 'Welcome bonus', 'users.welcome_stale'], ['#stale-admin', 'Stale cleanup', 'users.welcome_stale'], ['#merges', 'Merges']], [AREA]],
    ['accounts', '/admin/accounts', '🔐', 'Account security', [['#lookup', 'Look up a member'], ['#deletions', 'Deletions'], ['#events', 'Recent events']], ['accounts.security']],   // 1.99wl: accountsadmin.js
    ['economy', '/admin/economy', '🏦', 'Economy', [['#reserve', 'Reserve & flows', SENS], ['#loans', 'Loans & credit', SENS], ['#grants', 'PAT grants'], ['#codes', 'Redemption codes', 'econ.codes_view'], ['#royalties', 'Royalties'], ['#shop', 'Prize shop'], ['#oracle', 'AI judge rulings', 'oracle.admin'], ['#elsewhere', "On Pepe's panel"]], [AREA]],
    ['markets', '/admin/markets', '🤖', 'Auto markets', [['#settings', 'Settings'], ['#generate', 'Generate / preview'], ['#review', 'Review'], ['#list', 'Auto-created']], ['markets.auto']],   // 1.99th: automkt.js
    ['raffles', '/admin/raffles', '🎫', 'Raffles', [['#settings', 'Settings'], ['#review', 'Review'], ['#open', 'Open raffles'], ['#house', 'House raffle'], ['#recent', 'Recent']], ['raffles.admin']],   // 1.99xq: raffles.js (was a card on /raffles)
    ['oracle', '/admin/oracle', '⚖️', 'AI judge rulings', [], ['oracle.admin']],   // 1.99uc: oracleadmin.js - the AI judge's proposals and disputes
    ['pads', '/pads/admin', '🏠', 'Pads', [['#front', 'Front-page pad', 'pads.registry_admin'], ['#owners', 'Pads & owners', 'pads.registry_admin'], ['#padconn', 'Connection requests', 'pads.connect_review'], ['#royalties', 'Owner royalties', 'pads.registry_admin'], ['#adult', '18+ pads', 'pads.registry_admin']], ['pads.registry_admin', 'pads.connect_review']],
    ['feed', '/feed/admin', '🛡️', 'Feed & Trust and Safety', [['#urgent', 'Reports'], ['#users', 'Reported users'], ['#dms', 'Reported DMs', 'dm.report_review'], ['#audit', 'Access log', 'feed.abuse_details'], ['#bans', 'Feed bans'], ['#settings', 'Settings & Terms'], ['#pepe', 'Pepe on the feed'], ['/feed/admin/filter', 'Content filter', 'feed.filter_admin']], ['feed.admin_page']],
    ['imagesafety', '/admin/imagesafety', '🖼️', 'Image safety', [['#settings', 'Settings'], ['#review', 'Review']], ['imagesafety.admin']],
    ['shopart', '/admin/shopart', '🎨', 'Shop pictures', [['#settings', 'Settings'], ['#log', 'Generations']], ['shopart.view']],   // 1.99xr: shopart.js - the shop's Generate image button
    ['takedowns', '/admin/takedowns', '🚨', 'TAKE IT DOWN (48 h)', [], ['takedown.handle']],   // 1.99pv: takedown.js
    ['creators', '/admin/creators', '⭐', 'PATV Creators', [['#apps', 'Creators'], ['#disputes', 'Disputes'], ['#ledger', 'Ledger'], ['#settings', 'Settings', 'creators.config_explicit'], ['/admin/creators/explicit', 'Explicit tier checklist', 'creators.config_explicit']], ['creators.admin']],   // 1.99pv: creators.js
    ['banner', '/admin/banner', '📣', 'Homepage banner', [['#queue', 'Review queue'], ['#booked', 'Booked'], ['#settings', 'Settings', 'banner.config'], ['#promos', 'House promos', 'banner.config']], ['banner.review']],   // 1.99kk: banner.js
    ['stage', '/stage/admin', '📺', 'Stage & Stream', [['#open', 'On stage now'], ['#settings', 'Settings'], ['#bans', 'Booking bans'], ['#log', 'Booking log'], ['#events', 'Events']], ['stage.admin']],
    ['media', '/admin/media', '🎬', 'Plex & media', [['#checks', 'Connections'], ['#library', 'Play from library'], ['#plays', 'Play log'], ['#settings', 'Settings'], ['#requests', 'Requests'], ['#invites', 'Invite queue'], ['/admin/comps#plex', '🎁 Comp Plex access', 'comps.manage']], ['media.admin']],
    ['comps', '/admin/comps', '🎁', 'Comps & gifts', [['#plex', 'Plex'], ['#premium', 'Prime Time / Season Pass'], ['#items', 'Store items'], ['#active', 'Active comps'], ['#policy', 'Gift policy'], ['#log', 'Log'], ['#gifts', 'Gift log']], ['comps.manage']],   // 1.99ma: comps.js
    ['crypto', '/admin/crypto', '🪙', 'Crypto donations', [['#settings', 'Settings'], ['#health', 'Watcher'], ['#held', 'Held'], ['#unclaimed', 'Unclaimed'], ['#payments', 'All payments'], ['#dryrun', 'Dry run']], ['crypto.admin']],
    ['push', '/admin/push', '🔔', 'Web Push', [['#settings', 'Settings'], ['#health', 'Delivery'], ['#test', 'Test']], ['push.admin']],   // 1.99acd: webpush.js
    ['bridge', '/admin/bridge', '🌉', 'Bridge', [['#cmdlog', 'Web command log', 'bridge.cmdlog']], [AREA]],
    ['soundboards', '/admin/soundboards', '🔊', 'Soundboards, voices & likeness', [['#reports', 'Reports', 'soundboards.moderate'], ['#renders', 'Renders', 'soundboards.moderate'], ['#voices', 'Voices', 'voices.view'], ['#clones', 'Voice clones', 'voiceclone.view'], ['#likeness', 'Likeness royalties', 'likeness.view'], ['#settings', 'Settings', 'soundboards.config']], ['soundboards.moderate']],   // 1.99rh: soundboards.js / voicestore.js / likeness.js
    ['pepe', '/admin/pepe', '🐸', 'Pepe', [['#control', 'Control panel', 'pepe.control'], ['/admin/pepe/rooms', 'Rooms (join / leave)', 'pepe.rooms_commands_audio'], ['/admin/pepe/commands', 'Commands (on / off)', 'pepe.rooms_commands_audio'], ['/admin/pepe/audio#room-audio', 'Room audio', 'pepe.rooms_commands_audio'], ['/admin/pepe/livecams', 'Live cams', 'livecam.admin'], ['#feed', 'Feed settings']], [AREA]],
    ['backends', '/admin/backends', '🔌', 'Backends', [['#handovers', 'Hand-overs'], ['#status', 'Cutovers (status)']], ['econ.backend_cutover']],   // owner answers 2026-10-20: backends.js (Pepe's panel card is read-only)
    ['roles', '/admin/roles', '🎖️', 'Roles & permissions', [['#holders', 'Role holders'], ['#commands', 'Command permissions'], ['#targets', 'Moderation targets'], ['#notes', 'Notes'], ['#website', 'Website permissions'], ['#chat', 'Change from chat']], ['roles.assign']],   // 1.99acj: adminroles.js / pepeperms.js
    ['keys', '/admin/keys', '🔑', 'Bot keys & chat seam', [['#keys', 'Keys'], ['#scopes', 'Scopes'], ['#families', 'Route families'], ['#legacy', 'Legacy token use'], ['#routes', 'Route log'], ['#events', '/events'], ['#seam', 'Chat tickets & hub seam']], ['keys.view']],   // 1.99acf: adminkeys.js
    ['help', '/admin/help', '📖', 'Help questions', [['#misses', 'Unanswered']], ['help.admin']],
    ['translations', '/admin/translations', '🌐', 'Translations', [['#pending', 'Suggestions'], ['#overrides', 'Live overrides'], ['#export', 'Export']], ['i18n.admin']],
    ['games', '/admin/games', '🎰', 'Games', [['#wheel', 'Wheel spin'], ['#jackpot', 'Jackpot'], ['#casino', 'Casino bans'], ['#heistmarket', 'Heist market', 'games.config']], [AREA]],
    ['cosmetics', '/admin/cosmetics', '🏅', 'Cosmetics & Achievements', [['#badges', 'Badges'], ['#catalogs', 'Catalogs']], [AREA]],
    ['system', '/admin/system', '⚙️', 'System', [['#health', 'Health'], ['#storage', 'Storage']], [AREA]],
  ];
  // S1 (ADR 0007 D15): the 💬 Chat group. Release L1 makes its entry above (/admin/chat, the break-glass form, chat.breakglass);
  // S1 V2 (release L4, chatwidget.js) owns the chat hub's moderation screens in it: locals.chatAdminNav (app.locals, set by
  // chatwidget.register) lists [href, label, capability] per /admin/chat/<view> whose capability siteperms has registered
  // (chat.mod_queue: reports / held / mod log / bans; chat.audit: audit / switches). They join L1's entry, whose anchors become
  // /admin/chat#... (so they work from a view's page too) behind L1's capability; the group opens to their capabilities and
  // links to the first page the viewer may use. Without L1's entry, the links make the group.
  const _chatV = typeof locals.chatAdminNav === 'function' ? locals.chatAdminNav() : [];
  if (_chatV.length) {
    const _ci = ALL_.findIndex((n) => n[0] === 'chat');
    const _g = _ci >= 0 ? ALL_[_ci] : ['chat', '', '💬', 'Chat', [], []];
    const _gCap = _g[5][0] || null;
    const _subs = _g[4].map((s) => [s[0].charAt(0) === '#' ? _g[1] + s[0] : s[0], s[1], s[2] || _gCap]).concat(_chatV);
    const _caps = _g[5].concat(_chatV.map((s) => s[2])).filter((k, i, a) => a.indexOf(k) === i);
    const _home = [[_g[1], _gCap]].concat(_chatV.map((s) => [s[0], s[2]])).find((p) => p[0] && p[1] && _can(p[1]));
    const _entry = ['chat', _home ? _home[0] : _chatV[0][0], _g[2], _g[3], _subs, _caps];
    if (_ci >= 0) ALL_[_ci] = _entry; else ALL_.splice(ALL_.findIndex((n) => n[0] === 'keys') + 1, 0, _entry);
  }
  const NAV = ALL_.filter((n) => n[0] === _sec || n[5].some((k) => _can(k)));
  const _subOk = (s) => !s[2] || _can(s[2]);
  const _cur = NAV.find((n) => n[0] === _sec);
  const _role = _can(SENS) ? 'Admin' : _can(AREA) ? 'Staff' : 'Assistant';
%>
<nav class="adm-side" aria-label="Admin sections">
  <div class="adm-brand"><a href="<%= _can(AREA) || !NAV[0] ? '/admin' : NAV[0][1] %>">🛠️ Admin</a><span class="adm-role"><%= _role %></span></div>
  <ul class="adm-nav">
    <% NAV.forEach((n) => { const on = n[0] === _sec; %>
      <li class="<%= on ? 'on' : '' %>">
        <a href="<%= n[1] %>"<%- on ? ' aria-current="page"' : '' %>><span class="ic" aria-hidden="true"><%= n[2] %></span><span class="lb"><%= n[3] %></span></a>
        <% if (on && n[4].length) { %>
          <ul class="adm-sub">
            <% n[4].forEach((s) => { if (!_subOk(s)) return; %><li><a href="<%= s[0] %>"><%= s[1] %></a></li><% }) %>
          </ul>
        <% } %>
      </li>
    <% }) %>
  </ul>
  <div class="adm-side-foot"><% if (_can('shop.admin')) { %><a href="/shop/admin">Prize shop admin ›</a><% } %><a href="/">Back to the site ›</a></div>
</nav>
<% if (_cur && _cur[4].length) { %>
<nav class="adm-subbar" aria-label="<%= _cur[3] %> sections">
  <% _cur[4].forEach((s) => { if (!_subOk(s)) return; %><a href="<%= s[0] %>"><%= s[1] %></a><% }) %>
</nav>
<% } %>
