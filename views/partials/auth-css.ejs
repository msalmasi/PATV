<%# views/partials/auth-css.ejs - shared look + behaviour for the sign in / register / forgot / reset /
    account-conflict pages (dark card style, same family as tip.ejs / staking.ejs). Markup classes:
    .au (page) > .au-card; .au-field > label + input + .au-err; .au-pw (password + show/hide);
    form[data-au-form] gets client-side checks, inline errors, caps-lock hint and a busy state. %>
<style>
  .au { width: 100%; max-width: 460px; margin: 0 auto; padding: 28px 16px 64px; font-family: Ubuntu, sans-serif; color: #e6e6e6; box-sizing: border-box; display: grid; gap: 14px; }
  .au *, .au *::before, .au *::after { box-sizing: border-box; }
  .au a { color: #81c784; text-decoration: none; }
  .au a:hover { color: #a5d6a7; text-decoration: underline; }
  .au-card { background: #111; border: 1px solid #222; border-radius: 14px; padding: 22px 22px 20px; min-width: 0;
             background-image: radial-gradient(120% 90% at 0% 0%, #15291a 0%, rgba(17,17,17,0) 60%); }
  .au-brand { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; }
  .au-brand img { width: 36px; height: 36px; image-rendering: pixelated; flex: none; }
  .au-brand .k { font-family: 'Press Start 2P', monospace; font-size: 10px; letter-spacing: .08em; color: #ffd700; line-height: 1.6; text-transform: uppercase; }
  .au h1 { margin: 0; font-size: 26px; line-height: 1.2; color: #fff; }
  .au h1:focus { outline: none; }
  .au .sub { margin: 6px 0 0; color: #9a9; font-size: 14px; line-height: 1.45; }
  .au form { margin: 18px 0 0; display: grid; gap: 14px; background: none; }
  .au-field { display: grid; gap: 6px; min-width: 0; }
  .au-field label { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: #aaa; margin: 0; padding: 0; }
  .au-field .lblrow { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .au-field .lblrow a { font-size: 13px; }
  .au input[type="text"], .au input[type="email"], .au input[type="password"] {
    width: 100%; margin: 0; font: inherit; font-size: 16px; color: #fff; background: #0b0b0b; border: 1px solid #2b2b2b; border-radius: 10px;
    padding: 12px 14px; min-height: 48px; }
  .au input::placeholder { color: #555; }
  .au input:focus { outline: none; border-color: #4caf50; box-shadow: 0 0 0 3px rgba(76,175,80,.25); }
  .au input[aria-invalid="true"] { border-color: #e57373; }
  .au input[aria-invalid="true"]:focus { box-shadow: 0 0 0 3px rgba(229,115,115,.25); }
  .au-pw { position: relative; }
  .au-pw input { padding-right: 76px !important; }
  .au-pw .eye { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); margin: 0; min-height: 36px; padding: 6px 10px; border-radius: 8px;
                background: transparent; border: 1px solid transparent; color: #9a9; font: inherit; font-size: 13px; cursor: pointer; }
  .au-pw .eye:hover { color: #fff; background: #1a1a1a; }
  .au-pw .eye:focus-visible { outline: 2px solid #c6e94f; outline-offset: 1px; }
  .au-err { color: #ef9a9a; font-size: 13px; line-height: 1.4; }
  .au-err:empty { display: none; }
  .au-hint { color: #888; font-size: 13px; line-height: 1.4; }
  .au-hint.ok { color: #81c784; }
  .au-caps { color: #e8cf7a; font-size: 13px; }
  .au-caps[hidden] { display: none; }
  .au-alert { border-radius: 10px; padding: 10px 14px; font-size: 14px; line-height: 1.45; margin: 16px 0 0; overflow-wrap: anywhere; }
  .au-alert.err { color: #ffcdd2; background: #2a1414; border: 1px solid #5c2626; }
  .au-alert.ok { color: #c8e6c9; background: #10200f; border: 1px solid #2f5d31; }
  .au-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; min-height: 48px; margin: 0; padding: 12px 16px;
            border-radius: 10px; border: 1px solid #4caf50; background: #4caf50; color: #fff; font: inherit; font-size: 16px; font-weight: bold; cursor: pointer; }
  .au-btn:hover { background: #43a047; }
  .au-btn:focus-visible, .au-oauth:focus-visible { outline: 2px solid #c6e94f; outline-offset: 2px; }
  .au-btn.ghost { background: #181818; border-color: #2b2b2b; color: #ddd; font-weight: normal; }
  .au-btn.ghost:hover { border-color: #4caf50; }
  .au-btn.danger { background: #8e2b2b; border-color: #a33; }
  .au-btn.danger:hover { background: #a33; }
  .au-btn[disabled] { opacity: .65; cursor: progress; }
  .au-btn .spin { width: 16px; height: 16px; border-radius: 50%; border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; display: none; }
  .au-btn[aria-busy="true"] .spin { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) { .au-btn .spin { animation: au-spin .7s linear infinite; } }
  @keyframes au-spin { to { transform: rotate(360deg); } }
  .au-or { display: flex; align-items: center; gap: 10px; color: #666; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; margin: 18px 0 12px; }
  .au-or::before, .au-or::after { content: ""; flex: 1; height: 1px; background: #262626; }
  .au-oauths { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .au-oauth { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; padding: 10px 12px; border-radius: 10px;
              color: #fff !important; font-weight: bold; font-size: 15px; text-decoration: none !important; border: 1px solid transparent; }
  .au-oauth svg { width: 20px; height: 20px; flex: none; }
  .au-oauth.discord { background: #5865F2; }
  .au-oauth.discord:hover { background: #4752c4; }
  .au-oauth.twitch { background: #9146FF; }
  .au-oauth.twitch:hover { background: #772ce8; }
  .au-oauth-note { color: #777; font-size: 12px; margin: 8px 0 0; line-height: 1.4; }
  .au-foot { text-align: center; color: #999; font-size: 14px; }
  .au-terms { color: #999; font-size: 12.5px; line-height: 1.5; margin: 4px 0 12px; }
  .au-terms a { color: #81c784; }
  .au-perks { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .au-perks li { font-size: 12px; padding: 4px 10px; border-radius: 999px; border: 1px solid #2c3a2d; background: #0f1a10; color: #b9d8bb; }
  .au-perks code { color: #ffd700; font-size: 12px; }
  .au-sum { display: grid; background: #0d0d0d; border: 1px solid #1f1f1f; border-radius: 10px; margin: 16px 0 0; }
  .au-sum > div { display: flex; justify-content: space-between; gap: 12px; padding: 10px 14px; border-top: 1px solid #1a1a1a; font-size: 14px; }
  .au-sum > div:first-child { border-top: 0; }
  .au-sum .k { color: #999; flex: none; }
  .au-sum .v { text-align: right; min-width: 0; overflow-wrap: anywhere; font-weight: bold; }
  .au-check { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: #ccc; line-height: 1.4; cursor: pointer; }
  .au-check input { margin: 3px 0 0; width: 18px; height: 18px; flex: none; accent-color: #4caf50; }
  .au .row2 { display: grid; gap: 8px; }
  @media (max-width: 380px) {
    .au { padding: 16px 12px 48px; }
    .au-card { padding: 18px 16px; }
    .au h1 { font-size: 23px; }
    .au-oauths { grid-template-columns: 1fr; }
  }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>
