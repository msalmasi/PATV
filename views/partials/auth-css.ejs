<%# views/partials/auth-css.ejs - shared look + behaviour for the sign in / register / forgot / reset /
    account-conflict / Plex + SSO "new account" pages. 1.99pm: on the design system (docs/design-system.md, "Profile, account and auth").
    Markup: main.ds-page.narrow.au > section.ds-card.lg.au-card; .ds-field.au-field > label + input.ds-in + .au-err;
    .au-pw (password + show/hide); button.ds-btn.lg.wide.au-btn; .ds-note.au-alert. The .au-* names are the JS hooks
    (partials/auth-js: form[data-au-form], .au-pw .eye, .au-err, .au-hint.ok) - keep them. Accent: PATV green (the default). %>
<style>
  .au { gap: var(--ds-sp-4); padding-block-start: var(--ds-sp-6); }
  .au-card { background: radial-gradient(120% 90% at 0% 0%, var(--ds-green-bg) 0%, transparent 60%), var(--ds-surface); gap: 0; }
  .au-brand { display: flex; align-items: center; gap: var(--ds-sp-2h); margin: 0 0 var(--ds-sp-3h); }
  .au-brand img { width: 36px; height: 36px; image-rendering: pixelated; flex: none; }
  .au h1:focus { outline: none; }
  .au .ds-sub { margin-block-start: var(--ds-sp-1h); }
  .au form { margin: var(--ds-sp-5) 0 0; display: grid; gap: var(--ds-sp-3h); background: none; padding: 0; border: 0; }
  .au-field .lblrow { display: flex; justify-content: space-between; align-items: baseline; gap: var(--ds-sp-2); }
  .au-field .lblrow a { font: 400 var(--ds-fs-meta)/1.3 var(--ds-font); text-transform: none; letter-spacing: 0; }
  .au-field .ds-in.ds-in { font-size: 16px; }   /* no iOS zoom */
  .au-pw { position: relative; }
  .au-pw .ds-in.ds-in { padding-inline-end: 76px; }
  .au-pw .eye { position: absolute; inset-inline-end: 4px; top: 50%; transform: translateY(-50%); margin: 0; min-height: 36px; min-width: 0; padding: 0 var(--ds-sp-2h);
                border-radius: var(--ds-r-sm); background: transparent; border: 0; color: var(--ds-text-muted); font: 500 var(--ds-fs-meta)/1 var(--ds-font); cursor: pointer; box-shadow: none; }
  .au-pw .eye:hover { color: var(--ds-text-strong); background: var(--ds-hover); }
  .au-pw .eye:focus-visible { outline: 2px solid var(--ds-focus); outline-offset: 0; }
  .au-err { color: var(--ds-danger); font-size: var(--ds-fs-meta); line-height: 1.4; }
  .au-err:empty { display: none; }
  .au-hint { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); line-height: 1.4; }
  .au-hint.ok { color: var(--ds-ok); }
  .au-caps { color: var(--ds-warn); font-size: var(--ds-fs-meta); }
  .au-caps[hidden] { display: none; }
  .au-alert { margin: var(--ds-sp-4) 0 0; overflow-wrap: anywhere; }
  .au-h2 { margin: var(--ds-sp-5) 0 var(--ds-sp-2); }
  .au-h2 + .ds-sub { margin: 0 0 var(--ds-sp-3); }
  .au .au-h2 + form { margin-block-start: var(--ds-sp-2); }
  /* submit: a 52px full-width pill (.ds-btn.lg.wide); the spinner takes the ink colour */
  .au-btn .spin { width: 16px; height: 16px; border-radius: 50%; border: 2px solid currentColor; border-top-color: transparent; display: none; opacity: .8; }
  .au-btn[aria-busy="true"] .spin { display: inline-block; }
  .au-btn[disabled] { cursor: progress; }
  @media (prefers-reduced-motion: no-preference) { .au-btn .spin { animation: au-spin .7s linear infinite; } }
  @keyframes au-spin { to { transform: rotate(360deg); } }
  .au-linkbtn { margin: 0; padding: 0 var(--ds-sp-2); min-height: 36px; background: none; border: 0; border-radius: var(--ds-r-xs); color: var(--ds-text-muted); font: 400 var(--ds-fs-meta)/1 var(--ds-font);
                text-decoration: underline; text-underline-offset: 3px; cursor: pointer; box-shadow: none; }
  .au-linkbtn:hover { color: var(--ds-text); background: none; }
  .au form.au-cancel { margin: var(--ds-sp-2h) 0 0; display: flex; justify-content: center; }
  .au form.au-alt { margin-block-start: var(--ds-sp-2); }
  /* "or" rule + the sign-in-with buttons (brand fills; white ink only where it passes 4.5:1) */
  .au-or { display: flex; align-items: center; gap: var(--ds-sp-2h); color: var(--ds-text-faint); font: 700 var(--ds-fs-xs)/1 var(--ds-font); letter-spacing: var(--ds-ls-label); text-transform: uppercase; margin: var(--ds-sp-5) 0 var(--ds-sp-3); }
  .au-or::before, .au-or::after { content: ""; flex: 1; height: 1px; background: var(--ds-line); }
  .au-oauths { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ds-sp-2); }
  .au-oauth { display: flex; align-items: center; justify-content: center; gap: var(--ds-sp-2); min-height: var(--ds-tap); margin: 0; padding: 0 var(--ds-sp-3); border-radius: var(--ds-r-pill);
              color: #fff !important; font: 700 15px/1.1 var(--ds-font); text-decoration: none !important; border: 1px solid transparent; cursor: pointer; box-shadow: none;
              transition: filter var(--ds-dur-1); }
  .au-oauth:hover { filter: brightness(1.1); }
  .au-oauth:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .au-oauth svg { width: 20px; height: 20px; flex: none; }
  .au-oauth.discord { background: var(--ds-discord); }
  .au-oauth.twitch { background: var(--ds-twitch); }
  .au-oauth.google { background: #fff; color: #1f1f1f !important; border-color: #dadce0; }
  .au-oauth.google:hover { filter: none; background: #f1f3f4; }
  /* Sign in with Apple: Apple's white style (on a dark page) - black logo + black title in the system font, same size as the others */
  .au-oauth.apple { background: #fff; color: #000 !important; border-color: #fff; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif; font-weight: 600; }
  .au-oauth.apple:hover { filter: none; background: #f2f2f2; }
  .au-oauth.apple svg { width: 18px; height: 18px; margin-top: -2px; }
  .au-oauth.telegram { background: #1a7bb0; }   /* Telegram's #229ED9 is 3.0:1 with white - this shade is 4.7:1 */
  .au-oauth.telegram[disabled] { opacity: .6; cursor: progress; }
  .au-oauth.plex { grid-column: 1 / -1; background: var(--ds-plex); color: #1a1200 !important; }
  .au-oauth .plex-ic { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 5px; background: #1a1200; color: var(--ds-plex); font-size: 11px; }
  .au-oauth-note { color: var(--ds-text-faint); font-size: var(--ds-fs-xs); line-height: var(--ds-lh-xs); margin: var(--ds-sp-2h) 0 0; }
  .au-foot { margin: 0; text-align: center; color: var(--ds-text-muted); font-size: var(--ds-fs-sm); }
  .au-terms { color: var(--ds-text-muted); font-size: var(--ds-fs-xs); line-height: 1.5; margin: 0; }
  .au-perks { list-style: none; margin: var(--ds-sp-3h) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--ds-sp-1h); }
  .au-perks .ds-tag { font-weight: 500; font-size: var(--ds-fs-xs); padding: 3px 10px 3px 8px; white-space: normal; }
  .au-perks code { color: var(--ds-gold); background: none; padding: 0; font-size: var(--ds-fs-xs); }
  .au-sum { display: grid; background: var(--ds-sunken); border: 1px solid var(--ds-line-soft); border-radius: var(--ds-r-lg); margin: var(--ds-sp-4) 0 0; }
  .au-sum > div { display: flex; justify-content: space-between; gap: var(--ds-sp-3); padding: var(--ds-sp-2h) var(--ds-sp-3h); border-block-start: 1px solid var(--ds-line-soft); font-size: var(--ds-fs-sm); }
  .au-sum > div:first-child { border-block-start: 0; }
  .au-sum .k { color: var(--ds-text-muted); flex: none; }
  .au-sum .v { text-align: end; min-width: 0; overflow-wrap: anywhere; font-weight: 700; color: var(--ds-text-strong); }
  .au-sum .v.gold { color: var(--ds-gold-text); font-variant-numeric: tabular-nums; }
  .au .ds-check { align-items: flex-start; }
  .au .ds-check input { margin-block-start: 1px; }
  .au > .au-card > .au-hint { margin: var(--ds-sp-3) 0 0; }
  @media (max-width: 420px) {
    .au { padding-block-start: var(--ds-sp-4); }
    .au-oauths { grid-template-columns: 1fr; }
  }
</style>
