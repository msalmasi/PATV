<%#
  One feed post card (1.99bv, redesigned 1.99bx). Locals: p (feedstore.decorate row), fx (feedweb.fx), embeds
  (stageembed), host, viewer (or null), modRooms (Set of room ids the viewer manages), detail (bool), ctxRoom (room id or null)
  Layout: vote column (up / score / down) | meta line (pad · author · time), title + flair, body, media, action bar
  (comments, share, the "more" menu with everything else).
  1.99ci: a crosspost (p.xpost) shows "Crossposted from p/<slug> by u/<author>" and embeds the original (or "original
  removed"); an original shows "Crossposted to N pads". Crosspost is in the "more" menu (and the post page's bar).
%><%
  const signed = !!viewer;
  const staff_ = !!viewer && (viewer.class === 'Admin' || viewer.class === 'Staff');
  const detail_ = typeof detail !== 'undefined' && detail;
  const ctx_ = typeof ctxRoom !== 'undefined' ? ctxRoom : null;
  const mods_ = typeof modRooms !== 'undefined' && modRooms ? modRooms : new Set();
  const myRooms = p.roomsAll.filter((r) => mods_.has(r.id));
  const v_ = p.myVote || 0;
  const roomsShown = p.rooms.filter((r) => r.id !== ctx_);
  const url_ = '/feed/p/' + p.id;
  const live_ = p.roomsAll.filter((r) => !r.removed);
  const lockable = staff_ || (live_.length > 0 && live_.every((r) => mods_.has(r.id)));
  const xp_ = p.xpost || null;
  const canXpost = signed && !p.deleted && !p.hidden && !(xp_ && xp_.removed);
  // owner menu: the room in view first (room page / ?room= filter), else every room of theirs the post is in
  const ownRooms = ctx_ ? myRooms.filter((r) => r.id === ctx_) : myRooms;
%>
<article class="fp<%= p.nsfw ? ' is-nsfw' : '' %><%= p.hidden || p.roomHidden ? ' is-hidden' : '' %><%= p.pinned ? ' is-pinned' : '' %><%= detail_ ? ' is-detail' : '' %>" id="p-<%= p.id %>" data-id="<%= p.id %>">
  <div class="vote fp-vote" data-v="<%= v_ %>" data-kind="post"<%- p.mine ? ' data-own="1"' : '' %>>
    <button type="button" class="vb vb-up" data-act="vote" data-dir="1" aria-pressed="<%= v_ === 1 ? 'true' : 'false' %>" aria-label="Upvote"><%- fx.icon('up') %></button>
    <span class="vs" title="<%= p.ups %> up · <%= p.downs %> down"><%= fx.num(p.score) %></span>
    <button type="button" class="vb vb-down" data-act="vote" data-dir="-1" aria-pressed="<%= v_ === -1 ? 'true' : 'false' %>" aria-label="<%= p.mine ? 'You can\'t downvote your own post' : 'Downvote' %>"<%= p.mine ? ' disabled' : '' %>><%- fx.icon('down') %></button>
  </div>
  <div class="fp-main">
    <div class="fp-meta">
      <% if (p.pinned) { %><span class="fp-pin" title="Pinned by the pad owner"><%- fx.icon('pin') %>Pinned</span><span class="dot" aria-hidden="true">·</span><% } %>
      <% if (p.author.bot) { %>
        <%# 1.99cg: Pepe's own posts - his avatar and the bot badge instead of a name (pepefeed.js) %>
        <img class="av av-pepe" src="/public/img/pepe.png" alt="" width="22" height="22" aria-hidden="true">
        <a class="fp-author bot-badge" href="/u/<%= encodeURIComponent(p.author.username) %>/profile" title="Pepe, PATV's bot - written by AI">🤖 Pepe</a>
      <% } else { %>
      <span class="av" style="--h:<%= fx.hue(p.author.username) %>" aria-hidden="true"><%= fx.initial(p.author.display) %></span>
      <a class="fp-author" href="/u/<%= encodeURIComponent(p.author.username) %>/profile"><%= p.author.display %></a>
      <% } %>
      <% if (signed && !p.mine && !p.author.bot && p.author.username && p.author.username !== '[gone]') { %><span class="fp-follow"><%- include('follow-btn', { kind: 'user', id: p.author.username, following: !!p.followingAuthor, signed: true, next: '/', small: true }) %></span><% } %>
      <% if (roomsShown.length) { %>
        <span class="dot" aria-hidden="true">·</span>
        <span class="fp-where"><% roomsShown.forEach((r, i) => { %><%= i ? ', ' : '' %><% if (r.profile) { %><%# 1.99df: a profile post shows u/<username> where the pad would be %><a class="fp-room fp-user<%= r.removed ? ' off' : '' %>" href="/u/<%= encodeURIComponent(r.profile) %>/profile" title="<%= r.profile %>'s profile">u/<%= r.profile %><%= r.removed ? ' (removed)' : '' %></a><% } else { %><a class="fp-room<%= r.removed ? ' off' : '' %>" href="/p/<%= encodeURIComponent(r.slug) %>" title="<%= r.title %>">p/<%= r.slug %><%= r.removed ? ' (removed)' : '' %></a><% } %><% }) %></span>
      <% } %>
      <span class="dot" aria-hidden="true">·</span>
      <a class="fp-time" href="<%= url_ %>"><time datetime="<%= new Date(p.created).toISOString() %>" title="<%= new Date(p.created).toUTCString() %>"><%= fx.ago(p.created) %></time></a>
      <% if (p.edited) { %><span class="fp-ed" title="edited <%= new Date(p.edited).toUTCString() %>">(edited)</span><% } %>
    </div>
    <% if (p.title || p.nsfw || p.hidden || p.deleted || p.pending || p.roomHidden || p.locked || (p.mine && p.onProfile && !p.inAll)) { %>
      <div class="fp-titlerow">
        <% if (p.title) { %><h3 class="fp-title"><% if (detail_) { %><%= p.title %><% } else { %><a href="<%= url_ %>"><%= p.title %></a><% } %></h3><% } %>
        <% if (p.nsfw) { %><span class="tag nsfw">NSFW</span><% } %>
        <% if (p.hidden) { %><span class="tag warn" title="Hidden after reports - an admin will review it">Hidden · in review</span><% } %>
        <% if (p.deleted) { %><span class="tag warn">Deleted<%= p.deleteReason ? ': ' + p.deleteReason : '' %></span><% } %>
        <% if (p.pending) { %><span class="tag pend" title="The pad owner reviews posts before they show here">Awaiting approval</span><% } %>
        <% if (p.roomHidden) { %><span class="tag warn" title="Hidden in this pad by its owner">Hidden in this pad</span><% } %>
        <% if (p.locked) { %><span class="tag lock" title="Comments are locked"><%- fx.icon('lock') %> Locked</span><% } %>
        <% if (p.mine && p.onProfile && !p.inAll) { %><span class="tag pend" title="Only on your profile and in your followers' Following - not in All">Not in All</span><% } %>
      </div>
    <% } %>
    <% if (xp_) { %>
      <p class="fp-xfrom"><%- fx.icon('xpost') %><span>Crossposted from <% if (xp_.from && xp_.from.profile) { %><%- fx.padBadge(xp_.from, { compact: true }) %> <a href="/u/<%= encodeURIComponent(xp_.from.profile) %>/profile">u/<%= xp_.from.profile %></a><% } else if (xp_.from) { %><%- fx.padBadge(xp_.from, { compact: true }) %> <a href="/p/<%= encodeURIComponent(xp_.from.slug) %>">p/<%= xp_.from.slug %></a><% } else { %>a pad<% } %><% if (xp_.author) { %> by <a href="/u/<%= encodeURIComponent(xp_.author.username) %>/profile">u/<%= xp_.author.username %></a><% } %></span></p>
    <% } %>
    <div class="fp-content<%= p.nsfw ? ' blur' : '' %>">
      <% if (xp_) { %>
        <% if (xp_.post && !(xp_.removed && !staff_)) { const o_ = xp_.post; %>
          <div class="fp-xbox<%= xp_.removed ? ' is-gone' : '' %>">
            <% if (xp_.removed) { %><span class="tag warn">Original removed · staff view</span><% } %>
            <a class="fp-xtitle" href="/feed/p/<%= o_.id %>"><%= o_.title || (o_.link && o_.link.title) || 'View the original post' %></a>
            <%- include('feed-post-content', { q: Object.assign({}, o_, { nsfw: p.nsfw }), fx, embeds, host, detail_, signed, url_: '/feed/p/' + o_.id }) %>
            <a class="fp-xorig" href="/feed/p/<%= o_.id %>"><%- fx.icon('comment') %><span><%= fx.num(o_.score) %> points · <%= fx.num(o_.comments) %> comment<%= o_.comments === 1 ? '' : 's' %> on the original</span></a>
          </div>
        <% } else { %>
          <div class="fp-xbox is-gone"><p class="fp-xgone"><%- fx.icon('remove') %>The original post was removed.</p></div>
        <% } %>
      <% } else { %>
        <%- include('feed-post-content', { q: p, fx, embeds, host, detail_, signed, url_ }) %>
      <% } %>
      <% if (p.nsfw && signed) { %><button type="button" class="fp-reveal" data-act="reveal">NSFW — click to show</button><% } %>
    </div>
    <% if (p.xcount) { %>
      <p class="fp-xto"><%- fx.icon('xpost') %><span>Crossposted to <%= p.xcount %> pad<%= p.xcount === 1 ? '' : 's' %>:</span><% p.crossposts.slice(0, detail_ ? 20 : 3).forEach((x, i) => { %><%= i ? ',' : '' %> <a href="/feed/p/<%= x.id %>"><%= x.label || 'p/' + x.slug %></a><% }) %><%= !detail_ && p.crossposts.length > 3 ? ' …' : '' %></p>
    <% } %>
    <div class="bar fp-bar">
      <a class="act" href="<%= url_ %>#comments"><%- fx.icon('comment') %><span><%= fx.num(p.comments) %><span class="lg"> comment<%= p.comments === 1 ? '' : 's' %></span></span></a>
      <button type="button" class="act" data-act="share" data-url="<%= url_ %>"><%- fx.icon('share') %><span class="lbl">Share</span></button>
      <% if (detail_ && canXpost) { %><button type="button" class="act" data-act="crosspost" data-title="<%= p.title %>"><%- fx.icon('xpost') %><span class="lbl">Crosspost</span></button><% } %>
      <% if (signed) { %>
        <details class="more">
          <summary class="act" aria-label="More actions" title="More"><%- fx.icon('more') %></summary>
          <div class="menu" role="menu">
            <% if (p.mine && !p.deleted) { %>
              <button type="button" role="menuitem" data-act="edit"><%- fx.icon('edit') %>Edit</button>
              <button type="button" role="menuitem" class="danger" data-act="delete"><%- fx.icon('trash') %>Delete</button>
            <% } %>
            <% if (canXpost) { %><button type="button" role="menuitem" data-act="crosspost" data-title="<%= p.title %>"><%- fx.icon('xpost') %>Crosspost</button><% } %>
            <% if (!p.deleted && !p.hidden) { %><a role="menuitem" href="/messages?share=<%= encodeURIComponent(p.id) %>"><%- fx.icon('share') %>Share → Send in a message</a><% } %>
            <% if (signed && !p.mine && !p.author.bot && p.author.username && p.author.username !== '[gone]') { %><a role="menuitem" href="/messages?to=<%= encodeURIComponent(p.author.username) %>"><%- fx.icon('comment') %>Message <%= p.author.display %></a><% } %>
            <% if (!p.mine) { %><button type="button" role="menuitem" data-act="report"><%- fx.icon('flag') %>Report post</button><% } %>
            <% if (detail_ && typeof pepeMuted !== 'undefined' && !p.author.bot && !p.deleted && (p.mine || staff_ || myRooms.length)) { %>
              <button type="button" role="menuitem" data-act="pepe-mute" data-on="<%= pepeMuted ? '0' : '1' %>" title="Pepe won't answer or comment in this thread"><%- fx.icon(pepeMuted ? 'show' : 'hide') %><%= pepeMuted ? 'Let Pepe back in this thread' : 'Mute Pepe in this thread' %></button>
            <% } %>
            <% ownRooms.forEach((r) => { const q_ = ' data-room="' + r.id + '" data-slug="' + r.slug + '"'; %>
              <% if (r.profile) { %>
                <%# 1.99df: your profile - lock comments, and the profile feed's settings (blocks, Pepe); nothing to pin / hide / remove (delete the post instead) %>
                <div class="sep" role="separator"></div><div class="mh"><%- fx.icon('shield') %><span><%= viewer && viewer.username === r.profile ? 'Your profile' : 'u/' + r.profile %></span></div>
                <% if (lockable && !staff_) { %><button type="button" role="menuitem" data-act="rmod" data-op="<%= p.locked ? 'unlock' : 'lock' %>"<%- q_ %>><%- fx.icon(p.locked ? 'unlock' : 'lock') %><%= p.locked ? 'Unlock comments' : 'Lock comments' %></button><% } %>
                <% if (p.mine && !p.deleted) { %><button type="button" role="menuitem" data-act="in-all" data-on="<%= p.inAll ? '0' : '1' %>"><%- fx.icon(p.inAll ? 'hide' : 'show') %><%= p.inAll ? 'Keep out of All' : 'Also show in All' %></button><% } %>
                <a role="menuitem" href="/u/<%= encodeURIComponent(r.profile) %>/profile#profile-settings"><%- fx.icon('flag') %>Profile feed settings</a>
              <% return; } %>
              <div class="sep" role="separator"></div><div class="mh"><%- fx.icon('shield') %><span><%= r.title %></span></div>
              <% if (r.pending) { %>
                <button type="button" role="menuitem" data-act="rmod" data-op="approve"<%- q_ %>><%- fx.icon('check') %>Approve</button>
                <button type="button" role="menuitem" class="danger" data-act="rmod" data-op="reject"<%- q_ %>><%- fx.icon('x') %>Reject</button>
              <% } %>
              <% if (!r.removed && !r.pending) { %><button type="button" role="menuitem" data-act="rmod" data-op="<%= r.pinned ? 'unpin' : 'pin' %>"<%- q_ %>><%- fx.icon('pin') %><%= r.pinned ? 'Unpin' : 'Pin to the pad' %></button><% } %>
              <% if (lockable && !staff_) { %><button type="button" role="menuitem" data-act="rmod" data-op="<%= p.locked ? 'unlock' : 'lock' %>"<%- q_ %>><%- fx.icon(p.locked ? 'unlock' : 'lock') %><%= p.locked ? 'Unlock comments' : 'Lock comments' %></button><% } %>
              <button type="button" role="menuitem" data-act="rmod" data-op="<%= r.nsfw ? 'unnsfw' : 'nsfw' %>"<%- q_ %>><%- fx.icon('nsfw') %><%= r.nsfw ? 'Unmark NSFW here' : 'Mark NSFW in this pad' %></button>
              <button type="button" role="menuitem" data-act="rmod" data-op="<%= r.hidden ? 'unhide' : 'hide' %>"<%- q_ %>><%- fx.icon(r.hidden ? 'show' : 'hide') %><%= r.hidden ? 'Unhide in this pad' : 'Hide in this pad (review)' %></button>
              <% if (r.removed) { %><button type="button" role="menuitem" data-act="restore-room" data-room="<%= r.id %>"><%- fx.icon('restore') %>Put back in the pad</button>
              <% } else { %><button type="button" role="menuitem" class="danger" data-act="remove-room" data-room="<%= r.id %>"><%- fx.icon('remove') %>Remove from the pad</button><% } %>
              <% if (!p.mine) { %><button type="button" role="menuitem" class="danger" data-act="room-ban" data-user="<%= p.author.username %>"<%- q_ %>><%- fx.icon('shield') %>Ban <%= p.author.display %> from this pad</button><% } %>
              <a role="menuitem" href="/p/<%= encodeURIComponent(r.slug) %>/settings#moderation"><%- fx.icon('flag') %>Pad settings &amp; moderation</a>
            <% }) %>
            <% if (staff_) { %>
              <div class="sep" role="separator"></div><div class="mh"><%- fx.icon('shield') %><span>Admin</span></div>
              <button type="button" role="menuitem" data-act="admin-nsfw" data-on="<%= p.nsfw ? '0' : '1' %>"><%- fx.icon('nsfw') %><%= p.nsfw ? 'Unmark NSFW' : 'Mark NSFW' %></button>
              <button type="button" role="menuitem" data-act="admin-hide" data-on="<%= p.hidden ? '0' : '1' %>"><%- fx.icon(p.hidden ? 'show' : 'hide') %><%= p.hidden ? 'Unhide everywhere' : 'Hide everywhere' %></button>
              <button type="button" role="menuitem" data-act="admin-lock" data-on="<%= p.locked ? '0' : '1' %>"><%- fx.icon(p.locked ? 'unlock' : 'lock') %><%= p.locked ? 'Unlock comments' : 'Lock comments' %></button>
              <% if (!p.mine && !p.deleted) { %><button type="button" role="menuitem" class="danger" data-act="admin-delete"><%- fx.icon('trash') %>Delete for everyone</button><% } %>
              <% if (viewer.class === 'Admin') { %><button type="button" role="menuitem" data-act="details"><%- fx.icon('shield') %>Details (admin)</button><% } %>
            <% } %>
          </div>
        </details>
      <% } %>
      <% if (p.cost) { %><span class="cost" title="Paid to post"><%= Number(p.cost).toLocaleString('en-US') %> PAT</span><% } %>
    </div>
    <% if (p.mine) { %>
      <form class="fp-editf hide" data-act="edit-save">
        <input name="title" maxlength="140" value="<%= p.title %>" placeholder="Title (optional)" aria-label="Title">
        <textarea name="body" maxlength="5000" rows="4" aria-label="Text"><%= p.body %></textarea>
        <div class="row"><label class="ck"><input type="checkbox" name="nsfw"<%= p.nsfwAuthor ? ' checked' : '' %>> NSFW</label>
          <% if (p.onProfile) { %><label class="ck" title="Off: only on your profile and in your followers' Following"><input type="checkbox" name="inAll"<%= p.inAll ? ' checked' : '' %>> Also show in All</label><% } %>
          <span class="grow"></span><span class="fc-err" role="alert"></span><button type="button" class="btn-g" data-act="edit-cancel">Cancel</button><button type="submit" class="btn-s">Save</button></div>
      </form>
    <% } %>
  </div>
</article>
