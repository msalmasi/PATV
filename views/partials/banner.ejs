<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<%# views/partials/banner.ejs — the homepage banner slot (1.99kk, banner.js pick()). Locals: bn = {ad, paid, kind, promo, headline,
    line, image, alt, href, external, domain, by, vars, bookable}. A paid banner says "Sponsored" (+ who bought it); a house promo
    says "From PATV". Member text is always escaped; a house promo without its own text uses the translated built-in text.
    1.99kz: house promos have their own look - Pepeball gets a lotto card (the exact jackpot counting up, a live countdown
    to the draw + its time in the viewer's zone, tickets sold, a "Buy tickets" button, bouncing balls); the others an accent
    colour, an icon and a call-to-action chip. Motion is off under prefers-reduced-motion. A promo with an admin's own text
    keeps the plain card. Impressions: a beacon once the banner is at least half on screen for a second (aggregate counts only).
    1.99sw: cleanup - the label is an eyebrow above the headline (it touched the CTA as a corner tag), one centred row (max
    960px), even vertical padding, "Your banner here" under the CTA; a picture booking keeps its label + credit in the row below.
    1.99uk: re-layout - the content is left-aligned from the card's padding (no centred group), the CTA alone on the right and
    vertically centred, and "Your banner here" moved into the label row ("FROM PATV · Your banner here") so nothing hangs
    under the CTA. Same on a picture booking's row below the picture. %>
<%
  const B_ = bn;
  const V_ = B_.vars || {};
  const builtIn_ = (part) => (B_.promo && B_.promo !== 'custom' ? t('banner.promo.' + (B_.promo === 'support' && V_.promo_on ? 'support_promo' : B_.promo) + '.' + part, V_) : '');   // 1.99tq: a live donation promo
  const lab_ = B_.paid ? t('banner.sponsored') : t('banner.from_patv');
  const ICON_ = { lotto: '🎟️', season_pass: '🎟️', prime_time: '📺', plex: '📼', wheel: '🎡', support: '💖' };
  const house_ = !B_.paid && B_.kind !== 'image' && !!ICON_[B_.promo] && !B_.headline && !B_.line;
  const lotto_ = house_ && B_.promo === 'lotto' && V_.jackpot_n > 0;
  const fmt_ = (n) => Math.round(Number(n) || 0).toLocaleString('en-US');
  // the built-in headline without its leading emoji (the icon bubble shows it)
  const bare_ = (s) => String(s || '').replace(/^\s*(?:\p{Extended_Pictographic}|️|‍)+\s*/u, '');
  const left_ = (sec) => { const s = Math.max(0, Math.floor(sec)); const d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60);
    return d ? d + 'd ' + h + 'h ' + m + 'm' : h ? h + 'h ' + m + 'm ' + (s % 60) + 's' : m + 'm ' + (s % 60) + 's'; };
  const now_ = Date.now() / 1000;
  const when_ = lotto_ && V_.next_at ? (typeof tzTime === 'function' ? tzTime(V_.next_at, 'full') : t.esc(V_.draw || '')) : '';
%>
<style>
  /* G6 polish: ds tokens, radius 16 (a card), logical properties, 44px CTAs; the homepage grid gives the spacing (no own margin).
     1.99uk layout: one full-width row (.bn-in), left-aligned - [icon | eyebrow + headline + line | CTA] - vertically centred
     (align-items: center) with even padding. The eyebrow is "From PATV" / "Sponsored" (+ kicker / credit) + " · Your banner
     here", so the label never touches the CTA and nothing stacks under the CTA. The link (headline + line) covers the whole
     card (a stretched ::after); "Your banner here" is its own link above it (z-index 2). Phones stack: content, then the CTA. */
  .bn { position: relative; display: block; margin: 0; border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); background: linear-gradient(90deg, var(--ds-green-bg), var(--ds-surface) 60%); overflow: hidden; min-width: 0; }
  .bn.paid { background: var(--ds-surface); }
  .bn-in { display: flex; align-items: center; justify-content: flex-start; gap: var(--ds-sp-3) var(--ds-sp-5); min-height: 76px; padding: var(--ds-sp-4) var(--ds-sp-5); }
  .bn-a { color: var(--ds-text); text-decoration: none; min-width: 0; }
  a.bn-a::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  a.bn-a:focus-visible { outline: none; }
  a.bn-a:focus-visible::after { box-shadow: inset 0 0 0 2px var(--ds-focus); }
  a.bn-a:hover .bn-h, a.bn-a:focus-visible .bn-h { text-decoration: underline; text-underline-offset: 3px; }
  .bn-tx { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: center; gap: 2px; min-width: 0; text-align: start; }
  .bn-body { display: flex; flex-direction: column; gap: 2px; }
  .bn-eb { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 8px; margin-bottom: 4px; font-size: var(--ds-fs-xs); line-height: 1.4; color: var(--ds-text-muted); }
  .bn-lbl { flex: none; display: inline-block; padding: 0 8px; border-radius: var(--ds-r-pill); background: rgba(0,0,0,.4); border: 1px solid var(--acb, #3a3a3a); color: #c4c4c4; font: 700 10.5px/18px var(--ds-font); letter-spacing: var(--ds-ls-label); text-transform: uppercase; white-space: nowrap; }
  .bn-h { font: 700 16px/1.35 var(--ds-font); color: var(--ds-text-strong); overflow-wrap: anywhere; }
  .bn-l { font-size: var(--ds-fs-sm); line-height: 1.45; color: var(--ds-text-2); overflow-wrap: anywhere; }
  .bn-own { position: relative; z-index: 2; font-size: var(--ds-fs-xs); line-height: 1.4; color: var(--ds-text-muted); text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
  .bn-own:hover, .bn-own:focus-visible { color: var(--ds-text); }
  .bn-own:focus-visible { outline: 2px solid var(--ds-focus); outline-offset: 2px; border-radius: 4px; }
  .bn-ownw { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; }   /* the dot wraps with the link, never dangles */
  .bn-sep { color: var(--ds-text-faint); }

  /* a picture booking: the picture is the card (nothing drawn over it); the label, the credit and "Your banner here" a row below */
  .bn.img .bn-a { display: block; }
  .bn.img img { display: block; width: 100%; height: auto; aspect-ratio: 6 / 1; object-fit: cover; }
  .bn-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; padding: var(--ds-sp-2) var(--ds-sp-4); font-size: var(--ds-fs-xs); color: var(--ds-text-muted); }
  .bn-foot .bn-eb { margin: 0; }

  /* 1.99kz: house promos - accent colour (--ac / --ac2), icon bubble, call-to-action chip with a slow shine */
  .bn.hp { --ac: #4caf50; --ac2: #1b3a1f; --acb: #3a5a3e; border-color: var(--acb); background: radial-gradient(120% 140% at 0% 0%, var(--ac2), var(--ds-surface) 62%); }
  .bn-ic { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--ds-r-lg); font: 24px/1 var(--ds-font-emoji); background: rgba(0,0,0,.35); border: 1px solid var(--acb); }
  .bn.hp .bn-lbl { color: var(--ac); }
  .bn-cta { box-sizing: border-box; flex: none; position: relative; overflow: hidden; display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; min-width: 148px; padding: 0 var(--ds-sp-5); border-radius: var(--ds-r-pill); font: 700 15px/1.1 var(--ds-font); color: #141414; background: var(--ac); white-space: nowrap; }
  .bn-cta::after { content: ""; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,.55) 50%, transparent 70%); transform: translateX(-120%); animation: bnShine 4.5s ease-in-out 1.2s infinite; }
  .bn:has(a.bn-a:hover) .bn-cta, .bn:has(a.bn-a:focus-visible) .bn-cta { filter: brightness(1.12); }
  .bn.k-season_pass { --ac: #ffd54f; --ac2: #3a3010; --acb: #6b5a20; }
  .bn.k-prime_time { --ac: #64b5f6; --ac2: #0f2638; --acb: #24527a; }
  .bn.k-plex { --ac: #ffa726; --ac2: #3a2408; --acb: #7a4f12; }
  .bn.k-wheel { --ac: #f06292; --ac2: #3a1024; --acb: #7a2448; }
  .bn.k-support { --ac: #ff7c9c; --ac2: #3d0f1d; --acb: #7a2440; }

  /* Pepeball: the lotto card */
  .bn.k-lotto { --ac: var(--ds-gold); --acb: var(--ds-acc-lotto); border-color: var(--ds-acc-lotto); background: radial-gradient(90% 160% at 100% 0%, rgba(255,215,64,.18), transparent 55%), linear-gradient(120deg, var(--ds-lotto-bg), #3d1460 45%, #1b0b30); }
  .bn.k-lotto .bn-in { gap: var(--ds-sp-3) var(--ds-sp-6); }
  .bn-balls { flex: none; display: flex; gap: 4px; align-items: center; height: 48px; }
  .bn-ball { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; font: 700 11px/1 var(--ds-font); color: #222; background: radial-gradient(circle at 35% 30%, #fff, #e8e8e8 45%, #b8b8b8); box-shadow: 0 2px 4px rgba(0,0,0,.4); animation: bnBounce 1.8s ease-in-out infinite; }
  .bn-ball:nth-child(2) { animation-delay: .2s; } .bn-ball:nth-child(3) { animation-delay: .4s; } .bn-ball:nth-child(4) { animation-delay: .6s; }
  .bn-ball.pb { color: #fff; background: radial-gradient(circle at 35% 30%, #9ef09e, #3fa34d 50%, #1d5c27); animation-delay: .8s; }
  .bn-kick { font: 700 var(--ds-fs-label)/1.4 var(--ds-font); letter-spacing: var(--ds-ls-label); text-transform: uppercase; color: var(--ds-acc-lotto-2); }
  .bn-jp { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 8px; font: 700 34px/1.05 var(--ds-font); color: var(--ds-gold-text); text-shadow: 0 0 18px rgba(255,215,64,.35); font-variant-numeric: tabular-nums; }
  .bn-jp small { font-size: 15px; font-weight: 700; color: #ffecb3; letter-spacing: .05em; }
  .bn-meta { display: flex; flex-wrap: wrap; gap: 2px 14px; margin-top: 2px; font-size: 13px; color: #d9c8f0; }
  .bn-meta b { color: #fff; font-variant-numeric: tabular-nums; }
  .bn-meta time { color: #d9c8f0; }
  .bn.k-lotto .bn-cta { min-height: 52px; padding: 0 var(--ds-sp-6); font-size: 16px; color: var(--ds-on-gold); background: var(--ds-gold-grad); box-shadow: 0 3px 14px rgba(255,196,0,.35); }
  .bn.k-lotto .bn-lbl { background: rgba(20,6,36,.7); color: var(--ds-acc-lotto-2); }

  @keyframes bnShine { 0%, 70% { transform: translateX(-120%); } 100% { transform: translateX(120%); } }
  @keyframes bnBounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) { .bn-cta::after, .bn-ball { animation: none; } }

  /* phones: icon + text on one row, the CTA full width under them ("Your banner here" stays in the label row) */
  @media (max-width: 520px) {
    .bn-in { flex-wrap: wrap; gap: var(--ds-sp-3); padding: var(--ds-sp-3h) var(--ds-sp-3h) var(--ds-sp-3); }
    .bn-h { font-size: 15px; }
    .bn-ic { width: 40px; height: 40px; font-size: 21px; }
    .bn-tx { flex-basis: calc(100% - 52px); }
    .bn-in > .bn-tx:first-child { flex-basis: 100%; }
    .bn-cta { flex-basis: 100%; }
    .bn.k-lotto .bn-balls { flex-basis: 100%; height: 28px; }
    .bn.k-lotto .bn-ball { width: 22px; height: 22px; font-size: 10px; }
    .bn.k-lotto .bn-tx { flex-basis: 100%; }
    .bn-jp { font-size: 30px; }
    .bn-foot { padding: var(--ds-sp-2) var(--ds-sp-3); }
  }
</style>
<%
  // the link: the eyebrow + text (the stretched ::after makes the whole card clickable); no link -> a plain block
  const aOpen_ = (cls) => B_.href
    ? '<a class="bn-a ' + cls + '" href="' + t.esc(B_.href) + '"' + (B_.external ? ' target="_blank" rel="' + (B_.paid ? 'sponsored ' : '') + 'noopener noreferrer"' : (B_.paid ? ' rel="sponsored"' : '')) + '>'
    : '<div class="bn-a ' + cls + '">';
  const aClose_ = B_.href ? '</a>' : '</div>';
  const credit_ = B_.paid && (B_.by || B_.domain);
  // "Your banner here" rides at the end of the label row, after a dot that wraps with it (never under the CTA)
  const own_ = B_.bookable ? '<span class="bn-ownw"><span class="bn-sep" aria-hidden="true">·</span><a class="bn-own" href="/sponsor">' + t('banner.your_ad') + '</a></span>' : '';
  const cta_ = lotto_ ? t('banner.lotto.cta') : house_ ? t('banner.cta.' + B_.promo) : '';
%>
<aside class="bn<%= B_.paid ? ' paid' : '' %><%= B_.kind === 'image' ? ' img' : '' %><%= house_ ? ' hp k-' + B_.promo : '' %>" data-bn="<%= B_.ad %>" aria-label="<%- lab_ %>">
<% if (B_.kind === 'image' && B_.image) { %>
  <%- aOpen_('bn-pic') %><img src="<%= B_.image %>" alt="<%= B_.alt || '' %>" width="1200" height="200" loading="lazy" decoding="async"><%- aClose_ %>
  <div class="bn-foot">
    <span class="bn-eb"><span class="bn-lbl"><%- lab_ %></span><% if (credit_) { %><span><% if (B_.by) { %><%- t('banner.by', { name: '@' + B_.by }) %><% } %><% if (B_.by && B_.domain) { %> · <% } %><% if (B_.domain) { %><%= B_.domain %><% } %></span><% } %><%- own_ %></span>
  </div>
<% } else { %>
  <div class="bn-in">
    <% if (lotto_) { %>
      <span class="bn-balls" aria-hidden="true"><span class="bn-ball">7</span><span class="bn-ball">19</span><span class="bn-ball">23</span><span class="bn-ball">28</span><span class="bn-ball pb">P</span></span>
    <% } else if (house_) { %>
      <span class="bn-ic" aria-hidden="true"><%= ICON_[B_.promo] %></span>
    <% } %>
    <div class="bn-tx">
      <span class="bn-eb">
        <span class="bn-lbl"><%- lab_ %></span>
        <% if (lotto_) { %><span class="bn-kick"><%- t('banner.lotto.kicker') %></span><% } %>
        <% if (credit_) { %><span><% if (B_.by) { %><%- t('banner.by', { name: '@' + B_.by }) %><% } %><% if (B_.by && B_.domain) { %> · <% } %><% if (B_.domain) { %><%= B_.domain %><% } %></span><% } %>
        <%- own_ %>
      </span>
      <%- aOpen_('bn-body') %>
      <% if (lotto_) { %>
        <span class="bn-jp"><span data-bn-count="<%= V_.jackpot_n %>"><%= fmt_(V_.jackpot_n) %></span><small>PAT</small></span>
        <span class="bn-meta">
          <% if (V_.next_at) { %><span><%- V_.next_at > now_ ? t('banner.lotto.draw_in', { left: '<b data-bn-cd="' + Math.round(V_.next_at) + '">' + left_(V_.next_at - now_) + '</b>' }) : t('banner.lotto.drawing') %><% if (when_) { %> · <%- when_ %><% } %></span><% } %>
          <% if (V_.sold > 0) { %><span><%- t('banner.lotto.sold', { n: '<b>' + fmt_(V_.sold) + '</b>' }) %></span><% } %>
        </span>
      <% } else if (house_) { %>
        <span class="bn-h"><%- bare_(builtIn_('h')) %></span>
        <span class="bn-l"><%- builtIn_('l') %></span>
      <% } else { %>
        <span class="bn-h"><% if (B_.headline) { %><%= B_.headline %><% } else { %><%- builtIn_('h') %><% } %></span>
        <% if (B_.line || (!B_.headline && B_.promo && B_.promo !== 'custom')) { %><span class="bn-l"><% if (B_.line) { %><%= B_.line %><% } else { %><%- builtIn_('l') %><% } %></span><% } %>
      <% } %>
      <%- aClose_ %>
    </div>
    <% if (cta_) { %><span class="bn-cta" aria-hidden="true"><%- cta_ %></span><% } %>
  </div>
<% } %>
</aside>
<script>
(function () {
  'use strict';
  var el = document.querySelector('aside.bn[data-bn]');
  if (!el) return;
  // 1.99kz: the Pepeball card - the jackpot counts up once and the countdown ticks (no count-up under reduced motion)
  var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var jp = el.querySelector('[data-bn-count]');
  if (jp && !still && window.requestAnimationFrame) {
    var to = Number(jp.getAttribute('data-bn-count')) || 0, t0 = null, dur = 1400;
    var show = function (n) { jp.textContent = Math.round(n).toLocaleString('en-US'); };
    show(to * 0.6);
    var step = function (ts) { if (t0 === null) t0 = ts; var k = Math.min(1, (ts - t0) / dur); show(to * (0.6 + 0.4 * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  }
  var cd = el.querySelector('[data-bn-cd]');
  if (cd) {
    var at = Number(cd.getAttribute('data-bn-cd')) || 0;
    var tick = function () {
      var s = Math.max(0, Math.floor(at - Date.now() / 1000)), d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60);
      cd.textContent = d ? d + 'd ' + h + 'h ' + m + 'm' : h ? h + 'h ' + m + 'm ' + (s % 60) + 's' : m + 'm ' + (s % 60) + 's';
      if (s > 0) setTimeout(tick, 1000);
    };
    tick();
  }
  if (!('IntersectionObserver' in window)) return;
  var sent = false, timer = null;
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) {
      if (sent) return;
      if (e.isIntersecting && e.intersectionRatio >= 0.5) {
        timer = timer || setTimeout(function () {
          sent = true; io.disconnect();
          fetch('/api/banner/seen', { method: 'POST', credentials: 'same-origin', keepalive: true,
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' }, body: JSON.stringify({ ad: el.getAttribute('data-bn') }) }).catch(function () {});
        }, 1000);
      } else if (timer) { clearTimeout(timer); timer = null; }
    });
  }, { threshold: [0, 0.5, 1] });
  io.observe(el);
})();
</script>
