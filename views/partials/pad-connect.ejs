<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<%# 1.99ja: the settings hub's platform connections (padconnect.js; public/js/pad-connect.js). Locals: slug, room, connect
    (padconnect.state: platform, camfrog, twitch, twitchLinked, twitchLogin, ownerIsViewer, staff, admin, code_ttl_h, pepeIn). %>
<% const CN_ = connect, CF_ = CN_.camfrog, TW_ = CN_.twitch, PL_ = CN_.platform;
   const dt_ = (ms) => new Date(Number(ms) || 0).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
   const next_ = encodeURIComponent('/p/' + slug + '/settings?tab=address#connections'); %>
<div class="sb-card ps-card pcn" id="connections" data-base="/api/rooms/<%= encodeURIComponent(slug) %>">
  <h3><%- t('pad.conn.h') %></h3>
  <p class="muted"><%- t('pad.conn.intro', { badge: typeof padBadge === 'function' ? padBadge(PL_) : PL_ }) %></p>

  <div class="pcn-p" id="pcnCamfrog">
    <h4><%- t('pad.conn.cf_h') %></h4>
    <% if (CN_.house) { %>
      <p class="note"><%- t('pad.conn.house') %></p>
    <% } else if (PL_ === 'camfrog') { %>
      <p><%- t('pad.conn.cf_connected', { name: (CF_ && CF_.external_name) || room.id }) %> <small class="muted">(<%- t('pad.conn.room_id', { id: '<code>' + t.esc(room.id) + '</code>' }) %><%- CF_ && CF_.verified_at ? ', ' + t('pad.conn.since', { date: dt_(CF_.verified_at).slice(0, 10) }) : '' %>)</small>.</p>
      <% if (CF_) { %>
        <label class="ps-switch"><input type="checkbox" id="pcnJoin"<%= CF_.join_opt_in ? ' checked' : '' %>><span class="ps-sw" aria-hidden="true"></span>
          <span><%- t('pad.conn.want_pepe') %> <small class="muted">(<%- t('pad.conn.admin_approves') %> <%- CF_.join_status === 'approved' ? t('pad.conn.approved') : CF_.join_status === 'requested' ? t('pad.conn.waiting_admin') : CF_.join_status === 'denied' ? t('pad.conn.declined') : t('pad.conn.not_asked') %><%- CN_.pepeIn ? ' · ' + t('pad.conn.pepe_in') : '' %>)</small></span></label>
      <% } %>
      <details class="pcn-danger"><summary><%- t('pad.conn.cf_disc') %></summary>
        <p class="muted"><%- t('pad.conn.cf_disc_what') %></p>
        <button type="button" class="btn danger" data-pcn="disconnect" data-platform="camfrog"><%- t('pad.conn.cf_disc_btn') %></button>
      </details>
    <% } else if (PL_ !== 'site') { %>
      <p class="muted"><%- t('pad.conn.disc_first', { platform: PL_ }) %></p>
    <% } else if (CF_ && (CF_.status === 'pending' || CF_.status === 'review')) { %>
      <p><%- t('pad.conn.connecting', { name: CF_.external_name }) %></p>
      <p class="pcn-code"><code id="pcnCode"><%= CF_.code %></code> <button type="button" class="btn-s ghost" data-pcn="copy"><%- t('pad.conn.copy') %></button> <small class="muted"><%- t('pad.conn.valid_until', { date: dt_(CF_.code_expires) }) %></small></p>
      <ol class="pcn-steps">
        <li><%- t('pad.conn.step_topic', { code: '<code>' + t.esc(CF_.code) + '</code>' }) %></li>
        <li><%- t('pad.conn.step_cmd', { cmd: '<code>!verifypad ' + t.esc(CF_.code) + '</code>' }) %><%- CF_.status === 'review' ? t('pad.conn.review_done') : '' %>.</li>
      </ol>
      <p class="muted"><%- t('pad.conn.pepe_needed') %></p>
      <div class="row"><button type="button" class="btn" data-pcn="check"><%- t('pad.conn.check') %></button><button type="button" class="btn-s ghost" data-pcn="disconnect" data-platform="camfrog" data-soft="1"><%- t('pad.conn.cancel') %></button><span class="msg" id="pcnCfMsg" role="status" aria-live="polite"></span></div>
    <% } else { %>
      <form id="pcnCfForm" class="ps-form" autocomplete="off">
        <label class="fld"><%- t('pad.conn.room_name') %> <small class="muted"><%- t('pad.conn.room_name_hint') %></small><input type="text" name="room" maxlength="64" required placeholder="<%- t('pad.conn.room_ph') %>"></label>
        <label class="chk"><input type="checkbox" name="join"> <%- t('pad.conn.want_pepe') %> <small class="muted"><%- t('pad.conn.never_own') %></small></label>
        <div class="row"><button type="submit" class="btn primary"><%- t('pad.conn.get_code') %></button><span class="msg" id="pcnCfMsg" role="status" aria-live="polite"></span></div>
      </form>
      <% if (CF_ === null) { %><p class="muted ps-mini"><%- t('pad.conn.prove', { h: CN_.code_ttl_h }) %></p><% } %>
    <% } %>
  </div>

  <div class="pcn-p" id="pcnTwitch">
    <h4><%- t('pad.conn.tw_h') %></h4>
    <% if (PL_ === 'twitch' && TW_) { %>
      <p><%- t('pad.conn.tw_connected', { link: '<a href="https://twitch.tv/' + t.esc(TW_.external_id) + '" rel="noopener" target="_blank">twitch.tv/' + t.esc(TW_.external_id) + '</a>' }) %></p>
      <p class="muted ps-mini"><%- t('pad.conn.tw_also', { link: '<a href="/stage">' + t('pad.conn.go_live') + '</a>' }) %></p>
      <details class="pcn-danger"><summary><%- t('pad.conn.tw_disc') %></summary>
        <p class="muted"><%- t('pad.conn.tw_disc_what') %></p>
        <button type="button" class="btn danger" data-pcn="disconnect" data-platform="twitch"><%- t('pad.conn.tw_disc_btn') %></button>
      </details>
    <% } else if (CN_.house) { %>
      <p class="note"><%- t('pad.conn.house') %></p>
    <% } else if (PL_ !== 'site') { %>
      <p class="muted"><%- t('pad.conn.disc_first', { platform: PL_ }) %></p>
    <% } else if (!CN_.ownerIsViewer) { %>
      <p class="muted"><%- t('pad.conn.owner_only') %></p>
    <% } else if (CN_.twitchLogin) { %>
      <p><%- t('pad.conn.linked_to', { login: CN_.twitchLogin }) %></p>
      <div class="row"><button type="button" class="btn primary" data-pcn="twitch"><%- t('pad.conn.make_tw', { login: CN_.twitchLogin }) %></button><span class="msg" id="pcnTwMsg" role="status" aria-live="polite"></span></div>
    <% } else if (CN_.twitchLinked) { %>
      <p class="muted"><%- t('pad.conn.tw_relogin', { link: '<a href="/auth/twitch?next=' + t.esc(next_) + '">' + t('pad.conn.tw_signin') + '</a>' }) %></p>
    <% } else { %>
      <p class="muted"><%- t('pad.conn.tw_link_first') %> <a class="btn" href="/auth/twitch?next=<%= next_ %>"><%- t('pad.conn.tw_link') %></a></p>
    <% } %>
  </div>

  <div class="pcn-p" id="pcnDiscord">
    <h4><%- t('pad.conn.dc_h') %></h4>
    <p class="muted"><%- t('pad.conn.later') %></p>
  </div>
</div>
<style>
  .pcn .pcn-p { border-top: 1px solid var(--line, #2a2a2a); padding-top: 10px; margin-top: 10px; }
  .pcn h4 { margin: 0 0 6px; }
  .pcn .pcn-code code { font-size: 1.3em; letter-spacing: .08em; padding: 4px 10px; border-radius: 8px; background: #111; border: 1px solid #333; }
  .pcn .pcn-steps { margin: 6px 0; padding-left: 20px; line-height: 1.6; }
  .pcn .pcn-danger summary { cursor: pointer; color: #ef9a9a; margin: 6px 0; }
  .pcn .btn.danger { background: #5a1a1a; border-color: #8a2a2a; color: #fff; }
</style>
<script src="/public/js/pad-connect.js?v=1" defer></script>
