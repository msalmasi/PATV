<%# Recent website actions for this page. Pass { acts, msg }. Auto-refreshes while any are waiting. %>
<%# 1.99bj: every form that posts to /act gets a one-time key (idem) and can only be sent once per page
    load - a double click or an impatient second press is one action, not two (actions.js refuses a
    repeated key, Pepe journals it too). %>
<script>
(function () {
  if (window.__actIdem) return;
  window.__actIdem = true;
  function key() {
    try { if (window.crypto && crypto.randomUUID) return crypto.randomUUID().replace(/-/g, ""); } catch (e) {}
    var s = "";
    for (var i = 0; i < 32; i++) s += Math.floor(Math.random() * 16).toString(16);
    return s;
  }
  function tag(f) {
    if (!f || f.getAttribute("action") !== "/act") return null;
    var el = f.querySelector('input[name="idem"]');
    if (!el) {
      el = document.createElement("input");
      el.type = "hidden";
      el.name = "idem";
      el.value = key();
      f.appendChild(el);
    }
    return el;
  }
  function tagAll() { Array.prototype.forEach.call(document.querySelectorAll('form[action="/act"]'), tag); }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", tagAll); else tagAll();
  // bubble phase, so a form's own onsubmit (e.g. a confirm() that was cancelled) has already had its say
  document.addEventListener("submit", function (e) {
    var f = e.target;
    if (!tag(f) || e.defaultPrevented) return;
    if (f.getAttribute("data-act-sent")) { e.preventDefault(); return; }
    f.setAttribute("data-act-sent", "1");
    // next tick: a button disabled DURING the submit event would drop its own name=value from the post
    setTimeout(function () {
      Array.prototype.forEach.call(f.querySelectorAll('button[type="submit"], button:not([type]), input[type="submit"]'), function (b) {
        b.disabled = true;
        b.setAttribute("aria-busy", "true");
      });
    }, 0);
  });
  // back-button (bfcache) restore: the page is usable again, with fresh keys
  window.addEventListener("pageshow", function (e) {
    if (!e.persisted) return;
    Array.prototype.forEach.call(document.querySelectorAll('form[action="/act"]'), function (f) {
      f.removeAttribute("data-act-sent");
      var el = tag(f);
      if (el) el.value = key();
      Array.prototype.forEach.call(f.querySelectorAll("[aria-busy]"), function (b) { b.disabled = false; b.removeAttribute("aria-busy"); });
    });
  });
})();
</script>
<% if (typeof msg !== 'undefined' && msg) { %><p class="act-notice"><%= msg %></p><% } %>
<% if (typeof acts !== 'undefined' && acts && acts.length) { %>
  <div class="act-box">
    <div class="act-head">Your recent requests to Pepe</div>
    <% acts.forEach((a) => { %>
      <div class="act-row act-<%= a.status %>">
        <span class="act-st"><%= a.status === 'done' ? '✅' : a.status === 'failed' ? '❌' : '⏳' %></span>
        <span class="act-label"><%= a.label %></span>
        <%# 1.99du: Pepe sends the reason (bot 1.99ds: "something went wrong: <type>: <reason>"); the bare legacy
            string is from the 2026-10-05 webact bug (fixed in the bot's 1.99ae) - say so instead of nothing %>
        <%# 1.99ep: a failure carries a stable error code (weberrors.js, decorated as a.err by actions.recentFor):
            the friendly message (Pepe's own reply when he gave one), a hint, and the code in small print for support %>
        <% if (a.err) { %>
        <span class="act-msg"><%= a.err.message %></span>
        <span class="act-hint"><%= a.err.hint %></span>
        <span class="act-code">code <%= a.err.code %><%= a.err.incident ? ' · incident ' + a.err.incident : '' %></span>
        <% } else { %>
        <span class="act-msg"><%= a.status === 'pending' || a.status === 'claimed' ? 'waiting for Pepe…'
          : /^\s*something went wrong\.?\s*$/i.test(a.message || '') ? 'Pepe hit a bug on his side (since fixed) — nothing happened, so just try again.'
          : /^\s*something went wrong:/i.test(a.message || '') ? 'Something went wrong on Pepe\'s side. Check your balance before trying again.'
          : (a.message || (a.status === 'failed' ? 'Pepe couldn\'t do it (no reason given).' : '')) %></span>
        <% } %>
      </div>
    <% }) %>
  </div>
  <% if (acts.some((a) => a.status === 'pending' || a.status === 'claimed')) { %>
    <script>setTimeout(() => location.replace(location.pathname + location.search.replace(/[?&]msg=[^&]*/, '')), 4000)</script>
  <% } %>
<% } %>
<style>
  .act-notice { background: #13200f; border: 1px solid #4caf50; border-radius: 8px; padding: 10px 12px; }
  .act-box { border: 1px solid #222; border-radius: 10px; background: #0d0d0d; margin: 12px 0; overflow: hidden; }
  .act-head { font-size: 12px; color: #888; padding: 8px 12px; border-bottom: 1px solid #1c1c1c; }
  .act-row { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 2px 8px; padding: 8px 12px; border-bottom: 1px solid #161616; font-size: 13px; }
  .act-row:last-child { border-bottom: 0; }
  .act-label { color: #bbb; font-family: monospace; overflow-wrap: anywhere; }
  .act-msg { grid-column: 2; color: #e0e0e0; overflow-wrap: anywhere; }
  .act-failed .act-msg { color: #e57373; }
  .act-hint { grid-column: 2; color: #9e9e9e; font-size: 12px; }
  .act-code { grid-column: 2; color: #666; font-size: 11px; font-family: monospace; }
</style>
