<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<%#
  Profile → Analytics (userstats.js builds `a`). `L` (profilelayout.js view) decides what shows:
    * plain panels (an_*): Public or Hidden — hidden ones render greyed for the owner/admins only
    * privacy panels — top words (an_words), moderated against (an_modon), the itemised mod-action list
      (an_modlist), moderation commands (an_modcmds): Public / Only me & admins / Hidden. userstats.js
      only puts their data in `a` when this viewer may see them (a.words empty, a.mod.on null,
      a.mod.byRecent empty, no moderation commands), so the template just renders what it's given and tags it.
%>
<%
  const LL = typeof L !== 'undefined' && L ? L : null;
  const sub = (id) => !LL || LL.show(id);
  const hc = (id) => (LL && LL.hidden(id) ? ' ua-hid' : '');
  const ht = (id) => (LL && LL.hidden(id) ? '<span class="ua-hidtag">\u{1F441} ' + t('profile.hidden_from_visitors') + '</span>' : '');
  // "only me & admins" panels: a lock tag (only ever rendered for the owner/admins — visitors don't get the panel)
  const isPriv = (id) => !!(LL && LL.priv && LL.priv(id) && !LL.hidden(id));
  const pt = (id) => (isPriv(id) ? '<span class="lock">\u{1F512} ' + (LL.owner ? t('profile.an.only_you') : t('profile.an.only_owner')) + '</span>' : '');
%>
<style>
  .ua { display: grid; gap: 18px; }
  .ua-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px 14px; flex-wrap: wrap; }
  .ua-head h2 { margin: 0; }
  .ua .tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .ua .tile { background: #0d0d0d; border: 1px solid #1f1f1f; border-radius: 10px; padding: 11px 13px; min-width: 0; }
  .ua .tile .k { font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: #888; }
  .ua .tile .v { font-size: 21px; font-weight: bold; margin-top: 3px; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; line-height: 1.2; }
  .ua .tile .v.sm { font-size: 16px; }
  .ua .tile .s { font-size: 12px; color: #888; margin-top: 2px; }
  .ua .dot { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 6px; vertical-align: 1px; }
  .ua .blk { display: grid; gap: 8px; min-width: 0; }
  .ua .blk-top { display: flex; justify-content: space-between; align-items: baseline; gap: 6px 12px; flex-wrap: wrap; font-size: 14px; }
  .ua .blk-top b { color: #ddd; font-weight: 600; }
  .ua-bars { position: relative; padding: 0 0 20px 40px; }
  .ua-chart { display: block; width: 100%; height: 132px; overflow: visible; }
  .ua-grid { stroke: #232323; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .ua-base { stroke: #3a3a3a; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .ua-hit { fill: transparent; cursor: crosshair; }
  .ua-hit:hover { fill: rgba(255,255,255,.06); }
  .ua-yl { position: absolute; left: 0; top: 0; width: 34px; height: 132px; }
  .ua-yl span { position: absolute; right: 0; transform: translateY(-50%); font-size: 11px; color: #777; font-variant-numeric: tabular-nums; }
  .ua-xl { position: absolute; left: 40px; right: 0; bottom: 0; height: 16px; }
  .ua-xl span { position: absolute; transform: translateX(-50%); font-size: 11px; color: #777; white-space: nowrap; }
  .ua-xl span.end { transform: translateX(-100%); }
  .ua-hrow { display: grid; grid-template-columns: 40px minmax(0, 1fr); align-items: center; gap: 0; margin-bottom: 5px; }
  .ua-hname { font-size: 12px; color: #999; }
  .ua-cells { display: grid; grid-template-columns: repeat(24, minmax(0, 1fr)); gap: 2px; }
  .ua-cell { height: 26px; border-radius: 4px; cursor: crosshair; }
  .ua-cell:hover { outline: 1px solid #ddd; outline-offset: -1px; }
  .ua-hax { display: grid; grid-template-columns: 40px repeat(4, minmax(0, 1fr)); font-size: 11px; color: #777; }
  .ua .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
  .ua .rlist { display: grid; gap: 7px; }
  .ua .rrow { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 10px; font-size: 13px; }
  .ua .rrow .rn { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #ccc; }
  .ua .rrow .rv { color: #999; font-variant-numeric: tabular-nums; }
  .ua .rrow .rb { grid-column: 1 / -1; height: 6px; background: #1a1a1a; border-radius: 999px; overflow: hidden; }
  .ua .rrow .rb span { display: block; height: 100%; border-radius: 999px; }
  .ua .words { display: flex; flex-wrap: wrap; gap: 6px; }
  .ua .words span { font-size: 12px; padding: 3px 9px; border-radius: 999px; background: #151a15; border: 1px solid #243324; color: #b9d8bb; }
  .ua .words b { color: #6f8f71; font-weight: normal; margin-left: 4px; }
  .ua .sub { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: #9a9; margin: 0 0 8px; }
  .ua .modgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .ua .modbox { background: #0d0d0d; border: 1px solid #1f1f1f; border-radius: 10px; padding: 13px 14px; min-width: 0; }
  .ua .modbox.private { border-color: #3a2a1a; background: linear-gradient(180deg, #15100b, #0d0d0d); }
  .ua .modbox .big { font-size: 26px; font-weight: bold; font-variant-numeric: tabular-nums; }
  .ua .pills { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .ua .pill { font-size: 12px; padding: 3px 9px; border-radius: 999px; background: #161616; border: 1px solid #2a2a2a; color: #ccc; }
  .ua .pill b { color: #fff; margin-left: 3px; }
  .ua .lock { display: inline-block; white-space: nowrap; font-size: 11px; color: #c9a36a; border: 1px solid #4a3820; border-radius: 999px; padding: 1px 8px; margin-left: 6px; letter-spacing: 0; text-transform: none; vertical-align: 1px; }
  .ua table { width: 100%; border-collapse: collapse; font-size: 12.5px; margin-top: 10px; }
  .ua th { text-align: left; color: #777; font-weight: normal; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; padding: 0 6px 5px 0; }
  .ua td { padding: 5px 6px 5px 0; border-top: 1px solid #1c1c1c; color: #ccc; vertical-align: top; overflow-wrap: anywhere; }
  .ua td.t { color: #888; white-space: nowrap; }
  .ua td.w, .ua td.room { overflow-wrap: normal; word-break: normal; }
  .ua td.room { color: #999; }
  .ua .empty { color: #777; font-size: 13px; }
  .ua .cmdhead { display: flex; flex-wrap: wrap; gap: 6px 22px; align-items: baseline; }
  .ua .cmdhead .big { font-size: 26px; font-weight: bold; font-variant-numeric: tabular-nums; }
  .ua .cmdhead .muted b { color: #ccc; font-weight: normal; }
  .ua-spark { display: block; width: 100%; height: 34px; margin-top: 8px; }
  .ua .catbar { display: flex; height: 12px; border-radius: 999px; overflow: hidden; gap: 2px; background: #111; margin-top: 12px; }
  .ua .catbar span { display: block; height: 100%; min-width: 3px; }
  .ua .catleg { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 8px; font-size: 12px; color: #aaa; }
  .ua .catleg b { color: #ddd; font-weight: normal; margin-left: 3px; font-variant-numeric: tabular-nums; }
  .ua .toplist { display: grid; gap: 6px; margin-top: 4px; }
  .ua .toprow { display: grid; grid-template-columns: minmax(70px, 130px) minmax(0, 1fr) auto; gap: 10px; align-items: center; font-size: 13px; }
  .ua .toprow code { background: none; padding: 0; color: #e6e6e6; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ua .toprow .tb { height: 8px; background: #1a1a1a; border-radius: 999px; overflow: hidden; }
  .ua .toprow .tb span { display: block; height: 100%; border-radius: 999px; }
  .ua .toprow .tn { color: #999; font-variant-numeric: tabular-nums; white-space: nowrap; font-size: 12px; }
  .ua .ua-hid { position: relative; outline: 1px dashed #3a3a3a; outline-offset: 6px; border-radius: 6px; }
  .ua .ua-hid > :not(.ua-hidtag) { opacity: .45; filter: grayscale(.6); }
  .ua .ua-hidtag { position: absolute; top: -14px; right: 4px; z-index: 3; font-size: 10.5px; line-height: 1; padding: 3px 8px; border-radius: 999px;
                   background: #1d1a10; border: 1px solid #5a4a1c; color: #e8cf7a; white-space: nowrap; pointer-events: none; letter-spacing: 0; text-transform: none; }
  .ua .modbox.ua-hid { outline-offset: 3px; }
  .ua .ua-modlist { margin-top: 10px; }
  .ua .ua-modlist table { margin-top: 0; }
  .ua .ua-modlist.ua-hid { outline-offset: 3px; margin-top: 22px; padding-top: 4px; }
  .ua .ua-privnote { margin: 0 0 4px; }
  /* panel titles with a lock tag: the tag wraps flush-left on narrow screens instead of indented */
  .ua .sub, .ua .ua-ttl { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; }
  .ua .sub .lock, .ua .ua-ttl .lock, .ua .ua-privnote .lock { margin-left: 0; }
  #ua-tip { position: fixed; z-index: 50; pointer-events: none; background: #1d1d1d; color: #eee; border: 1px solid #333; border-radius: 6px;
            padding: 4px 8px; font-size: 12px; white-space: nowrap; box-shadow: 0 4px 14px rgba(0,0,0,.5); display: none; font-family: Ubuntu, sans-serif; }
  @media (max-width: 560px) {
    .ua .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ua-chart, .ua-yl { height: 110px; }
    .ua-cell { height: 20px; border-radius: 3px; }
    .ua table .room { display: none; }
  }
</style>
<section class="card ua" id="analytics">
  <div class="ua-head">
    <h2><%- t('profile.analytics') %></h2>
    <span class="muted"><%- t('profile.an.activity') %><% if (a.updated) { %> · <%- t('profile.an.updated', { when: a.updated }) %><% } %></span>
  </div>

  <% if (sub('an_tiles')) { %>
  <div class="tiles<%= hc('an_tiles') %>"><%- ht('an_tiles') %>
    <div class="tile"><div class="k"><%- t('profile.an.messages') %></div><div class="v"><%= a.tiles.messages %></div><div class="s"><%- t('profile.an.in_30_days', { n: a.tiles.messages30 }) %></div></div>
    <div class="tile"><div class="k"><%- t('profile.an.mic_time') %></div><div class="v"><%= a.tiles.micDur %></div><div class="s"><%- t('profile.an.longest', { d: a.tiles.longest }) %></div></div>
    <div class="tile"><div class="k"><%- t('profile.an.mic_sessions') %></div><div class="v"><%= a.tiles.sessions %></div><div class="s"><%- t('profile.an.avg_each', { d: a.tiles.avgSession }) %></div></div>
    <div class="tile"><div class="k"><%- t('profile.an.first_seen') %></div><div class="v sm"><%= a.tiles.first %></div><div class="s"><%- t('profile.an.by_pepe') %></div></div>
    <div class="tile"><div class="k"><%- t('profile.an.last_seen') %></div><div class="v sm"><%= a.tiles.last %></div><div class="s"><%- a.tiles.peakChat ? t('profile.an.busiest_at', { h: a.tiles.peakChat }) : t.esc('&nbsp;') %></div></div>
    <div class="tile"><div class="k"><%- t('profile.an.fav_room') %></div><div class="v sm"><%= a.tiles.favRoom %></div><div class="s"><%- t('profile.an.by_msgs_mic') %></div></div>
  </div>
  <% } %>

  <% if (sub('an_chat') || sub('an_mic')) { %>
  <div class="two">
    <% if (sub('an_chat')) { %>
    <div class="blk<%= hc('an_chat') %>"><%- ht('an_chat') %>
      <div class="blk-top"><b><span class="dot" style="background:#4caf50"></span><%- t('profile.an.msgs_per_day') %></b><span class="muted"><%- t('profile.an.last_90') %></span></div>
      <% if (a.hasChat) { %><%- a.chatChart %><% } else { %><div class="empty"><%- t('profile.an.no_chat') %></div><% } %>
    </div>
    <% } %>
    <% if (sub('an_mic')) { %>
    <div class="blk<%= hc('an_mic') %>"><%- ht('an_mic') %>
      <div class="blk-top"><b><span class="dot" style="background:#ffb74d"></span><%- t('profile.an.mic_per_day') %></b><span class="muted"><%- t('profile.an.last_90') %></span></div>
      <% if (a.hasMic) { %><%- a.micChart %><% } else { %><div class="empty"><%- t('profile.an.no_mic') %></div><% } %>
    </div>
    <% } %>
  </div>
  <% } %>

  <% if ((a.hasChat || a.hasMic) && sub('an_hours')) { %>
  <div class="blk<%= hc('an_hours') %>"><%- ht('an_hours') %>
    <div class="blk-top"><b><%- t('profile.an.time_of_day') %></b><span class="muted"><%- t('profile.an.all_time_clock') %><%= a.tz ? ' (' + a.tz + ')' : '' %><%- a.tiles.peakMic ? ' · ' + t('profile.an.mic_peaks', { h: a.tiles.peakMic }) : '' %></span></div>
    <div><%- a.hoursHtml %>
      <div class="ua-hax"><span></span><span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span></div>
    </div>
  </div>
  <% } %>

  <% if ((a.chatRooms.length || a.micRooms.length) && sub('an_rooms')) { %>
  <div class="two<%= hc('an_rooms') %>"><%- ht('an_rooms') %>
    <div>
      <div class="sub"><%- t('profile.an.rooms_chat') %></div>
      <div class="rlist">
        <% if (!a.chatRooms.length) { %><div class="empty">—</div><% } %>
        <% a.chatRooms.forEach((r) => { %>
          <div class="rrow"><span class="rn" title="<%= r.room %>"><%= r.room %></span><span class="rv"><%= r.label %></span><div class="rb"><span style="width:<%= r.pct.toFixed(1) %>%;background:#4caf50"></span></div></div>
        <% }) %>
      </div>
    </div>
    <div>
      <div class="sub"><%- t('profile.an.rooms_mic') %></div>
      <div class="rlist">
        <% if (!a.micRooms.length) { %><div class="empty">—</div><% } %>
        <% a.micRooms.forEach((r) => { %>
          <div class="rrow"><span class="rn" title="<%= r.room %>"><%= r.room %></span><span class="rv"><%= r.label %></span><div class="rb"><span style="width:<%= r.pct.toFixed(1) %>%;background:#ffb74d"></span></div></div>
        <% }) %>
      </div>
    </div>
  </div>
  <% } %>

  <% if (a.cmds && sub('an_cmds')) { const k = a.cmds; %>
  <div class="blk<%= hc('an_cmds') %>"><%- ht('an_cmds') %>
    <div class="sub"><%- t('profile.an.commands') %><% if (k.hasMod && LL && LL.hidden('an_modcmds')) { %> <span class="lock">👁 <%- t('profile.an.modcmds_hidden') %></span><% } else if (k.hasMod && isPriv('an_modcmds')) { %> <span class="lock">🔒 <%- LL.owner ? t('profile.an.modcmds_you') : t('profile.an.modcmds_owner') %></span><% } %></div>
    <div class="two">
      <div>
        <div class="cmdhead">
          <span class="big"><%= k.total %></span>
          <span class="muted"><%- t('profile.an.cmd_last30', { n: k.last30 }) %> · <%- t('profile.an.cmd_paid', { pct: k.paidPct }) %><% if (k.web !== '0') { %> · <%- t('profile.an.cmd_web', { n: k.web }) %><% } %></span>
        </div>
        <%- k.spark %>
        <div class="catbar" role="img" aria-label="<%- t('profile.an.cmds_by_cat') %>"><% k.cats.forEach((c) => { %><span style="width:<%= c.pct.toFixed(2) %>%;background:<%= c.color %>" data-tip="<%= c.label %> · <%= c.n %>"></span><% }) %></div>
        <div class="catleg"><% k.cats.forEach((c) => { %><span><span class="dot" style="background:<%= c.color %>"></span><%= c.label %><b><%= c.n %></b></span><% }) %></div>
      </div>
      <div>
        <div class="toplist">
          <% k.top.forEach((tp) => { %>
            <div class="toprow" data-tip="<%= tp.cmd %> · <%- t('profile.an.tip_uses', { n: tp.n, last: tp.last }) %> · <%= tp.cat %>"><code><%= tp.cmd %></code><div class="tb"><span style="width:<%= tp.pct.toFixed(1) %>%;background:<%= tp.color %>"></span></div><span class="tn"><%= tp.n %> · <%= tp.last %></span></div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <% if (a.words.length && sub('an_words')) { %>
  <div class="blk<%= hc('an_words') %>"><%- ht('an_words') %>
    <div class="sub"><%- t('profile.an.words') %> <%- pt('an_words') %></div>
    <div class="words"><% a.words.forEach(([w, n]) => { %><span><%= w %><b><%= n %></b></span><% }) %></div>
  </div>
  <% } %>

  <% const modOn = a.mod.on && sub('an_modon') ? a.mod.on : null; %>
  <% if (sub('an_mod') || modOn) { %>
  <div>
    <div class="sub"><%- t('profile.an.moderation') %></div>
    <div class="modgrid">
      <% if (sub('an_mod')) { %>
      <div class="modbox<%= hc('an_mod') %>"><%- ht('an_mod') %>
        <div class="muted"><%- t('settings.layout.label.an_mod') %></div>
        <div class="big"><%= t.num(a.mod.byTotal) %></div>
        <% if (a.mod.byCounts.length) { %>
          <div class="pills"><% a.mod.byCounts.forEach((c) => { %><span class="pill"><%= c.label %><b><%= c.n %></b></span><% }) %></div>
        <% } else { %><div class="empty"><%- t('profile.an.mod_none') %></div><% } %>
        <% if (a.mod.byRecent.length && sub('an_modlist')) { %>
          <div class="ua-modlist<%= hc('an_modlist') %>"><%- ht('an_modlist') %>
          <% if (isPriv('an_modlist')) { %><div class="ua-privnote"><%- pt('an_modlist') %></div><% } %>
          <table><thead><tr><th><%- t('profile.an.when') %></th><th><%- t('profile.an.action') %></th><th><%- t('profile.an.on') %></th><th class="room"><%- t('profile.an.room') %></th></tr></thead><tbody>
            <% a.mod.byRecent.forEach((e) => { %>
              <tr><td class="t" title="<%= e.when %>"><%= e.ago %></td><td><%= e.label %><%= e.note ? ' · ' + e.note : '' %></td><td class="w"><%= e.who || '—' %></td><td class="room"><%= e.room %></td></tr>
            <% }) %>
          </tbody></table>
          </div>
        <% } %>
      </div>
      <% } %>
      <% if (modOn) { %>
      <div class="modbox<%= isPriv('an_modon') ? ' private' : '' %><%= hc('an_modon') %>"><%- ht('an_modon') %>
        <div class="muted ua-ttl"><%- t('settings.layout.label.an_modon') %> <%- pt('an_modon') %></div>
        <div class="big"><%= t.num(modOn.total) %></div>
        <% if (modOn.counts.length) { %>
          <div class="pills"><% modOn.counts.forEach((c) => { %><span class="pill"><%= c.label %><b><%= c.n %></b></span><% }) %></div>
          <table><thead><tr><th><%- t('profile.an.when') %></th><th><%- t('profile.an.what') %></th><th><%- t('profile.an.by') %></th><th class="room"><%- t('profile.an.room') %></th></tr></thead><tbody>
            <% modOn.recent.forEach((e) => { %>
              <tr><td class="t" title="<%= e.when %>"><%= e.ago %></td><td><%= e.label %><%= e.note ? ' · ' + e.note : '' %></td><td class="w"><%= e.who || '—' %></td><td class="room"><%= e.room %></td></tr>
            <% }) %>
          </tbody></table>
        <% } else { %><div class="empty"><%- t('profile.an.clean') %></div><% } %>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>
</section>
<div id="ua-tip" role="tooltip"></div>
<script>
  (function () {
    var tip = document.getElementById('ua-tip'), root = document.getElementById('analytics');
    if (!tip || !root) return;
    function show(e) {
      var t = e.target.closest && e.target.closest('[data-tip]');
      if (!t || !root.contains(t)) { tip.style.display = 'none'; return; }
      tip.textContent = t.getAttribute('data-tip');
      tip.style.display = 'block';
      var x = e.clientX + 12, y = e.clientY - 34, w = tip.offsetWidth;
      if (x + w > window.innerWidth - 8) x = e.clientX - w - 12;
      tip.style.left = Math.max(8, x) + 'px';
      tip.style.top = Math.max(8, y) + 'px';
    }
    root.addEventListener('pointermove', show);
    root.addEventListener('pointerdown', show);
    root.addEventListener('pointerleave', function () { tip.style.display = 'none'; });
    // the native <title> tooltips double up with ours on desktop — drop them once JS is running
    root.querySelectorAll('[data-tip] title').forEach(function (n) { n.remove(); });
    root.querySelectorAll('.ua-cell[title]').forEach(function (n) { n.removeAttribute('title'); });
  })();
</script>
