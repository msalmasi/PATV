<%#
  1.99xk: 🎫 a pad's raffles (raffles.forPad) - the About tab's card (#raffles): the open ones (prize, price, sold / goal) and
  the last drawn, a link to /raffles filtered to this pad and the "Run a raffle" button (the create form with this pad picked).
  Pass { pr (raffles.forPad), slug }.
%>
<% const T_ = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json')));
   const pr_ = locals.pr || { open: [], past: [], count: 0 };
   const q_ = '?pad=' + encodeURIComponent(locals.slug || '');
   const n_ = (x) => Math.round(Number(x) || 0).toLocaleString('en-US'); %>
<section class="card prf" id="raffles" aria-labelledby="prfH">
  <h2 id="prfH"><span><span class="ds-ic" aria-hidden="true">🎫</span> <a href="/raffles<%= q_ %>"><%- T_('pad.raffles.h') %></a></span></h2>
  <% if (!pr_.open.length && !pr_.past.length) { %><p class="muted" style="margin:0"><%- T_('pad.raffles.empty') %></p><% } %>
  <ul>
    <% pr_.open.concat(pr_.past).forEach((r) => { const goal = r.trigger === 'target' ? r.target : r.min_tickets; %>
      <li><a href="<%= r.url %>">
        <span class="prf-q"><%= r.house ? '🏛️ ' : '' %><%= r.title %></span>
        <span class="prf-meta"><%- T_('pad.raffles.prize', { prize: r.prize.kind === 'pat' ? n_(r.prize.amount) + ' PAT' : r.prize.name }) %> ·
          <% if (r.status === 'open') { %><%- T_('pad.raffles.open', { price: n_(r.price), sold: n_(r.sold), goal: n_(goal) }) %><% } else { %><%- r.winner ? T_('pad.raffles.won', { who: r.winner }) : T_('rf.st.' + r.status) %><% } %></span>
      </a></li>
    <% }) %>
  </ul>
  <div class="prf-ctas"><a class="ds-btn sm" href="/raffles<%= q_ %>#new">＋ <%- T_('pad.raffles.new') %></a></div>
</section>
<style>
  .prf h2 a { color: inherit; text-decoration: none; }
  .prf h2 a:hover, .prf h2 a:focus-visible { text-decoration: underline; }
  .prf ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .prf li a { display: grid; gap: 2px; padding: 8px 10px; border: 1px solid var(--ds-line); border-radius: var(--ds-r-md, 8px); background: var(--ds-sunken); color: inherit; text-decoration: none; min-width: 0; }
  .prf li a:hover, .prf li a:focus-visible { border-color: var(--ds-acc-raffles, #ff8a5c); }
  .prf .prf-q { color: var(--ds-text); font-size: var(--ds-fs-sm, 14px); overflow-wrap: anywhere; }
  .prf .prf-meta { color: var(--ds-text-muted); font-size: var(--ds-fs-xs, 12px); }
  .prf .prf-ctas { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2); margin-top: var(--ds-sp-3); }
</style>
