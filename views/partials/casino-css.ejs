<%# views/partials/casino-css.ejs - D10 (2026-10-11): the casino tables' shared look (lobby, felt, cards, chips, seats, countdown
    rings, the action dock, sheets). Dark felt + wood rail + PATV gold, in the newer pages' style (Pepeball, Premium, Plex).
    Every animation is off under prefers-reduced-motion. Used by casino-bj.ejs and casino-hm.ejs.
    1.99pz polish: on the design-system tokens (docs/design-system.md, "Area notes: games" > Casino): the page is main.ds-page.flow.cz,
    gold / type / radii / focus / breakpoints are ds tokens, action-button fills pass AA with white ink, logical properties. %>
<style>
  .cz { --ds-ac: var(--ds-acc-casino); --ds-ac-2: var(--ds-acc-casino); --ds-ac-bg: rgba(126,224,138,.12); --ds-ac-line: #2e6b31; --ds-on-ac: #0b0f0c;
        --felt0: #0a3a1f; --felt1: #12673a; --felt2: #1b8a4d; --rail0: #2a160a; --rail1: #5a3418; --rail2: #8a5a2b;
        --gold: var(--ds-gold); --gold2: #ffc400; --goldt: var(--ds-gold-text); --ink: #0b0f0c; --mut: #a9bfae; --txt: #eef5ef; --bad: #ff8a80; --good: var(--ds-acc-casino);
        --panel: linear-gradient(180deg, rgba(20,48,31,.55), rgba(8,20,13,.75)); --line: rgba(126,224,138,.22); --cw: 46px;
        --ds-w: 1120px; max-width: 1120px; width: 100%; min-width: 0; box-sizing: border-box; margin: 0 auto; padding: 0 var(--ds-gutter) var(--ds-sp-12);
        font-family: var(--ds-font); color: var(--txt); overflow-wrap: anywhere; }
  .cz *, .cz *::before, .cz *::after { box-sizing: border-box; }
  .cz a { color: var(--goldt); }
  .cz [hidden] { display: none !important; }
  .cz-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cz :where(button) { font: inherit; }   /* zero-specificity on the element, so .cz-btn / .lob-tabs etc. set their own weight */
  .cz :focus-visible { outline: 2px solid var(--ds-focus); outline-offset: 2px; }

  /* ── top bar: the game, your balance, fairness, viewers ── */
  .cz-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin: 14px 0 12px; }
  .cz-brand { display: flex; align-items: center; gap: 10px; margin: 0; margin-inline-end: auto; min-width: 0; }
  .cz-brand .ic { flex: none; display: grid; place-items: center; width: 42px; height: 42px; border-radius: var(--ds-r-lg); font: 24px/1 var(--ds-font-emoji);
                  background: radial-gradient(circle at 35% 30%, var(--felt2), var(--felt0)); border: 1px solid var(--rail2); box-shadow: 0 4px 14px rgba(0,0,0,.4); }
  .cz-brand h1, .cz-brand .h1 { margin: 0; font: 700 var(--ds-fs-h1)/var(--ds-lh-h1) var(--ds-font); letter-spacing: .01em;
                 background: linear-gradient(180deg, #fff6cf, var(--gold) 60%, #ff9f00); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cz-brand small { display: block; color: var(--mut); font-size: 12px; letter-spacing: .04em; }
  .cz-pill { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; margin: 0; padding: 0 12px; border-radius: var(--ds-r-pill); font: 400 var(--ds-fs-meta)/1.2 var(--ds-font); text-decoration: none;
             background: rgba(0,0,0,.35); border: 1px solid var(--line); color: var(--txt); white-space: nowrap; }
  .cz-pill b { color: var(--goldt); font-variant-numeric: tabular-nums; }
  a.cz-pill { color: var(--txt); }
  a.cz-pill:hover, button.cz-pill:hover { border-color: var(--gold); }
  .cz-pill.fair { border-color: rgba(126,224,138,.5); color: var(--good); }
  .cz-pill.fair::before { content: "🔐"; }
  button.cz-pill { cursor: pointer; }
  .cz-toast { min-height: 22px; margin: 0 0 8px; text-align: center; font-size: var(--ds-fs-sm); color: #cfe8cf; }
  .cz-toast.bad { color: var(--bad); }

  /* ── buttons ── */
  /* game buttons: the ds .square shape (radius 10) for the dense table UI; every fill passes AA with its ink */
  .cz-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; margin: 0; padding: 0 18px; border-radius: var(--ds-r-md); border: 0;
            font: 700 16px/1.1 var(--ds-font); cursor: pointer; color: #fff; background: #2b3a30; text-decoration: none; transition: transform var(--ds-dur-1), filter var(--ds-dur-1);
            box-shadow: 0 3px 0 rgba(0,0,0,.35); }
  .cz-btn:hover { filter: brightness(1.12); }
  .cz-btn:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .cz-btn:active { transform: translateY(2px); box-shadow: 0 1px 0 rgba(0,0,0,.35); }
  .cz-btn[disabled] { opacity: .42; cursor: not-allowed; filter: none; transform: none; }
  .cz-btn.gold { background: var(--ds-gold-grad); color: var(--ds-on-gold) !important; }
  .cz-btn.green { background: linear-gradient(180deg, #2a7f3f, #1d6630); }
  .cz-btn.red { background: linear-gradient(180deg, #c43c38, #8e2424); }
  .cz-btn.blue { background: linear-gradient(180deg, #2f6fc0, #1f5aa6); }
  .cz-btn.amber { background: linear-gradient(180deg, #f0a43a, #d98a1c); color: #1a1200; }
  .cz-btn.ghost { background: rgba(0,0,0,.3); border: 1px solid var(--line); box-shadow: none; color: var(--txt); }
  .cz-btn.sm { min-height: 36px; padding: 0 12px; font-size: 14px; border-radius: var(--ds-r-sm); }
  .cz-btn.wide { width: 100%; }

  /* ── cards (a flip = .pc-in turning over; .down shows the back) ── */
  .pc { display: inline-block; width: var(--cw); height: calc(var(--cw) * 1.4); perspective: 600px; flex: none; }
  .pc-in { position: relative; display: block; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform .45s cubic-bezier(.3,.7,.3,1); }
  .pc.down .pc-in { transform: rotateY(180deg); }
  .pc-f, .pc-b { position: absolute; inset: 0; border-radius: calc(var(--cw) * .13); backface-visibility: hidden; -webkit-backface-visibility: hidden;
                 box-shadow: 0 2px 6px rgba(0,0,0,.45); }
  .pc-f { background: linear-gradient(160deg, #fff, #f0f0ea); color: #161616; font-weight: bold; line-height: 1; }
  .pc.red .pc-f { color: #c62828; }
  .pc-f .r { position: absolute; top: 7%; left: 9%; font-size: calc(var(--cw) * .36); letter-spacing: -.04em; }
  .pc-f .s1 { position: absolute; top: 33%; left: 10%; font-size: calc(var(--cw) * .26); }
  .pc-f .s2 { position: absolute; right: 8%; bottom: 6%; font-size: calc(var(--cw) * .58); }
  .pc-b { transform: rotateY(180deg); border: 2px solid #fff;
          background: radial-gradient(circle at 50% 50%, rgba(255,215,64,.35) 0 18%, transparent 19%),
                      repeating-linear-gradient(45deg, #9b1c1c 0 4px, #c62828 4px 8px); }
  .pc.deal { animation: pcDeal .42s cubic-bezier(.2,.8,.3,1) both; animation-delay: var(--dl, 0s); }
  .pc.ghost .pc-f { background: rgba(255,255,255,.06); box-shadow: inset 0 0 0 2px rgba(255,255,255,.18); }
  .pc.ghost .pc-f * { display: none; }
  .pc.dim { opacity: .55; }
  .cards { display: inline-flex; align-items: flex-end; }
  .cards.fan .pc + .pc { margin-inline-start: calc(var(--cw) * -.52); }
  .cards.row { gap: 6px; }
  @keyframes pcDeal { from { opacity: 0; transform: translate(var(--fx, 0), var(--fy, -90px)) rotate(-14deg) scale(.7); } to { opacity: 1; transform: none; } }

  /* ── chips ── */
  .chip { --c: #f4f4f4; --e: #1f5aa6; display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; flex: none;
          background: radial-gradient(circle, var(--c) 0 44%, var(--e) 45% 52%, var(--c) 53% 62%, transparent 63%),
                      repeating-conic-gradient(var(--e) 0 15deg, var(--c) 15deg 30deg);
          box-shadow: 0 2px 0 rgba(0,0,0,.45), inset 0 0 0 1px rgba(0,0,0,.25); }
  .chip.c500 { --c: #7b3fbf; --e: #f3e6ff; } .chip.c1k { --c: #f2c230; --e: #6a4b00; } .chip.c5k { --c: #d32f2f; --e: #ffe0e0; }
  .chip.c25k { --c: #222; --e: #ffd740; } .chip.cmax { --c: #0f7a5a; --e: #dfffe9; }
  .stack { display: inline-flex; align-items: center; gap: 6px; padding: 3px 9px 3px 4px; border-radius: 999px; background: rgba(0,0,0,.55);
           font: 700 12px/1 var(--ds-font); color: var(--goldt); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .stack .chip { width: 16px; height: 16px; }
  /* 1.99ov: 💎 High Roller chips (only High Rollers and High Roller tables see them): 100K onyx & gold, 500K solid gold, 1M platinum
     with a diamond inlay, 5M black diamond with an iridescent edge. A sheen (::after) and, on 1M / 5M, a cut diamond (::before). */
  .chip.hrc { position: relative; overflow: hidden; box-shadow: 0 2px 0 rgba(0,0,0,.55), 0 0 0 1px rgba(255,215,64,.75), 0 0 9px rgba(255,200,60,.45); }
  .chip.hrc::after { content: ""; position: absolute; inset: 0; border-radius: 50%; pointer-events: none;
                     background: linear-gradient(135deg, rgba(255,255,255,.55) 0%, rgba(255,255,255,0) 38%, rgba(255,255,255,0) 62%, rgba(255,255,255,.18) 100%); }
  .chip.c100k { background: radial-gradient(circle, #151515 0 36%, #e8c45a 37% 41%, #0b0b0b 42% 56%, #e8c45a 57% 60%, transparent 61%),
                            repeating-conic-gradient(#f5d77a 0 9deg, #0d0d0d 9deg 30deg); }
  .chip.c500k { background: radial-gradient(circle, #ffe9a3 0 18%, #c9971c 19% 36%, #3a2600 37% 40%, #f4c542 41% 56%, #3a2600 57% 60%, transparent 61%),
                            repeating-conic-gradient(#1a1100 0 8deg, #f6cf55 8deg 30deg); }
  .chip.c1m { background: radial-gradient(circle, #f7fbff 0 30%, #9fb3c8 31% 35%, #e6edf5 36% 56%, #5d7590 57% 60%, transparent 61%),
                          repeating-conic-gradient(#2b3a4d 0 8deg, #dfe8f2 8deg 22.5deg); }
  .chip.c5m { background: radial-gradient(circle, #0a0a12 0 52%, transparent 53%),
                          conic-gradient(from 0deg, #ff6ad5, #ffd36a, #6affc8, #6ac8ff, #c86aff, #ff6ad5);
              box-shadow: 0 2px 0 rgba(0,0,0,.6), 0 0 0 1px #fff, 0 0 12px rgba(200,140,255,.75); }
  .chip.c1m::before, .chip.c5m::before { content: ""; position: absolute; left: 50%; top: 50%; width: 36%; height: 36%; transform: translate(-50%, -50%);
                                         clip-path: polygon(50% 0, 100% 38%, 50% 100%, 0 38%); z-index: 1;
                                         background: linear-gradient(160deg, #ffffff 0%, #bfe9ff 35%, #6fb6ff 60%, #e9f7ff 100%); }
  .chip.c5m::before { background: linear-gradient(160deg, #ffffff 0%, #ffd6f4 30%, #b98cff 60%, #e9f7ff 100%); }
  /* a pile: a few chips of the amount stacked up (largest on top), 3px apart */
  .pile { position: relative; display: inline-block; flex: none; width: 16px; height: calc(16px + (var(--n, 1) - 1) * 3px); }
  .pile .chip { position: absolute; left: 0; bottom: calc(var(--i) * 3px); width: 16px; height: 16px; }
  .pot .main .pile, .pot .main .pile .chip { width: 18px; }
  .pot .main .pile .chip { height: 18px; }
  .stack.hr, .pot .main.hr { background: linear-gradient(180deg, rgba(28,22,6,.92), rgba(0,0,0,.85)); color: #ffe9a3;
                             box-shadow: 0 0 0 1px rgba(255,215,64,.6), 0 0 12px rgba(255,200,60,.3); }
  /* a High Roller table: a deeper felt, a gold rail and a diamond watermark */
  .felt.hr { --felt0: #04130c; --felt1: #0a2f1f; --felt2: #124a32; --rail0: #1a1203; --rail1: #6b4e0f; --rail2: #e8c45a; }
  .felt.hr::before { content: "💎"; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); font-size: 120px; opacity: .05; pointer-events: none; z-index: -1; }
  .tag.hr, .felt-meta .tag.hr { background: linear-gradient(180deg, #2a2208, #000); color: #ffe082; box-shadow: inset 0 0 0 1px rgba(255,215,64,.7); }

  /* ── countdown ring (SVG circle; JS sets the stroke offset from the server's deadline) ── */
  .ring { position: absolute; inset: -5px; width: calc(100% + 10px); height: calc(100% + 10px); transform: rotate(-90deg); pointer-events: none; }
  .ring circle { fill: none; stroke-width: 4; }
  .ring .bg { stroke: rgba(0,0,0,.35); }
  .ring .fg { stroke: var(--gold); stroke-linecap: round; transition: stroke-dashoffset .25s linear, stroke .25s; }
  .ring.low .fg { stroke: #ff7043; }
  .clock { position: relative; display: inline-grid; place-items: center; width: 46px; height: 46px; flex: none; font: 700 15px/1 var(--ds-font);
           color: #fff; font-variant-numeric: tabular-nums; }
  .clock .ring { inset: 0; width: 100%; height: 100%; }

  /* ── seats (avatar + name + stack); the turn seat glows and wears the ring ── */
  .seat { position: relative; display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 0; text-align: center; }
  .av { position: relative; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; flex: none;
        background: radial-gradient(circle at 35% 30%, #3b5d47, #13241a); border: 2px solid rgba(255,255,255,.25); color: #fff;
        font: 700 18px/1 var(--ds-font); text-transform: uppercase; }
  .av img { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; background: #13241a; }
  .av .badge { position: absolute; inset-inline-end: -6px; bottom: -4px; font-size: 13px; line-height: 1; filter: drop-shadow(0 1px 1px #000); }
  .seat.me .av { border-color: var(--good); }
  .seat.turn .av { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(255,215,64,.25), 0 0 18px rgba(255,215,64,.55); }
  .seat.folded { opacity: .45; }
  .seat.winner .av { border-color: var(--gold); box-shadow: 0 0 22px rgba(255,215,64,.9); animation: czGlow 1.2s ease-in-out 3; }
  .seat .who { display: flex; flex-direction: column; align-items: center; gap: 4px; max-width: 100%; position: relative; }
  .plate { display: block; max-width: 100%; padding: 4px 9px; border-radius: 10px; background: rgba(5,12,8,.82); border: 1px solid rgba(255,255,255,.1); line-height: 1.25; }
  .plate .nm { display: block; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 700 13px/1.25 var(--ds-font); color: #fff; }
  .plate .sub { display: block; font-size: 12px; color: var(--goldt); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .tag { display: inline-block; padding: 2px 6px; border-radius: var(--ds-r-xs); font: 700 10.5px/1.2 var(--ds-font); letter-spacing: .04em; text-transform: uppercase;
         background: rgba(255,255,255,.12); color: #ddd; white-space: nowrap; }
  .tag.gold { background: var(--gold); color: var(--ds-on-gold); } .tag.red { background: #c62828; color: #fff; } .tag.green { background: #2e7d32; color: #fff; }
  .tag.blue { background: #1565c0; color: #fff; }
  .pop { position: absolute; left: 50%; top: -6px; z-index: 5; transform: translate(-50%, 0); padding: 4px 10px; border-radius: 999px; pointer-events: none;
         font: 700 15px/1 var(--ds-font); white-space: nowrap; animation: czPop 2.4s ease-out forwards; }
  .pop.win { background: var(--ds-gold-grad); color: var(--ds-on-gold); box-shadow: 0 0 16px rgba(255,215,64,.7); }
  .pop.lose { background: rgba(0,0,0,.75); color: var(--bad); }
  .pop.push { background: rgba(0,0,0,.75); color: #ddd; }
  @keyframes czPop { 0% { opacity: 0; transform: translate(-50%, 10px) scale(.6); } 12% { opacity: 1; transform: translate(-50%, -8px) scale(1.12); }
                     25% { transform: translate(-50%, -12px) scale(1); } 80% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%, -34px); } }
  @keyframes czGlow { 50% { box-shadow: 0 0 34px rgba(255,215,64,1); } }

  /* ── the felt ── */
  .felt { position: relative; isolation: isolate; border-radius: 28px; padding: 18px;
          background: radial-gradient(120% 90% at 50% 25%, var(--felt2) 0%, var(--felt1) 45%, var(--felt0) 100%);
          box-shadow: inset 0 0 0 10px var(--rail1), inset 0 0 0 12px var(--rail2), inset 0 0 0 14px var(--rail0), inset 0 0 60px rgba(0,0,0,.55), 0 14px 40px rgba(0,0,0,.5); }
  .felt::after { content: ""; position: absolute; inset: 14px; border-radius: 18px; pointer-events: none; z-index: -1; opacity: .07;
                 background: repeating-radial-gradient(circle at 50% 50%, #fff 0 1px, transparent 1px 4px); }
  .felt-msg { min-height: 24px; margin: 4px 0; text-align: center; font: 700 16px/1.3 var(--ds-font); color: #fff; text-shadow: 0 1px 3px #000; }
  .felt-msg small { display: block; font-weight: normal; font-size: 13px; color: rgba(255,255,255,.75); }
  .felt-lbl { color: rgba(255,255,255,.72); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
  .felt-meta { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin: 4px 0 0; }
  .felt-meta .tag { background: rgba(0,0,0,.35); color: rgba(255,255,255,.85); font-weight: normal; text-transform: none; letter-spacing: 0; font-size: 12px; }

  /* ── spectator ribbon ── */
  .watchbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 12px; margin: 10px 0 0; padding: 10px 12px; border-radius: var(--ds-r-lg);
              background: var(--ds-gold-bg); border: 1px dashed rgba(255,215,64,.45); color: var(--ds-warn-ink); font-size: var(--ds-fs-sm); text-align: center; }

  /* ── the action dock: under the felt; on a phone it sticks to the bottom for the thumb ── */
  .dock { position: relative; bottom: 0; z-index: var(--ds-z-sticky); margin: 12px 0 0; padding: 12px; border-radius: var(--ds-r-2xl); background: rgba(8,16,11,.94);
          border: 1px solid var(--line); box-shadow: 0 -6px 24px rgba(0,0,0,.45); backdrop-filter: blur(6px); }
  .dock-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; }
  .dock > :not([hidden]) ~ :not([hidden]), .dock-row + .dock-row { margin-top: 10px; }
  .dock-acts { display: grid; grid-template-columns: repeat(auto-fit, minmax(96px, 1fr)); gap: 8px; flex: 1; min-width: 0; }
  .dock-acts .cz-btn { min-height: 54px; font-size: 17px; }
  .dock-note { color: var(--mut); font-size: var(--ds-fs-meta); text-align: center; }
  .dock-note b { color: var(--goldt); }
  .dock-turn { display: flex; align-items: center; gap: 10px; }

  /* ── sheets (history, host tools, buy-in): native <dialog> = focus trap + Esc; a bottom sheet on a phone ── */
  dialog.sheet { width: min(560px, calc(100vw - 24px)); max-height: min(80vh, 720px); padding: 0; border: 1px solid var(--line); border-radius: var(--ds-r-2xl);
                 background: #0c1a12; color: var(--txt); box-shadow: var(--ds-e-4); font-family: var(--ds-font); overflow: hidden; }
  dialog.sheet::backdrop { background: var(--ds-scrim, rgba(0,0,0,.62)); }   /* ::backdrop may not inherit custom properties: keep the fallback */
  dialog.sheet[open] { display: flex; flex-direction: column; animation: czSheet .22s ease-out; }
  .sheet-h { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--line); }
  .sheet-h h2 { margin: 0; font: 700 18px/1.3 var(--ds-font); color: #fff; }
  .sheet-x { display: inline-grid; place-items: center; flex: none; width: 40px; height: 40px; margin: 0; padding: 0; border-radius: var(--ds-r-sm); border: 1px solid var(--line); background: transparent; color: #fff; font-size: 20px; line-height: 1; cursor: pointer; }
  .sheet-x:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .sheet-b { padding: 14px 16px 18px; overflow-y: auto; }
  .sheet-b p { margin: 0 0 10px; line-height: 1.5; }
  .sheet .fine { color: var(--mut); font-size: var(--ds-fs-meta); line-height: 1.5; }
  .sheet label.lbl { display: block; margin: 12px 0 6px; color: var(--mut); font: 700 var(--ds-fs-label)/1.3 var(--ds-font); letter-spacing: var(--ds-ls-label); text-transform: uppercase; }
  /* resets the legacy global input[type=number] rule (margins, #ddd border, black text) */
  .sheet select, .sheet input[type=number] { width: 100%; min-height: var(--ds-tap); margin: 0; padding: 0 12px; border-radius: var(--ds-r-md); border: 1px solid var(--line); background: #06100a;
                                             color: #fff; font: 700 16px var(--ds-font); }
  .sheet select:focus, .sheet input[type=number]:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(255,207,64,.2); }
  .roomchips { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 10px; }
  .roomchips span { display: inline-flex; align-items: center; gap: 4px; padding: 2px; padding-inline-start: 10px; border-radius: var(--ds-r-pill); background: #1565c0; color: #fff; font-size: var(--ds-fs-meta); }
  .roomchips button { display: inline-grid; place-items: center; width: 32px; height: 32px; margin: 0; padding: 0; border-radius: 50%; border: 0; background: rgba(0,0,0,.3); color: #fff; cursor: pointer; font-size: 14px; line-height: 1; }
  .sheet .rowb { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  @keyframes czSheet { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @media (max-width: 600px) {
    dialog.sheet { width: 100vw; max-width: 100vw; margin: auto 0 0; border-radius: var(--ds-r-2xl) var(--ds-r-2xl) 0 0; max-height: 86vh; padding-bottom: env(safe-area-inset-bottom, 0px); }
  }

  /* history rows */
  .hist { display: grid; gap: 8px; }
  .hrow { padding: 10px 12px; border-radius: var(--ds-r-lg); background: rgba(0,0,0,.3); border: 1px solid rgba(255,255,255,.07); font-size: var(--ds-fs-sm); line-height: 1.45; }
