<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<%#
  The story strip (1.99bz; public/js/stories.js opens the viewer). Locals: story =
    { rooms: stories.forViewer() rows (circles, one per room), caps: one room's captures (thumbnails),
      room: room id for the thumbnails, signed: bool }, heading (optional), next (sign-in return path)
  Circles: unseen rooms first, then the newest. Signed-out visitors get the circles without pictures and
  a sign-in prompt instead of the viewer. Thumbnails keep their /media/<id> link as the no-JS fallback.
  1.99ez: story.compose (signed in) = a "＋ Your story" circle first (public/js/story-compose.js; the pad = story.room,
  or story.pad, preselected); person circles (r.person: a member's own uploads + captures of them) show their avatar;
  a member's own upload (source "user") is "<name>'s story".
%><%
  const S = story || { rooms: [], caps: [], signed: false };
  const ttl_ = typeof heading !== 'undefined' && heading ? heading : null;
  const ttlH_ = typeof headingHtml !== 'undefined' && headingHtml ? headingHtml : null;     // i18n: a heading that's already HTML (t() output)
  const next_ = typeof next !== 'undefined' && next ? next : '/';
  const mono = (t) => String(t || '?').replace(/[^A-Za-z0-9]/g, '').slice(0, 2).toUpperCase() || '📡';
  const kindIc = { photo: '📸', clip: '📹', audio: '🔊' };
  const mmss = (s) => { s = Math.round(Number(s) || 0); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };
  const showRooms = (S.rooms || []).length > 0, showCaps = (S.caps || []).length > 0, compose_ = !!(S.signed && S.compose);
  const composePad_ = S.pad || S.room || '';
  // 1.99fn: one pad's capture strip (thumbnails, no circles) - the viewer loads THAT pad's story only (/api/stories?room=),
  // so it never runs on into other pads or members' profile stories
  const scope_ = S.room && !showRooms ? S.room : '';
  // 1.99es: a pad's avatar (padlook.js) under the capture cover - what signed-out visitors see instead of the monogram
  const padAvSrc_ = (id) => { try { const L = typeof padLook === 'function' ? padLook(id) : null; return L && L.avatar ? L.avatar : null; } catch (e) { return null; } };
%>
<% if (showRooms || showCaps || compose_) { %>
<link rel="stylesheet" href="/public/css/stories.css?v=6">
<section class="ss" aria-label="<%- t('feed.story.strip_aria') %>" data-signed="<%= S.signed ? '1' : '' %>" data-next="<%= next_ %>"<% if (scope_) { %> data-scope="<%= scope_ %>"<% } %>>
  <% if (ttlH_) { %><h2 class="ss-h"><%- ttlH_ %> <small><%- t('feed.story.last24') %></small></h2><% } else if (ttl_) { %><h2 class="ss-h"><%= ttl_ %> <small><%- t('feed.story.last24') %></small></h2><% } %>
  <%# 1.99es: no native scrollbar - a fade at the edge that has more, and ‹ › buttons on hover-capable pointers (stories.js) %>
  <div class="ss-scroll">
  <button type="button" class="ss-arr prev" tabindex="-1" aria-label="<%- t('feed.story.scroll_back') %>" hidden>‹</button>
  <div class="ss-row" role="list">
    <% if (compose_) { %>
      <button type="button" role="listitem" class="ss-c ss-add" data-story-compose data-pad="<%= composePad_ %>" aria-label="<%- t('feed.story.add_aria') %>">
        <span class="ss-ring"><span class="ss-av"><span class="ss-plus" aria-hidden="true">＋</span></span></span>
        <span class="ss-n"><%- t('feed.story.yours') %></span>
      </button>
    <% } %>
    <% (S.rooms || []).forEach((r) => { %>
      <button type="button" role="listitem" class="ss-c<%= r.unseen ? ' unseen' : ' seen' %>" data-story-room="<%= r.id %>" data-latest="<%= r.latest %>"<%= !S.signed && r.open ? ' data-story-open=1' : '' %>
              aria-label="<%= r.title %>: <%- r.person ? t('feed.story.person_aria', { count: r.count }) : t('feed.story.room_aria', { count: r.count }) %><%- r.unseen ? t('feed.story.new_suffix') : '' %>">
        <span class="ss-ring"><span class="ss-av<%= r.person ? ' ss-person' : '' %>"><% if (r.person && r.avatar) { %><img src="<%= r.avatar %>" alt="" loading="lazy" onerror="this.remove()"><% } else { %><% if ((S.signed || r.open) && r.cover) { %><img src="<%= r.cover %>" alt="" loading="lazy" onerror="this.remove()"><% } %><% const pav_ = r.person ? null : padAvSrc_(r.id); if (pav_) { %><img class="ss-pav" src="<%= pav_ %>" alt="" loading="lazy"><% } else { %><span class="ss-mono" aria-hidden="true"><%= mono(r.title) %></span><% } %><% } %></span></span>
        <span class="ss-n"><%= r.title %></span>
        <span class="ss-k" aria-hidden="true"><%= r.count %></span>
      </button>
    <% }) %>
    <% (S.caps || []).forEach((c) => { %>
      <a role="listitem" class="ss-t k-<%= c.kind %><%= c.kind !== 'photo' && c.poster && !c.nsfw ? ' has-p' : '' %>" href="<%= c.page %>" data-story-room="<%= S.room %>" data-story-item="<%= c.id %>"
         aria-label="<% const what_ = c.source === 'stage' ? t(c.kind === 'clip' ? 'feed.story.k_stage_clip' : 'feed.story.k_stage_snap') : t(c.kind === 'photo' ? 'feed.story.k_snap' : c.kind === 'clip' ? 'feed.story.k_clip' : 'feed.story.k_audio'); %><%- c.source === 'user' ? (c.by ? t('feed.story.users', { name: c.by }) : t('feed.story.someones')) : c.subject ? t('feed.story.of', { what: what_, who: c.subject }) : t('feed.story.of_someone', { what: what_ }) %><%- c.nsfw ? ' ' + t('feed.story.nsfw_suffix') : '' %>">
        <% if (c.kind === 'photo' && !c.nsfw) { %><img src="<%= c.src %>" alt="" loading="lazy" onerror="this.parentNode.classList.add('gone'); this.remove()"><% } %>
        <%# 1.99dq: clips show their poster frame, audio its waveform card; the camcorder icon stays as the fallback %>
        <% if (c.kind !== 'photo' && c.poster && !c.nsfw) { %><img class="pst" src="<%= c.poster %>" alt="" loading="lazy" onerror="this.parentNode.classList.add('gone'); this.remove()"><% } %>
        <span class="ic" aria-hidden="true"><%= c.nsfw ? '🔞' : c.source === 'stage' ? '📺' : c.source === 'user' ? '✨' : kindIc[c.kind] %></span>
        <% if (c.kind !== 'photo') { %><span class="dur" aria-hidden="true"><%= c.kind === 'clip' ? '▶' : '🔊' %><% if (c.secs > 0) { %> <%= mmss(c.secs) %><% } %></span><% } %>
        <span class="who"><% const who_ = c.source === 'user' ? c.by : c.subject; %><%- who_ ? t.esc(who_) : t('feed.story.someone') %></span>
      </a>
    <% }) %>
  </div>
  <button type="button" class="ss-arr next" tabindex="-1" aria-label="<%- t('feed.story.scroll_more') %>" hidden>›</button>
  </div>
</section>
<%# 1.99fu: signed out, a Public pad's story (r.open, padaccess.js) is inlined too, so its circle opens %>
<% const inl_ = S.signed ? (S.rooms || []) : (S.rooms || []).filter((r) => r.open && Array.isArray(r.items)); %>
<% if (showRooms && inl_.length) { %><script type="application/json" class="ss-data"><%- JSON.stringify(inl_).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029') %></script><% } %>
<script src="/public/js/stories.js?v=10" defer></script>
<% if (compose_) { %><script src="/public/js/story-compose.js?v=1" defer></script><% } %>
<% } %>
