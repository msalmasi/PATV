<%# /p (the Pads): links to each pad's analytics (roomstats.js sets res.locals.roomAnalyticsList). %>
<% const _ral = typeof roomAnalyticsList !== 'undefined' && Array.isArray(roomAnalyticsList) ? roomAnalyticsList : []; %>
<% if (_ral.length) { %>
<style>
  .ral { display: grid; gap: 8px; }
  .ral h2 { margin: 6px 0 0; font-size: 16px; color: #ddd; }
  .ral .lst { display: flex; flex-wrap: wrap; gap: 8px; }
  .ral .lst a { font-size: 13px; padding: 6px 12px; border-radius: 999px; border: 1px solid #2c3a2d; background: #0f1a10; color: #b9d8bb !important; overflow-wrap: anywhere; }
  .ral .lst a:hover { border-color: #4caf50; }
</style>
<section class="ral" aria-labelledby="ralH">
  <h2 id="ralH">📈 Pad analytics</h2>
  <div class="lst"><% _ral.forEach((r) => { %><a href="/p/<%= encodeURIComponent(r.slug) %>/analytics"><%= r.name %></a><% }) %></div>
</section>
<% } %>
