<%# Shared look for /terms and /privacy (1.99cc) %>
<style>
  .lg { max-width: 860px; margin: 0 auto; padding: 18px 16px 40px; font-family: Ubuntu, sans-serif; color: #dcdcdc; line-height: 1.65; box-sizing: border-box; width: 100%; min-width: 0; overflow-wrap: break-word; }
  .lg *, .lg *::before, .lg *::after { box-sizing: border-box; }
  .lg a { color: #81c784; }
  .lg .hero { background: radial-gradient(110% 140% at 0% 0%, #17301a 0%, #111 55%), #111; border: 1px solid #222; border-radius: 16px; padding: 20px 20px 16px; }
  .lg .eyebrow { font-family: 'Press Start 2P', monospace; font-size: 10px; letter-spacing: .12em; color: #c6e94f; }
  .lg h1 { font-size: clamp(26px, 4vw, 36px); line-height: 1.15; margin: 10px 0 6px; color: #fff; }
  .lg .updated { display: inline-block; margin: 2px 0 10px; padding: 3px 10px; border-radius: 999px; background: #1f2b22; border: 1px solid #3CC47C; color: #c8f0d3; font-size: 13px; font-weight: bold; }
  .lg .draft { margin: 0 0 10px; padding: 7px 12px; border-radius: 10px; background: #2a2412; border: 1px solid #8a7420; color: #f1e2a6; font-size: 13.5px; }
  .lg .draft b { display: inline-block; margin-right: 6px; padding: 0 7px; border-radius: 999px; background: #8a7420; color: #111; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .lg .lead { color: #c9d3c9; margin: 0; }
  .lg .note { margin: 14px 0 0; padding: 10px 12px; border-radius: 10px; background: #1c1a12; border: 1px solid #4a4220; color: #e9dca8; font-size: 13.5px; }
  .lg nav.toc { margin: 18px 0; background: #111; border: 1px solid #222; border-radius: 14px; padding: 12px 16px; }
  .lg nav.toc b { display: block; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #ffd700; margin-bottom: 6px; }
  .lg nav.toc ol { margin: 0; padding-left: 20px; columns: 2; column-gap: 28px; font-size: 14px; }
  .lg nav.toc li { break-inside: avoid; }
  .lg section { margin: 26px 0 0; scroll-margin-top: 70px; }
  .lg h2 { font-size: 20px; margin: 0 0 8px; color: #fff; border-bottom: 1px solid #262626; padding-bottom: 6px; }
  .lg h3 { font-size: 16px; margin: 16px 0 4px; color: #eaeaea; }
  .lg p, .lg li { font-size: 15px; }
  .lg ul, .lg ol { padding-left: 22px; }
  .lg li { margin: 3px 0; }
  .lg .ph { background: #3a1f1f; color: #ffb4a8; border: 1px dashed #ff8a75; border-radius: 4px; padding: 0 4px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .92em; white-space: nowrap; }
  .lg .tw { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 8px 0; border: 1px solid #262626; border-radius: 10px; }
  .lg table { border-collapse: collapse; width: 100%; font-size: 14px; min-width: 520px; }
  .lg th, .lg td { text-align: left; vertical-align: top; padding: 8px 10px; border-bottom: 1px solid #222; }
  .lg th { background: #151515; color: #bbb; font-weight: bold; }
  .lg tr:last-child td { border-bottom: 0; }
  .lg code { background: #1b1b1b; border: 1px solid #2a2a2a; border-radius: 4px; padding: 0 4px; font-size: .92em; }
  .lg .caps { color: #cfcfcf; }
  @media (max-width: 640px) {
    .lg nav.toc ol { columns: 1; }
    .lg .hero { padding: 16px; }
    .lg .ph { white-space: normal; }
    /* phones: each table row becomes a small card (first cell = its heading) */
    .lg table { min-width: 0; }
    .lg table, .lg tbody, .lg tr, .lg td { display: block; width: auto; }
    .lg thead { display: none; }
    .lg tr { padding: 8px 10px; border-bottom: 1px solid #222; }
    .lg tr:last-child { border-bottom: 0; }
    .lg td { border: 0; padding: 2px 0; }
    .lg td:first-child { font-weight: bold; color: #fff; }
  }
</style>
