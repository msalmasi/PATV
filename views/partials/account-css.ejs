<%# 1.99vz: the Edit profile page CSS, shared with Settings -> Account (/settings/account, views/settingsAccount.ejs). %>
<style>
  /* 1.99ps (polish G4): on the design system - .ds-page.mid + tokens, docs/design-system.md "Area notes: profile, account and auth" */
  .pe { gap: var(--ds-sp-4); }
  .pe .card { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-5); min-width: 0; scroll-margin-top: calc(var(--ds-nav-h) + 16px); }
  /* one section-heading style: the pixel heading (.ds-pixel-h), same as the profile */
  .pe h2 { margin: 0 0 var(--ds-sp-1h); font: var(--ds-fs-pixel-h)/1.6 var(--ds-font-pixel); letter-spacing: var(--ds-ls-pixel-h); text-transform: uppercase; color: var(--ds-gold); }
  .pe .lede { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); margin: 0 0 var(--ds-sp-4); }
  .pe .muted { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); }
  .pe .top { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .pe .top-acts { display: flex; flex-wrap: wrap; gap: 8px; }
  /* buttons: pills. 44px next to a 44px field (forms, connections); 36px in toolbars (.top-acts, hero, layout actions). .primary = accent fill + dark ink */
  .pe .btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--ds-sp-1h); min-height: var(--ds-tap); margin: 0; padding: 0 var(--ds-sp-4); border-radius: var(--ds-r-pill);
             border: 1px solid var(--ds-line-strong); background: transparent; color: var(--ds-text) !important; font: 700 14px/1.1 var(--ds-font); cursor: pointer;
             text-decoration: none !important; white-space: nowrap; box-shadow: none; transition: border-color var(--ds-dur-1), filter var(--ds-dur-1); }
  .pe .btn:hover { border-color: var(--ds-ac); background: rgba(255, 255, 255, .03); }
  .pe .btn:focus-visible, .pe .lay-grip:focus-visible, .pe .mv button:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .pe .btn.primary { background: var(--ds-ac); border-color: transparent; color: var(--ds-on-ac) !important; }
  .pe .btn.primary:hover { background: var(--ds-ac); filter: brightness(1.1); }
  .pe .top-acts .btn, .pe .hero-foot .btn, .pe .lay-actions .btn { min-height: 36px; padding: 0 var(--ds-sp-3h); font-size: 13.5px; }
  @media (pointer: coarse) { .pe .top-acts .btn, .pe .hero-foot .btn, .pe .lay-actions .btn { min-height: 40px; } }
  .pe .btn.ghost { background: transparent; }
  .pe .btn.twitch { background: #9146ff; border-color: #9146ff; color: #fff !important; }
  .pe .btn.discord { background: #5865f2; border-color: #5865f2; color: #fff !important; }
  .pe .btn svg { width: 18px; height: 18px; flex: none; }
  .pe #twitchLoginButton, .pe #discordLoginButton { display: inline-flex; width: auto; min-height: var(--ds-tap); margin: 0; padding: 0 var(--ds-sp-4); border-radius: var(--ds-r-pill); font: 700 14px/1.1 var(--ds-font); }
  .pe #twitchLoginButton { background: var(--ds-twitch); border-color: var(--ds-twitch); color: #fff !important; }
  .pe #discordLoginButton { background: var(--ds-discord); border-color: var(--ds-discord); color: #fff !important; }
  .pe #twitchLoginButton:hover, .pe #discordLoginButton:hover { filter: brightness(1.1); }
  .pe .btn:disabled { filter: grayscale(.6) brightness(.7); cursor: not-allowed; }
  .pe .btn.primary:disabled:hover { filter: grayscale(.6) brightness(.7); }
  .pe .jump { display: flex; flex-wrap: wrap; gap: 6px; }
  /* jump links: .ds-tab pills (36px, 40 on touch) */
  .pe .jump a { display: inline-flex; align-items: center; min-height: 36px; padding: 0 var(--ds-sp-3h); border-radius: var(--ds-r-pill); border: 1px solid #2a2a2a;
                background: #151515; color: var(--ds-text-2); font: 500 var(--ds-fs-meta)/1 var(--ds-font); white-space: nowrap; text-decoration: none; }
  .pe .jump a:hover { border-color: var(--ds-ac); color: var(--ds-text-strong); text-decoration: none; }
  @media (pointer: coarse) { .pe .jump a { min-height: 40px; } }

  /* messages */
  .pe .msg { overflow-wrap: anywhere; }

  /* hero preview (mirrors the profile hero) */
  .pe .hero { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--ds-sp-4) var(--ds-sp-5); align-items: center; border-radius: var(--ds-r-2xl);
              background: radial-gradient(90% 140% at 0% 0%, var(--ds-green-bg), transparent 60%), #111; }
  .pe .avatar { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 3px solid #4caf50; background: var(--ds-sunken);
                box-shadow: 0 0 0 6px rgba(76, 175, 80, .12); }
  .pe .who .nm { margin: 0; font: 700 var(--ds-fs-h1)/var(--ds-lh-h1) var(--ds-font); color: var(--ds-text-strong); overflow-wrap: anywhere; }
  .pe .handle { color: var(--ds-text-muted); font-size: 14px; margin-top: 2px; overflow-wrap: anywhere; }
  /* 1.99jr: one pill style - same height / padding / line-height, centred in a flex row (the Preview pill used to pick up
     the privacy panel's .pv grid + padding and stretch the row, which pushed the other pills' text to the top) */
  .pe .chips { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 10px; }
  .pe .chip { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; height: 24px; margin: 0;
              padding: 0 10px; font-size: 12px; line-height: 1; white-space: nowrap; border-radius: var(--ds-r-pill); border: 1px solid #2c3a2d;
              background: #0f1a10; color: #b9d8bb; }
  .pe .chip.admin { border-color: #6b4fa0; background: #1a1326; color: #cbb6f2; }
  .pe .chip.staff { border-color: #2f6d8f; background: #10202a; color: #a9d7f0; }
  .pe .chip.chip-preview { border-color: #5a4a1c; background: #1d1a10; color: #e8cf7a; }
  .pe .chip.plex { border-color: #8a5a12; background: #241806; color: #f3c04f; text-decoration: none; }
  .pe .hero-foot { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }

  /* forms */
  .pe .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 14px 18px; }
  .pe form.field { margin: 0; display: grid; gap: 6px; align-content: start; }
  .pe label.lbl { font: 700 var(--ds-fs-label)/1.3 var(--ds-font); letter-spacing: var(--ds-ls-label); text-transform: uppercase; color: #b9b9b9; }
  .pe .row { display: flex; gap: 8px; }
  .pe .row input { flex: 1; min-width: 0; }
  /* fields: the .ds-in spec (44px, radius 10, sunken, #333 line, accent focus halo; 16px on phones) - styles.css's global input rules reset here */
  .pe input[type="text"], .pe input[type="email"], .pe input[type="password"], .pe select {
    width: 100%; min-width: 0; min-height: var(--ds-tap); margin: 0; padding: 10px 12px; border-radius: var(--ds-r-md); border: 1px solid var(--ds-line-strong); background: var(--ds-sunken);
    color: #eee; font: 400 15px/1.3 var(--ds-font); box-sizing: border-box; transition: border-color var(--ds-dur-1), box-shadow var(--ds-dur-1); }
  .pe select { flex: 1; }
  .pe input[type="text"]:hover, .pe input[type="email"]:hover, .pe input[type="password"]:hover, .pe select:hover { border-color: #444; }
  .pe input[type="text"]:focus, .pe input[type="email"]:focus, .pe input[type="password"]:focus, .pe select:focus { border-color: var(--ds-ac); outline: none; box-shadow: 0 0 0 3px var(--ds-ac-bg); }
  @media (max-width: 760px) { .pe input[type="text"], .pe input[type="email"], .pe input[type="password"], .pe select { font-size: 16px; } }
  .pe .hint { font-size: 12px; color: var(--ds-text-faint); }
  .pe .status { font-size: 13px; min-height: 18px; }
  .pe .status.ok { color: #81c784; }
  .pe .status.err { color: #ef9a9a; }

  /* avatar */
  .pe .avup { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 16px 18px; align-items: center; }
  .pe .avup img { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; border: 2px solid #2b2b2b; background: var(--ds-sunken); }
  .pe .file { position: relative; display: inline-flex; }
  .pe .file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; }
  .pe .file:focus-within .btn { box-shadow: var(--ds-focus-ring); }

  /* connections */
  .pe .conn { display: grid; gap: 10px; }
  .pe .conn-row { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; gap: var(--ds-sp-3); align-items: center; background: var(--ds-sunken);
                  border: 1px solid var(--ds-line-soft); border-radius: var(--ds-r-lg); padding: var(--ds-sp-3) var(--ds-sp-3h); }
  .pe .conn-ico { width: 36px; height: 36px; border-radius: var(--ds-r-md); display: grid; place-items: center; font-size: 18px; }
  .pe .conn-ico svg { width: 20px; height: 20px; }
  .pe .conn-name { font-size: 14px; }
  .pe .conn-name b { display: block; font-size: 15px; overflow-wrap: anywhere; }
  .pe .conn-name .none { color: var(--ds-text-faint); font-weight: normal; }
  .pe .conn-cf { grid-column: 1 / -1; }
  .pe .conn-name .pv-d { display: block; margin-top: 2px; color: var(--ds-text-muted); font-size: 13px; line-height: 1.4; }   /* 1.99ta: privacy & likeness rows */
  .pe .conn-name .px-st { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 4px; font-size: 12px; color: var(--ds-text-muted); }
  .pe .btn.telegram { background: #1a7bb0; border-color: transparent; color: #fff !important; }   /* Telegram blue darkened for 4.7:1 white ink */
  .pe .btn.telegram:hover { background: #1a7bb0; filter: brightness(1.1); }
  .pe .btn.plex { background: var(--ds-plex); border-color: transparent; color: #1a1200 !important; }
  .pe .btn.plex:hover { background: var(--ds-plex); filter: brightness(1.1); }
  /* 1.99lu: Link Google = Google's light sign-in button (white, #1f1f1f text 16:1, #747775 outline, the G). The old inline
     colour lost to .pe .btn's #ddd !important - pale grey on white */
  .pe .btn.google { background: #fff; border-color: #747775; color: #1f1f1f !important; font-weight: 700; }
  .pe .btn.google:hover { background: #f2f2f2; border-color: #747775; }
  /* Continue with Apple = Apple's white button style: black logo + black title (21:1), system font */
  .pe .btn.apple { background: #fff; border-color: #fff; color: #000 !important; font-weight: 600; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif; }
  .pe .btn.apple:hover { background: #f2f2f2; border-color: #f2f2f2; }
  .pe .btn.apple svg { width: 16px; height: 16px; margin-top: -2px; }

  /* 1.99lu: Password - the cells sit on the grid's bottom edge and the button is as tall as the inputs, so it lines up with
     them (it used to sit at the labels' height); the status message gets its own row */
  .pe .pw-form { align-items: end; }
  .pe .pw-form .field { display: grid; gap: var(--ds-sp-1h); }
  .pe .pw-form input[type="password"], .pe .pw-act .btn { height: var(--ds-tap); }
  .pe .pw-act { display: flex; }
  .pe .pw-status { display: block; margin-top: 8px; }
  .pe .pw-status:empty { min-height: 0; margin: 0; }

  /* layout editor */
  .pe .lay-fixed b { color: var(--ds-text-2); }
  .pe .lay-fixed { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: var(--ds-r-md); border: 1px dashed #2b2b2b; color: var(--ds-text-muted); font-size: 13px; margin-bottom: 8px; }
  .pe .lay { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .pe .lay-item { display: grid; grid-template-columns: 28px 30px minmax(0, 1fr) auto auto; gap: 10px; align-items: center;
                  background: var(--ds-sunken); border: 1px solid var(--ds-line-soft); border-radius: var(--ds-r-md); padding: 10px 12px; transition: border-color var(--ds-dur-2), background var(--ds-dur-2); }
  .pe .lay-item.off { background: #0b0b0b; border-style: dashed; }
  .pe .lay-item.off .lay-ico, .pe .lay-item.off .lay-txt { opacity: .5; }
  .pe .lay-item.dragging { border-color: var(--ds-ac); background: #102012; box-shadow: 0 8px 24px rgba(0,0,0,.5); position: relative; z-index: 2; }
  .pe .lay-grip { width: 28px; height: 36px; margin: 0; box-shadow: none; border: 0; padding: 0; border-radius: 6px; background: transparent; color: var(--ds-text-faint); cursor: grab; touch-action: none;
                  font-size: 18px; line-height: 1; display: grid; place-items: center; }
  .pe .lay-grip:hover { color: var(--ds-text-2); background: #181818; }
  .pe .lay-item.dragging .lay-grip { cursor: grabbing; }
  .pe .lay-ico { font-size: 20px; text-align: center; }
  .pe .lay-txt b { display: block; font-size: 15px; color: var(--ds-text); }
  .pe .lay-txt small { display: block; color: var(--ds-text-muted); font-size: 12px; margin-top: 1px; }
  .pe .lay-subs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .pe .lay-subs label { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; color: var(--ds-text-2); padding: 3px 9px 3px 6px; border-radius: var(--ds-r-pill);
                        border: 1px solid #2a2a2a; background: #141414; cursor: pointer; user-select: none; }
  .pe .lay-subs label:has(input:not(:checked)) { color: var(--ds-text-faint); border-style: dashed; text-decoration: line-through; }
  .pe .lay-subs input { margin: 0; accent-color: var(--ds-ac); }
  .pe .lay-item.off .lay-subs, .pe .lay-item.off .lay-priv { pointer-events: none; }
  .pe .lay-item.off .lay-priv { opacity: .5; }
  /* privacy panels: three-state segmented control */
  .pe .lay-priv { grid-column: 1 / -1; display: grid; gap: 8px; margin-top: 2px; padding-top: 10px; border-top: 1px solid var(--ds-line-soft); }
  .pe .lay-priv-h { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ds-text-muted); }
  .pe .lay-priv-h span { text-transform: none; letter-spacing: 0; color: var(--ds-text-faint); }
  .pe .pv { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 14px; align-items: center; padding: 9px 10px;
            border-radius: var(--ds-r-md); background: #111; border: 1px solid #1d1d1d; margin: 0; min-width: 0; }
  .pe .pv-txt { min-width: 0; }
  .pe .pv-txt b { display: block; font-size: 14px; color: var(--ds-text); font-weight: 700; }
  .pe .pv-txt small { display: block; font-size: 12px; color: var(--ds-text-muted); margin-top: 1px; }
  .pe .seg { display: inline-grid; grid-template-columns: repeat(3, auto); border: 1px solid #2b2b2b; border-radius: var(--ds-r-md); overflow: hidden; background: #0b0b0b; }
  .pe .seg label { position: relative; display: inline-flex; align-items: center; gap: 5px; min-height: 34px; padding: 0 11px; font-size: 12.5px; color: var(--ds-text-muted);
                   cursor: pointer; user-select: none; white-space: nowrap; border-inline-start: 1px solid #2b2b2b; }
  .pe .seg label:first-child { border-inline-start: 0; }
  .pe .seg input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .pe .seg label:hover { color: #ddd; background: #151515; }
  .pe .seg label:has(input:focus-visible) { outline: 2px solid var(--ds-focus); outline-offset: -2px; }
  .pe .seg label.s-public:has(input:checked) { background: #13301a; color: #b9f0c0; }
  .pe .seg label.s-private:has(input:checked) { background: #2b2210; color: #f0d58a; }
  .pe .seg label.s-hidden:has(input:checked) { background: #2a1414; color: #f0a8a8; }
  .pe .pv.is-private { border-color: #3a2f18; }
  .pe .pv.is-hidden { border-style: dashed; }
  .pe .pv.is-hidden .pv-txt { opacity: .6; }
  .pe .sw { position: relative; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font-size: 12px; color: var(--ds-text-muted); user-select: none; white-space: nowrap; }
  .pe .sw input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .pe .sw .tr { width: 38px; height: 22px; border-radius: var(--ds-r-pill); background: #2a2a2a; position: relative; transition: background .15s; flex: none; }
  .pe .sw .tr::after { content: ""; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #888; transition: transform .15s, background .15s; }
  .pe .sw input:checked + .tr { background: var(--ds-ac); }
  .pe .sw input:checked + .tr::after { transform: translateX(16px); background: #fff; }
  .pe .sw input:focus-visible + .tr { box-shadow: var(--ds-focus-ring); }
  .pe .sw .st { min-width: 46px; }
  .pe .mv { display: inline-flex; gap: 4px; }
  .pe .mv button { width: 36px; height: 36px; margin: 0; padding: 0; border-radius: var(--ds-r-sm); border: 1px solid var(--ds-line-strong); background: #1c1c1f; color: var(--ds-text-2); cursor: pointer; font-size: 12px; box-shadow: none; }
  .pe .mv button:hover:not(:disabled) { border-color: var(--ds-ac); color: #fff; }
  .pe .mv button:disabled { opacity: .3; cursor: default; }
  .pe .lay-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 14px; }
  .pe .lay-actions .dirty { font-size: 13px; color: #e8cf7a; display: none; }
  .pe .lay-actions .dirty.on { display: inline; }
  .pe .lay-note { font-size: 12px; color: var(--ds-text-faint); margin-top: 10px; }
  .pe .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* S1 V3: the chat text-style picker (#textstyle, textstyle.js). Swatches show the palette pair (dark | light) and the name in
     its dark-theme colour; the preview draws one chat line on each chat theme's background (the registry's), mentions in the
     chat's link colour */
  .pe .ts { display: grid; gap: var(--ds-sp-4); }
  .pe .ts-set { margin: 0; padding: 0; border: 0; min-width: 0; }
  .pe .ts-set legend { padding: 0; margin-bottom: var(--ds-sp-2); }
  .pe .ts-colors { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 8px; }
  .pe .ts-fonts { display: grid; grid-template-columns: repeat(auto-fill, minmax(124px, 1fr)); gap: 8px; }
  .pe .ts-sw, .pe .ts-font { position: relative; display: flex; align-items: center; gap: 8px; min-height: var(--ds-tap); box-sizing: border-box; padding: 6px 10px; margin: 0;
                             border-radius: var(--ds-r-md); border: 1px solid var(--ds-line-soft); background: var(--ds-sunken); cursor: pointer; user-select: none;
                             font-size: 13px; color: var(--ds-text-2); transition: border-color var(--ds-dur-1), background var(--ds-dur-1); }
  .pe .ts-sw input, .pe .ts-font input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
  .pe .ts-sw:hover, .pe .ts-font:hover { border-color: #3a3a3a; }
  .pe .ts-sw:has(input:checked), .pe .ts-font:has(input:checked) { border-color: var(--ds-ac); background: #102012; color: var(--ds-text-strong); }
  .pe .ts-sw:has(input:focus-visible), .pe .ts-font:has(input:focus-visible) { box-shadow: var(--ds-focus-ring); }
  .pe .ts-chip { flex: none; width: 22px; height: 22px; border-radius: 50%; box-sizing: border-box; border: 1px solid rgba(255, 255, 255, .2);
                 background: linear-gradient(135deg, var(--ts-d) 0 50%, var(--ts-l) 50% 100%); }
  .pe .ts-sw .ts-nm { color: var(--ts-d, var(--ds-text-2)); font-weight: 700; overflow-wrap: anywhere; }
  .pe .ts-sw-none .ts-chip { background: repeating-linear-gradient(45deg, #2c2c2c 0 4px, #161616 4px 8px); }
  .pe .ts-aa { flex: none; min-width: 30px; text-align: center; line-height: 1; color: var(--ds-text-strong); }
  .pe .ts-pv { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 10px; }
  .pe .ts-pv-row { border-radius: var(--ds-r-md); padding: 10px 14px; border: 1px solid var(--ds-line-soft); min-width: 0; }
  .pe .ts-pv-row.ts-dark { background: var(--ts-bg-d, #0f0f11); --ts-ink: #e4e4e7; --ts-lbl: #a1a1aa; --ts-at: var(--ts-at-d, #81c784); --ts-msg: var(--ts-msg-d, var(--ts-ink)); }
  .pe .ts-pv-row.ts-light { background: var(--ts-bg-l, #ffffff); border-color: #d4d4d8; --ts-ink: #27272a; --ts-lbl: #52525b; --ts-at: var(--ts-at-l, #276b2b); --ts-msg: var(--ts-msg-l, var(--ts-ink)); }
  .pe .ts-pv-t { display: block; margin-bottom: 4px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ts-lbl); }
  .pe .ts-line { margin: 0; color: var(--ts-ink); font: 400 15px/1.5 var(--ds-font); overflow-wrap: anywhere; }
  .pe .ts-who { font-weight: 700; margin-inline-end: 8px; }
  .pe .ts-msg { color: var(--ts-msg); font-family: var(--ts-font, inherit); font-size: calc(1em * var(--ts-scale, 1)); }
  .pe .ts-at { color: var(--ts-at); font-weight: 700; }
  .pe .ts .hint { margin: 0; }
  .pe .ts-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  @media (prefers-reduced-motion: reduce) { .pe .ts-sw, .pe .ts-font { transition: none; } }

  /* verify box (kept from before) */
  .verify-box { background: linear-gradient(135deg, #1a2f1a, #0f1f0f); border: 1px solid var(--ds-green); border-radius: var(--ds-r-xl); padding: var(--ds-sp-5); box-shadow: 0 0 24px rgba(76,175,80,0.3); animation: pulse-border 2s ease-in-out infinite; }
