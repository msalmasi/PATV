<%# A room's schedule on its page (1.99bx): on now, the booked / scheduled slots ahead, the queue.
    Pass { slug, schedule (mainstage.roomSchedule), manage }. Times are rendered in UTC here and turned
    into the viewer's local time by public/js/room-schedule.js, which also refreshes it every 30 s from
    /api/rooms/:slug/stage. Requests waiting for the owner's OK are only in `schedule` for the room's
    managers and the person who asked (roomSchedule decides) - this template shows whatever it gets. %>
<%
  const S = schedule || { live: [], upcoming: [], queue: [] };
  const iso = (ms) => new Date(Number(ms)).toISOString();
  const utc = (ms) => iso(ms).slice(0, 10) + ' ' + iso(ms).slice(11, 16) + ' UTC';
  const src = (r) => r.mode === 'embed' ? '▶ ' + (r.embed_label || 'Video link') : '🎥 Stream';
%>
<style>
  .rs h2 { align-items: center; flex-wrap: wrap; }
  .rs h2 .acts { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .rs .sbtn { font-family: Ubuntu, sans-serif; letter-spacing: 0; text-transform: none; font-size: 12.5px; font-weight: bold; padding: 5px 12px; border-radius: 999px;
              background: linear-gradient(90deg, #e53935, #ff7043); color: #fff !important; white-space: nowrap; }
  .rs .sbtn.ghost { background: #1d1a0f; border: 1px solid #6b5a20; color: #f3e3a3 !important; }
  .rs .sbtn:focus-visible { outline: 2px solid #ffd700; outline-offset: 2px; }
  .rs .scols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 1fr); gap: 14px; align-items: start; }
  .rs h3 { margin: 0 0 6px; font-size: 12px; color: #9fb39f; text-transform: uppercase; letter-spacing: .08em; font-weight: normal; }
  .rs ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .rs .srow { display: grid; grid-template-columns: minmax(0, 1fr); gap: 3px; padding: 8px 10px; border-radius: 10px; background: rgba(0,0,0,.35); border: 1px solid #1f2a20; font-size: 13.5px; min-width: 0; }
  .rs .srow.live { border-color: #7a2222; background: #1a0f0f; }
  .rs .srow.pend { border-style: dashed; border-color: #6b5a20; }
  .rs .srow.mine { box-shadow: inset 3px 0 0 #4caf50; }
  .rs .when { color: #c6e94f; font-variant-numeric: tabular-nums; font-size: 12.5px; }
  .rs .srow.live .when { color: #ffb4b4; font-weight: bold; }
  .rs .who { min-width: 0; overflow-wrap: anywhere; }
  .rs .who b { color: #fff; }
  .rs .who .ttl { color: #bbb; }
  .rs .who .ttl::before { content: " · "; color: #666; }
  .rs .tags { display: flex; flex-wrap: wrap; gap: 4px; }
  .rs .tg { font-size: 11px; padding: 1px 8px; border-radius: 999px; border: 1px solid #333; color: #bbb; background: #151515; white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
  .rs .tg.feat { border-color: #6b5a20; color: #f3e3a3; background: #1d1a0f; }
  .rs .tg.pend { border-color: #6b5a20; color: #ffcf7a; background: #1d160a; }
  .rs .tg.you { border-color: #2f6b3a; color: #bdf0c6; background: #12301a; }
  .rs .empty { color: #888; font-size: 13px; padding: 4px 2px; }
  .rs .note { color: #888; font-size: 12px; margin: 8px 0 0; }
  @media (max-width: 860px) { .rs .scols { grid-template-columns: minmax(0, 1fr); } }
</style>
<section class="card rs" id="rmSched" aria-labelledby="rmSchedH" data-slug="<%= slug %>">
  <h2 id="rmSchedH"><span>📅 Schedule</span>
    <span class="acts">
      <a class="sbtn" href="/stage?room=<%= encodeURIComponent(slug) %>">Book a slot</a>
      <% if (manage) { %><a class="sbtn ghost" href="/p/<%= encodeURIComponent(slug) %>/settings#stage">⚙ Pad settings<%= S.pending ? ' · ' + S.pending + ' to approve' : '' %></a><% } %>
    </span></h2>
  <div class="scols">
    <div>
      <h3 id="rsLiveH">On now</h3>
      <ul id="rsLive" aria-labelledby="rsLiveH">
        <% if (!S.live.length) { %><li class="empty">Nothing on this stage right now.</li><% } %>
        <% S.live.forEach((r) => { %><li class="srow<%= r.live ? ' live' : '' %><%= r.mine ? ' mine' : '' %>">
          <span class="when"><%= r.live ? '● LIVE' : 'Starting' %> · until <time data-ts="<%= r.ends_by %>" data-fmt="t" datetime="<%= iso(r.ends_by) %>"><%= iso(r.ends_by).slice(11, 16) %> UTC</time></span>
          <span class="who"><b><% if (r.href) { %><a class="ulink" href="<%= r.href %>" title="<%= r.username %>"><%= r.display %></a><% } else { %><%= r.display %><% } %></b><% if (r.title) { %><span class="ttl"><%= r.title %></span><% } %></span>
          <span class="tags"><span class="tg<%= r.featured ? ' feat' : '' %>"><%= r.featured ? '★ Featured' : 'Ordinary slot' %></span><span class="tg"><%= src(r) %></span><% if (r.mine) { %><span class="tg you">You</span><% } %></span>
        </li><% }) %>
      </ul>
    </div>
    <div>
      <h3 id="rsUpH">Coming up</h3>
      <ul id="rsUp" aria-labelledby="rsUpH">
        <% if (!S.upcoming.length) { %><li class="empty">Nothing booked yet — <a href="/stage?room=<%= encodeURIComponent(slug) %>">book the first slot</a>.</li><% } %>
        <% S.upcoming.forEach((r) => { %><li class="srow<%= r.status === 'requested' ? ' pend' : '' %><%= r.mine ? ' mine' : '' %>">
          <span class="when"><time data-ts="<%= r.start_at %>" data-min="<%= r.minutes %>" datetime="<%= iso(r.start_at) %>"><%= utc(r.start_at) %></time> · <%= r.minutes %> min</span>
          <span class="who"><b><% if (r.href) { %><a class="ulink" href="<%= r.href %>" title="<%= r.username %>"><%= r.display %></a><% } else { %><%= r.display %><% } %></b><% if (r.title) { %><span class="ttl"><%= r.title %></span><% } %></span>
          <span class="tags"><span class="tg<%= r.featured ? ' feat' : '' %>"><%= r.featured ? '★ Featured' : 'Ordinary slot' %></span><span class="tg"><%= src(r) %></span><% if (r.status === 'requested') { %><span class="tg pend">⏳ Waiting for the owner's OK</span><% } %><% if (r.mine) { %><span class="tg you">You</span><% } %></span>
        </li><% }) %>
      </ul>
    </div>
    <div>
      <h3 id="rsQH">Queue</h3>
      <ul id="rsQ" aria-labelledby="rsQH">
        <% if (!S.queue.length) { %><li class="empty">Nobody waiting — a free slot goes to the next in line.</li><% } %>
        <% S.queue.forEach((r) => { %><li class="srow<%= r.mine ? ' mine' : '' %>">
          <span class="when">#<%= r.position %> · <%= r.minutes %> min</span>
          <span class="who"><b><% if (r.href) { %><a class="ulink" href="<%= r.href %>" title="<%= r.username %>"><%= r.display %></a><% } else { %><%= r.display %><% } %></b><% if (r.title) { %><span class="ttl"><%= r.title %></span><% } %></span>
          <span class="tags"><span class="tg<%= r.featured ? ' feat' : '' %>"><%= r.featured ? '★ Featured' : 'Ordinary slot' %></span><span class="tg"><%= r.mode === 'embed' ? '▶ Video link' : '🎥 Stream' %></span><% if (r.mine) { %><span class="tg you">You</span><% } %></span>
        </li><% }) %>
      </ul>
    </div>
  </div>
  <p class="note" id="rsNote">Times in your local time<span id="rsTz"></span>.</p>
</section>
<script src="/public/js/room-schedule.js?v=3" defer></script>
