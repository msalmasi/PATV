<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<%# A pad's stage schedule (1.99bx; 1.99dx: no longer a card of its own; 1.99ee: the lower half of the pad's Go live
    card in views/room.ejs, under its slot status and action row): on now, the booked / scheduled slots
    ahead, the queue. Pass { slug, schedule (mainstage.roomSchedule) }. Times are rendered in UTC here and
    turned into the viewer's local time by public/js/room-schedule.js, which also refreshes it (and the
    card's slot status line) every 30 s from /api/rooms/:slug/stage. Requests waiting for the owner's OK are
    only in `schedule` for the pad's managers and the person who asked (roomSchedule decides) - this template
    shows whatever it gets. The pad settings link lives in the pad header only. %>
<%
  const S = schedule || { live: [], upcoming: [], queue: [] };
  const iso = (ms) => new Date(Number(ms)).toISOString();
  const utc = (ms) => iso(ms).slice(0, 10) + ' ' + iso(ms).slice(11, 16) + ' UTC';
  const src = (r) => r.mode === 'embed' ? '▶ ' + (r.embed_label ? t.esc(r.embed_label) : t('pad.sched.video_link')) : t('pad.sched.stream');
%>
<style>
  .rs { display: grid; gap: 8px; margin-top: 12px; padding-top: 12px; border-top: 1px solid #1f2a20; }
  .rs .scols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 1fr); gap: 14px; align-items: start; }
  .rs h3 { margin: 0 0 6px; font-size: 12px; color: #9fb39f; text-transform: uppercase; letter-spacing: .08em; font-weight: normal; }
  .rs ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .rs .srow { display: grid; grid-template-columns: minmax(0, 1fr); gap: 3px; padding: 8px 10px; border-radius: 10px; background: rgba(0,0,0,.35); border: 1px solid #1f2a20; font-size: 13.5px; min-width: 0; }
  .rs .srow.live { border-color: #7a2222; background: #1a0f0f; }
  .rs .srow.pend { border-style: dashed; border-color: #6b5a20; }
  .rs .srow.mine { box-shadow: inset 3px 0 0 #4caf50; }
  .rs .when { color: #c6e94f; font-variant-numeric: tabular-nums; font-size: 12.5px; }
  .rs .srow.live .when { color: #ffb4b4; font-weight: bold; }
  .rs .who { min-width: 0; overflow-wrap: anywhere; }
  .rs .who b { color: #fff; }
  .rs .who .ttl { color: #bbb; }
  .rs .who .ttl::before { content: " · "; color: #666; }
  .rs .tags { display: flex; flex-wrap: wrap; gap: 4px; }
  .rs .tg { font-size: 11px; padding: 1px 8px; border-radius: 999px; border: 1px solid #333; color: #bbb; background: #151515; white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
  .rs .tg.feat { border-color: #6b5a20; color: #f3e3a3; background: #1d1a0f; }
  .rs .tg.pend { border-color: #6b5a20; color: #ffcf7a; background: #1d160a; }
  .rs .tg.you { border-color: #2f6b3a; color: #bdf0c6; background: #12301a; }
  .rs .empty { color: #888; font-size: 13px; padding: 4px 2px; }
  .rs .note { color: #7d7d7d; font-size: 11.5px; margin: 0; }
  @media (max-width: 860px) { .rs .scols { grid-template-columns: minmax(0, 1fr); } }
</style>
<div class="rs" id="rmSched" data-slug="<%= slug %>" role="group" aria-label="<%- t('pad.sched.aria') %>">
  <div class="scols">
    <div>
      <h3 id="rsLiveH"><%- t('pad.sched.on_now') %></h3>
      <ul id="rsLive" aria-labelledby="rsLiveH">
        <% if (!S.live.length) { %><li class="empty"><%- t('pad.sched.nothing_now') %></li><% } %>
        <% S.live.forEach((r) => { %><li class="srow<%= r.live ? ' live' : '' %><%= r.mine ? ' mine' : '' %>">
          <span class="when"><%- r.live ? t('pad.sched.live') : t('pad.sched.starting') %> · <%- t('pad.sched.until') %> <time data-ts="<%= r.ends_by %>" data-fmt="t" datetime="<%= iso(r.ends_by) %>"><%= iso(r.ends_by).slice(11, 16) %> UTC</time></span>
          <span class="who"><b><% if (r.href) { %><a class="ulink" href="<%= r.href %>" title="<%= r.username %>"><%= r.display %></a><% } else { %><%= r.display %><% } %></b><% if (r.title) { %><span class="ttl"><%= r.title %></span><% } %></span>
          <span class="tags"><span class="tg<%= r.featured ? ' feat' : '' %>"><%- r.featured ? t('pad.sched.featured') : t('pad.sched.ordinary') %></span><span class="tg"><%- src(r) %></span><% if (r.mine) { %><span class="tg you"><%- t('pad.sched.you') %></span><% } %></span>
        </li><% }) %>
      </ul>
    </div>
    <div>
      <h3 id="rsUpH"><%- t('pad.sched.coming_up') %></h3>
      <ul id="rsUp" aria-labelledby="rsUpH">
        <% if (!S.upcoming.length) { %><li class="empty"><%- t('pad.sched.none_booked', { link: '<a href="/stage?room=' + encodeURIComponent(slug) + '#whenSet">' + t('pad.sched.book_first') + '</a>' }) %></li><% } %>
        <% S.upcoming.forEach((r) => { %><li class="srow<%= r.status === 'requested' ? ' pend' : '' %><%= r.mine ? ' mine' : '' %>">
          <span class="when"><time data-ts="<%= r.start_at %>" data-min="<%= r.minutes %>" datetime="<%= iso(r.start_at) %>"><%= utc(r.start_at) %></time> · <%- t('pad.sched.min', { n: r.minutes }) %></span>
          <span class="who"><b><% if (r.href) { %><a class="ulink" href="<%= r.href %>" title="<%= r.username %>"><%= r.display %></a><% } else { %><%= r.display %><% } %></b><% if (r.title) { %><span class="ttl"><%= r.title %></span><% } %></span>
          <span class="tags"><span class="tg<%= r.featured ? ' feat' : '' %>"><%- r.featured ? t('pad.sched.featured') : t('pad.sched.ordinary') %></span><span class="tg"><%- src(r) %></span><% if (r.status === 'requested') { %><span class="tg pend"><%- t('pad.sched.waiting_ok') %></span><% } %><% if (r.mine) { %><span class="tg you"><%- t('pad.sched.you') %></span><% } %></span>
        </li><% }) %>
      </ul>
    </div>
    <div>
      <h3 id="rsQH"><%- t('pad.sched.queue') %></h3>
      <ul id="rsQ" aria-labelledby="rsQH">
        <% if (!S.queue.length) { %><li class="empty"><%- t('pad.sched.nobody_waiting') %></li><% } %>
        <% S.queue.forEach((r) => { %><li class="srow<%= r.mine ? ' mine' : '' %>">
          <span class="when">#<%= r.position %> · <%- t('pad.sched.min', { n: r.minutes }) %></span>
          <span class="who"><b><% if (r.href) { %><a class="ulink" href="<%= r.href %>" title="<%= r.username %>"><%= r.display %></a><% } else { %><%= r.display %><% } %></b><% if (r.title) { %><span class="ttl"><%= r.title %></span><% } %></span>
          <span class="tags"><span class="tg<%= r.featured ? ' feat' : '' %>"><%- r.featured ? t('pad.sched.featured') : t('pad.sched.ordinary') %></span><span class="tg"><%- r.mode === 'embed' ? '▶ ' + t('pad.sched.video_link') : t('pad.sched.stream') %></span><% if (r.mine) { %><span class="tg you"><%- t('pad.sched.you') %></span><% } %></span>
        </li><% }) %>
      </ul>
    </div>
  </div>
  <p class="note" id="rsNote"><%- t('pad.sched.local_time', { tz: '<span id="rsTz"></span>' }) %></p>
</div>
<script src="/public/js/room-schedule.js?v=5" defer></script>
