<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<%#
  The feed sort bar (1.99bx): Hot / New / Top / Controversial / Rising, and a time filter that only shows
  for Top and Controversial. Reused by /feed, the room feeds (and Following / profiles).
  Locals: fx, sort, top (time window), href(sort, t) -> url, label (aria label, optional), swap (links swap the list in place on /feed),
  hop (1.99eq, optional: this feed's Hop scope - "all" | "following" | "p/<slug>" | "u/<username>"): the "▶ Hop" button, which opens
  Hop (public/js/hop.js) on this feed in this sort; without JS it's a link to the feed's Hop page
  gallery (1.99fn, optional: feedgallery.forFeed): the ☰ List / ▦ Gallery toggle, and the gallery grid right after the bar
  (feed-gallery.ejs - a sibling of the post list; the bar's data-view picks which one shows)
%><%
  const t_ = fx.WINDOWS.includes(top) ? top : 'week';
  const timed_ = fx.TIMED.has(sort);
  const L_ = (k, d) => (t.has(k) ? t(k) : t.esc(d));     // i18n: a sort / window label (HTML), English from fx when the catalog lacks it
  const sw_ = typeof swap !== 'undefined' && swap ? ' data-swap' : '';
  const G_ = typeof gallery !== 'undefined' && gallery && gallery.scope && typeof hop !== 'undefined' && hop ? gallery : null;
  // the toggle's no-JS links: this feed, this sort, + ?view=
  const vHref_ = (v) => {
    const h = href(sort, timed_ ? t_ : ''), i = h.indexOf('#');
    const b = i >= 0 ? h.slice(0, i) : h, hash = i >= 0 ? h.slice(i) : '';
    return b + (b.indexOf('?') < 0 ? '?' : b.endsWith('?') || b.endsWith('&') ? '' : '&') + 'view=' + v + hash;
  };
%>
<nav class="fs" aria-label="<% if (typeof label !== 'undefined' && label) { %><%= label %><% } else { %><%- t('feed.sort.aria') %><% } %>"<% if (G_) { %> data-view="<%= G_.view %>"<% } %>>
  <div class="fs-sorts">
    <% fx.SORTS.forEach((s) => { %><a<%- sw_ %> class="fs-pill<%= sort === s ? ' on' : '' %>" href="<%= href(s, fx.TIMED.has(s) ? t_ : '') %>"<%= sort === s ? ' aria-current=true' : '' %>><%- fx.icon(s) %><span><%- L_('feed.sort.' + s, fx.SORT_LABELS[s]) %></span></a><% }) %>
  </div>
  <% if (G_) { const gal_ = G_.view === 'gallery'; %>
    <div class="fv" role="group" aria-label="<%- t('feed.view.aria') %>" data-fv-scope="<%= G_.scope %>" data-fv-src="<%= G_.src %>">
      <a class="fv-b<%= gal_ ? '' : ' on' %>" href="<%= vHref_('list') %>" data-fv="list" aria-pressed="<%= gal_ ? 'false' : 'true' %>" title="<%- t('feed.view.list_title') %>"><span aria-hidden="true">☰</span><span class="fv-l"> <%- t('feed.view.list') %></span></a>
      <a class="fv-b<%= gal_ ? ' on' : '' %>" href="<%= vHref_('gallery') %>" data-fv="gallery" aria-pressed="<%= gal_ ? 'true' : 'false' %>" title="<%- t('feed.view.gallery_title') %>"><span aria-hidden="true">▦</span><span class="fv-l"> <%- t('feed.view.gallery') %></span></a>
    </div>
  <% } %>
  <% if (typeof hop !== 'undefined' && hop && fx.HOP) { %>
    <a class="fs-hop" href="<%= fx.hopHref(hop, { sort, t: timed_ ? t_ : '' }) %>" data-hop-scope="<%= hop %>" data-hop-sort="<%= sort %>" data-hop-t="<%= timed_ ? t_ : '' %>"
       title="<%= fx.HOP.hint %>" aria-label="<%= fx.HOP.name %>: <%= fx.HOP.hint.toLowerCase() %>"><%= fx.HOP.button %></a>
  <% } %>
  <% if (timed_) { %>
    <details class="fs-time">
      <summary aria-label="<%- t('feed.sort.range_aria', { w: L_('feed.window.' + t_, fx.WINDOW_LABELS[t_]) }) %>"><%- fx.icon('clock') %><span><%- L_('feed.window.' + t_, fx.WINDOW_LABELS[t_]) %></span><%- fx.icon('chevron', 'chev') %></summary>
      <div class="fs-menu" role="menu">
        <% fx.WINDOWS.forEach((w) => { %><a<%- sw_ %> role="menuitem" class="<%= w === t_ ? 'on' : '' %>" href="<%= href(sort, w) %>"><%- L_('feed.window.' + w, fx.WINDOW_LABELS[w]) %></a><% }) %>
      </div>
    </details>
  <% } %>
</nav>
<% if (G_) { %><%- include('feed-gallery', { G: G_, hop, sort, tw: timed_ ? t_ : '' }) %><% } %>
