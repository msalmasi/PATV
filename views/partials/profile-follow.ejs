<%#
  Profile hero: follower / following counts (public) and the Follow button (1.99bz). The lists themselves
  are only on the owner's own Following tab. Locals: social (feedweb.profileSocial), usernameProfile, previewing
%><% const S_ = social; const back_ = '/u/' + encodeURIComponent(usernameProfile) + '/profile'; %>
<div class="pf-follow">
  <span class="fw-counts">
    <span><b data-follower-count-kind="user" data-follower-count-id="<%= usernameProfile %>"><%= S_.counts.followers.toLocaleString('en-US') %></b> follower<%= S_.counts.followers === 1 ? '' : 's' %></span>
    <span><b><%= S_.counts.following.toLocaleString('en-US') %></b> following</span>
    <% if (S_.self && !previewing) { %><a href="/feed/following">your lists ›</a><% } %>
  </span>
  <% if (!S_.self && !previewing) { %><%- include('follow-btn', { kind: 'user', id: usernameProfile, following: S_.following, signed: S_.signed, next: back_ }) %><% } %>
  <% if (!S_.self && !previewing && S_.signed) { %><a class="pf-msg" href="/messages?to=<%= encodeURIComponent(usernameProfile) %>" title="Send a direct message">💬 Message</a><% } %>
  <% if (!S_.self && !previewing && S_.signed) { %><button type="button" class="pf-report" data-safety="report-user" data-user="<%= usernameProfile %>" title="Report this account to the site admins">⚑ Report user</button><% } %>
</div>
<% if (!S_.self && !previewing && S_.signed) { %><script src="/public/js/feed-safety.js?v=3" defer></script>
<style>.pf-report { background: none; border: 1px solid #3a3a42; color: #aaa; border-radius: 999px; padding: 3px 10px; font: 12.5px Ubuntu, sans-serif; cursor: pointer; }
.pf-report:hover, .pf-report:focus-visible { color: #ff8a80; border-color: #ff8a80; }
.pf-msg { display: inline-flex; align-items: center; gap: 4px; border: 1px solid #3CC47C; color: #e6ffe6 !important; background: #0f1a10; border-radius: 999px; padding: 3px 12px; font: bold 12.5px Ubuntu, sans-serif; text-decoration: none; }
.pf-msg:hover, .pf-msg:focus-visible { background: #17301a; }</style><% } %>
<link rel="stylesheet" href="/public/css/stories.css?v=2">
<script src="/public/js/follow.js?v=1" defer></script>
