<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: t('ach.title'), user: user}) %>
<%#
  views/achievements.ejs - the achievements page (index.js /achievements). 1.99lv design pass: arcade marquee hero with
  your progress (overall, per rarity, XP/PAT earned), a filter bar (group chips, unlocked/locked, rarity, search -
  plain client-side show/hide, the page works without JS), badge cards in a 2-up phone grid. Data is unchanged:
  achievements (site badges + catalog), holders {id: n}, owned (Set or null), viewing, own.
%>
<%
  const TIERS = ['common', 'uncommon', 'rare', 'legendary'];
  const fmt = (n) => Number(n || 0).toLocaleString('en-US');
  const siteIds = achievements.filter(a => a.site).map(a => a.id);
  const GROUPS = [['patv', t.esc("PATV"), siteIds], ['start', t('ach.group.start'), ["cf_linked","cf_telegram_","cf_google_","cf_wallet_","cf_cmd_1","cf_level_"]], ['chat', t('ach.group.chat'), ["cf_chat_","cf_streak_"]], ['mic', t('ach.group.mic'), ["cf_mic_","cf_top_mic"]], ['commands', t('ach.group.commands'), ["cf_cmd_","cf_say_","cf_roast_","cf_look_","cf_video_","cf_clip_10","cf_snap_","cf_sticker_","cf_sponsor","cf_imagine","cf_ask","cf_dj"]], ['room', t('ach.group.room'), ["cf_tip","cf_unblocked","cf_roasted","cf_clipped","cf_gang","cf_turf","cf_beg"]], ['heists', t('ach.group.heists'), ["cf_heist","cf_crack","cf_door","cf_convoy","cf_nat20","cf_bail","cf_pinched","cf_reroll","cf_store_"]], ['shop', t('ach.group.shop'), ["cf_shop_","cf_kit_","cf_hm_"]], ['kit', t('ach.group.kit'), ["cf_use_","cf_clutch","cf_relic_","cf_crate_"]], ['wheel', t('ach.group.wheel'), ["cf_spin","cf_wheel"]], ['cards', t('ach.group.cards'), ["cf_bj","cf_holdem","cf_cards_"]], ['casino', t('ach.group.casino'), ["cf_lotto","cf_bingo","cf_wager","cf_market","cf_loan","cf_high_roller"]], ['games', t('ach.group.games'), ["cf_trivia","cf_pictionary","cf_showdown","cf_fight"]], ['bounties', t('ach.group.bounties'), ["cf_bounty"]], ['plex', t('ach.group.plex'), ["cf_plex_"]], ['giving', t('ach.group.giving'), ["cf_gift_","cf_donor"]], ['stream', t('ach.group.stream'), ["cf_stream_","cf_micclip_"]], ['social', t('ach.group.social'), ["cf_post_","cf_comment_","cf_likes_","cf_follow","cf_poll_"]], ['style', t('ach.group.style'), ["cf_avatar_","cf_voice_","cf_stickers_","cf_cos_"]], ['pads', t('ach.group.pads'), ["cf_pad_","cf_boost_","cf_banner","cf_packs_","cf_translator"]], ['else', t('ach.group.else'), ["cf_"]]];
  const used = new Set();
  const sections = GROUPS.map(([slug, title, prefixes]) => {
    const items = achievements.filter(a => !used.has(a.id) && prefixes.some(p => a.id === p || a.id.startsWith(p)));
    items.forEach(a => used.add(a.id));
    return { slug, title, items, got: owned ? items.filter(a => owned.has(a.id)).length : 0 };
  }).filter(s => s.items.length);
  const has = (a) => !!(owned && owned.has(a.id));
  // 1.99mt: names + descriptions localized (en.json ach.n.<id> / ach.d.<id>); the site's own PATV badges stay as stored
  const nameOf = (a) => t.has('ach.n.' + a.id) ? t('ach.n.' + a.id) : t.esc(a.name);
  const descOf = (a) => t.has('ach.d.' + a.id) ? t('ach.d.' + a.id) : t.esc(a.desc);
  const total = achievements.length, gotN = owned ? achievements.filter(has).length : 0;
  const pct = total ? Math.round(gotN * 100 / total) : 0;
  const tierN = Object.fromEntries(TIERS.map(k => [k, { all: achievements.filter(a => (a.tier || 'common') === k).length, got: achievements.filter(a => (a.tier || 'common') === k && has(a)).length }]));
  const earnedXp = owned ? achievements.filter(has).reduce((s, a) => s + (a.xp || 0), 0) : 0;
  const earnedPat = owned ? achievements.filter(has).reduce((s, a) => s + (a.pat || 0), 0) : 0;
  const theirs = typeof viewing !== 'undefined' && viewing && !own;
%>
<style>
  /* 1.99pt polish: on the design system (docs/design-system.md, "Area notes: games"). Keeps the arcade marquee (scanlines, neon,
     pixel section heads and badge names) but reads ds tokens; the h1 is the display style (no pixel-font h1s) with the gold glow. */
  .acx { --ds-ac: var(--ds-acc-ach); --ds-ac-2: var(--ds-acc-ach); --ds-ac-bg: rgba(57,255,136,.10); --ds-ac-line: #1f5a36; --ds-on-ac: #02140a;
         --neon: var(--ds-acc-ach); --gold: var(--ds-gold); --cyan: #3de8ff;
         --t-common: var(--ds-r-common); --t-uncommon: var(--ds-r-uncommon); --t-rare: var(--ds-r-rare); --t-legendary: var(--ds-r-legendary); }
  .acx a:not([class]) { color: var(--neon); }
  .acx .px { font-family: var(--ds-font-pixel); }

  /* marquee hero */
  .acx .hero { position: relative; overflow: hidden; border: 1px solid #1e3a2a; border-radius: var(--ds-r-2xl); padding: var(--ds-sp-8) var(--ds-sp-8) var(--ds-sp-7);
               background: radial-gradient(70% 120% at 50% -10%, #102a1c 0%, rgba(8,8,8,0) 70%), #080808;
               box-shadow: inset 0 0 0 4px #0b0b0b, inset 0 0 0 5px #173022, 0 0 30px rgba(57,255,136,.08);
               display: grid; gap: var(--ds-sp-6); grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; }
  .acx .hero::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
                       background: repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 1px, transparent 1px 3px); }
  .acx .hero > * { position: relative; }
  .acx .hero-main { display: grid; gap: var(--ds-sp-2); min-width: 0; }
  .acx .hero .ds-eyebrow { color: var(--cyan); }
  .acx .hero h1 { margin: var(--ds-sp-1) 0; color: var(--gold); text-shadow: 0 0 6px rgba(255,215,64,.6), 0 0 22px rgba(255,170,0,.35), 3px 3px 0 #5a2d00; }

  /* score panel */
  .acx .score { background: var(--ds-sunken); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); display: grid; gap: var(--ds-sp-3); }
  .acx .score .who { font-size: 9px; color: #a3b3a3; line-height: 1.8; letter-spacing: .08em; }
  .acx .score .big { font-size: clamp(22px, 3.4vw, 30px); color: var(--ds-text-strong); line-height: 1.2; font-variant-numeric: tabular-nums; }
  .acx .score .big small { font-size: .5em; color: var(--ds-text-muted); }
  .acx .bar { height: 16px; border: 1px solid #2e2e2e; border-radius: var(--ds-r-xs); background: #050505; padding: 2px; }
  .acx .bar i { display: block; height: 100%; width: var(--p); border-radius: 2px;
                background: repeating-linear-gradient(90deg, var(--neon) 0 8px, #1fbf62 8px 10px); box-shadow: 0 0 10px rgba(57,255,136,.55); }
  .acx .tiers { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--ds-sp-1h); }
  .acx .tiers div { background: var(--ds-surface); border: 1px solid var(--ds-line); border-top: 3px solid var(--tc); border-radius: var(--ds-r-sm); padding: 7px 6px; text-align: center; min-width: 0; }
  .acx .tiers b { display: block; font: 11px/1.5 var(--ds-font-pixel); color: var(--ds-text-strong); font-variant-numeric: tabular-nums; }
  .acx .tiers span { font-size: 11px; font-weight: 700; color: var(--tc); text-transform: capitalize; }
  .acx .earned { display: flex; flex-wrap: wrap; gap: var(--ds-sp-1h); }
  .acx .chip { display: inline-flex; align-items: center; gap: 4px; font: 700 12px/1.5 var(--ds-font); padding: 2px 9px; border-radius: var(--ds-r-pill); border: 1px solid var(--ds-line-strong); background: #151515; color: #ddd; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .acx .chip.xp { color: var(--cyan); border-color: #1b4650; background: #08181b; }
  .acx .chip.pat { color: var(--ds-gold-text); border-color: var(--ds-gold-line); background: #1a1708; }
  .acx .signin { font-size: var(--ds-fs-sm); color: var(--ds-text-2); margin: 0; }

  /* filter bar */
  .acx .fb { background: var(--ds-sunken); border: 1px solid var(--ds-line); border-radius: var(--ds-r-lg); padding: var(--ds-sp-2h); display: grid; gap: var(--ds-sp-2h); min-width: 0; }
  @media (min-width: 1000px) { .acx .fb { position: sticky; top: var(--ds-sp-2); z-index: var(--ds-z-sticky); box-shadow: 0 8px 22px rgba(0,0,0,.6); } }
  .acx .fb .row { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2); align-items: center; }
  .acx .chips { display: flex; gap: var(--ds-sp-1h); overflow-x: auto; padding: 2px; margin: -2px; scrollbar-width: none; }
  .acx .chips::-webkit-scrollbar { display: none; }
  @media (min-width: 1000px) { .acx .chips { flex-wrap: wrap; overflow: visible; } }
  .acx .chips button, .acx .seg button { flex: none; display: inline-flex; align-items: center; gap: 6px; min-height: 36px; margin: 0; padding: 0 var(--ds-sp-3); background: #151515; border: 1px solid #2c2c2c; color: #ccc;
                                         border-radius: var(--ds-r-pill); font: 500 var(--ds-fs-meta)/1 var(--ds-font); cursor: pointer; white-space: nowrap; transition: border-color var(--ds-dur-1); }
  .acx .chips button:hover, .acx .seg button:hover { border-color: var(--neon); color: #fff; }
  .acx .chips button:focus-visible, .acx .seg button:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  @media (pointer: coarse) { .acx .chips button, .acx .seg button { min-height: 40px; } }
  .acx .chips button small { color: var(--ds-text-faint); font-size: var(--ds-fs-xs); font-variant-numeric: tabular-nums; }
  .acx .chips button[aria-pressed=true], .acx .seg button[aria-pressed=true] { background: #0f2a1a; border-color: var(--neon); color: #fff; box-shadow: 0 0 8px rgba(57,255,136,.25); }
  .acx .chips button[aria-pressed=true] small { color: #9be3b4; }
  .acx .seg { display: inline-flex; gap: var(--ds-sp-1); flex-wrap: wrap; }
  .acx .seg button .ds-ic { font-size: 12px; width: 14px; height: 14px; }
  .acx .seg button[data-tier] { border-color: color-mix(in srgb, var(--tc) 45%, #2c2c2c); color: var(--tc); }
  .acx .seg button[data-tier][aria-pressed=true] { background: color-mix(in srgb, var(--tc) 18%, #111); border-color: var(--tc); color: #fff; }
  .acx .fb .ds-in.ds-in { flex: 1 1 200px; width: auto; min-height: 40px; padding-block: 8px; }
  .acx .fb .n { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); white-space: nowrap; margin-inline-start: auto; font-variant-numeric: tabular-nums; }
  .acx .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* groups: one section-heading style - the neon pixel head */
  .acx .grp[hidden] { display: none; }
  .acx .grp { min-width: 0; }
  .acx .gh { display: flex; align-items: center; gap: var(--ds-sp-3); margin: 0 0 var(--ds-sp-3); }
  .acx .gh h2 { margin: 0; color: var(--neon); text-shadow: 0 0 8px rgba(57,255,136,.45); }
  .acx .gh .line { flex: 1; height: 2px; background: repeating-linear-gradient(90deg, #1f3a2a 0 6px, transparent 6px 10px); }
  .acx .gh .gp { font: 9px var(--ds-font-pixel); color: #a3b3a3; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .acx .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: var(--ds-sp-3); }

  /* badge cards */
  .acx .ach { --tc: var(--t-common); position: relative; background: #0f0f0f; border: 1px solid #262626; border-radius: var(--ds-r-xl); padding: var(--ds-sp-4) var(--ds-sp-3) var(--ds-sp-3);
              display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--ds-sp-1h); min-width: 0; }
  .acx .ach[hidden] { display: none; }
  .acx .uncommon { --tc: var(--t-uncommon); } .acx .rare { --tc: var(--t-rare); } .acx .legendary { --tc: var(--t-legendary); }
  .acx .tiers .common { --tc: var(--t-common); }
  .acx .seg .common { --tc: var(--t-common); }
  .acx .frame { width: 84px; height: 84px; border-radius: var(--ds-r-md); display: grid; place-items: center; background: radial-gradient(circle at 50% 40%, color-mix(in srgb, var(--tc) 16%, #111) 0%, #0a0a0a 70%);
                border: 2px solid color-mix(in srgb, var(--tc) 55%, #222); }
  .acx .frame img { width: 68px; height: 68px; image-rendering: pixelated; }
  .acx .tier { font: 9px/1.6 var(--ds-font-pixel); letter-spacing: .1em; color: var(--tc); text-transform: uppercase; }
  .acx .nm { margin: 0; font: 10px/1.55 var(--ds-font-pixel); color: var(--ds-text-strong); text-transform: uppercase; }
  .acx .ds { font-size: var(--ds-fs-meta); color: var(--ds-text-2); line-height: 1.45; margin: 0; }
  .acx .rw { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--ds-sp-1); margin-top: auto; padding-top: var(--ds-sp-1); }
  .acx .rw .chip { font-size: 11px; padding: 1px 7px; }
  .acx .hd { font-size: 11px; color: var(--ds-text-faint); }
  .acx .st { position: absolute; top: var(--ds-sp-2); inset-inline-end: var(--ds-sp-2); display: grid; place-items: center; min-width: 22px; height: 22px; font: 700 11px/1 var(--ds-font); padding: 0 5px; border-radius: var(--ds-r-xs); }
  .acx .st > span[aria-hidden] { font-family: var(--ds-font-emoji); }
  .acx .got { border-color: var(--neon); box-shadow: 0 0 0 1px rgba(57,255,136,.25), 0 0 16px rgba(57,255,136,.18); background: linear-gradient(180deg, #0e1f15 0%, #0f0f0f 45%); }
  .acx .got .st { background: var(--neon); color: #002a12; }
  .acx .locked .frame img { filter: grayscale(1) brightness(.4); }
  .acx .locked .nm { color: var(--ds-text-muted); }
  .acx .locked .st { background: #1c1c1c; color: var(--ds-text-muted); border: 1px solid var(--ds-line-strong); }
  .acx .legendary.got { border-color: var(--gold); box-shadow: 0 0 0 1px rgba(255,215,64,.3), 0 0 18px rgba(255,200,0,.25); background: linear-gradient(180deg, #221c06 0%, #0f0f0f 45%); }
  .acx .legendary.got .st { background: var(--gold); color: var(--ds-on-gold); }
  .acx .none { margin: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .acx .hero h1 { animation: acx-flicker 6s steps(1) infinite; }
    @keyframes acx-flicker { 0%, 93%, 96%, 100% { opacity: 1; } 94% { opacity: .55; } 95% { opacity: .9; } }
    .acx .ach { transition: transform var(--ds-dur-2) ease, box-shadow var(--ds-dur-2) ease; }
    .acx .ach:hover { transform: translateY(-2px); }
  }
  @media (max-width: 760px) { .acx .hero { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 520px) {
    .acx .hero { padding: var(--ds-sp-6) var(--ds-sp-5) var(--ds-sp-5); }
    .acx .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ds-sp-2); }
    .acx .ach { padding: var(--ds-sp-3) var(--ds-sp-2) var(--ds-sp-2h); }
    .acx .frame { width: 68px; height: 68px; } .acx .frame img { width: 56px; height: 56px; }
    .acx .nm { font-size: 9px; }
    .acx .ds { font-size: var(--ds-fs-xs); }
    .acx .rw .chip { font-size: 10px; padding: 1px 5px; }
    .acx .hd { font-size: 11px; }
    .acx .st { top: 6px; inset-inline-end: 6px; }
    .acx .tiers { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .acx .tiers div { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 2px 6px; text-align: start; padding: 6px 8px; }
    .acx .tiers span { overflow-wrap: normal; }
    .acx .tiers b { order: 2; font-size: 10px; }
  }
</style>
<main class="ds-page wide acx">
  <section class="hero" aria-labelledby="acxH">
    <div class="hero-main">
      <span class="ds-eyebrow"><%- t('ach.eyebrow', { n: fmt(total) }) %></span>
      <h1 id="acxH" class="ds-display"><%- t('ach.heading') %></h1>
      <p class="ds-lead"><%- t('ach.lede') %></p>
    </div>
    <div class="score">
      <% if (owned) { %>
        <div class="who px"><%- theirs ? t('ach.score.theirs', { name: viewing }) : t('ach.score.yours') %></div>
        <div class="big px"><%= gotN %> <small>/ <%= total %></small></div>
        <div class="bar" role="progressbar" aria-valuemin="0" aria-valuemax="<%= total %>" aria-valuenow="<%= gotN %>"
             aria-label="<%- theirs ? t('ach.they_have', { name: viewing, n: gotN, total }) : t('ach.you_have', { n: gotN, total }) %>"><i style="--p: <%= pct %>%"></i></div>
      <% } else { %>
        <div class="who px"><%- t('ach.score.catalog') %></div>
        <div class="big px"><%= total %></div>
      <% } %>
      <div class="tiers">
        <% TIERS.forEach((k) => { %><div class="<%= k %>"><b><%= owned ? tierN[k].got + '/' + tierN[k].all : tierN[k].all %></b><span><%- t('ach.tier.' + k) %></span></div><% }) %>
      </div>
      <% if (owned) { %>
        <div class="earned"><span class="chip xp"><%- t('ach.earned_xp', { n: fmt(earnedXp) }) %></span><span class="chip pat"><%- t('ach.earned_pat', { n: fmt(earnedPat) }) %></span></div>
      <% } else { %>
        <p class="signin"><%- t('ach.signin', { link: '<a href="/login?next=/achievements">' + t('ach.signin_link') + '</a>' }) %></p>
      <% } %>
    </div>
  </section>

  <div class="fb" role="search" aria-label="<%- t('ach.filter.aria') %>" id="acxBar" hidden>
    <div class="chips" role="group" aria-label="<%- t('ach.filter.group') %>">
      <button type="button" data-group="" aria-pressed="true"><%- t('ach.filter.all') %><small><%= owned ? gotN + '/' + total : total %></small></button>
      <% sections.forEach((s) => { %><button type="button" data-group="<%= s.slug %>" aria-pressed="false"><%- s.title %><small><%= owned ? s.got + '/' + s.items.length : s.items.length %></small></button><% }) %>
    </div>
    <div class="row">
      <% if (owned) { %>
      <div class="seg" role="group" aria-label="<%- t('ach.filter.status') %>">
        <button type="button" data-state="" aria-pressed="true"><%- t('ach.filter.all') %></button>
        <button type="button" data-state="got" aria-pressed="false"><span class="ds-ic" aria-hidden="true">✓</span><%- t('ach.state.unlocked') %></button>
        <button type="button" data-state="locked" aria-pressed="false"><span class="ds-ic" aria-hidden="true">🔒</span><%- t('ach.state.locked') %></button>
      </div>
      <% } %>
      <div class="seg" role="group" aria-label="<%- t('ach.filter.rarity') %>">
        <% TIERS.forEach((k) => { %><button type="button" class="<%= k %>" data-tier="<%= k %>" aria-pressed="false"><%- t('ach.tier.' + k) %></button><% }) %>
      </div>
      <label class="sr" for="acxQ"><%- t('ach.filter.search_label') %></label>
      <input id="acxQ" class="ds-in" type="search" placeholder="<%- t('ach.filter.search_ph') %>" autocomplete="off">
      <span class="n" id="acxN" aria-live="polite" data-tpl="<%- t('ach.filter.shown') %>"></span>
    </div>
  </div>

  <% sections.forEach((s) => { %>
  <section class="grp" data-group="<%= s.slug %>" aria-labelledby="g-<%= s.slug %>">
    <div class="gh"><h2 id="g-<%= s.slug %>" class="ds-pixel-h"><%- s.title %></h2><span class="line" aria-hidden="true"></span><span class="gp"><%= owned ? s.got + ' / ' + s.items.length : s.items.length %></span></div>
    <div class="grid">
      <% s.items.forEach(a => { const got = has(a); const tier = a.tier || 'common'; %>
        <article class="ach <%= tier %> <%= owned ? (got ? 'got' : 'locked') : '' %>" data-tier="<%= tier %>" data-state="<%= owned ? (got ? 'got' : 'locked') : '' %>">
          <% if (owned) { %><span class="st" title="<%- got ? t('ach.state.unlocked') : t('ach.state.locked') %>"><span aria-hidden="true"><%= got ? '✓' : '🔒' %></span><span class="sr"><%- got ? t('ach.state.unlocked') : t('ach.state.locked') %></span></span><% } %>
          <div class="frame"><img src="<%= a.icon %>" alt="" loading="lazy" width="68" height="68"></div>
          <div class="tier"><%- t('ach.tier.' + tier) %></div>
          <h3 class="nm"><%- nameOf(a) %></h3>
          <p class="ds"><%- descOf(a) %></p>
          <div class="rw"><% if (a.xp) { %><span class="chip xp">+<%= fmt(a.xp) %> XP</span><% } %><% if (a.pat) { %><span class="chip pat">+<%= fmt(a.pat) %> PAT</span><% } %></div>
          <div class="hd"><%- t('ach.holders', { count: holders[a.id] || 0, n: (holders[a.id] || 0).toLocaleString() }) %></div>
        </article>
      <% }) %>
    </div>
  </section>
  <% }) %>
  <p class="none ds-empty" id="acxNone" hidden><span><%- t('ach.filter.none') %></span> <button type="button" class="ds-btn ghost sm" id="acxReset"><%- t('ach.filter.reset') %></button></p>
</main>
<script>
(function () {
  var bar = document.getElementById('acxBar');
  if (!bar) return;
  bar.hidden = false;
  var cards = [].slice.call(document.querySelectorAll('.acx .ach'));
  var groups = [].slice.call(document.querySelectorAll('.acx .grp'));
  var q = document.getElementById('acxQ'), n = document.getElementById('acxN'), none = document.getElementById('acxNone');
  var hay = cards.map(function (c) { return c.textContent.toLowerCase(); });
  var f = { group: '', state: '', tier: '' };
  function press(sel, attr, val) {
    [].forEach.call(bar.querySelectorAll(sel), function (b) { b.setAttribute('aria-pressed', String(b.getAttribute(attr) === val)); });
  }
  function apply() {
    var words = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean), shown = 0;
    cards.forEach(function (c, i) {
      var g = c.closest('.grp').getAttribute('data-group');
      var ok = (!f.group || g === f.group) && (!f.state || c.getAttribute('data-state') === f.state) &&
               (!f.tier || c.getAttribute('data-tier') === f.tier) && words.every(function (w) { return hay[i].indexOf(w) >= 0; });
      c.hidden = !ok;
      if (ok) shown++;
    });
    groups.forEach(function (s) { s.hidden = !s.querySelector('.ach:not([hidden])'); });
    var any = f.group || f.state || f.tier || words.length;
    n.textContent = any ? n.getAttribute('data-tpl').replace('{n}', shown).replace('{total}', cards.length) : '';
    none.hidden = shown > 0;
  }
  bar.addEventListener('click', function (ev) {
    var b = ev.target.closest('button');
    if (!b) return;
    if (b.hasAttribute('data-group')) { f.group = b.getAttribute('data-group'); press('[data-group]', 'data-group', f.group); }
    else if (b.hasAttribute('data-state')) { f.state = b.getAttribute('data-state'); press('[data-state]', 'data-state', f.state); }
    else if (b.hasAttribute('data-tier')) { var v = b.getAttribute('data-tier'); f.tier = f.tier === v ? '' : v; press('[data-tier]', 'data-tier', f.tier); }
    apply();
  });
  var tm = null;
  q.addEventListener('input', function () { clearTimeout(tm); tm = setTimeout(apply, 60); });
  document.getElementById('acxReset').addEventListener('click', function () {
    f = { group: '', state: '', tier: '' }; q.value = '';
    press('[data-group]', 'data-group', ''); press('[data-state]', 'data-state', ''); press('[data-tier]', 'data-tier', '');
    apply();
  });
})();
</script>
</body>
</html>
