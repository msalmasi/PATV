<%- include('layout', { title: 'Shop', user: user}) %>
<link rel="stylesheet" href="/public/css/shop.css">
<div class="shop-container">
    <h1 class="shop-title">PAT Redemption Codes</h1>
    <form id="codeform" action="/api/redeem-code" method="post">
        <input type="text" id="code" name="code" placeholder="Enter your redemption code" required>
        <button class="code-btn" type="submit">Redeem</button>
    </form>
    <div id="codeStatus" class="spin-status"></div>
</div>
<div class="shop-container">
    <div id="shopStatus" class="spin-status"></div>
    <h1 class="shop-title">Arcade Shop</h1>
    
    <div class="product-list">
        <!-- Items will be dynamically inserted here -->
    </div>
</div>

<script>
    // Purchases are irreversible and cost real PAT, so the outcome has to be unmistakable:
    // colour-coded, and failures stay up longer than confirmations so they're actually read.
    let shopStatusTimer = null;
    function showShopStatus(message, ok) {
        const status = document.getElementById('shopStatus');
        if (!status) return;
        status.textContent = message;
        status.style.color = ok ? '#81C784' : '#e57373';
        status.style.fontWeight = '600';
        status.style.visibility = 'visible';
        clearTimeout(shopStatusTimer);
        shopStatusTimer = setTimeout(() => { status.style.visibility = 'hidden'; }, ok ? 6000 : 9000);
    }

    document.addEventListener('DOMContentLoaded', () => {
        const productList = document.querySelector('.product-list');
    
        // Fetch prizes from the API
        fetch('/api/prizes')
        .then(response => response.json())
        .then(prizes => {
            // Ensure prizes data is an array and not empty
            if (Array.isArray(prizes) && prizes.length) {
                prizes.forEach(prize => {
                    const li = document.createElement('div');
                    li.className = 'product-item';
                    li.innerHTML = `
                        <div class="buy-btn-div">
                        <h3>${prize.prize}</h3>
                        </div>
                        <div class="buy-btn-div">
                        <p>PAT ${prize.cost.toLocaleString()}</p>
                        </div>
                        <div class="buy-btn-div">
                        <p class="product-stock">${prize.quantity.toLocaleString()} Left</p>
                        </div>
                        <div class="buy-btn-div">
                        <button class="buy-btn" data-product="${prize.prizeId}">Buy</button>
                        </div>
                    `;
                    productList.appendChild(li);
                });
                addBuyButtonEventListeners();  // Call to add event listeners after elements are created
            } else {
                productList.innerHTML = '<li>No prizes available at the moment.</li>';
            }
        })
        .catch(error => {
            console.error('Failed to fetch prizes:', error);
            productList.innerHTML = '<li>Error loading prizes. Please try again later.</li>';
        });
    
        // Function to handle purchase buttons
        function addBuyButtonEventListeners() {
            document.querySelectorAll('.buy-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const product = this.getAttribute('data-product');
                    fetch(`/shop`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ product: product })
                    })
                    // The server explains WHY a purchase failed (not logged in, not enough PAT,
                    // out of stock). Read that message instead of throwing it away and showing a
                    // generic failure — "please log in again" is actionable, "Failed" isn't.
                    .then(response => response.json()
                        .catch(() => ({}))                      // non-JSON body (e.g. a crash page)
                        .then(data => ({ ok: response.ok, data })))
                    .then(({ ok, data }) => {
                        const succeeded = ok && data && data.success;
                        // The server already words each outcome (out of stock, how much short,
                        // session expired) — show that rather than a generic line.
                        showShopStatus(
                            (data && data.message) ||
                                (succeeded ? 'Purchase complete.' : 'Could not buy that item.'),
                            succeeded);
                        if (succeeded) {
                            button.disabled = true;             // no accidental double-buy
                            button.textContent = 'Purchased';
                            if (typeof data.remaining_stock === 'number') {
                                const item = button.closest('.product-item');
                                const stockEl = item && item.querySelector('.product-stock');
                                if (stockEl) {
                                    stockEl.textContent = data.remaining_stock > 0
                                        ? `${data.remaining_stock.toLocaleString()} Left`
                                        : 'Out of stock';
                                }
                            }
                        }
                    })
                    .catch(error => {
                        console.error('Error making the POST request:', error);
                        showShopStatus('Could not reach the server — try again.', false);
                    });
                });
            });
        }
    });
    </script>

<script>
    let codeStatusTimer = null;
    function showCodeStatus(message, ok) {
        const status = document.getElementById('codeStatus');
        if (!status) return;
        status.textContent = message;
        status.style.color = ok ? '#81C784' : '#e57373';
        status.style.fontWeight = '600';
        status.style.visibility = 'visible';
        clearTimeout(codeStatusTimer);
        codeStatusTimer = setTimeout(() => { status.style.visibility = 'hidden'; }, ok ? 6000 : 9000);
    }

    document.getElementById('codeform').addEventListener('submit', function(event) {
    event.preventDefault();
    var code = document.getElementById('code').value;


    fetch('/api/redeem-code', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({code: code})
    })
    // Same treatment as a purchase: show what the server actually said (bad code, already used,
    // expired) instead of one catch-all failure line.
    .then(response => response.json()
        .catch(() => ({}))
        .then(data => ({ ok: response.ok, data })))
    .then(({ ok, data }) => {
        const message = (data && data.message) || '';
        const succeeded = ok && /success/i.test(message);
        showCodeStatus(message || (succeeded ? 'Code redeemed.' : 'That code could not be redeemed.'),
                       succeeded);
        if (succeeded) document.getElementById('code').value = '';
    })
    .catch(error => {
        console.error('Error making the POST request:', error);
        showCodeStatus('Could not reach the server — try again.', false);
    });
});
</script>