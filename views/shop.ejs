<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: store && store.username ? t('shop.title_store', { name: store.username }) : t('shop.title'), user: user }) %>
<%- include('partials/shop-css') %>
<%- include('partials/shop-store-css') %>
<% if (store && store.nameCss) { %><%- include('partials/cosmetics-css') %><% } %>
<%
  // 1.99lz: the storefront redesign - hero + search, featured, shelf chips, cards with pictures and "can you afford it".
  const f = filters || {};
  const baseQ = { q: f.q, cat: f.cat, min: f.min, max: f.max, instock: f.instock, official: f.official, shelf: f.shelf, afford: f.afford, sort: sort !== 'newest' ? sort : '' };
  const path = store && store.username ? '/shop/seller/' + encodeURIComponent(store.username) : '/shop';
  if (!store) baseQ.seller = f.seller;
  const FEAT = locals.feat || [];
  const SC = locals.shelfCounts || {};
  const allN = Object.values(SC).reduce((a, b) => a + b, 0);
  const subOf = (it) => { const c = H.cat(it) || {}; const rk = H.roleKey ? H.roleKey(it) : null;
    return rk ? t('shop.role.' + rk + '.short') : (c.tkey && t.has('shop.cat.item.' + c.tkey)) ? t('shop.cat.item.' + c.tkey) : ''; };
%>
<div class="sh st">
<% if (store && store.missing) { %>
  <h1><%- t('shop.not_found') %></h1>
  <p class="sub"><%- t('shop.no_user', { name: '"' + t.esc(store.missing) + '"' }) %> <a href="/shop"><%- t('shop.back') %></a></p>
<% } else { %>
  <% if (store) { const SB = store.best || []; %>
    <%# 1.99mv: the storefront hero - the seller's photo, name style, level, showcase badges, stats, search %>
    <div class="links" style="margin:0 0 10px"><a href="/shop"><%- t('shop.all_items') %></a></div>
    <section class="st-hero st-store" aria-labelledby="storeH">
      <div class="st-sh">
        <span class="st-sav" style="--h:<%= Array.from(String(store.username)).reduce((h, ch) => (h * 31 + ch.codePointAt(0)) >>> 0, 0) % 360 %>" aria-hidden="true"><%= (Array.from(String(store.displayname || store.username).replace(/^[^\p{L}\p{N}]+/u, ''))[0] || '?').toUpperCase() %><% if (H.av(store.avatar) !== '/public/img/avatar.png') { %><img src="<%= H.av(store.avatar) %>" alt="" referrerpolicy="no-referrer" onerror="this.remove()"><% } %></span>
        <div style="min-width:0;display:grid;gap:6px">
          <p class="st-eyebrow"><%- t('shop.storefront.eyebrow') %></p>
          <h1 id="storeH"><%- t('shop.storefront.title', { name: '<span class="cx-name"' + (store.nameCss ? ' style="' + t.esc(store.nameCss) + '"' : '') + '>' + t.esc(store.displayname || store.username) + '</span>' }) %></h1>
          <div class="st-who">
            <span>@<%= store.username %></span>
            <% if (store.level) { %><span class="st-lvl"><%- t('shop.storefront.level', { n: H.fmt(store.level) }) %></span><% } %>
            <% if (store.since) { %><span><%- t('shop.storefront.since', { date: H.day(store.since).slice(0, 7) }) %></span><% } %>
            <a href="/u/<%= encodeURIComponent(store.username) %>"><%- t('shop.storefront.profile') %></a>
          </div>
          <% if (store.badges && store.badges.length) { %>
            <div class="st-pins" aria-label="<%- t('shop.storefront.badges') %>">
              <% store.badges.forEach((b) => { %><span class="pin" title="<%= b.description || '' %>"><img src="<%= b.icon %>" alt=""><%= b.name %></span><% }) %>
            </div>
          <% } %>
        </div>
      </div>
      <div class="st-wallet st-sstats">
        <div><span class="lbl"><%- t('shop.storefront.sales') %></span><b class="bal"><%= H.fmt(store.sales) %></b></div>
        <div><span class="lbl"><%- t('shop.storefront.items') %></span><b class="bal"><%= H.fmt(total) %></b></div>
        <% if (store.mine) { %><a class="btn gold" href="/shop/seller">🏪 <%- t('shop.storefront.manage') %></a><% } %>
      </div>
      <form class="st-search" method="GET" action="<%= path %>" role="search">
        <label class="vh" for="shopQ"><%- t('shop.search') %></label>
        <input id="shopQ" type="search" name="q" value="<%= f.q || '' %>" placeholder="<%- t('shop.search_store') %>" maxlength="80">
        <button type="submit" class="gold"><%- t('shop.search') %></button>
      </form>
    </section>
    <% if (SB.length) { %>
      <h2 id="bestH"><%- t(SB.some((x) => Number(x.sold) > 0) ? 'shop.storefront.best' : 'shop.storefront.picks') %></h2>
      <section class="st-sbest" aria-labelledby="bestH">
        <% SB.forEach((it, i) => { const im = H.img(it); %>
          <a class="st-mini<%= i === 0 ? ' top' : '' %>" href="/shop/item/<%= encodeURIComponent(it.prizeId) %>">
            <span class="st-img"><% if (im) { %><img src="<%= im %>" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()"><% } else { %><span class="ph">🛍️</span><% } %></span>
            <div><% if (i === 0 && Number(it.sold) > 0) { %><span class="st-tag"><%- t('shop.storefront.top') %></span><% } %><b><%= it.prize %></b><span class="st-price" style="font-size:15px"><%= H.fmt(it.cost) %> <small>PAT</small></span>
              <% if (Number(it.sold) > 0) { %><span class="st-meta"><%- t('shop.n_sold', { n: H.fmt(it.sold) }) %></span><% } %></div>
          </a>
        <% }) %>
      </section>
      <h2 id="allH"><%- t('shop.storefront.all') %></h2>
    <% } %>
  <% } else { %>
    <section class="st-hero" aria-labelledby="shopH">
      <div>
        <p class="st-eyebrow"><%- t('shop.hero.eyebrow') %></p>
        <h1 id="shopH"><%- t('shop.hero.title', { em: '<em>' + t('shop.hero.title_em') + '</em>' }) %></h1>
        <p class="st-lead"><%- t('shop.hero.lead') %></p>
      </div>
      <div class="st-wallet">
        <% if (me) { %>
          <span class="lbl"><%- t('shop.hero.your_balance') %></span>
          <span class="bal"><span id="shopBalance"><%= H.fmt(me.points_balance) %></span> <small>PAT</small></span>
          <nav aria-label="<%- t('shop.hero.your_links') %>">
            <a href="/shop/orders"><%- t('shop.my_orders') %></a>
            <a href="/subscriptions">🔁 <%- t('subs.title') %></a>
            <a href="/shop/seller"><%- t('shop.sell') %></a>
            <% if (me.staff) { %><a href="/shop/admin"><%- t('shop.admin') %></a><% } %>
          </nav>
        <% } else { %>
          <span class="lbl"><%- t('shop.hero.your_balance') %></span>
          <a class="btn gold" href="/login"><%- t('shop.signin_buy_sell') %></a>
          <span class="muted"><%- t('shop.hero.earn', { link: '<a href="/economy">' + t('shop.hero.earn_link') + '</a>' }) %></span>
        <% } %>
      </div>
      <form class="st-search" method="GET" action="/shop" role="search">
        <label class="vh" for="shopQ"><%- t('shop.search') %></label>
        <input id="shopQ" type="search" name="q" value="<%= f.q || '' %>" placeholder="<%- t('shop.search_ph') %>" maxlength="80">
        <% if (f.shelf) { %><input type="hidden" name="shelf" value="<%= f.shelf %>"><% } %>
        <button type="submit" class="gold"><%- t('shop.search') %></button>
      </form>
    </section>
  <% } %>

  <% if (msg) { %><p class="notice" role="status"><%= msg %></p><% } %>

  <% if (!store && FEAT.length) { const top = FEAT[0]; const rest = FEAT.slice(1, 4); const topImg = H.img(top); const topCan = me && Number(me.points_balance) >= Number(top.cost); %>
    <h2 id="featH"><%- t('shop.featured') %></h2>
    <section class="st-feat" aria-labelledby="featH">
      <article class="st-top">
        <a class="st-img" href="/shop/item/<%= encodeURIComponent(top.prizeId) %>" tabindex="-1" aria-hidden="true"><% if (topImg) { %><img src="<%= topImg %>" alt=""><% } %></a>
        <div class="st-tb">
          <span class="st-tag"><%- t('shop.featured_pick') %></span>
          <h3><a href="/shop/item/<%= encodeURIComponent(top.prizeId) %>"><%= top.prize %></a></h3>
          <% const ts = subOf(top); if (ts) { %><p class="desc"><%- ts %></p><% } %>
          <div class="st-price"><%= H.fmt(top.cost) %> <small>PAT</small></div>
          <% if (me) { %><div class="st-aff <%= topCan ? 'ok' : 'no' %>"><%- topCan ? '✓ ' + t('shop.afford.yes') : t('shop.afford.need', { n: H.fmt(Number(top.cost) - Number(me.points_balance || 0)) }) %></div><% } %>
          <div><a class="btn gold" href="/shop/item/<%= encodeURIComponent(top.prizeId) %>"><%- t('shop.see_it') %><span class="vh"> <%= top.prize %></span></a></div>
        </div>
      </article>
      <% if (rest.length) { %>
        <div class="st-side">
          <% rest.forEach((it) => { const im = H.img(it); %>
            <a class="st-mini" href="/shop/item/<%= encodeURIComponent(it.prizeId) %>">
              <span class="st-img"><% if (im) { %><img src="<%= im %>" alt="" loading="lazy"><% } %></span>
              <div><b><%= it.prize %></b><span class="st-price" style="font-size:15px"><%= H.fmt(it.cost) %> <small>PAT</small></span></div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </section>
  <% } %>

  <% if (!store) { %>
    <div class="st-chipwrap" id="stChipwrap">
    <button type="button" class="st-chip-arr l" data-dir="-1" aria-label="<%- t('shop.chips_prev') %>" tabindex="-1">‹</button>
    <nav class="st-chips" id="stChips" aria-label="<%- t('shop.chips_label') %>">
      <a href="/shop<%= H.qs({ q: f.q, sort: sort !== 'newest' ? sort : '' }, {}) %>" aria-current="<%= !f.shelf && !f.afford ? 'true' : 'false' %>"><%- t('shop.shelf.all') %> <span class="n"><%= allN %></span></a>
      <% H.shelves().forEach((s) => { if (!SC[s.id]) return; %>
        <a href="/shop<%= H.qs({ q: f.q, sort: sort !== 'newest' ? sort : '', afford: f.afford }, { shelf: s.id }) %>" aria-current="<%= f.shelf === s.id ? 'true' : 'false' %>"><span aria-hidden="true"><%= s.emoji %></span> <%- t('shop.shelf.' + s.id) %> <span class="n"><%= SC[s.id] %></span></a>
      <% }) %>
      <% if (me) { %>
        <a class="afford" href="/shop<%= H.qs({ q: f.q, shelf: f.shelf, sort: sort !== 'newest' ? sort : '' }, { afford: f.afford ? '' : '1' }) %>" aria-current="<%= f.afford ? 'true' : 'false' %>">✓ <%- t('shop.chip.afford') %></a>
      <% } %>
    </nav>
    <button type="button" class="st-chip-arr r" data-dir="1" aria-label="<%- t('shop.chips_next') %>" tabindex="-1">›</button>
    </div>
  <% } %>

  <% if (!store && H.wantsRequests && H.wantsRequests(f.q)) { %>
    <p class="notice"><%- t('shop.requests_hint', { link: '<a href="/plex#request">📼 ' + t('nav.plex') + '</a>' }) %></p>
  <% } %>

  <div class="st-tools">
    <div class="muted" role="status"><%- f.q ? t('shop.results_for', { q: f.q }) + ' · ' : '' %><%- t('shop.n_items', { count: total, n: H.fmt(total) }) %><%- pages > 1 ? ' · ' + t('shop.page_of', { page: page, pages: pages }) : '' %></div>
    <form method="GET" action="<%= path %>">
      <% Object.entries(baseQ).forEach(([k, v]) => { if (k !== 'sort' && v !== '' && v != null && v !== false) { %><input type="hidden" name="<%= k %>" value="<%= v === true ? '1' : v %>"><% } }) %>
      <label for="shopSort" class="muted" style="display:inline"><%- t('shop.sort') %></label>
      <select id="shopSort" name="sort" onchange="this.form.submit()">
        <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>><%- t('shop.sort_newest') %></option>
        <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>><%- t('shop.sort_price_asc') %></option>
        <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>><%- t('shop.sort_price_desc') %></option>
        <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>><%- t('shop.sort_popular') %></option>
      </select>
      <noscript><button type="submit" class="alt"><%- t('shop.apply') %></button></noscript>
    </form>
  </div>

  <% const active = f.cat || f.min || f.max || (!store && f.seller) || f.instock || f.official; %>
  <details class="st-more box" <%= active ? 'open' : '' %>>
    <summary><%- t('shop.filters') %><%- active ? ' ' + t('shop.filters_on') : '' %></summary>
    <form method="GET" action="<%= path %>" class="filters">
      <% if (f.q) { %><input type="hidden" name="q" value="<%= f.q %>"><% } %>
      <% if (f.shelf) { %><input type="hidden" name="shelf" value="<%= f.shelf %>"><% } %>
      <% if (f.afford) { %><input type="hidden" name="afford" value="1"><% } %>
      <% if (sort !== 'newest') { %><input type="hidden" name="sort" value="<%= sort %>"><% } %>
      <label><%- t('shop.category') %>
        <select name="cat">
          <option value=""><%- t('shop.all_categories') %></option>
          <% categories.forEach((c) => { %><option value="<%= c %>" <%= f.cat === c ? 'selected' : '' %>><%= c %><%= catCounts && catCounts[c] && !store ? ' (' + catCounts[c] + ')' : '' %></option><% }) %>
        </select>
      </label>
      <label><%- t('shop.min') %> <input type="number" name="min" min="0" value="<%= f.min %>" inputmode="numeric"></label>
      <label><%- t('shop.max') %> <input type="number" name="max" min="0" value="<%= f.max %>" inputmode="numeric"></label>
      <% if (!store) { %><label><%- t('shop.seller') %> <input type="text" name="seller" value="<%= f.seller || '' %>" maxlength="60" placeholder="<%- t('shop.seller_ph') %>"></label><% } %>
      <div style="display:grid;gap:6px;align-content:end">
        <label class="check"><input type="checkbox" name="instock" value="1" <%= f.instock ? 'checked' : '' %>> <%- t('shop.in_stock_only') %></label>
        <% if (!store) { %><label class="check"><input type="checkbox" name="official" value="1" <%= f.official ? 'checked' : '' %>> <%- t('shop.official_only') %></label><% } %>
      </div>
      <div class="row" style="align-self:end"><button type="submit"><%- t('shop.apply') %></button><a class="btn alt" href="<%= path %>"><%- t('shop.reset') %></a></div>
    </form>
  </details>

  <div id="shopStatus" class="status-msg" role="status" aria-live="polite"></div>
  <% if (!items.length) { %>
    <p class="muted" style="text-align:center;padding:24px 0"><%- t('shop.no_match', { link: '<a href="' + t.esc(path) + '">' + t('shop.clear_filters') + '</a>' }) %></p>
  <% } %>
  <div class="st-grid">
    <% items.forEach((it) => { %><%- include('partials/shop-card', { it, me, H, i18nT: t, quickBuy: true }) %><% }) %>
  </div>

  <% if (pages > 1) { %>
    <nav class="pager" aria-label="<%- t('shop.pages') %>">
      <% if (page > 1) { %><a href="<%= path + H.qs(baseQ, { page: page - 1 }) %>"><%- t('shop.prev') %></a><% } %>
      <% const lo = Math.max(1, page - 2), hi = Math.min(pages, page + 2);
         if (lo > 1) { %><a href="<%= path + H.qs(baseQ, { page: 1 }) %>">1</a><% if (lo > 2) { %><span>…</span><% } }
         for (let i = lo; i <= hi; i++) { if (i === page) { %><span class="cur" aria-current="page"><%= i %></span><% } else { %><a href="<%= path + H.qs(baseQ, { page: i }) %>"><%= i %></a><% } }
         if (hi < pages) { if (hi < pages - 1) { %><span>…</span><% } %><a href="<%= path + H.qs(baseQ, { page: pages }) %>"><%= pages %></a><% } %>
      <% if (page < pages) { %><a href="<%= path + H.qs(baseQ, { page: page + 1 }) %>"><%- t('shop.next') %></a><% } %>
    </nav>
  <% } %>

  <% if (!store) { %>
    <h2 id="anyH"><%- t('shop.anywhere.h') %></h2>
    <section class="st-any" aria-labelledby="anyH">
      <div><b>🐸 Camfrog</b><br><%- t('shop.anywhere.camfrog', { a: '<code>!prizes</code>', b: '<code>!redeem 3</code>' }) %></div>
      <div><b>💬 Discord</b><br><%- t('shop.anywhere.discord', { a: '<code>/shop</code>' }) %></div>
      <div><b>🌐 publicaccess.tv</b><br><%- t('shop.anywhere.same') %></div>
    </section>

    <% if (me) { %><%- include('partials/donate-card', { donate: locals.donate }) %><% } %>

    <h2><%- t('shop.codes.heading') %></h2>
    <form id="codeform" class="box row" action="/api/redeem-code" method="post">
      <label class="vh" for="code"><%- t('shop.codes.heading') %></label>
      <input type="text" id="code" name="code" placeholder="<%- t('shop.codes.placeholder') %>" required style="flex:1 1 200px">
      <button class="code-btn" type="submit"><%- t('shop.codes.redeem') %></button>
    </form>
    <div id="codeStatus" class="status-msg" role="status" aria-live="polite"></div>
    <p class="muted" style="margin-top:18px"><a href="/plex">📼 <%- t('nav.plex') %></a> · <a href="/premium"><%- t('shop.links.premium') %></a> · <a href="/lotto"><%- t('shop.links.lotto') %></a></p>
  <% } %>
<% } %>
</div>

<%- include('partials/shop-buy-js') %>
<script>
  // 1.99mv: the shelf chips row - fades + arrows only while it overflows, wheel scrolls it sideways, mouse drag scrolls it,
  // the current chip is scrolled into view. Touch keeps the native swipe.
  (function () {
    var wrap = document.getElementById('stChipwrap'), row = document.getElementById('stChips');
    if (!wrap || !row) return;
    function edges() {
      var max = row.scrollWidth - row.clientWidth;
      wrap.classList.toggle('fl', row.scrollLeft > 2);
      wrap.classList.toggle('fr', max > 2 && row.scrollLeft < max - 2);
    }
    var cur = row.querySelector('a[aria-current="true"]');
    if (cur && cur.offsetLeft + cur.offsetWidth > row.clientWidth) row.scrollLeft = cur.offsetLeft - 48;
    edges();
    row.addEventListener('scroll', edges, { passive: true });
    window.addEventListener('resize', edges);
    wrap.querySelectorAll('.st-chip-arr').forEach(function (b) {
      b.addEventListener('click', function () { row.scrollBy({ left: Number(b.dataset.dir) * Math.max(160, row.clientWidth * 0.7), behavior: 'smooth' }); });
    });
    row.addEventListener('wheel', function (e) {
      if (row.scrollWidth <= row.clientWidth || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
      var max = row.scrollWidth - row.clientWidth;
      if ((e.deltaY < 0 && row.scrollLeft <= 0) || (e.deltaY > 0 && row.scrollLeft >= max)) return;   // at an end: let the page scroll
      e.preventDefault();
      row.scrollLeft += e.deltaY;
    }, { passive: false });
    var down = null, moved = false;
    row.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = { x: e.clientX, left: row.scrollLeft }; moved = false;
    });
    window.addEventListener('pointermove', function (e) {
      if (!down) return;
      var dx = e.clientX - down.x;
      if (!moved && Math.abs(dx) < 6) return;
      moved = true; row.classList.add('drag');
      row.scrollLeft = down.left - dx;
    });
    window.addEventListener('pointerup', function () {
      if (!down) return;
      down = null;
      setTimeout(function () { row.classList.remove('drag'); }, 0);
    });
    row.addEventListener('click', function (e) { if (moved) { e.preventDefault(); moved = false; } }, true);
    row.addEventListener('dragstart', function (e) { e.preventDefault(); });
  })();
</script>
<script>
  // Redemption codes: show what the server actually said (bad code, already used, expired).
  (function () {
    var _t = typeof __t === 'function' ? __t : function (k, d, v) { return String(d).replace(/\{!?(\w+)\}/g, function (m, n) { return v && v[n] != null ? v[n] : m; }); };
    const form = document.getElementById('codeform');
    if (!form) return;
    let timer = null;
    function show(message, ok) {
      const el = document.getElementById('codeStatus');
      el.textContent = message; el.style.color = ok ? '#81C784' : '#e57373';
      clearTimeout(timer); timer = setTimeout(() => { el.textContent = ''; }, ok ? 6000 : 9000);
    }
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      fetch('/api/redeem-code', { method: 'POST', headers: { 'Content-Type': 'application/json' },
                                  body: JSON.stringify({ code: document.getElementById('code').value }) })
        .then((r) => r.json().catch(() => ({})).then((data) => ({ ok: r.ok, data })))
        .then(({ ok, data }) => {
          const message = (data && data.message) || '';
          const succeeded = ok && /success/i.test(message);
          show(message || (succeeded ? _t('js.shop.code_redeemed', 'Code redeemed.') : _t('js.shop.code_failed', 'That code could not be redeemed.')), succeeded);
          if (succeeded) document.getElementById('code').value = '';
        })
        .catch(() => show(_t('js.shop.no_server', 'Could not reach the server — try again.'), false));
    });
  })();
</script>
