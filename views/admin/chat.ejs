<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<%- include('../partials/admin-open', { title, user, section: 'chat', admIsAdmin: isAdmin }) %>
<%# views/admin/chat.ejs - S1 V1 (release L1; ADR 0007 D3, D15, OQ-19): the chat hub's break-glass form (adminchat.js,
    chatswitches.js). It never calls the chat hub: CHAT_HUB, the pads' chat backends, the interlock, the seam poster and the
    change log are all this site's own. Turning anything ON (CHAT_HUB, a pad to the hub) is a Pepe owner's, with a confirm step;
    turning it OFF is any admin's, one click. Every change takes the reason typed at the top (public/js/admin-chat.js posts one
    change at a time, same-origin fetch). Every value from the database is escaped by EJS. %>
<%
  const fmtFn = (locals.tzFmt || new Function(include('../../tz-core.js'))()('UTC', 'en').fmt);
  const when = (ms) => ms ? fmtFn(Number(ms), 'datetime') : '–';
  const num = (n) => Number(n || 0).toLocaleString('en-US');
  const hubOn = V.hub.value === 'on';
  const L = V.interlock || { state: {}, missing: [] };
  const P = V.poster;
  const padName = (p) => p.title || p.slug || p.room_id;
  const backend = (b) => t('admchat.backend.' + (['v1', 'hub_read', 'hub'].includes(b) ? b : 'v1'));
%>
<div class="adm-head">
  <h1><%- t('admchat.title') %></h1>
  <p><%- t('admchat.lede') %></p>
  <p class="adm-help" id="acYou"><%- t(V.owner ? 'admchat.you_owner' : 'admchat.you_admin') %></p>
  <p class="adm-help"><%- t('admchat.no_hub_call') %></p>
  <p class="adm-form"><label for="acReason"><%- t('admchat.reason') %>
    <input type="text" id="acReason" maxlength="200" autocomplete="off" spellcheck="true" placeholder="<%- t('admchat.reason_ph') %>"></label></p>
</div>

<section class="adm-card" id="hub" aria-labelledby="acHubT" data-hub="<%= hubOn ? 'on' : 'off' %>">
  <h2 id="acHubT"><%- t('admchat.hub.h') %> <span class="adm-pill <%= hubOn ? 'ok' : '' %>" id="acHubState"><%- t(hubOn ? 'admchat.hub.on' : 'admchat.hub.off') %></span></h2>
  <p class="adm-help"><%- t('admchat.hub.help') %></p>
  <p class="adm-help"><%- V.hub.updated_at ? t('admchat.hub.changed', { when: when(V.hub.updated_at) }) : t('admchat.hub.never') %></p>
  <div class="adm-actions">
    <% if (hubOn) { %>
      <button type="button" class="adm-btn" id="acHubOff" data-hub-on="0"><%- t('admchat.hub.btn_off') %></button>
    <% } else if (V.owner && !L.missing.length) { %>
      <button type="button" id="acHubOn" data-hub-on="1"><%- t('admchat.hub.btn_on') %></button>
    <% } else if (V.owner) { %>
      <button type="button" id="acHubOn" disabled><%- t('admchat.hub.btn_on') %></button>
      <span class="adm-help" id="acHubNeeds"><%- t('admchat.hub.needs', { list: L.missing.join(', ') }) %></span>
    <% } else { %>
      <span class="adm-help" id="acHubOwnerOnly"><%- t('admchat.hub.owner_only') %></span>
    <% } %>
    <span class="adm-msg" role="status"></span>
  </div>
</section>

<section class="adm-card" id="pads" aria-labelledby="acPadsT">
  <h2 id="acPadsT"><%- t('admchat.pads.h') %></h2>
  <p class="adm-help"><%- t('admchat.pads.help') %></p>
  <% if (!V.pads.length) { %>
    <p class="adm-help" id="acPadsNone"><%- t('admchat.pads.none') %></p>
  <% } else { %>
  <div class="adm-tbl"><table>
    <thead><tr><th><%- t('admchat.col.pad') %></th><th><%- t('admchat.col.platform') %></th><th><%- t('admchat.col.backend') %></th>
      <th><%- t('admchat.col.changed') %></th><th></th></tr></thead>
    <tbody>
      <% V.pads.forEach((p) => { %><tr data-pad="<%= p.room_id %>">
        <td><b><% if (p.slug) { %><a href="/p/<%= encodeURIComponent(p.slug) %>"><%= padName(p) %></a><% } else { %><%= padName(p) %><% } %></b><br><span class="adm-help"><code><%= p.room_id %></code></span></td>
        <td><%= p.platform %></td>
        <td><%= backend(p.backend) %></td>
        <td><%= when(p.updated) %><% if (p.updated_by) { %><br><span class="adm-help"><%= p.updated_by %></span><% } %></td>
        <td><button type="button" class="adm-btn ghost" data-pad-backend="v1" data-room="<%= p.room_id %>" data-name="<%= padName(p) %>"><%- t('admchat.pads.btn_v1') %></button>
          <span class="adm-msg" role="status"></span></td>
      </tr><% }) %>
    </tbody>
  </table></div>
  <% } %>
  <% if (V.owner) { %>
  <div class="adm-form" id="acMove">
    <label for="acMovePad"><%- t('admchat.pads.move_label') %>
      <select id="acMovePad">
        <option value=""><%- t('admchat.pads.pick') %></option>
        <% V.choices.forEach((p) => { %><option value="<%= p.room_id %>"><%= padName(p) %><% if (V.pilots.includes(p.room_id)) { %> · <%- t('admchat.pads.pilot') %><% } %> (<%= p.room_id %>)</option><% }) %>
      </select></label>
    <div class="adm-actions"><button type="button" id="acMoveBtn" data-pad-backend="hub"><%- t('admchat.pads.btn_hub') %></button><span class="adm-msg" role="status"></span></div>
    <p class="adm-help"><%- t('admchat.pads.site_only') %></p>
  </div>
  <% } else { %>
    <p class="adm-help" id="acMoveOwnerOnly"><%- t('admchat.pads.owner_only') %></p>
  <% } %>
</section>

<section class="adm-card" id="interlock" aria-labelledby="acLockT">
  <h2 id="acLockT"><%- t('admchat.lock.h') %> <span class="adm-pill <%= L.missing.length ? '' : 'ok' %>"><%- t(L.missing.length ? 'admchat.lock.not_ready' : 'admchat.lock.ready') %></span></h2>
  <p class="adm-help"><%- t('admchat.lock.help') %></p>
  <div class="adm-kv">
    <% Object.keys(L.state).forEach((k) => { %><div data-seam="<%= k %>"><b><code><%= k %></code></b><span><span class="adm-dot <%= L.state[k] ? 'ok' : 'bad' %>"></span> <%- t(L.state[k] ? 'admchat.lock.on' : 'admchat.lock.off') %> · <%- t('admchat.sw.' + k) %></span></div><% }) %>
  </div>
  <p class="adm-help"><a href="/admin/keys#seam"><%- t('admchat.lock.link') %></a></p>
</section>

<section class="adm-card" id="seam" aria-labelledby="acSeamT">
  <h2 id="acSeamT"><%- t('admchat.seam.h') %></h2>
  <p class="adm-help"><%- t('admchat.seam.help') %></p>
  <% if (!P) { %>
    <p class="adm-help"><span class="adm-pill bad"><%- t('admchat.seam.unknown') %></span></p>
  <% } else { %>
  <div class="adm-kv">
    <div><b><%- t('admchat.seam.hub') %></b><span><span class="adm-dot <%= P.configured && !P.refusal ? 'ok' : '' %>"></span> <%- P.configured ? (P.refusal ? t('admchat.seam.refused', { code: P.refusal }) : t('admchat.seam.configured', { env: P.env || '?' })) : t('admchat.seam.unconfigured') %></span></div>
    <div><b><%- t('admchat.seam.queue') %></b><span><%- t('admchat.seam.queue_state', { pending: num(P.pending), oldest: when(P.oldest_pending) }) %><% P.failing.forEach((tp) => { %> · <span class="adm-pill bad"><code><%= tp %></code></span><% }) %></span></div>
    <% ['switches/changed', 'pads/changed'].forEach((tp) => { const s = P.topics[tp]; %>
    <div><b><code><%= tp %></code></b><span><%- s ? t('admchat.seam.queue_state', { pending: num(s.pending), oldest: when(s.oldest_pending_at) }) : t('admchat.seam.topic_off') %></span></div>
    <% }) %>
    <div><b><%- t('admchat.seam.last_post') %></b><span><% if (P.last_post) { %><span class="adm-dot <%= P.last_post.ok ? 'ok' : 'bad' %>"></span> <%= when(P.last_post.at) %> <code><%= P.last_post.topic || '' %></code> <%= P.last_post.ok ? '' : (P.last_post.status || P.last_post.error || '') %><% } else { %><%- t('admchat.seam.never') %><% } %></span></div>
    <div><b><%- t('admchat.seam.heartbeat') %></b><span><% if (P.heartbeat) { %><span class="adm-dot <%= P.heartbeat.ok ? 'ok' : 'bad' %>"></span> <%= when(P.heartbeat.at) %> <%= P.heartbeat.ok ? '' : (P.heartbeat.status || P.heartbeat.error || '') %><% } else { %><%- t('admchat.seam.never') %><% } %></span></div>
  </div>
  <% } %>
  <p class="adm-help"><a href="/admin/keys#seam"><%- t('admchat.seam.link') %></a></p>
</section>

<section class="adm-card" id="log" aria-labelledby="acLogT">
  <h2 id="acLogT"><%- t('admchat.log.h') %></h2>
  <% if (!V.log.length) { %>
    <p class="adm-help"><%- t('admchat.log.none') %></p>
  <% } else { %>
  <div class="adm-tbl"><table>
    <thead><tr><th><%- t('admchat.col.when') %></th><th><%- t('admchat.col.who') %></th><th><%- t('admchat.col.what') %></th><th><%- t('admchat.col.reason') %></th></tr></thead>
    <tbody>
      <% V.log.forEach((r) => { const d = r.detail || {}; %><tr data-log="<%= r.action %>">
        <td><%= when(r.at) %></td>
        <td><%= r.admin || '–' %></td>
        <td><% if (r.action === 'chat.switch') { %><%- t('admchat.log.switch', { key: d.key || '?', from: d.from || '?', to: d.to || '?' }) %><% } else { %><%- t('admchat.log.pad', { pad: d.slug || d.room_id || '?', from: d.from || '?', to: d.to || '?' }) %><% } %></td>
        <td><%= r.reason || '' %></td>
      </tr><% }) %>
    </tbody>
  </table></div>
  <% } %>
</section>
<script src="/public/js/admin-chat.js?v=1" defer></script>
<%- include('../partials/admin-close') %>
</body>
</html>
