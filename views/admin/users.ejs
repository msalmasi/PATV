<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<%- include('../partials/admin-open', { title, user, section: 'users', admIsAdmin: isAdmin }) %>
<% const _can = locals.can || new Function(include('../../siteperms-core.js'))().viewCan(locals); -%>
<div class="adm-head">
  <h1>Users &amp; Accounts</h1>
  <p><% if (_can('accounts.members')) { %><a href="#members">👥 Every account</a> (newest first), r<% } else { %>R<% } %>oles and classes, XP, the welcome bonus and the stale-account cleanup<% if (_can('auth.invites')) { %>, <a href="#invites">🎟️ sign-ups &amp; invites</a><% } %><% if (_can('auth.guest_access')) { %>, <a href="#guests">🚪 what signed-out visitors can open</a><% } %>. Each card saves on its own. A member's sessions and account deletion: <a href="/admin/accounts">🔐 Account security</a>.</p>
</div>
<% if (errors && errors.length) { %><div class="adm-flash err" role="alert"><%= errors %></div><% } %>

<% if (_can('accounts.members')) { %>
<%# 1.99anv: 👥 every account, paged on the server (members.js; GET /api/admin/members, public/js/admin-members.js). No emails / IPs. %>
<section class="adm-card mm" id="members" aria-labelledby="membersT">
  <h2 id="membersT"><span class="ds-ic" aria-hidden="true">👥</span> All members <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">Every account, newest first - 50 a page. Click a column heading to sort by it (click again for the other way round); search finds a username, display name or Camfrog login. <b>Chat-only</b> accounts were made for chat - by Pepe for a Camfrog login, or by the Twitch / Discord bots - and nobody has signed in to them on the website yet. <b>Last seen</b> is the website (a sign-in session, or a signed-in visit); Camfrog activity isn't in it. <%- t('admmembers.country_help') %> No email addresses, IPs or devices are shown here<% if (_can('accounts.security')) { %> - a name opens its <a href="/admin/accounts">🔐 Account security</a> page<% } %>.</p>
  <p class="adm-help" id="mmCounts" style="color:var(--ds-text)">Loading…</p>
  <div class="mm-bar">
    <div class="mm-chips" role="group" aria-label="Show">
      <button type="button" class="mm-chip" data-mm-filter="all" aria-pressed="true">All <span class="mm-n"></span></button>
      <button type="button" class="mm-chip" data-mm-filter="website" aria-pressed="false">Website members <span class="mm-n"></span></button>
      <button type="button" class="mm-chip" data-mm-filter="chat" aria-pressed="false">Chat-only accounts <span class="mm-n"></span></button>
      <button type="button" class="mm-chip" data-mm-filter="banned" aria-pressed="false">Banned <span class="mm-n"></span></button>
      <button type="button" class="mm-chip" data-mm-filter="deleted" aria-pressed="false">Deleted <span class="mm-n"></span></button>
    </div>
    <div class="mm-find">
      <%# 1.99anx: 🏳️ the country they last signed in from (members.js "country"); the two options here, each country from the answer %>
      <label for="mmCountry" class="mm-sr"><%= t('admmembers.country_label') %></label>
      <select id="mmCountry"><option value=""><%= t('admmembers.any_country') %></option><option value="none"><%= t('admmembers.no_country') %></option></select>
      <form id="mmForm" class="mm-search" role="search" autocomplete="off">
        <label for="mmQ" class="mm-sr">Search members</label>
        <input type="search" id="mmQ" maxlength="64" placeholder="Username, display name or Camfrog login">
      </form>
    </div>
  </div>
  <%# data-filtered: admin-shell.js's "Filter rows…" box would filter only this page's 50 rows - the search above asks the server %>
  <div class="adm-tbl mm-tbl"><table aria-label="All members" data-filtered="1">
    <thead><tr>
      <th scope="col" data-mm-sort="username" aria-sort="none"><button type="button">Username <span class="mm-ar" aria-hidden="true"></span></button></th>
      <th scope="col">Display name</th>
      <th scope="col" data-mm-sort="created" aria-sort="descending"><button type="button">Created <span class="mm-ar" aria-hidden="true">▼</span></button></th>
      <th scope="col" data-mm-sort="seen" aria-sort="none"><button type="button">Last seen <span class="mm-ar" aria-hidden="true"></span></button></th>
      <th scope="col" class="num" data-mm-sort="level" aria-sort="none"><button type="button">Level <span class="mm-ar" aria-hidden="true"></span></button></th>
      <th scope="col">Signs in with</th>
      <th scope="col">Invited by</th>
      <th scope="col">Status</th>
    </tr></thead>
    <tbody id="mmRows"><tr><td colspan="8" class="empty">Loading…</td></tr></tbody>
  </table></div>
  <div class="adm-actions mm-pager">
    <button type="button" class="adm-btn ghost" id="mmPrev" disabled>‹ Previous page</button>
    <span id="mmPage" class="adm-msg" role="status"></span>
    <button type="button" class="adm-btn ghost" id="mmNext" disabled>Next page ›</button>
    <span id="mmMsg" class="adm-msg" role="status" aria-live="polite"></span>
  </div>
</section>
<style>
  .mm .mm-bar { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; justify-content: space-between; margin-top: 6px; }
  .mm .mm-chips { display: flex; flex-wrap: wrap; gap: 6px; min-width: 0; }
  .mm .mm-chip { min-height: 36px; padding: 0 12px; border: 1px solid var(--ds-line-strong, #333); border-radius: 999px; background: var(--ds-sunken, #111); color: var(--ds-text-2, #cfcfcf); font: 600 13px/1 var(--ds-font, sans-serif); cursor: pointer; width: auto; margin: 0; }
  .mm .mm-chip[aria-pressed="true"] { border-color: var(--ds-green, #4caf50); color: #fff; background: var(--ds-hover, #1b2a1d); }
  .mm .mm-chip .mm-n { color: var(--ds-text-muted, #9a9a9a); font-weight: 400; }
  .mm .mm-find { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: flex-end; flex: 1 1 300px; min-width: 0; max-width: 100%; }
  .mm .mm-search { flex: 1 1 220px; max-width: 360px; min-width: 0; margin: 0; }
  /* 1.99anx: 🏳️ flags - Windows has no flag emoji, so the regional-indicator pairs are drawn by the self-hosted "Twemoji Country
     Flags" font (as on the profile, views/profile.ejs; country-flag-emoji-polyfill, MIT; Twemoji art CC-BY 4.0 -
     public/fonts/twemoji-flags), for the flag code points only. #mmCountry: an id to beat the admin shell's control font */
  @font-face { font-family: "Twemoji Country Flags"; src: url("/public/fonts/twemoji-flags/TwemojiCountryFlags.woff2") format("woff2");
               unicode-range: U+1F1E6-1F1FF, U+1F3F4, U+E0062-E0063, U+E0065, U+E0067, U+E006C, U+E006E, U+E0073-E0074, U+E0077, U+E007F; font-display: swap; }
  .mm .mm-flag { font-family: "Twemoji Country Flags", "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif; margin-inline-start: 6px; cursor: default; font-weight: 400; }
  .mm #mmCountry { flex: 0 1 auto; width: auto; max-width: 100%; min-width: 0; min-height: 36px; padding-top: 6px; padding-bottom: 6px; font-size: 16px;
                   font-family: "Twemoji Country Flags", var(--ds-font, sans-serif); }
  @media (max-width: 560px) { .mm .mm-find { justify-content: flex-start; } .mm #mmCountry { flex: 1 1 100%; } .mm .mm-search { max-width: none; } }
  .mm .mm-search input { width: 100%; box-sizing: border-box; min-height: 36px; font-size: 16px; }
  .mm .mm-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
  .mm .mm-tbl th button { all: unset; cursor: pointer; display: inline-flex; gap: 4px; align-items: center; min-height: 32px; font: inherit; color: inherit; }
  .mm .mm-tbl th button:focus-visible { outline: 2px solid var(--ds-focus, #ffd54f); outline-offset: 2px; border-radius: 4px; }
  .mm .mm-tbl td.mm-when { white-space: nowrap; }
  .mm .mm-tbl td.mm-when small { display: block; }
  .mm .mm-mut { color: var(--ds-text-muted, #9a9a9a); font-size: 12px; }
  .mm .mm-user { white-space: nowrap; }
  .mm .mm-user .mm-prof { margin-inline-start: 6px; text-decoration: none; }
  .mm .mm-dn { max-width: 16em; overflow-wrap: anywhere; }
  .mm .mm-methods { white-space: nowrap; }
  .mm .mm-ic { display: inline-flex; align-items: center; justify-content: center; min-width: 22px; height: 22px; padding: 0 3px; margin-inline-end: 3px; border: 1px solid var(--ds-line, #262626); border-radius: 6px; font: 700 11px/1 var(--ds-font, sans-serif); box-sizing: border-box; }
  .mm .mm-st { white-space: normal; }
  .mm .mm-st .adm-pill { margin: 1px 3px 1px 0; }
  .mm tr.mm-gone td { opacity: .65; }
  .mm .mm-pager { flex-wrap: wrap; }
</style>
<script src="/public/js/admin-members.js?v=2" defer></script>
<% } %>

<div class="adm-cols">
  <section class="adm-card" id="roles" aria-labelledby="rolesT">
    <h2 id="rolesT">Assign a class</h2>
    <p class="adm-help">Sets an account's class (role). <b>Admin</b> and <b>Staff</b> open the admin area; only Admins see Pepe, the Reserve, loans, DM reports and the stale cleanup. <b>Admin</b>, <b>Staff</b> and <b>Assistant</b> are Pepe's roles too (owner / admin = Admin): they need a linked Camfrog name, follow Pepe's rules (only Pepe's owners make admins) and stay in step with <code>!role</code> in chat. Only Admins change classes.</p>
    <form id="classEditForm" class="adm-form" action="/api/u/username/class/update" method="POST">
      <label for="userClassUsername">Username<input type="text" id="userClassUsername" name="username" required autocomplete="off"></label>
      <label for="userClass">Class<select name="class" id="userClass" required><option value="">Select a class…</option></select></label>
      <div class="adm-actions"><button type="submit">Set class</button><span id="classEditStatus" class="adm-msg" role="status"></span></div>
    </form>
  </section>

  <section class="adm-card" id="classes" aria-labelledby="classesT">
    <h2 id="classesT">Manage classes</h2>
    <p class="adm-help">The list of classes the picker offers.</p>
    <ul class="adm-tags" id="classList" aria-label="Current classes"></ul>
    <details class="adm-adv">
      <summary>Add or remove a class</summary>
      <div class="adm-adv-body">
        <form id="classListForm" class="adm-form" action="/api/classes/edit" method="POST">
          <label for="classAction">Action<select name="action" id="classAction" required><option value="add">Add</option><option value="remove">Remove</option></select></label>
          <label for="className">Class name<input type="text" id="className" name="className" required></label>
          <div class="adm-actions"><button type="submit">Save</button><span id="classListStatus" class="adm-msg" role="status"></span></div>
        </form>
      </div>
    </details>
  </section>

  <section class="adm-card" id="xp" aria-labelledby="xpT">
    <h2 id="xpT">XP and level <span class="adm-pill admin">admins</span></h2>
    <p class="adm-help">Add (or take away) XP, or set a level. You see the change before it's applied. Admin adjustments pay <b>no</b> level-up PAT rewards; level-unlock cosmetics and achievements follow the new level. Every change is written to the admin log.</p>
    <form id="xpTransferForm" class="adm-form" action="/api/admin/update-level" method="POST">
      <label for="xpUsername">Username<input type="text" id="xpUsername" name="username" required autocomplete="off" maxlength="64"></label>
      <label for="xpMode">Change<select id="xpMode" name="mode"><option value="add">Add XP</option><option value="set_level">Set level</option></select></label>
      <label for="xpAmount" id="xpAmountLbl">XP (negative takes away)<input type="number" id="xpAmount" name="amount" required step="1" inputmode="numeric"></label>
      <label for="xpReason">Reason (optional, for the log)<input type="text" id="xpReason" name="reason" maxlength="200" autocomplete="off"></label>
      <div class="adm-actions"><button type="submit">Review change…</button><span id="xpStatus" class="adm-msg" role="status"></span></div>
    </form>
    <details class="adm-adv">
      <summary>Recent adjustments</summary>
      <div class="adm-adv-body"><ul class="adm-help" id="xpRecent" style="margin:0;padding-left:18px"></ul></div>
    </details>
  </section>

  <section class="adm-card" id="donlimit" aria-labelledby="donlimitT">
    <h2 id="donlimitT"><span class="ds-ic" aria-hidden="true">💖</span> Donation limit (one member) <span class="adm-pill admin">admins</span></h2>
    <p class="adm-help">Raise or lower the daily donation limit for one member (dollars per day, card and crypto together; the day is midnight to midnight New York time). Empty = the default from <a href="/admin/economy#donations">Economy → Donations</a>; 0 = no limit for this member. Every change is written to the admin log.</p>
    <form id="dlUserForm" class="adm-form" autocomplete="off">
      <label for="dlUser">Username<input type="text" id="dlUser" required maxlength="64"></label>
      <label for="dlUsd">Limit ($ per day; empty = default, 0 = none)<input type="number" id="dlUsd" min="0" step="1" inputmode="numeric"></label>
      <label for="dlNote">Note (optional, for the log)<input type="text" id="dlNote" maxlength="200"></label>
      <div class="adm-actions"><button type="button" id="dlLook" class="adm-btn ghost">Look up</button><button type="submit">Save</button><span id="dlMsg" class="adm-msg" role="status"></span></div>
    </form>
    <script src="/public/js/admin-donlimit.js?v=1" defer></script>
  </section>

  <%# 1.99zf: one account's web bridge restrictions in EVERY room (bridgeblocks.js, global rows per feature; admin_audit bridge_block) %>
  <% if (_can('bridge.blocks_global')) { %>
  <section class="adm-card" id="bridgebans" aria-labelledby="bridgebansT">
    <h2 id="bridgebansT"><span class="ds-ic" aria-hidden="true">🌐</span> Web bridge restrictions (one member) <span class="adm-pill admin">admins</span></h2>
    <p class="adm-help">Stop one account using parts of the web bridge in <b>every</b> room: tick what they can't use, pick how long and why, Save. Untick to lift. Enforced by the site on every bridge write path (and by Pepe's mirror); the member sees the reason when something is refused. Every change is in the admin audit (<code>bridge_block</code>). Rooms' own blocks (by their owner / mods) are listed under it; all blocks: <a href="/admin/bridge#blocks">Bridge › Web relay blocks</a>.</p>
    <form id="bbUserForm" class="adm-form" autocomplete="off">
      <label for="bbUser">Who (username, chat name or u:&lt;id&gt;)<input type="text" id="bbUser" required maxlength="70"></label>
      <div class="adm-actions"><button type="button" id="bbLook" class="adm-btn ghost">Look up</button></div>
      <fieldset id="bbFeats" hidden style="border:0;padding:0;margin:0">
        <legend class="adm-help">Blocked in every room from…</legend>
        <div id="bbFeatList"></div>
        <label for="bbHours">For<select id="bbHours"><option value="1">1 hour</option><option value="24" selected>24 hours</option><option value="168">7 days</option><option value="720">30 days</option><option value="0">until lifted</option></select></label>
        <label for="bbReason">Reason (shown to them; for the log)<input type="text" id="bbReason" maxlength="120"></label>
        <div class="adm-actions"><button type="submit">Save</button></div>
      </fieldset>
      <span id="bbMsg" class="adm-msg" role="status"></span>
      <ul class="adm-help" id="bbRooms" style="margin:0;padding-left:18px"></ul>
    </form>
    <script src="/public/js/admin-bridgebans.js?v=1" defer></script>
  </section>
  <% } %>

  <%# 1.99ajn padppl: the Camfrog-name tag (cfnames.js; 1.99ajw padppl rework: no longer a sign-up / rename guard) - accounts whose username / display name is (or looks like) a Camfrog login they
      aren't linked to. Review fixes: logins and names in a monospace face (tricon vs trlcon), each entry one tidy row %>
  <% if (_can('accounts.name_clash')) { %>
  <section class="adm-card sfty" id="nameclash" aria-labelledby="nameclashT">
    <h2 id="nameclashT"><span class="ds-ic sfty-ic" aria-hidden="true">👥</span> Named like a Camfrog user <span class="adm-pill admin">admins</span> <span class="adm-pill" id="ncCount" aria-label="accounts listed">?</span></h2>
    <p class="adm-help">PATV accounts whose username or display name is - or only looks like - a Camfrog login Pepe has seen, but which aren't linked to that login (someone may be posing as them - the "tricon" case). Nobody is refused such a name (it may be their own Camfrog name - they get a hint to link it). On the pads the name shows as it is - no tag (owner, 2026-11-05: it only confused people); the 🌐 web mark and the Camfrog login tooltip tell people apart. <b>Rename</b> tells them why; <b>Mark OK</b> when it's the same person who hasn't linked yet. Every change is in the admin audit (<code>name_clash</code>).</p>
    <div class="adm-actions"><button type="button" id="ncLoad" class="adm-btn ghost">Load the list</button></div>
    <ul id="ncList" class="sfty-list"></ul>
  </section>
  <% } %>

  <%# 1.99ajn padppl: network bans (netban.js) - dark until switched on; keyed codes only, every look logged. Review fixes: one list row per
      account ban, a way to let ONE account through (never only lifting the ban), "which bans hit this account", the look by POST (the
      reason never sits in a URL), the forms apart, labels as written (no capitals on u:&lt;id&gt;) %>
  <% if (_can('safety.net_bans')) { %>
  <section class="adm-card sfty" id="netbans" aria-labelledby="netbansT">
    <h2 id="netbansT"><span class="ds-ic sfty-ic" aria-hidden="true">⛔</span> Network bans <span class="adm-pill admin">admins</span></h2>
    <p class="adm-help">Stops sign-ups, sign-ins and posting from a network (the harasser's next account). The site keeps a one-way keyed code of each member's network - never the address - for 90 days after its last use, only while this is on. A ban never tells anyone an address. Staff pass every network ban; a member caught by one (a shared household, campus or mobile network) can be let through below without lifting it. Every ban, lift and look is logged (<code>net_ban</code>, the view log).</p>
    <label class="ck"><input type="checkbox" id="nbOn"> Network bans on (recording starts)</label>
    <div id="nbForms" hidden>
      <h3 class="sfty-h">Ban</h3>
      <form id="nbForm" class="adm-form sfty-form" autocomplete="off">
        <label for="nbKind"><span>What</span><select id="nbKind"><option value="account">An account's networks (last 30 days)</option><option value="ip">One IP (stored only as its code)</option><option value="range">An IP range (IPv4 /8-/31, IPv6 /32-/63)</option></select></label>
        <label for="nbValue"><span>Who or what - <code>u:&lt;id&gt;</code>, <code>@name</code>, <code>cf:&lt;login&gt;</code>, an IP or a range</span><input type="text" id="nbValue" maxlength="80" required class="sfty-mono"></label>
        <label for="nbDays"><span>For</span><select id="nbDays"><option value="1">1 day</option><option value="7" selected>7 days</option><option value="30">30 days</option><option value="0">permanent</option></select></label>
        <label for="nbReason"><span>Reason (for the log)</span><input type="text" id="nbReason" maxlength="120"></label>
        <div class="adm-actions"><button type="submit">Ban</button></div>
      </form>
      <h3 class="sfty-h">Look up an account</h3>
      <form id="nsForm" class="adm-form sfty-form" autocomplete="off">
        <label for="nsWho"><span>Account - <code>u:&lt;id&gt;</code>, <code>@name</code>, <code>cf:&lt;login&gt;</code></span><input type="text" id="nsWho" maxlength="70" required class="sfty-mono"></label>
        <label for="nsWhy"><span>Why you're looking (logged)</span><input type="text" id="nsWhy" maxlength="120" required></label>
        <div class="adm-actions"><button type="submit" class="adm-btn ghost" data-op="shared">Who shares its networks</button><button type="button" class="adm-btn ghost" id="nsHit">Which bans hit it</button></div>
        <ul id="nsOut" class="sfty-list"></ul>
      </form>
    </div>
    <span id="nbMsg" class="adm-msg" role="status"></span>
    <h3 class="sfty-h">Active bans</h3>
    <ul id="nbList" class="sfty-list"></ul>
  </section>
  <% } %>
  <% if (_can('accounts.name_clash') || _can('safety.net_bans')) { %><style>
    .sfty .sfty-ic { white-space: nowrap; display: inline-block; }
    .sfty .sfty-h { margin: 14px 0 6px; font-size: 14px; color: var(--ds-text-2, #cfcfcf); }
    .sfty .sfty-form { display: grid; gap: 8px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); align-items: end; }
    .sfty .sfty-form label { display: grid; gap: 4px; text-transform: none; letter-spacing: 0; font-size: 12.5px; color: var(--ds-text-muted, #9a9a9a); min-width: 0; }
    .sfty .sfty-form label code { text-transform: none; }
    .sfty .sfty-form select, .sfty .sfty-form input { width: 100%; min-width: 0; box-sizing: border-box; }
    .sfty .sfty-form .adm-actions { grid-column: 1 / -1; }
    .sfty .sfty-mono, .sfty .mono { font-family: var(--ds-font-mono, ui-monospace, monospace); }
    .sfty .sfty-list { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 6px; }
    .sfty .sfty-list > li.sfty-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 10px; border: 1px solid var(--ds-line, #262626); border-radius: 10px; min-width: 0; flex-wrap: wrap; }
    .sfty .sfty-list .sfty-who { min-width: 0; overflow-wrap: anywhere; flex: 1 1 260px; }
    .sfty .sfty-list .sfty-who small { display: block; color: var(--ds-text-muted, #9a9a9a); font-size: 12px; }
    .sfty .sfty-list .sfty-btns { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .sfty .sfty-list .sfty-btns input { width: 11em; max-width: 100%; }
  </style><script src="/public/js/admin-safety.js?v=2" defer></script><% } %>

  <section class="adm-card" id="merges" aria-labelledby="mergesT">
    <h2 id="mergesT">Account merges</h2>
    <p class="adm-help">Merges happen on their own: linking a Camfrog name (<code>!verify</code>) folds Pepe's auto-made account into the real one, and a Twitch/Discord sign-in that belongs to another account offers the member a merge. Duplicate and alt merges by hand are a server script (dry run first), not a button here.</p>
  </section>
</div>

<section class="adm-card" id="welcome-admin" aria-labelledby="welcomeT">
  <h2 id="welcomeT">Welcome bonus <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">New accounts start at 0. The bonus vests after real play (level, active days, account age) and is paid once per person from the Federal Reserve. An account that matches one that already got it (Camfrog identity, Discord, Twitch, email, browser, or too many from one network) is marked duplicate - you can still pay it. Connect bonuses: once per Discord/Twitch id, held until the welcome vests.</p>
  <p id="welcome-stats" class="adm-help" style="color:var(--ds-text)">Loading…</p>
  <form id="welcome-config" class="adm-form">
    <label>On<select name="enabled"><option value="1">yes</option><option value="0">no (pending ones wait)</option></select></label>
    <label>Amount (PAT)<input type="number" name="amount" min="0" step="1000"></label>
    <label>Connect bonus (PAT)<input type="number" name="connect_amount" min="0" step="1000"></label>
    <details class="adm-adv" style="grid-column:1/-1">
      <summary>Advanced: vesting and duplicate limits</summary>
      <div class="adm-adv-body adm-form">
        <label>Min level<input type="number" name="min_level" min="0"></label>
        <label>Active days<input type="number" name="min_days" min="0"></label>
        <label>Min account age (h)<input type="number" name="min_age_hours" min="0"></label>
        <label>Per network<input type="number" name="ip_max" min="0"></label>
        <label>…per days<input type="number" name="ip_window_days" min="1"></label>
        <label>Expire after (days)<input type="number" name="expire_days" min="1"></label>
      </div>
    </details>
    <div class="adm-actions"><button type="submit">Save welcome bonus</button><span id="welcomeMsg" class="adm-msg" role="status"></span></div>
  </form>
  <h3>Latest decisions</h3>
  <div class="adm-tbl"><table aria-label="Welcome bonus decisions" data-filter>
    <thead><tr><th>Account</th><th>State</th><th>Why</th><th>When (UTC)</th><th></th></tr></thead>
    <tbody id="welcome-recent"></tbody>
  </table></div>
</section>

<section class="adm-card" id="stale-admin" aria-labelledby="staleT">
  <h2 id="staleT">Stale-account cleanup <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">Accounts nobody has used (auto Camfrog accounts with no activity, junk web sign-ups, ownerless ghosts, Twitch/Discord-bot accounts without real activity and 100k+ PAT) are warned first, then archived: their PAT goes back to the Federal Reserve and signing in brings it back. Any activity in the warning window (sign-in, a site visit, Camfrog, Twitch, Discord, linking) clears the warning. Empty tier-A accounts are deleted after the purge date. Run by <code>migrate-stale-accounts.js</code> on the server (dry run by default).</p>
  <p id="stale-dates" style="font-size:14px;margin:0">Loading…</p>
  <div class="adm-tbl"><table aria-label="Stale accounts by tier">
    <thead><tr><th>Tier</th><th class="num">Pending</th><th class="num">Cleared</th><th class="num">Archived</th></tr></thead>
    <tbody id="stale-counts"></tbody>
  </table></div>
  <p id="stale-vias" class="adm-help" style="margin-top:8px"></p>
</section>
<% if (_can('auth.signin_methods')) { %>
<section class="adm-card" id="signin" aria-labelledby="signinT">
  <h2 id="signinT">Sign-in methods <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">The single-sign-on buttons on <code>/login</code> and <code>/register</code>. A method shows only when it's switched on <b>and</b> its keys are in the server's <code>.env</code> (see <code>.env.example</code>). Only accounts explicitly linked to that provider sign in; nothing is ever matched by email or username. Switching one off doesn't unlink anybody.</p>
  <form id="signinForm" class="adm-form" onsubmit="return false">
    <label class="ck"><input type="checkbox" name="plex_sso"> 📼 Sign in with Plex <span class="adm-msg" data-st="plex"></span></label>
    <label class="ck"><input type="checkbox" name="telegram_sso"> ✈️ Sign in with Telegram (<code>TELEGRAM_BOT_TOKEN</code>; the bot's domain set in BotFather) <span class="adm-msg" data-st="telegram"></span></label>
    <label class="ck"><input type="checkbox" name="google_sso"> G Sign in with Google (<code>GOOGLE_CLIENT_ID</code> + <code>GOOGLE_CLIENT_SECRET</code>) <span class="adm-msg" data-st="google"></span></label>
    <label class="ck"><input type="checkbox" name="apple_sso"> Sign in with Apple (<code>APPLE_SERVICES_ID</code> + <code>APPLE_TEAM_ID</code> + <code>APPLE_KEY_ID</code> + <code>APPLE_PRIVATE_KEY</code>; return URL <code>/auth/apple/callback</code>, notifications <code>/auth/apple/notifications</code>) <span class="adm-msg" data-st="apple"></span></label>
    <div class="adm-actions"><button type="button" id="signinSave">Save</button><span id="signinStatus" class="adm-msg" role="status"></span></div>
  </form>
</section>
<script>
(function () {
  'use strict';
  var f = document.getElementById('signinForm'), msg = document.getElementById('signinStatus');
  if (!f) return;
  function paint(d) {
    ['plex', 'telegram', 'google', 'apple'].forEach(function (k) {
      var s = d[k] || {};
      f.elements[k + '_sso'].checked = !!s['switch'];
      var el = f.querySelector('[data-st="' + k + '"]');
      el.textContent = s.on ? '- showing' : (!s.configured ? '- not configured (hidden)' : '- off');
      // Apple's server-to-server notifications (consent revoked, account deleted, email forwarding): need APPLE_APP_ID
      var n = k === 'apple' && s.notices;
      if (n) {
        var when = function (x) { return new Date(x.at).toLocaleString(); };
        el.textContent += n.app_id ? '' : ' - notifications REFUSED until APPLE_APP_ID (the primary App ID) is set';
        if (n.last_ok) el.textContent += ' - last notification ' + when(n.last_ok) + ' (' + n.last_ok.type + ')';
        if (n.last_refused) el.textContent += ' - last refused ' + when(n.last_refused) + ' (' + n.last_refused.code + ')';
      }
    });
  }
  function call(method, body) {
    return fetch('/api/admin/signin-methods', { method: method, credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' }, body: body ? JSON.stringify(body) : undefined })
      .then(function (r) { return r.json(); })
      .then(function (d) { if (!d.ok) throw new Error(d.error || 'Failed'); return d; });
  }
  call('GET').then(paint).catch(function (e) { msg.textContent = e.message; });
  document.getElementById('signinSave').addEventListener('click', function () {
    msg.textContent = 'Saving…';
    call('POST', { plex_sso: f.elements.plex_sso.checked, telegram_sso: f.elements.telegram_sso.checked, google_sso: f.elements.google_sso.checked, apple_sso: f.elements.apple_sso.checked })
      .then(function (d) { paint(d); msg.textContent = 'Saved.'; })
      .catch(function (e) { msg.textContent = e.message; });
  });
})();
</script>
<% } %>
<% if (_can('auth.invites')) { %>
<%# 1.99anv: 🎟 sign-ups open / invite-only + invites (invites.js; GET/POST /api/admin/invites*, public/js/admin-invites.js) %>
<section class="adm-card" id="invites" aria-labelledby="invitesT">
  <h2 id="invitesT"><span class="ds-ic" aria-hidden="true">🎟️</span> Sign-ups &amp; invites <span class="adm-pill admin">admins</span> <span class="adm-pill" id="invMode" aria-label="sign-ups right now">?</span></h2>
  <p class="adm-help">While sign-ups are <b>invite-only</b>, every new website account needs an invite: the sign-up form, a first Google / Apple / Telegram / Plex / Twitch / Discord sign-in, and the first website sign-in of an account the Twitch / Discord bots made while it was on (claiming a Camfrog account goes through the sign-up form too). Never stopped: existing accounts signing in by any method, linking a sign-in method, Pepe's automatic Camfrog accounts, and the house invites below. Members get invites by level (the tiers add up), from the shop, or from you. An expired or revoked invite goes back to its owner. Every change here is in the admin log.</p>
  <p class="adm-help" id="invStats" style="color:var(--ds-text)">Loading…</p>
  <form id="invForm" class="adm-form" onsubmit="return false" autocomplete="off">
    <label for="invSignups">Sign-ups<select id="invSignups" name="signups"><option value="open">Open - anyone can sign up</option><option value="invite">Invite-only - an invite is needed</option></select></label>
    <label for="invExpiry">Invites expire after (days)<input type="number" id="invExpiry" name="expiry_days" min="1" max="365" step="1" inputmode="numeric"></label>
    <label for="invPrice">Shop price of one invite (PAT)<input type="number" id="invPrice" name="price" min="1" step="1" inputmode="numeric"></label>
    <label class="ck"><input type="checkbox" id="invWhenOpen" name="invites_when_open"> Members can make invites while sign-ups are open (an invite used then is still recorded)</label>
    <fieldset style="grid-column:1/-1;border:0;padding:0;margin:0;min-width:0">
      <legend class="adm-help" style="margin:0 0 6px">Invites by level - each tier adds to the ones before it; the last can be unlimited</legend>
      <div id="invTiers" style="display:grid;gap:8px"></div>
      <div class="adm-actions" style="margin-top:8px"><button type="button" class="adm-btn ghost" id="invTierAdd">Add a tier</button></div>
    </fieldset>
    <label for="invReason" style="grid-column:1/-1">Reason (optional, for the log)<input type="text" id="invReason" name="reason" maxlength="200"></label>
    <div class="adm-actions"><button type="button" id="invSave">Save sign-ups &amp; invites</button><span id="invMsg" class="adm-msg" role="status"></span></div>
  </form>

  <h3>Issue invites to a member</h3>
  <form id="invGrantForm" class="adm-form" onsubmit="return false" autocomplete="off">
    <label for="invGrantUser">Username<input type="text" id="invGrantUser" maxlength="64" required></label>
    <label for="invGrantN">Invites (negative takes back)<input type="number" id="invGrantN" step="1" value="1" inputmode="numeric" required></label>
    <label for="invGrantWhy">Reason (for the log)<input type="text" id="invGrantWhy" maxlength="200" required></label>
    <div class="adm-actions"><button type="button" id="invGrant">Issue</button><span id="invGrantMsg" class="adm-msg" role="status"></span></div>
  </form>

  <h3>House invite</h3>
  <p class="adm-help">A link from PATV itself: it counts against nobody's invites and works while sign-ups are invite-only. It expires like any invite.</p>
  <form id="invHouseForm" class="adm-form" onsubmit="return false" autocomplete="off">
    <label for="invHouseWhy">Who it's for (for the log)<input type="text" id="invHouseWhy" maxlength="200" required></label>
    <div class="adm-actions"><button type="button" id="invHouse">Make a house invite</button><span id="invHouseMsg" class="adm-msg" role="status"></span></div>
  </form>
  <p id="invHouseOut" class="mono" style="overflow-wrap:anywhere;margin:6px 0 0" hidden></p>

  <h3>Every invite</h3>
  <form id="invFilter" class="adm-form" onsubmit="return false" autocomplete="off">
    <label for="invQ">Username or code<input type="text" id="invQ" maxlength="64"></label>
    <label for="invStatus">Status<select id="invStatus"><option value="">all</option><option value="pending">pending</option><option value="used">used</option><option value="expired">expired</option><option value="revoked">revoked</option><option value="house">house</option></select></label>
    <div class="adm-actions"><button type="button" class="adm-btn ghost" id="invLoad">Show</button></div>
  </form>
  <div class="adm-tbl"><table aria-label="Invites">
    <thead><tr><th>#</th><th>Code</th><th>From</th><th>Used by</th><th>State</th><th>Made (UTC)</th><th>Expires (UTC)</th><th></th></tr></thead>
    <tbody id="invRows"></tbody>
  </table></div>

  <details class="adm-adv">
    <summary>Issued and bought invites, and the log</summary>
    <div class="adm-adv-body">
      <h3>Issued and bought</h3>
      <ul class="adm-help" id="invGrants" style="margin:0;padding-left:18px"></ul>
      <h3>Log</h3>
      <ul class="adm-help" id="invAudit" style="margin:0;padding-left:18px"></ul>
    </div>
  </details>
</section>
<script src="/public/js/admin-invites.js?v=2" defer></script>
<% } %>
<% if (_can('auth.guest_access')) { %>
<%# 1.99anv: 🚪 guest access - sections signed-out visitors can open (guestaccess.js; GET/POST /api/admin/guest-access, public/js/admin-guests.js) %>
<section class="adm-card ga" id="guests" aria-labelledby="guestsT">
  <h2 id="guestsT"><span class="ds-ic" aria-hidden="true">🚪</span> Guest access <span class="adm-pill admin">admins</span> <span class="adm-pill" id="gaCount" aria-label="sections off for guests">?</span></h2>
  <p class="adm-help">What a <b>signed-out</b> visitor can open. Untick a section and, for guests only, its pages show <i>"Sign in to see …"</i> with Sign in and - while sign-ups are invite-only - <i>Got an invite?</i> (else <i>Sign up</i>); its data feeds answer "sign in"; and it disappears from the navbar, the ☰ / More menus, the footer and the homepage's tiles. Members who are signed in see everything as before. Always open whatever this says: the homepage, signing in and up, invites, the legal pages, the bots' and Pepe's feeds, OBS overlays and embeds. All on = nothing changes. A change reaches every server process within 30 seconds, and each one is in the admin log (<code>guest_access</code>).</p>
  <p class="adm-help" id="gaMode" style="color:var(--ds-text)">Loading…</p>
  <form id="gaForm" class="ga-form" onsubmit="return false" autocomplete="off">
    <div id="gaList" class="ga-list"></div>
    <label for="gaReason" class="ga-why">Reason (optional, for the log)<input type="text" id="gaReason" maxlength="200"></label>
    <div class="adm-actions"><button type="button" id="gaSave">Save guest access</button><button type="button" class="adm-btn ghost" id="gaAll">Turn everything on</button><span id="gaMsg" class="adm-msg" role="status" aria-live="polite"></span></div>
  </form>
  <details class="adm-adv">
    <summary>Log</summary>
    <div class="adm-adv-body"><ul class="adm-help" id="gaAudit" style="margin:0;padding-left:18px"></ul></div>
  </details>
</section>
<style>
  .ga .ga-list { display: grid; gap: 14px; margin-top: 6px; }
  .ga .ga-sec { border: 0; padding: 0; margin: 0; min-width: 0; }
  .ga .ga-sec legend { font: 700 13px/1.4 var(--ds-font, sans-serif); color: var(--ds-text-2, #cfcfcf); margin: 0 0 6px; padding: 0; }
  .ga .ga-rows { display: grid; gap: 6px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .ga .ga-row { display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; align-items: start; padding: 8px 10px; border: 1px solid var(--ds-line, #262626); border-radius: 10px; cursor: pointer; text-transform: none; letter-spacing: 0; min-width: 0; }
  .ga .ga-row input { margin: 3px 0 0; grid-row: span 2; width: 18px; height: 18px; }
  .ga .ga-row b { color: var(--ds-text, #eee); font-size: 14px; }
  .ga .ga-row small { color: var(--ds-text-muted, #9a9a9a); font-size: 12.5px; line-height: 1.45; overflow-wrap: anywhere; }
  .ga .ga-row.off { border-color: var(--ds-danger-line, #5a2626); background: var(--ds-danger-bg, #1f1010); }
  .ga .ga-row.dirty b::after { content: " · not saved"; color: var(--ds-gold-text, #ffd54f); font-weight: 400; font-size: 12px; }
  .ga .ga-why { display: grid; gap: 4px; margin-top: 12px; text-transform: none; letter-spacing: 0; font-size: 12.5px; color: var(--ds-text-muted, #9a9a9a); }
  .ga .ga-why input { width: 100%; box-sizing: border-box; font-size: 16px; }
</style>
<script src="/public/js/admin-guests.js?v=1" defer></script>
<% } %>
