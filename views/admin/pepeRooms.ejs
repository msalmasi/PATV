<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<%- include('../partials/admin-open', { title, user, section: 'pepe', admIsAdmin: isAdmin }) %>
<%# 1.99kp: control the Camfrog rooms Pepe is in (roomctl.js -> website action room.ctl -> camfrog-bot pepe_roomctl.py). Admins only. %>
<div class="adm-head">
  <h1>Pepe's rooms</h1>
  <p>The Camfrog rooms Pepe is in right now. Join, leave, pick his active room (his mic/cam window and the main stage) and mute a room's sound. The same controls are on his own admin panel on the VM (port 8766, "Rooms Pepe is in").</p>
<p><a href="/admin/discord-golive"><%- t('admin.discord_golive.title') %></a></p>
</div>

<section class="adm-card" id="rooms" aria-labelledby="rmT">
  <h2 id="rmT">In the rooms <span class="adm-pill admin">admins</span> <span class="adm-pill" id="rmOnline"><%= v.online ? 'live' : 'offline' %></span></h2>
  <p class="adm-help">People / on the mic are known for bridged rooms only. Mute with net audio on also stops transcribing that room (<code>!audioroom -room</code>). Make active is refused while a game or Pepe's mic would be cut short, unless you tick force.</p>
  <div class="adm-tbl-wrap"><table class="adm-tbl"><thead><tr><th>Room</th><th class="num">👥</th><th class="num">🎙</th><th>Active</th><th>Sound</th><th></th></tr></thead>
    <tbody id="rmRows"><tr><td colspan="6" class="adm-help">Loading…</td></tr></tbody></table></div>
  <p class="adm-help" id="rmAudio"></p>
  <p class="adm-help" id="rmBans" hidden></p>
  <div class="adm-actions"><label><input type="checkbox" id="rmForce"> force (Make active even mid-game / mid-mic)</label>
    <button type="button" data-rc="active" data-room="auto" class="adm-btn ghost">Active: auto</button></div>
</section>

<section class="adm-card" id="join" aria-labelledby="jnT">
  <h2 id="jnT">Join a room</h2>
  <p class="adm-help">The name on the room's tab (e.g. Pepe's Pad) or its id. The password is used once and not stored (add the room to Auto-join on Pepe's panel to keep it). Pepe can only join while Camfrog is running on his VM.</p>
  <form class="adm-form" id="rmJoin" autocomplete="off">
    <label>Room <input type="text" id="rmName" maxlength="64" required></label>
    <label>Password (optional) <input type="password" id="rmPw" maxlength="64" autocomplete="new-password"></label>
    <div class="adm-actions"><button type="submit">Join</button></div>
  </form>
</section>

<section class="adm-card" id="log" aria-labelledby="lgT">
  <h2 id="lgT">Recent changes</h2>
  <p class="adm-msg" id="rmMsg" role="status" aria-live="polite"></p>
  <ul id="rmLog" class="adm-help"></ul>
</section>

<%# grabcard 1.99amm (the owner 2026-11-08: "where do i set the mic relay cooldowns and adjustable grab limits on the site?"): ⚡ Fast mic grab -
    Pepe's !mic fastgrab switches and caps for a room, the global default or every room (fastgrab.js: GET / POST /api/admin/pepe/fastgrab ->
    website action mic.fastgrab -> camfrog-bot pepe_fastgrabweb.py; the values are the ones Pepe reports with his rooms state). The card's
    script: public/js/admin-fastgrab.js. Admins only (pepe.rooms_commands_audio), each change audited (admin_audit pepe.fastgrab).
    1.99?? micblock: + Block break, Self-unblock and the Unblock code (the owner 11-08: "give me a toggle to remove this courtesy" / "a
    toggle plus field for whatever the unblock code is"). %>
<% const FG = locals.fg || { online: !!v.online, at: v.at || null, fg: (v.state && v.state.fastgrab) || null, actions: [] };
   const _fgFmt = (x) => (typeof x === 'boolean' ? (x ? 'on' : 'off') : Array.isArray(x) ? x.join('/') : x == null ? '–' : x === '' ? 'none' : String(x));
   const _fgKeys = ['on', 'contest', 'fair', 'claim', 'web', 'chatty', 'rate', 'shots', 'tries', 'breaker', 'pause', 'fairwait', 'ceiling',
                    'blockbreak', 'selfunblock', 'unblockcode']; %>
<style>
  #fastgrab .fg-num { width: 6.5em; display: inline-block; margin: 2px 4px 2px 0; }
  #fastgrab tr.fg-edited td { background: var(--ds-gold-bg); }
  #fastgrab .fg-follow { display: block; margin-top: 4px; }
  #fastgrab .fg-unit { white-space: nowrap; }
  #fastgrab td .adm-help { margin: 2px 0 0; }
  #fastgrab table.adm-tbl { max-height: none; }   /* (16 settings: the page scrolls, not a box inside it) */
  #fastgrab input[data-fg="unblockcode"] { width: 10em; }
  /* narrow screens (and the side panel): each setting is a block - name and what it does, then its value, where it comes from */
  @media (max-width: 760px) {
    #fastgrab table.adm-tbl, #fastgrab table.adm-tbl tbody, #fastgrab table.adm-tbl tr, #fastgrab table.adm-tbl td { display: block; width: auto; }
    #fastgrab table.adm-tbl thead { display: none; }
    #fastgrab table.adm-tbl tr { padding: 6px 0; border-bottom: 1px solid var(--ds-line); }
    #fastgrab table.adm-tbl td { border: 0; padding: 4px 12px; }
  }
</style>
<section class="adm-card" id="fastgrab" aria-labelledby="fgT">
  <h2 id="fgT"><span class="ds-ic" aria-hidden="true">⚡</span> Fast mic grab <span class="adm-pill admin">admins</span> <span class="adm-pill" id="fgOnline"><%= FG.online ? (FG.fg ? 'live' : 'live (older Pepe)') : 'offline' %></span></h2>
  <p class="adm-help">How Pepe wins a mic people are fighting over while a soundboard clip, a paid <code>!say</code> or an alert waits for it: the switches and limits of <code>!mic fastgrab</code> (and Fast grab caps on his own panel). Pick a room to set its own values, or the global default that every room without its own follows (tick every room to also clear the rooms' own values, like <code>-all</code>). The values are what Pepe reports now; a save sends only what you changed, as one change, and he answers with what he stored - a number outside its range is clamped and the card says so.</p>
  <p class="adm-help">Looking for the <b>push-to-talk</b> (relayed mic) cooldown, clips per 10 minutes and max length? Those are on <a href="/admin/bridge#pttlimits">Bridge › Push-to-talk clips</a>.</p>
  <p class="adm-help">When someone <b>blocks Pepe's mic</b> in a room: <b>Block break</b> (on by default) keeps him off that room's mic for 30 minutes; turn it off and he tries again as soon as the block is lifted. <b>Self-unblock</b> (off by default) makes him type the room's <b>Unblock code</b> in its chat a moment later, for a room bot that unblocks whoever types it (Players Lounge: <code>1</code>). Both are per room; a code is 1-20 characters and can't start with <code>/</code> or <code>!</code>.</p>
  <div class="adm-form">
    <label>Where<select id="fgWhere" class="ds-in">
      <option value="global">Global default (every room without its own)</option>
      <% ((FG.fg && FG.fg.rooms) || []).forEach((r) => { %><option value="room:<%= r.id %>"><%= r.name %><%= r.name !== r.id ? ' (' + r.id + ')' : '' %><%= r.joined ? '' : ' - Pepe is not in it now' %></option><% }) %>
    </select></label>
    <label id="fgAllL"><input type="checkbox" id="fgAll"> every room (also clears the rooms' own values)</label>
    <label>Reason (optional)<input class="ds-in" id="fgReason" maxlength="200" autocomplete="off"></label>
  </div>
  <% if (FG.fg && FG.fg.global) { %>
  <p class="adm-help" id="fgNow">Global now: <%= _fgKeys.map((k) => k + ' ' + _fgFmt(FG.fg.global[k])).join(' · ') %></p>
  <ul class="adm-help" id="fgRoomsNow">
    <% (FG.fg.rooms || []).forEach((r) => { const own = Object.keys(r.own || {}); %><li><b><%= r.name %></b><%= r.name !== r.id ? ' (' + r.id + ')' : '' %>: <%= own.length ? own.map((k) => k + ' ' + _fgFmt(r.values[k])).join(' · ') + ' (its own)' : 'follows the global' %></li><% }) %>
  </ul>
  <% } %>
  <div class="adm-tbl-wrap"><table class="adm-tbl" data-filtered="1" aria-label="Fast mic grab settings"><thead><tr><th>Setting</th><th>Value</th><th>From</th><th>Range · default</th></tr></thead>
    <tbody id="fgRows"><tr><td colspan="4" class="adm-help"><%= FG.fg ? 'Loading…' : (FG.online ? "This Pepe doesn't report his fast-grab settings yet - use !mic fastgrab in a room (or his own panel) until his update runs." : 'No report from Pepe right now (offline?).') %></td></tr></tbody></table></div>
  <p class="adm-help" id="fgContest"></p>
  <div class="adm-actions"><button type="button" id="fgSave"<%= FG.fg && FG.online ? '' : ' disabled' %>>Save</button>
    <button type="button" id="fgUndo" class="adm-btn ghost">Undo my edits</button>
    <span id="fgMsg" class="adm-msg" role="status" aria-live="polite"></span></div>
  <h3>Recent fast-grab changes</h3>
  <ul id="fgLog" class="adm-help">
    <% (FG.actions || []).forEach((x) => { %><li><%= x.status === 'done' ? '✅' : x.status === 'failed' ? '❌' : '⏳' %> <%= x.username || '' %>: <%= x.label || '' %><%= x.message ? ' - ' + x.message : '' %></li><% }) %>
  </ul>
</section>
<script type="application/json" id="fgData"><%- JSON.stringify(FG).replace(/</g, '\\u003c') %></script>
<script src="/public/js/admin-fastgrab.js?v=2" defer></script>

<script>
(function () {
  'use strict';
  var V = <%- JSON.stringify(v).replace(/</g, '\\u003c') %>;
  function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
  function btn(verb, room, label) { var b = el('button', 'adm-btn ghost', label); b.type = 'button'; b.setAttribute('data-rc', verb); b.setAttribute('data-room', room); return b; }
  function when(ms) { return ms ? new Date(ms).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : ''; }
  function render() {
    var st = V.state || { rooms: [] };
    document.getElementById('rmOnline').textContent = V.online ? 'live' : 'offline' + (V.at ? ' (last seen ' + when(V.at) + ')' : '');
    var body = document.getElementById('rmRows');
    body.textContent = '';
    if (!st.rooms.length) {
      var tr0 = el('tr'); var td0 = el('td', 'adm-help', V.online ? 'Pepe is not in any room.' : 'No report from Pepe yet.'); td0.colSpan = 6; tr0.appendChild(td0); body.appendChild(tr0);
    }
    st.rooms.forEach(function (r) {
      var tr = el('tr');
      var n = el('td'); n.appendChild(el('b', null, r.name)); if (r.name !== r.id) n.appendChild(el('div', 'adm-help', r.id));
      if (r.autojoin) n.appendChild(el('span', 'adm-pill', 'auto-join'));
      tr.appendChild(n);
      tr.appendChild(el('td', 'num', r.count == null ? '–' : String(r.count)));
      tr.appendChild(el('td', 'num', r.mic == null ? '–' : String(r.mic)));
      var a = el('td'); if (r.active) a.appendChild(el('span', 'adm-pill', st.pinned ? 'active (pinned)' : 'active (auto)')); else a.appendChild(btn('active', r.id, 'Make active'));
      tr.appendChild(a);
      var s = el('td'); s.appendChild(r.muted === true ? btn('unmute', r.id, '🔇 Unmute') : btn('mute', r.id, '🔊 Mute'));
      tr.appendChild(s);
      var l = el('td'); l.appendChild(btn('leave', r.id, 'Leave')); tr.appendChild(l);
      body.appendChild(tr);
    });
    document.getElementById('rmAudio').textContent = 'Audio: ' + (st.net_audio ? 'net audio (each room its own sound)' : 'one room at a time - ' + (st.audio_room || 'all rooms'))
      + (st.busy ? ' · now: ' + st.busy.verb + ' ' + st.busy.room + '…' : '');
    // 1.99zp: banned rooms (Pepe makes no automatic join there; Join below tries at once and clears it if he gets in)
    var bans = document.getElementById('rmBans');
    bans.hidden = !(st.bans && st.bans.length);
    bans.textContent = (st.bans || []).map(function (b) {
      return '🚫 banned from ' + b.room + (b.by ? ' (by ' + b.by + ')' : '') + (b.since ? ' since ' + new Date(b.since).toLocaleString() : '')
        + (b.retry_at ? ' - next automatic try ' + new Date(b.retry_at).toLocaleString() : '');
    }).join(' · ');
    var log = document.getElementById('rmLog');
    log.textContent = '';
    (V.actions || []).forEach(function (x) {
      var mark = x.status === 'done' ? '✅ ' : x.status === 'failed' ? '❌ ' : '⏳ ';
      log.appendChild(el('li', null, mark + when(x.created) + ' ' + (x.username || '') + ': ' + (x.label || '') + (x.message ? ' - ' + x.message : '')));
    });
  }
  function load() {
    return fetch('/api/admin/pepe/rooms', { credentials: 'same-origin', cache: 'no-store' }).then(function (r) { return r.json(); })
      .then(function (d) { if (d && d.ok) { V = d; render(); } }).catch(function () {});
  }
  function send(body) {
    var msg = document.getElementById('rmMsg');
    msg.textContent = '…';
    return fetch('/api/admin/pepe/rooms', { method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json(); })
      .then(function (d) { msg.textContent = d.ok ? 'Sent to Pepe - the result shows below in a few seconds.' : '❌ ' + (d.error || 'failed'); load(); })
      .catch(function () { msg.textContent = '❌ The site did not answer.'; });
  }
  document.addEventListener('click', function (ev) {
    var b = ev.target.closest ? ev.target.closest('button[data-rc]') : null;
    if (!b) return;
    var verb = b.getAttribute('data-rc'), room = b.getAttribute('data-room');
    if (verb === 'leave' && !confirm('Leave ' + room + '?')) return;
    var body = { verb: verb, room: room };
    if (verb === 'active' && room !== 'auto' && document.getElementById('rmForce').checked) body.force = true;
    send(body);
  });
  document.getElementById('rmJoin').addEventListener('submit', function (ev) {
    ev.preventDefault();
    var name = document.getElementById('rmName').value.trim(), pw = document.getElementById('rmPw');
    if (!name) return;
    var body = { verb: 'join', room: name };
    if (pw.value) body.password = pw.value;
    pw.value = '';
    send(body);
  });
  render();
  setInterval(function () { if (!document.hidden) load(); }, 5000);
})();
</script>
<%- include('../partials/admin-close') %>
</body>
</html>
