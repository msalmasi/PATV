<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<%- include('../partials/admin-open', { title, user, section: 'economy', admIsAdmin: isAdmin }) %>
<%
  const fmt = (x) => Math.round(Number(x) || 0).toLocaleString('en-US');
  const ago = (t) => { if (!t) return 'never'; const s = Math.max(0, Math.round((Date.now() - t) / 1000)); return s < 90 ? s + 's ago' : s < 5400 ? Math.round(s / 60) + 'm ago' : s < 172800 ? Math.round(s / 3600) + 'h ago' : Math.round(s / 86400) + 'd ago'; };
  const R = reserve, L = loans, T = (roy && roy.totals) || {};
%>
<div class="adm-head">
  <h1>Economy</h1>
  <p>The Federal Reserve and what the site pays out of it, loans, PAT grants, redemption codes, pad royalties and the prize shop. Rewards the site pays are funded from a vault, never minted.</p>
</div>

<section class="adm-card" id="reserve" aria-labelledby="reserveT">
  <h2 id="reserveT">Federal Reserve &amp; today's flows <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">The Reserve lives in Pepe; he syncs its balance here. Site payouts from it (level-ups, welcome and connect bonuses, codes…) are booked as claims that Pepe settles by draining his Reserve. If a vault can't cover a payout, it's skipped.</p>
  <% if (!isAdmin) { %><p class="adm-help">Admins only.</p><% } else if (!R) { %><p class="adm-help">Couldn't read the Reserve numbers.</p><% } else { %>
    <div class="adm-kv">
      <div><b>Balance (from Pepe)</b><span><%= R.balance === null ? 'never synced' : fmt(R.balance) + ' PAT' %></span></div>
      <div><b>Last sync</b><span><%= ago(R.syncedAt) %></span></div>
      <div><b>Unsettled site claims</b><span><%= fmt(R.unsettled) %> PAT</span></div>
      <div><b>Paid out today (UTC)</b><span><%= fmt(R.todayTotal) %> PAT</span></div>
      <% if (R.jackpot !== null) { %><div><b>Casino jackpot</b><span><%= fmt(R.jackpot) %> PAT</span></div><% } %>
    </div>
    <% const MP = typeof monetary !== 'undefined' ? monetary : null; %>
    <h3>Monetary policy (from Pepe)</h3>
    <% if (!MP) { %><p class="adm-help">Not synced yet: House flash liquidity is off and donations use the defaults (500,000 PAT per $1, +20% to the incentive budget).</p><% } else { %>
    <div class="adm-kv" id="monetaryKv">
      <div><b>Flash liquidity</b><span>House <%= MP.flash.house ? 'on' : 'off' %> · Bank <%= MP.flash.bank ? 'on' : 'off' %> · MM <%= MP.flash.mm ? 'on' : 'off' %></span></div>
      <div><b>Fed loan room</b><span><%= fmt(MP.fedloan_room) %> PAT</span></div>
      <div><b>House hard floor</b><span><%= fmt(MP.house_hard_floor) %> PAT</span></div>
      <div><b>Donations</b><span><%= fmt(MP.donation.rate) %> PAT per $1 · +<%= MP.donation.bonus_pct %>% to incentives</span></div>
      <div><b>Staff grant cap</b><span><%= MP.grant_weekly_cap < 0 ? 'unlimited' : fmt(MP.grant_weekly_cap) + ' PAT / week' %></span></div>
      <% if (MP.band) { %><div><b>Fed band</b><span><%= MP.band.fed === null ? '?' : fmt(MP.band.fed) %> (floor <%= MP.band.floor === null ? '?' : fmt(MP.band.floor) %> · ceiling <%= MP.band.ceiling === null ? '?' : fmt(MP.band.ceiling) %>)</span></div><% } %>
    </div>
    <% } %>
    <div class="adm-tbl"><table aria-label="Reserve payouts today by flow">
      <thead><tr><th>Flow (today, UTC)</th><th class="num">Payouts</th><th class="num">PAT</th></tr></thead>
      <tbody>
        <% if (!R.today.length) { %><tr><td colspan="3" class="empty">No Reserve payouts today.</td></tr><% } %>
        <% R.today.forEach((f) => { %><tr><td><code><%= f.flow %></code></td><td class="num"><%= fmt(f.n) %></td><td class="num"><%= fmt(f.t) %></td></tr><% }) %>
      </tbody>
    </table></div>
  <% } %>
</section>

<section class="adm-card" id="donations" aria-labelledby="donT">
  <h2 id="donT"><span class="ds-ic" aria-hidden="true">💖</span> Donations: promos <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">The normal rate is Pepe's (<code>!econ set donation_rate</code> / <code>donation_bonus_pct</code>). A <b>promo</b> boosts it for a while: a promo rate (PAT per $1) or a multiplier, a per-donor cap in dollars (dollars above it earn the normal rate; a donation that straddles the cap is split), an optional budget (the most PAT credited at the promo rate across everyone; then the normal rate), and an end time (at most 7 days). Card and stablecoin donations both use it; a donation belongs to the promo live when it was <b>paid</b> (card: when the checkout opened). Once a promo has started, its rate, cap and start are locked (donations were priced with them) - you can still change the label, the end, the budget and the switch, or end it now. Promos can't overlap. Every change is audit-logged.</p>
  <% if (!isAdmin) { %><p class="adm-help">Admins only.</p><% } else { %>
    <div id="dpAdm">
      <div class="adm-kv" id="dpKv"><div><b>Status</b><span>loading…</span></div></div>
      <h3>New promo</h3>
      <form class="adm-form" id="dpForm" autocomplete="off">
        <label for="dpLabel">Headline (optional)<input type="text" id="dpLabel" maxlength="120" placeholder="Today only: 1M PAT per $1, up to $100"></label>
        <label for="dpMode">Boost<select id="dpMode"><option value="rate">a promo rate (PAT per $1)</option><option value="mult">a multiplier on the normal rate</option></select></label>
        <label for="dpRate" id="dpRateL">Promo rate (PAT per $1)<input type="number" id="dpRate" min="1" step="1" placeholder="1000000"></label>
        <label for="dpMult" id="dpMultL" style="display:none">Multiplier (×)<input type="number" id="dpMult" min="1.01" step="0.01" placeholder="2"></label>
        <label for="dpCap">Per-donor cap ($ at the promo rate)<input type="number" id="dpCap" min="1" max="1000" step="1" value="100" required></label>
        <label for="dpBudget"><%= t('adm.dp.budget_label') %><input type="number" id="dpBudget" min="0" step="any" placeholder="<%= t('adm.dp.budget_ph_pat') %>" aria-describedby="dpBudgetHelp dpBudgetWarn"></label>
        <label for="dpBudgetUnit"><%= t('adm.dp.budget_unit') %><select id="dpBudgetUnit"><option value="pat"><%= t('adm.dp.unit_pat') %></option><option value="usd"><%= t('adm.dp.unit_usd') %></option></select></label>
        <p class="adm-help" id="dpBudgetHelp" aria-live="polite" style="grid-column:1/-1;margin:0"></p>
        <p class="adm-msg err" id="dpBudgetWarn" role="alert" style="grid-column:1/-1;margin:0" hidden></p>
        <label for="dpBonus">Incentive bonus % taken on<select id="dpBonus"></select></label>
        <label for="dpStarts">Starts (your time)<input type="datetime-local" id="dpStarts"></label>
        <label for="dpEnds">Ends (your time)<input type="datetime-local" id="dpEnds"></label>
        <label><input type="checkbox" id="dpToday"> Today only (now until midnight, <span id="dpTz">economy time zone</span>)</label>
        <label><input type="checkbox" id="dpEnabled" checked> Enabled</label>
        <p class="adm-help" id="dpPreview" aria-live="polite" style="grid-column:1/-1"></p>
        <div class="adm-actions"><button type="submit">Create promo</button></div>
      </form>
      <p class="adm-msg" id="dpMsg" role="status" aria-live="polite"></p>
      <h3>Promos</h3>
      <div class="adm-tbl"><table aria-label="Donation promos">
        <thead><tr><th>Promo</th><th>Status</th><th>Window</th><th class="num">Rate</th><th class="num">Cap</th><th class="num">Donors</th><th class="num">$ at promo</th><th class="num">PAT at promo / budget</th><th></th></tr></thead>
        <tbody id="dpRows"><tr><td colspan="9" class="empty">loading…</td></tr></tbody>
      </table></div>
      <form class="adm-form" id="dpEdit" autocomplete="off" style="display:none">
        <p class="adm-help" style="grid-column:1/-1" id="dpEditWhat"></p>
        <label for="dpELabel">Headline<input type="text" id="dpELabel" maxlength="120"></label>
        <label for="dpEEnds">Ends (your time)<input type="datetime-local" id="dpEEnds"></label>
        <label for="dpEBudget"><%= t('adm.dp.ebudget_label') %><input type="number" id="dpEBudget" min="0" step="any" placeholder="<%= t('adm.dp.budget_ph_pat') %>" aria-describedby="dpEBudgetHelp dpEBudgetWarn"></label>
        <label for="dpEBudgetUnit"><%= t('adm.dp.budget_unit') %><select id="dpEBudgetUnit"><option value="pat"><%= t('adm.dp.unit_pat') %></option><option value="usd"><%= t('adm.dp.unit_usd') %></option></select></label>
        <p class="adm-help" id="dpEBudgetHelp" aria-live="polite" style="grid-column:1/-1;margin:0"></p>
        <p class="adm-msg err" id="dpEBudgetWarn" role="alert" style="grid-column:1/-1;margin:0" hidden></p>
        <label><input type="checkbox" id="dpEEnabled"> Enabled</label>
        <div class="adm-actions"><button type="submit">Save</button><button type="button" class="adm-btn ghost" id="dpECancel">Cancel</button></div>
      </form>
      <h3>Daily donation limit</h3>
      <p class="adm-help">A member may donate at most this many dollars per day, card and crypto together; the day is midnight to midnight in the economy time zone (<b id="dlTz">America/New_York</b>), by when a donation was paid. 0 or blank = no limit. It is separate from a promo's per-donor cap (which only decides how much earns the promo rate) - both apply. Card: a checkout that would go over is refused (today's paid + open checkouts count), so we never take money we won't credit; a race that still goes over is credited and flagged below. Crypto: an over-limit transfer is <b>held</b> on <a href="/admin/crypto#held">/admin/crypto</a> - credit it or mark it refunded off-site. One member's override: <a href="/admin/users#donlimit">Users &amp; Accounts → Donation limit</a>.</p>
      <div class="adm-kv" id="dlKv"><div><b>Status</b><span>loading…</span></div></div>
      <div class="adm-tbl"><table aria-label="Donations credited over the daily limit">
        <thead><tr><th>Paid (UTC)</th><th>Member</th><th>Via</th><th class="num">Amount</th><th class="num">Limit</th></tr></thead>
        <tbody id="dlFlagged"><tr><td colspan="5" class="empty">loading…</td></tr></tbody>
      </table></div>
      <div class="adm-tbl"><table aria-label="Per-member daily limit overrides">
        <thead><tr><th>Member</th><th class="num">Limit / day</th><th>Set by</th><th>Note</th></tr></thead>
        <tbody id="dlOverrides"><tr><td colspan="4" class="empty">loading…</td></tr></tbody>
      </table></div>
      <h3>Global daily donation cap</h3>
      <p class="adm-help">A site-wide cap on the PAT donations mint per day (the donor's PAT at the base or promo rate <b>plus</b> the incentive bonus), all donors together, same New York day. Either a fixed PAT amount or a % of the total supply - the supply is frozen at the start of the day so the cap doesn't drift. Optionally also a cap on the day's donated dollars; whichever is hit first applies. Card checkouts that don't fit are refused before Stripe (the donor is offered the amount that still fits; open checkouts count); a race that still goes over is credited and flagged. Crypto over it is held on <a href="/admin/crypto#held">/admin/crypto</a>. The public page shows only "X% left" / "full for today", never the number. It applies on top of the per-member limit and the promo cap.</p>
      <div class="adm-kv" id="dgKv"><div><b>Status</b><span>loading…</span></div></div>
      <h3>Settings</h3>
      <form class="adm-form" id="dpSet" autocomplete="off">
        <label for="dgMode">Global cap<select id="dgMode"><option value="off">off (only the USD cap below, if set)</option><option value="fixed">a fixed PAT amount per day</option><option value="pct">a % of the total supply per day</option></select></label>
        <label for="dgPat">Fixed: PAT per day<input type="number" id="dgPat" min="0" step="1"></label>
        <label for="dgPct">%: of the supply frozen at the day's start<input type="number" id="dgPct" min="0" max="100" step="0.0001"></label>
        <label for="dgUsd">Also cap dollars per day ($, 0 = none)<input type="number" id="dgUsd" min="0" step="1"></label>
        <label for="dpDaily">Daily donation limit per member ($, 0 = none)<input type="number" id="dpDaily" min="0" max="1000000" step="1"></label>
        <label for="dpCeil">Ceiling (× the normal rate, 1-50)<input type="number" id="dpCeil" min="1" max="50" step="0.01"></label>
        <label for="dpSBonus">Default bonus base<select id="dpSBonus"></select></label>
        <label for="dpSTz">Time zone ("today only")<input type="text" id="dpSTz" maxlength="64"></label>
        <div class="adm-actions"><button type="submit">Save settings</button></div>
      </form>
      <h3>Change log</h3>
      <div class="adm-tbl"><table aria-label="Donation promo changes">
        <thead><tr><th>When (UTC)</th><th>By</th><th>What</th></tr></thead>
        <tbody id="dpLog"><tr><td colspan="3" class="empty">loading…</td></tr></tbody>
      </table></div>
    </div>
    <script src="/public/js/donpromo-budget.js?v=1" defer></script>
    <script src="/public/js/admin-donpromo.js?v=4" defer></script>
  <% } %>
</section>

<section class="adm-card" id="supply-history" aria-labelledby="shT">
  <h2 id="shT"><span class="ds-ic" aria-hidden="true">📈</span> Supply history <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">One row per UTC day, written on every supply snapshot Pepe posts: total supply, the Federal Reserve against its band, and each day's mints (Pepe's mint journal, by source) against the PAT burned that day. Month-to-date mints by source are compared with Pepe's caps.</p>
  <% if (!isAdmin) { %><p class="adm-help">Admins only.</p><% } else { %>
    <div id="shStatus" class="adm-help" aria-live="polite">Loading…</div>
    <figure class="sh-fig"><figcaption>Total supply (PAT)</figcaption><div id="shTotal" class="sh-chart"></div></figure>
    <figure class="sh-fig"><figcaption>Federal Reserve vs its band</figcaption><div id="shFed" class="sh-chart"></div></figure>
    <figure class="sh-fig"><figcaption>Mints per day (by source) vs burns</figcaption><div id="shMints" class="sh-chart"></div><div id="shLegend" class="sh-legend"></div></figure>
    <div class="adm-tbl"><table aria-label="Month-to-date mints by source">
      <thead><tr><th>Source (month to date)</th><th class="num">Minted</th><th class="num">Cap</th></tr></thead>
      <tbody id="shMtd"><tr><td colspan="3" class="empty">loading…</td></tr></tbody>
    </table></div>
    <style>
      .sh-fig { margin: 10px 0; min-width: 0; }
      .sh-fig figcaption { font-size: var(--ds-fs-meta); color: var(--ds-text-muted); margin-bottom: 4px; }
      .sh-chart svg { width: 100%; height: auto; display: block; }
      .sh-legend { display: flex; flex-wrap: wrap; gap: 10px; font-size: 12px; margin-top: 4px; }
      .sh-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-inline-end: 4px; vertical-align: middle; }
    </style>
    <script src="/public/js/admin-supply.js?v=2" defer></script>
  <% } %>
</section>

<section class="adm-card" id="incentives" aria-labelledby="incT">
  <h2 id="incT"><span class="ds-ic" aria-hidden="true">🎁</span> Incentive budget &amp; grant queue <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">Economy v2 E-2. While Pepe's treasury is on (<code>!econ treasury on</code>, with <code>!econ layers on</code>), the weekly surplus waterfall fills the incentive budget and the site pays welcome PAT, level-ups, achievements and connect bonuses from it, each group within its weekly budget. A grant that doesn't fit waits here (FIFO per group) and is paid when a sync shows room; Pepe only settles paid claims. Preview the week with <code>!econ waterfall preview</code>.</p>
  <% const I = typeof inc !== 'undefined' ? inc : null; %>
  <% if (!isAdmin) { %><p class="adm-help">Admins only.</p><% } else if (!I) { %><p class="adm-help">Couldn't read the queue.</p><% } else { %>
    <div class="adm-kv">
      <div><b>Status</b><span><%= I.live ? 'live (grants paid from the incentive budget)' : 'off: grants are paid from the Reserve' %></span></div>
      <% if (I.incentives) { %>
        <div><b>Budget (from Pepe)</b><span><%= fmt(I.incentives.balance) %> PAT</span></div>
        <div><b>Week</b><span><%= I.incentives.week %><%= I.incentives.share !== null ? ' · share ' + fmt(I.incentives.share) + ' (' + fmt(I.incentives.release_per_day) + '/day)' : '' %></span></div>
      <% } %>
      <div><b>Paid, not yet settled by Pepe</b><span><%= fmt(I.unsettled) %> PAT</span></div>
    </div>
    <div class="adm-tbl"><table aria-label="Grant budgets and queue by group">
      <thead><tr><th>Group</th><th class="num">Left this week</th><th class="num">Weekly budget</th><th class="num">Queued</th><th class="num">Queued PAT</th><th>Oldest</th></tr></thead>
      <tbody>
        <% const gs = Array.from(new Set(Object.keys((I.incentives && I.incentives.budgets) || {}).concat(Object.keys(I.groups || {})))); %>
        <% if (!gs.length) { %><tr><td colspan="6" class="empty">Nothing queued, and no budgets synced.</td></tr><% } %>
        <% gs.forEach((g) => { const q = (I.groups || {})[g] || { n: 0, t: 0, oldest: null }; const b = I.incentives || { remaining: {}, budgets: {} }; %>
          <tr><td><code><%= g %></code><%= g === 'activity' ? ' ' + t('economy.group.activity') : '' %></td><td class="num"><%= b.remaining[g] !== undefined ? fmt(b.remaining[g]) : '–' %></td>
            <td class="num"><%= b.budgets[g] !== undefined ? fmt(b.budgets[g]) : '–' %></td><td class="num"><%= fmt(q.n) %></td>
            <td class="num"><%= fmt(q.t) %></td><td><%= q.oldest || '–' %></td></tr>
        <% }) %>
      </tbody>
    </table></div>
    <div class="adm-tbl"><table aria-label="Oldest queued grants">
      <thead><tr><th>Queued (UTC)</th><th>User</th><th>Grant</th><th class="num">PAT</th></tr></thead>
      <tbody>
        <% if (!I.items.length) { %><tr><td colspan="4" class="empty">No grants waiting.</td></tr><% } %>
        <% I.items.forEach((c) => { %><tr><td><%= c.created %></td><td><%= c.username || '(gone)' %></td><td><%= c.type %></td><td class="num"><%= fmt(c.amount) %></td></tr><% }) %>
      </tbody>
    </table></div>
  <% } %>
</section>

<section class="adm-card" id="launchpad" aria-labelledby="lpT">
  <h2 id="lpT"><span class="ds-ic" aria-hidden="true">🚀</span> Pad launchpad <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">New pads build momentum (regulars: real, linked, aged accounts active on 2+ days, never the owner or alts) toward launch tiers. A tier that is reached waits here for review; once approved, Pepe pays <b>his</b> tier amount from the incentive budget's <code>launchpad</code> group into the pad's room vault (needs <code>!econ roomvaults on</code>). Newcomer welcomes, owner deposit matching and front-page boost credit come from the same group. Every number is a Pepe setting: <code>!econ launchpad</code> · <code>!econ launchpad set &lt;key&gt; &lt;value&gt;</code> · <code>!econ launchpad tier &lt;n&gt; &lt;regulars&gt; &lt;days&gt; &lt;grant&gt;</code> · <code>!econ launchpad on|off</code>.</p>
  <% if (!isAdmin) { %><p class="adm-help">Admins only.</p><% } else { %>
    <div id="lpAdmin" aria-live="polite"><p class="adm-help">Loading…</p></div>
    <form id="lpEnroll" class="adm-form" autocomplete="off">
      <label for="lpRoom">Pad (slug or room id)</label> <input id="lpRoom" name="room" required>
      <select name="action" aria-label="Action"><option value="enroll">enroll (launch starts now)</option><option value="exclude">exclude</option><option value="include">include again</option></select>
      <input name="note" placeholder="note" aria-label="Note">
      <button type="submit">Apply</button>
    </form>
    <script src="/public/js/launchpad-admin.js?v=1" defer></script>
  <% } %>
</section>

<%- include('../partials/econ-activity-pads', { isAdmin, me }) %>

<%- include('../partials/econ-pools', { isAdmin, me }) %>

<%- include('../partials/econ-gscale', { isAdmin, me }) %>

<%- include('../partials/econ-policy', { isAdmin, me }) %>

<%- include('../partials/econ-autoescrow', { isAdmin, me }) %>

<section class="adm-card" id="burn" aria-labelledby="burnT">
  <h2 id="burnT"><span class="ds-ic" aria-hidden="true">🔥</span> Burn reserve <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">The last step of the weekly surplus waterfall: once the incentive buffer and the Reserve's 25M target are full, the leftover moves into Pepe's burn reserve and is destroyed (total supply goes down). Nothing else feeds it and no other pool can be burned. In <b>accrual</b> mode Pepe burns it at his next burn tick; in <b>batch</b> mode it waits for a burn here (or <code>!burn</code> in chat). Mode and caps are on Pepe's admin panel. Public log: <a href="/economy#burned">/economy#burned</a>.</p>
  <% if (!isAdmin) { %><p class="adm-help">Admins only.</p><% } else { %>
    <div id="burnAdm" data-csrf="<%= typeof pepeCtlCsrf === 'function' ? pepeCtlCsrf(me.username) : '' %>">
      <div class="adm-kv" id="burnKv"><div><b>Status</b><span>loading…</span></div></div>
      <form class="adm-form" id="burnForm" autocomplete="off">
        <label for="burnAmt">Amount (PAT)<input type="number" id="burnAmt" min="1" step="1" required></label>
        <label for="burnWhy">Reason<input type="text" id="burnWhy" maxlength="200" placeholder="what this burn is"></label>
        <div class="adm-actions"><button type="submit">Preview burn…</button></div>
      </form>
      <div id="burnConfirm" hidden>
        <p class="adm-help" id="burnWhat"></p>
        <label for="burnPw" class="adm-help">Confirm with your account password</label>
        <input type="password" id="burnPw" maxlength="200" autocomplete="current-password">
        <div class="adm-actions"><button type="button" id="burnYes">Burn it for good</button><button type="button" id="burnNo" class="adm-btn ghost">Cancel</button></div>
      </div>
      <p class="adm-msg" id="burnMsg" role="status"></p>
      <div class="adm-tbl"><table aria-label="Recent burns">
        <thead><tr><th>When (UTC)</th><th class="num">PAT</th><th>Reason</th><th>By</th></tr></thead>
        <tbody id="burnRows"><tr><td colspan="4" class="empty">loading…</td></tr></tbody>
      </table></div>
    </div>
    <script src="/public/js/admin-burn.js?v=1" defer></script>
  <% } %>
</section>

<section class="adm-card" id="loans" aria-labelledby="loansT">
  <h2 id="loansT">Loans &amp; credit <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">Reserve loan requests are approved or declined on the wallet page (its admin sections show each requester's live credit score). Pepe sends the loan book; rates and limits are his.</p>
  <% if (!isAdmin) { %><p class="adm-help">Admins only.</p><% } else if (!L || !L.known) { %><p class="adm-help">No loan data from Pepe yet.</p><% } else { %>
    <div class="adm-kv">
      <div><b>Pending requests</b><span><%= L.pending %><%= L.pending && isFinite(L.oldest) ? ' · oldest ' + ago(L.oldest * (L.oldest < 1e12 ? 1000 : 1)) : '' %></span></div>
      <div><b>Open Reserve loans</b><span><%= L.reserveOpen %></span></div>
      <div><b>Outstanding book</b><span><%= L.book == null ? '—' : fmt(L.book) + ' PAT' %></span></div>
      <div><b>Room left</b><span><%= L.room == null ? '—' : fmt(L.room) + ' PAT' %></span></div>
      <div><b>Reserve lending</b><span><%= L.enabled === null ? '—' : L.enabled ? 'open' : 'closed' %></span></div>
      <div><b>Synced</b><span><%= ago(L.updated) %></span></div>
    </div>
  <% } %>
  <div class="adm-actions" style="margin-top:10px">
    <a class="adm-btn ghost" href="/wallet#admin-requests">Loan requests ›</a>
    <a class="adm-btn ghost" href="/wallet#admin-book">Reserve book ›</a>
    <a class="adm-btn ghost" href="/wallet#admin-stashes">All stashes ›</a>
  </div>
</section>

<div class="adm-cols">
  <section class="adm-card" id="grants" aria-labelledby="grantsT">
    <h2 id="grantsT">PAT grant <span class="adm-pill admin">admins</span></h2>
    <p class="adm-help">Paid from the incentive budget: adds PAT to an account's balance as a "Staff transfer" in their history (the old "Points panel"). Refused if the incentive budget can't cover it, isn't synced yet, or this week's staff-grant cap (a Pepe setting) would be passed - never queued, never minted. A negative amount takes PAT back into the incentive budget. The Reserve only fills the protocol's pools, so it never pays a grant.</p>
    <% if (!isAdmin) { %><p class="adm-help">Admins only.</p><% } else { %>
    <form id="pointsTransferForm" class="adm-form" action="/api/admin/transfer/username" method="POST">
      <label for="pointsUsername">Username<input type="text" id="pointsUsername" name="username" required autocomplete="off"></label>
      <label for="pointsAmount">Amount (PAT)<input type="number" id="pointsAmount" name="amount" required></label>
      <div class="adm-actions"><button type="submit">Grant PAT</button><span id="transferStatus" class="adm-msg" role="status"></span></div>
    </form>
    <% } %>
  </section>

  <section class="adm-card" id="codes" aria-labelledby="codesT">
    <h2 id="codesT">Redemption codes</h2>
    <p class="adm-help">Codes members redeem for PAT (paid through the <code>redeem_codes</code> flow). Click a code to see who used it.</p>
    <form id="redemption-codes" class="adm-form" action="/api/admin/redemption-codes" method="post">
      <label for="code">Code<input type="text" id="code" name="code" required autocomplete="off"></label>
      <label for="points">PAT value<input type="number" id="points" name="points" required></label>
      <label for="uses_allowed">Uses<input type="number" id="uses_allowed" name="uses_allowed" required></label>
      <label for="expiration_date">Expires<input type="date" id="expiration_date" name="expiration_date"></label>
      <div class="adm-actions"><button type="submit">Save code</button><span id="codeStatus" class="adm-msg" role="status"></span></div>
    </form>
    <h3>Existing codes</h3>
    <div id="redemptionCodesList" class="adm-chips"></div>
  </section>
</div>

<section class="adm-card" id="royalties" aria-labelledby="royT">
  <h2 id="royT">Pad owner royalties</h2>
  <p class="adm-help">What pad owners earn on spending in their pads. Rates and payout rules are set on <a href="/pads/admin#royalties">Pads › Owner royalties</a>.</p>
  <div class="adm-kv">
    <div><b>Pending</b><span><%= fmt(T.pending) %> PAT</span></div>
    <div><b>Paid out by the Fed</b><span><%= fmt(T.paid) %> PAT</span></div>
    <div><b>Expired</b><span><%= fmt(T.expired) %> PAT</span></div>
    <div><b>Earned all-time</b><span><%= fmt(T.earned) %> PAT</span></div>
    <% if (roy && roy.next_release) { %><div><b>Next release</b><span><%= new Date(roy.next_release).toISOString().slice(0, 16).replace('T', ' ') %> UTC</span></div><% } %>
  </div>
</section>

<section class="adm-card" id="econ-telemetry" aria-labelledby="econT">
  <h2 id="econT">Economy telemetry <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">Economy v2, phase E-0: measurement only, nothing is paid. The last 7 days per room: revenue by flow (every PAT flow Pepe routes, tagged with its room), verified watch-minutes from the stage players (one session per account, visible + playing; the streamer and linked accounts excluded, likely alts counted apart), participants (&ge; 10 chat lines or &ge; 5 mic minutes that day), and a <b>dry run</b>: what the 50/50 split would have put in the room's vault and what the room-vault recipe (10%/day, owner 15 / gang 15 / streamers 25 / participants 35 / games 10) would have paid from an empty vault. Gang and room-games slices are 0 until those phases exist; the activity top-up pool (the only pad top-up since 2026-10-12) tops a pad up to at most 1:1 of "paid". Burn reserve: 0 (no Treasury epoch yet).</p>
  <div id="econ-tel-status" class="adm-help">Loading…</div>
  <div class="adm-tbl"><table>
    <thead><tr><th>Room</th><th class="num">Revenue 7d</th><th>Top flows</th><th class="num">50/50 to vault</th><th class="num">to Fort Knox</th><th class="num">VWM (alt / self)</th><th class="num">Participants/day</th><th class="num">Recipe would pay</th><th class="num">Vault after 7d</th></tr></thead>
    <tbody id="econ-tel-rows"><tr><td colspan="9" class="empty">…</td></tr></tbody>
  </table></div>
  <p class="adm-help" id="econ-tel-foot"></p>
</section>

<section class="adm-card" id="shop" aria-labelledby="shopT">
  <h2 id="shopT">Prize shop</h2>
  <p class="adm-help">Member listings, orders, disputes and the shop's fee settings have their own admin page; official (site) prizes have the older manager.</p>
  <div class="adm-kv">
    <div><b>Listings awaiting review</b><span><%= shop ? shop.review : '—' %></span></div>
    <div><b>Disputed orders</b><span><%= shop ? shop.disputes : '—' %></span></div>
  </div>
  <div class="adm-actions" style="margin-top:10px">
    <a class="adm-btn ghost" href="/shop/admin">Prize shop admin ›</a>
    <a class="adm-btn ghost" href="/admin/manage-prizes">Official prizes ›</a>
  </div>
</section>

<section class="adm-card" id="oracle" aria-labelledby="oracleT">
  <h2 id="oracleT"><span class="ds-ic" aria-hidden="true">⚖️</span> <%- t('oadm.econ.title') %></h2>
  <p class="adm-help"><%- t('oadm.econ.help') %></p>
  <div class="adm-actions"><a class="adm-btn ghost" href="/admin/oracle"><%- t('oadm.econ.link') %> ›</a></div>
</section>

<section class="adm-card" id="elsewhere" aria-labelledby="elseT">
  <h2 id="elseT">On Pepe's admin panel, not here</h2>
  <p class="adm-help">These are Pepe's and are changed from his own admin panel (or chat commands), not from the website:</p>
  <ul class="adm-list">
    <li><b>PAT Routing</b> - which vault each flow pays from / into, including the pad-owner share.</li>
    <li><b>Automint</b> and <b>vaults</b> (vault flows, the share of all Reserve outflows).</li>
    <li><b>Reserve top-ups</b> and the Reserve loan rate and limits.</li>
    <li><b>Burn reserve</b> mode (accrual / batch) and the manual-burn caps.</li>
    <li><b>Casino bans</b> (the site only stores the flag Pepe sets).</li>
  </ul>
</section>
<script src="/public/js/admin-panel.js?v=4" defer></script>
<%- include('../partials/admin-close') %>
</body>
</html>
