<%- include('../partials/admin-open', { title, user, section: 'bridge', admIsAdmin: isAdmin }) %>
<% const _can = locals.can || new Function(include('../../siteperms-core.js'))().viewCan(locals);
   // 1.99acl: each section on its own capability (the command log, the relay blocks, the mod log)
   const logOk = _can('bridge.cmdlog'), blkOk = _can('bridge.blocks_global'), mlOk = _can('pepe.modlog');
   const clOk = _can('chatlog.admin');   // CL2: the pad chat archive (chatlog.js)
   const tdOk = _can('chatlog.read_all');   // CL6: takedowns + audit (chatlogmod.js) -%>
<div class="adm-head">
  <h1>Bridge</h1>
  <p>The Camfrog bridge: Pepe relays each Camfrog room he's in to its pad. Members with a linked Camfrog name can send chat and <code>!commands</code> from the pad page; every web command is logged here.</p>
</div>

<section class="adm-card" id="cmdlog" aria-labelledby="cmdT">
  <h2 id="cmdT">Web command log <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">Newest first. Filter by pad (Camfrog room id) and/or Camfrog name; up to 500 rows.</p>
  <% if (!logOk) { %><p class="adm-help">Admins only.</p><% } else { %>
  <form id="cmdForm" class="adm-form">
    <label>Room id<input type="text" name="room" placeholder="e.g. plant_based_chatting" autocomplete="off"></label>
    <label>Camfrog name<input type="text" name="camfrog" autocomplete="off"></label>
    <label>Rows<select name="limit"><option>100</option><option>250</option><option>500</option></select></label>
    <div class="adm-actions"><button type="submit">Show</button><span id="cmdMsg" class="adm-msg" role="status"></span></div>
  </form>
  <div class="adm-tbl"><table aria-label="Web command log" data-filter>
    <thead><tr><th>When (UTC)</th><th>Account</th><th>Camfrog</th><th>Room</th><th>Command</th><th>Status</th><th>Result</th></tr></thead>
    <tbody id="cmdRows"><tr><td colspan="7" class="empty">Loading…</td></tr></tbody>
  </table></div>
  <% } %>
</section>

<section class="adm-card" id="blocks" aria-labelledby="blkT">
  <h2 id="blkT">Web relay blocks <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">Accounts blocked from talking into a Camfrog room from the website (relay lines, clips, <code>!commands</code>, the Pepe menu) - by a room's mods / the pad's owner (<code>!bridge block</code>, the owner page) or here. Leave the room empty to block in <b>every</b> room. A linked chat login keeps its normal Camfrog chat. Pepe enforces the same list.</p>
  <% if (blkOk) { %>
  <form id="blkForm" class="adm-form">
    <label>Who<input type="text" name="target" placeholder="🌐name, u:&lt;id&gt;, username or chat name" autocomplete="off" required></label>
    <label>Room id<input type="text" name="room" placeholder="empty = every room" autocomplete="off"></label>
    <label>What<select name="feature"><option value="all">everything</option><option value="chat">chat</option><option value="commands">commands + Pepe menu</option><option value="soundboard">soundboard</option><option value="voice">voice clips</option><option value="snapshots">cam snapshots</option><option value="livecams">live cams</option><option value="clips">cam + mic clips</option></select></label>
    <label>For<select name="hours"><option value="24">24 hours</option><option value="168">7 days</option><option value="720">30 days</option><option value="0">until lifted</option></select></label>
    <label>Reason<input type="text" name="reason" maxlength="120" autocomplete="off"></label>
    <div class="adm-actions"><button type="submit">Block</button><span id="blkMsg" class="adm-msg" role="status"></span></div>
  </form>
  <div class="adm-tbl"><table aria-label="Web relay blocks">
    <thead><tr><th>Account</th><th>Room</th><th>What</th><th>Until (UTC)</th><th>Reason</th><th>By</th><th></th></tr></thead>
    <tbody id="blkRows"><tr><td colspan="7" class="empty">Loading…</td></tr></tbody>
  </table></div>
  <p class="adm-help">One account's restrictions as toggles: <a href="/admin/users#bridgebans">Users › Web bridge restrictions</a>.</p>
  <% } %>
</section>

<%# 1.99zf: Pepe's mod log, every room (pepemodlog.js; owners see their own room's on the pad's owner panel) %>
<section class="adm-card" id="modlog" aria-labelledby="mlT">
  <h2 id="mlT">Moderation history <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">Pepe's mod log (kicks, bans, time-outs, mic blocks, roles, automod strikes / fines, topic) synced from Pepe, plus the site's web bridge blocks and live-cam ends - newest first. Each pad's owner sees their own room's on the pad's owner panel.</p>
  <% if (mlOk) { %>
  <form id="mlForm" class="adm-form">
    <label>Room id<input type="text" name="room" placeholder="empty = every room" autocomplete="off"></label>
    <label>Kind<select name="cat"><option value="">all</option><option>kick</option><option>ban</option><option>timeout</option><option>mic</option><option>roles</option><option>automod</option><option>bridge</option><option>room</option><option value="misc">other</option></select></label>
    <label>Name / text<input type="text" name="q" maxlength="40" autocomplete="off"></label>
    <div class="adm-actions"><button type="submit">Show</button><button type="button" id="mlOlder" class="adm-btn ghost" disabled>Older</button><span id="mlMsg" class="adm-msg" role="status"></span></div>
  </form>
  <div class="adm-tbl"><table aria-label="Moderation history">
    <thead><tr><th>When (UTC)</th><th>Room</th><th>Kind</th><th>Type</th><th>By</th><th>Target</th><th>Details</th></tr></thead>
    <tbody id="mlRows"><tr><td colspan="7" class="empty">Loading…</td></tr></tbody>
  </table></div>
  <% } %>
</section>

<%# CL2: the pad chat archive (chatlog.js) - its switches, write health, the held un-hides and the search index %>
<section class="adm-card" id="chatarchive" aria-labelledby="clT">
  <h2 id="clT">Chat archive <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">Every line a pad's live chat shows, kept by the pad's tier once the archive is on (chat, mic transcripts, joins / leaves / mic, topic, site notices; never PMs or commands with private arguments). Turn on the <b>notice</b> first: the privacy policy changes at once and Pepe announces it in every bridged room; the <b>archive</b> can start 7 days later. History, search and downloads stay off until their releases are live and checked; deletion by tier (purge) is on by default.</p>
  <% if (!clOk) { %><p class="adm-help">Site admins only.</p><% } else { %>
  <p class="adm-help" id="clSummary" role="status">Loading…</p>
  <div class="adm-tbl"><table aria-label="Chat archive switches">
    <thead><tr><th>Switch</th><th>State</th><th>Notes</th><th></th></tr></thead>
    <tbody id="clSwitches"><tr><td colspan="4" class="empty">Loading…</td></tr></tbody>
  </table></div>
  <p class="adm-help" id="clWrites"></p>
  <h3>Held un-hides</h3>
  <p class="adm-help" id="clHeldHelp">A batch that would un-hide many people at once - or move them from left out to shown as "someone" (Pepe lost his state?) - waits here. Approve only if Pepe really meant it; anyone who hid again since keeps that. <b>Incognito only</b>: people an older Pepe listed without saying why, whom he now reports as incognito and not on <code>!bridge hide</code> - approving shows their lines as "someone". <b>No longer listed</b>: people an older Pepe hid without saying why and lists no more - approving un-hides them (names them again), so only approve when that's right; rejecting keeps them left out until the site restarts.</p>
  <div class="adm-tbl"><table aria-label="Held un-hides">
    <thead><tr><th>When (UTC)</th><th>Kind</th><th>People</th><th></th></tr></thead>
    <tbody id="clHeld"><tr><td colspan="4" class="empty">Loading…</td></tr></tbody>
  </table></div>
  <h3>Search index</h3>
  <p class="adm-help" id="clFts"></p>
  <div class="adm-actions"><button type="button" id="clFtsCheck" class="adm-btn ghost">Run a full check</button><button type="button" id="clFtsRepair" class="adm-btn ghost">Repair</button><span id="clMsg" class="adm-msg" role="status"></span></div>
  <h3>Rooms</h3>
  <div class="adm-tbl"><table aria-label="Archived rooms">
    <thead><tr><th>Room</th><th>Pad</th><th>Lines</th><th>Indexed</th><th>Size</th><th>Since (UTC)</th></tr></thead>
    <tbody id="clRooms"><tr><td colspan="6" class="empty">Loading…</td></tr></tbody>
  </table></div>
  <%# CL7: deletion by tier (chatlogpurge.js) - the last nightly pass, its fail-safes, what the next 7 days would delete %>
  <h3>Deletion by tier</h3>
  <p class="adm-help">Every night, lines past their pad's retention are deleted from the archive, its search index and the live chat: chat by the tier's chat window, 🎙 transcripts by its recording window, and each tier a pad loses keeps its windows 30 more days from the day it was lost. Nothing is deleted while Pepe's retention report is more than an hour old (or didn't name every tier's windows), a pad's tier can't be read, or the server clock looks wrong; such a pass is retried at the next hourly check. A legal hold or an open report keeps its lines, also one placed while a pass runs. With the purge switch off the pass only counts, and lines past retention stay out of view. Not reached by it: copies with a life of their own (quotes, chat clips and 🔊 mic clips posted to the feed, 🔔 mention alerts - a staff "Delete for good" reaches those), backups until they expire, and the database file's free pages until SQLite reuses them.</p>
  <p class="adm-help" id="clPurge" role="status">Loading…</p>
  <div class="adm-actions"><button type="button" id="clPurgeRun" class="adm-btn ghost">Run tonight's pass now…</button><button type="button" id="clPurgeCount" class="adm-btn ghost">Recount (deletes nothing)</button><span id="clPurgeMsg" class="adm-msg" role="status"></span></div>
  <div class="adm-tbl"><table aria-label="Deletion by tier per room">
    <thead><tr><th>Room</th><th>Tier</th><th>Deleted (last pass)</th><th>Past retention, not deleted</th><th>Next 7 days (per day)</th></tr></thead>
    <tbody id="clPurgeRows"><tr><td colspan="5" class="empty">Loading…</td></tr></tbody>
  </table></div>
  <%# CL3: each pad's 💬 Chat settings (padchat.js) - what visitors see, the forward-only watermarks, a lock %>
  <h3>Pad chat settings</h3>
  <p class="adm-help">What each pad's owner chose in Pad settings › 💬 Chat (pads with defaults aren't listed). <b>Lock</b> freezes a pad's settings for its owner and staff; only site admins can change them then. Watermarks: lines said before them stay out of public view (a wider setting never reopens the past; "open earlier history" does, 7 days after the owner asks).</p>
  <div class="adm-tbl"><table aria-label="Pad chat settings">
    <thead><tr><th>Pad</th><th>Visitors see</th><th>Search</th><th>Downloads</th><th>Mods</th><th>Watermarks (UTC)</th><th></th></tr></thead>
    <tbody id="clPads"><tr><td colspan="7" class="empty">Loading…</td></tr></tbody>
  </table></div>
  <form class="adm-actions" id="clLockForm" autocomplete="off">
    <label>Lock a pad's chat settings: <input type="text" name="room" maxlength="128" placeholder="pad address or room id" required></label>
    <button type="submit" class="adm-btn ghost">Lock</button>
  </form>
  <p class="adm-help" id="clRedact"></p>
  <p class="adm-help" id="clCmds"></p>
  <%# CL10: chat-log downloads (chatlogexport.js) - metadata only, never content; kept 90 days %>
  <h3>Downloads</h3>
  <p class="adm-help" id="clDlSum">Who downloaded which pad's chat log (range, format, lines, how it ended) - never what was in it. Kept 90 days; each person sees their own in Settings › Account.</p>
  <div class="adm-tbl"><table aria-label="Chat-log downloads">
    <thead><tr><th>When (UTC)</th><th>Who</th><th>Pad</th><th>Range (UTC)</th><th>Format</th><th>As</th><th>Lines</th><th>Size</th><th>State</th></tr></thead>
    <tbody id="clDl"><tr><td colspan="9" class="empty">Loading…</td></tr></tbody>
  </table></div>
  <% } %>
</section>

<%# CL6: takedowns and audit (chatlogmod.js) - the per-login tool, legal holds, the owner's earlier era, the staff audit %>
<section class="adm-card" id="takedowns" aria-labelledby="tdT">
  <h2 id="tdT">Chat takedowns <span class="adm-pill">staff</span></h2>
  <p class="adm-help">Reported lines are decided on <a href="/feed/admin#chatlines">Feed › Reported chat lines</a>. Here: everything archived from one Camfrog login or account (privacy@ requests from people without an account, minors, deceased users, legal orders), legal holds, and letting a pad's owner read from before they became its owner. Every action here, and every staff read of a pad's history past its public window, is logged below (kept 2 years).</p>
  <% if (!tdOk) { %><p class="adm-help">PATV staff only (chatlog.read_all).</p><% } else { %>
  <p class="adm-help" id="tdSummary" role="status">Loading…</p>
  <h3>One login or account</h3>
  <form class="adm-form" id="tdWho" autocomplete="off">
    <label>Who<input type="text" name="key" maxlength="70" placeholder="a Camfrog login, @username or u:&lt;account id&gt;" required></label>
    <label>Reason (audited)<input type="text" name="why" maxlength="200" placeholder="e.g. privacy@ request #123"></label>
    <div class="adm-actions">
      <button type="submit" data-act="look" class="adm-btn ghost">Look up</button>
      <button type="button" data-act="export" class="adm-btn ghost">Export (JSON)</button>
      <button type="button" data-act="hide_all" class="adm-btn ghost">Hide every line</button>
      <button type="button" data-act="unhide_all" class="adm-btn ghost">Undo "Hide every line"</button>
      <button type="button" data-act="hold" class="adm-btn ghost">Legal hold</button>
      <button type="button" data-act="unhold" class="adm-btn ghost">Release hold</button>
      <button type="button" data-act="purge_all" class="adm-btn danger">Delete every line for good…</button>
      <span id="tdMsg" class="adm-msg" role="status"></span>
    </div>
  </form>
  <div id="tdResult" class="adm-help"></div>
  <h3>A pad's archive</h3>
  <form class="adm-form" id="tdRoom" autocomplete="off">
    <label>Pad<input type="text" name="room" maxlength="128" placeholder="pad address or room id" required></label>
    <label>Reason (audited)<input type="text" name="why" maxlength="200"></label>
    <div class="adm-actions">
      <button type="button" data-op="hold" class="adm-btn ghost">Legal hold</button>
      <button type="button" data-op="unhold" class="adm-btn ghost">Release hold</button>
      <button type="button" data-op="grant" class="adm-btn ghost">Let the owner read the earlier era</button>
      <button type="button" data-op="ungrant" class="adm-btn ghost">Take that back</button>
      <span id="tdRoomMsg" class="adm-msg" role="status"></span>
    </div>
  </form>
  <h3>Legal holds</h3>
  <p class="adm-help">A hold pauses the 30-day deletion of hidden lines, deletion by tier and staff deletions for its room or login, until it's released.</p>
  <div class="adm-tbl"><table aria-label="Legal holds">
    <thead><tr><th>On</th><th>Why</th><th>By</th><th>Since (UTC)</th></tr></thead>
    <tbody id="tdHolds"><tr><td colspan="4" class="empty">Loading…</td></tr></tbody>
  </table></div>
  <h3>Staff reads and actions</h3>
  <div class="adm-tbl"><table aria-label="Staff reads and actions">
    <thead><tr><th>When (UTC)</th><th>Who</th><th>What</th><th>Room</th><th>Login</th><th>Why</th></tr></thead>
    <tbody id="tdViews"><tr><td colspan="6" class="empty">Loading…</td></tr></tbody>
  </table></div>
  <% } %>
</section>

<%# 1.99afn: who saw through a frog name, when and why (seethrough.js; chatlog.see_through = Admins) %>
<% if (_can('chatlog.see_through')) { %>
<section class="adm-card" id="seethrough" aria-labelledby="stT">
  <h2 id="stT">See-through log <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">Every time a PATV admin, or a pad's owner on their own pad, revealed who is behind a private person's frog name (room analytics now; pad chat later) - one row per reveal, or per "Show real names" toggle (open until it was turned off, with every login it showed). Kept 180 days; never shown to the people revealed.</p>
  <form id="stForm" class="adm-form">
    <label>Room id<input type="text" name="room" placeholder="empty = every pad" autocomplete="off"></label>
    <label>Rows<select name="limit"><option>100</option><option>250</option><option>500</option></select></label>
    <div class="adm-actions"><button type="submit">Show</button><span id="stMsg" class="adm-msg" role="status"></span></div>
  </form>
  <div class="adm-tbl"><table aria-label="See-through log">
    <thead><tr><th>When (UTC)</th><th>Who</th><th>As</th><th>What</th><th>Pad</th><th>Logins shown</th><th>Reason</th><th>Ended</th></tr></thead>
    <tbody id="stRows"><tr><td colspan="8" class="empty">Loading…</td></tr></tbody>
  </table></div>
</section>
<script>
(function () {
  'use strict';
  var f = document.getElementById('stForm'), body = document.getElementById('stRows'), msg = document.getElementById('stMsg');
  if (!f) return;
  var when = function (t) { return t ? new Date(Number(t)).toISOString().slice(0, 16).replace('T', ' ') : ''; };
  function td(t) { var d = document.createElement('td'); d.textContent = t == null ? '' : String(t); return d; }
  function load() {
    var q = new URLSearchParams();
    ['room', 'limit'].forEach(function (k) { var v = f.elements[k].value.trim(); if (v) q.set(k, v); });
    msg.textContent = 'Loading…'; msg.className = 'adm-msg';
    fetch('/api/admin/seethrough?' + q.toString(), { credentials: 'same-origin', cache: 'no-store' })
      .then(function (r) { return r.json().then(function (d) { if (!r.ok || !d.ok) throw new Error(d.error || ('HTTP ' + r.status)); return d; }); })
      .then(function (d) {
        body.textContent = '';
        (d.rows || []).forEach(function (r) {
          var tr = document.createElement('tr');
          [when(r.at), r.username || r.user_id, r.role, r.scope + (r.scope.slice(-7) === '_toggle' ? ' (' + r.n + ' page' + (r.n === 1 ? '' : 's') + ')' : ''), r.room_id,
           (r.logins || []).join(', ') || '-', r.reason, r.ended ? when(r.ended) : 'still on'].forEach(function (v) { tr.appendChild(td(v)); });
          body.appendChild(tr);
        });
        if (!(d.rows || []).length) { var tr = document.createElement('tr'), c = td('Nobody has revealed anyone.'); c.colSpan = 8; c.className = 'empty'; tr.appendChild(c); body.appendChild(tr); }
        msg.textContent = (d.rows || []).length + ' rows'; msg.className = 'adm-msg ok';
      })
      .catch(function (e) { msg.textContent = e.message; msg.className = 'adm-msg err'; });
  }
  f.addEventListener('submit', function (e) { e.preventDefault(); load(); });
  load();
})();
</script>
<% } %>

<section class="adm-card" aria-labelledby="bridgeMoreT">
  <h2 id="bridgeMoreT">Per pad</h2>
  <p class="adm-help">Each pad's bridge settings and its room moderation are on the pad's own Manage page; the list of pads is on <a href="/pads/admin#owners">Pads › Pads &amp; owners</a>.</p>
</section>
<% if (logOk || blkOk || mlOk) { %>
<script>
(function () {
  'use strict';
  var f = document.getElementById('cmdForm'), body = document.getElementById('cmdRows'), msg = document.getElementById('cmdMsg');
  if (!f) return;
  function td(t) { var d = document.createElement('td'); d.textContent = t == null ? '' : String(t); return d; }
  function load() {
    var q = new URLSearchParams();
    ['room', 'camfrog', 'limit'].forEach(function (k) { var v = f.elements[k].value.trim(); if (v) q.set(k, v); });
    msg.textContent = 'Loading…'; msg.className = 'adm-msg';
    fetch('/api/bridge/cmdlog?' + q.toString(), { credentials: 'same-origin', cache: 'no-store' })
      .then(function (r) { return r.json().then(function (d) { if (!r.ok || !d.ok) throw new Error(d.error || ('HTTP ' + r.status)); return d; }); })
      .then(function (d) {
        body.textContent = '';
        (d.rows || []).forEach(function (r) {
          var tr = document.createElement('tr');
          tr.appendChild(td(r.ts ? new Date(Number(r.ts)).toISOString().slice(0, 16).replace('T', ' ') : ''));
          [r.username, r.camfrog, r.room, r.command, r.status, r.result].forEach(function (v) { tr.appendChild(td(v)); });
          body.appendChild(tr);
        });
        if (!(d.rows || []).length) { var tr = document.createElement('tr'), c = td('No commands.'); c.colSpan = 7; c.className = 'empty'; tr.appendChild(c); body.appendChild(tr); }
        msg.textContent = (d.rows || []).length + ' rows'; msg.className = 'adm-msg ok';
      })
      .catch(function (e) { msg.textContent = e.message; msg.className = 'adm-msg err'; });
  }
  f.addEventListener('submit', function (e) { e.preventDefault(); load(); });
  load();
})();
// 1.99xa: web relay blocks (bridgeblocks.js)
(function () {
  'use strict';
  var f = document.getElementById('blkForm'), body = document.getElementById('blkRows'), msg = document.getElementById('blkMsg');
  if (!f) return;
  function td(t) { var d = document.createElement('td'); d.textContent = t == null ? '' : String(t); return d; }
  function req(method, data) {
    return fetch('/api/admin/bridge/blocks', { method: method, credentials: 'same-origin', cache: 'no-store',
      headers: data ? { 'content-type': 'application/json', 'x-requested-with': 'fetch' } : {}, body: data ? JSON.stringify(data) : undefined })
      .then(function (r) { return r.json().then(function (d) { if (!r.ok || !d.ok) throw new Error(d.error || ('HTTP ' + r.status)); return d; }); });
  }
  function load() {
    req('GET').then(function (d) {
      body.textContent = '';
      (d.blocks || []).forEach(function (b) {
        var tr = document.createElement('tr');
        [b.username || b.userId, b.global ? 'every room' : b.room, b.feature || 'all', b.until ? new Date(b.until).toISOString().slice(0, 16).replace('T', ' ') : 'until lifted',
         b.reason, b.by].forEach(function (v) { tr.appendChild(td(v)); });
        var c = document.createElement('td'), btn = document.createElement('button');
        btn.type = 'button'; btn.textContent = 'Unblock';
        btn.addEventListener('click', function () {
          btn.disabled = true;
          req('POST', { op: 'unblock', room: b.room, target: 'u:' + b.userId, feature: b.feature || 'all' }).then(load)
            .catch(function (e) { btn.disabled = false; msg.textContent = e.message; msg.className = 'adm-msg err'; });
        });
        c.appendChild(btn); tr.appendChild(c); body.appendChild(tr);
      });
      if (!(d.blocks || []).length) { var tr = document.createElement('tr'), c = td('Nobody is blocked.'); c.colSpan = 7; c.className = 'empty'; tr.appendChild(c); body.appendChild(tr); }
    }).catch(function (e) { msg.textContent = e.message; msg.className = 'adm-msg err'; });
  }
  f.addEventListener('submit', function (e) {
    e.preventDefault();
    var d = { op: 'block', target: f.elements.target.value.trim(), room: f.elements.room.value.trim(), feature: f.elements.feature.value, hours: f.elements.hours.value, reason: f.elements.reason.value.trim() };
    msg.textContent = 'Blocking…'; msg.className = 'adm-msg';
    req('POST', d).then(function (r) { msg.textContent = 'Blocked ' + ((r.target && r.target.username) || d.target) + (d.room ? ' in ' + d.room : ' in every room') + '.'; msg.className = 'adm-msg ok'; f.reset(); load(); })
      .catch(function (err) { msg.textContent = err.message; msg.className = 'adm-msg err'; });
  });
  load();
})();
// 1.99zf: the moderation history, every room (pepemodlog.js)
(function () {
  'use strict';
  var f = document.getElementById('mlForm'), body = document.getElementById('mlRows'), msg = document.getElementById('mlMsg'), older = document.getElementById('mlOlder');
  if (!f) return;
  var page = 0;
  function td(t) { var d = document.createElement('td'); d.textContent = t == null ? '' : String(t); return d; }
  function load(append) {
    var q = new URLSearchParams();
    ['room', 'cat', 'q'].forEach(function (k) { var v = f.elements[k].value.trim(); if (v) q.set(k, v); });
    q.set('page', String(page)); q.set('limit', '100');
