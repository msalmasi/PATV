      (s.relays_to != null ? ' · !msg copies sent to them: ' + s.relays_to : '') +
      (s.camfrog ? ' · their Camfrog login in !msg copy records: ' + (s.camfrog.copies_to + s.camfrog.copies_from) + ', admins’ Camfrog logs: ' + s.camfrog.threads : '') +
      (r.camfrog_forgot ? ' · Camfrog login replaced by a pseudonym in ' + r.camfrog_forgot.relays + ' copy record(s) and ' + r.camfrog_forgot.threads + ' log(s)' : '') +
      (r.audit_renamed ? ' · ' + r.audit_renamed + ' earlier audit row(s) now name the pseudonym' : '') +
      (r.purged != null ? ' · deleted now: ' + r.purged + (r.skipped_held ? ' (' + r.skipped_held + ' kept: a room hold)' : '') : '') +
      (r.unhidden != null ? ' · staff hide undone' + (r.still_hidden ? ' (still hidden for another reason: their own privacy setting, forget-me or deletion)' : '') : '');
    out.appendChild(p);
    if ((s.rooms || []).length) {
      var ul = document.createElement('ul');
      s.rooms.forEach(function (x) { var li = document.createElement('li'); li.textContent = (x.title || x.room_id) + ': ' + x.n + ' line(s)' + (x.removed ? ', ' + x.removed + ' taken down' : '') + ' · ' + when(x.first) + ' - ' + when(x.last) + ' UTC'; ul.appendChild(li); });
      out.appendChild(ul);
    }
    if (r.export) {
      var blob = new Blob([JSON.stringify(r.export, null, 2)], { type: 'application/json' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob); a.download = 'patv-chatlog-' + r.keys[0].replace(/[^\w.-]+/g, '_') + '.json';
      a.textContent = 'Download the export (' + r.export.lines.length + ' line(s)' + (r.export.truncated ? ', cut at the cap' : '') + ')';
      out.appendChild(a);
    }
  }
  function runWho(act) {
    var key = who.elements.key.value.trim(), why = who.elements.why.value.trim();
    if (!key) return;
    // (CL6 fix-up: a look too - it tells where and when someone spoke)
    if (why.length < 3) { say(msg, 'Give the reason first - it is audited.', false); return; }
    if (act === 'purge_all' && !window.confirm('Delete EVERY archived line of ' + key + ' for good - everywhere (quotes, mic clips, mention alerts, Pepe’s !log) - and replace their Camfrog login with a pseudonym in Pepe’s !msg copy records and the admins’ Camfrog logs? This can’t be undone.')) return;
    if (act === 'hide_all' && !window.confirm('Hide every line of ' + key + ' on every pad, past and future (Undo "Hide every line" reverses only this)?')) return;
    say(msg, 'Working…', true);
    req('/api/admin/chatlog/who', { key: key, action: act, why: why }).then(function (r) { say(msg, 'Done.', true); showWho(r); load(); })
      .catch(function (e) { say(msg, e.message, false); });
  }
  who.addEventListener('submit', function (e) { e.preventDefault(); runWho('look'); });
  Array.prototype.forEach.call(who.querySelectorAll('button[type="button"][data-act]'), function (b) { b.addEventListener('click', function () { runWho(b.getAttribute('data-act')); }); });
  Array.prototype.forEach.call(room.querySelectorAll('button[data-op]'), function (b) {
    b.addEventListener('click', function () {
      var r = room.elements.room.value.trim().replace(/^.*\/p\//, '').replace(/[/?#].*$/, ''), why = room.elements.why.value.trim();
      if (!r) return;
      if (why.length < 3) { say(rmsg, 'Give the reason first - it is audited.', false); return; }
      say(rmsg, 'Working…', true);
      req('/api/admin/chatlog/room/' + encodeURIComponent(r) + '/' + b.getAttribute('data-op'), { why: why }).then(function () { say(rmsg, 'Done.', true); load(); })
        .catch(function (e) { say(rmsg, e.message, false); });
    });
  });
  load();
})();
</script>
<% } %>
<%- include('../partials/admin-close') %>
</body>
</html>
