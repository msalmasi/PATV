<%- include('../partials/admin-open', { title, user, section: 'pepe', admIsAdmin: isAdmin }) %>
<% const ctlOk = (locals.can || new Function(include('../../siteperms-core.js'))().viewCan(locals))('pepe.control'); -%>
<div class="adm-head">
  <h1>Pepe</h1>
  <p>Restart Pepe or Camfrog on his VM, change his look, and see what he's doing. The same panel is still at the bottom of the homepage for admins.</p>
</div>

<section class="adm-card" id="control" aria-labelledby="ctlT">
  <h2 id="ctlT">Control panel <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">Status from the VM supervisor's heartbeat. Restarts need your account password; look changes run Pepe's admin chat commands as you. Everything is logged.</p>
  <% if (ctlOk) { %>
    <%- include('../partials/pepe-control', { me }) %>
    <script>(function () { var d = document.getElementById('pepeCtl'); if (d) d.open = true; })();</script>
  <% } else { %>
    <p class="adm-help">Admins only.</p>
  <% } %>
</section>

<section class="adm-card" id="rooms" aria-labelledby="rmT">
  <h2 id="rmT"><span class="ds-ic" aria-hidden="true">📡</span> Rooms <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">The Camfrog rooms Pepe is in: join a room (with a password), leave, pick his active room, mute a room's sound.</p>
  <div class="adm-actions"><a class="adm-btn ghost" href="/admin/pepe/rooms">Pepe's rooms ›</a></div>
</section>

<%# grabcard 1.99amm: ⚡ Fast mic grab (fastgrab.js; the card is on the rooms page) %>
<section class="adm-card" id="fastgrab" aria-labelledby="fgT">
  <h2 id="fgT"><span class="ds-ic" aria-hidden="true">⚡</span> Fast mic grab <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">How Pepe wins a mic people are fighting over (<code>!mic fastgrab</code>): fast grab, contest, fairness and claim, PTT web clips / chatty lines / -mic replies, and the limits - rate, shots, tries, breaker, contested pause, fairness wait, the ceiling - for one room, the global default or every room, with the values he has now. The push-to-talk clip limits (cooldown, clips per 10 minutes, max length) are on the Bridge page.</p>
  <div class="adm-actions"><a class="adm-btn ghost" href="/admin/pepe/rooms#fastgrab">Fast mic grab ›</a><a class="adm-btn ghost" href="/admin/bridge#pttlimits">Push-to-talk clips ›</a></div>
</section>

<%# micspeed 1.99anb: ⏱ Mic timing (mictiming.js; the card is on the rooms page) %>
<section class="adm-card" id="mictiming" aria-labelledby="mtHubT">
  <h2 id="mtHubT"><span class="ds-ic" aria-hidden="true">⏱</span> Mic timing <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">How fast Pepe's clips start once he has the mic - the timing pads (grab confirm, lead-in, tail-out, the web clip settle) and the speed-ups (the Talk check during the clip, the fast grab's confirm window, the second-click retry, the TTS poll) - and the list of people <code>!mic yield</code> gives the mic to.</p>
  <div class="adm-actions"><a class="adm-btn ghost" href="/admin/pepe/rooms#mictiming">Mic timing ›</a></div>
</section>

<section class="adm-card" id="commands" aria-labelledby="pcT">
  <h2 id="pcT"><span class="ds-ic" aria-hidden="true">🎛️</span> Commands <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">Every command and feature with a master switch (off = off in every room) and the global default rooms follow - search, AI badges, bulk actions, the change log.</p>
  <div class="adm-actions"><a class="adm-btn ghost" href="/admin/pepe/commands">Pepe's commands ›</a></div>
</section>

<section class="adm-card" id="audio" aria-labelledby="paT">
  <h2 id="paT"><span class="ds-ic" aria-hidden="true">🔊</span> Room audio <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">How Pepe streams a room's sound to its pad: WebRTC pacing (helper process / in-process), its buffer, the mixer latency, the listener's jitter buffer and the bitrates - with the values he runs now and each room's latest audio stats.</p>
  <div class="adm-actions"><a class="adm-btn ghost" href="/admin/pepe/audio#room-audio">Room audio settings ›</a></div>
</section>

<%# wave 3 (design §N.3): 🧠 Pepe's memory - a count only (who opted out is never shown, not even here); admins only (adminweb.js) %>
<% if (locals.mem) { const MS = mem; %>
<section class="adm-card" id="memory" aria-labelledby="pmT">
  <h2 id="pmT"><span class="ds-ic" aria-hidden="true">🧠</span> Pepe's memory <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help">People who told Pepe "don't remember me" (<code>!remember off</code> or Settings → Privacy). Nobody can switch it back for them; an admin can only make Pepe forget someone on a privacy request.</p>
  <% if (!MS.capable) { %>
    <p class="adm-help">Pepe's latest privacy report doesn't have the switch yet (an older Pepe) - the setting and its privacy-policy text are hidden until it does.</p>
  <% } else { %>
    <p><b><%= MS.all == null ? '-' : MS.all %></b> opted out in Pepe's latest full list<% if (MS.last_full) { %> (<%= new Date(MS.last_full).toISOString().slice(0, 16).replace('T', ' ') %> UTC)<% } %>, <b><%= MS.linked %></b> of them with a PATV account.</p>
  <% } %>
</section>
<% } %>

<section class="adm-card" id="feed" aria-labelledby="pfT">
  <h2 id="pfT">Pepe on the feed</h2>
  <p class="adm-help">His site-wide caps, his All-feed settings, the pads he's switched on in, and every post and comment he made are on the feed admin page.</p>
  <div class="adm-actions"><a class="adm-btn ghost" href="/feed/admin#pepe">Pepe's feed settings ›</a><a class="adm-btn ghost" href="/admin/bridge">Bridge command log ›</a></div>
</section>
<%- include('../partials/admin-close') %>
</body>
</html>
