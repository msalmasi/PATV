<% const t = locals.i18nT || new Function(include('../../i18n-core.js'))()(JSON.parse(include('../../locales/en.json'))); -%>
<%- include('../partials/admin-open', { title, user, section: 'games', admIsAdmin: isAdmin }) %>
<%# 1.99ack: each admin-only card asks its own capability (siteperms.js) %><% const _can = locals.can || new Function(include('../../siteperms-core.js'))().viewCan(locals); -%>
<div class="adm-head">
  <h1>Games</h1>
  <p>The wheel and its jackpot, the casino front end, the GTF heist market and the duel / brawl rules. Hold'em, blackjack and the chat games run in Pepe; their settings are his.</p>
</div>

<div class="adm-cols">
  <section class="adm-card" id="wheel" aria-labelledby="wheelT">
    <h2 id="wheelT">Manual wheel spin</h2>
    <p class="adm-help">Spins the public wheel for a member, as if they'd spun it. Only one spin runs at a time.</p>
    <form id="manualSpinForm" class="adm-form" action="/api/g/wheel/jackpot" method="POST">
      <label for="spinUsername">Username<input type="text" id="spinUsername" name="username" required autocomplete="off"></label>
      <div class="adm-actions"><button id="spin" type="submit">Spin the wheel</button><span id="spinStatus" class="adm-msg" role="status"></span></div>
    </form>
    <p class="adm-help" style="margin-top:10px"><a href="/u/<%= encodeURIComponent(user) %>/wheel">Watch the wheel ›</a></p>
  </section>

  <section class="adm-card" id="jackpot" aria-labelledby="jackpotT">
    <h2 id="jackpotT">House adjustment <span class="adm-pill admin">owners</span></h2>
    <p class="adm-help">Moves PAT between the Federal Reserve and the House (the casino jackpot pot) - never a free mint. A positive amount is paid by the Reserve (refused if it can't cover it); a negative one returns what the House holds to the Reserve. Needs a reason; every adjustment is in the admin log.</p>
    <%# PO-0b: a Pepe owner's; owner answers 2026-10-20 (3): + the password step-up (stepup.js) %>
    <% if (!_can('econ.house_adjust')) { %><p class="adm-help">Admins only.</p><% } else { %>
    <p class="adm-help"><%- t('admin.stepup.owner_help') %></p>
    <form id="jackpotForm" class="adm-form" action="/api/g/wheel/jackpot" method="POST">
      <label for="jackpotAmount">Amount (PAT)<input type="number" id="jackpotAmount" name="amount" step="1" required></label>
      <label for="jackpotReason">Reason<input type="text" id="jackpotReason" name="reason" minlength="8" maxlength="200" required placeholder="why the House needs this"></label>
      <label for="jackpotPw"><%- t('admin.stepup.pw') %><input type="password" id="jackpotPw" maxlength="200" autocomplete="current-password" required></label>
      <div class="adm-actions"><button type="submit">Adjust the House</button><span id="jackpotStatus" class="adm-msg" role="status"></span></div>
    </form>
    <% } %>
  </section>
</div>

<%# 1.99ol: the casino FRONT END per game (casino_settings bj_front / hm_front, casino/service.js frontOf) - which pages the
    links and redirects use. Separate from the engine switches (bj_enabled / hm_enabled) and from rooms' !casino backend. %>
<section class="adm-card" id="casino-front" aria-labelledby="casinoFrontT">
  <h2 id="casinoFrontT"><%- t('casino.front.title') %> <span class="adm-pill admin">admins</span></h2>
  <p class="adm-help"><%- t('casino.front.help', { patv: '<code>/casino/blackjack</code>, <code>/casino/holdem</code>', pepe: '<code>/blackjack</code>, <code>/poker</code>' }) %></p>
  <% if (!_can('casino.admin')) { %><p class="adm-help">Admins only.</p><% } else if (!locals.casino) { %><p class="adm-help"><%- t('casino.front.failed') %></p><% } else { %>
  <% const _cs = locals.casino;
     const _eff = (g) => { const f = g === 'holdem' ? _cs.hm_front : _cs.bj_front; if (f === 'patv' || f === 'pepe') return f; return (g === 'holdem' ? _cs.hm_enabled : _cs.bj_enabled) ? 'patv' : 'pepe'; };
     const _path = (g) => _eff(g) === 'patv' ? (g === 'holdem' ? '/casino/holdem' : '/casino/blackjack') : (g === 'holdem' ? '/poker' : '/blackjack'); %>
  <form id="casinoFrontForm" class="adm-form" data-saved="<%= t('casino.front.saved') %>" data-failed="<%= t('casino.front.failed') %>">
    <% [['bj', 'bj_front', 'bj_enabled', 'casino.front.bj'], ['holdem', 'hm_front', 'hm_enabled', 'casino.front.hm']].forEach(([g, key, eng, label]) => { %>
    <label for="cf_<%= key %>"><%- t(label) %>
      <select id="cf_<%= key %>" name="<%= key %>">
        <% ['auto', 'patv', 'pepe'].forEach((v) => { %><option value="<%= v %>"<%= (_cs[key] || 'auto') === v ? ' selected' : '' %>><%- t('casino.front.' + v) %></option><% }) %>
      </select>
      <span class="adm-help" style="margin:0"><%- t('casino.front.now', { page: '<a href="' + _path(g) + '"><code>' + _path(g) + '</code></a>' }) %> · <%- t('casino.front.engine', { state: t(_cs[eng] ? 'casino.front.on' : 'casino.front.off') }) %></span>
    </label>
    <% }) %>
    <div class="adm-actions"><button type="submit"><%- t('casino.front.save') %></button><span id="casinoFrontStatus" class="adm-msg" role="status"></span></div>
  </form>
  <p class="adm-help" style="margin-top:10px"><%- t('casino.front.preview', { a: '<a href="/casino/blackjack?preview=1"><code>/casino/blackjack?preview=1</code></a>', b: '<a href="/poker?preview=1"><code>/poker?preview=1</code></a>' }) %></p>
  <% } %>
</section>

<section class="adm-card" id="casino" aria-labelledby="casinoT">
  <% if (_can('casino.admin') && locals.casino) { %>
  <h2>Hold'em controls</h2>
  <form id="hmQolForm" class="adm-form">
    <% [['hm_sitout_mins','Sit-out limit (minutes)'],['hm_timebank_secs','Initial time bank (seconds)'],['hm_timebank_max','Maximum time bank (seconds)'],['hm_timebank_per10','Bank refill per 10 hands (seconds)'],['hm_presets_pot','Pot presets (%)'],['hm_presets_bb','Preflop presets (BB)']].forEach(([key,label]) => { %>
    <label><%= label %><input name="<%= key %>" value="<%= locals.casino[key] %>" required></label>
    <% }) %>
    <button type="submit">Save Hold'em controls</button><span id="hmQolStatus" role="status"></span>
  </form>
  <script>
  (function () {
    var form = document.getElementById('hmQolForm');
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var status = document.getElementById('hmQolStatus');
      try {
        for (var input of form.querySelectorAll('input[name]')) {
          var r = await fetch('/api/casino/admin/settings', {method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json','X-Requested-With':'fetch'}, body:JSON.stringify({key:input.name,value:input.value})});
          var j = await r.json(); if (!j.ok) throw new Error(j.error || 'Save failed');
        }
        status.textContent = 'Saved';
      } catch (err) { status.textContent = err.message || 'Save failed'; }
    });
  })();
  </script>
  <% } %>
  <h2 id="casinoT">Casino bans</h2>
  <p class="adm-help">One flag blocks a member from all casino play (the web wheel and blackjack, the chat games, Discord). Pepe sets and lists it from his admin panel / chat; the site only enforces it.</p>
  <div class="adm-actions"><a class="adm-btn ghost" href="/casino">Casino lobby ›</a><a class="adm-btn ghost" href="/lotto">Lotto ›</a></div>
</section>
<%# h22 (1.99??): 🏁 Sit & Go - the switch casino_sng (off | staff | everyone, default off; Hold'em on the site must be on too), its
    settings (validated by casino/tourney.js checkSetting; a sit & go keeps the ones it opened with) and an admin's cancel with full refunds
    (POST /api/casino/sng/:id/cancel, in the admin log as casino_sng_cancel). Audited like the other casino settings (casino_settings.actor). %>
<section class="adm-card" id="casino-sng" aria-labelledby="casinoSngT">
  <h2 id="casinoSngT">🏁 Sit &amp; Go <span class="adm-pill admin">admins</span></h2>
  <% if (!_can('casino.admin') || !locals.casino) { %><p class="adm-help">Admins only.</p><% } else { const _c = locals.casino; %>
  <p class="adm-help">One-table Hold'em tournaments: everyone pays the same entry (buy-in + the fee, held in escrow), plays tournament chips (not PAT), and the finish pays the prizes and the fee to the House in one move. Needs Hold'em on the site on (now <b><%= _c.hm_enabled ? 'on' : 'off' %></b>). Changes apply to sit &amp; gos opened after them.</p>
  <%# h22 review: /casino/holdem (the web lobby with the Sit & Go section + its Create sheet) redirects to Pepe's tables while the Hold'em front is "pepe" %>
  <% if (_c.hm_front === 'pepe') { %><p class="adm-help" id="sngFront"><b>Heads-up:</b> the Hold'em front end is set to <b>pepe</b> (Casino front end, above), so the web lobby /casino/holdem, where the Sit &amp; Go section and its Create sheet are, sends people to Pepe's tables instead. Set the Hold'em front to <b>auto</b> or <b>patv</b> for it; a sit &amp; go's own table page works either way.</p><% } %>
  <form id="sngForm" class="adm-form">
    <label>Who can play
      <select name="casino_sng"><% ['off', 'staff', 'everyone'].forEach((v) => { %><option value="<%= v %>"<%= _c.casino_sng === v ? ' selected' : '' %>><%= v %></option><% }) %></select>
    </label>
    <% [['sng_fee_pct', 'Fee (% of the buy-in, to the House)'], ['sng_buyins', 'Buy-ins (PAT, comma-separated)'], ['sng_payouts', 'Payouts % for 2-3 | 4-6 | 7-9 players'],
        ['sng_levels', 'Blind levels (sb/bb, comma-separated; then x1.5)'], ['sng_level_mins', 'Level length (minutes)'], ['sng_turbo_mins', 'Turbo level length (minutes)']].forEach(([key, label]) => { %>
    <label><%= label %><input name="<%= key %>" value="<%= _c[key] %>" required autocomplete="off" spellcheck="false"></label>
    <% }) %>
    <button type="submit">Save Sit &amp; Go settings</button><span id="sngStatus" role="status"></span>
  </form>
  <h3>Open sit &amp; gos</h3>
  <div id="sngList" class="adm-help">Loading…</div>
  <script>
  (function () {
    var form = document.getElementById('sngForm');
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var status = document.getElementById('sngStatus');
      try {
        for (var input of form.querySelectorAll('[name]')) {
          var r = await fetch('/api/casino/admin/settings', {method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json','X-Requested-With':'fetch'}, body:JSON.stringify({key:input.name,value:input.value})});
          var j = await r.json(); if (!j.ok) throw new Error(input.name + ': ' + (j.error || 'Save failed'));
          if (j.settings && j.settings[input.name] !== undefined) input.value = j.settings[input.name];
        }
        status.textContent = 'Saved';
      } catch (err) { status.textContent = err.message || 'Save failed'; }
    });
    var box = document.getElementById('sngList');
    function esc(x) { return String(x == null ? '' : x).replace(/[&<>"']/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
    async function load() {
      try {
        var j = await (await fetch('/api/casino/sng', {credentials:'same-origin', cache:'no-store'})).json();
        var rows = (j.list || []).filter(function (r) { return r.status === 'registering' || r.status === 'running' || r.status === 'settling'; });
        if (!rows.length) { box.textContent = 'None open.'; return; }
        box.innerHTML = rows.map(function (r) {
          return '<div class="adm-actions"><a href="/casino/holdem/t/' + esc(r.id) + '"><code>#' + esc(r.short) + '</code></a> ' + esc(r.size) + ' seats · ' +
            esc(r.entry.toLocaleString()) + ' PAT entry · ' + esc(r.status) + ' · ' + esc(r.registered) + ' registered' +
            (r.status === 'settling' ? '' : ' <button type="button" class="adm-btn ghost" data-cancel="' + esc(r.id) + '">Cancel (refund everyone)</button>') + '</div>';
        }).join('');
      } catch (err) { box.textContent = 'Couldn\'t load them.'; }
    }
    box.addEventListener('click', async function (e) {
      var b = e.target.closest('button[data-cancel]');
      if (!b) return;
      var why = prompt('Cancel this sit & go? Every entry is refunded in full (buy-in and fee). Reason for the admin log:');
      if (why === null) return;
      b.disabled = true;
      var idem = 'adm-' + Date.now() + '-' + Math.random().toString(16).slice(2, 10);
      var r = await fetch('/api/casino/sng/' + encodeURIComponent(b.dataset.cancel) + '/cancel', {method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json','X-Requested-With':'fetch'}, body:JSON.stringify({idem:idem, reason:why})});
      var j = await r.json().catch(function () { return {}; });
      alert(j.reply || j.error || (j.ok ? 'Cancelled.' : 'That did not work.'));
      load();
    });
    load();
  })();
  </script>
  <% } %>
</section>
<%- include('../partials/admin-heistmarket', { t, isAdmin: _can('games.config'), hm: locals.hm }) %>
<%- include('../partials/admin-pvpcfg', { isAdmin: _can('games.config') }) %>
<%- include('../partials/admin-spincfg', { isAdmin: _can('games.config') }) %>
<%- include('../partials/admin-roomwars', { isAdmin: _can('games.config') }) %>
<script src="/public/js/admin-panel.js?v=6" defer></script>
<%- include('../partials/admin-close') %>
</body>
</html>
