<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%- include('layout', { title: 'Cosmetics', user: user }) %>
<%- include('partials/cosmetics-css') %>
<%
  const fmt = (n) => Math.floor(Number(n) || 0).toLocaleString('en-US');
  const RC = (r) => (rarities[r] && rarities[r].color) || '#bbb';
  const kindLabel = (k) => (kinds[k] && kinds[k].label) || k;
  const kindEmoji = (k) => (kinds[k] && kinds[k].emoji) || '🎨';
  const avSeed = (me && seed) || 7;
  const myName = me ? me.display : 'Your Name';
  const myAvatar = me ? me.avatar : '/public/img/avatar.png';
  const srcText = (it) => {
    const out = [];
    const s = it.source || [];
    if (s.includes('shop')) out.push('Shop');
    if (s.includes('season') && it.season) out.push(it.season.label);
    if (s.includes('achievement') && it.unlock && it.unlock.achievement) out.push('Achievement unlock');
    if (s.includes('level') && it.unlock && it.unlock.level) out.push('Level ' + it.unlock.level);
    if (s.includes('drop')) out.push((it.drop_events || []).includes('bounty') ? 'Bounty drop' : 'Game drop');
    return out.join(' · ');
  };
  // What the item is and where it shows (data-driven from the catalog's kinds/tags), plus its set.
  const kindGroup = (k) => (kinds[k] && kinds[k].group) || (String(k).startsWith('gtf_') ? 'GTF avatar' : 'Profile');
  const kindSlot = (k) => (kinds[k] && kinds[k].slot) || kindLabel(k);
  const typeText = (k) => kindGroup(k) + ' · ' + kindSlot(k);
  const whereText = (k) => kindGroup(k) === 'GTF avatar' ? 'Worn by your Grand Theft Frogger pixel avatar (heist sheets, stream overlay)' : 'Shows on your PATV profile' + (k === 'name_color' ? ' and the rankings' : '');
  const seasonEmoji = (label) => /winter/i.test(label) ? '❄️' : /pride/i.test(label) ? '🏳️‍🌈' : /hallowe/i.test(label) ? '🎃' : '📅';
  const fmtDay = (ms) => { const d = new Date(ms); return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC', ...(d.getUTCFullYear() !== new Date(now).getUTCFullYear() ? { year: 'numeric' } : {}) }); };
  const itemTags = (it) => (it && Array.isArray(it.tags) ? it.tags : []).filter((t) => tags[t]);
  const chips = (it) => {
    if (!it) return;
    const st = it.season ? (it.seasonState || seasonStateOf(it, now)) : null; %>
    <div class="cxp-chips">
      <span class="cxp-chip cxp-chip-type <%= kindGroup(it.kind) === 'GTF avatar' ? 'gtf' : 'prof' %>" title="<%= whereText(it.kind) %>"><span class="ds-ic" aria-hidden="true"><%= kindEmoji(it.kind) %></span><%= typeText(it.kind) %></span>
      <% if (it.season) { const lastDay = dayMs(it.season.to) - 86400000; %>
        <span class="cxp-chip cxp-chip-season <%= st %>" title="<%= it.season.label %> set">
          <span class="ds-ic" aria-hidden="true"><%= seasonEmoji(it.season.label) %></span><%= it.season.label %> ·
          <%= st === 'active' ? 'available until ' + fmtDay(lastDay) : st === 'upcoming' ? 'arrives ' + fmtDay(dayMs(it.season.from)) : 'season ended' %>
        </span>
      <% } %>
      <% itemTags(it).forEach((t) => { %><span class="cxp-chip cxp-chip-tag tag-<%= t %>"><span class="ds-ic" aria-hidden="true"><%= tags[t].emoji %></span><%= tags[t].label %></span><% }) %>
    </div>
<% };
  const fAttrs = (it) => `data-kind="${it.kind}" data-group="${kindGroup(it.kind)}" data-tags="${itemTags(it).join(' ')}"`;
  const left = (ms) => { const s = Math.max(0, Math.round((ms - now) / 1000)); const d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60); return d ? `${d}d ${h}h` : h ? `${h}h ${m}m` : `${m}m`; };
%>
<%
  // A small profile card showing a combination of account cosmetics (each argument a render object or null).
  const mini = (o) => { %>
  <div class="cxp-mini cx-host">
    <% if (o.banner) { %><div class="cx-banner" style="<%= o.banner.css %>"></div><% } %>
    <% if (o.effect) { %><div class="cx-fx cx-fx-<%= o.effect.effect %>" aria-hidden="true"></div><% } %>
    <div class="cxp-mini-body">
      <span class="cx-av">
        <% if (o.deco && o.deco.conic) { %><span class="cx-conic<%= o.deco.spin ? ' cx-spin' : '' %>" style="<%= o.deco.conic %>"></span><% } %>
        <img class="cxp-mini-av" src="<%= myAvatar %>" alt="" onerror="this.src='/public/img/avatar.png'" style="<%= o.deco ? o.deco.ring : '' %>">
        <% if (o.deco && o.deco.emoji) { %><span class="cx-emoji" style="font-size:15px;top:-5px;right:-7px"><%= o.deco.emoji %></span><% } %>
      </span>
      <b class="cxp-mini-name"><% if (o.name) { %><span class="cx-name" style="<%= o.name.css %>"><%= myName %></span><% } else { %><%= myName %><% } %></b>
    </div>
    <% if (o.border) { %><div class="cx-frame <%= o.border.cls %>" style="<%= o.border.css %>"></div><% } %>
  </div>
<% };
  const gtfBox = (layers, size) => { %>
  <span class="cx-gtf cxp-gtf" data-seed="<%= avSeed %>" data-size="<%= size %>" data-layers="<%= JSON.stringify(layers) %>"
        style="width:<%= size %>px;height:<%= size %>px"><span class="cxp-gtf-fb"><%= Object.values(layers).length ? '' : '🐸' %></span></span>
<% };
  const preview = (r) => {
    if (!r) return;
    if (r.kind === 'name_color') { %><div class="cxp-prev cxp-prev-name"><span class="cx-name" style="<%= r.css %>"><%= myName %></span></div><% }
    else if (r.kind === 'profile_border') { mini({ border: r }); }
    else if (r.kind === 'profile_banner') { mini({ banner: r }); }
    else if (r.kind === 'profile_effect') { mini({ effect: r }); }
    else if (r.kind === 'avatar_decoration') { %>
      <div class="cxp-prev"><span class="cx-av">
        <% if (r.conic) { %><span class="cx-conic<%= r.spin ? ' cx-spin' : '' %>" style="<%= r.conic %>"></span><% } %>
        <img class="cxp-av" src="<%= myAvatar %>" alt="" onerror="this.src='/public/img/avatar.png'" style="<%= r.ring %>">
        <% if (r.emoji) { %><span class="cx-emoji"><%= r.emoji %></span><% } %>
      </span></div>
    <% } else if (r.layer) { %>
      <div class="cxp-prev"><span class="cxp-gtfwrap"><% gtfBox({ [r.opt]: r.layer }, 72) %><span class="cxp-layer-emoji" title="<%= r.layer %>"><%= r.emoji %></span></span></div>
    <% }
  };
  const itemCard = (it) => { %>
  <div class="cxp-card" style="--rc: <%= RC(it.rarity) %>" <%- fAttrs(it) %>>
    <% preview(it.r) %>
    <div class="cxp-title"><b><%= it.name %></b><span class="cxp-rar"><%= it.rarity %></span></div>
    <% chips(it) %>
    <div class="cxp-desc"><%= it.desc %></div>
    <div class="cxp-src"><%= srcText(it) %><% if (it.unlock && it.unlock.achievement) { %>: <a href="/achievements"><%= achName[it.unlock.achievement] || it.unlock.achievement %></a><% } %></div>
    <% if (it.sale) { %>
      <div class="cxp-price"><%= fmt(it.price) %> PAT</div>
      <% if (me) { %>
        <form method="POST" action="/cosmetics/act" class="cxp-row">
          <input type="hidden" name="op" value="buy"><input type="hidden" name="item" value="<%= it.id %>"><input type="hidden" name="tab" value="shop">
          <button class="ds-btn gold sm" type="submit">Buy</button>
        </form>
        <details class="cxp-more"><summary><span class="ds-ic" aria-hidden="true">🎁</span>Gift a new one</summary>
          <form method="POST" action="/cosmetics/act" class="cxp-row">
            <input type="hidden" name="op" value="gift"><input type="hidden" name="item" value="<%= it.id %>"><input type="hidden" name="tab" value="shop">
            <input class="ds-in" name="to" placeholder="Camfrog name or username" required maxlength="60" aria-label="Gift to">
            <label class="cxp-anon"><input type="checkbox" name="anon" value="1"> <%- t('gifts.anon.box_short') %></label>
            <button class="ds-btn ghost sm" type="submit">Gift</button>
          </form>
        </details>
      <% } else { %><div class="cxp-muted"><a href="/login">Sign in</a> to buy.</div><% } %>
    <% } else if (it.perk === 'season_pass') { %>
      <div class="cxp-muted"><span class="ds-ic" aria-hidden="true">🎟️</span> Comes with the <a href="/premium">Season Pass</a></div>
    <% } else if (it.perk === 'plex') { %>
      <div class="cxp-muted"><%- t('cos.plex_perk', { link: '<a href="/subscriptions">' + t('cos.plex_perk_link') + '</a>' }) %></div>
    <% } else if (it.seasonState === 'upcoming') { %>
      <div class="cxp-price"><%= fmt(it.price) %> PAT</div><div class="cxp-muted">On sale in <span class="cx-cd" data-to="<%= it.seasonStart %>"><%= left(it.seasonStart) %></span></div>
    <% } else if (it.seasonState === 'over') { %>
      <div class="cxp-muted">Season over — find one on the <a href="/cosmetics?tab=market#tabs">market</a>.</div>
    <% } else if (it.unlock && it.unlock.level) { %>
      <div class="cxp-muted"><span class="ds-ic" aria-hidden="true">🔓</span> Free at level <%= it.unlock.level %><%= me && me.level >= it.unlock.level ? ' — yours!' : '' %></div>
    <% } else if (it.unlock && it.unlock.achievement) { %>
      <div class="cxp-muted"><span class="ds-ic" aria-hidden="true">🔓</span> Free with the achievement</div>
    <% } else { %>
      <div class="cxp-muted"><span class="ds-ic" aria-hidden="true">🎲</span> <%= (it.drop_events || []).includes('bounty') ? 'Drops from completed bounties' : 'Drops from heists, the arena, bingo and bounties' %> — or buy one on the market.</div>
    <% } %>
  </div>
<% }; %>
<%
  const filterBar = () => { %>
    <div class="cxp-filter" data-filter>
      <div class="cxp-frow"><span class="cxp-flabel">Type</span>
        <button type="button" class="ds-tab on" data-ftype="">All</button>
        <button type="button" class="ds-tab" data-ftype="group:Profile">👤 Profile</button>
        <button type="button" class="ds-tab" data-ftype="group:GTF avatar">🐸 GTF avatar</button>
        <% if (typeof padCat !== 'undefined' && padCat.length) { %><button type="button" class="ds-tab" data-ftype="group:Pad">🛋️ Pad</button><% } %>
        <select class="ds-select" data-fkind aria-label="Filter by slot">
          <option value="">Any slot</option>
          <% Object.keys(kinds).forEach((k) => { %><option value="<%= k %>"><%= kindEmoji(k) %> <%= typeText(k) %></option><% }) %>
        </select>
      </div>
      <div class="cxp-frow"><span class="cxp-flabel">Style</span>
        <button type="button" class="ds-tab on" data-ftag="">All</button>
        <% Object.keys(tags).forEach((t) => { %><button type="button" class="ds-tab" data-ftag="<%= t %>"><%= tags[t].emoji %> <%= tags[t].label %></button><% }) %>
        <label class="cxp-fhide"><input type="checkbox" data-fhidekink> Hide kink items</label>
      </div>
    </div>
<% }; %>
<style>
  /* /cosmetics: catalogue + locker. Block flow (.ds-page.flow); section headings are .ds-h2 (one style). Rarity = --rc (from the catalog). */
  .cxp .ds-head { margin-block-end: var(--ds-sp-5); }
  .cxp .ds-head .ds-h1 { display: flex; align-items: center; gap: var(--ds-sp-2h); }
  .cxp .ds-head .ds-sub { max-width: 70ch; font-size: var(--ds-fs-body); color: var(--ds-text-2); }
  .cxp h2.ds-h2 { margin: var(--ds-sp-7) 0 var(--ds-sp-3); scroll-margin-top: 80px; }
  .cxp-h2where { font: 400 var(--ds-fs-meta)/1.4 var(--ds-font); color: var(--ds-text-muted); }
  .cxp .tabs { margin-block: var(--ds-sp-4) var(--ds-sp-3); scroll-margin-top: 80px; }
  .cxp .tabs .ds-tab { font-size: var(--ds-fs-sm); }
  .cxp .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: var(--ds-sp-3); }

  /* 1.99ta: 🧸 Stickers tab */
  .cxp .cxs h2.ds-h2 { margin-block: var(--ds-sp-5) var(--ds-sp-2); }
  .cxs > p, .cxs > .ds-note { margin: 0 0 var(--ds-sp-3); }
  .cxs > .cxp-muted:last-child { margin-block-start: var(--ds-sp-4); }
  .cxs-msg:empty { display: none; }
  .cxs-sheet { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .cxs-sheet img { width: 100%; height: auto; aspect-ratio: 1; image-rendering: pixelated; background: var(--ds-sunken); border-radius: var(--ds-r-sm); padding: 4px; box-sizing: border-box; }
  .cxs-pack.owned { border-color: var(--ds-ac-line); }
  a.cxs-perk { text-decoration: none; min-height: 28px; }
  a.cxs-perk:hover, a.cxs-perk:focus-visible { border-color: var(--ds-ac-2); }
  .cxs-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }

  /* item card */
  .cxp-card { background: var(--ds-surface); border: 1px solid var(--ds-line); border-block-start: 3px solid var(--rc); border-radius: var(--ds-r-xl); padding: var(--ds-sp-3);
              display: grid; gap: var(--ds-sp-2); align-content: start; min-width: 0; }
  .cxp-title { display: flex; justify-content: space-between; align-items: center; gap: var(--ds-sp-2); min-width: 0; }
  .cxp-title b { color: var(--ds-text-strong); font-size: var(--ds-fs-h4); line-height: 1.3; min-width: 0; }
  .cxp-rar { flex: none; font: 700 10.5px/1.6 var(--ds-font); text-transform: uppercase; letter-spacing: var(--ds-ls-chip); color: var(--rc); border: 1px solid var(--rc); border-radius: var(--ds-r-pill); padding: 0 8px; white-space: nowrap; }
  .cxp-desc { font-size: var(--ds-fs-meta); color: var(--ds-text-2); line-height: 1.45; }
  .cxp-src { font-size: var(--ds-fs-xs); color: var(--ds-text-faint); }
  .cxp-price { font-size: var(--ds-fs-num); font-weight: 700; color: var(--ds-gold-text); font-variant-numeric: tabular-nums; }
  .cxp-muted { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); line-height: 1.5; }
  .cxp-row { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2); margin: 0; align-items: center; }
  .cxp-row .ds-in.ds-in { flex: 1 1 140px; width: auto; min-height: 40px; font-size: var(--ds-fs-sm); }
  .cxp-row .ds-btn { flex: none; }
  .cxp-anon { display: inline-flex; align-items: center; gap: 6px; font-size: var(--ds-fs-meta); color: var(--ds-text-2); min-height: 36px; cursor: pointer; }
  .cxp-anon input { width: 18px; height: 18px; margin: 0; accent-color: var(--ds-ac); }
  .cxp-more summary { display: flex; align-items: center; gap: 6px; min-height: 36px; cursor: pointer; font-size: var(--ds-fs-meta); color: var(--ds-text-2); border-radius: var(--ds-r-xs); }
  .cxp-more summary:hover { color: var(--ds-text-strong); }
  .cxp-more[open] summary { margin-block-end: 6px; }

  /* item chips: what it is + where it shows, its season, style tags */
  .cxp-chips { display: flex; flex-wrap: wrap; gap: 4px; min-width: 0; }
  .cxp-chip { display: inline-flex; align-items: center; gap: 4px; font: 500 11px/1.6 var(--ds-font); padding: 1px 8px; border-radius: var(--ds-r-pill); border: 1px solid var(--ds-line-strong); color: #ccc; background: #161616; white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
  .cxp-chip .ds-ic { font-size: 11px; width: 13px; height: 13px; }
  .cxp-chip-type.prof { border-color: var(--ds-info-line); color: var(--ds-info); background: #0f1a22; }
  .cxp-chip-type.gtf { border-color: var(--ds-green-line); color: var(--ds-ok); background: #0f1a10; }
  .cxp-chip-type.pad { border-color: var(--ds-warn-line); color: var(--ds-warn); background: #1d150a; }
  .cxp-pad .pc-pv { width: 100%; }
  .cxp-chip-season { border-color: var(--ds-warn-line); color: #ffcc80; background: #1d150a; white-space: normal; text-overflow: clip; border-radius: var(--ds-r-md); }
  .cxp-chip-season.upcoming { border-color: #4a4a6a; color: #c5cae9; background: #12121d; }
  .cxp-chip-season.over { border-color: #444; color: var(--ds-text-muted); background: #151515; }
  .cxp-chip-tag { color: var(--ds-text); }
  .cxp-chip-tag.tag-pride { border-color: #7a4a8a; }
  .cxp-chip-tag.tag-camp { border-color: #8a3a6a; }
  .cxp-chip-tag.tag-cute { border-color: #8a5a72; }
  .cxp-chip-tag.tag-kink { border-color: #5a2a2a; }

  /* previews (the cosmetic itself is styled by partials/cosmetics-css) */
  .cxp-prev { min-height: 86px; display: grid; place-items: center; background: var(--ds-sunken); border: 1px solid var(--ds-line-soft); border-radius: var(--ds-r-lg); padding: var(--ds-sp-2); }
  .cxp-prev-name { font-size: 20px; font-weight: 700; text-align: center; }
  .cxp-av { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; border: 3px solid var(--ds-green); background: var(--ds-sunken); }
  .cxp-mini { height: 86px; background: radial-gradient(120% 140% at 0% 0%, #17301a 0%, #111 55%); border: 1px solid var(--ds-line); border-radius: var(--ds-r-lg); overflow: hidden; }
  .cxp-mini .cx-banner { position: absolute; top: 0; inset-inline: 0; height: 34px; margin: 0; border-radius: 11px 11px 0 0; }
  .cxp-mini-body { display: flex; align-items: center; gap: var(--ds-sp-2h); padding: 26px var(--ds-sp-3) 0; min-width: 0; }
  .cxp-mini-av { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid var(--ds-green); background: var(--ds-sunken); }
  .cxp-mini-name { font-size: var(--ds-fs-h4); color: var(--ds-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .cxp-gtfwrap { position: relative; display: inline-block; }
  .cxp-gtf { display: inline-grid; place-items: center; background: #151515; border-radius: var(--ds-r-sm); font-size: 34px; }
  .cxp-layer-emoji { position: absolute; inset-inline-end: -10px; bottom: -6px; font-size: 20px; line-height: 1; }

  /* seasonal sets */
  .cxp .season { background: linear-gradient(135deg, #1d1230, var(--ds-surface) 60%); border: 1px solid #3a2a55; border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); margin: var(--ds-sp-4) 0; }
  .cxp .season.winter { background: linear-gradient(135deg, #0f2233, var(--ds-surface) 60%); border-color: #26475f; }
  .cxp .season.pride { background: linear-gradient(135deg, rgba(228, 3, 3, .16), rgba(255, 237, 0, .08) 30%, rgba(0, 77, 255, .1) 60%, var(--ds-surface) 85%); border-color: #5a3a6a; }
  .cxp .season-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px var(--ds-sp-3h); align-items: center; margin-block-end: var(--ds-sp-3); }
  .cxp .season-head b { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; font-size: var(--ds-fs-h3); color: var(--ds-text-strong); }
  .cxp .season-head b .cxp-muted { font-weight: 400; }
  .cxp .cd { color: var(--ds-gold-text); font-variant-numeric: tabular-nums; }

  /* how-you-get-items strip */
  .cxp .howstrip { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: var(--ds-sp-2); margin: 0 0 var(--ds-sp-3); }
  .cxp .howstrip div { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-lg); padding: var(--ds-sp-3); font-size: var(--ds-fs-meta); line-height: 1.45; color: var(--ds-text-muted); min-width: 0; }
  .cxp .howstrip b { display: flex; align-items: center; gap: 6px; color: var(--ds-text-strong); font-size: var(--ds-fs-sm); margin-block-end: 4px; }

  /* filters (shop + market) */
  .cxp-filter { display: grid; gap: var(--ds-sp-2); background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-3); margin: var(--ds-sp-3) 0 var(--ds-sp-2); }
  .cxp-frow { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: var(--ds-fs-meta); }
  .cxp-flabel { font: 700 var(--ds-fs-chip)/1.3 var(--ds-font); letter-spacing: var(--ds-ls-label); text-transform: uppercase; color: var(--ds-text-muted); min-width: 44px; }
  .cxp-filter .ds-tab { margin: 0; }
  .cxp-filter .ds-select.ds-select { width: auto; max-width: 100%; min-height: 36px; padding-block: 6px; font-size: var(--ds-fs-meta); border-radius: var(--ds-r-pill); }
  .cxp-fhide { color: var(--ds-text-2); display: inline-flex; gap: 6px; align-items: center; margin-inline-start: auto; min-height: 36px; cursor: pointer; }
  .cxp-fhide input { width: 18px; height: 18px; margin: 0; accent-color: var(--ds-ac); }
  [data-fhid] { display: none !important; }
  .cxp .cxp-fempty { margin-block-start: var(--ds-sp-4); }

  /* market */
  .cxp .sortbar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: var(--ds-sp-3) 0; }
  .cxp .sortbar .cxp-flabel { min-width: 0; margin-inline-end: 4px; }

  /* my items */
  .cxp .inv { display: grid; gap: var(--ds-sp-2h); }
  .cxp .copy { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: var(--ds-sp-3); background: var(--ds-surface); border: 1px solid var(--ds-line); border-inline-start: 3px solid var(--rc); border-radius: var(--ds-r-xl); padding: var(--ds-sp-3); align-items: start; }
  .cxp .copy .cxp-prev { min-height: 70px; padding: 4px; }
  .cxp .copy .cxp-mini { height: 70px; }
  .cxp .copy .cxp-mini-body { padding-block-start: 18px; }
  .cxp .copy-meta { display: grid; gap: 6px; min-width: 0; }
  .cxp .copy-name { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .cxp .copy-name > b { color: var(--ds-text-strong); font-size: var(--ds-fs-h4); }
  .cxp .tag { display: inline-flex; align-items: center; font: 700 11px/1.6 var(--ds-font); padding: 0 8px; border-radius: var(--ds-r-pill); border: 1px solid var(--ds-line-strong); color: #ccc; white-space: nowrap; }
  .cxp .tag.rar { color: var(--rc); border-color: var(--rc); text-transform: uppercase; letter-spacing: var(--ds-ls-chip); font-size: 10.5px; }
  .cxp .tag.eq { border-color: var(--ds-ok-line); color: var(--ds-ok); background: var(--ds-ok-bg); }
  .cxp .tag.ls { border-color: var(--ds-warn-line); color: var(--ds-warn); background: var(--ds-warn-bg); }
  .cxp .look { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--ds-sp-4); align-items: center; background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); }
  .cxp .look .cxp-muted { margin-block-end: var(--ds-sp-2); }
  .cxp .stk-packs { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2h); }
  .cxp .stk-pack { display: grid; gap: 6px; max-width: 280px; padding: var(--ds-sp-3); background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); }
  .cxp .stk-pack b { color: var(--ds-text); }
  .cxp .stk-pack span { display: flex; gap: 4px; flex-wrap: wrap; }
  .cxp .stk-pack img { image-rendering: pixelated; }
  .cxp .stk-foot { margin-block-start: var(--ds-sp-2); }

  /* showcase picker */
  .cxp .badgepick { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 120px), 1fr)); gap: var(--ds-sp-2); margin-block: var(--ds-sp-3); }
  .cxp .badgepick label { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-lg); padding: var(--ds-sp-2h) var(--ds-sp-2); text-align: center; display: grid; gap: 6px; justify-items: center; cursor: pointer; font-size: var(--ds-fs-xs); color: var(--ds-text-2); }
  .cxp .badgepick label:hover { border-color: var(--ds-line-strong); }
  .cxp .badgepick label:has(input:checked) { border-color: var(--ds-gold); background: var(--ds-gold-bg); color: var(--ds-text-strong); }
  .cxp .badgepick label:focus-within { box-shadow: var(--ds-focus-ring); }
  .cxp .badgepick input { width: 18px; height: 18px; margin: 0; accent-color: var(--ds-gold); }
  .cxp .badgepick img { width: 40px; height: 40px; object-fit: contain; image-rendering: pixelated; }

  .cxp .ds-note { margin: var(--ds-sp-3) 0; }
  .cxp .ds-empty { margin-block: var(--ds-sp-4); }
  .cxp .ds-empty p { margin: 0; color: var(--ds-text-muted); }
  .cxp .how { max-width: 76ch; }
  .cxp .how p, .cxp .how li { line-height: 1.6; color: var(--ds-text-2); }
  .cxp .how li + li { margin-block-start: var(--ds-sp-2); }
  .cxp .how ul { padding-inline-start: 1.2em; }
  @media (max-width: 520px) {
    .cxp .copy { grid-template-columns: 1fr; }
    .cxp .look { grid-template-columns: 1fr; justify-items: center; }
    .cxp .look > div { width: 100%; }
    .cxp-fhide { margin-inline-start: 0; }
    .cxp-row .ds-in.ds-in { font-size: 16px; flex-basis: 100%; }
    .cxp .season { padding: var(--ds-sp-3); }
  }
</style>
<main class="ds-page flow cxp">
  <div class="ds-head">
    <h1 class="ds-h1"><span class="ds-ic" aria-hidden="true">🎨</span> Cosmetics</h1>
    <p class="ds-sub">Look the part. Name colors, profile banners, borders, effects and avatar decorations for your PATV profile, plus gear for your Grand Theft Frogger pixel avatar. Every item is a real copy you own — equip it, gift it, or sell it to another player.</p>
  </div>

  <%- include('partials/actions', { acts, msg }) %>
  <% if (me && !me.camfrog) { %>
    <div class="ds-note warn"><span class="ds-ic" aria-hidden="true">⚠️</span><div>Buying and gifting new items runs through Pepe as your linked chat name — <a href="/u/<%= me.username %>/edit">link a chat account</a> (Connections) first. Equipping, listing and gifting items you already own work without it.</div></div>
  <% } %>

  <nav class="ds-tabs tabs" id="tabs" aria-label="Cosmetics sections">
    <a href="/cosmetics?tab=shop#tabs" class="ds-tab<%= tab === 'shop' ? ' on' : '' %>"<%- tab === 'shop' ? ' aria-current="page"' : '' %>><span class="ds-ic" aria-hidden="true">🛍️</span> Shop</a>
    <%# 1.99ta: 🧸 sticker packs (stickers.js) for sale here too, not only on /premium %>
    <a href="/cosmetics?tab=stickers#tabs" class="ds-tab<%= tab === 'stickers' ? ' on' : '' %>"<%- tab === 'stickers' ? ' aria-current="page"' : '' %>><span class="ds-ic" aria-hidden="true">🧸</span> <%- t('cos.stk.tab') %></a>
    <a href="/cosmetics?tab=market#tabs" class="ds-tab<%= tab === 'market' ? ' on' : '' %>"<%- tab === 'market' ? ' aria-current="page"' : '' %>><span class="ds-ic" aria-hidden="true">🏪</span> Market<% if (listings.length) { %> <span class="ds-count"><%= listings.length %></span><% } %></a>
    <a href="/cosmetics?tab=mine#tabs" class="ds-tab<%= tab === 'mine' ? ' on' : '' %>"<%- tab === 'mine' ? ' aria-current="page"' : '' %>><span class="ds-ic" aria-hidden="true">🎒</span> My items<% if (inv) { %> <span class="ds-count"><%= inv.count %></span><% } %></a>
    <a href="/cosmetics?tab=showcase#tabs" class="ds-tab<%= tab === 'showcase' ? ' on' : '' %>"<%- tab === 'showcase' ? ' aria-current="page"' : '' %>><span class="ds-ic" aria-hidden="true">🏅</span> Showcase</a>
    <a href="/cosmetics?tab=how#tabs" class="ds-tab<%= tab === 'how' ? ' on' : '' %>"<%- tab === 'how' ? ' aria-current="page"' : '' %>><span class="ds-ic" aria-hidden="true">❓</span> How it works</a>
  </nav>

  <% if (tab === 'shop') { %>
    <div class="howstrip">
      <div><b><span class="ds-ic" aria-hidden="true">🛍️</span>Shop</b>Buy with PAT — Pepe charges you.</div>
      <div><b><span class="ds-ic" aria-hidden="true">🎲</span>Drops</b>Heists, the arena, bingo and completed bounties can drop GTF gear.</div>
      <div><b><span class="ds-ic" aria-hidden="true">🏅</span>Unlocks</b>Achievements and levels 10 / 25 / 50 give free items.</div>
      <div><b><span class="ds-ic" aria-hidden="true">🏪</span>Trade</b>Sell or buy copies on the market (<%= fee %>% fee).</div>
    </div>
    <% filterBar() %>

    <% seasons.forEach((s) => { %>
      <section class="season <%= /winter/i.test(s.label) ? 'winter' : /pride/i.test(s.label) ? 'pride' : '' %> cxp-fsec">
        <div class="season-head">
          <b><span class="ds-ic" aria-hidden="true"><%= seasonEmoji(s.label) %></span><%= s.label %> <span class="cxp-muted">· seasonal set</span></b>
          <% if (s.state === 'active') { %>
            <span class="cxp-muted">Limited — leaves the shop in <span class="cd cx-cd" data-to="<%= s.to %>"><%= left(s.to) %></span></span>
          <% } else { %>
            <span class="cxp-muted">Arrives in <span class="cd cx-cd" data-to="<%= s.from %>"><%= left(s.from) %></span></span>
          <% } %>
        </div>
        <div class="grid">
          <% s.items.forEach((it) => { itemCard({ ...it, seasonState: s.state, seasonStart: s.from }); }) %>
        </div>
      </section>
    <% }) %>

    <% Object.keys(byKind).forEach((k) => { const list = byKind[k].filter((it) => !it.season || it.seasonState === 'over'); if (!list.length) return; %>
      <section class="cxp-fsec">
        <h2 class="ds-h2" id="k-<%= k %>"><span class="ds-ic lg" aria-hidden="true"><%= kindEmoji(k) %></span><%= kindLabel(k) %> <span class="cxp-h2where"><%= kindGroup(k) === 'GTF avatar' ? 'on your GTF pixel avatar' : 'on your profile' %></span></h2>
        <div class="grid">
          <% list.forEach((it) => { itemCard(it); }) %>
        </div>
      </section>
    <% }) %>
    <%# 1.99ew: premium PAD cosmetics (padcosmetics.js): they belong to a pad - bought from its ⚙ settings (owner) or gifted from its page %>
    <% if (typeof padCat !== 'undefined' && padCat.length) {
         const PSLOT = { pad_frame: ['🖼️', 'Banner frame'], pad_glow: ['✨', 'Name glow'], pad_badge: ['🏷️', 'Pad badge'], pad_avatar: ['🎞️', 'Animated avatar'] }; %>
      <link rel="stylesheet" href="/public/css/padfx.css?v=4">
      <section class="cxp-fsec cxp-pad">
        <h2 class="ds-h2" id="k-pad"><span class="ds-ic lg" aria-hidden="true">🛋️</span>Pad cosmetics <span class="cxp-h2where">on a pad — its header, its /p card and Top Pads</span></h2>
        <p class="cxp-muted">These belong to a <b>pad</b>, not to you. A pad's owner buys them from <b>⚙ Pad settings → General → ✨ Cosmetics</b> (100% to Fort Knox); anyone can <b>🎁 gift</b> one from a pad's page (half to Fort Knox, half to that pad's vault). The owner can equip or decline a gift — no refunds.</p>
        <div class="grid">
          <% padCat.forEach((it) => { const st = it.style || {}; const sl = PSLOT[it.kind] || ['🛋️', it.kind]; %>
            <div class="cxp-card" style="--rc: <%= RC(it.rarity) %>" data-kind="<%= it.kind %>" data-group="Pad" data-tags="">
              <div class="cxp-prev"><div class="pc-pv<%= it.kind === 'pad_frame' ? ' pfx pfx-f-' + st.fx : '' %>" aria-hidden="true"><% if (it.kind === 'pad_frame') { %><span class="pfx-l"></span><% } %>
                <div class="pc-pv-in"><span class="pc-pv-av<%= it.kind === 'pad_avatar' ? ' pc-anim' : '' %>"><%= it.kind === 'pad_avatar' ? '🎞️' : 'P' %></span>
                  <b class="pc-pv-n<%= it.kind === 'pad_glow' ? ' pfx-g pfx-g-' + st.fx : '' %>">Your pad</b>
                  <% if (it.kind === 'pad_badge') { %><span class="pfx-bs"><span class="pfx-b"><% if (st.icon) { %><span aria-hidden="true"><%= st.icon %></span><% } %><%= st.text %></span></span><% } %></div></div></div>
              <div class="cxp-title"><b><%= it.name %></b><span class="cxp-rar"><%= it.rarity %></span></div>
              <div class="cxp-chips"><span class="cxp-chip cxp-chip-type pad"><span class="ds-ic" aria-hidden="true"><%= sl[0] %></span>Pad · <%= sl[1] %></span><% if (it.animated) { %><span class="cxp-chip">animated</span><% } %><% if (it.season) { %><span class="cxp-chip cxp-chip-season"><%= it.season.label %></span><% } %></div>
              <div class="cxp-desc"><%= it.desc %></div>
              <div class="cxp-price"><%= fmt(it.price) %> PAT</div>
              <div class="cxp-muted">Buy it for your pad in ⚙ Pad settings, or 🎁 gift it from any pad's page (⋯ menu or About).</div>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>
    <div class="ds-empty cxp-fempty" hidden><span class="ds-ic" aria-hidden="true">🔍</span><p>Nothing matches those filters.</p></div>
  <% } %>

  <% if (tab === 'stickers') { %>
    <%# 1.99ta: the sticker packs (stickers.pageData) - previews, price, owned, buy / 🎟️ claim / 🎁 gift through POST /api/stickers/buy
        (public/js/cos-stickers.js). Perk packs are never sold: they show which tier they come with. %>
    <% const STK = (typeof stickerPacks !== 'undefined' && stickerPacks) || { packs: [], signed: false, allowance: null };
       const SC = (typeof stkCfg !== 'undefined' && stkCfg) || { price: 0, spPer: 0, sales: true };
       const stkL_ = (k, d) => (t.has(k) ? t(k) : t.esc(d)); %>
    <section class="cxs" data-stk-shop aria-labelledby="cxsH">
      <h2 class="ds-h2" id="cxsH"><span class="ds-ic lg" aria-hidden="true">🧸</span><%- t('cos.stk.heading') %></h2>
      <p class="cxp-muted"><%- t('premium.stk.intro', { price: fmt(SC.price) }) %><% if (STK.allowance && STK.allowance.per) { %> · <%- t('premium.stk.left', { count: STK.allowance.left }) %><% } else if (SC.spPer) { %> · <%- t('premium.stk.sp_includes', { n: SC.spPer }) %><% } %>.</p>
      <% if (!SC.sales) { %><div class="ds-note warn"><span class="ds-ic" aria-hidden="true">⏸️</span><div><%- t('cos.stk.off') %></div></div><% } %>
      <% if (!STK.signed) { %><p class="cxp-muted"><%- t('cos.stk.signin', { link: '<a href="/login?next=' + encodeURIComponent('/cosmetics?tab=stickers') + '">' + t('cos.stk.signin_link') + '</a>' }) %></p><% } %>
      <p class="ds-note cxs-msg" data-stk-msg role="status" aria-live="polite" hidden></p>
      <% if (!STK.packs.length) { %>
        <div class="ds-empty"><span class="ds-ic" aria-hidden="true">🧸</span><p><%- t('cos.stk.none') %></p></div>
      <% } else { %>
      <div class="grid cxs-grid">
        <% STK.packs.forEach((p) => { const pn_ = stkL_('stk.pack.' + p.id + '.name', p.name); %>
        <div class="cxp-card cxs-pack<%= p.owned ? ' owned' : '' %>" style="--rc: <%= p.perk ? 'var(--ds-gold)' : 'var(--ds-ac)' %>" data-stk-pack="<%= p.id %>">
          <div class="cxp-title"><b><span aria-hidden="true"><%= p.emoji %></span> <%- pn_ %></b><% if (p.owned) { %><span class="ds-tag ac"><%- t('premium.stk.yours') %></span><% } %></div>
          <div class="cxs-sheet"><% p.stickers.forEach((st) => { const sn_ = stkL_('stk.s.' + p.id + '.' + st.id, st.name); %><img src="<%= st.url %>" alt="<%- sn_ %>" title="<%- sn_ %>" width="64" height="64" loading="lazy"><% }) %></div>
          <div class="cxp-desc"><%- stkL_('stk.pack.' + p.id + '.desc', p.desc) %></div>
          <div class="cxp-src"><%- t('cos.stk.count', { count: p.stickers.length }) %></div>
          <% if (p.perk) { %>
            <div class="cxp-row"><a class="ds-tag ac cxs-perk" href="/premium<%= p.perk === 'prime_plus' ? '#plus' : '' %>"><%- p.perk === 'prime_plus' ? t('premium.stk.perk_plus') : t('premium.stk.perk_sp') %></a><% if (p.season) { %><span class="ds-tag"><%- t('premium.stk.seasonal', { label: t.esc(p.season.label || '') }) %></span><% } %></div>
          <% } else { %>
            <div class="cxp-price"><%= fmt(p.price) %> PAT</div>
            <% if (STK.signed) { %>
              <% if (!p.owned) { %><div class="cxp-row">
                <% if (STK.allowance && STK.allowance.left) { %><button type="button" class="ds-btn sm" data-stk="<%= p.id %>" data-free="1"><%- t('premium.stk.claim') %></button><% } %>
                <button type="button" class="ds-btn gold sm" data-stk="<%= p.id %>" data-price="<%= p.price %>"<%= SC.sales ? '' : ' disabled' %>><%- t('cos.stk.buy') %></button>
              </div><% } %>
              <details class="cxp-more"><summary><span class="ds-ic" aria-hidden="true">🎁</span><%- t('cos.stk.gift_summary') %></summary>
                <form class="cxp-row" data-stk-gift="<%= p.id %>" data-price="<%= p.price %>">
                  <input class="ds-in" name="to" placeholder="<%- t('cos.stk.gift_to') %>" required maxlength="60" aria-label="<%- t('cos.stk.gift_to') %>" autocomplete="off">
                  <label class="cxp-anon"><input type="checkbox" name="anon" value="1"> <%- t('gifts.anon.box_short') %></label>
                  <button class="ds-btn ghost sm" type="submit"<%= SC.sales ? '' : ' disabled' %>><%- t('cos.stk.gift_btn') %></button>
                </form>
              </details>
            <% } %>
          <% } %>
        </div>
        <% }) %>
      </div>
      <% } %>
      <p class="cxp-muted"><%- t('cos.stk.foot', { link: '<a href="/premium#stickers">' + t('cos.stk.foot_link') + '</a>' }) %></p>
    </section>
  <% } %>

  <% if (tab === 'market') { %>
    <p class="cxp-muted">Copies other players are selling. Pepe takes the PAT from you, pays the seller (minus a <%= fee %>% market fee), and moves the item to your inventory. Sell your own from <a href="/cosmetics?tab=mine#tabs">My items</a>.</p>
    <div class="sortbar"><span class="cxp-flabel">Sort</span>
      <a href="/cosmetics?tab=market&sort=newest#tabs" class="ds-tab<%= sort === 'newest' ? ' on' : '' %>"<%- sort === 'newest' ? ' aria-current="true"' : '' %>>Newest</a>
      <a href="/cosmetics?tab=market&sort=price#tabs" class="ds-tab<%= sort === 'price' ? ' on' : '' %>"<%- sort === 'price' ? ' aria-current="true"' : '' %>>Price ↑</a>
      <a href="/cosmetics?tab=market&sort=price_desc#tabs" class="ds-tab<%= sort === 'price_desc' ? ' on' : '' %>"<%- sort === 'price_desc' ? ' aria-current="true"' : '' %>>Price ↓</a>
    </div>
    <% if (!listings.length) { %>
      <div class="ds-empty"><span class="ds-ic" aria-hidden="true">🏪</span><p>Nothing for sale yet. Be the first — list something from <a href="/cosmetics?tab=mine#tabs">My items</a>.</p></div>
    <% } else { %>
      <% filterBar() %>
      <div class="grid cxp-fsec">
        <% listings.forEach((l) => { const mine = myListings.has(l.id); %>
          <div class="cxp-card" style="--rc: <%= RC(l.item.rarity) %>" <%- fAttrs(l.item) %>>
            <% preview(l.r) %>
            <div class="cxp-title"><b><%= l.item.name %></b><span class="cxp-rar"><%= l.item.rarity %></span></div>
            <% chips(l.item) %>
            <div class="cxp-src">listing #<%= l.id %> · by <a href="/u/<%= encodeURIComponent(l.seller || '') %>"><%= l.seller_display || l.seller %></a></div>
            <div class="cxp-price"><%= fmt(l.price) %> PAT</div>
            <% if (!me) { %>
              <div class="cxp-muted"><a href="/login">Sign in</a> to buy.</div>
            <% } else if (mine) { %>
              <form method="POST" action="/cosmetics/cancel" class="cxp-row">
                <input type="hidden" name="listing_id" value="<%= l.id %>"><input type="hidden" name="tab" value="market">
                <button class="ds-btn danger sm" type="submit">Cancel my listing</button>
              </form>
            <% } else { %>
              <form method="POST" action="/cosmetics/act" class="cxp-row">
                <input type="hidden" name="op" value="buylisting"><input type="hidden" name="listing" value="<%= l.id %>"><input type="hidden" name="tab" value="market">
                <button class="ds-btn gold sm" type="submit">Buy for <%= fmt(l.price) %></button>
              </form>
            <% } %>
          </div>
        <% }) %>
      </div>
      <div class="ds-empty cxp-fempty" hidden><span class="ds-ic" aria-hidden="true">🔍</span><p>Nothing matches those filters.</p></div>
    <% } %>
  <% } %>

  <% if (tab === 'mine') { %>
    <% if (!me) { %>
      <div class="ds-empty"><span class="ds-ic" aria-hidden="true">🎒</span><p><a href="/login">Sign in</a> to see your items.</p></div>
    <% } else { %>
      <div class="look">
        <div>
          <div class="cxp-muted">Your look right now · <a href="/u/<%= me.username %>">see your profile</a></div>
          <% mini({ banner: equippedR.profile_banner, border: equippedR.profile_border, effect: equippedR.profile_effect, deco: equippedR.avatar_decoration, name: equippedR.name_color }) %>
        </div>
        <% { const L = {}; GTF_KINDS.forEach((k) => { if (equippedR[k]) L[equippedR[k].opt] = equippedR[k].layer; }); gtfBox(L, 96); } %>
      </div>
      <%# 1.99iw: sticker packs (stickers.js) live in the inventory too %>
      <% if (typeof stickerPacks !== 'undefined' && stickerPacks) { const own_ = stickerPacks.packs.filter((p) => p.owned); const stkL_ = (k, d) => (t.has(k) ? t(k) : t.esc(d)); %>
        <h2 class="ds-h2"><span class="ds-ic lg" aria-hidden="true">🧸</span>Sticker packs</h2>
        <% if (own_.length) { %><div class="stk-packs"><% own_.forEach((p) => { %>
          <div class="cxp-muted stk-pack"><b><%= p.emoji %> <%- stkL_('stk.pack.' + p.id + '.name', p.name) %></b>
            <span><% p.stickers.forEach((s) => { const sn_ = stkL_('stk.s.' + p.id + '.' + s.id, s.name); %><img src="<%= s.url %>" alt="<%- sn_ %>" title="<%- sn_ %>" width="40" height="40" loading="lazy"><% }) %></span></div>
        <% }) %></div><p class="cxp-muted stk-foot">Use them with the 🧸 button in messages and posts. <a href="/cosmetics?tab=stickers#tabs">More packs</a></p>
        <% } else { %><p class="cxp-muted">None yet - <a href="/cosmetics?tab=stickers#tabs">get a sticker pack</a><%= stickerPacks.allowance && stickerPacks.allowance.left ? ' (your 🎟️ Season Pass has a free one)' : '' %>.</p><% } %>
      <% } %>
      <% if (!inv.count) { %>
        <div class="ds-empty"><span class="ds-ic" aria-hidden="true">🎒</span><p>No items yet. Grab something from the <a href="/cosmetics?tab=shop#tabs">shop</a>, run a heist for a drop, or level up.</p></div>
      <% } %>
      <% Object.keys(kinds).forEach((k) => { const list = inv.groups[k]; if (!list || !list.length) return; %>
        <h2 class="ds-h2"><span class="ds-ic lg" aria-hidden="true"><%= kindEmoji(k) %></span><%= kindLabel(k) %></h2>
        <div class="inv">
          <% list.forEach((c) => { %>
            <div class="copy" style="--rc: <%= RC(c.rarity) %>">
              <div><% preview(c.r) %></div>
              <div class="copy-meta">
                <div class="copy-name"><b><%= c.name %></b>
                  <span class="tag rar"><%= c.rarity %></span>
                  <% if (c.equipped) { %><span class="tag eq">equipped</span><% } %>
                  <% if (c.listing_id) { %><span class="tag ls">listed #<%= c.listing_id %> · <%= fmt(c.listing_price) %> PAT</span><% } %>
                </div>
                <% chips(c.item) %>
                <div class="cxp-src">copy #<%= c.inv_id %> · from <%= c.source || '—' %></div>
                <% if (c.listing_id) { %>
                  <form method="POST" action="/cosmetics/cancel" class="cxp-row">
                    <input type="hidden" name="listing_id" value="<%= c.listing_id %>"><input type="hidden" name="tab" value="mine">
                    <button class="ds-btn danger sm" type="submit">Cancel listing</button>
                  </form>
                <% } else { %>
                  <form method="POST" action="/cosmetics/equip" class="cxp-row">
                    <input type="hidden" name="inv_id" value="<%= c.inv_id %>"><input type="hidden" name="on" value="<%= c.equipped ? 0 : 1 %>"><input type="hidden" name="tab" value="mine">
                    <button class="ds-btn sm<%= c.equipped ? ' ghost' : '' %>" type="submit"><%= c.equipped ? 'Unequip' : 'Equip' %></button>
                  </form>
                  <details class="cxp-more"><summary><span class="ds-ic" aria-hidden="true">🏪</span>List for sale</summary>
                    <form method="POST" action="/cosmetics/list" class="cxp-row">
                      <input type="hidden" name="inv_id" value="<%= c.inv_id %>"><input type="hidden" name="tab" value="mine">
                      <input class="ds-in" name="price" inputmode="numeric" placeholder="Price in PAT (min <%= fmt(listMin) %>, e.g. 50k)" required aria-label="Price">
                      <button class="ds-btn ghost sm" type="submit">List</button>
                    </form>
                    <div class="cxp-src" style="margin-top:6px">You get the price minus <%= fee %>% when it sells. Listing unequips it.</div>
                  </details>
                  <details class="cxp-more"><summary><span class="ds-ic" aria-hidden="true">🎁</span>Gift this copy</summary>
                    <form method="POST" action="/cosmetics/gift" class="cxp-row">
                      <input type="hidden" name="inv_id" value="<%= c.inv_id %>"><input type="hidden" name="tab" value="mine">
                      <input class="ds-in" name="to" placeholder="PATV username or Camfrog name" required maxlength="60" aria-label="Gift to">
                      <label class="cxp-anon"><input type="checkbox" name="anon" value="1"> <%- t('gifts.anon.box_short') %></label>
                      <button class="ds-btn ghost sm" type="submit">Gift</button>
                    </form>
                  </details>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% }) %>
    <% } %>
  <% } %>

  <% if (tab === 'showcase') { %>
    <% if (!me) { %>
      <div class="ds-empty"><span class="ds-ic" aria-hidden="true">🏅</span><p><a href="/login">Sign in</a> to pick your showcase.</p></div>
    <% } else if (!badges.length) { %>
      <div class="ds-empty"><span class="ds-ic" aria-hidden="true">🏅</span><p>You don't have any badges yet. <a href="/achievements">How to earn them</a></p></div>
    <% } else { %>
      <p class="cxp-muted">Pin up to <%= showcaseMax %> badges to the top of your profile.</p>
      <form method="POST" action="/cosmetics/showcase" id="showcase">
        <input type="hidden" name="tab" value="showcase">
        <div class="badgepick">
          <% badges.forEach((b) => { %>
            <label title="<%= b.description %>">
              <input type="checkbox" name="badges" value="<%= b.badgeId %>" <%= showcase.includes(b.badgeId) ? 'checked' : '' %>>
              <img src="<%= b.icon %>" alt="" loading="lazy"><span><%= b.name %></span>
            </label>
          <% }) %>
        </div>
        <div class="ds-actions"><button class="ds-btn" type="submit">Save showcase</button></div>
      </form>
      <script>
        (function () {
          var f = document.getElementById('showcase'), max = <%= showcaseMax %>;
          f.addEventListener('change', function (e) {
            if (e.target.name !== 'badges') return;
            if (f.querySelectorAll('input[name=badges]:checked').length > max) e.target.checked = false;
          });
        })();
      </script>
    <% } %>
  <% } %>

  <% if (tab === 'how') { %>
    <section class="how">
      <h2 class="ds-h2">Getting items</h2>
      <ul>
        <li><b>Shop</b> — pick an item and hit Buy. Pepe charges the PAT as you, so you need a linked chat account. Prices by rarity:
          <% Object.keys(rarities).forEach((r, i) => { %><%= i ? ' · ' : '' %><span style="color:<%= RC(r) %>"><%= r %> <%= fmt(rarities[r].price) %></span><% }) %>.</li>
        <li><b>Drops</b> — heists, the arena, bingo and completed bounties (10,000+ PAT pots) can drop items, mostly Grand Theft Frogger avatar gear. Rarer drops are rarer, and some gear (the Wanted Poster, Lasso Frame and Sheriff Star) only drops from bounties.</li>
        <li><b>Achievements &amp; levels</b> — some items unlock for free when you earn an <a href="/achievements">achievement</a> or reach level 10, 25 or 50. They land in My items automatically.</li>
        <li><b>Seasonal</b> — limited items sell only during their season (Halloween, winter). After that the only way to get one is from another player.</li>
        <li><b>Gifts</b> — buy a new item for a friend from the shop, or give away a copy you own.</li>
        <li><b>Labels</b> — every card says what it is and where it shows: <b>Profile</b> items (name color, border, banner, effect, avatar decoration) dress up your PATV profile; <b>GTF avatar</b> items (hat, mask, outfit, prop, background, frame) are worn by your Grand Theft Frogger pixel avatar. Seasonal items are labelled with their set and when they leave the shop. Style tags (Pride, Drag &amp; camp, Cute, Kink) let you filter the shop — tick <i>Hide kink items</i> if you'd rather not see those. Pride flags are always in the shop; the Pride set is June only.</li>
      </ul>
      <h2 class="ds-h2">Trading</h2>
      <p>Every item you own is a copy that can change hands. List a copy on the <a href="/cosmetics?tab=market#tabs">market</a> at your price (at least <%= fmt(listMin) %> PAT); it's unequipped and locked while it's listed, and you can cancel any time. When someone buys it Pepe moves the PAT — the seller gets the price minus a <%= fee %>% market fee.</p>
      <h2 class="ds-h2">Wearing them</h2>
      <p>One item per slot. Account cosmetics show on your <% if (me) { %><a href="/u/<%= me.username %>">profile</a><% } else { %>profile<% } %> (name colors also show on the rankings); GTF gear shows on your pixel avatar in heists. In chat, <code>!equip</code> works too.</p>
    </section>
  <% } %>
</main>
<script>
  (function () {
    // countdowns
    var cds = document.querySelectorAll('.cx-cd[data-to]');
    function tick() {
      var now = Date.now();
      cds.forEach(function (el) {
        var s = Math.max(0, Math.round((+el.getAttribute('data-to') - now) / 1000));
        var d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60), sec = s % 60;
        el.textContent = (d ? d + 'd ' : '') + (d || h ? h + 'h ' : '') + m + 'm ' + sec + 's';
      });
    }
    if (cds.length) { tick(); setInterval(tick, 1000); }
    // type / style filters (shop + market)
    var fb = document.querySelectorAll('[data-filter]');
    if (fb.length) {
      var state = { type: '', kind: '', tag: '', hideKink: false };
      try { state.hideKink = localStorage.getItem('cx-hide-kink') === '1'; } catch (e) { /* private mode */ }
      var apply = function () {
        var cards = document.querySelectorAll('.cxp .cxp-card[data-kind]'), shown = 0;
        cards.forEach(function (c) {
          var tg = (' ' + (c.getAttribute('data-tags') || '') + ' ');
          var ok = (!state.type || c.getAttribute('data-group') === state.type) &&
                   (!state.kind || c.getAttribute('data-kind') === state.kind) &&
                   (!state.tag || tg.indexOf(' ' + state.tag + ' ') >= 0) &&
                   !(state.hideKink && tg.indexOf(' kink ') >= 0);
          if (ok) { c.removeAttribute('data-fhid'); shown++; } else c.setAttribute('data-fhid', '');
        });
        document.querySelectorAll('.cxp-fsec').forEach(function (sec) {
          if (sec.querySelector('.cxp-card[data-kind]:not([data-fhid])') || !sec.querySelector('.cxp-card[data-kind]')) sec.removeAttribute('data-fhid');
          else sec.setAttribute('data-fhid', '');
        });
        document.querySelectorAll('.cxp-fempty').forEach(function (p) { p.hidden = shown > 0 || !cards.length; });
        fb.forEach(function (bar) {
          bar.querySelectorAll('[data-ftype]').forEach(function (b) { b.classList.toggle('on', (b.getAttribute('data-ftype') || '').replace('group:', '') === state.type); });
          bar.querySelectorAll('[data-ftag]').forEach(function (b) { b.classList.toggle('on', b.getAttribute('data-ftag') === state.tag); });
          var sel = bar.querySelector('[data-fkind]'); if (sel) sel.value = state.kind;
          var hk = bar.querySelector('[data-fhidekink]'); if (hk) hk.checked = state.hideKink;
        });
      };
      fb.forEach(function (bar) {
        bar.addEventListener('click', function (e) {
          var b = e.target.closest('button'); if (!b) return;
          if (b.hasAttribute('data-ftype')) { state.type = (b.getAttribute('data-ftype') || '').replace('group:', ''); state.kind = ''; }
          if (b.hasAttribute('data-ftag')) { state.tag = b.getAttribute('data-ftag') || ''; if (state.tag === 'kink') state.hideKink = false; }
          apply();
        });
        bar.addEventListener('change', function (e) {
          if (e.target.hasAttribute('data-fkind')) { state.kind = e.target.value; if (state.kind) state.type = ''; }
          if (e.target.hasAttribute('data-fhidekink')) {
            state.hideKink = e.target.checked; if (state.hideKink && state.tag === 'kink') state.tag = '';
            try { localStorage.setItem('cx-hide-kink', state.hideKink ? '1' : '0'); } catch (err) { /* ignore */ }
          }
          apply();
        });
      });
      apply();
    }
    // GTF previews (pixel avatar script; if it's missing the emoji fallback stays)
    var boxes = document.querySelectorAll('.cx-gtf[data-layers]');
    if (!boxes.length) return;
    function draw() {
      var f = window.pepeAvatarSVG;
      if (typeof f !== 'function') return;
      boxes.forEach(function (el) {
        try {
          el.innerHTML = f(+el.getAttribute('data-seed') || 7, +el.getAttribute('data-size') || 72, JSON.parse(el.getAttribute('data-layers') || '{}'));
        } catch (e) { /* keep the fallback */ }
      });
    }
    var s = document.createElement('script');
    s.src = '/public/js/avatar.js';
    s.onload = draw;
    document.head.appendChild(s);
  })();
</script>
<% if (tab === 'stickers') { %><script src="/public/js/cos-stickers.js?v=1" defer></script><% } %>
</body>
</html>
