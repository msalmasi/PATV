<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%# /sponsor — book the homepage banner slot with PAT (1.99kk, banner.js). Locals: user, signed, S = banner.state(viewer), fmt.
    The booking form, the uploader and "my bookings" are public/js/sponsor.js; everything a member typed goes back in as text. %>
<%- include('layout', { title: t('sponsor.title'), user: user }) %>
<%
  const C_ = S.config;
  const dayLbl_ = (d) => { const [y, m, dd] = d.split('-').map(Number); return new Date(Date.UTC(y, m - 1, dd)).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' }); };
%>
<style>
  /* 1.99pu polish: ds-page + ds-hero/ds-card/ds-btn/ds-in. Default green accent; booking spends PAT -> .ds-btn.gold. */
  .sp .ds-card p { margin: 0; }
  .sp .mut { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); line-height: var(--ds-lh-meta); }
  .sp .fld { display: grid; gap: 6px; min-width: 0; font: 700 var(--ds-fs-label)/1.3 var(--ds-font); letter-spacing: var(--ds-ls-label); text-transform: uppercase; color: #b9b9b9; }
  .sp .fld > input, .sp .fld > select { text-transform: none; letter-spacing: 0; }
  .sp .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 160px); gap: var(--ds-sp-3); }
  .sp .kinds { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2); }
  .sp .kinds .ds-check { flex: 1 1 160px; }
  .sp input[type=file] { color: var(--ds-text-2); font: 400 var(--ds-fs-sm)/1.4 var(--ds-font); text-transform: none; letter-spacing: 0; max-width: 100%; }
  .sp .row { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2h); align-items: center; }
  .sp .msg { min-height: 1.4em; font-size: var(--ds-fs-sm); } .sp .msg.bad { color: var(--ds-danger); } .sp .msg.ok { color: var(--ds-ok); }
  .sp .cal { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 6px; }
  .sp .cal span { display: grid; place-items: center; min-height: 36px; padding: 4px 8px; border-radius: var(--ds-r-sm); border: 1px solid var(--ds-line-strong);
                  font-size: var(--ds-fs-xs); text-align: center; color: var(--ds-text-2); font-variant-numeric: tabular-nums; }
  .sp .cal .tk { background: var(--ds-danger-bg); border-color: var(--ds-danger-line); color: var(--ds-danger); text-decoration: line-through; }
  .sp .cal .fr { background: var(--ds-ok-bg); border-color: var(--ds-ok-line); color: var(--ds-ok-ink); }
  .sp .cal .td { border-style: dashed; color: var(--ds-text-faint); }
  .sp .prev img { display: block; width: 100%; height: auto; aspect-ratio: 6 / 1; object-fit: cover; border-radius: var(--ds-r-md); border: 1px solid var(--ds-line); }
  .sp .st { display: inline-block; padding: 1px 8px; border-radius: var(--ds-r-pill); font-size: var(--ds-fs-xs); font-weight: 700; border: 1px solid var(--ds-line-strong); white-space: nowrap; }
  .sp .st.pending { color: var(--ds-warn); border-color: var(--ds-warn-line); } .sp .st.approved { color: var(--ds-ok); border-color: var(--ds-ok-line); }
  .sp .st.rejected, .sp .st.removed, .sp .st.expired { color: var(--ds-danger); border-color: var(--ds-danger-line); } .sp .st.cancelled { color: var(--ds-text-muted); }
  .sp .ds-tbl table { min-width: 620px; }
  .sp .ds-tbl td { vertical-align: top; }
  @media (max-width: 560px) { .sp .two { grid-template-columns: minmax(0, 1fr); } }
</style>
<main class="ds-page mid sp">
  <header class="ds-hero gold">
    <span class="ds-eyebrow"><span class="ds-ic" aria-hidden="true">📣</span> <%- t('sponsor.eyebrow') %></span>
    <h1><%- t('sponsor.h1') %></h1>
    <p class="ds-lead"><%- t('sponsor.lead') %></p>
    <div class="ds-note"><span class="ds-ic" aria-hidden="true">💰</span><div><%- t('sponsor.how', { price: fmt(C_.price), max: C_.maxDays, n: C_.maxBookings }) %></div></div>
  </header>

  <% if (!C_.paid) { %>
    <div class="ds-note warn off" role="status"><span class="ds-ic" aria-hidden="true">⏳</span><div><%- t('sponsor.closed') %></div></div>
  <% } else if (!signed) { %>
    <div class="ds-note info off"><span class="ds-ic" aria-hidden="true">🔑</span><div><%- t('sponsor.sign_in', { link: '<a href="/login?next=%2Fsponsor">' + t('sponsor.sign_in_link') + '</a>' }) %></div></div>
  <% } else { %>
  <form class="ds-card lg ds-form" id="spForm" autocomplete="off" aria-labelledby="spBookH">
    <h2 class="ds-h2" id="spBookH"><%- t('sponsor.book_h') %></h2>
    <div class="two">
      <label class="fld"><%- t('sponsor.start') %>
        <select class="ds-select" id="spStart" required>
          <% S.calendar.filter((d) => d.bookable).forEach((d) => { %><option value="<%= d.day %>"><%= dayLbl_(d.day) %></option><% }) %>
        </select></label>
      <label class="fld"><%- t('sponsor.days') %><input type="number" class="ds-in num" inputmode="numeric" id="spDays" min="1" max="<%= C_.maxDays %>" value="1" required></label>
    </div>
    <div class="kinds" role="radiogroup" aria-label="<%- t('sponsor.kind') %>">
      <label class="ds-check"><input type="radio" name="kind" value="text" checked> <%- t('sponsor.kind_text') %></label>
      <label class="ds-check"><input type="radio" name="kind" value="image"> <%- t('sponsor.kind_image') %></label>
    </div>
    <div id="spText" class="ds-form">
      <label class="fld"><%- t('sponsor.headline') %><input type="text" class="ds-in" id="spHead" maxlength="<%= S.limits.headline %>"></label>
      <label class="fld"><%- t('sponsor.line') %><input type="text" class="ds-in" id="spLine" maxlength="<%= S.limits.line %>"></label>
    </div>
    <div id="spImage" class="ds-form" hidden>
      <label class="fld"><%- t('sponsor.picture', { w: S.limits.w, h: S.limits.h, mb: Math.round(S.limits.bytes / 1048576) }) %><input type="file" id="spFile" accept="image/jpeg,image/png,image/gif,image/webp,image/avif"></label>
      <label class="fld"><%- t('sponsor.alt') %><input type="text" class="ds-in" id="spAlt" maxlength="<%= S.limits.alt %>"></label>
      <div class="prev" id="spPrev" hidden><img alt="" id="spPrevImg"></div>
    </div>
    <label class="fld"><%- t('sponsor.link') %><input type="text" class="ds-in" id="spLink" maxlength="<%= S.limits.link %>" placeholder="https://"></label>
    <p class="mut"><%- t('sponsor.rules') %></p>
    <div class="row">
      <button type="submit" class="ds-btn gold pri" id="spGo"><%- t('sponsor.book_btn') %></button>
      <span id="spTotal" class="mut"></span>
    </div>
    <p class="msg" id="spMsg" role="status" aria-live="polite"></p>
  </form>
  <% } %>

  <section class="ds-card lg" aria-labelledby="spCalH">
    <h2 class="ds-h2" id="spCalH"><%- t('sponsor.cal_h') %></h2>
    <p class="mut"><%- t('sponsor.cal_note') %></p>
    <div class="cal">
      <% S.calendar.forEach((d) => { %><span class="<%= d.taken ? 'tk' : d.bookable ? 'fr' : 'td' %>" title="<%- d.taken ? t('sponsor.taken') : d.bookable ? t('sponsor.free') : t('sponsor.today') %>"><%= dayLbl_(d.day) %></span><% }) %>
    </div>
  </section>

  <% if (signed) { %>
  <section class="ds-card lg" aria-labelledby="spMineH">
    <h2 class="ds-h2" id="spMineH"><%- t('sponsor.mine_h') %></h2>
    <% if (!S.mine.length) { %><p class="mut"><%- t('sponsor.mine_none') %></p><% } else { %>
    <div class="ds-tbl tw"><table>
      <thead><tr><th><%- t('sponsor.col.days') %></th><th><%- t('sponsor.col.ad') %></th><th><%- t('sponsor.col.status') %></th><th class="r"><%- t('sponsor.col.price') %></th><th class="r"><%- t('sponsor.col.views') %></th><th class="r"><%- t('sponsor.col.clicks') %></th><th></th></tr></thead>
      <tbody>
      <% S.mine.forEach((b) => { const st_ = b.stats || { impressions: 0, clicks: 0 }; %>
        <tr data-id="<%= b.id %>">
          <td><%= b.start %><%= b.days > 1 ? ' → ' + b.end : '' %></td>
          <td><% if (b.kind === 'image' && b.image) { %><span class="ds-ic" aria-hidden="true">🖼️</span> <%= b.alt || '' %><% } else { %><%= b.headline || '' %><% } %><% if (b.domain) { %> <span class="mut">(<%= b.domain %>)</span><% } %></td>
          <td><span class="st <%= b.status %>"><%- t('sponsor.status.' + b.status) %></span><% if (b.reason) { %><div class="mut"><%= b.reason %></div><% } %></td>
          <td class="r"><%= fmt(b.price) %><% if (b.refunded) { %><div class="mut"><%- t('sponsor.refunded') %></div><% } %></td>
          <td class="r"><%= fmt(st_.impressions) %></td>
          <td class="r"><%= fmt(st_.clicks) %><% if (st_.impressions) { %> <span class="mut">(<%= (st_.clicks / st_.impressions * 100).toFixed(1) %>%)</span><% } %></td>
          <td><% if (b.status === 'pending') { %><button type="button" class="ds-btn sm danger" data-cancel="<%= b.id %>"><%- t('sponsor.cancel') %></button><% } %></td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
    <p class="mut"><%- t('sponsor.stats_note') %></p>
    <% } %>
  </section>
  <% } %>
</main>
<script type="application/json" id="spBoot"><%- JSON.stringify({ price: C_.price, maxDays: C_.maxDays, chunk: 524288, maxBytes: S.limits.bytes, balance: S.balance }).replace(/</g, '\\u003c') %></script>
<script src="/public/js/sponsor.js?v=1" defer></script>
</body>
</html>
