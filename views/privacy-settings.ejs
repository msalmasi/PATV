    <p class="pv-st" id="pvGhSt" role="status" aria-live="polite"><%- gh.on ? t('gh.st_on') : t('gh.st_off') %></p>
    <p class="ds-meta"><%- t('gh.chat') %></p>
  </section>
  <% } %>

  <section class="ds-card lg" aria-labelledby="pvMoreH">
