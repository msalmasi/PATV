    <div class="pv-set">
      <div><b><%- t('gh.switch') %></b></div>
      <label class="ds-switch"><input type="checkbox" id="pvGh" <%= gh.on ? 'checked' : '' %> aria-label="<%- t('gh.switch') %>"><span></span></label>
