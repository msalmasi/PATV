<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%# /settings/privacy - 1.99wa (incognito.js): Settings → Privacy. Incognito's ONE home on the website (the same switch as
    !incognito in chat - Pepe applies it and reports the real state back) + links to the other privacy pages. Client:
    public/js/privacy-settings.js. %>
<%- include('layout', { title: t('inc.title'), user: user }) %>
<style>
  .pv .pv-set { display: flex; align-items: center; justify-content: space-between; gap: var(--ds-sp-3); min-height: 56px; padding: var(--ds-sp-2) 0; }
  .pv .pv-set > div { min-width: 0; }
  .pv .pv-set b { color: var(--ds-text-strong); }
  .pv .pv-set.pending .ds-switch { opacity: .55; }
  .pv .pv-why { margin: 0 0 var(--ds-sp-2); color: var(--ds-text-2); font-size: 14px; line-height: 1.55; }
  .pv .pv-list { margin: 0 0 var(--ds-sp-2); padding-inline-start: 1.2em; color: var(--ds-text-2); font-size: 14px; line-height: 1.6; }
  .pv .pv-st { min-height: 1.2em; font-size: 13px; color: var(--ds-text-muted); margin: var(--ds-sp-2) 0 0; }
  .pv .pv-st.ok { color: var(--ds-ok); } .pv .pv-st.bad { color: var(--ds-danger); } .pv .pv-st.wait { color: var(--ds-text-2); }
  .pv .pv-log { list-style: none; margin: 0; padding: 0; font-size: 13px; color: var(--ds-text-2); }
  .pv .pv-log li { display: flex; justify-content: space-between; gap: var(--ds-sp-2); padding: 6px 0; border-top: 1px solid var(--ds-line-soft); }
  .pv .pv-log li:first-child { border-top: 0; }
  .pv .pv-links a { display: flex; gap: var(--ds-sp-2); padding: 10px 0; border-top: 1px solid var(--ds-line-soft); text-decoration: none; color: inherit; }
  .pv .pv-links a:first-child { border-top: 0; }
  .pv .pv-links small { display: block; color: var(--ds-text-2); }
  .pv .pv-ca { border-top: 1px solid var(--ds-line-soft); margin-top: var(--ds-sp-2); padding-top: var(--ds-sp-2); }
  .pv .pv-ca[hidden] { display: none; }
  .pv .pv-ca select, .pv .pv-ca-add input { min-height: 40px; max-width: 100%; border-radius: 8px; border: 1px solid var(--ds-line-strong); background: var(--ds-surface); color: var(--ds-text); padding: 0 10px; font: inherit; }
  .pv .pv-ca-ask { display: flex; gap: 8px; align-items: center; font-size: 14px; color: var(--ds-text-2); }
  .pv .pv-ca-add { display: flex; flex-wrap: wrap; gap: 8px; margin-top: var(--ds-sp-2); }
  .pv .pv-ca-add input { flex: 1 1 200px; min-width: 0; }
  .pv .pv-ca-add[hidden] { display: none; }                  /* wave 3: the 🧠 card's FORGET confirm until it's needed */
  .pv .pv-ca .pv-log li { align-items: center; flex-wrap: wrap; }
  .pv .pv-ca .pv-log button { margin-inline-start: 6px; }
</style>
<%
  const when = (ms) => ms ? (t.date ? t.date(Number(ms), { dateStyle: 'medium', timeStyle: 'short' }) : new Date(Number(ms)).toISOString()) : '';
  // wave 3 (design §N): with a Pepe that has the 🧠 memory switch (memoryoptout.js: mem.capable) incognito is about the website only -
  // the incognito card says so (the _v2 keys) and the Pepe's memory card shows
  const memOn = !!(locals.mem && mem.capable);
  const stateKey = st.on === null ? 'inc.st_unknown' : st.on ? (memOn ? 'inc.st_on_v2' : 'inc.st_on') : 'inc.st_off';
  const memLog = (r) => r.kind === 'request' ? t(r.on ? 'mem.log_req_off' : 'mem.log_req_on')
    : r.kind === 'refused' ? t('mem.log_refused')
    // 1.99aft (review): Telegram's own label, and a carry-over (a re-key to a new login, or a room-typed switch tied to the login)
    // is said as one - it can only switch the memory OFF
    : (r.on && (r.via === 'rekey' || r.via === 'ident')) ? t('mem.log_off_carry')
    : t((r.on ? 'mem.log_off_' : 'mem.log_on_') + (r.via === 'web' ? 'web' : r.via === 'forget' ? 'forget' : r.via === 'telegram' ? 'telegram' : 'chat'));
  const logLine = (r) => r.kind === 'request' ? t(r.on ? 'inc.log_req_on' : 'inc.log_req_off')
    : r.kind === 'refused' ? t('inc.log_refused')
    : t(r.on ? (r.via === 'web' ? 'inc.log_on_web' : 'inc.log_on_chat') : (r.via === 'web' ? 'inc.log_off_web' : 'inc.log_off_chat'));
%>
<main class="ds-page mid pv" id="pv">
  <a class="ds-back" href="/settings">← <%- t('inc.back') %></a>
  <header class="ds-hero compact">
    <span class="ds-eyebrow"><span class="ds-ic" aria-hidden="true">🔒</span> <%- t('inc.eyebrow') %></span>
    <h1><%- t('inc.h1') %></h1>
    <p class="ds-lead"><%- t('inc.lead') %></p>
  </header>

  <section class="ds-card lg" id="incognito" aria-labelledby="pvIncH"
           data-linked="<%= st.linked ? 1 : 0 %>" data-on="<%= st.on === null ? '' : st.on ? 1 : 0 %>" data-waiting="<%= st.waiting ? st.waiting.id : '' %>"
           data-want="<%= st.waiting && st.waiting.want !== null ? (st.waiting.want ? 1 : 0) : '' %>" data-mem="<%= memOn ? 1 : 0 %>">
    <h2 class="ds-h2" id="pvIncH"><span class="dot"></span>🕶️ <%- t('inc.h2') %></h2>
    <p class="pv-why"><%- t(memOn ? 'inc.what_v2' : 'inc.what') %></p>
    <ul class="pv-list">
      <li><%- t(memOn ? 'inc.what_memory_v2' : 'inc.what_memory') %></li>
      <%# review 2 fix-up: new keys for the owner's decision-9 change (incognito hides WHO, not WHAT) - every other language falls
          back to this English until it is translated, instead of keeping the old promise ("your chat lines aren't shown") -%>
      <li><%- t(st.account ? 'inc.what_web_someone_acct' : 'inc.what_web_someone') %></li>
      <li><%- t('inc.what_media_someone') %></li>
      <%# WP-1 (design section H, approved 2026-10-28): true today - not behind any switch %>
      <li><%- t('inc.what_voice') %></li>
      <%# 1.99aft (review): Pepe counts no top word said while incognito (pepe_userstats: the memory switch AND incognito, at count
          time), with or without the memory switch - the same line either way %>
      <li><%- t('inc.what_stats') %></li>
      <%# mic retention (ops plan 8.8, approved 2026-10-27): only while the /admin/bridge › Mic recordings switch is on (micrec.policyOn) %>
      <% if (locals.micrecOn) { %><li><%- t('inc.what_rec') %></li><% } %>
    </ul>
    <p class="pv-why"><%- t(memOn ? 'inc.what_not_v2' : 'inc.what_not') %></p>

    <% if (!st.linked) { %>
      <div class="ds-note"><span class="ds-ic" aria-hidden="true">🔗</span><div><%- t('inc.unlinked') %></div></div>
      <div class="ds-ctas"><a class="ds-btn" href="/u/<%= encodeURIComponent(user) %>/edit#camfrogDiv"><%- t('inc.link_btn') %></a></div>
    <% } else { %>
      <div class="pv-set<%= st.waiting ? ' pending' : '' %>" id="pvRow">
        <div><b><%- t('inc.switch') %></b><p class="ds-meta"><%- st.account ? t('inc.identity_account', { name: st.name || '' }) : t('inc.identity', { login: st.login }) %></p></div>
        <label class="ds-switch"><input type="checkbox" id="pvInc" <%= st.on ? 'checked' : '' %> <%= st.waiting ? 'disabled' : '' %> aria-label="<%- t('inc.switch') %>"><span></span></label>
      </div>
      <p class="pv-st<%= st.waiting ? ' wait' : st.failed ? ' bad' : '' %>" id="pvSt" role="status" aria-live="polite"><%- st.waiting ? t('inc.waiting') : st.failed ? t('inc.failed') : t(stateKey) %></p>
      <p class="ds-meta" id="pvRep"><%- st.reported ? t('inc.reported', { when: when(st.reported) }) : t('inc.not_reported') %></p>
    <% } %>
    <p class="ds-meta"><%- t('inc.chat') %></p>

    <% if (st.log && st.log.length) { %>
    <details><summary class="ds-meta"><%- t('inc.log_h') %></summary>
      <ul class="pv-log">
        <% st.log.forEach((r) => { %><li><span><%- logLine(r) %></span><span><%= when(r.at) %></span></li><% }) %>
      </ul>
    </details>
    <% } %>
  </section>

  <% if (memOn) { const M = mem; const mKey = M.on === null ? 'mem.st_unknown' : M.on ? (M.since ? 'mem.st_off_since' : 'mem.st_off') : 'mem.st_on'; %>
  <%# wave 3 (design §N.3 / §N.8 card text, owner-approved 2026-10-28): 🧠 Pepe's memory (memoryoptout.js) - only while Pepe's latest
      report has the switch. The switch shows REMEMBERING: checked = Pepe remembers (wire on: false); unchecked = "don't remember me"
      (memory_optout on). Turning it off with "Also forget what Pepe already knows about me" ticked runs Make Pepe forget me (its FORGET
      confirm; pepeforget keep_off queues the switch with it). Client: public/js/privacy-memory.js %>
  <section class="ds-card lg" id="memory" aria-labelledby="pvMemH"
           data-linked="<%= M.linked ? 1 : 0 %>" data-on="<%= M.on === null ? '' : M.on ? 1 : 0 %>" data-waiting="<%= M.waiting ? M.waiting.id : '' %>"
           data-want="<%= M.waiting && M.waiting.want !== null ? (M.waiting.want ? 1 : 0) : '' %>">
    <h2 class="ds-h2" id="pvMemH"><span class="dot"></span>🧠 <%- t('mem.h2') %></h2>
    <p class="pv-why"><%- t('mem.what') %></p>
    <% if (!M.linked) { %>
      <div class="ds-note"><span class="ds-ic" aria-hidden="true">🔗</span><div><%- t('mem.unlinked') %></div></div>
      <div class="ds-ctas"><a class="ds-btn" href="/u/<%= encodeURIComponent(user) %>/edit#camfrogDiv"><%- t('inc.link_btn') %></a></div>
    <% } else { %>
      <div class="pv-set<%= M.waiting ? ' pending' : '' %>" id="pvMemRow">
        <div><b><%- t('mem.switch') %></b><p class="ds-meta"><%- t('mem.where') %> · <%- M.account ? t('inc.identity_account', { name: M.name || '' }) : t('inc.identity', { login: M.login }) %></p></div>
        <label class="ds-switch"><input type="checkbox" id="pvMem" <%= M.on ? '' : 'checked' %> <%= M.waiting ? 'disabled' : '' %> aria-label="<%- t('mem.switch') %>"><span></span></label>
      </div>
      <label class="pv-ca-ask"><input type="checkbox" id="pvMemForget" aria-describedby="pvMemForgetHint"> <%- t('mem.forget') %></label>
      <p class="ds-meta" id="pvMemForgetHint"><%- t('mem.forget_meta') %></p>
      <form class="pv-ca-add" id="pvMemPf" hidden>
        <input type="text" name="confirm" maxlength="10" autocomplete="off" placeholder="<%- t('pf.type') %>" aria-label="<%- t('pf.type') %>">
        <button type="submit" class="ds-btn danger"><%- t('mem.forget_go') %></button>
      </form>
      <p class="pv-st<%= M.waiting ? ' wait' : M.failed ? ' bad' : '' %>" id="pvMemSt" role="status" aria-live="polite"><%- M.waiting ? t('inc.waiting') : M.failed ? t('mem.failed') : t(mKey, { when: when(M.since) }) %></p>
      <p class="ds-meta" id="pvMemRep"><%- M.reported ? t('inc.reported', { when: when(M.reported) }) : t('inc.not_reported') %></p>
    <% } %>
    <p class="ds-meta"><%- t('mem.chat') %></p>
    <% if (M.log && M.log.length) { %>
    <details><summary class="ds-meta"><%- t('inc.log_h') %></summary>
      <ul class="pv-log">
        <% M.log.forEach((r) => { %><li><span><%- memLog(r) %></span><span><%= when(r.at) %></span></li><% }) %>
      </ul>
    </details>
    <% } %>
  </section>
  <% } %>

  <%# 1.99aat (pepeforget.js): 🧠 Pepe forgets you + your private conversations with him. Client: privacy-forget.js %>
  <section class="ds-card lg" id="forget" aria-labelledby="pvPfH">
    <h2 class="ds-h2" id="pvPfH"><span class="dot"></span>🧠 <%- t('pf.h2') %></h2>
    <p class="pv-why"><%- t('pf.what') %></p>
    <ul class="pv-list">
      <li><%- t('pf.what_mem') %></li>
      <li><%- t('pf.what_pm') %></li>
      <li><%- t('pf.what_not') %></li>
      <% if (locals.micrecOn) { %><li><%- t('pf.what_not_rec') %></li><% } %>
      <%# CL13 fix-up: `!msg` copies (an admin's messages, not a conversation with Pepe) stay - spec §3.10 %>
      <li><%- t('pf.what_msg') %></li>
      <li><%- t(memOn ? 'pf.what_again_mem' : 'pf.what_again') %></li>
    </ul>
    <%# CL6 (decision 14): unticked by default - hides the past pad chat lines too (chatlog.js sticky hidden set, src forget) %>
    <label class="pv-ca-ask"><input type="checkbox" id="pvPfLines" aria-describedby="pvPfLinesHint"> <%- t('pf.hide_lines') %></label>
    <p class="ds-meta" id="pvPfLinesHint"><%- t('pf.hide_lines_meta') %></p>
    <%# wave 3 (design §N.4): "Keep it that way - don't remember me from now on", ticked by default (keep_off: Pepe's memory switch is queued
        with the forget) - only while Pepe has the switch and the member has a chat identity %>
    <% if (memOn && mem.linked) { %><label class="pv-ca-ask"><input type="checkbox" id="pvPfKeep" checked> <%- t('pf.keep_off') %></label><% } %>
    <form class="pv-ca-add" id="pvPf">
      <input type="text" name="confirm" maxlength="10" autocomplete="off" placeholder="<%- t('pf.type') %>" aria-label="<%- t('pf.type') %>">
      <button type="submit" class="ds-btn danger"><%- t('pf.go') %></button>
    </form>
    <p class="pv-st" id="pvPfSt" role="status" aria-live="polite"><% if (locals.pf && pf.at) { %><%- t('pf.last', { when: when(pf.at) }) %><% } %></p>
    <p class="ds-meta"><%- t('pf.chat') %></p>
  </section>

  <% if (locals.lc) { %>
  <section class="ds-card lg" id="livecam" aria-labelledby="pvLcH" data-linked="<%= lc.linked ? 1 : 0 %>">
    <h2 class="ds-h2" id="pvLcH"><span class="dot"></span>📡 <%- t('lc.h2') %></h2>
    <p class="pv-why"><%- t('lc.what') %></p>
    <ul class="pv-list">
      <li><%- t('lc.what_who') %></li>
      <li><%- t('lc.what_told') %></li>
      <li><%- t('lc.what_never') %></li>
    </ul>
    <% if (!lc.linked) { %>
      <div class="ds-note"><span class="ds-ic" aria-hidden="true">🔗</span><div><%- t('lc.unlinked') %></div></div>
      <p class="ds-meta"><%- t('privacy.mf.unlinked') %></p><%# micfollow %>
    <% } else { %>
      <div class="pv-set" id="pvLcRow">
        <div><b><%- t('lc.switch') %></b><p class="ds-meta"><%- t('lc.identity', { login: lc.login }) %></p></div>
        <label class="ds-switch"><input type="checkbox" id="pvLc" <%= lc.off ? '' : 'checked' %> aria-label="<%- t('lc.switch') %>"><span></span></label>
      </div>
      <p class="pv-st" id="pvLcSt" role="status" aria-live="polite"><%- lc.off ? t('lc.st_off') : t('lc.st_on') %></p>
      <%# 1.99aar (camaccess.js): who may watch while it's on, asking, the "always" list. Client: privacy-livecam.js %>
      <div class="pv-ca" id="pvCa">
        <div class="pv-set">
          <div><b><%- t('ca.who') %></b><p class="ds-meta"><%- t('ca.who_meta') %></p></div>
          <select id="pvCaMode" aria-label="<%- t('ca.who') %>">
            <option value="everyone"><%- t('ca.m_everyone') %></option>
            <option value="members"><%- t('ca.m_members') %></option>
            <option value="followers"><%- t('ca.m_followers') %></option>
            <option value="request"><%- t('ca.m_request') %></option>
          </select>
        </div>
        <label class="pv-ca-ask" id="pvCaAskRow"><input type="checkbox" id="pvCaAsk"> <%- t('ca.ask') %></label>
        <p class="pv-st" id="pvCaSt" role="status" aria-live="polite"></p>
        <div id="pvCaAsks" hidden><h3 class="ds-h3"><%- t('ca.asks_h') %></h3><ul class="pv-log" id="pvCaAskList"></ul></div>
        <h3 class="ds-h3"><%- t('ca.allow_h') %></h3>
        <p class="ds-meta"><%- t('ca.allow_meta') %></p>
        <ul class="pv-log" id="pvCaAllow"></ul>
        <form id="pvCaAdd" class="pv-ca-add"><input type="text" name="target" maxlength="40" placeholder="<%- t('ca.allow_ph') %>" aria-label="<%- t('ca.allow_ph') %>" autocomplete="off"> <button type="submit" class="ds-btn"><%- t('ca.allow_add') %></button></form>
      </div>
      <% if (locals.mf && mf.linked) { %>
      <%# micfollow: 🎙 the mic stage switch (default on; off keeps ▶ Live but no mic stages) + this person's own mic stages.
          Client: privacy-livecam.js (POST /api/privacy/micfollow {auto}). %>
      <div class="pv-ca" id="pvMf">
        <div class="pv-set">
          <div><b><%- t('privacy.mf.label') %></b><p class="ds-meta"><%- t('privacy.mf.hint') %></p></div>
          <label class="ds-switch"><input type="checkbox" id="pvMfSw" <%= mf.auto ? 'checked' : '' %> aria-label="<%- t('privacy.mf.label') %>"><span></span></label>
        </div>
        <p class="pv-st" id="pvMfSt" role="status" aria-live="polite"></p>
        <h3 class="ds-h3"><%- t('privacy.mf.spans_title') %></h3>
        <ul class="pv-log" id="pvMfSpans">
          <% if (!mf.spans.length) { %><li><span><%- t('privacy.mf.spans_empty') %></span></li><% } %>
          <% mf.spans.forEach((s_) => { %><li><span><%- t('privacy.mf.span', { pad: s_.pad, when: when(s_.started), secs: s_.secs }) %></span><span><%= s_.video_secs ? '📡 ' + s_.video_secs + ' s' : '' %></span></li><% }) %>
        </ul>
      </div>
      <% } %>
    <% } %>
    <p class="ds-meta"><%- t('lc.chat') %></p>
  </section>

  <%# 1.99yq (camviewers.js): who opened your cam through the website + the people you blocked from it. Client:
      public/js/privacy-camviewers.js (GET / POST /api/privacy/camviewers). %>
  <section class="ds-card lg" id="camviewers" aria-labelledby="pvCvH">
    <h2 class="ds-h2" id="pvCvH"><span class="dot"></span>👁 <%- t('cv.h2') %></h2>
    <p class="pv-why"><%- t('cv.what') %></p>
    <% if (!lc.linked) { %>
      <div class="ds-note"><span class="ds-ic" aria-hidden="true">🔗</span><div><%- t('lc.unlinked') %></div></div>
    <% } else { %>
      <div id="pvCv">
        <h3 class="ds-h3"><%- t('cv.live_h') %></h3>
        <ul class="pv-log" id="pvCvLive"><li><span><%- t('cv.loading') %></span></li></ul>
        <h3 class="ds-h3"><%- t('cv.recent_h') %></h3>
        <ul class="pv-log" id="pvCvRecent"></ul>
        <h3 class="ds-h3"><%- t('cv.blocks_h') %></h3>
        <p class="pv-why"><%- t('cv.blocks_what') %></p>
        <ul class="pv-log" id="pvCvBlocks"></ul>
        <form id="pvCvForm" class="ds-row" autocomplete="off">
          <div class="ds-field"><label class="ds-label" for="pvCvName"><%- t('cv.add_label') %></label><input class="ds-in" id="pvCvName" maxlength="42" required></div>
          <button type="submit" class="ds-btn sm"><%- t('cv.add') %></button>
        </form>
        <p class="pv-st" id="pvCvSt" role="status" aria-live="polite"></p>
      </div>
    <% } %>
    <p class="ds-meta"><%- t('cv.chat') %></p>
  </section>

  <%# stagefix site (stageleave.js): 🎬 where your cam is on a pad's Stage now ("Take me off this Stage") and the pads that can't
      put it back yet. Client: public/js/privacy-stage.js (GET /api/privacy/stage, POST /api/stage/leave). %>
  <section class="ds-card lg" id="stage" aria-labelledby="pvSlH">
    <h2 class="ds-h2" id="pvSlH"><span class="dot"></span>🎬 <%- t('sl.h2') %></h2>
    <p class="pv-why"><%- t('sl.what') %></p>
    <p class="pv-why"><%- t('sl.what_off') %></p>
    <p class="pv-why"><%- t('sl.what_check') %></p>
    <% if (!lc.linked) { %>
      <div class="ds-note"><span class="ds-ic" aria-hidden="true">🔗</span><div><%- t('lc.unlinked') %></div></div>
    <% } else { %>
      <div id="pvSl">
        <%# stagefix final round (stagepin.js, D-17): your level, the asks out to you now, the pads you said yes to %>
        <div class="pv-set">
          <div><b><%- t('sl.level') %></b><p class="ds-meta"><%- t('sl.level_meta') %></p></div>
          <select id="pvSlLevel" aria-label="<%- t('sl.level') %>">
            <option value="on"><%- t('sl.level_on') %></option>
            <option value="off"><%- t('sl.level_off') %></option>
            <option value="never"><%- t('sl.level_never') %></option>
          </select>
        </div>
        <div id="pvSlAsks" hidden><h3 class="ds-h3"><%- t('sl.asks_h') %></h3><ul class="pv-log" id="pvSlAskList"></ul></div>
        <h3 class="ds-h3"><%- t('sl.on_h') %></h3>
        <ul class="pv-log" id="pvSlOn"><li><span><%- t('cv.loading') %></span></li></ul>
        <h3 class="ds-h3"><%- t('sl.off_h') %></h3>
        <ul class="pv-log" id="pvSlOff"></ul>
        <h3 class="ds-h3"><%- t('sl.yes_h') %></h3>
        <p class="ds-meta"><%- t('sl.yes_meta') %></p>
        <ul class="pv-log" id="pvSlYes"></ul>
        <p class="pv-st" id="pvSlSt" role="status" aria-live="polite"></p>
      </div>
    <% } %>
    <p class="ds-meta"><%- locals.slChat ? t('sl.chat') : t('sl.chat_livecam') %><% if (locals.slOk) { %> <%- t('sl.chat_ok') %><% } %></p>
  </section>
  <% } %>

  <% if (locals.oa && oa.linked) { %>
  <!-- 1.99yt: 📺 a cam on Pepe's main stream needs its owner's opt-in (onair.js) -->
  <section class="ds-card lg" id="onair" aria-labelledby="pvOaH">
    <h2 class="ds-h2" id="pvOaH"><span class="dot"></span>📺 <%- t('oa.h2') %></h2>
    <p class="pv-why"><%- t('oa.what') %></p>
    <ul class="pv-list">
      <li><%- t('oa.what_told') %></li>
      <li><%- t('oa.what_never') %></li>
    </ul>
    <div class="pv-set">
      <div><b><%- t('oa.switch') %></b><p class="ds-meta"><%- t('lc.identity', { login: oa.login }) %></p></div>
      <label class="ds-switch"><input type="checkbox" id="pvOa" <%= oa.on ? 'checked' : '' %> aria-label="<%- t('oa.switch') %>"><span></span></label>
    </div>
    <p class="pv-st" id="pvOaSt" role="status" aria-live="polite"><%- oa.on ? t('oa.st_on') : t('oa.st_off') %></p>
    <p class="ds-meta"><%- t('oa.chat') %></p>
  </section>
  <% } %>

  <% if (locals.gh) { %>
  <%# 1.99aaf (ghost.js): 👻 ghost mode - site staff only. Client: public/js/privacy-ghost.js (POST /api/privacy/ghost). %>
  <section class="ds-card lg" id="ghost" aria-labelledby="pvGhH">
