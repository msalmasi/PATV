<%# views/inbox.ejs — the signed-in user's notices (inbox.js: GET /inbox) %>
<%- include('layout', { title: title, user: user, inboxUnread: inboxUnread }) %>
<%
  const escH = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const K = (k) => KINDS[k] || KINDS.system;
  const unreadOf = {};
  let totalAll = 0;
  (counts || []).forEach((c) => { unreadOf[c.kind] = c.unread || 0; totalAll += c.n; });
  const qs = (o) => { const p = []; if (o.kind) p.push('kind=' + encodeURIComponent(o.kind)); if (o.page > 1) p.push('page=' + o.page); return p.length ? '?' + p.join('&') : ''; };
  const here = '/inbox' + qs({ kind: kind, page: page });
  const kindsWithItems = Object.keys(KINDS).filter((k) => (counts || []).some((c) => c.kind === k));
%>
<style>
  .ib { width: 100%; max-width: 760px; margin: 0 auto; padding: 18px 16px 56px; font-family: Ubuntu, sans-serif; color: #e6e6e6; display: grid; gap: 16px; box-sizing: border-box; }
  .ib *, .ib *::before, .ib *::after { box-sizing: border-box; }
  .ib a { color: #81c784; text-decoration: none; }
  .ib a:hover { color: #a5d6a7; }
  .ib .card { background: #111; border: 1px solid #222; border-radius: 14px; padding: 18px 20px; min-width: 0; }
  .ib h1 { margin: 0; font-size: 24px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .ib h2 { margin: 0 0 12px; letter-spacing: .1em; text-transform: uppercase; color: #ffd700; font-family: 'Press Start 2P', monospace; font-size: 11px; line-height: 1.6; }
  .ib .muted { color: #888; font-size: 13px; line-height: 1.55; }
  .ib .head { display: flex; justify-content: space-between; align-items: center; gap: 10px 14px; flex-wrap: wrap;
              background: radial-gradient(120% 140% at 0% 0%, #17301a 0%, #111 55%); }
  .ib .count { font-size: 12px; padding: 3px 10px; border-radius: 999px; background: #4caf50; color: #fff; font-weight: bold; }
  .ib .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 9px 14px; border-radius: 8px; border: 1px solid #2b2b2b;
             background: #181818; color: #ddd !important; font-size: 14px; cursor: pointer; font-family: inherit; min-height: 40px; }
  .ib .btn:hover { border-color: #4caf50; }
  .ib .btn[disabled] { opacity: .45; cursor: default; border-color: #2b2b2b; }
  .ib .btn:focus-visible, .ib a:focus-visible, .ib input:focus-visible { outline: 2px solid #c6e94f; outline-offset: 2px; }
  .ib .msg { background: #0f1a10; border: 1px solid #2c3a2d; color: #b9d8bb; border-radius: 10px; padding: 10px 14px; font-size: 14px; }

  .ib .filters { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 2px; scrollbar-width: thin; }
  .ib .chip { flex: none; font-size: 13px; padding: 6px 12px; border-radius: 999px; border: 1px solid #2a2a2a; background: #141414; color: #bbb !important; white-space: nowrap; }
  .ib .chip.on { border-color: #4caf50; background: #0f1a10; color: #e6ffe6 !important; }
  .ib .chip .n { color: #4caf50; font-weight: bold; margin-left: 4px; }

  .ib ul.list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .ib .it { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; gap: 4px 12px; align-items: start; padding: 12px 14px;
            background: #0d0d0d; border: 1px solid #1f1f1f; border-radius: 12px; position: relative; }
  .ib .it.unread { background: #101a11; border-color: #2f5a33; }
  .ib .it.unread::before { content: ""; position: absolute; left: -1px; top: 12px; bottom: 12px; width: 3px; border-radius: 3px; background: #4caf50; }
  .ib .ic { width: 40px; height: 40px; border-radius: 10px; background: #181818; border: 1px solid #262626; display: grid; place-items: center; font-size: 20px; line-height: 1; }
  .ib .tx { min-width: 0; }
  .ib .tt { font-weight: bold; color: #fff; font-size: 15px; overflow-wrap: anywhere; }
  .ib .it:not(.unread) .tt { color: #cfcfcf; font-weight: normal; }
  .ib .bd { color: #aaa; font-size: 14px; margin-top: 3px; line-height: 1.45; overflow-wrap: anywhere; white-space: pre-line; }
  .ib .meta { color: #777; font-size: 12px; margin-top: 6px; display: flex; gap: 6px 12px; flex-wrap: wrap; align-items: center; }
  .ib .meta .cat { color: #9a9; }
  .ib .acts { display: flex; flex-direction: column; gap: 6px; align-items: flex-end; }
  .ib .acts form { margin: 0; }
  .ib .link { font-size: 13px; padding: 6px 10px; border-radius: 8px; border: 1px solid #2c3a2d; background: #0f1a10; white-space: nowrap; }
  .ib .mark { font-size: 12px; padding: 5px 9px; border-radius: 8px; border: 1px solid #2b2b2b; background: transparent; color: #999; cursor: pointer; font-family: inherit; white-space: nowrap; }
  .ib .mark:hover { color: #fff; border-color: #4caf50; }

  .ib .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ib .empty { text-align: center; padding: 34px 16px; }
  .ib .empty .big { font-size: 42px; }
  .ib .pager { display: flex; justify-content: space-between; align-items: center; gap: 10px; }

  .ib .prefs { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 6px 14px; margin: 10px 0 14px; }
  .ib .prefs label { display: flex; align-items: center; gap: 8px; font-size: 14px; color: #ccc; padding: 6px 0; cursor: pointer; }
  .ib .prefs input { width: 18px; height: 18px; accent-color: #4caf50; }
  .ib details > summary { cursor: pointer; list-style: none; }
  .ib details > summary::-webkit-details-marker { display: none; }

  @media (max-width: 520px) {
    .ib { padding: 12px 10px 48px; gap: 12px; }
    .ib .card { padding: 14px; }
    .ib h1 { font-size: 20px; }
    .ib .it { grid-template-columns: 34px minmax(0, 1fr); padding: 11px 12px; }
    .ib .ic { width: 34px; height: 34px; font-size: 17px; }
    .ib .acts { grid-column: 2; flex-direction: row; align-items: center; flex-wrap: wrap; }
  }
</style>

<main class="ib">
  <section class="card head">
    <div>
      <h1>🔔 Inbox <% if (inboxUnread) { %><span class="count"><%= inboxUnread %> unread</span><% } %></h1>
      <div class="muted">Notices from Pepe and the site — stakes, loans, wagers, markets, shop orders, tips.</div>
    </div>
    <form method="post" action="/inbox/read">
      <input type="hidden" name="all" value="1">
      <input type="hidden" name="back" value="<%= here %>">
      <button class="btn" type="submit"<%= inboxUnread ? '' : ' disabled' %>>✓ Mark all read</button>
    </form>
  </section>

  <% if (msg) { %><div class="msg" role="status"><%= msg %></div><% } %>

  <% if (totalAll) { %>
  <nav class="filters" aria-label="Filter by category">
    <a class="chip<%= kind ? '' : ' on' %>" href="/inbox">All</a>
    <% kindsWithItems.forEach((k) => { %>
      <a class="chip<%= kind === k ? ' on' : '' %>" href="/inbox?kind=<%= encodeURIComponent(k) %>"><%= K(k).icon %> <%= K(k).label %><% if (unreadOf[k]) { %><span class="n"><%= unreadOf[k] %></span><% } %></a>
    <% }) %>
  </nav>
  <% } %>

  <section class="card">
    <% if (!items.length) { %>
      <div class="empty">
        <div class="big">📭</div>
        <p><b><%= kind ? 'Nothing here in ' + K(kind).label + '.' : 'Your inbox is empty.' %></b></p>
        <p class="muted">When Pepe executes a stake, a loan gets paid, you're picked to judge a wager, an order ships or someone tips you, it shows up here<% if (!camfrog) { %> — <a href="/u/<%= encodeURIComponent(user) %>/profile/edit">link your Camfrog name</a> to get Pepe's notices too<% } %>.</p>
      </div>
    <% } else { %>
      <ul class="list">
        <% items.forEach((n) => { const k = K(n.kind); const unread = !n.read_at; %>
          <li class="it<%= unread ? ' unread' : '' %>">
            <div class="ic" aria-hidden="true"><%= k.icon %></div>
            <div class="tx">
              <div class="tt"><% if (unread) { %><span class="vh">Unread: </span><% } %><%= n.title %></div>
              <% if (n.body) { %><div class="bd"><%= n.body %></div><% } %>
              <div class="meta"><span class="cat"><%= k.label %></span><time datetime="<%= new Date(n.created).toISOString() %>" data-ts="<%= n.created %>"><%= new Date(n.created).toISOString().slice(0, 16).replace('T', ' ') %> UTC</time></div>
            </div>
            <div class="acts">
              <% if (n.link) { %><a class="link" href="/inbox/open/<%= n.id %>">Open →</a><% } %>
              <% if (unread) { %>
                <form method="post" action="/inbox/read" class="mr">
                  <input type="hidden" name="id" value="<%= n.id %>">
                  <input type="hidden" name="back" value="<%= here %>">
                  <button class="mark" type="submit">Mark read</button>
                </form>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
      <% if (pages > 1) { %>
        <div class="pager" style="margin-top:14px">
          <% if (page > 1) { %><a class="btn" href="/inbox<%= qs({ kind: kind, page: page - 1 }) %>">← Newer</a><% } else { %><span></span><% } %>
          <span class="muted">Page <%= page %> of <%= pages %> · <%= total %> notices</span>
          <% if (page < pages) { %><a class="btn" href="/inbox<%= qs({ kind: kind, page: page + 1 }) %>">Older →</a><% } else { %><span></span><% } %>
        </div>
      <% } %>
    <% } %>
  </section>

  <section class="card">
    <details>
      <summary><h2 style="margin:0">⚙️ Camfrog PMs</h2></summary>
      <p class="muted" style="margin-top:10px">Everything always lands here. Untick a category and Pepe stops PMing you about it in Camfrog (it only PMs you in a room you're in — otherwise he waits until he sees you).<% if (!camfrog) { %> You haven't linked a Camfrog name yet.<% } %></p>
      <form method="post" action="/inbox/prefs">
        <div class="prefs">
          <% Object.keys(KINDS).forEach((k) => { %>
            <label><input type="checkbox" name="pm_<%= k %>" value="1"<%= prefs[k] && prefs[k].pm ? ' checked' : '' %>> <%= KINDS[k].icon %> <%= KINDS[k].label %></label>
          <% }) %>
        </div>
        <button class="btn" type="submit">Save</button>
        <span class="muted" style="margin-left:8px">Shop emails/PMs also follow your <a href="/shop/seller#notify">shop settings</a>.</span>
      </form>
    </details>
  </section>
</main>
<script>
  // local time for the timestamps; "Mark read" without a page reload
  (function () {
    document.querySelectorAll('.ib time[data-ts]').forEach(function (t) {
      var d = new Date(Number(t.getAttribute('data-ts')));
      if (!isNaN(d)) t.textContent = d.toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
    });
    document.querySelectorAll('.ib form.mr').forEach(function (f) {
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        var body = new URLSearchParams(new FormData(f));
        fetch('/inbox/read', { method: 'POST', headers: { 'x-requested-with': 'fetch' }, body: body, credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            var li = f.closest('li'); if (li) li.classList.remove('unread');
            f.remove();
            var b = document.querySelector('.nav-bell .nav-badge');
            if (b) { if (d.unread > 0) b.textContent = d.unread > 99 ? '99+' : d.unread; else b.remove(); }
            var c = document.querySelector('.ib .count');
            if (c) { if (d.unread > 0) c.textContent = d.unread + ' unread'; else c.remove(); }
          })
          .catch(function () { f.submit(); });
      });
    });
  })();
</script>
