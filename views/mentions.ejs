<% const t = locals.i18nT || new Function(include('../i18n-core.js'))()(JSON.parse(include('../locales/en.json'))); -%>
<%# /settings/mentions — 📣 room mention alerts (1.99ii, mentions.js). Locals: user, title, boot {prefs, words, names, linked, rooms, wordsMax}.
    Everything user-entered goes back in with textContent / .value; the JSON boot is < -escaped. %>
<%- include('layout', { title: title, user: user }) %>
<style>
  /* 1.99qd: a settings page on the design system - .ds-page.mid, .ds-head, .ds-card.lg, one .ds-h2 per card (docs/design-system.md, "Area notes: feed, pads and social").
     The fields and buttons keep their (class-less) markup because the page script builds the word rows; they read the ds tokens here. */
  .mn .card { display: grid; gap: var(--ds-sp-2h); }
  .mn .mut, .mn .muted { margin: 0; color: var(--ds-text-muted); font-size: var(--ds-fs-meta); }
  .mn label.ck, .mn label.fl-notify { display: flex; gap: var(--ds-sp-2h); align-items: flex-start; min-height: 32px; margin: 0; font-size: var(--ds-fs-body); color: var(--ds-text); cursor: pointer; }
  .mn label.ck input, .mn label.fl-notify input { width: 18px; height: 18px; margin: 2px 0 0; flex: none; accent-color: var(--ds-ac); }
  .mn .names { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 0 28px; margin-inline: 28px 0; }
  .mn .chip { display: inline-flex; align-items: center; padding: 2px 10px; border-radius: var(--ds-r-pill); background: #1b1b1b; border: 1px solid var(--ds-line-strong); font-size: var(--ds-fs-meta); color: #ddd; }
  .mn .words { display: grid; gap: var(--ds-sp-2); }
  .mn .w { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 200px) auto; gap: var(--ds-sp-2); align-items: center; }
  .mn input[type=text], .mn select, .mn input[type=time] { width: 100%; min-width: 0; min-height: 40px; margin: 0; padding: 8px 12px; border-radius: var(--ds-r-md); border: 1px solid var(--ds-line-strong);
    background: var(--ds-sunken); color: #eee; font: 15px/1.3 var(--ds-font); box-sizing: border-box; }
  .mn input[type=text]:focus, .mn select:focus, .mn input[type=time]:focus { outline: none; border-color: var(--ds-ac); box-shadow: 0 0 0 3px var(--ds-ac-bg); }
  .mn button { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 36px; margin: 0; padding: 0 var(--ds-sp-3h); border-radius: var(--ds-r-pill);
    border: 1px solid var(--ds-line-strong); background: transparent; color: var(--ds-text); font: 700 13.5px/1.1 var(--ds-font); cursor: pointer; justify-self: start; }
  .mn button:hover { border-color: var(--ds-ac); }
  .mn button:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .mn button.pri { min-height: var(--ds-tap); padding: 0 var(--ds-sp-5); background: var(--ds-ac); border-color: transparent; color: var(--ds-on-ac); font-size: 15px; }
  .mn button.pri:hover { filter: brightness(1.1); }
  .mn button.x { width: 36px; padding: 0; }
  .mn .row { display: flex; flex-wrap: wrap; gap: var(--ds-sp-2); align-items: center; }
  .mn .q { display: grid; grid-template-columns: auto minmax(0, 140px) auto minmax(0, 140px); gap: var(--ds-sp-2); align-items: center; margin-inline-start: 28px; }
  .mn .q label { color: var(--ds-text-muted); font-size: var(--ds-fs-meta); }
  .mn .msg { min-height: 1.4em; font-size: var(--ds-fs-sm); }
  .mn .msg.bad { color: var(--ds-danger); } .mn .msg.ok { color: var(--ds-ok); }
  .mn .muted-on { color: var(--ds-warn); }
  @media (max-width: 760px) { .mn input[type=text], .mn select, .mn input[type=time] { font-size: 16px; } }
  @media (pointer: coarse) { .mn button { min-height: 40px; } }
  @media (max-width: 560px) { .mn .w { grid-template-columns: minmax(0, 1fr) auto; } .mn .w select { grid-column: 1 / -1; grid-row: 2; } .mn .q { grid-template-columns: auto minmax(0, 1fr); margin-inline-start: 0; } }
</style>
<main class="ds-page mid mn">
  <div class="ds-head">
    <span class="ds-eyebrow"><span class="ds-ic" aria-hidden="true">📣</span> <%- t('settings.mentions.eyebrow') %></span>
    <h1 class="ds-h1"><%- t('settings.mentions.h1') %></h1>
    <p class="ds-lead"><%- t('settings.mentions.lead') %></p>
    <p class="ds-sub"><%- t('settings.mentions.note', { n: boot.hourMax }) %></p>
  </div>

  <form id="mnForm" class="ds-stack lg" autocomplete="off">
    <section class="ds-card lg card" aria-labelledby="mnOnH">
      <h2 id="mnOnH" class="ds-h2"><%- t('settings.mentions.alerts') %></h2>
      <label class="ck"><input type="checkbox" id="mnOn"> <span><%- t('settings.mentions.on') %></span></label>
      <label class="ck"><input type="checkbox" id="mnNames"> <span><%- t('settings.mentions.names') %></span></label>
      <div class="names" id="mnNameList" aria-label="<%- t('settings.mentions.names_aria') %>"></div>
      <p class="mut" id="mnNoLink" hidden><%- t('settings.mentions.nolink') %></p>
    </section>

    <%# 1.99kk: @mentions in feed posts and comments (feedmentions.js) - on by default, same mute / quiet hours %>
    <section class="ds-card lg card" aria-labelledby="mnFH">
      <h2 id="mnFH" class="ds-h2"><%- t('settings.mentions.feed_h') %></h2>
      <label class="ck"><input type="checkbox" id="mnFeed"> <span><%- t('settings.mentions.feed') %></span></label>
      <p class="mut"><%- t('settings.mentions.feed_note') %></p>
    </section>

    <section class="ds-card lg card" aria-labelledby="mnWH">
      <h2 id="mnWH" class="ds-h2"><%- t('settings.mentions.words_h') %></h2>
      <p class="mut"><%- t('settings.mentions.words_note', { q: '"', max: '<span id="mnMax"></span>' }) %></p>
      <div class="words" id="mnWords"></div>
      <button type="button" id="mnAdd">+ <%- t('settings.mentions.add') %></button>
    </section>

    <section class="ds-card lg card" aria-labelledby="mnQH">
      <h2 id="mnQH" class="ds-h2"><%- t('settings.mentions.quiet_h') %></h2>
      <label class="ck"><input type="checkbox" id="mnQuiet"> <span><%- t('settings.mentions.quiet') %></span></label>
      <div class="q" id="mnQ">
        <label for="mnFrom"><%- t('settings.mentions.from') %></label><input type="time" id="mnFrom" value="23:00">
        <label for="mnTo"><%- t('settings.mentions.to') %></label><input type="time" id="mnTo" value="08:00">
      </div>
      <p class="mut" style="margin-inline-start:28px"><%- t('settings.mentions.tz') %> <b id="mnTz"></b></p>
      <div class="row" role="group" aria-label="<%- t('settings.mentions.mute') %>">
        <span id="mnMuteTxt" class="mut"></span>
        <button type="button" data-mute="60"><%- t('settings.mentions.mute_1h') %></button>
        <button type="button" data-mute="480"><%- t('settings.mentions.h8') %></button>
        <button type="button" data-mute="1440"><%- t('settings.mentions.h24') %></button>
        <button type="button" data-mute="10080"><%- t('settings.mentions.w1') %></button>
        <button type="button" data-mute="0" id="mnUnmute" hidden><%- t('settings.mentions.unmute') %></button>
      </div>
    </section>

    <div class="row">
      <button type="submit" class="pri"><%- t('msg.save') %></button>
      <span class="msg" id="mnMsg" role="status" aria-live="polite"></span>
    </div>
  </form>
  <%# 1.99kp: 🎥 go-live alerts (golive.js) - saved on change by public/js/follow.js, outside the mentions form %>
  <% const GL_ = typeof golive !== 'undefined' && golive ? golive : { alerts: true, pm: false }; %>
  <section class="ds-card lg card" aria-labelledby="mnGlH" id="golive">
    <h2 id="mnGlH" class="ds-h2"><span class="ds-ic" aria-hidden="true">🎥</span> <%- t('settings.golive.title') %></h2>
    <p class="muted"><%- t('settings.golive.what', { link: '<a href="/feed/following">' + t('feed.following') + '</a>' }) %></p>
    <label class="fl-notify"><input type="checkbox" data-golive-pref="alerts"<%= GL_.alerts ? ' checked' : '' %>> <span><%- t('feed.fl.golive') %></span></label>
    <label class="fl-notify"><input type="checkbox" data-golive-pref="pm"<%= GL_.pm ? ' checked' : '' %>> <span><span class="ds-ic" aria-hidden="true">🐸</span> <%- t('feed.fl.golive_pm') %></span></label>
  </section>
</main>
<script src="/public/js/follow.js?v=2" defer></script>
<script type="application/json" id="mnBoot"><%- JSON.stringify(boot).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029') %></script>
<script>
(function () {
  'use strict';
  var _t = typeof __t === 'function' ? __t : function (k, d, v) { return String(d).replace(/\{!?(\w+)\}/g, function (m, n) { return v && v[n] != null ? v[n] : m; }); };
  var B = JSON.parse(document.getElementById('mnBoot').textContent);
  var $ = function (id) { return document.getElementById(id); };
  var tz = (B.prefs.quiet && B.prefs.quiet.tz) || B.prefs.tz || '';
  try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || tz || 'UTC'; } catch (e) { tz = tz || 'UTC'; }
  $('mnTz').textContent = tz;
  $('mnMax').textContent = B.wordsMax;
  function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
  function hm(min) { return ('0' + Math.floor(min / 60)).slice(-2) + ':' + ('0' + (min % 60)).slice(-2); }
  function mins(v) { var m = /^(\d{1,2}):(\d{2})/.exec(v || ''); return m ? (Number(m[1]) % 24) * 60 + Number(m[2]) : null; }
  function say(t, c) { var m = $('mnMsg'); m.textContent = t || ''; m.className = 'msg' + (c ? ' ' + c : ''); }
  function api(url, body) {
    return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json().catch(function () { return { ok: false, error: 'HTTP ' + r.status }; }); })
      .then(function (d) { if (!d.ok) throw new Error(d.error || _t('js.settings.mentions.error', 'Something went wrong.')); return d; });
  }
  function wordRow(w) {
    var row = el('div', 'w');
    var inp = el('input'); inp.type = 'text'; inp.maxLength = 60; inp.placeholder = _t('js.settings.mentions.word_ph', 'a word or phrase'); inp.value = w.phrase || ''; inp.setAttribute('aria-label', _t('js.settings.mentions.word_aria', 'Word or phrase'));
    var sel = el('select'); sel.setAttribute('aria-label', _t('js.settings.mentions.rooms_aria', 'Which rooms'));
    sel.appendChild(new Option(_t('js.settings.mentions.every_room', 'Every room'), ''));
    (B.rooms || []).forEach(function (r) { sel.appendChild(new Option(r.name, r.id)); });
    if (w.room && !(B.rooms || []).some(function (r) { return r.id === w.room; })) sel.appendChild(new Option(_t('js.settings.mentions.gone_room', '(a room no longer bridged)'), w.room));
    sel.value = w.room || '';
    var x = el('button', 'x', '✕'); x.type = 'button'; x.setAttribute('aria-label', _t('js.settings.mentions.remove', 'Remove')); x.addEventListener('click', function () { row.remove(); });
    row.appendChild(inp); row.appendChild(sel); row.appendChild(x);
    return row;
  }
  function paint(d) {
    $('mnOn').checked = !!d.prefs.enabled;
    $('mnNames').checked = d.prefs.names !== false;
    $('mnFeed').checked = d.prefs.feed !== false;
    var nl = $('mnNameList'); nl.textContent = '';
    (d.names || []).forEach(function (n) { nl.appendChild(el('span', 'chip', n)); });
    $('mnNoLink').hidden = !!d.linked;
    var ws = $('mnWords'); ws.textContent = '';
    (d.words || []).forEach(function (w) { ws.appendChild(wordRow(w)); });
    var q = d.prefs.quiet;
    $('mnQuiet').checked = !!q;
    if (q) { $('mnFrom').value = hm(q.from); $('mnTo').value = hm(q.to); }
    $('mnQ').style.opacity = q ? '1' : '.55';
    var mu = d.prefs.mutedUntil;
    $('mnMuteTxt').textContent = mu ? '🔕 ' + _t('js.settings.mentions.muted_until', 'Muted until {when}', { when: new Date(mu).toLocaleString() }) : _t('js.settings.mentions.not_muted', 'Not muted.');
    $('mnMuteTxt').className = mu ? 'muted-on' : 'mut';
    $('mnUnmute').hidden = !mu;
  }
  paint(B);
  $('mnQuiet').addEventListener('change', function () { $('mnQ').style.opacity = this.checked ? '1' : '.55'; });
  $('mnAdd').addEventListener('click', function () {
    if ($('mnWords').children.length >= B.wordsMax) { say(_t('js.settings.mentions.max_words', 'Up to {n} words or phrases.', { n: B.wordsMax }), 'bad'); return; }
    var r = wordRow({}); $('mnWords').appendChild(r); r.querySelector('input').focus();
  });
  $('mnForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var words = Array.prototype.map.call($('mnWords').children, function (r) { return { phrase: r.querySelector('input').value, room: r.querySelector('select').value }; })
      .filter(function (w) { return w.phrase.trim(); });
    var quiet = { from: null, to: null, tz: tz };
    if ($('mnQuiet').checked) { quiet.from = mins($('mnFrom').value); quiet.to = mins($('mnTo').value); }
    say(_t('js.settings.mentions.saving', 'Saving…'));
    api('/api/mentions', { enabled: $('mnOn').checked, names: $('mnNames').checked, feed: $('mnFeed').checked, words: words, quiet: quiet })
      .then(function (d) { paint(d); say(_t('js.settings.mentions.saved', 'Saved.'), 'ok'); })
      .catch(function (x) { say(x.message, 'bad'); });
  });
  Array.prototype.forEach.call(document.querySelectorAll('[data-mute]'), function (b) {
    b.addEventListener('click', function () {
      api('/api/mentions/mute', { minutes: Number(b.getAttribute('data-mute')) })
        .then(function (d) { paint(d); say(Number(b.getAttribute('data-mute')) ? _t('js.settings.mentions.muted', 'Muted.') : _t('js.settings.mentions.unmuted', 'Unmuted.'), 'ok'); })
        .catch(function (x) { say(x.message, 'bad'); });
    });
  });
})();
</script>
</body>
</html>
