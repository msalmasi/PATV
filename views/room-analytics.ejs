<%- include('layout', { title: room.name + ' — Pad analytics', user: user }) %>
<%#
  /rooms/:slug/analytics (roomstats.js builds `a`; null for visitors, who get a sign-in prompt like
  the live room page). Everything here is aggregate or opt-in public: !incognito users are never sent
  by name, people who hide Analytics on their profile are folded into "+N keep their activity private",
  moderation is counts only.
  1.99afn: private people (!incognito / !bridge hide) are a FROG NAME at their real rank (r.anon: r.name is the frog name, italic,
  a "private" tag, no link / avatar / tooltip; "(you)" on their own row). a.see = the viewer may see through (admin / this pad's
  owner after 90 days): a Reveal per row and the on-until-off toggle (fetch POSTs, each logged); r.revealed + r.real only while the
  viewer's toggle is on.
%>
<style>
  .ra { max-width: var(--ds-w-wide); margin: 0 auto; padding: var(--ds-sp-4) var(--ds-gutter) var(--ds-sp-14); font-family: var(--ds-font); color: var(--ds-text); display: grid; gap: 14px; box-sizing: border-box; width: 100%; }
  .ra *, .ra *::before, .ra *::after { box-sizing: border-box; }
  .ra a { color: var(--ds-green-2); text-decoration: none; }
  .ra a:hover { color: #a5d6a7; }
  .ra .crumb { font-size: 13px; color: var(--ds-text-muted); overflow-wrap: anywhere; }
  .ra .hero { background: radial-gradient(90% 140% at 100% 0%, var(--ds-ac-bg), transparent 60%), #111; border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-5) var(--ds-sp-6); display: grid; gap: 8px; min-width: 0; }
  .ra .hero h1 { margin: 0; font: 700 var(--ds-fs-h1)/var(--ds-lh-h1) var(--ds-font); color: var(--ds-text-strong); overflow-wrap: anywhere; }
  .ra .hero .sub { color: var(--ds-text-2); font-size: var(--ds-fs-sm); line-height: 1.5; }
  .ra .tabs { display: flex; flex-wrap: wrap; gap: 6px; }
  .ra .tab { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; font-size: var(--ds-fs-meta); padding: 0 var(--ds-sp-3h); border-radius: var(--ds-r-pill); border: 1px solid #2a2a2a; background: #151515; color: #ccc !important; white-space: nowrap; }
  .ra .tab.on { background: var(--ds-ac-bg); border-color: var(--ds-ac); color: #fff !important; }
  .ra a.tab:hover { border-color: var(--ds-ac); color: #fff !important; }
  .ra a.tab:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .ra .card { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-r-xl); padding: var(--ds-sp-4); min-width: 0; display: grid; gap: 12px; align-content: start; }
  .ra h2 { margin: 0; letter-spacing: .1em; text-transform: uppercase; color: var(--ds-gold); font-family: var(--ds-font-pixel); font-size: var(--ds-fs-pixel-h); letter-spacing: var(--ds-ls-pixel-h); line-height: 1.6; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 4px 8px; }
  .ra h2 small { font-family: var(--ds-font); letter-spacing: 0; text-transform: none; color: var(--ds-text-muted); font-size: 12px; }
  .ra .muted { color: var(--ds-text-muted); font-size: 12px; }
  .ra .tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .ra .tile { background: var(--ds-sunken); border: 1px solid var(--ds-line-soft); border-radius: var(--ds-r-md); padding: var(--ds-sp-2h) var(--ds-sp-3); min-width: 0; }
  .ra .tile .k { font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--ds-text-muted); }
  .ra .tile .v { font-size: 21px; font-weight: 700; color: var(--ds-text-strong); margin-top: 3px; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; line-height: 1.2; }
  .ra .tile .v.sm { font-size: 15px; }
  .ra .tile .s { font-size: 12px; color: var(--ds-text-muted); margin-top: 2px; }
  .ra .up { color: var(--ds-ok); } .ra .down { color: var(--ds-danger-solid); }
  .ra .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
  .ra .blk { display: grid; gap: 8px; min-width: 0; }
  .ra .blk-top { display: flex; justify-content: space-between; align-items: baseline; gap: 6px 12px; flex-wrap: wrap; font-size: 14px; }
  .ra .blk-top b { color: #ddd; font-weight: 600; }
  .ra .dot { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 6px; vertical-align: 1px; }
  .ua-bars { position: relative; padding: 0 0 20px 40px; }
  .ua-chart { display: block; width: 100%; height: 132px; overflow: visible; }
  .ua-grid { stroke: #232323; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .ua-base { stroke: #3a3a3a; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .ua-hit { fill: transparent; cursor: crosshair; }
  .ua-hit:hover { fill: rgba(255,255,255,.06); }
  .ua-yl { position: absolute; left: 0; top: 0; width: 34px; height: 132px; }
  .ua-yl span { position: absolute; right: 0; transform: translateY(-50%); font-size: 11px; color: var(--ds-text-faint); font-variant-numeric: tabular-nums; }
  .ua-xl { position: absolute; left: 40px; right: 0; bottom: 0; height: 16px; }
  .ua-xl span { position: absolute; transform: translateX(-50%); font-size: 11px; color: var(--ds-text-faint); white-space: nowrap; }
  .ua-xl span.end { transform: translateX(-100%); }
  .ra-hrow { display: grid; grid-template-columns: 36px minmax(0, 1fr); align-items: center; margin-bottom: 3px; }
  .ra-hname { font-size: 11px; color: var(--ds-text-muted); }
  .ra-cells { display: grid; grid-template-columns: repeat(24, minmax(0, 1fr)); gap: 2px; }
  .ra-cell { height: 18px; border-radius: 3px; cursor: crosshair; }
  .ra-cell:hover { outline: 1px solid #ddd; outline-offset: -1px; }
  .ra-hax { display: grid; grid-template-columns: 36px repeat(4, minmax(0, 1fr)); font-size: 11px; color: var(--ds-text-faint); }
  .ra .legend { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; color: #aaa; }
  .ra .ra-tbl { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-inline: calc(-1 * var(--ds-sp-1)); padding-inline: var(--ds-sp-1); }
  .ra table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .ra th { text-align: start; color: var(--ds-text-muted); font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; padding: 0 8px 6px 0; white-space: nowrap; }
  .ra td { padding: 6px 8px 6px 0; border-top: 1px solid #1c1c1c; color: #ccc; vertical-align: top; font-variant-numeric: tabular-nums; }
  .ra td.n { color: var(--ds-text-faint); width: 26px; }
  .ra td.who { overflow-wrap: anywhere; color: var(--ds-text); }
  .ra .num { text-align: end; white-space: nowrap; }
  .ra .privnote { font-size: 12px; color: #c9a36a; }
  .ra .anon { font-style: italic; color: var(--ds-text-muted); }
  /* 1.99afn: a private person's frog name, its "private" tag, "(you)", a revealed login and the see-through controls */
  .ra .ptag { display: inline-block; font-style: normal; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--ds-text-muted); border: 1px solid var(--ds-line-strong); border-radius: 999px; padding: 0 6px; margin-left: 4px; line-height: 1.5; vertical-align: 1px; white-space: nowrap; }
  .ra .you { color: var(--ds-text-muted); white-space: nowrap; }
  .ra .real { color: var(--ds-gold); white-space: nowrap; }
  .ra .ra-rv { font: inherit; font-size: 11px; line-height: 1.4; padding: 1px 8px; margin-left: 4px; border-radius: 999px; border: 1px solid var(--ds-line-strong); background: transparent; color: var(--ds-text-2); cursor: pointer; white-space: nowrap; }
  .ra .ra-rv:hover { border-color: var(--ds-gold); color: var(--ds-text-strong); }
  .ra .ra-rv:focus-visible { outline: none; box-shadow: var(--ds-focus-ring); }
  .ra .brow.priv .bn { white-space: normal; overflow: visible; overflow-wrap: anywhere; }
  .ra .ra-fnote { margin: 0; }
  .ra .ra-see { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-size: 13px; line-height: 1.5; color: var(--ds-text-2); }
  .ra .ra-see.on { border-color: var(--ds-gold); }
  .ra .ra-see > span:first-child { flex: 1 1 260px; min-width: 0; }
  .ra .ra-see input { font: inherit; font-size: 13px; padding: 4px 8px; border-radius: var(--ds-r-xs); border: 1px solid var(--ds-line-strong); background: var(--ds-sunken); color: var(--ds-text); width: 180px; max-width: 100%; }
  .ra .bars { display: grid; gap: 7px; }
  .ra .brow { display: grid; grid-template-columns: minmax(80px, 150px) minmax(0, 1fr) auto; gap: 10px; align-items: center; font-size: 13px; }
  .ra .brow .bn { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ds-text); }
  .ra .brow .bb { height: 8px; background: #1a1a1a; border-radius: 999px; overflow: hidden; }
  .ra .brow .bb span { display: block; height: 100%; border-radius: 999px; }
  .ra .brow .bv { color: var(--ds-text-muted); white-space: nowrap; font-size: 12px; }
  .ra .catbar { display: flex; height: 12px; border-radius: 999px; overflow: hidden; gap: 2px; background: #111; }
  .ra .catbar span { display: block; height: 100%; min-width: 3px; }
  .ra .pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .ra .pill { font-size: 12px; padding: 3px 9px; border-radius: 999px; background: #161616; border: 1px solid #2a2a2a; color: #ccc; }
  .ra .pill b { color: #fff; margin-left: 3px; }
  .ra .topics { display: flex; flex-wrap: wrap; gap: 10px 8px; align-items: center; }
  .ra .topics span { padding: 3px 11px; border-radius: 999px; background: #151a15; border: 1px solid #243324; color: #c8e6c9; line-height: 1.4; }
  /* 1.99el: one vertical rhythm in "What people talk about" - 22px between sections (summary, vibe, topics, the
     jokes / moments / norms columns, changes / topics over time), 8px from a label to its content, 8px between
     list items, 10px between chip rows */
  .ra .know { display: grid; gap: 22px; }
  .ra .know p { margin: 0; line-height: 1.6; color: #ddd; }
  .ra .know p.ksub { margin: 0 0 8px; color: var(--ds-text-muted); line-height: 1.4; }   /* .know p's margin:0 used to win: labels sat on their lists */
  .ra .know ul { margin: 0; padding-left: 18px; display: grid; gap: 8px; color: #ccc; font-size: 14px; line-height: 1.5; }
  .ra .know .two { gap: 22px 28px; }
  .ra .know .two > div { display: grid; align-content: start; min-width: 0; }
  .ra .ksub { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ds-text-muted); margin: 0 0 8px; line-height: 1.4; }
  .ra .vibe { display: inline-block; font-size: 13px; padding: 4px 12px; border-radius: 999px; background: #1a1630; border: 1px solid #3a3260; color: #d1c4e9; }
  /* 1.99el: one grid for every row, so the date + time column ("Oct 7 · 8 AM") lines up and never wraps */
  .ra .hist { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 8px 14px; font-size: 13px; line-height: 1.5; }
  .ra .hist div { display: contents; color: #bbb; }
  .ra .hist b { color: var(--ds-text-muted); font-weight: normal; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .ra .hist span { color: #bbb; min-width: 0; overflow-wrap: anywhere; }
  .ra .empty { color: var(--ds-text-faint); font-size: 13px; }
  .ra .gate { display: grid; justify-items: center; gap: var(--ds-sp-2); background: transparent; border: 1px dashed var(--ds-line-strong); border-radius: var(--ds-r-xl); padding: var(--ds-sp-6) var(--ds-sp-4); text-align: center; color: var(--ds-text-2); line-height: 1.6; }
  #ra-tip { position: fixed; z-index: var(--ds-z-pop); pointer-events: none; background: var(--ds-surface-3); color: #eee; border: 1px solid var(--ds-line-menu); border-radius: var(--ds-r-xs);
            padding: 4px 8px; font-size: 12px; white-space: nowrap; box-shadow: 0 4px 14px rgba(0,0,0,.5); display: none; font-family: var(--ds-font); }
  @media (max-width: 760px) { .ra .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .ua-chart, .ua-yl { height: 110px; }
    .ra-cell { height: 14px; border-radius: 2px; }
    .ra-cells { gap: 1px; }
    .ra .hide-sm { display: none; }
    .ra .brow { grid-template-columns: minmax(70px, 110px) minmax(0, 1fr) auto; }
    .ra .hist { gap: 8px 10px; font-size: 12.5px; }
  }
</style>
<main class="ds-page wide ra" id="ra">
  <div class="crumb"><a href="/p">Pads</a> › <% if (room.bridged) { %><a href="/p/<%= encodeURIComponent(room.slug) %>"><%= room.name %></a><% } else { %><%= room.name %><% } %> › Analytics</div>
  <section class="hero">
    <h1><span class="ds-ic" aria-hidden="true">📈</span> <%= room.name %></h1>
    <div class="sub">What happens in this Camfrog room, from what Pepe sees sitting in it<% if (a && a.updated) { %> · updated <%= a.updated %><% } %><% if (a && a.tz) { %> · times in <%= a.tz %><% } %>.</div>
    <div class="tabs">
      <% if (room.bridged) { %><a class="tab" href="/p/<%= encodeURIComponent(room.slug) %>"><span class="ds-ic" aria-hidden="true">💬</span>Pad page</a><% } %>
      <span class="tab on" aria-current="page"><span class="ds-ic" aria-hidden="true">📈</span>Pad analytics</span>
    </div>
  </section>

<% if (!a) { %>
  <div class="gate"><span class="ds-ic xl" aria-hidden="true">🔒</span><span>Pad analytics are for signed-in members, like the live Camfrog room chat.</span><a class="ds-btn sm" href="/login">Sign in</a></div>
<% } else { %>
  <section class="card" aria-label="Summary">
    <div class="tiles">
      <div class="tile"><div class="k">Messages · 30d</div><div class="v"><%= a.tiles.msgs30 %></div><div class="s"><% if (a.tiles.msgsTrend != null) { %><span class="<%= a.tiles.msgsTrend >= 0 ? 'up' : 'down' %>"><%= a.tiles.msgsTrend >= 0 ? '▲' : '▼' %> <%= Math.abs(a.tiles.msgsTrend) %>%</span> on the month before<% } else { %>public chat<% } %></div></div>
      <div class="tile"><div class="k">Visitors · 30d</div><div class="v"><%= a.tiles.uniq30 %></div><div class="s">~<%= a.tiles.avgVisitors %> a day · <%= a.tiles.uniq90 %> in 90d</div></div>
      <div class="tile"><div class="k">New vs returning</div><div class="v"><%= a.tiles.new30 %> <span class="muted">/ <%= a.tiles.returning30 %></span></div><div class="s">first-timers / regulars back, 30d</div></div>
      <div class="tile"><div class="k">Typical size</div><div class="v"><%= a.tiles.typical %></div><div class="s"><%= a.tiles.typicalNote %><% if (a.tiles.peakSize) { %> · peak <%= a.tiles.peakSize %><% } %></div></div>
      <div class="tile"><div class="k">Mic time · 30d</div><div class="v"><%= a.tiles.mic30 %></div><div class="s">on the mic in the Camfrog room</div></div>
      <div class="tile"><div class="k">Commands · 30d</div><div class="v"><%= a.tiles.cmds30 %></div><div class="s">typed to Pepe here</div></div>
      <div class="tile"><div class="k">Busiest</div><div class="v sm"><%= a.tiles.peak %></div><div class="s">by messages</div></div>
      <div class="tile"><div class="k">Tracked since</div><div class="v sm"><%= a.tiles.first %></div><div class="s">last activity <%= a.tiles.last %></div></div>
    </div>
  </section>

  <section class="card" aria-labelledby="raKnow">
    <h2 id="raKnow"><span><span class="ds-ic" aria-hidden="true">🧠</span> What people talk about</span><small><%= a.know.at ? "Pepe's notes from " + a.know.at : "no notes yet" %></small></h2>
    <% if (!a.know.has) { %>
      <div class="empty">Pepe hasn't summarised this Camfrog room yet — he reads the room a few times a day once it's been chatty.</div>
    <% } else { %>
    <div class="know">
      <% if (a.know.summary) { %><p><%= a.know.summary %></p><% } %>
      <% if (a.know.vibe) { %><div><span class="vibe">✨ <%= a.know.vibe %></span></div><% } %>
      <% if (a.know.topics.length) { %>
      <div><p class="ksub">Recurring topics</p><div class="topics"><% a.know.topics.forEach((t) => { %><span style="font-size:<%= t.size %>em"><%= t.t %></span><% }) %></div></div>
      <% } %>
      <div class="two">
        <% if (a.know.jokes.length) { %><div><p class="ksub">Running jokes</p><ul><% a.know.jokes.forEach((j) => { %><li><%= j %></li><% }) %></ul></div><% } %>
        <% if (a.know.events.length) { %><div><p class="ksub">Notable moments</p><ul><% a.know.events.forEach((j) => { %><li><%= j %></li><% }) %></ul></div><% } %>
        <% if (a.know.rules.length) { %><div><p class="ksub">House norms</p><ul><% a.know.rules.forEach((j) => { %><li><%= j %></li><% }) %></ul></div><% } %>
      </div>
      <% if (a.changes.length || a.history.length > 1) { %>
      <div class="two">
        <% if (a.changes.length) { %><div><p class="ksub">How it's changing</p><ul><% a.changes.forEach((c) => { %><li><%= c %></li><% }) %></ul></div><% } %>
        <% if (a.history.length > 1) { %><div><p class="ksub">Topics over time</p><div class="hist"><% a.history.forEach((h) => { %><div><b><%= h.when %></b><span><%= h.topics.join(' · ') %></span></div><% }) %></div></div><% } %>
      </div>
      <% } %>
    </div>
    <% } %>
  </section>

  <section class="card" aria-labelledby="raAct">
    <h2 id="raAct"><span><span class="ds-ic" aria-hidden="true">📊</span> Activity</span><small>last 90 days</small></h2>
    <div class="two">
      <div class="blk"><div class="blk-top"><b><span class="dot" style="background:var(--ds-green)"></span>Messages per day</b></div>
        <% if (a.hasMsgs) { %><%- a.msgChart %><% } else { %><div class="empty">No chat recorded yet.</div><% } %></div>
      <div class="blk"><div class="blk-top"><b><span class="dot" style="background:#ffb74d"></span>Mic time per day</b></div>
        <% if (a.hasMic) { %><%- a.micChart %><% } else { %><div class="empty">Nobody on the mic yet.</div><% } %></div>
    </div>
    <div class="blk"><div class="blk-top"><b>Unique visitors per day</b>
      <span class="legend"><span><span class="dot" style="background:#26c6da"></span>new</span><span><span class="dot" style="background:#5c6bc0"></span>returning</span></span></div>
      <%- a.visitorsChart %></div>
  </section>

  <section class="card" aria-labelledby="raHeat">
    <h2 id="raHeat"><span><span class="ds-ic" aria-hidden="true">🗓</span> When it's busy</span><small>hour of the week</small></h2>
    <div class="two">
      <div class="blk"><div class="blk-top"><b><span class="dot" style="background:var(--ds-green)"></span>Chat</b></div>
        <div><%- a.heatChat %><div class="ra-hax" aria-hidden="true"><span></span><span>00</span><span>06</span><span>12</span><span>18</span></div></div></div>
      <% if (a.hasHeatMic) { %>
      <div class="blk"><div class="blk-top"><b><span class="dot" style="background:#ffb74d"></span>Mic</b></div>
        <div><%- a.heatMic %><div class="ra-hax" aria-hidden="true"><span></span><span>00</span><span>06</span><span>12</span><span>18</span></div></div></div>
      <% } %>
    </div>
  </section>

  <% /* 1.99afn: a private row's name - the frog name, the tag, (you), then the revealed login or the Reveal control (see-through only) */
     const fnName = (x) => '<span class="anon">' + escFn(x.name) + '</span><span class="ptag">private</span>' + (x.you ? ' <span class="you">(you)</span>' : '') +
       (x.revealed ? ' <span class="real" title="Only you can see this">· ' + escFn(x.real || '(not known to the site)') + ' 🕶</span>'
        : a.see ? ' <button type="button" class="ra-rv" data-row="' + escFn(x.name) + '" aria-label="Reveal who is ' + escFn(x.name) + '">Reveal</button>' : '');
     function escFn(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&#34;', "'": '&#39;' })[c]); } %>
  <% if (a.see) { %>
  <section class="card ra-see<%= a.see.on ? ' on' : '' %>" id="raSee" aria-label="See who is behind a frog name" data-slug="<%= room.slug %>">
    <% if (a.see.on) { %>
    <span>🕶 Real names are on for you on this pad until you hide them again. Only you can see them; every page you open while they're on is logged.</span>
    <button type="button" class="ds-btn sm" id="raSeeOff">Hide real names</button>
    <% } else { %>
    <span>🕶 As <%= a.see.role === 'admin' ? 'a PATV admin' : "this pad's owner" %> you can see who is behind a frog name here - one row (Reveal) or every row until you hide them again. Nothing shows until you ask, and every reveal is logged.</span>
    <input type="text" id="raSeeWhy" maxlength="120" placeholder="Reason (optional)" aria-label="Reason (optional)" autocomplete="off">
    <button type="button" class="ds-btn sm" id="raSeeOn">Show real names</button>
    <% } %>
    <span id="raSeeMsg" class="muted" role="status"></span>
  </section>
  <% } %>
  <div class="two">
    <section class="card" aria-labelledby="raRegs">
      <h2 id="raRegs"><span><span class="ds-ic" aria-hidden="true">👥</span> Regulars</span><small>by days here, chat and mic</small></h2>
      <% if (a.regulars.length) { %>
      <div class="ra-tbl"><table><thead><tr><th></th><th>Who</th><th class="num">Days 30d</th><th class="num">Msgs 30d</th><th class="num hide-sm">Mic 30d</th><th class="num hide-sm">Last seen</th></tr></thead><tbody>
        <% a.regulars.forEach((r) => { %><tr><td class="n"><%= r.rank %></td><td class="who"><% if (r.anon) { %><%- fnName(r) %><% } else if (r.href) { %><a href="<%= r.href %>"><%= r.name %></a><% } else { %><%= r.name %><% } %></td><td class="num"><%= r.d30 %></td><td class="num"><%= r.m30 %></td><td class="num hide-sm"><%= r.mic30 %></td><td class="num hide-sm"><%= r.last %></td></tr><% }) %>
      </tbody></table></div>
      <% } else { %><div class="empty">No regulars yet.</div><% } %>
      <% if (a.regularsHidden) { %><div class="privnote">🔒 +<%= a.regularsHidden %> regular<%= a.regularsHidden === 1 ? '' : 's' %> keep their activity private.</div><% } %>
    </section>
    <section class="card" aria-labelledby="raMic">
      <h2 id="raMic"><span><span class="ds-ic" aria-hidden="true">🎙</span> Mic leaderboard</span><small>last 90 days</small></h2>
      <% if (a.mic.length) { %>
      <div class="bars"><% a.mic.forEach((m) => { %>
        <div class="brow<%= m.anon ? ' priv' : '' %>"><span class="bn"><%= m.rank %>. <% if (m.anon) { %><%- fnName(m) %><% } else if (m.href) { %><a href="<%= m.href %>"><%= m.name %></a><% } else { %><%= m.name %><% } %></span><span class="bb"><span style="width:<%= m.pct.toFixed(1) %>%;background:#ffb74d"></span></span><span class="bv"><%= m.dur %></span></div>
      <% }) %></div>
      <% } else { %><div class="empty">Nobody on the mic yet.</div><% } %>
      <% if (a.micHidden) { %><div class="privnote">🔒 +<%= a.micHidden %> keep their activity private.</div><% } %>
    </section>
  </div>
  <% if (a.hasPrivate) { %><p class="muted ra-fnote">🐸 Private people (Camfrog <code>!incognito</code> / <code>!bridge hide</code>) show under a frog name at their real rank, with their real numbers. The names change every day at 10:00 UTC and aren't their chat names; Pepe's notes above call them "someone".</p><% } %>

  <div class="two">
    <section class="card" aria-labelledby="raCmd">
      <h2 id="raCmd"><span><span class="ds-ic" aria-hidden="true">⌨️</span> Commands here</span><small>since tracking began</small></h2>
      <% if (a.cmds.length) { %>
      <div class="catbar" role="img" aria-label="Commands by category"><% a.cats.forEach((c) => { %><span style="width:<%= c.pct.toFixed(1) %>%;background:<%= c.color %>" title="<%= c.label %>: <%= c.n %>"></span><% }) %></div>
      <div class="legend"><% a.cats.forEach((c) => { %><span><span class="dot" style="background:<%= c.color %>"></span><%= c.label %> <b><%= c.n %></b></span><% }) %></div>
      <div class="bars"><% a.cmds.forEach((c) => { %>
        <div class="brow"><span class="bn"><code><%= c.cmd %></code></span><span class="bb"><span style="width:<%= c.pct.toFixed(1) %>%;background:<%= c.color %>"></span></span><span class="bv"><%= c.n %></span></div>
      <% }) %></div>
      <% } else { %><div class="empty">No commands yet.</div><% } %>
    </section>
    <section class="card" aria-labelledby="raGames">
      <h2 id="raGames"><span><span class="ds-ic" aria-hidden="true">🎲</span> Games &amp; moderation</span><small>30d · 90d</small></h2>
      <% if (a.games.length) { %>
      <div class="ra-tbl"><table><thead><tr><th>Game</th><th class="num">30 days</th><th class="num">90 days</th></tr></thead><tbody>
        <% a.games.forEach((g) => { %><tr><td><span class="dot" style="background:<%= g.color %>"></span><%= g.label %></td><td class="num"><%= g.d30 %></td><td class="num"><%= g.d90 %></td></tr><% }) %>
      </tbody></table></div>
      <div class="muted">Game commands played in the Camfrog room (a hand, a spin, a heist move).</div>
      <% } else { %><div class="empty">No games played here yet.</div><% } %>
      <p class="ksub" style="margin-top:6px">Moderation · 90 days · <%= a.modTotal %></p>
      <% if (a.mod.length) { %><div class="pills"><% a.mod.forEach((m) => { %><span class="pill"><%= m.label %><b><%= m.n %></b></span><% }) %></div>
      <% } else { %><div class="empty">Quiet — nothing on file.</div><% } %>
      <div class="muted">Totals only — who did what is never shown here.</div>
    </section>
  </div>
<% } %>
</main>
<div id="ra-tip" role="tooltip"></div>
<script>
  (function () {
    var tip = document.getElementById('ra-tip'), root = document.getElementById('ra');
    if (!tip || !root) return;
    function show(e) {
      var t = e.target.closest && e.target.closest('[data-tip]');
      if (!t || !root.contains(t)) { tip.style.display = 'none'; return; }
      tip.textContent = t.getAttribute('data-tip');
      tip.style.display = 'block';
      var x = e.clientX + 12, y = e.clientY - 34, w = tip.offsetWidth;
      if (x + w > window.innerWidth - 8) x = e.clientX - w - 12;
      tip.style.left = Math.max(8, x) + 'px';
      tip.style.top = Math.max(8, y) + 'px';
    }
    root.addEventListener('pointermove', show);
    root.addEventListener('pointerdown', show);
    root.addEventListener('pointerleave', function () { tip.style.display = 'none'; });
    root.querySelectorAll('[data-tip] title').forEach(function (n) { n.remove(); });
    root.querySelectorAll('.ra-cell[title]').forEach(function (n) { n.removeAttribute('title'); });
  })();
  // 1.99afn see-through: a row's Reveal and the on-until-off toggle - same-site fetch POSTs (each one a log row on the server)
  (function () {
    var box = document.getElementById('raSee');
    if (!box) return;
    var base = '/p/' + encodeURIComponent(box.getAttribute('data-slug')) + '/analytics/';
    var msg = document.getElementById('raSeeMsg'), why = document.getElementById('raSeeWhy');
    function post(path, body) {
      return fetch(base + path, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' },
                                  body: JSON.stringify(body) }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); });
    }
    function say(t) { if (msg) msg.textContent = t || ''; }
    function toggle(on) {
      say('…');
      post('seethrough', { on: on, reason: why ? why.value : '' }).then(function (d) {
        if (d && d.ok) location.reload(); else say((d && d.error) || 'Could not change it.');
      }, function () { say('Could not change it - check your connection.'); });
    }
    var onB = document.getElementById('raSeeOn'), offB = document.getElementById('raSeeOff');
    if (onB) onB.addEventListener('click', function () { toggle(true); });
    if (offB) offB.addEventListener('click', function () { toggle(false); });
    document.querySelectorAll('#ra .ra-rv').forEach(function (b) {
      b.addEventListener('click', function () {
        b.disabled = true;
        post('reveal', { row: b.getAttribute('data-row'), reason: why ? why.value : '' }).then(function (d) {
          if (!d || !d.ok) { b.disabled = false; say((d && d.error) || 'Could not reveal it.'); return; }
          var s = document.createElement('span');
          s.className = 'real';
          s.title = 'Only you can see this';
          s.textContent = '· ' + (d.real || '(not known to the site)') + ' 🕶';
          b.replaceWith(s);
        }, function () { b.disabled = false; say('Could not reveal it - check your connection.'); });
      });
    });
  })();
</script>
