<%- include('layout', { title: 'Manage Prizes', user: user}) %>
<%# /admin/manage-prizes - the classic official-prize editor (shop.js). G6 polish: off Bootstrap 4 onto the design system
    (.ds-page, .ds-head, a .ds-card form, a .ds-tbl table, a .ds-scrim > .ds-modal edit dialog). Every id the script uses is
    kept; the Bootstrap modal plugin is replaced by a small open / close helper (focus in, Esc and the scrim close it, focus
    returns to the button that opened it). The requests themselves are unchanged. %>
<style>
  .mp .mp-form { grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); align-items: end; }
  .mp .mp-form .ds-actions { grid-column: 1 / -1; }
  .mp #costContainer { display: grid; }   /* styles.css has #costContainer { display: block } (an old wheel form) */
  .mp .spin-status { height: auto; min-height: 1.5em; padding: 0; margin: 0; text-align: start; color: var(--ds-danger); font-size: var(--ds-fs-sm); font-weight: 700; }
  .mp .spin-status.ok { color: var(--ds-ok); }
  .mp #prizesTable td:last-child { white-space: nowrap; }
  .mp #prizesTable td:last-child .ds-btn + .ds-btn { margin-inline-start: var(--ds-sp-2); }
  .mp #prizesTable tbody:empty::after { content: "No official prizes yet."; display: table-cell; padding: var(--ds-sp-6) var(--ds-sp-4); color: var(--ds-text-muted); }
  .mp .ds-modal .ds-form { gap: var(--ds-sp-3); }
</style>

<main class="mp ds-page mid">
  <div class="ds-head">
    <span class="ds-eyebrow">Staff · Prize shop</span>
    <h1 class="ds-h1">Manage Prizes</h1>
    <p class="ds-sub">Official store items only. Descriptions, images, categories, the marketplace (review queue, disputes, orders, fee and approval settings) are in <a href="/shop/admin">Shop admin</a>.</p>
  </div>

  <section class="ds-card lg" aria-labelledby="mpAddH">
    <h2 class="ds-h3" id="mpAddH">Add New Prize</h2>
    <form id="prizeListForm" class="ds-form mp-form" action="/api/prizes/edit" method="POST">
      <div class="ds-field">
        <label for="prizeName">Prize Name</label>
        <input class="ds-in" type="text" id="prizeName" name="prizeName" required>
      </div>
      <div class="ds-field" id="costContainer">
        <label for="prizeCost">Prize Cost</label>
        <input class="ds-in num" type="text" id="prizeCost" name="cost" inputmode="numeric">
      </div>
      <div class="ds-field" id="qtyContainer">
        <label for="prizeQty">Prize Qty</label>
        <input class="ds-in num" type="text" id="prizeQty" name="quantity" inputmode="numeric">
      </div>
      <div class="ds-actions">
        <button id="addPrizeBtn" class="ds-btn">Add New Prize</button>
        <div id="PrizeListStatus" class="spin-status" role="status" aria-live="polite"></div>
      </div>
    </form>
  </section>

  <section class="ds-stack" aria-labelledby="mpListH">
    <h2 class="ds-h2 dot" id="mpListH">Official prizes</h2>
    <div class="ds-tbl">
      <table id="prizesTable">
        <thead>
          <tr>
            <th>Prize ID</th>
            <th>Prize Name</th>
            <th class="r">Cost</th>
            <th class="r">Quantity</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <!-- the edit dialog -->
  <div class="ds-scrim sheet" id="editPrizeModal" hidden>
    <div class="ds-modal" role="dialog" aria-modal="true" aria-labelledby="editPrizeModalLabel">
      <form id="editPrizeForm" class="ds-form">
        <div class="ds-modal-h">
          <h2 id="editPrizeModalLabel">Edit Prize</h2>
          <button type="button" class="ds-close" aria-label="Close" data-mp-close><span aria-hidden="true">&times;</span></button>
        </div>
        <input type="hidden" id="editPrizeId" name="prizeId">
        <div class="ds-field">
          <label for="editPrizeName">Prize Name</label>
          <input type="text" class="ds-in" id="editPrizeName" name="prizeName" required>
        </div>
        <div class="ds-field">
          <label for="editPrizeCost">Cost</label>
          <input type="number" class="ds-in num" id="editPrizeCost" name="cost" required min="0" inputmode="numeric">
        </div>
        <div class="ds-field">
          <label for="editPrizeQuantity">Quantity</label>
          <input type="number" class="ds-in num" id="editPrizeQuantity" name="quantity" required min="0" inputmode="numeric">
        </div>
        <div class="ds-modal-f">
          <button type="button" class="ds-btn ghost" data-mp-close>Cancel</button>
          <button type="submit" class="ds-btn">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</main>

  <!-- Include JS libraries -->
  <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
  <script>
    // G6: the dialog helper that replaces Bootstrap's $(...).modal('show' / 'hide')
    (function () {
      var scrim = document.getElementById('editPrizeModal'), opener = null;
      function show() { opener = document.activeElement; scrim.hidden = false; var f = document.getElementById('editPrizeName'); if (f) f.focus(); }
      function hide() { scrim.hidden = true; if (opener && opener.focus && document.contains(opener)) opener.focus(); opener = null; }
      $.fn.modal = function (cmd) { if (this[0] === scrim) { if (cmd === 'show') show(); else if (cmd === 'hide') hide(); } return this; };
      scrim.addEventListener('click', function (e) { if (e.target === scrim) window.closeEditModal ? window.closeEditModal() : hide(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !scrim.hidden) { window.closeEditModal ? window.closeEditModal() : hide(); } });
    })();
  </script>

  <!-- Custom Script (1.99qh: the rows are built with the DOM - a prize name is text, never HTML - and the buttons use
       addEventListener, not inline onclick; adding a prize refreshes the table in place) -->
  <script>
    (function () {
      'use strict';
      var statusEl = document.getElementById('PrizeListStatus');
      var tbody = document.querySelector('#prizesTable tbody');

      function say(msg, fade, ok) {
        statusEl.textContent = msg;
        statusEl.classList.toggle('ok', !!ok);
        statusEl.style.visibility = 'visible';
        if (fade) setTimeout(function () { statusEl.style.visibility = 'hidden'; }, 2000);
      }
      function cell(text, cls) { var td = document.createElement('td'); td.textContent = text == null ? '' : String(text); if (cls) td.className = cls; return td; }
      function button(label, cls, onClick) {
        var b = document.createElement('button'); b.type = 'button'; b.className = cls; b.textContent = label;
        b.addEventListener('click', onClick); return b;
      }

      // Populate the prizes table: every value goes in as text (textContent), so a name like <img onerror=...> is shown, not run
      function populatePrizesTable(prizes) {
        tbody.textContent = '';
        (Array.isArray(prizes) ? prizes : []).forEach(function (prize) {
          var tr = document.createElement('tr');
          tr.appendChild(cell(prize.prizeId));
          tr.appendChild(cell(prize.prize));
          tr.appendChild(cell(prize.cost, 'r'));
          tr.appendChild(cell(prize.quantity, 'r'));
          var acts = document.createElement('td');
          acts.appendChild(button('Edit', 'ds-btn sm ghost', function () { window.openEditModal(prize.prizeId, prize.prize, prize.cost, prize.quantity); }));
          acts.appendChild(button('Remove', 'ds-btn sm danger', function () { window.removePrize(prize.prize); }));
          tr.appendChild(acts);
          tbody.appendChild(tr);
        });
      }

      // Fetch prizes and populate the table
      function fetchPrizes() {
        $.ajax({
          url: '/api/prizes',
          method: 'GET',
          success: function (response) { populatePrizesTable(response); },
          error: function () { say('Prize list change failed. Check the prize name.', true); }
        });
      }
      window.fetchPrizes = fetchPrizes;

      // Open the edit modal with prize details
      window.openEditModal = function (prizeId, prizeName, cost, quantity) {
        $('#editPrizeId').val(prizeId);
        $('#editPrizeName').val(prizeName);
        $('#editPrizeCost').val(cost);
        $('#editPrizeQuantity').val(quantity);
        $('#editPrizeModal').modal('show');
      };

      // Close the edit modal
      window.closeEditModal = function () {
        $('#editPrizeForm')[0].reset();
        $('#editPrizeModal').modal('hide');
      };
      document.querySelectorAll('[data-mp-close]').forEach(function (b) { b.addEventListener('click', window.closeEditModal); });

      // Handle form submission for editing a prize
      $('#editPrizeForm').submit(function (event) {
        event.preventDefault();
        $.ajax({
          url: '/api/prizes/edit',
          method: 'POST',
          data: {
            action: 'add',   // 'add' with a prizeId edits it
            prizeId: $('#editPrizeId').val(),
            prizeName: $('#editPrizeName').val(),
            cost: $('#editPrizeCost').val(),
            quantity: $('#editPrizeQuantity').val()
          },
          success: function (response) {
            if (response && response.message && response.message.includes('successfully')) say('Prize list edited successfully.', false, true);
            window.closeEditModal();
            fetchPrizes();
          },
          error: function (xhr) { say(xhr && xhr.responseText && xhr.status === 400 ? xhr.responseText : 'Prize list change failed. Check the prize name.', true); }
        });
      });

      // Remove a prize
      window.removePrize = function (prizeName) {
        if (!confirm('Are you sure you want to remove this prize?')) return;
        $.ajax({
          url: '/api/prizes/edit',
          method: 'POST',
          data: { action: 'remove', prizeName: prizeName },
          success: function (response) {
            if (response && response.message && response.message.includes('successfully')) say('Prize removed successfully.', false, true);
            fetchPrizes();
          },
          error: function () { say('Failed to remove prize. Check the prize name.', true); }
        });
      };

      // Adding prizes: then refresh the table in place (it used to look for a #prizeList that isn't on this page)
      document.getElementById('prizeListForm').addEventListener('submit', function (event) {
        event.preventDefault();
        fetch('/api/prizes/edit', {
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'add', prizeName: document.getElementById('prizeName').value,
                                 cost: document.getElementById('prizeCost').value, quantity: document.getElementById('prizeQty').value }),
          method: 'POST'
        }).then(function (response) {
          if (!response.ok) return response.text().then(function (t) { var e = new Error('Failed to edit prize list.'); e.detail = response.status === 400 ? t : ''; throw e; });
          return response.json();
        }).then(function (data) {
          if (data && data.message && data.message.includes('successfully')) {
            say('Prize list edited successfully.', false, true);
            event.target.reset();
          }
          fetchPrizes();
        }).catch(function (error) {
          console.error('Error making the POST request:', error);
          say(error.detail || 'Prize list change failed. Check the prize name.', true);
        });
      });

      $(fetchPrizes);
    })();
  </script>
